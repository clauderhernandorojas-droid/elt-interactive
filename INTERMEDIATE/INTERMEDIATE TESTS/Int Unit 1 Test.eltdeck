{
  "version": "2.0",
  "title": "Int Unit 1 Test",
  "updatedAt": "2026-10-30T18:49:38.333Z",
  "slides": [
    {
      "id": 1793383602965,
      "title": "Progress Test 1 - Vocabulary: Weekend Activities",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Progress Test 1 - Vocabulary: Weekend Activities</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header / Scoreboard -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-8 border-b w-full shadow-sm flex flex-wrap items-center justify-between gap-4\">\n        <div class=\"flex items-center gap-3\">\n            <span class=\"bg-indigo-600 text-white font-bold text-xs px-2.5 py-1 rounded-lg uppercase tracking-wider\">Progress Test 1</span>\n            <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">Weekend Activities & Collocations</h1>\n        </div>\n        <div class=\"flex items-center gap-4\">\n            <div id=\"score-display\" class=\"text-sm font-semibold bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full border border-slate-200\">\n                Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">11</span>\n            </div>\n            <button id=\"reset-btn\" class=\"bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-medium px-3.5 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer\">\n                <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                Reset\n            </button>\n        </div>\n    </header>\n\n    <!-- Main Container (w-full max-w-4xl mx-auto as required) -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Instructions & Word Bank Card -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6 mb-6\">\n            <div class=\"flex items-start gap-3 mb-4\">\n                <div class=\"p-2 bg-indigo-50 text-indigo-600 rounded-xl\">\n                    <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n                </div>\n                <div>\n                    <h2 class=\"text-lg font-bold text-slate-900\">Vocabulary Exercise</h2>\n                    <p class=\"text-sm text-slate-600 mt-0.5\">Fill in the gaps with these verbs. You can use the verbs more than once.</p>\n                </div>\n            </div>\n\n            <!-- Word Bank -->\n            <div class=\"flex flex-wrap gap-2 pt-2 border-t border-slate-100\">\n                <span class=\"text-xs font-bold text-slate-400 uppercase tracking-wider self-center mr-2\">Word Bank:</span>\n                <span class=\"bg-indigo-50 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-lg border border-indigo-100 shadow-2xs\">do</span>\n                <span class=\"bg-indigo-50 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-lg border border-indigo-100 shadow-2xs\">chat</span>\n                <span class=\"bg-indigo-50 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-lg border border-indigo-100 shadow-2xs\">visit</span>\n                <span class=\"bg-indigo-50 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-lg border border-indigo-100 shadow-2xs\">tidy up</span>\n                <span class=\"bg-indigo-50 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-lg border border-indigo-100 shadow-2xs\">have</span>\n                <span class=\"bg-indigo-50 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-lg border border-indigo-100 shadow-2xs\">go</span>\n                <span class=\"bg-indigo-50 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-lg border border-indigo-100 shadow-2xs\">meet</span>\n            </div>\n        </section>\n\n        <!-- Questions Form -->\n        <form id=\"quiz-form\" class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-8 space-y-4\">\n            \n            <!-- Item 1 (Example) -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-400 w-6 text-right\">1.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>I often</span>\n                    <input type=\"text\" value=\"do\" disabled class=\"bg-slate-100 text-slate-500 font-medium px-3 py-1.5 rounded-lg border border-slate-200 w-28 text-center cursor-not-allowed\">\n                    <span>some gardening at the weekend. <span class=\"text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded ml-1\">(Example)</span></span>\n                </div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">2.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>We usually</span>\n                    <input type=\"text\" data-answer=\"visit\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>my grandmother on Sundays.</span>\n                </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">3.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>When did you last</span>\n                    <input type=\"text\" data-answer=\"tidy up\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>the flat?</span>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">4.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>I think I'll</span>\n                    <input type=\"text\" data-answer=\"have\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>a quiet night in.</span>\n                </div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">5.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>We often</span>\n                    <input type=\"text\" data-answer=\"go\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>clubbing with friends.</span>\n                </div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">6.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>I never</span>\n                    <input type=\"text\" data-answer=\"have\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>a lie-in on Saturday mornings.</span>\n                </div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">7.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>My sister and I often</span>\n                    <input type=\"text\" data-answer=\"chat\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>to people online.</span>\n                </div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">8.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>I really need to</span>\n                    <input type=\"text\" data-answer=\"do\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>some exercise.</span>\n                </div>\n            </div>\n\n            <!-- Item 9 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">9.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>We hardly ever</span>\n                    <input type=\"text\" data-answer=\"go\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>to exhibitions.</span>\n                </div>\n            </div>\n\n            <!-- Item 10 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2 border-b border-slate-100\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">10.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>I sometimes</span>\n                    <input type=\"text\" data-answer=\"have\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>friends round for dinner.</span>\n                </div>\n            </div>\n\n            <!-- Item 11 -->\n            <div class=\"flex items-center gap-3 text-sm sm:text-base py-2\">\n                <span class=\"flex-none font-bold text-slate-700 w-6 text-right\">11.</span>\n                <div class=\"flex-grow flex flex-wrap items-center gap-2 text-slate-700\">\n                    <span>Sam's going to</span>\n                    <input type=\"text\" data-answer=\"meet\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"type verb...\" class=\"bg-slate-50 focus:bg-white text-slate-800 font-medium px-3 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all w-36 text-center\">\n                    <span>up with some friends.</span>\n                </div>\n            </div>\n\n            <!-- Submit Button Bar -->\n            <div class=\"pt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4\">\n                <p id=\"feedback-msg\" class=\"text-sm font-medium text-slate-500\">Fill in all gaps and click check answers.</p>\n                <button type=\"submit\" id=\"check-btn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl transition-all shadow-sm cursor-pointer flex items-center justify-center gap-2 min-h-[44px]\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    Check Answers\n                </button>\n            </div>\n        </form>\n\n        <!-- Additional Note Section as requested by the professor -->\n        <section class=\"mt-6 bg-amber-50 border border-amber-200 rounded-2xl p-5 sm:p-6 text-amber-900 shadow-2xs\">\n            <div class=\"flex items-start gap-3\">\n                <div class=\"p-2 bg-amber-100 text-amber-700 rounded-xl mt-0.5\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-amber-900 text-sm sm:text-base\">Additional Note / Part C Reference</h3>\n                    <p class=\"text-xs sm:text-sm text-amber-800 mt-1 leading-relaxed\">\n                        Remember to review your collocations regularly. Practice using these verb phrases in your daily conversations to build natural fluency and expand your active vocabulary for weekend routines.\n                    </p>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-4 text-xs text-slate-400 border-t border-slate-100 mt-auto\">\n        ELT Interactive Micro-App &bull; Progress Test 1\n    </footer>\n\n    <!-- Interactive Script & Metrics Contract -->\n    <script>\n        // MANDATORY PEDAGOGICAL METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'weekend_activities_collocations',\n            maxScore: 11\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const form = document.getElementById('quiz-form');\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const currentScoreSpan = document.getElementById('current-score');\n            const feedbackMsg = document.getElementById('feedback-msg');\n            const inputs = form.querySelectorAll('input[data-answer]');\n\n            document.getElementById('total-score').textContent = inputs.length;\n\n            form.addEventListener('submit', (e) => {\n                e.preventDefault();\n                let correctCount = 0;\n\n                inputs.forEach(input => {\n                    const userAnswer = input.value.trim().toLowerCase();\n                    const correctAnswer = input.getAttribute('data-answer').toLowerCase();\n\n                    input.classList.remove('is-correct', 'is-wrong');\n\n                    if (userAnswer === correctAnswer) {\n                        input.classList.add('is-correct');\n                        correctCount++;\n                    } else {\n                        input.classList.add('is-wrong');\n                    }\n                });\n\n                currentScoreSpan.textContent = correctCount;\n\n                if (correctCount === inputs.length) {\n                    feedbackMsg.textContent = '🎉 Excellent! All answers are correct.';\n                    feedbackMsg.className = 'text-sm font-bold text-emerald-600';\n                } else {\n                    feedbackMsg.textContent = `You got ${correctCount} out of ${inputs.length} correct. Review the highlighted items.`;\n                    feedbackMsg.className = 'text-sm font-bold text-amber-600';\n                }\n\n                // DISPATCH MANDATORY CUSTOM EVENT & POSTMESSAGE\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                try {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: inputs.length\n                    }, '*');\n                } catch (err) {\n                    console.log('PostMessage not available');\n                }\n            });\n\n            resetBtn.addEventListener('click', () => {\n                inputs.forEach(input => {\n                    input.value = '';\n                    input.classList.remove('is-correct', 'is-wrong');\n                });\n                currentScoreSpan.textContent = '0';\n                feedbackMsg.textContent = 'Fill in all gaps and click check answers.';\n                feedbackMsg.className = 'text-sm font-medium text-slate-500';\n            });\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793383748284,
      "title": "Make Questions - Grammar Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Make Questions - Grammar Practice</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom smooth transitions and focus styles */\n    .transition-custom {\n      transition: all 0.2s ease-in-out;\n    }\n    input:focus {\n      outline: none;\n      ring: 2px;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Header for Metrics & Title -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-6 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n      <div>\n        <span class=\"inline-block bg-indigo-100 text-indigo-800 text-xs font-semibold px-2.5 py-0.5 rounded-full uppercase tracking-wide\">Grammar Practice</span>\n        <h1 class=\"text-lg sm:text-xl font-bold text-slate-900 mt-0.5\">Make questions with these words</h1>\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <div id=\"score-display\" class=\"bg-slate-100 text-slate-700 font-medium px-3 py-1.5 rounded-xl text-sm border border-slate-200\">\n          Score: <span id=\"current-score\" class=\"font-bold text-indigo-600\">0</span> / <span id=\"total-score\">12</span>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n    \n    <!-- Instructions Card -->\n    <div class=\"bg-indigo-50 border border-indigo-100 rounded-2xl p-4 sm:p-5 mb-6 text-indigo-900 text-sm sm:text-base flex items-start gap-3 shadow-sm\">\n      <svg class=\"w-6 h-6 text-indigo-600 flex-shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n      </svg>\n      <div>\n        <p class=\"font-semibold\">Instructions:</p>\n        <p class=\"mt-0.5 text-indigo-800/90\">Look at the prompts and write the correct grammatical question. Pay close attention to verb tenses and auxiliary verbs (Present Simple, Past Simple, Present Continuous, Present Perfect, etc.).</p>\n      </div>\n    </div>\n\n    <!-- Interactive Form / Exercise List -->\n    <form id=\"quiz-form\" class=\"space-y-4 sm:space-y-6\" onsubmit=\"event.preventDefault();\">\n      \n      <!-- Item 1 (Example) -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-900 text-white font-bold flex items-center justify-center text-sm shadow-sm\">1</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-600 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              Why / you / learn / English / this school?\n            </div>\n            <input type=\"text\" disabled value=\"Why are you learning English at this school?\" \n              class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-slate-700 text-sm sm:text-base cursor-not-allowed font-medium\">\n            <span class=\"text-xs text-slate-500 mt-1 block italic\">✓ Example (already answered)</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 2 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"2\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">2</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              How long / Eve / live / her flat?\n            </div>\n            <input type=\"text\" \n              data-answer=\"How long has Eve lived in her flat?\" \n              data-alt1=\"How long has Eve been living in her flat?\"\n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"3\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">3</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              What / Nick / watch / at the moment?\n            </div>\n            <input type=\"text\" \n              data-answer=\"What is Nick watching at the moment?\" \n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 4 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"4\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">4</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              What / happen / when you / get / home last night?\n            </div>\n            <input type=\"text\" \n              data-answer=\"What happened when you got home last night?\" \n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 5 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"5\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">5</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              What / Andrew normally / do / the weekend?\n            </div>\n            <input type=\"text\" \n              data-answer=\"What does Andrew normally do at the weekend?\" \n              data-alt1=\"What does Andrew normally do on the weekend?\"\n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 6 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"6\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">6</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              What / Tom and Ann / do / now?\n            </div>\n            <input type=\"text\" \n              data-answer=\"What are Tom and Ann doing now?\" \n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 7 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"7\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">7</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              When / she / start / coming / this school?\n            </div>\n            <input type=\"text\" \n              data-answer=\"When did she start coming to this school?\" \n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 8 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"8\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">8</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              How many cars / you / have / in your life?\n            </div>\n            <input type=\"text\" \n              data-answer=\"How many cars have you had in your life?\" \n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 9 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"9\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">9</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              Where / they / go / holiday last year?\n            </div>\n            <input type=\"text\" \n              data-answer=\"Where did they go on holiday last year?\" \n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 10 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"10\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">10</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              Who / come / your party last weekend?\n            </div>\n            <input type=\"text\" \n              data-answer=\"Who came to your party last weekend?\" \n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 11 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"11\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">11</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              What / your children usually / have / dinner?\n            </div>\n            <input type=\"text\" \n              data-answer=\"What do your children usually have for dinner?\" \n              data-alt1=\"What did your children usually have for dinner?\"\n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 12 -->\n      <div class=\"bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-custom question-container\" data-id=\"12\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm shadow-sm\">12</span>\n          <div class=\"flex-grow\">\n            <div class=\"text-slate-700 font-mono text-xs sm:text-sm bg-slate-100 px-3 py-1.5 rounded-lg inline-block mb-2 border border-slate-200\">\n              How often / go / the beach when / be / child?\n            </div>\n            <input type=\"text\" \n              data-answer=\"How often did you go to the beach when you were a child?\" \n              placeholder=\"Type your question here...\" \n              class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-slate-800 text-sm sm:text-base focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-custom\">\n            <div class=\"feedback-container mt-1.5 text-xs font-semibold hidden\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"flex flex-col sm:flex-row items-center justify-end gap-3 pt-4\">\n        <button type=\"button\" id=\"reset-btn\" onclick=\"resetQuiz()\" class=\"w-full sm:w-auto px-6 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-xl text-sm sm:text-base transition-custom flex items-center justify-center gap-2\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n          Reset Answers\n        </button>\n        <button type=\"button\" id=\"check-btn\" onclick=\"checkAnswers()\" class=\"w-full sm:w-auto px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl text-sm sm:text-base shadow-sm transition-custom flex items-center justify-center gap-2\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n          Check Answers\n        </button>\n      </div>\n    </form>\n\n    <!-- Part C Reference Text (Requested by Professor) -->\n    <section class=\"mt-12 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm\">\n      <h3 class=\"text-base font-bold text-slate-900 mb-2 flex items-center gap-2\">\n        <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path>\n        </svg>\n        Part C: Reference & Grammar Note\n      </h3>\n      <p class=\"text-sm text-slate-600 leading-relaxed\">\n        When forming questions in English, remember the auxiliary order rule: <strong class=\"text-slate-800\">Q-W-S-A-V</strong> (<span class=\"text-indigo-600 font-medium\">Question Word, Auxiliary, Subject, Verb</span>). For continuous tenses, use forms of <em>be</em> (is/are/am/was/were). For simple tenses, use <em>do/does/did</em> in questions unless the main verb is <em>be</em> or a modal verb. When asking about the subject directly (e.g., item 10: <em>Who came...?</em>), no auxiliary verb is needed.\n      </p>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 mt-8\">\n    Interactive ELT Module &bull; Responsive Design &amp; Pedagogical Metrics\n  </footer>\n\n  <!-- Script & Activity Metrics Contract -->\n  <script>\n    // Pedagogical Metrics Contract (Mandatory)\n    window.ACTIVITY_METRICS = {\n      domain: 'Grammar',\n      skill: 'forming_questions',\n      maxScore: 11 // Total interactive questions (items 2 to 12)\n    };\n\n    function normalize(str) {\n      if (!str) return '';\n      return str.trim()\n                .toLowerCase()\n                .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g, \"\")\n                .replace(/\\s+/g, \" \");\n    }\n\n    function checkAnswers() {\n      const questionContainers = document.querySelectorAll('.question-container');\n      let correctCount = 0;\n      let totalCount = questionContainers.length;\n\n      questionContainers.forEach(container => {\n        const input = container.querySelector('input[type=\"text\"]');\n        const feedback = container.querySelector('.feedback-container');\n        \n        const userVal = input.value;\n        const normUser = normalize(userVal);\n        \n        const primaryAnswer = input.getAttribute('data-answer');\n        const altAnswer = input.getAttribute('data-alt1');\n        \n        const isCorrect = (normUser === normalize(primaryAnswer)) || (altAnswer && normUser === normalize(altAnswer));\n\n        // Styling updates\n        input.classList.remove('border-slate-300', 'border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n        feedback.classList.remove('hidden', 'text-emerald-600', 'text-rose-600');\n\n        if (isCorrect) {\n          correctCount++;\n          input.classList.add('border-emerald-500', 'bg-emerald-50');\n          feedback.classList.add('text-emerald-600');\n          feedback.innerHTML = '✓ Correct!';\n        } else {\n          input.classList.add('border-rose-500', 'bg-rose-50');\n          feedback.classList.add('text-rose-600');\n          feedback.innerHTML = `✗ Incorrect. Correct answer: <span class=\"font-normal underline\">${primaryAnswer}</span>`;\n        }\n      });\n\n      // Update UI Score\n      document.getElementById('current-score').textContent = correctCount;\n\n      // Dispatch Mandatory ELT Custom Event\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: totalCount,\n          completed: correctCount === totalCount\n        }\n      }));\n\n      // PostMessage for external frame wrappers\n      if (window.parent !== window) {\n        window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: totalCount }, '*');\n      }\n    }\n\n    function resetQuiz() {\n      const questionContainers = document.querySelectorAll('.question-container');\n      questionContainers.forEach(container => {\n        const input = container.querySelector('input[type=\"text\"]');\n        const feedback = container.querySelector('.feedback-container');\n\n        input.value = '';\n        input.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n        input.classList.add('border-slate-300');\n        \n        feedback.classList.add('hidden');\n        feedback.innerHTML = '';\n      });\n\n      document.getElementById('current-score').textContent = '0';\n\n      // Dispatch reset event update\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: 0,\n          total: questionContainers.length,\n          completed: false\n        }\n      }));\n    }\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793383846347,
      "title": "Vocabulary Practice: Preferences & Feelings",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Vocabulary Practice: Preferences & Feelings</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n        .input-gap {\n            transition: all 0.2s ease-in-out;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header with Score & Title -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-6 border-b w-full shadow-sm flex flex-wrap justify-between items-center gap-4\">\n        <div class=\"flex items-center space-x-2\">\n            <span class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z\" />\n                </svg>\n            </span>\n            <div>\n                <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">Vocabulary Builder</h1>\n                <p class=\"text-xs text-slate-500\">Fill in the gaps with one word expressing likes/dislikes.</p>\n            </div>\n        </div>\n\n        <div class=\"flex items-center space-x-3\">\n            <div class=\"bg-slate-100 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700 border border-slate-200\">\n                Score: <span id=\"score-display\" class=\"text-indigo-600 font-bold\">0</span> / <span id=\"total-display\">8</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Instructions Card -->\n        <div class=\"bg-indigo-50 border border-indigo-100 rounded-2xl p-4 sm:p-5 mb-6 shadow-sm flex items-start space-x-3\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6 text-indigo-600 flex-shrink-0 mt-0.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n            </svg>\n            <div class=\"text-sm text-indigo-900\">\n                <span class=\"font-semibold block mb-1\">Exercise 3: Fill in the gaps with one word.</span>\n                Type the correct missing word into each sentence gap. Pay attention to common collocations and expressions of preference.\n            </div>\n        </div>\n\n        <!-- Activity Form / Sentences -->\n        <form id=\"quiz-form\" class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-6 md:p-8 space-y-6\" onsubmit=\"event.preventDefault();\">\n            \n            <ol class=\"space-y-5 text-sm sm:text-base\">\n                \n                <!-- Item 1 (Example - read only) -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100 gap-2\">\n                    <span class=\"text-slate-700\"><strong>1</strong> He loves his new MP3 player. He thinks it's <span class=\"font-semibold text-indigo-700 underline decoration-indigo-300\">brilliant</span>.</span>\n                    <span class=\"text-xs bg-slate-200 text-slate-600 px-2 py-1 rounded w-fit self-start sm:self-auto\">Example</span>\n                </li>\n\n                <!-- Item 2 -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100 gap-2\">\n                    <span class=\"text-slate-700 flex-grow\"><strong>2</strong> Tania hates mobile phone ring tones. She just can't \n                        <input type=\"text\" data-answer=\"stand\" data-alts=\"bear\" class=\"input-gap mx-1 px-3 py-2 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none w-32 sm:w-36\" placeholder=\"type word...\" autocomplete=\"off\"> \n                        them.\n                    </span>\n                    <span id=\"feedback-2\" class=\"text-xs font-semibold px-2 py-1 rounded\"></span>\n                </li>\n\n                <!-- Item 3 -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100 gap-2\">\n                    <span class=\"text-slate-700 flex-grow\"><strong>3</strong> I'm very \n                        <input type=\"text\" data-answer=\"keen\" class=\"input-gap mx-1 px-3 py-2 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none w-32 sm:w-36\" placeholder=\"type word...\" autocomplete=\"off\"> \n                        on cooking. It's a great way to relax.\n                    </span>\n                    <span id=\"feedback-3\" class=\"text-xs font-semibold px-2 py-1 rounded\"></span>\n                </li>\n\n                <!-- Item 4 -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100 gap-2\">\n                    <span class=\"text-slate-700 flex-grow\"><strong>4</strong> Listening to other people's conversations really gets on my \n                        <input type=\"text\" data-answer=\"nerves\" class=\"input-gap mx-1 px-3 py-2 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none w-32 sm:w-36\" placeholder=\"type word...\" autocomplete=\"off\">.\n                    </span>\n                    <span id=\"feedback-4\" class=\"text-xs font-semibold px-2 py-1 rounded\"></span>\n                </li>\n\n                <!-- Item 5 -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100 gap-2\">\n                    <span class=\"text-slate-700 flex-grow\"><strong>5</strong> Computer games are OK, I suppose. I don't \n                        <input type=\"text\" data-answer=\"mind\" class=\"input-gap mx-1 px-3 py-2 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none w-32 sm:w-36\" placeholder=\"type word...\" autocomplete=\"off\"> \n                        them.\n                    </span>\n                    <span id=\"feedback-5\" class=\"text-xs font-semibold px-2 py-1 rounded\"></span>\n                </li>\n\n                <!-- Item 6 -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100 gap-2\">\n                    <span class=\"text-slate-700 flex-grow\"><strong>6</strong> My mum doesn't like loud music. It drives her \n                        <input type=\"text\" data-answer=\"crazy\" data-alts=\"mad\" class=\"input-gap mx-1 px-3 py-2 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none w-32 sm:w-36\" placeholder=\"type word...\" autocomplete=\"off\">.\n                    </span>\n                    <span id=\"feedback-6\" class=\"text-xs font-semibold px-2 py-1 rounded\"></span>\n                </li>\n\n                <!-- Item 7 -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100 gap-2\">\n                    <span class=\"text-slate-700 flex-grow\"><strong>7</strong> My sister loves exhibitions, but I don't like them at \n                        <input type=\"text\" data-answer=\"all\" class=\"input-gap mx-1 px-3 py-2 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none w-32 sm:w-36\" placeholder=\"type word...\" autocomplete=\"off\">.\n                    </span>\n                    <span id=\"feedback-7\" class=\"text-xs font-semibold px-2 py-1 rounded\"></span>\n                </li>\n\n                <!-- Item 8 -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100 gap-2\">\n                    <span class=\"text-slate-700 flex-grow\"><strong>8</strong> I'm very \n                        <input type=\"text\" data-answer=\"interested\" class=\"input-gap mx-1 px-3 py-2 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none w-32 sm:w-36\" placeholder=\"type word...\" autocomplete=\"off\"> \n                        in sailing.\n                    </span>\n                    <span id=\"feedback-8\" class=\"text-xs font-semibold px-2 py-1 rounded\"></span>\n                </li>\n\n                <!-- Item 9 -->\n                <li class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100 gap-2\">\n                    <span class=\"text-slate-700 flex-grow\"><strong>9</strong> Janet \n                        <input type=\"text\" data-answer=\"really\" class=\"input-gap mx-1 px-3 py-2 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none w-32 sm:w-36\" placeholder=\"type word...\" autocomplete=\"off\"> \n                        loves watching her children sleep.\n                    </span>\n                    <span id=\"feedback-9\" class=\"text-xs font-semibold px-2 py-1 rounded\"></span>\n                </li>\n\n            </ol>\n\n            <!-- Action Buttons -->\n            <div class=\"flex flex-wrap items-center justify-end gap-3 pt-4 border-t border-slate-100\">\n                <button type=\"button\" onclick=\"resetActivity()\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 font-medium text-slate-700 hover:bg-slate-100 transition min-h-[42px] flex items-center space-x-2\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    <span>Reset</span>\n                </button>\n                <button type=\"button\" onclick=\"checkAnswers()\" class=\"px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 font-medium text-white shadow-sm transition min-h-[42px] flex items-center space-x-2\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                    <span>Check Answers</span>\n                </button>\n            </div>\n\n        </form>\n\n    </main>\n\n    <!-- Footer / Reference Text Part C -->\n    <footer class=\"w-full bg-white border-t border-slate-200 mt-12 py-6 px-4 sm:px-8\">\n        <div class=\"max-w-4xl mx-auto text-xs text-slate-500 space-y-2\">\n            <p class=\"font-semibold text-slate-700 uppercase tracking-wider\">Additional Practice Notes / Reference Text:</p>\n            <p class=\"italic\">Practice expressing likes, dislikes, strong preferences, and annoyances using appropriate adjectives and prepositional phrases (keen on, interested in, can't stand, gets on my nerves).</p>\n        </div>\n    </footer>\n\n    <!-- Script Logic & Metrics -->\n    <script>\n        // Mandatory pedagogical metrics contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'preferences_and_feelings',\n            maxScore: 8\n        };\n\n        function checkAnswers() {\n            const inputs = document.querySelectorAll('#quiz-form input[data-answer]');\n            let correctCount = 0;\n\n            inputs.forEach((input, index) => {\n                const userVal = input.value.trim().toLowerCase();\n                const primaryAnswer = input.getAttribute('data-answer').toLowerCase();\n                const altAnswers = input.getAttribute('data-alts') ? input.getAttribute('data-alts').toLowerCase().split(',') : [];\n                \n                const allAccepted = [primaryAnswer, ...altAnswers];\n                const feedbackSpan = document.getElementById(`feedback-${index + 2}`);\n\n                if (allAccepted.includes(userVal)) {\n                    input.classList.remove('border-slate-300', 'border-red-500', 'bg-red-50');\n                    input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n                    if (feedbackSpan) {\n                        feedbackSpan.textContent = '✓ Correct';\n                        feedbackSpan.className = 'text-xs font-semibold px-2 py-1 rounded bg-emerald-100 text-emerald-800';\n                    }\n                    correctCount++;\n                } else {\n                    input.classList.remove('border-slate-300', 'border-emerald-500', 'bg-emerald-50');\n                    input.classList.add('border-red-500', 'bg-red-50', 'text-red-900');\n                    if (feedbackSpan) {\n                        feedbackSpan.textContent = `✗ (${primaryAnswer})`;\n                        feedbackSpan.className = 'text-xs font-semibold px-2 py-1 rounded bg-red-100 text-red-800';\n                    }\n                }\n            });\n\n            // Update UI Score\n            document.getElementById('score-display').textContent = correctCount;\n\n            // Dispatch mandatory metrics event for live session integration\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: inputs.length,\n                    completed: correctCount === inputs.length\n                }\n            }));\n\n            // Legacy postMessage support\n            if (window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: inputs.length }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const inputs = document.querySelectorAll('#quiz-form input[data-answer]');\n            inputs.forEach((input, index) => {\n                input.value = '';\n                input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900');\n                input.classList.add('border-slate-300');\n                \n                const feedbackSpan = document.getElementById(`feedback-${index + 2}`);\n                if (feedbackSpan) {\n                    feedbackSpan.textContent = '';\n                    feedbackSpan.className = 'text-xs font-semibold px-2 py-1 rounded';\n                }\n            });\n\n            document.getElementById('score-display').textContent = '0';\n\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: 0,\n                    total: inputs.length,\n                    completed: false\n                }\n            }));\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793383928630,
      "title": "Grammar Practice: Making Sentences Negative",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Grammar Practice: Making Sentences Negative</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2\">\n            <div class=\"flex items-center gap-2\">\n                <span class=\"bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wide\">Grammar</span>\n                <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">Make these sentences negative</h1>\n            </div>\n            <div class=\"flex items-center gap-3\">\n                <div class=\"text-sm font-semibold text-slate-600 bg-slate-100 px-3 py-1 rounded-full border border-slate-200\">\n                    Score: <span id=\"score-display\" class=\"text-indigo-600 font-bold\">0</span> / <span id=\"total-display\">10</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Instructions Card -->\n        <div class=\"bg-indigo-50 border border-indigo-100 rounded-xl p-4 sm:p-5 mb-6 shadow-sm\">\n            <div class=\"flex items-start gap-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-lg mt-0.5 shrink-0\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                </div>\n                <div>\n                    <h2 class=\"font-semibold text-indigo-900 text-base\">Exercise 4: Negative transformations</h2>\n                    <p class=\"text-indigo-700 text-sm mt-1\">Make these sentences negative by changing the words/phrases in bold. Type your completed negative sentences in the input fields below.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Activity Form / List -->\n        <form id=\"grammar-form\" class=\"space-y-4\" onsubmit=\"event.preventDefault();\">\n            \n            <!-- Example (Item 1) -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm opacity-90\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-200 text-slate-700 text-xs font-bold px-2 py-1 rounded shrink-0\">1</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700\">I <strong class=\"text-slate-900\">like</strong> watching sport on TV.</p>\n                        <div class=\"mt-2 text-sm italic text-slate-500 bg-slate-50 p-2 rounded border border-slate-200\">\n                            ➔ I don't like watching sport on TV. <span class=\"text-xs bg-emerald-100 text-emerald-800 font-semibold px-2 py-0.5 rounded ml-2 not-italic\">Example</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">2</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\">They <strong class=\"text-indigo-600 font-semibold\">are playing</strong> tennis at the moment.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"They aren't playing tennis at the moment.\"\n                            data-alts=\"they are not playing tennis at the moment\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">3</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\">Alice <strong class=\"text-indigo-600 font-semibold\">lives</strong> with her parents.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"Alice doesn't live with her parents.\"\n                            data-alts=\"alice does not live with her parents\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">4</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\"><strong class=\"text-indigo-600 font-semibold\">All</strong> of my friends can drive.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"None of my friends can drive.\"\n                            data-alts=\"none of my friends can drive\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">5</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\">John's <strong class=\"text-indigo-600 font-semibold\">been</strong> to Italy before.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"John hasn't been to Italy before.\"\n                            data-alts=\"john has not been to italy before\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">6</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\"><strong class=\"text-indigo-600 font-semibold\">Everyone</strong> in my family likes football.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"No one in my family likes football.\"\n                            data-alts=\"nobody in my family likes football\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">7</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\">I <strong class=\"text-indigo-600 font-semibold\">usually</strong> go out on Friday evenings.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"I don't usually go out on Friday evenings.\"\n                            data-alts=\"i do not usually go out on friday evenings\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">8</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\"><strong class=\"text-indigo-600 font-semibold\">Both</strong> of my sisters <strong class=\"text-indigo-600 font-semibold\">have</strong> a car.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"Neither of my sisters has a car.\"\n                            data-alts=\"neither of my sisters has got a car\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 9 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">9</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\">They<strong class=\"text-indigo-600 font-semibold\">'ve seen</strong> him before.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"They haven't seen him before.\"\n                            data-alts=\"they have not seen him before\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 10 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">10</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\">I <strong class=\"text-indigo-600 font-semibold\">saw</strong> Rupert last night.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"I didn't see Rupert last night.\"\n                            data-alts=\"i did not see rupert last night\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 11 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm transition-all\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-800 text-white text-xs font-bold px-2 py-1 rounded shrink-0 mt-2\">11</span>\n                    <div class=\"w-full\">\n                        <p class=\"text-sm sm:text-base text-slate-700 mb-2\">I<strong class=\"text-indigo-600 font-semibold\">'m going</strong> out tonight.</p>\n                        <input type=\"text\" \n                            class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2.5 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\"\n                            placeholder=\"Type the negative sentence...\"\n                            data-answer=\"I'm not going out tonight.\"\n                            data-alts=\"i am not going out tonight\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"flex flex-wrap items-center justify-end gap-3 pt-4\">\n                <button type=\"button\" onclick=\"resetActivity()\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 font-medium text-slate-700 bg-white hover:bg-slate-100 transition-colors min-h-[42px]\">\n                    🔄 Reset\n                </button>\n                <button type=\"button\" onclick=\"checkAnswers()\" class=\"px-6 py-2.5 rounded-xl font-medium text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition-colors min-h-[42px]\">\n                    ✓ Check Answers\n                </button>\n            </div>\n        </form>\n\n        <!-- Reference Section Part C -->\n        <section class=\"mt-10 bg-white border border-slate-200 rounded-xl p-5 shadow-sm\">\n            <h3 class=\"text-md font-bold text-slate-900 mb-2 flex items-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                </svg>\n                Additional Reference Note (Part C)\n            </h3>\n            <p class=\"text-slate-600 text-sm leading-relaxed\">\n                Pay careful attention to auxiliary verbs (do/does/did, have/has, be) and quantifier opposites (all ➔ none, everyone ➔ no one, both ➔ neither). When transforming sentences into the negative form, ensure that tense and agreement remain consistent throughout the structure.\n            </p>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-slate-200 py-4 px-6 text-center text-xs text-slate-500\">\n        Interactive ELT Activity &bull; Designed for Responsive Touch Interfaces\n    </footer>\n\n    <!-- Script Logic -->\n    <script>\n        // Metrics Contract Declaration\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'negative_sentence_transformations',\n            maxScore: 10\n        };\n\n        function normalizeText(text) {\n            return text.toLowerCase()\n                       .replace(/['‘’]/g, \"'\")\n                       .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()?]/g,\"\")\n                       .replace(/\\s{2,}/g,\" \")\n                       .trim();\n        }\n\n        function checkAnswers() {\n            const inputs = document.querySelectorAll('#grammar-form input[data-answer]');\n            let correctCount = 0;\n            const total = inputs.length;\n\n            inputs.forEach(input => {\n                const userVal = normalizeText(input.value);\n                const primaryAns = normalizeText(input.getAttribute('data-answer'));\n                const altAttrs = input.getAttribute('data-alts') || '';\n                const alts = altAttrs.split('|').map(a => normalizeText(a));\n\n                input.classList.remove('is-correct', 'is-wrong');\n\n                if (userVal === primaryAns || alts.includes(userVal)) {\n                    input.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    input.classList.add('is-wrong');\n                }\n            });\n\n            // Update UI Score\n            document.getElementById('score-display').textContent = correctCount;\n            document.getElementById('total-display').textContent = total;\n\n            // Dispatch Custom Event for platform tracking\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: total,\n                    completed: correctCount === total\n                }\n            }));\n\n            // Post message for parent frame integration\n            if (window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: total }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const inputs = document.querySelectorAll('#grammar-form input[data-answer]');\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('is-correct', 'is-wrong');\n            });\n            document.getElementById('score-display').textContent = '0';\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793384001087,
      "title": "Complete these adjectives - ELT Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Complete these adjectives - ELT Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Top Bar for Header & Score -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-6 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z\" />\n                    </svg>\n                </div>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Complete these adjectives</h1>\n                    <p class=\"text-xs text-slate-500\">Vocabulary Practice • Feelings & Emotions</p>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center gap-3\">\n                <div id=\"score-badge\" class=\"bg-slate-100 px-3 py-1.5 rounded-xl text-sm font-semibold text-slate-700 border border-slate-200\">\n                    Score: <span id=\"current-score\">0</span> / <span id=\"max-score\">10</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Instructions / Context Card -->\n        <div class=\"bg-indigo-50 border border-indigo-100 rounded-2xl p-4 sm:p-5 mb-6 shadow-sm\">\n            <div class=\"flex items-start gap-3\">\n                <div class=\"bg-indigo-500 text-white p-1.5 rounded-lg mt-0.5 flex-shrink-0\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                </div>\n                <div>\n                    <h2 class=\"text-sm font-bold text-indigo-900 uppercase tracking-wide\">Instructions</h2>\n                    <p class=\"text-sm text-indigo-700 mt-0.5\">Complete the missing letters to form the correct adjective based on the context of each sentence. Item 1 is already completed as an example.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Activity Form / Exercise List -->\n        <form id=\"quiz-form\" class=\"space-y-4 sm:space-y-5\" onsubmit=\"return false;\">\n            \n            <!-- Item 1 (Example) -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 opacity-80\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">1</span>\n                    <p class=\"text-sm sm:text-base text-slate-700\">\n                        I always feel extremely <span class=\"font-semibold text-emerald-700 underline decoration-emerald-300\">relaxed</span> after I've been swimming. <span class=\"text-xs text-slate-400 italic\">(Example)</span>\n                    </p>\n                </div>\n                <div class=\"bg-slate-100 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-500 text-right sm:w-auto\">Completed</div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">2</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>Wendy was u</span>\n                        <input type=\"text\" data-answer=\"pset\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition-colors\" placeholder=\"...about\">\n                        <span>about the news. She was crying after she heard it.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">3</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>Rosie feels fr</span>\n                        <input type=\"text\" data-answer=\"ustrated\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition-colors\" placeholder=\"...when\">\n                        <span>when her boss doesn't listen to her.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">4</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>He felt e</span>\n                        <input type=\"text\" data-answer=\"mbarrassed\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition-colors\" placeholder=\"...when\">\n                        <span>when my brother got angry and shouted at everyone.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">5</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>Isabel is quite n</span>\n                        <input type=\"text\" data-answer=\"ervous\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition-colors\" placeholder=\"...about\">\n                        <span>about the interview.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">6</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>I'm very g</span>\n                        <input type=\"text\" data-answer=\"lad\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 sm:w-40 transition-colors\" placeholder=\"...you\">\n                        <span>you all enjoyed the meal.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">7</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>Edward was very d</span>\n                        <input type=\"text\" data-answer=\"epressed\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition-colors\" placeholder=\"...when\">\n                        <span>when he heard that he didn't get the job.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">8</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>Is everything OK, son? Your mother and I are quite c</span>\n                        <input type=\"text\" data-answer=\"oncerned\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition-colors\" placeholder=\"...about\">\n                        <span>about you.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 9 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">9</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>After watching that horror film I was so s</span>\n                        <input type=\"text\" data-answer=\"cared\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 sm:w-40 transition-colors\" placeholder=\"...I\">\n                        <span>I couldn't sleep.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 10 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">10</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>Kate gets very s</span>\n                        <input type=\"text\" data-answer=\"tressed\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition-colors\" placeholder=\"...when\">\n                        <span>when she has too much to do. She should calm down a bit.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Item 11 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 flex-grow\">\n                    <span class=\"flex-shrink-0 bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center mt-0.5\">11</span>\n                    <p class=\"text-sm sm:text-base text-slate-700 flex flex-wrap items-center gap-1.5\">\n                        <span>I was sh</span>\n                        <input type=\"text\" data-answer=\"ocked\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 sm:w-40 transition-colors\" placeholder=\"...to\">\n                        <span>to hear that you lost your job.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Action Buttons Bar -->\n            <div class=\"flex flex-wrap items-center justify-between gap-3 pt-4\">\n                <button type=\"button\" id=\"reset-btn\" class=\"w-full sm:w-auto px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-100 active:bg-slate-200 transition-colors flex items-center justify-center gap-2 min-h-[42px]\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    Reset Answers\n                </button>\n                <button type=\"button\" id=\"check-btn\" class=\"w-full sm:w-auto px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 active:bg-indigo-800 transition-colors shadow-sm flex items-center justify-center gap-2 min-h-[42px]\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                    Check Answers\n                </button>\n            </div>\n        </form>\n\n        <!-- Additional Part C Text Section (as requested by teacher notes) -->\n        <div class=\"mt-10 bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm\">\n            <h3 class=\"text-sm font-bold text-slate-900 uppercase tracking-wide mb-3 flex items-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.747 0-3.332.477-4.5 1.253\" />\n                </svg>\n                Part C: Further Practice / Reference Context\n            </h3>\n            <p class=\"text-sm text-slate-600 leading-relaxed\">\n                When talking about emotional states, adjectives ending in <strong class=\"text-slate-800\">-ed</strong> (e.g., <em>frustrated, embarrassed, depressed, concerned, scared, stressed, shocked</em>) describe how a person feels. Conversely, adjectives ending in <strong class=\"text-slate-800\">-ing</strong> describe the situation, event, or person that causes the feeling. Pay close attention to context clues such as physical reactions (crying, shouting, sleeping problems) to select the exact vocabulary term required.\n            </p>\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full py-4 px-6 text-center text-xs text-slate-400 border-t bg-white mt-10\">\n        Interactive ELT Learning Module • Responsive Touch UI\n    </footer>\n\n    <!-- Script Logic -->\n    <script>\n        // Mandatory Metrics Contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'complete_adjectives_feelings',\n            maxScore: 10\n        };\n\n        document.getElementById('max-score').textContent = window.ACTIVITY_METRICS.maxScore;\n\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const inputs = document.querySelectorAll('input[data-answer]');\n        const currentScoreEl = document.getElementById('current-score');\n\n        function normalize(str) {\n            return str.trim().toLowerCase();\n        }\n\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n\n            inputs.forEach(input => {\n                const expected = normalize(input.getAttribute('data-answer'));\n                const userVal = normalize(input.value);\n\n                input.classList.remove('is-correct', 'is-wrong');\n\n                if (userVal === expected) {\n                    input.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    input.classList.add('is-wrong');\n                }\n            });\n\n            currentScoreEl.textContent = correctCount;\n\n            // Dispatch custom analytics event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: inputs.length,\n                    completed: correctCount === inputs.length\n                }\n            }));\n\n            // Post message for parent frame embedding\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: inputs.length\n                }, '*');\n            }\n        });\n\n        resetBtn.addEventListener('click', () => {\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('is-correct', 'is-wrong');\n            });\n            currentScoreEl.textContent = '0';\n\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: 0,\n                    total: inputs.length,\n                    completed: false\n                }\n            }));\n\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: 0,\n                    total: inputs.length\n                }, '*');\n            }\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793384153821,
      "title": "Prepositions Practice - Choose the Correct Word",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Prepositions Practice - Choose the Correct Word</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom smooth transitions and states */\n        .option-btn {\n            transition: all 0.2s ease-in-out;\n        }\n        .is-correct {\n            background-color: #d1fae5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fee2e2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header / Activity Title -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </div>\n                <div>\n                    <h1 class=\"text-lg sm:text-xl font-bold text-slate-900\">Choose the correct word</h1>\n                    <p class=\"text-xs sm:text-sm text-slate-500\">Grammar Focus: Adjective & Verb Prepositions</p>\n                </div>\n            </div>\n            <div id=\"score-display\" class=\"bg-indigo-50 border border-indigo-100 text-indigo-700 px-3.5 py-1.5 rounded-full text-sm font-semibold shadow-inner\">\n                Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">11</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Instructions Card -->\n        <div class=\"bg-white border border-slate-200 rounded-2xl p-5 mb-6 shadow-sm\">\n            <div class=\"flex items-start space-x-3\">\n                <span class=\"bg-slate-800 text-white text-sm font-bold w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">6</span>\n                <div>\n                    <h2 class=\"font-semibold text-slate-800 text-base sm:text-lg\">Select the correct preposition for each sentence.</h2>\n                    <p class=\"text-slate-500 text-sm mt-0.5\">Click or tap on the right option among the choices given in each sentence.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Exercise Items List -->\n        <div id=\"exercise-form\" class=\"space-y-4\">\n            \n            <!-- Item 1 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"1\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">1.</span> My cousin George is really good \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"at\">at</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"with\">with</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"by\">by</button>\n                        </span>\n                        football.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"2\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">2.</span> Veronica's getting fed up \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"for\">for</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"with\">with</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"by\">by</button>\n                        </span>\n                        working at the weekend.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"3\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">3.</span> Jonathan's boss was quite angry \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"with\">with</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"about\">about</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"on\">on</button>\n                        </span>\n                        him during the meeting.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"4\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">4.</span> My granddaughter is very worried \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"for\">for</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"on\">on</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"about\">about</button>\n                        </span>\n                        her driving test.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"5\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">5.</span> We were very surprised \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"of\">of</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"on\">on</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"by\">by</button>\n                        </span>\n                        the letter we received yesterday.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"6\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">6.</span> I don't think Joanne's very satisfied \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"with\">with</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"on\">on</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"at\">at</button>\n                        </span>\n                        her new mobile.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"7\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">7.</span> My brother is very bad \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"for\">for</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"of\">of</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"at\">at</button>\n                        </span>\n                        maths.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"8\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">8.</span> Dave is bored \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"for\">for</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"about\">about</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"with\">with</button>\n                        </span>\n                        his new course.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 9 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"9\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">9.</span> Tim's daughter is frightened \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"of\">of</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"from\">from</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"about\">about</button>\n                        </span>\n                        the dark.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 10 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"10\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">10.</span> My English teacher was very pleased \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"of\">of</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"on\">on</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"with\">with</button>\n                        </span>\n                        my test results.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 11 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm transition-all hover:border-slate-300 exercise-item\" data-id=\"11\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-base text-slate-800 font-medium leading-relaxed\">\n                        <span class=\"text-slate-400 font-semibold mr-2\">11.</span> We were really angry \n                        <span class=\"inline-flex flex-wrap gap-1.5 my-1 sm:my-0 mx-1 align-middle\">\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"correct\" data-value=\"with\">with</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"by\">by</button>\n                            <button type=\"button\" class=\"option-btn px-3 py-1.5 text-sm font-medium border border-slate-300 rounded-lg bg-white hover:bg-slate-50 active:scale-95\" data-answer=\"wrong\" data-value=\"about\">about</button>\n                        </span>\n                        what happened.\n                    </div>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- Action Controls -->\n        <div class=\"mt-8 flex flex-col sm:flex-row items-center justify-center gap-4\">\n            <button id=\"check-btn\" type=\"button\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-8 py-3 rounded-xl shadow-md transition-all active:scale-95 flex items-center justify-center space-x-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                <span>Check Answers</span>\n            </button>\n            <button id=\"reset-btn\" type=\"button\" class=\"w-full sm:w-auto bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-8 py-3 rounded-xl transition-all active:scale-95 flex items-center justify-center space-x-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                </svg>\n                <span>Reset Activity</span>\n            </button>\n        </div>\n\n    </main>\n\n    <!-- Footer / Part C inclusion as requested -->\n    <footer class=\"bg-white border-t border-slate-200 mt-12 py-6 px-4\">\n        <div class=\"max-w-4xl mx-auto text-slate-600 text-sm space-y-3\">\n            <h3 class=\"font-bold text-slate-800 text-base flex items-center space-x-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                </svg>\n                <span>Part C Note & Reference</span>\n            </h3>\n            <p class=\"leading-relaxed\">\n                Remember that adjectives and passive verbs are frequently followed by specific prepositions (e.g., <em>good at</em>, <em>fed up with</em>, <em>angry with</em>, <em>frightened of</em>). Keep practicing these collocations in context to improve your fluency and natural expression.\n            </p>\n        </div>\n    </footer>\n\n    <!-- Interactive Logic Script -->\n    <script>\n        // Mandatory Metrics Declaration\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'prepositions_after_adjectives_verbs',\n            maxScore: 11\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const exerciseItems = document.querySelectorAll('.exercise-item');\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const currentScoreSpan = document.getElementById('current-score');\n            const totalScoreSpan = document.getElementById('total-score');\n\n            totalScoreSpan.textContent = exerciseItems.length;\n\n            // Handle option selection within each item\n            exerciseItems.forEach(item => {\n                const buttons = item.querySelectorAll('.option-btn');\n                buttons.forEach(btn => {\n                    btn.addEventListener('click', () => {\n                        // Deselect all buttons in this item\n                        buttons.forEach(b => {\n                            b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-sm');\n                            b.classList.add('bg-white', 'text-slate-800', 'border-slate-300');\n                        });\n                        // Select clicked button\n                        btn.classList.remove('bg-white', 'text-slate-800', 'border-slate-300');\n                        btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-sm');\n                        btn.dataset.selected = 'true';\n                        \n                        // Clear selection state from other buttons\n                        buttons.forEach(b => {\n                            if (b !== btn) delete b.dataset.selected;\n                        });\n                    });\n                });\n            });\n\n            // Check Answers Logic\n            checkBtn.addEventListener('click', () => {\n                let correctCount = 0;\n                let answeredCount = 0;\n\n                exerciseItems.forEach(item => {\n                    const buttons = item.querySelectorAll('.option-btn');\n                    let itemAnswered = false;\n\n                    buttons.forEach(btn => {\n                        // Reset previous feedback classes\n                        btn.classList.remove('is-correct', 'is-wrong');\n\n                        if (btn.dataset.selected === 'true') {\n                            itemAnswered = true;\n                            if (btn.dataset.answer === 'correct') {\n                                btn.classList.add('is-correct');\n                                correctCount++;\n                            } else {\n                                btn.classList.add('is-wrong');\n                            }\n                        }\n\n                        // Always highlight the correct answer so learners see it clearly after checking\n                        if (btn.dataset.answer === 'correct' && btn.dataset.selected !== 'true') {\n                            btn.style.borderColor = '#059669';\n                            btn.style.borderStyle = 'dashed';\n                        }\n                    });\n                });\n\n                currentScoreSpan.textContent = correctCount;\n\n                // Dispatch mandatory custom event for live session analytics\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: exerciseItems.length,\n                        completed: correctCount === exerciseItems.length\n                    }\n                }));\n\n                // Post message for parent frame integration\n                if (window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: exerciseItems.length\n                    }, '*');\n                }\n            });\n\n            // Reset Logic\n            resetBtn.addEventListener('click', () => {\n                exerciseItems.forEach(item => {\n                    const buttons = item.querySelectorAll('.option-btn');\n                    buttons.forEach(btn => {\n                        btn.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-sm', 'is-correct', 'is-wrong');\n                        btn.classList.add('bg-white', 'text-slate-800', 'border-slate-300');\n                        btn.style.borderStyle = 'solid';\n                        delete btn.dataset.selected;\n                    });\n                });\n                currentScoreSpan.textContent = '0';\n            });\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793384258886,
      "title": "At a Barbecue - Grammar Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>At a Barbecue - Grammar Practice</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between antialiased\">\n\n    <!-- Sticky Header / Toolbar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n            <div class=\"flex items-center space-x-3\">\n                <span class=\"bg-indigo-600 text-white p-2 rounded-xl text-sm font-bold shadow-sm\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z\"/>\n                    </svg>\n                </span>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Conversation at a Barbecue</h1>\n                    <p class=\"text-xs text-slate-500\">Fill in the gaps with a question tag or a short answer.</p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 ml-auto\">\n                <div id=\"score-display\" class=\"text-xs sm:text-sm font-semibold bg-slate-100 text-slate-700 py-1.5 px-3 rounded-lg border border-slate-200\">\n                    Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">11</span>\n                </div>\n                <button id=\"reset-btn\" class=\"p-2 rounded-xl border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition active:scale-95 text-xs font-medium flex items-center gap-1 shadow-sm\" title=\"Reset Activity\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\n                    <span class=\"hidden sm:inline\">Reset</span>\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n\n        <!-- Visual Context: Student Image -->\n        <div class=\"mb-6 bg-white p-3 rounded-2xl border border-slate-200 shadow-sm flex justify-center items-center overflow-visible\">\n            <img src=\"data:image/png;base64,\" alt=\"People talking at a barbecue party\" class=\"max-h-64 md:max-h-72 w-auto mx-auto object-contain rounded-xl shadow-sm block\">\n            <p class=\"text-xs text-center text-slate-500 mt-2 italic w-full\">Scene from the conversation: A barbecue gathering outdoors.</p>\n        </div>\n\n        <!-- Instructions & Context Card -->\n        <div class=\"bg-indigo-50/60 border border-indigo-100 rounded-2xl p-4 sm:p-5 mb-6 text-slate-700\">\n            <div class=\"flex gap-3\">\n                <div class=\"text-indigo-600 mt-0.5\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                        <path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z\" clip-rule=\"evenodd\"/>\n                    </svg>\n                </div>\n                <div>\n                    <h2 class=\"font-semibold text-indigo-900 text-sm sm:text-base\">Grammar Focus: Question Tags & Short Answers</h2>\n                    <p class=\"text-xs sm:text-sm text-indigo-700/80 mt-0.5\">Read the dialogue between Caroline and her friend at the party. Complete gaps 2 to 12 carefully using correct punctuation and forms.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Dialogue Container -->\n        <div class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-6 space-y-4\">\n\n            <!-- Turn 1 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-sky-100 text-sky-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">A</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span>Hello. It’s Caroline,</span>\n                    <span class=\"inline-flex items-center gap-1 bg-slate-100 px-2.5 py-1 rounded-lg text-slate-800 font-medium text-sm border border-slate-200\">\n                        1. isn't it <span class=\"text-xs text-emerald-600 font-semibold\">(given)</span>\n                    </span>\n                    <span>?</span>\n                </div>\n            </div>\n\n            <!-- Turn 2 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-pink-100 text-pink-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">B</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span class=\"text-emerald-600 font-bold\">✓</span>\n                    <span class=\"text-slate-400 font-bold\">2.</span>\n                    <input type=\"text\" data-answer=\"Yes, it is\" placeholder=\"e.g. Yes, it is\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition\">\n                    <span>. How are you?</span>\n                </div>\n            </div>\n\n            <!-- Turn 3 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-sky-100 text-sky-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">A</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span>I’m fine, thank you. We met last summer,</span>\n                    <span class=\"text-slate-400 font-bold\">3.</span>\n                    <input type=\"text\" data-answer=\"didn't we\" placeholder=\"tag...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 sm:w-36 transition\">\n                    <span>?</span>\n                </div>\n            </div>\n\n            <!-- Turn 4 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-pink-100 text-pink-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">B</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span class=\"text-emerald-600 font-bold\">✓</span>\n                    <span class=\"text-slate-400 font-bold\">4.</span>\n                    <input type=\"text\" data-answer=\"Yes, we did\" placeholder=\"short answer...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition\">\n                    <span>. It was at Steve’s party, I think.</span>\n                </div>\n            </div>\n\n            <!-- Turn 5 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-sky-100 text-sky-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">A</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span>That’s right. Have you seen him recently?</span>\n                </div>\n            </div>\n\n            <!-- Turn 6 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-pink-100 text-pink-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">B</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span class=\"text-rose-500 font-bold\">✗</span>\n                    <span class=\"text-slate-400 font-bold\">5.</span>\n                    <input type=\"text\" data-answer=\"No, I haven't\" data-alt=\"No, I have not\" placeholder=\"short answer...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-40 sm:w-48 transition\">\n                    <span>. He’s at university in Edinburgh.</span>\n                </div>\n            </div>\n\n            <!-- Turn 7 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-sky-100 text-sky-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">A</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span>That’s right. I remember now. He studies medicine,</span>\n                    <span class=\"text-slate-400 font-bold\">6.</span>\n                    <input type=\"text\" data-answer=\"doesn't he\" placeholder=\"tag...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 sm:w-36 transition\">\n                    <span>?</span>\n                </div>\n            </div>\n\n            <!-- Turn 8 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-pink-100 text-pink-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">B</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span class=\"text-emerald-600 font-bold\">✓</span>\n                    <span class=\"text-slate-400 font-bold\">7.</span>\n                    <input type=\"text\" data-answer=\"Yes, he does\" placeholder=\"short answer...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition\">\n                    <span>. He’s in his second year. He’s really enjoying it.</span>\n                </div>\n            </div>\n\n            <!-- Turn 9 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-sky-100 text-sky-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">A</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span>What about his brothers? They haven't left school yet,</span>\n                    <span class=\"text-slate-400 font-bold\">8.</span>\n                    <input type=\"text\" data-answer=\"have they\" placeholder=\"tag...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 sm:w-36 transition\">\n                    <span>?</span>\n                </div>\n            </div>\n\n            <!-- Turn 10 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-pink-100 text-pink-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">B</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span class=\"text-emerald-600 font-bold\">✓</span>\n                    <span class=\"text-slate-400 font-bold\">9.</span>\n                    <input type=\"text\" data-answer=\"Yes, they have\" placeholder=\"short answer...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition\">\n                    <span>, actually. They’re working abroad.</span>\n                </div>\n            </div>\n\n            <!-- Turn 11 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-sky-100 text-sky-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">A</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span>Oh yes, I remember. They’re teaching English in Japan,</span>\n                    <span class=\"text-slate-400 font-bold\">10.</span>\n                    <input type=\"text\" data-answer=\"aren't they\" data-alt=\"are not they\" placeholder=\"tag...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 sm:w-36 transition\">\n                    <span>?</span>\n                </div>\n            </div>\n\n            <!-- Turn 12 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-pink-100 text-pink-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">B</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span class=\"text-rose-500 font-bold\">✗</span>\n                    <span class=\"text-slate-400 font-bold\">11.</span>\n                    <input type=\"text\" data-answer=\"No, they aren't\" data-alt=\"No, they are not\" placeholder=\"short answer...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-44 transition\">\n                    <span>, actually. They’re working in Argentina now.</span>\n                </div>\n            </div>\n\n            <!-- Turn 13 -->\n            <div class=\"flex items-start gap-3 dialogue-pair p-2.5 rounded-xl hover:bg-slate-50/50 transition\">\n                <span class=\"flex-shrink-0 bg-sky-100 text-sky-800 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider\">A</span>\n                <div class=\"text-sm sm:text-base text-slate-700 flex-grow leading-relaxed flex flex-wrap items-center gap-2\">\n                    <span>Really? How interesting. Oh dear, I’m asking a lot of questions,</span>\n                    <span class=\"text-slate-400 font-bold\">12.</span>\n                    <input type=\"text\" data-answer=\"aren't I\" data-alt=\"are not I\" placeholder=\"tag...\" class=\"gap-input bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 sm:w-36 transition\">\n                    <span>? Tell me about yourself. What do you do?</span>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- Action Buttons Bar -->\n        <div class=\"mt-6 flex flex-wrap items-center justify-center gap-3\">\n            <button id=\"check-btn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-md transition transform active:scale-95 text-sm sm:text-base flex items-center justify-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/></svg>\n                Check Answers\n            </button>\n        </div>\n\n        <!-- Part C / Additional Reference Text Section requested by teacher -->\n        <div class=\"mt-8 bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm\">\n            <h3 class=\"text-sm sm:text-base font-bold text-slate-900 mb-2 flex items-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"/></svg>\n                Reference Notes & Additional Practice\n            </h3>\n            <p class=\"text-xs sm:text-sm text-slate-600 leading-relaxed\">\n                Remember that question tags change polarity: if the main clause is positive, the question tag is negative (e.g., <em>You like parties, don't you?</em>). If the main clause is negative, the tag is positive (e.g., <em>They haven't left, have they?</em>). Short answers match the auxiliary verb of the question asked (e.g., <em>Have you...? Yes, I have. / Is it...? Yes, it is.</em>).\n            </p>\n        </div>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full border-t border-slate-200 bg-white py-4 mt-8 text-center text-xs text-slate-400\">\n        Interactive ELT Activity &bull; Designed for Mobile and Desktop\n    </footer>\n\n    <!-- Script / Metrics / Validation Logic -->\n    <script>\n        // Mandatory Metrics Contract Declaration\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'question_tags_and_short_answers',\n            maxScore: 11\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const inputs = document.querySelectorAll('.gap-input');\n            const currentScoreSpan = document.getElementById('current-score');\n            const totalScoreSpan = document.getElementById('total-score');\n            \n            totalScoreSpan.textContent = inputs.length;\n\n            function normalize(text) {\n                return text.trim().toLowerCase().replace(/['']/g, \"'\").replace(/\\s+/g, ' ');\n            }\n\n            function checkAnswers() {\n                let correctCount = 0;\n\n                inputs.forEach(input => {\n                    const userVal = normalize(input.value);\n                    const primaryAns = normalize(input.getAttribute('data-answer'));\n                    const altAttr = input.getAttribute('data-alt');\n                    \n                    let isMatch = (userVal === primaryAns);\n                    if (!isMatch && altAttr) {\n                        const alts = altAttr.split('|').map(a => normalize(a));\n                        if (alts.includes(userVal)) {\n                            isMatch = true;\n                        }\n                    }\n\n                    input.classList.remove('is-correct', 'is-wrong');\n                    if (userVal === '') {\n                        // Leave neutral if empty\n                    } else if (isMatch) {\n                        input.classList.add('is-correct');\n                        correctCount++;\n                    } else {\n                        input.classList.add('is-wrong');\n                    }\n                });\n\n                currentScoreSpan.textContent = correctCount;\n\n                // Dispatch mandatory Custom Event\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                // Post message for parent frame embedding\n                if (window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: inputs.length\n                    }, '*');\n                }\n            }\n\n            function resetActivity() {\n                inputs.forEach(input => {\n                    input.value = '';\n                    input.classList.remove('is-correct', 'is-wrong');\n                });\n                currentScoreSpan.textContent = '0';\n                \n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: inputs.length,\n                        completed: false\n                    }\n                }));\n            }\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n\n            // Allow Enter key to trigger check\n            inputs.forEach(input => {\n                input.addEventListener('keydown', (e) => {\n                    if (e.key === 'Enter') {\n                        checkAnswers();\n                    }\n                });\n            });\n        });\n    </script>\n</body>\n</html>"
    }
  ]
}