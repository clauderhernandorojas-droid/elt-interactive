{
  "version": "2.0",
  "title": "Int SB U2 Lesson B",
  "updatedAt": "2026-11-01T19:47:00.007Z",
  "slides": [
    {
      "id": 1793554459898,
      "title": "Vocabulary: In the kitchen",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Vocabulary: In the kitchen</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen py-6 px-3 sm:px-6\">\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-12\">\n        \n        <!-- Header Banner -->\n        <header class=\"bg-emerald-700 text-white p-6 sm:p-8\">\n            <div class=\"flex items-center gap-3 mb-2\">\n                <span class=\"bg-emerald-800 text-emerald-100 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider\">Vocabulary</span>\n                <span class=\"text-emerald-200 text-sm font-medium\">In the kitchen</span>\n            </div>\n            <h1 class=\"text-2xl sm:text-3xl font-bold tracking-tight\">Discussion & Practice</h1>\n            <p class=\"text-emerald-100 text-sm sm:text-base mt-1\">Explore vocabulary and talk about your cooking habits and favorite meals.</p>\n        </header>\n\n        <!-- Content Area -->\n        <div class=\"p-4 sm:p-8 space-y-8\">\n            \n            <!-- Activity 1: Discussion Questions -->\n            <section class=\"bg-slate-50 border border-slate-200 rounded-xl p-5 sm:p-6 shadow-sm\">\n                <div class=\"flex items-center gap-3 mb-4\">\n                    <div class=\"w-8 h-8 rounded-full bg-emerald-700 text-white flex items-center justify-center font-bold text-sm\">1</div>\n                    <h2 class=\"text-lg font-semibold text-slate-900\">Work in groups. Discuss these questions.</h2>\n                </div>\n                <p class=\"text-xs sm:text-sm text-slate-500 mb-6 italic\">Type your personal responses or thoughts for each question below to practice structuring your ideas.</p>\n\n                <div class=\"space-y-6\">\n                    <!-- Question 1 -->\n                    <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n                        <label for=\"q1\" class=\"block text-sm font-medium text-slate-800 mb-2\">\n                            <span class=\"font-bold text-emerald-700 mr-1\">1.</span> What's your favourite meal?\n                        </label>\n                        <input type=\"text\" id=\"q1\" data-answer=\"personal\" placeholder=\"e.g., My favourite meal is homemade lasagna...\" \n                            class=\"w-full min-h-[42px] px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-all\">\n                        <span class=\"text-xs text-slate-400 mt-1 block\">Open-ended discussion prompt (Any thoughtful answer is correct).</span>\n                    </div>\n\n                    <!-- Question 2 -->\n                    <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n                        <label for=\"q2\" class=\"block text-sm font-medium text-slate-800 mb-2\">\n                            <span class=\"font-bold text-emerald-700 mr-1\">2.</span> When do you have your main meal of the day?\n                        </label>\n                        <input type=\"text\" id=\"q2\" data-answer=\"personal\" placeholder=\"e.g., I usually have my main meal in the evening around 8 PM...\" \n                            class=\"w-full min-h-[42px] px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-all\">\n                        <span class=\"text-xs text-slate-400 mt-1 block\">Open-ended discussion prompt.</span>\n                    </div>\n\n                    <!-- Question 3 -->\n                    <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n                        <label for=\"q3\" class=\"block text-sm font-medium text-slate-800 mb-2\">\n                            <span class=\"font-bold text-emerald-700 mr-1\">3.</span> Who cooks your main meal and how long does it take to prepare?\n                        </label>\n                        <input type=\"text\" id=\"q3\" data-answer=\"personal\" placeholder=\"e.g., I cook it myself, and it usually takes about 45 minutes...\" \n                            class=\"w-full min-h-[42px] px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-all\">\n                        <span class=\"text-xs text-slate-400 mt-1 block\">Open-ended discussion prompt.</span>\n                    </div>\n\n                    <!-- Question 4 -->\n                    <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n                        <label for=\"q4\" class=\"block text-sm font-medium text-slate-800 mb-2\">\n                            <span class=\"font-bold text-emerald-700 mr-1\">4.</span> Do you like cooking? Why? / Why not?\n                        </label>\n                        <input type=\"text\" id=\"q4\" data-answer=\"personal\" placeholder=\"e.g., Yes, I like cooking because it's relaxing and creative...\" \n                            class=\"w-full min-h-[42px] px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-all\">\n                        <span class=\"text-xs text-slate-400 mt-1 block\">Open-ended discussion prompt.</span>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Control Bar / Feedback -->\n            <div class=\"flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-200\">\n                <div id=\"score-display\" class=\"text-sm font-medium text-slate-600\">\n                    Responses completed: <span id=\"current-score\" class=\"font-bold text-emerald-700\">0</span> / <span id=\"total-score\">4</span>\n                </div>\n                <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                    <button id=\"reset-btn\" class=\"w-full sm:w-auto min-h-[42px] px-5 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-100 transition-colors\">\n                        🔄 Reset\n                    </button>\n                    <button id=\"check-btn\" class=\"w-full sm:w-auto min-h-[42px] px-6 py-2 rounded-xl bg-emerald-700 text-white font-medium hover:bg-emerald-800 shadow-sm transition-all\">\n                        ✓ Check Answers\n                    </button>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <!-- Script / Metrics / Logic -->\n    <script>\n        // MANDATORY METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'kitchen_vocabulary_discussion',\n            maxScore: 4\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const inputs = document.querySelectorAll('input[data-answer]');\n            const currentScoreEl = document.getElementById('current-score');\n\n            checkBtn.addEventListener('click', () => {\n                let correctCount = 0;\n\n                inputs.forEach(input => {\n                    const val = input.value.trim();\n                    if (val.length > 2) {\n                        input.classList.remove('is-wrong');\n                        input.classList.add('is-correct');\n                        correctCount++;\n                    } else {\n                        input.classList.remove('is-correct');\n                        input.classList.add('is-wrong');\n                    }\n                });\n\n                currentScoreEl.textContent = correctCount;\n\n                // Dispatch global event for live session integration\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                // Post message for iframe container embedding\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: inputs.length\n                    }, '*');\n                }\n            });\n\n            resetBtn.addEventListener('click', () => {\n                inputs.forEach(input => {\n                    input.value = '';\n                    input.classList.remove('is-correct', 'is-wrong');\n                });\n                currentScoreEl.textContent = '0';\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: inputs.length,\n                        completed: false\n                    }\n                }));\n\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: 0,\n                        total: inputs.length\n                    }, '*');\n                }\n            });\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793554562083,
      "title": "Kitchen, Food & Cooking Vocabulary Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"h-full\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Kitchen, Food & Cooking Vocabulary Practice</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        brand: {\n                            50: '#f0fdf4',\n                            100: '#dcfce7',\n                            500: '#22c55e',\n                            600: '#16a34a',\n                            700: '#15803d',\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 h-full flex flex-col antialiased selection:bg-brand-100 selection:text-brand-700\">\n\n    <!-- Sticky Top Bar for Metrics & Quick Actions -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm flex flex-wrap items-center justify-between gap-4\">\n        <div class=\"flex items-center gap-2\">\n            <span class=\"bg-brand-600 text-white p-1.5 rounded-lg flex items-center justify-center\">\n                <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10\"></path></svg>\n            </span>\n            <div>\n                <h1 class=\"text-sm font-bold text-slate-900 leading-tight\">Kitchen & Cooking Vocabulary</h1>\n                <p class=\"text-xs text-slate-500\">Categorize words into 3 groups</p>\n            </div>\n        </div>\n\n        <div class=\"flex items-center gap-3 ml-auto\">\n            <div id=\"score-display\" class=\"bg-slate-100 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 border border-slate-200\">\n                Score: <span id=\"current-score\" class=\"text-brand-600 font-bold\">0</span> / <span id=\"total-score\">27</span>\n            </div>\n            <button onclick=\"resetActivity()\" class=\"p-2 text-slate-500 hover:text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center gap-1 text-xs font-medium\" title=\"Reset Activity\">\n                <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                <span class=\"hidden sm:inline\">Reset</span>\n            </button>\n        </div>\n    </header>\n\n    <!-- Main Container (Strictly w-full max-w-4xl mx-auto) -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Instruction Card -->\n        <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 mb-6\">\n            <div class=\"flex items-start gap-3\">\n                <span class=\"bg-slate-900 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center shrink-0 mt-0.5\">2</span>\n                <div>\n                    <h2 class=\"text-base sm:text-lg font-bold text-slate-900\">a) Put these words/phrases into groups 1–3.</h2>\n                    <p class=\"text-xs sm:text-sm text-slate-600 mt-1\">Drag or select the correct category for each word or phrase from the word bank below.</p>\n                </div>\n            </div>\n\n            <!-- Word Bank Pool -->\n            <div class=\"mt-5 p-4 bg-slate-50 rounded-xl border border-slate-200\">\n                <span class=\"block text-xs font-bold uppercase tracking-wider text-slate-500 mb-3\">Word Bank Reference (Click or drag to place):</span>\n                <div id=\"word-bank\" class=\"flex flex-wrap gap-2\">\n                    <!-- Dynamic chips generated via JS or listed -->\n                </div>\n            </div>\n        </section>\n\n        <!-- Categories Container -->\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-5 mb-8\">\n            \n            <!-- Category 1: Food -->\n            <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-200 flex flex-col\">\n                <div class=\"border-b border-slate-100 pb-3 mb-4\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md\">Group 1</span>\n                    <h3 class=\"font-bold text-slate-900 text-lg mt-2\">Food</h3>\n                    <p class=\"text-xs text-slate-500\">Ex: broccoli, beef...</p>\n                </div>\n                <div id=\"dropzone-1\" class=\"category-dropzone flex-grow space-y-2 min-h-[220px] bg-slate-50/50 border-2 border-dashed border-slate-200 rounded-xl p-3 transition-colors\" data-category=\"1\">\n                    <div class=\"text-slate-400 text-xs italic text-center py-8 pointer-events-none drop-placeholder\">Drop food items here</div>\n                </div>\n            </div>\n\n            <!-- Category 2: Things in the kitchen -->\n            <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-200 flex flex-col\">\n                <div class=\"border-b border-slate-100 pb-3 mb-4\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md\">Group 2</span>\n                    <h3 class=\"font-bold text-slate-900 text-lg mt-2\">Things in the kitchen</h3>\n                    <p class=\"text-xs text-slate-500\">Ex: a fridge, cooker...</p>\n                </div>\n                <div id=\"dropzone-2\" class=\"category-dropzone flex-grow space-y-2 min-h-[220px] bg-slate-50/50 border-2 border-dashed border-slate-200 rounded-xl p-3 transition-colors\" data-category=\"2\">\n                    <div class=\"text-slate-400 text-xs italic text-center py-8 pointer-events-none drop-placeholder\">Drop kitchen items here</div>\n                </div>\n            </div>\n\n            <!-- Category 3: Ways of cooking -->\n            <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-200 flex flex-col\">\n                <div class=\"border-b border-slate-100 pb-3 mb-4\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md\">Group 3</span>\n                    <h3 class=\"font-bold text-slate-900 text-lg mt-2\">Ways of cooking</h3>\n                    <p class=\"text-xs text-slate-500\">Ex: boil, roast...</p>\n                </div>\n                <div id=\"dropzone-3\" class=\"category-dropzone flex-grow space-y-2 min-h-[220px] bg-slate-50/50 border-2 border-dashed border-slate-200 rounded-xl p-3 transition-colors\" data-category=\"3\">\n                    <div class=\"text-slate-400 text-xs italic text-center py-8 pointer-events-none drop-placeholder\">Drop cooking methods here</div>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"flex flex-wrap items-center justify-center gap-4 pt-4 border-t border-slate-200\">\n            <button onclick=\"checkAnswers()\" class=\"w-full sm:w-auto min-h-[44px] px-8 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl shadow-sm transition-all flex items-center justify-center gap-2\">\n                <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                Check Answers\n            </button>\n        </div>\n\n        <!-- Discussion Section b) -->\n        <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 mt-8\">\n            <div class=\"flex items-start gap-3\">\n                <span class=\"bg-slate-900 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center shrink-0 mt-0.5\">b</span>\n                <div>\n                    <h3 class=\"text-base sm:text-lg font-bold text-slate-900\">Work in pairs. Answer these questions.</h3>\n                    <p class=\"text-xs sm:text-sm text-slate-600 mt-1\">Reflect on your local cuisine and kitchen setup.</p>\n                </div>\n            </div>\n            <div class=\"mt-4 space-y-4\">\n                <div class=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n                    <p class=\"text-sm font-medium text-slate-800\">1. How is the food in <strong class=\"text-brand-600\">2a</strong> usually cooked in your country?</p>\n                    <textarea class=\"w-full mt-2 p-3 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none resize-y\" rows=\"2\" placeholder=\"Type your answer here...\"></textarea>\n                </div>\n                <div class=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n                    <p class=\"text-sm font-medium text-slate-800\">2. Which of the things in <strong class=\"text-brand-600\">2a</strong> do you both have in your kitchen?</p>\n                    <textarea class=\"w-full mt-2 p-3 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none resize-y\" rows=\"2\" placeholder=\"Type your answer here...\"></textarea>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full py-6 text-center text-xs text-slate-400 border-t border-slate-200 mt-auto\">\n        Interactive ELT Micro-Application • Responsive Touch Interface\n    </footer>\n\n    <!-- Script Application Logic -->\n    <script>\n        // CONTRACT: Activity Metrics\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'kitchen_food_cooking_categorization',\n            maxScore: 27\n        };\n\n        const itemsData = [\n            // Category 1: Food\n            { id: 'item-1', text: 'broccoli', category: 1 },\n            { id: 'item-2', text: 'a red/green pepper', category: 1 },\n            { id: 'item-3', text: 'peas', category: 1 },\n            { id: 'item-4', text: 'beef', category: 1 },\n            { id: 'item-5', text: 'lamb', category: 1 },\n            { id: 'item-6', text: 'carrots', category: 1 },\n            { id: 'item-7', text: 'an aubergine [US: eggplant]', category: 1 },\n            { id: 'item-8', text: 'beans', category: 1 },\n            { id: 'item-9', text: 'courgettes [US: zucchini]', category: 1 },\n\n            // Category 2: Things in the kitchen\n            { id: 'item-10', text: 'a fridge', category: 2 },\n            { id: 'item-11', text: 'a freezer', category: 2 },\n            { id: 'item-12', text: 'a cooker', category: 2 },\n            { id: 'item-13', text: 'a grill', category: 2 },\n            { id: 'item-14', text: 'an oven', category: 2 },\n            { id: 'item-15', text: 'a microwave', category: 2 },\n            { id: 'item-16', text: 'a saucepan', category: 2 },\n            { id: 'item-17', text: 'a frying pan', category: 2 },\n            { id: 'item-18', text: 'a wok', category: 2 },\n            { id: 'item-19', text: 'a blender', category: 2 },\n            { id: 'item-20', text: 'a toaster', category: 2 },\n            { id: 'item-21', text: 'a rubbish bin', category: 2 },\n\n            // Category 3: Ways of cooking\n            { id: 'item-22', text: 'boil', category: 3 },\n            { id: 'item-23', text: 'roast', category: 3 },\n            { id: 'item-24', text: 'bake', category: 3 },\n            { id: 'item-25', text: 'grill', category: 3 },\n            { id: 'item-26', text: 'fry', category: 3 },\n            { id: 'item-27', text: 'heat up', category: 3 },\n            { id: 'item-28', text: 'microwave', category: 3 },\n            { id: 'item-29', text: 'steam', category: 3 }\n        ];\n\n        // Shuffle items for the word bank\n        let activeItems = [...itemsData].sort(() => Math.random() - 0.5);\n\n        function renderWordBank() {\n            const wordBank = document.getElementById('word-bank');\n            wordBank.innerHTML = '';\n            \n            activeItems.forEach(item => {\n                const chip = document.createElement('div');\n                chip.id = item.id;\n                chip.className = 'item-chip bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium cursor-pointer shadow-sm transition-all select-none flex items-center gap-2 min-h-[40px]';\n                chip.setAttribute('draggable', 'true');\n                chip.dataset.id = item.id;\n                chip.dataset.category = item.category;\n                \n                chip.innerHTML = `\n                    <span>${item.text}</span>\n                    <span class=\"text-slate-400 text-xs ml-auto hidden sm:inline\">⋮⋮</span>\n                `;\n\n                // Drag and drop events\n                chip.addEventListener('dragstart', (e) => {\n                    e.dataTransfer.setData('text/plain', item.id);\n                });\n\n                // Click to move modal / toggle selection for mobile accessibility\n                chip.addEventListener('click', () => {\n                    selectItemForPlacement(chip);\n                });\n\n                wordBank.appendChild(chip);\n            });\n            updateTotalScoreDisplay();\n        }\n\n        let selectedChip = null;\n\n        function selectItemForPlacement(chip) {\n            if (selectedChip) {\n                selectedChip.classList.remove('ring-2', 'ring-brand-500', 'bg-brand-50');\n            }\n            if (selectedChip === chip) {\n                selectedChip = null;\n                return;\n            }\n            selectedChip = chip;\n            chip.classList.add('ring-2', 'ring-brand-500', 'bg-brand-50');\n        }\n\n        // Setup Dropzones\n        const dropzones = document.querySelectorAll('.category-dropzone');\n        dropzones.forEach(zone => {\n            zone.addEventListener('dragover', (e) => {\n                e.preventDefault();\n                zone.classList.add('bg-brand-50/50', 'border-brand-400');\n            });\n\n            zone.addEventListener('dragleave', () => {\n                zone.classList.remove('bg-brand-50/50', 'border-brand-400');\n            });\n\n            zone.addEventListener('drop', (e) => {\n                e.preventDefault();\n                zone.classList.remove('bg-brand-50/50', 'border-brand-400');\n                const id = e.dataTransfer.getData('text/plain');\n                const chip = document.getElementById(id);\n                if (chip) {\n                    moveChipToZone(chip, zone);\n                }\n            });\n\n            zone.addEventListener('click', () => {\n                if (selectedChip) {\n                    moveChipToZone(selectedChip, zone);\n                    selectedChip.classList.remove('ring-2', 'ring-brand-500', 'bg-brand-50');\n                    selectedChip = null;\n                }\n            });\n        });\n\n        function moveChipToZone(chip, zone) {\n            const placeholder = zone.querySelector('.drop-placeholder');\n            if (placeholder) {\n                placeholder.remove();\n            }\n            zone.appendChild(chip);\n            checkPlaceholders();\n        }\n\n        function checkPlaceholders() {\n            dropzones.forEach(zone => {\n                const chips = zone.querySelectorAll('.item-chip');\n                if (chips.length === 0 && !zone.querySelector('.drop-placeholder')) {\n                    const ph = document.createElement('div');\n                    ph.className = 'text-slate-400 text-xs italic text-center py-8 pointer-events-none drop-placeholder';\n                    ph.textContent = 'Drop items here';\n                    zone.appendChild(ph);\n                }\n            });\n            \n            // Return to word bank if needed via double click\n            document.querySelectorAll('.item-chip').forEach(chip => {\n                chip.ondblclick = () => {\n                    document.getElementById('word-bank').appendChild(chip);\n                    checkPlaceholders();\n                };\n            });\n        }\n\n        function updateTotalScoreDisplay() {\n            document.getElementById('total-score').textContent = itemsData.length;\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const total = itemsData.length;\n\n            dropzones.forEach(zone => {\n                const zoneCategory = parseInt(zone.dataset.category);\n                const chips = zone.querySelectorAll('.item-chip');\n\n                chips.forEach(chip => {\n                    const itemCategory = parseInt(chip.dataset.category);\n                    chip.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900');\n                    \n                    if (itemCategory === zoneCategory) {\n                        chip.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n                        correctCount++;\n                    } else {\n                        chip.classList.add('border-red-500', 'bg-red-50', 'text-red-900');\n                    }\n                });\n            });\n\n            // Update Score Board\n            document.getElementById('current-score').textContent = correctCount;\n\n            // Dispatch Metrics Event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: total,\n                    completed: correctCount === total\n                }\n            }));\n\n            // Post message for iframe containers\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: total }, '*');\n            }\n        }\n\n        function resetActivity() {\n            activeItems = [...itemsData].sort(() => Math.random() - 0.5);\n            renderWordBank();\n            dropzones.forEach(zone => {\n                zone.innerHTML = '<div class=\"text-slate-400 text-xs italic text-center py-8 pointer-events-none drop-placeholder\">Drop items here</div>';\n            });\n            document.getElementById('current-score').textContent = '0';\n            document.querySelectorAll('textarea').forEach(ta => ta.value = '');\n        }\n\n        // Initialize on load\n        window.addEventListener('DOMContentLoaded', () => {\n            renderWordBank();\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793556109993,
      "title": "What's for Dinner? - Reading & Grammar",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>What's for Dinner? - Reading & Grammar</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Top Bar / Header -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-pink-600 text-white text-xs uppercase font-bold px-2.5 py-1 rounded-md\">Reading</span>\n                <h1 class=\"text-base sm:text-lg font-bold text-slate-800 tracking-tight\">What's for Dinner?</h1>\n            </div>\n            <div class=\"flex items-center gap-3\">\n                <div id=\"score-display\" class=\"text-sm font-semibold bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full border border-slate-200\">\n                    Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">4</span>\n                </div>\n                <button onclick=\"resetActivity()\" class=\"text-xs bg-slate-200 hover:bg-slate-300 active:scale-95 text-slate-700 font-medium px-3 py-1.5 rounded-lg transition\">\n                    🔄 Reset\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-4 space-y-8\">\n\n        <!-- Cartoon Intro Section -->\n        <section class=\"bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-4\">\n            <div class=\"border-l-4 border-pink-600 pl-3\">\n                <h2 class=\"text-lg font-bold text-slate-800\">3. a) Look at the cartoon</h2>\n                <p class=\"text-sm text-slate-600\">What is the article about, do you think? Compare with the illustration below.</p>\n            </div>\n            <div class=\"flex justify-center items-center overflow-visible bg-pink-50/50 p-3 rounded-xl\">\n                <img src=\"data:image/png;base64,\" alt=\"Linda and her mother cartoon talking about dinner\" class=\"max-h-64 md:max-h-72 w-auto mx-auto object-contain rounded-xl shadow-sm block\">\n            </div>\n        </section>\n\n        <!-- Reading Text Accordion Section -->\n        <section class=\"bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-4\">\n            <details open class=\"group\">\n                <summary class=\"flex justify-between items-center font-bold text-base text-slate-800 cursor-pointer list-none select-none bg-slate-100 p-3 rounded-xl hover:bg-slate-200 transition\">\n                    <span class=\"flex items-center gap-2\">\n                        <svg class=\"w-5 h-5 text-pink-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n                        Linda Roberts investigates the rise in popularity of ready meals (Click to toggle text)\n                    </span>\n                    <span class=\"transition group-open:rotate-180\">▼</span>\n                </summary>\n                \n                <div class=\"mt-4 space-y-4 text-slate-700 text-sm md:text-base leading-relaxed pt-2\">\n                    <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 bg-sky-500 text-white font-bold rounded-full flex items-center justify-center text-sm\">1</span>\n                        <p>Like many working people, I never actually cook anything – I just don’t have the time. My mother, on the other hand, still cooks a full three-course meal every evening, but then she doesn’t have to work any more. I usually work very long hours and now I’m writing a book in my spare time, so ready meals are the perfect solution – or are they?</p>\n                    </div>\n\n                    <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 bg-sky-500 text-white font-bold rounded-full flex items-center justify-center text-sm\">2</span>\n                        <p>According to a survey by a British market research company, we only spend 20 minutes cooking each day – 20 years ago it was an hour a day. One reason for this change is ready meals. Now you can heat up a delicious Indian, Thai, Chinese or Italian meal in the microwave in under four minutes. What could be easier or quicker?</p>\n                    </div>\n\n                    <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 bg-sky-500 text-white font-bold rounded-full flex items-center justify-center text-sm\">3</span>\n                        <p>We all know these ready meals taste delicious, but many experts now believe they're bad for our health because they often contain a lot of sugar, fat and salt. Health advisers say that we shouldn't eat ready meals too often and we need to read the labels carefully. Despite this, people who live in the UK spend over £1 billion a year on ready meals and the market is growing rapidly.</p>\n                    </div>\n\n                    <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 bg-sky-500 text-white font-bold rounded-full flex items-center justify-center text-sm\">4</span>\n                        <p>People in the USA and Sweden also buy a lot of ready meals, and they're becoming more common in Germany, France and Holland. The Spanish and Italians still cook their own meals, but things are beginning to change there too. My mother will never change, though – now she's doing an evening course in traditional English cooking!</p>\n                    </div>\n                </div>\n            </details>\n        </section>\n\n        <!-- Exercise Interaction Section -->\n        <section class=\"bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-6\">\n            <div class=\"border-l-4 border-pink-600 pl-3\">\n                <h2 class=\"text-lg font-bold text-slate-800\">3. b) Read the article. Match headings a)–d) to paragraphs 1–4.</h2>\n                <p class=\"text-sm text-slate-600\">Select the correct heading option for each paragraph number.</p>\n            </div>\n\n            <!-- Headings Reference Box -->\n            <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-900 space-y-1\">\n                <p class=\"font-bold\">Headings Bank:</p>\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-1 text-xs sm:text-sm\">\n                    <div><strong>a)</strong> Ready meals around the world</div>\n                    <div><strong>b)</strong> How British eating habits are changing</div>\n                    <div><strong>c)</strong> Too busy to cook</div>\n                    <div><strong>d)</strong> How healthy are ready meals?</div>\n                </div>\n            </div>\n\n            <!-- Matching Form -->\n            <div class=\"space-y-4\">\n                <!-- Item 1 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm flex-shrink-0\">1</span>\n                        <span class=\"text-sm sm:text-base font-medium text-slate-700\">Paragraph 1</span>\n                    </div>\n                    <select data-answer=\"c\" class=\"match-select w-full sm:w-72 p-2.5 text-sm sm:text-base bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-pink-500 outline-none transition\">\n                        <option value=\"\">-- Select heading --</option>\n                        <option value=\"a\">a) Ready meals around the world</option>\n                        <option value=\"b\">b) How British eating habits are changing</option>\n                        <option value=\"c\">c) Too busy to cook</option>\n                        <option value=\"d\">d) How healthy are ready meals?</option>\n                    </select>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm flex-shrink-0\">2</span>\n                        <span class=\"text-sm sm:text-base font-medium text-slate-700\">Paragraph 2</span>\n                    </div>\n                    <select data-answer=\"b\" class=\"match-select w-full sm:w-72 p-2.5 text-sm sm:text-base bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-pink-500 outline-none transition\">\n                        <option value=\"\">-- Select heading --</option>\n                        <option value=\"a\">a) Ready meals around the world</option>\n                        <option value=\"b\">b) How British eating habits are changing</option>\n                        <option value=\"c\">c) Too busy to cook</option>\n                        <option value=\"d\">d) How healthy are ready meals?</option>\n                    </select>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm flex-shrink-0\">3</span>\n                        <span class=\"text-sm sm:text-base font-medium text-slate-700\">Paragraph 3</span>\n                    </div>\n                    <select data-answer=\"d\" class=\"match-select w-full sm:w-72 p-2.5 text-sm sm:text-base bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-pink-500 outline-none transition\">\n                        <option value=\"\">-- Select heading --</option>\n                        <option value=\"a\">a) Ready meals around the world</option>\n                        <option value=\"b\">b) How British eating habits are changing</option>\n                        <option value=\"c\">c) Too busy to cook</option>\n                        <option value=\"d\">d) How healthy are ready meals?</option>\n                    </select>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"w-8 h-8 rounded-full bg-slate-800 text-white font-bold flex items-center justify-center text-sm flex-shrink-0\">4</span>\n                        <span class=\"text-sm sm:text-base font-medium text-slate-700\">Paragraph 4</span>\n                    </div>\n                    <select data-answer=\"a\" class=\"match-select w-full sm:w-72 p-2.5 text-sm sm:text-base bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-pink-500 outline-none transition\">\n                        <option value=\"\">-- Select heading --</option>\n                        <option value=\"a\">a) Ready meals around the world</option>\n                        <option value=\"b\">b) How British eating habits are changing</option>\n                        <option value=\"c\">c) Too busy to cook</option>\n                        <option value=\"d\">d) How healthy are ready meals?</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"pt-4 flex flex-wrap items-center justify-between gap-3\">\n                <button onclick=\"checkAnswers()\" class=\"w-full sm:w-auto bg-pink-600 hover:bg-pink-700 active:scale-95 text-white font-bold py-3 px-6 rounded-xl shadow-md transition flex items-center justify-center gap-2 text-base\">\n                    ✓ Check Answers\n                </button>\n                <div id=\"feedback-msg\" class=\"text-sm font-medium text-slate-600 hidden\"></div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-6 text-xs text-slate-400 border-t border-slate-200 bg-white\">\n        Interactive Reading & Grammar Activity • ELT Responsive Micro-App\n    </footer>\n\n    <!-- Script Logic & Metrics Contract -->\n    <script>\n        // OBLIGATORY METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Reading',\n            skill: 'matching_headings_to_paragraphs',\n            maxScore: 4\n        };\n\n        function checkAnswers() {\n            const selects = document.querySelectorAll('.match-select');\n            let correctCount = 0;\n\n            selects.forEach(select => {\n                const userVal = select.value;\n                const correctVal = select.getAttribute('data-answer');\n\n                select.classList.remove('is-correct', 'is-wrong');\n\n                if (userVal === correctVal) {\n                    select.classList.add('is-correct');\n                    correctCount++;\n                } else if (userVal !== \"\") {\n                    select.classList.add('is-wrong');\n                }\n            });\n\n            // Update Score Badge\n            document.getElementById('current-score').textContent = correctCount;\n            \n            const feedback = document.getElementById('feedback-msg');\n            feedback.classList.remove('hidden');\n            if(correctCount === selects.length) {\n                feedback.textContent = '🎉 Excellent! All matches are correct.';\n                feedback.className = 'text-sm font-bold text-emerald-600';\n            } else {\n                feedback.textContent = `You got ${correctCount} out of ${selects.length} correct. Check the highlighted ones!`;\n                feedback.className = 'text-sm font-bold text-amber-600';\n            }\n\n            // Dispatch global ELT event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: selects.length,\n                    completed: correctCount === selects.length\n                }\n            }));\n\n            // Post message for parent frames if any\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ \n                    type: 'ACTIVITY_SCORE', \n                    score: correctCount, \n                    total: selects.length \n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const selects = document.querySelectorAll('.match-select');\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('is-correct', 'is-wrong');\n            });\n\n            document.getElementById('current-score').textContent = '0';\n            const feedback = document.getElementById('feedback-msg');\n            feedback.textContent = '';\n            feedback.classList.add('hidden');\n\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: 0,\n                    total: selects.length,\n                    completed: false\n                }\n            }));\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793556626177,
      "title": "Linda Roberts investigates ready meals - Reading Comprehension",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Linda Roberts investigates ready meals - Reading Comprehension</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY TOP BAR: METRICS & SCORE CONTROLLER -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"w-full max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-2\">\n                <span class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </span>\n                <div>\n                    <h1 class=\"text-sm font-bold text-slate-900 leading-tight\">Reading & True/False Exercise</h1>\n                    <p class=\"text-xs text-slate-500\">Linda Roberts investigates the rise in popularity of ready meals</p>\n                </div>\n            </div>\n\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200 text-sm font-medium\">\n                    Score: <span id=\"score-display\" class=\"text-indigo-600 font-bold\">0</span> / <span id=\"total-display\">10</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTENT CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow space-y-6\">\n\n        <!-- READING ARTICLE ACCORDION -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden\">\n            <details open class=\"group\">\n                <summary class=\"flex items-center justify-between p-4 sm:p-5 bg-slate-50 cursor-pointer font-semibold text-slate-800 hover:bg-slate-100 transition\">\n                    <div class=\"flex items-center gap-2.5\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z\" />\n                        </svg>\n                        <span class=\"text-base sm:text-lg\">Read the article: Linda Roberts investigates the rise in popularity of ready meals</span>\n                    </div>\n                    <span class=\"text-xs text-indigo-600 font-semibold group-open:underline\">Toggle Article</span>\n                </summary>\n                \n                <div class=\"p-5 sm:p-6 space-y-4 text-slate-700 leading-relaxed border-t border-slate-100 text-sm sm:text-base\">\n                    <div class=\"flex gap-3 items-start\">\n                        <span class=\"bg-indigo-100 text-indigo-800 font-bold text-xs px-2 py-1 rounded-md shrink-0 mt-1\">1</span>\n                        <p>Like many working people, I never actually cook anything – I just don't have the time. My mother, on the other hand, still cooks a full three-course meal every evening, but then she doesn't have to work any more. I usually work very long hours and now I'm writing a book in my spare time, so ready meals are the perfect solution – or are they?</p>\n                    </div>\n                    <div class=\"flex gap-3 items-start\">\n                        <span class=\"bg-indigo-100 text-indigo-800 font-bold text-xs px-2 py-1 rounded-md shrink-0 mt-1\">2</span>\n                        <p>According to a survey by a British market research company, we only spend 20 minutes cooking each day – 20 years ago it was an hour a day. One reason for this change is ready meals. Now you can heat up a delicious Indian, Thai, Chinese or Italian meal in the microwave in under four minutes. What could be easier or quicker?</p>\n                    </div>\n                    <div class=\"flex gap-3 items-start\">\n                        <span class=\"bg-indigo-100 text-indigo-800 font-bold text-xs px-2 py-1 rounded-md shrink-0 mt-1\">3</span>\n                        <p>We all know these ready meals taste delicious, but many experts now believe they're bad for our health because they often contain a lot of sugar, fat and salt. Health advisers say that we shouldn't eat ready meals too often and we need to read the labels carefully. Despite this, people who live in the UK spend over £1 billion a year on ready meals and the market is growing rapidly.</p>\n                    </div>\n                    <div class=\"flex gap-3 items-start\">\n                        <span class=\"bg-indigo-100 text-indigo-800 font-bold text-xs px-2 py-1 rounded-md shrink-0 mt-1\">4</span>\n                        <p>People in the USA and Sweden also buy a lot of ready meals, and they're becoming more common in Germany, France and Holland. The Spanish and Italians still cook their own meals, but things are beginning to change there too. My mother will never change, though – now she's doing an evening course in traditional English cooking!</p>\n                    </div>\n                </div>\n            </details>\n        </section>\n\n        <!-- EXERCISE SECTION: TRUE/FALSE & CORRECTIONS -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6 md:p-8 space-y-6\">\n            <div class=\"border-b pb-4\">\n                <h2 class=\"text-lg font-bold text-slate-900\">a) Read the article again. Are sentences 1–5 true or false? Change the false ones.</h2>\n                <p class=\"text-sm text-slate-500 mt-1\">Select True (T) or False (F). If the sentence is false, write the correct sentence in the text box provided.</p>\n            </div>\n\n            <div id=\"questions-container\" class=\"space-y-6\">\n                <!-- Item 1 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-index=\"1\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <p class=\"text-sm sm:text-base font-medium text-slate-900\">\n                            <span class=\"font-bold text-indigo-600 mr-2\">1.</span>Linda Roberts cooks a three-course meal every evening.\n                        </p>\n                        <div class=\"flex items-center gap-2 shrink-0\">\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q1\" value=\"T\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> True\n                            </label>\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q1\" value=\"F\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> False\n                            </label>\n                        </div>\n                    </div>\n                    <div>\n                        <input type=\"text\" data-answer=\"She never cooks anything\" placeholder=\"If false, write the correction here...\" class=\"w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                    </div>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-index=\"2\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <p class=\"text-sm sm:text-base font-medium text-slate-900\">\n                            <span class=\"font-bold text-indigo-600 mr-2\">2.</span>We spent more time cooking 20 years ago than we do now.\n                        </p>\n                        <div class=\"flex items-center gap-2 shrink-0\">\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q2\" value=\"T\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> True\n                            </label>\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q2\" value=\"F\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> False\n                            </label>\n                        </div>\n                    </div>\n                    <div>\n                        <input type=\"text\" data-answer=\"none\" placeholder=\"If false, write the correction here (leave blank if true)...\" class=\"w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                    </div>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-index=\"3\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <p class=\"text-sm sm:text-base font-medium text-slate-900\">\n                            <span class=\"font-bold text-indigo-600 mr-2\">3.</span>Health advisers say we should never eat ready meals.\n                        </p>\n                        <div class=\"flex items-center gap-2 shrink-0\">\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q3\" value=\"T\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> True\n                            </label>\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q3\" value=\"F\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> False\n                            </label>\n                        </div>\n                    </div>\n                    <div>\n                        <input type=\"text\" data-answer=\"Health advisers say that we shouldn't eat ready meals too often\" placeholder=\"If false, write the correction here...\" class=\"w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                    </div>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-index=\"4\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <p class=\"text-sm sm:text-base font-medium text-slate-900\">\n                            <span class=\"font-bold text-indigo-600 mr-2\">4.</span>The Spanish eat a lot of ready meals.\n                        </p>\n                        <div class=\"flex items-center gap-2 shrink-0\">\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q4\" value=\"T\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> True\n                            </label>\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q4\" value=\"F\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> False\n                            </label>\n                        </div>\n                    </div>\n                    <div>\n                        <input type=\"text\" data-answer=\"The Spanish still cook their own meals\" placeholder=\"If false, write the correction here...\" class=\"w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                    </div>\n                </div>\n\n                <!-- Item 5 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-index=\"5\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <p class=\"text-sm sm:text-base font-medium text-slate-900\">\n                            <span class=\"font-bold text-indigo-600 mr-2\">5.</span>Linda doesn't think her mother will start eating ready meals.\n                        </p>\n                        <div class=\"flex items-center gap-2 shrink-0\">\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q5\" value=\"T\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> True\n                            </label>\n                            <label class=\"inline-flex items-center px-3 py-2 rounded-lg border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition text-sm font-medium\">\n                                <input type=\"radio\" name=\"q5\" value=\"F\" class=\"text-indigo-600 focus:ring-indigo-500 mr-2 h-4 w-4\"> False\n                            </label>\n                        </div>\n                    </div>\n                    <div>\n                        <input type=\"text\" data-answer=\"none\" placeholder=\"If false, write the correction here (leave blank if true)...\" class=\"w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- ACTION BUTTONS -->\n            <div class=\"flex flex-wrap items-center justify-end gap-3 pt-4 border-t\">\n                <button id=\"reset-btn\" type=\"button\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-100 transition min-h-[42px]\">\n                    Reset\n                </button>\n                <button id=\"check-btn\" type=\"button\" class=\"px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold hover:bg-indigo-700 transition shadow-sm min-h-[42px]\">\n                    Check Answers\n                </button>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"w-full text-center py-6 text-xs text-slate-400 border-t mt-12 bg-white\">\n        Interactive ELT Activity &bull; Designed for Responsive Touch Interfaces\n    </footer>\n\n    <!-- ACTIVITY SCRIPT & METRICS CONTROLLER -->\n    <script>\n        // OBLIGATORY METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Reading',\n            skill: 'reading_for_detail_true_false',\n            maxScore: 10 // 5 T/F answers + 5 correction evaluations\n        };\n\n        const trueAnswers = {\n            q1: { tf: 'F', correction: ['she never cooks anything', 'never cooks anything', 'i never actually cook anything'] },\n            q2: { tf: 'T', correction: ['none', ''] },\n            q3: { tf: 'F', correction: [\"health advisers say that we shouldn't eat ready meals too often\", \"we shouldn't eat ready meals too often\", \"shouldn't eat ready meals too often\"] },\n            q4: { tf: 'F', correction: ['the spanish still cook their own meals', 'still cook their own meals'] },\n            q5: { tf: 'T', correction: ['none', ''] }\n        };\n\n        function normalizeStr(str) {\n            if (!str) return '';\n            return str.toLowerCase().replace(/['']/g, \"'\").replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()?]/g,\"\").trim();\n        }\n\n        document.getElementById('check-btn').addEventListener('click', () => {\n            let score = 0;\n            const cards = document.querySelectorAll('.question-card');\n\n            cards.forEach(card => {\n                const index = card.getAttribute('data-index');\n                const qKey = 'q' + index;\n                const radios = card.querySelectorAll(`input[name=\"${qKey}\"]`);\n                const textInput = card.querySelector('input[type=\"text\"]');\n                \n                let selectedTf = '';\n                radios.forEach(r => { if (r.checked) selectedTf = r.value; });\n\n                const correctData = trueAnswers[qKey];\n                \n                // Evaluate True/False\n                let tfCorrect = (selectedTf === correctData.tf);\n                \n                // Evaluate Correction input\n                const userTextNorm = normalizeStr(textInput.value);\n                let corrCorrect = false;\n\n                if (correctData.tf === 'T') {\n                    // If True, correction should be empty/none\n                    if (userTextNorm === '' || userTextNorm === 'none') {\n                        corrCorrect = true;\n                    }\n                } else {\n                    // If False, check against accepted corrections\n                    corrCorrect = correctData.correction.some(acc => userTextNorm.includes(normalizeStr(acc)));\n                }\n\n                // Apply visual feedback for TF container\n                const radioParent = radios[0].closest('.flex');\n                if (tfCorrect) {\n                    radioParent.classList.add('bg-emerald-50', 'border', 'border-emerald-300', 'p-2', 'rounded-lg');\n                    score++;\n                } else {\n                    radioParent.classList.add('bg-rose-50', 'border', 'border-rose-300', 'p-2', 'rounded-lg');\n                }\n\n                // Apply visual feedback for text input\n                if (correctData.tf === 'F') {\n                    if (corrCorrect) {\n                        textInput.classList.add('is-correct');\n                        textInput.classList.remove('is-wrong');\n                        score++;\n                    } else {\n                        textInput.classList.add('is-wrong');\n                        textInput.classList.remove('is-correct');\n                    }\n                } else {\n                    // For True statements, if they left it blank or wrote none, give point\n                    if (corrCorrect) {\n                        textInput.classList.add('is-correct');\n                        textInput.classList.remove('is-wrong');\n                        score++;\n                    } else {\n                        textInput.classList.add('is-wrong');\n                        textInput.classList.remove('is-correct');\n                    }\n                }\n            });\n\n            // Update Score Display\n            document.getElementById('score-display').textContent = score;\n\n            // Dispatch Metrics and Parent PostMessage\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: score,\n                    total: 10,\n                    completed: score === 10\n                }\n            }));\n\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: score, total: 10 }, '*');\n            }\n        });\n\n        document.getElementById('reset-btn').addEventListener('click', () => {\n            const cards = document.querySelectorAll('.question-card');\n            cards.forEach(card => {\n                const radios = card.querySelectorAll('input[type=\"radio\"]');\n                radios.forEach(r => r.checked = false);\n                const textInput = card.querySelector('input[type=\"text\"]');\n                textInput.value = '';\n                textInput.classList.remove('is-correct', 'is-wrong');\n                \n                const radioParent = radios[0].closest('.flex');\n                radioParent.classList.remove('bg-emerald-50', 'border', 'border-emerald-300', 'p-2', 'rounded-lg', 'bg-rose-50', 'border-rose-300');\n            });\n            document.getElementById('score-display').textContent = '0';\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793557286266,
      "title": "Present Continuous vs Present Simple Interactive Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Present Continuous vs Present Simple Interactive Practice</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n        .is-correct { background-color: #ecfdf5 !important; border-color: #059669 !important; color: #065f46 !important; }\n        .is-wrong { background-color: #fef2f2 !important; border-color: #dc2626 !important; color: #991b1b !important; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY TOP HEADER & SCORE BAR -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 sm:px-6 border-b border-slate-200 shadow-sm w-full\">\n        <div class=\"w-full max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </div>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Grammar Workshop</h1>\n                    <p class=\"text-xs text-slate-500\">Present Continuous vs Present Simple</p>\n                </div>\n            </div>\n\n            <!-- Score Badge & Controls -->\n            <div class=\"flex items-center space-x-3\">\n                <div id=\"score-badge\" class=\"bg-indigo-50 border border-indigo-200 text-indigo-700 px-3 py-1.5 rounded-xl font-semibold text-sm flex items-center shadow-inner\">\n                    <span>Score: </span>\n                    <span id=\"score-current\" class=\"ml-1 font-bold\">0</span>\n                    <span class=\"mx-0.5\">/</span>\n                    <span id=\"score-total\">14</span>\n                </div>\n                <button id=\"reset-btn\" class=\"bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 rounded-xl text-sm font-medium transition active:scale-95 flex items-center space-x-1\" title=\"Reset activity\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    <span class=\"hidden sm:inline\">Reset</span>\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 space-y-8 flex-grow\">\n\n        <!-- INTRO & VISUAL REFERENCE SECTION -->\n        <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 space-y-4\">\n            <div class=\"border-b border-slate-100 pb-3\">\n                <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full\">Visual Context & Reading</span>\n                <h2 class=\"text-xl font-bold text-slate-900 mt-2\">What's for dinner? & Article Analysis</h2>\n                <p class=\"text-sm text-slate-600 mt-1\">Examine the cartoon and refer to the reading article to understand when we use Present Continuous and Present Simple.</p>\n            </div>\n\n            <!-- Student Image 1 (Cartoon) -->\n            <div class=\"flex justify-center items-center overflow-visible my-4\">\n                <img src=\"data:image/png;base64,\" alt=\"What's for dinner cartoon and phone call\" class=\"max-h-64 md:max-h-72 w-auto mx-auto object-contain rounded-xl shadow-sm block border border-slate-100\">\n            </div>\n\n            <!-- Reading Reference Accordion -->\n            <details class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-700\">\n                <summary class=\"font-semibold cursor-pointer text-indigo-700 flex items-center justify-between outline-none\">\n                    <span>📖 Read Article: Linda Roberts investigates the rise in popularity of ready meals</span>\n                    <span class=\"text-xs bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded\">Expand / Collapse</span>\n                </summary>\n                <div class=\"mt-3 space-y-3 pt-3 border-t border-slate-200 text-slate-600\">\n                    <p><strong>1.</strong> Like many working people, I <strong>never actually cook</strong> anything – I just don’t have the time. My mother, on the other hand, still <strong>cooks</strong> a full three-course meal every evening... I usually work very long hours and now I<strong>'m writing</strong> a book in my spare time, so ready meals are the perfect solution – or are they?</p>\n                    <p><strong>2.</strong> According to a survey by a British market research company, we only <strong>spend</strong> 20 minutes cooking each day... Now you can heat up a delicious Indian, Thai, Chinese or Italian meal in the microwave in under four minutes.</p>\n                    <p><strong>3.</strong> We all know these ready meals <strong>taste</strong> delicious, but many experts now <strong>believe</strong> they're bad for our health because they often <strong>contain</strong> a lot of sugar, fat and salt... people who <strong>live</strong> in the UK spend over £1 billion a year on ready meals and the market <strong>is growing</strong> rapidly.</p>\n                    <p><strong>4.</strong> People in the USA and Sweden also <strong>buy</strong> a lot of ready meals, and they<strong>'re becoming</strong> more common... My mother will never change, though – now she<strong>'s doing</strong> an evening course in traditional English cooking!</p>\n                </div>\n            </details>\n        </section>\n\n        <!-- TASK 1: GRAMMAR MEANINGS MATCH -->\n        <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 space-y-5\">\n            <div class=\"flex items-start justify-between\">\n                <div>\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full\">Grammar Task 1</span>\n                    <h3 class=\"text-lg font-bold text-slate-900 mt-2\">Present Continuous vs Present Simple Meanings</h3>\n                    <p class=\"text-sm text-slate-600\">Select the correct verb form from the article and cartoon to match each meaning.</p>\n                </div>\n            </div>\n\n            <div class=\"space-y-4\">\n                <!-- Question 1 -->\n                <div class=\"p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n                    <div class=\"text-sm text-slate-700 font-medium\">\n                        <span class=\"font-bold text-indigo-700 mr-2\">1.</span> We use the <strong class=\"text-slate-900\">Present Continuous</strong> for things that are happening at the moment of speaking:\n                    </div>\n                    <div class=\"w-full md:w-64\">\n                        <select class=\"w-full py-2 px-3 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"'m cooking\">\n                            <option value=\"\">-- Select verb form --</option>\n                            <option value=\"'m cooking\">'m cooking</option>\n                            <option value=\"'m making\">'m making</option>\n                            <option value=\"'m writing\">'m writing</option>\n                            <option value=\"'s doing\">'s doing</option>\n                            <option value=\"is growing\">is growing</option>\n                            <option value=\"'re becoming\">'re becoming</option>\n                            <option value=\"cooks\">cooks</option>\n                            <option value=\"spend\">spend</option>\n                            <option value=\"live\">live</option>\n                            <option value=\"buy\">buy</option>\n                            <option value=\"believe\">believe</option>\n                            <option value=\"need\">need</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Question 2 -->\n                <div class=\"p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n                    <div class=\"text-sm text-slate-700 font-medium\">\n                        <span class=\"font-bold text-indigo-700 mr-2\">2.</span> We use the <strong class=\"text-slate-900\">Present Continuous</strong> for things that are temporary and happening around now:\n                    </div>\n                    <div class=\"w-full md:w-64\">\n                        <select class=\"w-full py-2 px-3 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"'m writing\">\n                            <option value=\"\">-- Select verb form --</option>\n                            <option value=\"'m cooking\">'m cooking</option>\n                            <option value=\"'m making\">'m making</option>\n                            <option value=\"'m writing\">'m writing</option>\n                            <option value=\"'s doing\">'s doing</option>\n                            <option value=\"is growing\">is growing</option>\n                            <option value=\"'re becoming\">'re becoming</option>\n                            <option value=\"cooks\">cooks</option>\n                            <option value=\"spend\">spend</option>\n                            <option value=\"live\">live</option>\n                            <option value=\"buy\">buy</option>\n                            <option value=\"believe\">believe</option>\n                            <option value=\"need\">need</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Question 3 -->\n                <div class=\"p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n                    <div class=\"text-sm text-slate-700 font-medium\">\n                        <span class=\"font-bold text-indigo-700 mr-2\">3.</span> We use the <strong class=\"text-slate-900\">Present Continuous</strong> for things that are changing over a period of time:\n                    </div>\n                    <div class=\"w-full md:w-64\">\n                        <select class=\"w-full py-2 px-3 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"is growing\">\n                            <option value=\"\">-- Select verb form --</option>\n                            <option value=\"'m cooking\">'m cooking</option>\n                            <option value=\"'m making\">'m making</option>\n                            <option value=\"'m writing\">'m writing</option>\n                            <option value=\"'s doing\">'s doing</option>\n                            <option value=\"is growing\">is growing</option>\n                            <option value=\"'re becoming\">'re becoming</option>\n                            <option value=\"cooks\">cooks</option>\n                            <option value=\"spend\">spend</option>\n                            <option value=\"live\">live</option>\n                            <option value=\"buy\">buy</option>\n                            <option value=\"believe\">believe</option>\n                            <option value=\"need\">need</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Question 4 -->\n                <div class=\"p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n                    <div class=\"text-sm text-slate-700 font-medium\">\n                        <span class=\"font-bold text-indigo-700 mr-2\">4.</span> We use the <strong class=\"text-slate-900\">Present Simple</strong> for habits, daily routines, things we do every day:\n                    </div>\n                    <div class=\"w-full md:w-64\">\n                        <select class=\"w-full py-2 px-3 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"cooks\">\n                            <option value=\"\">-- Select verb form --</option>\n                            <option value=\"'m cooking\">'m cooking</option>\n                            <option value=\"'m making\">'m making</option>\n                            <option value=\"'m writing\">'m writing</option>\n                            <option value=\"'s doing\">'s doing</option>\n                            <option value=\"is growing\">is growing</option>\n                            <option value=\"'re becoming\">'re becoming</option>\n                            <option value=\"cooks\">cooks</option>\n                            <option value=\"spend\">spend</option>\n                            <option value=\"live\">live</option>\n                            <option value=\"buy\">buy</option>\n                            <option value=\"believe\">believe</option>\n                            <option value=\"need\">need</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Question 5 -->\n                <div class=\"p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n                    <div class=\"text-sm text-slate-700 font-medium\">\n                        <span class=\"font-bold text-indigo-700 mr-2\">5.</span> We use the <strong class=\"text-slate-900\">Present Simple</strong> for things that are permanent or true for a long time:\n                    </div>\n                    <div class=\"w-full md:w-64\">\n                        <select class=\"w-full py-2 px-3 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"live\">\n                            <option value=\"\">-- Select verb form --</option>\n                            <option value=\"'m cooking\">'m cooking</option>\n                            <option value=\"'m making\">'m making</option>\n                            <option value=\"'m writing\">'m writing</option>\n                            <option value=\"'s doing\">'s doing</option>\n                            <option value=\"is growing\">is growing</option>\n                            <option value=\"'re becoming\">'re becoming</option>\n                            <option value=\"cooks\">cooks</option>\n                            <option value=\"spend\">spend</option>\n                            <option value=\"live\">live</option>\n                            <option value=\"buy\">buy</option>\n                            <option value=\"believe\">believe</option>\n                            <option value=\"need\">need</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Question 6 -->\n                <div class=\"p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n                    <div class=\"text-sm text-slate-700 font-medium\">\n                        <span class=\"font-bold text-indigo-700 mr-2\">6.</span> We use the <strong class=\"text-slate-900\">Present Simple</strong> for verbs that describe states (e.g. have got, be, know, believe):\n                    </div>\n                    <div class=\"w-full md:w-64\">\n                        <select class=\"w-full py-2 px-3 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"believe\">\n                            <option value=\"\">-- Select verb form --</option>\n                            <option value=\"'m cooking\">'m cooking</option>\n                            <option value=\"'m making\">'m making</option>\n                            <option value=\"'m writing\">'m writing</option>\n                            <option value=\"'s doing\">'s doing</option>\n                            <option value=\"is growing\">is growing</option>\n                            <option value=\"'re becoming\">'re becoming</option>\n                            <option value=\"cooks\">cooks</option>\n                            <option value=\"spend\">spend</option>\n                            <option value=\"live\">live</option>\n                            <option value=\"buy\">buy</option>\n                            <option value=\"believe\">believe</option>\n                            <option value=\"need\">need</option>\n                        </select>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- TASK 2: ACTIVITY VS STATE VERBS CLASSIFICATION -->\n        <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 space-y-5\">\n            <div>\n                <span class=\"text-xs font-bold uppercase tracking-wider text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full\">Grammar Task 2</span>\n                <h3 class=\"text-lg font-bold text-slate-900 mt-2\">Activity (A) or State (S) Verbs?</h3>\n                <p class=\"text-sm text-slate-600\">Look at these verbs from the text and classify them as Activity (A) or State (S).</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3\">\n                <!-- Verb 1: watch -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\">\n                    <span class=\"font-medium text-slate-800 text-sm\">watch</span>\n                    <select class=\"py-1 px-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"A\">\n                        <option value=\"\">--</option>\n                        <option value=\"A\">A</option>\n                        <option value=\"S\">S</option>\n                    </select>\n                </div>\n\n                <!-- Verb 2: talk -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\">\n                    <span class=\"font-medium text-slate-800 text-sm\">talk</span>\n                    <select class=\"py-1 px-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"A\">\n                        <option value=\"\">--</option>\n                        <option value=\"A\">A</option>\n                        <option value=\"S\">S</option>\n                    </select>\n                </div>\n\n                <!-- Verb 3: seem -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\">\n                    <span class=\"font-medium text-slate-800 text-sm\">seem</span>\n                    <select class=\"py-1 px-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"S\">\n                        <option value=\"\">--</option>\n                        <option value=\"A\">A</option>\n                        <option value=\"S\">S</option>\n                    </select>\n                </div>\n\n                <!-- Verb 4: spend -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\">\n                    <span class=\"font-medium text-slate-800 text-sm\">spend</span>\n                    <select class=\"py-1 px-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"A\">\n                        <option value=\"\">--</option>\n                        <option value=\"A\">A</option>\n                        <option value=\"S\">S</option>\n                    </select>\n                </div>\n\n                <!-- Verb 5: agree -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\">\n                    <span class=\"font-medium text-slate-800 text-sm\">agree</span>\n                    <select class=\"py-1 px-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"S\">\n                        <option value=\"\">--</option>\n                        <option value=\"A\">A</option>\n                        <option value=\"S\">S</option>\n                    </select>\n                </div>\n\n                <!-- Verb 6: eat -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\">\n                    <span class=\"font-medium text-slate-800 text-sm\">eat</span>\n                    <select class=\"py-1 px-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"A\">\n                        <option value=\"\">--</option>\n                        <option value=\"A\">A</option>\n                        <option value=\"S\">S</option>\n                    </select>\n                </div>\n\n                <!-- Verb 7: prefer -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\">\n                    <span class=\"font-medium text-slate-800 text-sm\">prefer</span>\n                    <select class=\"py-1 px-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"S\">\n                        <option value=\"\">--</option>\n                        <option value=\"A\">A</option>\n                        <option value=\"S\">S</option>\n                    </select>\n                </div>\n\n                <!-- Verb 8: want -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between\">\n                    <span class=\"font-medium text-slate-800 text-sm\">want</span>\n                    <select class=\"py-1 px-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"S\">\n                        <option value=\"\">--</option>\n                        <option value=\"A\">A</option>\n                        <option value=\"S\">S</option>\n                    </select>\n                </div>\n            </div>\n        </section>\n\n        <!-- ACTION BUTTONS -->\n        <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4 pt-4\">\n            <button id=\"check-btn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-md transition active:scale-95 flex items-center justify-center space-x-2 text-base\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                <span>Check Answers</span>\n            </button>\n        </div>\n\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"w-full text-center py-6 text-xs text-slate-400 border-t border-slate-200 mt-12 bg-white\">\n        Interactive ELT Micro-Application • Responsive Touch Optimized\n    </footer>\n\n    <!-- JAVASCRIPT LOGIC -->\n    <script>\n        // METRICS & CONTRACT DECLARATION\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'present_continuous_vs_present_simple',\n            maxScore: 14\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const scoreCurrent = document.getElementById('score-current');\n            const scoreTotal = document.getElementById('score-total');\n\n            // Gather all interactives (selects)\n            const interactives = document.querySelectorAll('select[data-answer]');\n            scoreTotal.textContent = interactives.length;\n            window.ACTIVITY_METRICS.maxScore = interactives.length;\n\n            function checkAnswers() {\n                let correctCount = 0;\n\n                interactives.forEach(el => {\n                    const userVal = el.value.trim();\n                    const correctVal = el.getAttribute('data-answer').trim();\n\n                    // Remove previous feedback classes\n                    el.classList.remove('is-correct', 'is-wrong');\n\n                    if (userVal === correctVal) {\n                        el.classList.add('is-correct');\n                        correctCount++;\n                    } else {\n                        el.classList.add('is-wrong');\n                    }\n                });\n\n                // Update score display\n                scoreCurrent.textContent = correctCount;\n\n                // Dispatch mandatory custom event\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: interactives.length,\n                        completed: correctCount === interactives.length\n                    }\n                }));\n\n                // Post message for parent frame embedding\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: interactives.length\n                    }, '*');\n                }\n            }\n\n            function resetActivity() {\n                interactives.forEach(el => {\n                    el.value = '';\n                    el.classList.remove('is-correct', 'is-wrong');\n                });\n                scoreCurrent.textContent = '0';\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: interactives.length,\n                        completed: false\n                    }\n                }));\n            }\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793558988215,
      "title": "G2.2 Present Continuous and Present Simple Reference Guide",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>G2.2 Present Continuous and Present Simple Reference Guide</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom scrollbar and smooth transitions */\n    html {\n      scroll-behavior: smooth;\n    }\n    body {\n      background-color: #f8fafc;\n      color: #1e293b;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen py-6 px-3 sm:px-6 md:px-8\">\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-12\">\n\n    <!-- Header Sticky Section -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-4 px-6 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4 shadow-xs\">\n      <div class=\"flex items-center space-x-3\">\n        <div class=\"bg-indigo-600 text-white font-bold px-3 py-1.5 rounded-lg text-sm shadow-xs flex items-center gap-1.5\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n          G2.2\n        </div>\n        <div>\n          <h1 class=\"text-lg sm:text-xl font-extrabold text-slate-800 tracking-tight\">Present Continuous and Present Simple</h1>\n          <p class=\"text-xs text-slate-500 font-medium\">Grammar Reference & Structure Guide (2B 5 p15)</p>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <span class=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100\">\n          Interactive Reference\n        </span>\n      </div>\n    </header>\n\n    <!-- Content Body -->\n    <div class=\"p-5 sm:p-8 space-y-8\">\n\n      <!-- SECTION 1: USAGE (Present Continuous & Present Simple) -->\n      <section class=\"space-y-6\">\n        <div class=\"border-l-4 border-indigo-600 pl-4\">\n          <h2 class=\"text-xl font-bold text-slate-900\">When do we use them?</h2>\n          <p class=\"text-sm text-slate-500\">Core functional rules with contextual examples.</p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          \n          <!-- Present Continuous Card -->\n          <div class=\"bg-indigo-50/50 border border-indigo-100 rounded-xl p-5 shadow-xs space-y-3\">\n            <div class=\"flex items-center justify-between\">\n              <h3 class=\"font-bold text-indigo-900 text-base flex items-center gap-2\">\n                <span class=\"w-2.5 h-2.5 rounded-full bg-indigo-600\"></span>\n                Present Continuous\n              </h3>\n            </div>\n            <ul class=\"space-y-3 text-sm text-slate-700\">\n              <li class=\"bg-white/80 p-3 rounded-lg border border-indigo-100/50\">\n                <strong class=\"text-indigo-900 block mb-0.5\">a) Happening at the moment of speaking:</strong>\n                <span class=\"italic text-slate-600\">\"I'm cooking dinner. That's exactly what I'm making!\"</span>\n              </li>\n              <li class=\"bg-white/80 p-3 rounded-lg border border-indigo-100/50\">\n                <strong class=\"text-indigo-900 block mb-0.5\">b) Temporary & around now (not exact moment):</strong>\n                <span class=\"italic text-slate-600\">\"I'm writing a book in my spare time. She's doing an evening course in traditional English cooking!\"</span>\n              </li>\n              <li class=\"bg-white/80 p-3 rounded-lg border border-indigo-100/50\">\n                <strong class=\"text-indigo-900 block mb-0.5\">c) Changing over a period of time:</strong>\n                <span class=\"italic text-slate-600\">\"The market is growing rapidly. They're becoming more common in Germany.\"</span>\n              </li>\n            </ul>\n          </div>\n\n          <!-- Present Simple Card -->\n          <div class=\"bg-emerald-50/50 border border-emerald-100 rounded-xl p-5 shadow-xs space-y-3\">\n            <div class=\"flex items-center justify-between\">\n              <h3 class=\"font-bold text-emerald-900 text-base flex items-center gap-2\">\n                <span class=\"w-2.5 h-2.5 rounded-full bg-emerald-600\"></span>\n                Present Simple\n              </h3>\n            </div>\n            <ul class=\"space-y-3 text-sm text-slate-700\">\n              <li class=\"bg-white/80 p-3 rounded-lg border border-emerald-100/50\">\n                <strong class=\"text-emerald-900 block mb-0.5\">a) Habits, daily routines, regular activities:</strong>\n                <span class=\"italic text-slate-600\">\"My mother still cooks a full three-course meal every evening. These days we only spend 20 minutes each day cooking food.\"</span>\n              </li>\n              <li class=\"bg-white/80 p-3 rounded-lg border border-emerald-100/50\">\n                <strong class=\"text-emerald-900 block mb-0.5\">b) Permanent situations or long-term truths:</strong>\n                <span class=\"italic text-slate-600\">\"People who live in the UK spend over £1 billion a year. People in the USA and Sweden also buy a lot of ready meals.\"</span>\n              </li>\n              <li class=\"bg-white/80 p-3 rounded-lg border border-emerald-100/50\">\n                <strong class=\"text-emerald-900 block mb-0.5\">c) Verbs describing states (have got, be, know, think):</strong>\n                <span class=\"italic text-slate-600\">\"Many experts now believe that they're bad for our health. We need to read the labels carefully.\"</span>\n              </li>\n            </ul>\n          </div>\n\n        </div>\n      </section>\n\n      <!-- SECTION 2: ACTIVITY AND STATE VERBS -->\n      <section class=\"space-y-6 pt-4 border-t border-slate-100\">\n        <div class=\"border-l-4 border-amber-500 pl-4\">\n          <h2 class=\"text-xl font-bold text-slate-900\">Activity and State Verbs</h2>\n          <p class=\"text-sm text-slate-500\">Understanding dynamic actions vs. static states.</p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div class=\"bg-amber-50/50 border border-amber-100 rounded-xl p-5 space-y-3\">\n            <h3 class=\"font-bold text-amber-900 text-sm uppercase tracking-wide\">Activity Verbs (Dynamic)</h3>\n            <p class=\"text-sm text-slate-700 leading-relaxed\">\n              Talk about activities and actions. We can use activity verbs in both the <strong>Present Simple</strong> and the <strong>Present Continuous</strong> (and other continuous forms).\n            </p>\n            <div class=\"bg-white/90 p-3 rounded-lg border border-amber-200 text-sm text-slate-600 italic\">\n              \"I watch TV every evening. I'm watching TV now.\"\n            </div>\n            <p class=\"text-xs text-slate-500\"><strong>Typical activity verbs:</strong> watch, talk, spend, eat, learn, buy, cook, take.</p>\n          </div>\n\n          <div class=\"bg-slate-100/70 border border-slate-200 rounded-xl p-5 space-y-3\">\n            <h3 class=\"font-bold text-slate-900 text-sm uppercase tracking-wide\">State Verbs (Stative)</h3>\n            <p class=\"text-sm text-slate-700 leading-relaxed\">\n              Talk about states, feelings and opinions. We <strong>don't usually use state verbs</strong> in the Present Continuous.\n            </p>\n            <div class=\"bg-white/90 p-3 rounded-lg border border-slate-200 text-sm text-slate-600\">\n              <span class=\"text-emerald-700 font-semibold\">✓ I like broccoli.</span><br>\n              <span class=\"text-rose-600 font-semibold line-through\">✗ I'm liking broccoli.</span>\n            </div>\n            <p class=\"text-xs text-slate-500\">State verbs describe feelings or conditions that aren't dynamic actions.</p>\n          </div>\n        </div>\n\n        <!-- Common State Verbs Table/Grid -->\n        <div class=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs space-y-4\">\n          <h3 class=\"font-bold text-slate-800 text-sm uppercase tracking-wide border-b pb-2\">Learn these common state verbs:</h3>\n          <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 text-sm\">\n            <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100\">\n              <span class=\"font-bold text-indigo-700 block mb-1 text-xs uppercase\">be & have verbs</span>\n              <ul class=\"text-slate-600 space-y-1 text-xs\">\n                <li>be</li>\n                <li>have (got)</li>\n                <li>own</li>\n                <li>belong</li>\n              </ul>\n            </div>\n            <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100\">\n              <span class=\"font-bold text-indigo-700 block mb-1 text-xs uppercase\">think & know</span>\n              <ul class=\"text-slate-600 space-y-1 text-xs\">\n                <li>think</li>\n                <li>know</li>\n                <li>believe</li>\n                <li>understand</li>\n                <li>remember</li>\n                <li>forget</li>\n                <li>mean</li>\n              </ul>\n            </div>\n            <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100\">\n              <span class=\"font-bold text-indigo-700 block mb-1 text-xs uppercase\">like & hate</span>\n              <ul class=\"text-slate-600 space-y-1 text-xs\">\n                <li>like</li>\n                <li>love</li>\n                <li>hate</li>\n                <li>prefer</li>\n                <li>want</li>\n              </ul>\n            </div>\n            <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100\">\n              <span class=\"font-bold text-indigo-700 block mb-1 text-xs uppercase\">senses</span>\n              <ul class=\"text-slate-600 space-y-1 text-xs\">\n                <li>see</li>\n                <li>hear</li>\n                <li>taste</li>\n                <li>smell</li>\n                <li>touch</li>\n              </ul>\n            </div>\n            <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100\">\n              <span class=\"font-bold text-indigo-700 block mb-1 text-xs uppercase\">other verbs</span>\n              <ul class=\"text-slate-600 space-y-1 text-xs\">\n                <li>hope</li>\n                <li>seem</li>\n                <li>need</li>\n                <li>cost</li>\n                <li>agree</li>\n                <li>weigh</li>\n                <li>contain</li>\n              </ul>\n            </div>\n          </div>\n        </div>\n\n        <!-- Tips Box -->\n        <div class=\"bg-blue-50 border border-blue-200 rounded-xl p-5 space-y-3 text-sm text-blue-900\">\n          <div class=\"flex items-center gap-2 font-bold text-blue-950\">\n            <svg class=\"w-5 h-5 text-blue-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n            TIPS!\n          </div>\n          <ul class=\"space-y-2 text-xs sm:text-sm text-blue-900/90 list-disc list-inside\">\n            <li>We often use <strong>can</strong> with verbs that describe the senses to talk about what is happening now: <span class=\"italic font-medium\">I can hear a noise outside. I can't see anything.</span></li>\n            <li>Some verbs can be <strong>both activity and state verbs</strong>: <span class=\"italic font-medium\">I'm having dinner at the moment (activity)</span> vs <span class=\"italic font-medium\">They have two dogs (state)</span>. <span class=\"italic font-medium\">What are you thinking about? (activity)</span> vs <span class=\"italic font-medium\">I think football is boring (state)</span>.</li>\n            <li>We often use <strong>still</strong> with the Present Simple and Present Continuous to mean something that started in the past and continues in the present: <span class=\"italic font-medium\">My mother still cooks a full three-course meal every evening. The Spanish and Italians are still cooking their own meals.</span></li>\n          </ul>\n        </div>\n      </section>\n\n      <!-- SECTION 3: STRUCTURE & FORMATION -->\n      <section class=\"space-y-6 pt-4 border-t border-slate-100\">\n        <div class=\"border-l-4 border-emerald-600 pl-4\">\n          <h2 class=\"text-xl font-bold text-slate-900\">Structure & Formation</h2>\n          <p class=\"text-sm text-slate-500\">Positive, negative, and question patterns.</p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          \n          <!-- Present Continuous Formation -->\n          <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-5 space-y-4\">\n            <h3 class=\"font-bold text-indigo-900 text-base border-b pb-2\">Present Continuous</h3>\n            \n            <div class=\"space-y-2 text-sm\">\n              <p class=\"font-semibold text-slate-700\">Positive and Negative:</p>\n              <div class=\"bg-white p-3 rounded-lg border border-slate-200 font-mono text-xs text-indigo-700\">\n                subject + be + (not) + verb+ing\n              </div>\n              <p class=\"text-xs text-slate-600 italic\">\"I'm (not) cooking dinner at the moment.<br>You/We/They are/aren't writing a book.<br>He/She/It's/isn't becoming more popular.\"</p>\n            </div>\n\n            <div class=\"space-y-2 text-sm pt-2\">\n              <p class=\"font-semibold text-slate-700\">Questions:</p>\n              <div class=\"bg-white p-3 rounded-lg border border-slate-200 font-mono text-xs text-indigo-700\">\n                (question word) + am/are/is + subject + verb+ing\n              </div>\n              <p class=\"text-xs text-slate-600 italic\">\"What am I doing here?<br>Who are you/we/they talking to?<br>Is he/she/it working today?\"</p>\n            </div>\n          </div>\n\n          <!-- Present Simple Formation -->\n          <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-5 space-y-4\">\n            <h3 class=\"font-bold text-emerald-900 text-base border-b pb-2\">Present Simple</h3>\n            \n            <div class=\"space-y-2 text-sm\">\n              <p class=\"font-semibold text-slate-700\">Positive:</p>\n              <p class=\"text-xs text-slate-600\">For <span class=\"font-mono font-bold\">I/you/we/they</span>, the positive is the same as the infinitive. For <span class=\"font-mono font-bold\">he/she/it</span>, we add <span class=\"font-mono font-bold\">-s</span> or <span class=\"font-mono font-bold\">-es</span> to the infinitive.</p>\n              <div class=\"bg-white p-3 rounded-lg border border-slate-200 font-mono text-xs text-emerald-700\">\n                he lives; she goes; it works.\n              </div>\n            </div>\n\n            <div class=\"space-y-2 text-sm\">\n              <p class=\"font-semibold text-slate-700\">Negative:</p>\n              <div class=\"bg-white p-3 rounded-lg border border-slate-200 font-mono text-xs text-emerald-700\">\n                subject + don't/doesn't + infinitive\n              </div>\n              <p class=\"text-xs text-slate-600 italic\">\"I/You/We/They don't cook. He/She/It doesn't go out.\"</p>\n            </div>\n\n            <div class=\"space-y-2 text-sm\">\n              <p class=\"font-semibold text-slate-700\">Questions:</p>\n              <div class=\"bg-white p-3 rounded-lg border border-slate-200 font-mono text-xs text-emerald-700\">\n                (question word) + do/does + subject + infinitive\n              </div>\n              <p class=\"text-xs text-slate-600 italic\">\"Where do I/you/we/they live? Does he/she/it work?\"</p>\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n    </div>\n\n    <!-- Footer Note -->\n    <footer class=\"bg-slate-50 border-t border-slate-100 py-4 px-6 text-center text-xs text-slate-400\">\n      G2.2 Reference Activity • English Language Teaching Guide\n    </footer>\n\n  </main>\n\n</body>\n</html>"
    },
    {
      "id": 1793559136892,
      "title": "Present Simple vs Present Continuous - Linda & Her Mother",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Present Simple vs Present Continuous - Linda & Her Mother</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Estilos personalizados para transiciones y feedback visual */\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Top Header con Indicador de Progreso y Acciones -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-8 border-b border-slate-200 w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-inner\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </div>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">Grammar Practice: Present Simple vs. Continuous</h1>\n                    <p class=\"text-xs text-slate-500\">Read the paragraphs, identify the speaker, and complete the verbs.</p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3\">\n                <div id=\"score-counter\" class=\"text-sm font-semibold bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg border border-slate-200\">\n                    Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">14</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Contenedor Principal (w-full max-w-4xl mx-auto) -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-6\">\n        \n        <!-- Instrucciones y Ejercicio 7a -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-7 shadow-sm mb-6\">\n            <div class=\"flex items-start gap-3 mb-4\">\n                <span class=\"flex-shrink-0 bg-indigo-600 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">7</span>\n                <div>\n                    <h2 class=\"text-base sm:text-lg font-semibold text-slate-900\">a) Who is speaking in each paragraph?</h2>\n                    <p class=\"text-sm text-slate-600\">Select whether paragraph 1 and paragraph 2 are spoken by <strong>Linda</strong> or <strong>her mother</strong>.</p>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4\">\n                <!-- Speaker Para 1 -->\n                <div class=\"bg-slate-50 border border-slate-200 p-4 rounded-xl\">\n                    <label class=\"block text-sm font-medium text-slate-700 mb-2\">Paragraph 1 speaker:</label>\n                    <select id=\"speaker-1\" data-answer=\"Linda\" class=\"w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- Choose speaker --</option>\n                        <option value=\"Linda\">Linda</option>\n                        <option value=\"her mother\">Her mother</option>\n                    </select>\n                </div>\n                <!-- Speaker Para 2 -->\n                <div class=\"bg-slate-50 border border-slate-200 p-4 rounded-xl\">\n                    <label class=\"block text-sm font-medium text-slate-700 mb-2\">Paragraph 2 speaker:</label>\n                    <select id=\"speaker-2\" data-answer=\"her mother\" class=\"w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- Choose speaker --</option>\n                        <option value=\"Linda\">Linda</option>\n                        <option value=\"her mother\">Her mother</option>\n                    </select>\n                </div>\n            </div>\n        </section>\n\n        <!-- Ejercicio 7b: Completar con Present Simple o Present Continuous -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-7 shadow-sm mb-8\">\n            <div class=\"flex items-start gap-3 mb-6\">\n                <span class=\"flex-shrink-0 bg-indigo-600 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">b</span>\n                <div>\n                    <h2 class=\"text-base sm:text-lg font-semibold text-slate-900\">Put the verbs in brackets in the Present Simple or Present Continuous.</h2>\n                    <p class=\"text-sm text-slate-600\">Type the correct conjugated verb form in each gap. Pay attention to contractions (e.g., <code class=\"bg-slate-100 px-1 py-0.5 rounded text-xs\">'m cooking</code> or <code class=\"bg-slate-100 px-1 py-0.5 rounded text-xs\">am cooking</code>).</p>\n                </div>\n            </div>\n\n            <!-- Párrafo 1 -->\n            <div class=\"mb-8\">\n                <span class=\"inline-block bg-indigo-100 text-indigo-800 text-xs font-bold px-2.5 py-1 rounded-md mb-3\">Paragraph 1</span>\n                <p class=\"text-base leading-relaxed text-slate-800 space-y-3\">\n                    The ready meal I \n                    <input type=\"text\" data-answer=\"'m cooking,am cooking\" data-alts=\"'m cooking|am cooking\" placeholder=\"1...\" class=\"inline-block w-36 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (cook) right now is chicken and vegetables. I \n                    <input type=\"text\" data-answer=\"eat\" data-alts=\"eat\" placeholder=\"2...\" class=\"inline-block w-24 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (eat) a lot of ready meals because I \n                    <input type=\"text\" data-answer=\"prefer\" data-alts=\"prefer\" placeholder=\"3...\" class=\"inline-block w-28 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (prefer) to do other things in the evening. I \n                    <input type=\"text\" data-answer=\"'m learning,am learning\" data-alts=\"'m learning|am learning\" placeholder=\"4...\" class=\"inline-block w-36 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (learn) Italian at the moment, so I often \n                    <input type=\"text\" data-answer=\"watch\" data-alts=\"watch\" placeholder=\"5...\" class=\"inline-block w-28 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (watch) Italian films in the evenings. I \n                    <input type=\"text\" data-answer=\"think\" data-alts=\"think\" placeholder=\"6...\" class=\"inline-block w-24 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (think) my Italian \n                    <input type=\"text\" data-answer=\"'s getting,is getting\" data-alts=\"'s getting|is getting\" placeholder=\"7...\" class=\"inline-block w-32 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (get) quite good.\n                </p>\n            </div>\n\n            <!-- Párrafo 2 -->\n            <div>\n                <span class=\"inline-block bg-pink-100 text-pink-800 text-xs font-bold px-2.5 py-1 rounded-md mb-3\">Paragraph 2</span>\n                <p class=\"text-base leading-relaxed text-slate-800 space-y-3\">\n                    I \n                    <input type=\"text\" data-answer=\"don't understand\" data-alts=\"don't understand|do not understand\" placeholder=\"8...\" class=\"inline-block w-36 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (not understand) her. She says that she \n                    <input type=\"text\" data-answer=\"'s putting,is putting\" data-alts=\"'s putting|is putting\" placeholder=\"9...\" class=\"inline-block w-32 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (put on) weight – well, that's because she \n                    <input type=\"text\" data-answer=\"never eats\" data-alts=\"never eats\" placeholder=\"10...\" class=\"inline-block w-32 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (never eat) properly. Also she \n                    <input type=\"text\" data-answer=\"doesn't know\" data-alts=\"doesn't know|does not know\" placeholder=\"11...\" class=\"inline-block w-36 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    (not know) how to cook, so why \n                    <input type=\"text\" data-answer=\"is studying\" data-alts=\"is studying\" placeholder=\"12...\" class=\"inline-block w-24 mx-1 border border-slate-300 rounded-lg px-3 py-2 text-sm text-center focus:ring-2 focus:ring-indigo-500 focus:outline-none\" />\n                    she \n                    <span class=\"italic text-slate-500\">(study)</span> \n                    Italian instead of going to cookery classes?\n                </p>\n            </div>\n        </section>\n\n        <!-- Botones de Acción -->\n        <div class=\"flex flex-wrap items-center justify-center gap-4\">\n            <button id=\"check-btn\" onclick=\"checkAnswers()\" class=\"bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium px-6 py-3 rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer min-h-[42px]\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                Check Answers\n            </button>\n            <button id=\"reset-btn\" onclick=\"resetActivity()\" class=\"bg-white hover:bg-slate-100 text-slate-700 font-medium px-6 py-3 rounded-xl border border-slate-300 shadow-sm transition-all flex items-center gap-2 cursor-pointer min-h-[42px]\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                </svg>\n                Reset Activity\n            </button>\n        </div>\n\n    </main>\n\n    <!-- Footer Institucional Sutil -->\n    <footer class=\"w-full py-4 text-center text-xs text-slate-400 border-t border-slate-200 bg-white\">\n        Interactive ELT Module &bull; Present Simple vs Present Continuous\n    </footer>\n\n    <!-- Lógica de Calificación y Métricas -->\n    <script>\n        // CONTRATO OBLIGATORIO DE MÉTRICAS PEDAGÓGICAS\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'present_simple_vs_continuous',\n            maxScore: 14\n        };\n\n        function normalize(str) {\n            return str.toLowerCase().trim().replace(/\\s+/g, ' ');\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalItems = 14;\n\n            // 1. Validar selects (speaker 1 y speaker 2)\n            const selects = [document.getElementById('speaker-1'), document.getElementById('speaker-2')];\n            selects.forEach(select => {\n                const userVal = select.value.trim();\n                const expected = select.getAttribute('data-answer');\n                if (userVal.toLowerCase() === expected.toLowerCase()) {\n                    select.classList.remove('is-wrong', 'border-slate-300');\n                    select.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    select.classList.remove('is-correct', 'border-slate-300');\n                    select.classList.add('is-wrong');\n                }\n            });\n\n            // 2. Validar inputs de texto\n            const inputs = document.querySelectorAll('input[type=\"text\"]');\n            inputs.forEach(input => {\n                const userVal = normalize(input.value);\n                const allowedAnswers = input.getAttribute('data-alts').split('|').map(a => normalize(a));\n                \n                if (allowedAnswers.includes(userVal)) {\n                    input.classList.remove('is-wrong', 'border-slate-300');\n                    input.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    input.classList.remove('is-correct', 'border-slate-300');\n                    input.classList.add('is-wrong');\n                }\n            });\n\n            // Actualizar marcador visual en pantalla\n            document.getElementById('current-score').textContent = correctCount;\n\n            // Disparar eventos de analítica y comunicación con el contenedor principal (iframe / LMS)\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: totalItems,\n                    completed: correctCount === totalItems\n                }\n            }));\n\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalItems\n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            // Limpiar selects\n            const selects = [document.getElementById('speaker-1'), document.getElementById('speaker-2')];\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('is-correct', 'is-wrong');\n                select.classList.add('border-slate-300');\n            });\n\n            // Limpiar inputs\n            const inputs = document.querySelectorAll('input[type=\"text\"]');\n            inputs.forEach(input => {\n                input.value = \"\";\n                input.classList.remove('is-correct', 'is-wrong');\n                input.classList.add('border-slate-300');\n            });\n\n            // Restablecer contador\n            document.getElementById('current-score').textContent = '0';\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793562165030,
      "title": "Eating Habits - Interactive Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Eating Habits - Interactive Activity</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom smooth transitions and animations */\n    .transition-all {\n      transition: all 0.25s ease-in-out;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Header Bar -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"max-w-4xl mx-auto flex justify-between items-center\">\n      <div class=\"flex items-center space-x-2\">\n        <span class=\"bg-emerald-600 text-white font-bold px-2.5 py-1 rounded-lg text-sm shadow-sm\">8</span>\n        <h1 class=\"text-base sm:text-lg font-semibold text-slate-900 tracking-tight\">Changing Eating Habits</h1>\n      </div>\n      <div id=\"score-display\" class=\"text-sm font-medium text-slate-600 bg-slate-100 px-3 py-1 rounded-full border border-slate-200\">\n        Score: <span id=\"current-score\">0</span> / <span id=\"max-score\">8</span>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 my-6 bg-white border border-slate-200 rounded-2xl shadow-sm flex-grow\">\n    \n    <!-- Instructions Section -->\n    <section class=\"mb-6 bg-emerald-50 border border-emerald-100 rounded-xl p-4 sm:p-5\">\n      <div class=\"flex items-start space-x-3\">\n        <div class=\"bg-emerald-600 text-white p-2 rounded-lg mt-0.5 flex-shrink-0\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z\" />\n          </svg>\n        </div>\n        <div>\n          <h2 class=\"font-bold text-emerald-900 text-base sm:text-lg\">a) Make sentences about how eating habits in your country are changing.</h2>\n          <p class=\"text-emerald-700 text-sm mt-1\">Complete each sentence using the correct present continuous form or vocabulary trend based on the ideas provided below.</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- Ideas Reference Pills -->\n    <section class=\"mb-8\">\n      <h3 class=\"text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3\">Vocabulary Ideas to Use:</h3>\n      <div class=\"flex flex-wrap gap-2\">\n        <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 shadow-2xs\">🍔 fast food</span>\n        <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 shadow-2xs\">🌱 organic food</span>\n        <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 shadow-2xs\">🍽️ restaurants</span>\n        <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 shadow-2xs\">💰 prices</span>\n        <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 shadow-2xs\">🛒 supermarkets</span>\n        <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 shadow-2xs\">🌍 food from other countries</span>\n        <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 shadow-2xs\">⚖️ the amount people eat</span>\n        <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 shadow-2xs\">⭐ quality of food</span>\n      </div>\n    </section>\n\n    <!-- Example Box -->\n    <div class=\"mb-6 p-4 bg-slate-50 border-l-4 border-slate-400 rounded-r-xl italic text-slate-600 text-sm\">\n      <span class=\"font-semibold not-italic text-slate-700\">Example:</span> Teenagers are eating more fast food these days.\n    </div>\n\n    <!-- Interactive Sentences Form -->\n    <form id=\"activity-form\" class=\"space-y-4\" onsubmit=\"event.preventDefault();\">\n      \n      <!-- Item 1 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold\">1</span>\n          <span class=\"text-slate-700 font-medium text-sm sm:text-base\">More people</span>\n        </div>\n        <div class=\"flex items-center space-x-2 flex-grow max-w-md\">\n          <input type=\"text\" \n                 data-answer=\"are buying organic food\" \n                 data-alts=\"are buying organic food,are purchasing organic food,buy organic food\"\n                 placeholder=\"e.g. are buying organic food\" \n                 class=\"w-full px-3.5 py-2.5 text-sm sm:text-base bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 2 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold\">2</span>\n          <span class=\"text-slate-700 font-medium text-sm sm:text-base\">The number of</span>\n        </div>\n        <div class=\"flex items-center space-x-2 flex-grow max-w-md\">\n          <input type=\"text\" \n                 data-answer=\"restaurants is increasing\" \n                 data-alts=\"restaurants are increasing,restaurants is growing\"\n                 placeholder=\"e.g. restaurants is increasing\" \n                 class=\"w-full px-3.5 py-2.5 text-sm sm:text-base bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold\">3</span>\n          <span class=\"text-slate-700 font-medium text-sm sm:text-base\">Food</span>\n        </div>\n        <div class=\"flex items-center space-x-2 flex-grow max-w-md\">\n          <input type=\"text\" \n                 data-answer=\"prices are getting higher\" \n                 data-alts=\"prices are rising,prices are going up,prices are increasing\"\n                 placeholder=\"e.g. prices are getting higher\" \n                 class=\"w-full px-3.5 py-2.5 text-sm sm:text-base bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 4 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold\">4</span>\n          <span class=\"text-slate-700 font-medium text-sm sm:text-base\">Supermarkets</span>\n        </div>\n        <div class=\"flex items-center space-x-2 flex-grow max-w-md\">\n          <input type=\"text\" \n                 data-answer=\"are selling more international food\" \n                 data-alts=\"are selling more foreign food,are offering more imported food\"\n                 placeholder=\"e.g. are selling more international food\" \n                 class=\"w-full px-3.5 py-2.5 text-sm sm:text-base bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 5 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold\">5</span>\n          <span class=\"text-slate-700 font-medium text-sm sm:text-base\">People</span>\n        </div>\n        <div class=\"flex items-center space-x-2 flex-grow max-w-md\">\n          <input type=\"text\" \n                 data-answer=\"are eating out more often\" \n                 data-alts=\"are eating in restaurants more often,are consuming more food\"\n                 placeholder=\"e.g. are eating out more often\" \n                 class=\"w-full px-3.5 py-2.5 text-sm sm:text-base bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 6 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold\">6</span>\n          <span class=\"text-slate-700 font-medium text-sm sm:text-base\">The amount of food</span>\n        </div>\n        <div class=\"flex items-center space-x-2 flex-grow max-w-md\">\n          <input type=\"text\" \n                 data-answer=\"people waste is growing\" \n                 data-alts=\"people waste is increasing,we throw away is increasing\"\n                 placeholder=\"e.g. people waste is growing\" \n                 class=\"w-full px-3.5 py-2.5 text-sm sm:text-base bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 7 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold\">7</span>\n          <span class=\"text-slate-700 font-medium text-sm sm:text-base\">We</span>\n        </div>\n        <div class=\"flex items-center space-x-2 flex-grow max-w-md\">\n          <input type=\"text\" \n                 data-answer=\"are eating more food from other countries\" \n                 data-alts=\"are trying food from other countries,are eating imported food\"\n                 placeholder=\"e.g. are eating more food from other countries\" \n                 class=\"w-full px-3.5 py-2.5 text-sm sm:text-base bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 8 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold\">8</span>\n          <span class=\"text-slate-700 font-medium text-sm sm:text-base\">The quality of food</span>\n        </div>\n        <div class=\"flex items-center space-x-2 flex-grow max-w-md\">\n          <input type=\"text\" \n                 data-answer=\"is getting better\" \n                 data-alts=\"is improving,is changing,is getting worse\"\n                 placeholder=\"e.g. is getting better\" \n                 class=\"w-full px-3.5 py-2.5 text-sm sm:text-base bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all\">\n        </div>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-100\">\n        <button type=\"button\" \n                onclick=\"checkAnswers()\" \n                class=\"w-full sm:w-auto px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl shadow-sm transition-all flex items-center justify-center space-x-2 cursor-pointer text-base\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n          </svg>\n          <span>Check Answers</span>\n        </button>\n\n        <button type=\"button\" \n                onclick=\"resetActivity()\" \n                class=\"w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition-all flex items-center justify-center space-x-2 cursor-pointer text-base\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n          </svg>\n          <span>Reset</span>\n        </button>\n      </div>\n\n    </form>\n\n    <!-- Part B Instructions Section -->\n    <section class=\"mt-8 pt-6 border-t border-slate-200 bg-sky-50 border border-sky-100 rounded-xl p-4 sm:p-5\">\n      <div class=\"flex items-start space-x-3\">\n        <div class=\"bg-sky-600 text-white p-2 rounded-lg mt-0.5 flex-shrink-0\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\" />\n          </svg>\n        </div>\n        <div>\n          <h2 class=\"font-bold text-sky-900 text-base sm:text-lg\">b) Work in groups. Tell other students five things you found out about the class.</h2>\n          <p class=\"text-sky-700 text-sm mt-1\">Discuss your findings with your classmates using the sentences you created and share interesting trends you discovered.</p>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"text-center py-4 text-xs text-slate-400\">\n    Interactive ELT Learning Module • Responsive Design\n  </footer>\n\n  <!-- Script Logic & Metrics Contract -->\n  <script>\n    // Mandatory Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'eating_habits_sentences',\n      maxScore: 8\n    };\n\n    function normalizeText(text) {\n      return text.toLowerCase()\n                 .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g, \"\")\n                 .replace(/\\s{2,}/g, \" \")\n                 .trim();\n    }\n\n    function checkAnswers() {\n      const inputs = document.querySelectorAll('input[data-answer]');\n      let correctCount = 0;\n\n      inputs.forEach(input => {\n        const userVal = normalizeText(input.value);\n        const primaryAnswer = normalizeText(input.getAttribute('data-answer'));\n        const altAnswers = input.getAttribute('data-alts') \n                           ? input.getAttribute('data-alts').split(',').map(a => normalizeText(a)) \n                           : [];\n\n        // Remove previous styles\n        input.classList.remove('border-emerald-500', 'bg-emerald-50', 'border-red-500', 'bg-red-50', 'text-emerald-900', 'text-red-900');\n\n        if (userVal === \"\" ) {\n          input.classList.add('border-slate-300', 'bg-slate-50');\n          return;\n        }\n\n        const isCorrect = (userVal === primaryAnswer) || altAnswers.includes(userVal) || userVal.includes(primaryAnswer);\n\n        if (isCorrect) {\n          input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-medium');\n          correctCount++;\n        } else {\n          input.classList.add('border-red-500', 'bg-red-50', 'text-red-900');\n        }\n      });\n\n      // Update UI Score\n      document.getElementById('current-score').textContent = correctCount;\n\n      // Dispatch Custom Event for live analytics\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: inputs.length,\n          completed: correctCount === inputs.length\n        }\n      }));\n\n      // Post message to parent container if embedded in iframe\n      if (window.parent && window.parent !== window) {\n        window.parent.postMessage({ \n          type: 'ACTIVITY_SCORE', \n          score: correctCount, \n          total: inputs.length \n        }, '*');\n      }\n    }\n\n    function resetActivity() {\n      const inputs = document.querySelectorAll('input[data-answer]');\n      inputs.forEach(input => {\n        input.value = \"\";\n        input.classList.remove('border-emerald-500', 'bg-emerald-50', 'border-red-500', 'bg-red-50', 'text-emerald-900', 'text-red-900', 'font-medium');\n        input.classList.add('border-slate-300', 'bg-slate-50');\n      });\n      document.getElementById('current-score').textContent = \"0\";\n\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: 0,\n          total: inputs.length,\n          completed: false\n        }\n      }));\n    }\n  </script>\n</body>\n</html>"
    }
  ]
}