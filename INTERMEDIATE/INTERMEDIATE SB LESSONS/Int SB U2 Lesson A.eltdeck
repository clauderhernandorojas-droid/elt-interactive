{
  "version": "2.0",
  "title": "Int SB U2 Lesson A",
  "updatedAt": "2026-10-31T19:26:47.632Z",
  "slides": [
    {
      "id": 1793472580658,
      "title": "Vocabulary: Work Collocations",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Vocabulary: Work Collocations</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Transiciones suaves y efectos táctiles */\n    .collocation-btn {\n      transition: all 0.2s ease-in-out;\n    }\n    .collocation-btn:active {\n      transform: scale(0.98);\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- CABECERA STICKY SUPERIOR -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 shadow-sm w-full\">\n    <div class=\"max-w-4xl mx-auto flex items-center justify-between\">\n      <div class=\"flex items-center space-x-2\">\n        <span class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 132V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6m18 0a2 2 0 01-2 2h-2a2 2 0 00-2 2v2a2 2 0 01-2 2H9a2 2 0 01-2-2v-2a2 2 0 00-2-2H5a2 2 0 01-2-2m18 0H3\" />\n          </svg>\n        </span>\n        <div>\n          <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Vocabulary: Work Collocations</h1>\n          <p class=\"text-xs text-slate-500\">Choose the correct verbs in these phrases.</p>\n        </div>\n      </div>\n      <!-- CONTADOR DE PUNTUACIÓN STICKY -->\n      <div class=\"flex items-center bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-full shadow-inner\">\n        <span class=\"text-xs font-semibold uppercase tracking-wider text-slate-500 mr-2 hidden sm:inline\">Score:</span>\n        <span id=\"score-display\" class=\"text-sm font-bold text-indigo-600\">0 / 10</span>\n      </div>\n    </div>\n  </header>\n\n  <!-- CONTENEDOR PRINCIPAL -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-4 space-y-6\">\n    \n    <!-- TARJETA INSTRUCCIONAL (a) -->\n    <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6\">\n      <div class=\"flex items-start space-x-3\">\n        <div class=\"bg-indigo-50 text-indigo-700 font-bold w-8 h-8 rounded-full flex items-center justify-center shrink-0 mt-0.5\">\n          1\n        </div>\n        <div>\n          <h2 class=\"text-base sm:text-lg font-semibold text-slate-900 mb-1\">a) Choose the correct verbs in these phrases.</h2>\n          <p class=\"text-sm text-slate-600\">Tap the correct verb for each item to complete the common work collocation.</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- LISTA DE EJERCICIOS (INTERACTIVOS TÁCTILES) -->\n    <section id=\"exercise-list\" class=\"space-y-4\">\n      \n      <!-- Ítem 1 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">1</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"1\" data-value=\"take\">take</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"1\" data-value=\"be\">be</button>\n            </div>\n            <span>work home</span>\n          </div>\n        </div>\n        <div id=\"feedback-1\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 2 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">2</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"2\" data-value=\"be\">be</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"2\" data-value=\"have\">have</button>\n            </div>\n            <span>time to relax</span>\n          </div>\n        </div>\n        <div id=\"feedback-2\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 3 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">3</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"3\" data-value=\"get\">get</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"3\" data-value=\"work\">work</button>\n            </div>\n            <span>long hours</span>\n          </div>\n        </div>\n        <div id=\"feedback-3\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 4 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">4</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"4\" data-value=\"work\">work</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"4\" data-value=\"spend\">spend</button>\n            </div>\n            <span>overtime</span>\n          </div>\n        </div>\n        <div id=\"feedback-4\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 5 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">5</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"5\" data-value=\"get\">get</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"5\" data-value=\"be\">be</button>\n            </div>\n            <span>a workaholic</span>\n          </div>\n        </div>\n        <div id=\"feedback-5\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 6 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">6</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"6\" data-value=\"meet\">meet</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"6\" data-value=\"take\">take</button>\n            </div>\n            <span>deadlines</span>\n          </div>\n        </div>\n        <div id=\"feedback-6\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 7 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">7</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"7\" data-value=\"take\">take</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"7\" data-value=\"be\">be</button>\n            </div>\n            <span>time off work</span>\n          </div>\n        </div>\n        <div id=\"feedback-7\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 8 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">8</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"8\" data-value=\"have\">have</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"8\" data-value=\"be\">be</button>\n            </div>\n            <span>under pressure at work</span>\n          </div>\n        </div>\n        <div id=\"feedback-8\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 9 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">9</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"9\" data-value=\"leave\">leave</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"9\" data-value=\"spend\">spend</button>\n            </div>\n            <span>a lot of time at work</span>\n          </div>\n        </div>\n        <div id=\"feedback-9\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n      <!-- Ítem 10 -->\n      <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div class=\"flex items-center space-x-3\">\n          <span class=\"text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md\">10</span>\n          <div class=\"flex items-center flex-wrap gap-2 text-base font-medium text-slate-800\">\n            <div class=\"inline-flex rounded-lg p-1 bg-slate-100 border border-slate-200 gap-1\">\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"10\" data-value=\"have\">have</button>\n              <button type=\"button\" class=\"collocation-btn px-3 py-2 rounded-md text-sm font-medium bg-white text-slate-700 shadow-sm hover:bg-indigo-50 focus:outline-none\" data-item=\"10\" data-value=\"be\">be</button>\n            </div>\n            <span>good working conditions</span>\n          </div>\n        </div>\n        <div id=\"feedback-10\" class=\"text-sm font-semibold hidden sm:block\"></div>\n      </div>\n\n    </section>\n\n    <!-- BARRA DE ACCIÓN (CHECK & RESET) -->\n    <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4 bg-white border border-slate-200 p-4 sm:p-5 rounded-2xl shadow-sm\">\n      <button id=\"check-btn\" class=\"w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-md transition duration-150 flex items-center justify-center space-x-2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n        </svg>\n        <span>Check Answers</span>\n      </button>\n      <button id=\"reset-btn\" class=\"w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition duration-150 flex items-center justify-center space-x-2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n        </svg>\n        <span>Reset</span>\n      </button>\n    </div>\n\n    <!-- SECCIÓN DE EXTENSIÓN: Ejercicios b) y c) -->\n    <section class=\"space-y-4 pt-4 border-t border-slate-200\">\n      \n      <!-- Ejercicio b -->\n      <div class=\"bg-indigo-50/60 border border-indigo-100 rounded-2xl p-5 sm:p-6 shadow-sm\">\n        <div class=\"flex items-start space-x-3\">\n          <div class=\"bg-indigo-600 text-white font-bold w-8 h-8 rounded-full flex items-center justify-center shrink-0 mt-0.5\">\n            b\n          </div>\n          <div class=\"w-full\">\n            <h2 class=\"text-base sm:text-lg font-semibold text-slate-900 mb-1\">Think of three people you know who have jobs.</h2>\n            <p class=\"text-sm text-slate-600 mb-4\">Choose two phrases from part <strong>a)</strong> for each person.</p>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n              <div class=\"bg-white p-3 rounded-xl border border-slate-200 shadow-sm\">\n                <span class=\"block text-xs font-bold text-indigo-600 uppercase mb-1\">Person 1</span>\n                <input type=\"text\" placeholder=\"e.g., My brother, Anna...\" class=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-2\">\n                <textarea rows=\"2\" placeholder=\"Write two phrases...\" class=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none\"></textarea>\n              </div>\n              <div class=\"bg-white p-3 rounded-xl border border-slate-200 shadow-sm\">\n                <span class=\"block text-xs font-bold text-indigo-600 uppercase mb-1\">Person 2</span>\n                <input type=\"text\" placeholder=\"e.g., My friend, Carlos...\" class=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-2\">\n                <textarea rows=\"2\" placeholder=\"Write two phrases...\" class=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none\"></textarea>\n              </div>\n              <div class=\"bg-white p-3 rounded-xl border border-slate-200 shadow-sm\">\n                <span class=\"block text-xs font-bold text-indigo-600 uppercase mb-1\">Person 3</span>\n                <input type=\"text\" placeholder=\"e.g., My manager...\" class=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-2\">\n                <textarea rows=\"2\" placeholder=\"Write two phrases...\" class=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none\"></textarea>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Ejercicio c -->\n      <div class=\"bg-slate-100 border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm\">\n        <div class=\"flex items-start space-x-3\">\n          <div class=\"bg-slate-700 text-white font-bold w-8 h-8 rounded-full flex items-center justify-center shrink-0 mt-0.5\">\n            c\n          </div>\n          <div>\n            <h2 class=\"text-base sm:text-lg font-semibold text-slate-900 mb-1\">Work in pairs.</h2>\n            <p class=\"text-sm text-slate-700 mb-2\">Tell your partner about the people you chose. <strong>Which person works the hardest?</strong></p>\n            <p class=\"text-xs text-slate-500 italic\">Discuss with a classmate or reflect on your answers aloud to practice your speaking skills.</p>\n          </div>\n        </div>\n      </div>\n\n    </section>\n\n  </main>\n\n  <!-- PIE DE PÁGINA INSTITUCIONAL -->\n  <footer class=\"bg-white border-t border-slate-200 py-4 px-6 text-center text-xs text-slate-500 w-full mt-auto\">\n    Interactive ELT Activity &bull; Work Collocations\n  </footer>\n\n  <!-- LÓGICA JAVASCRIPT Y CONTRATO DE MÉTRICAS -->\n  <script>\n    // CONTRATO OBLIGATORIO DE MÉTRICAS PEDAGÓGICAS\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'work_collocations',\n      maxScore: 10\n    };\n\n    // Respuestas correctas basadas estrictamente en la verdad del Answer Key (Recorte OCR)\n    const answerKey = {\n      1: 'take',\n      2: 'have',\n      3: 'work',\n      4: 'work',\n      5: 'be',\n      6: 'meet',\n      7: 'take',\n      8: 'be',\n      9: 'spend',\n      10: 'have'\n    };\n\n    // Estado del usuario\n    const userSelections = {};\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const buttons = document.querySelectorAll('.collocation-btn');\n      const checkBtn = document.getElementById('check-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const scoreDisplay = document.getElementById('score-display');\n\n      // Manejo de selección en los botones\n      buttons.forEach(btn => {\n        btn.addEventListener('click', () => {\n          const item = btn.getAttribute('data-item');\n          const value = btn.getAttribute('data-value');\n\n          // Desmarcar hermanos del mismo ítem\n          document.querySelectorAll(`.collocation-btn[data-item=\"${item}\"]`).forEach(b => {\n            b.classList.remove('bg-indigo-600', 'text-white', 'shadow');\n            b.classList.add('bg-white', 'text-slate-700');\n          });\n\n          // Marcar el botón seleccionado\n          btn.classList.remove('bg-white', 'text-slate-700');\n          btn.classList.add('bg-indigo-600', 'text-white', 'shadow');\n\n          // Guardar selección\n          userSelections[item] = value;\n        });\n      });\n\n      // Botón Check Answers\n      checkBtn.addEventListener('click', () => {\n        let correctCount = 0;\n        const totalItems = Object.keys(answerKey).length;\n\n        for (let i = 1; i <= totalItems; i++) {\n          const selected = userSelections[i];\n          const correct = answerKey[i];\n          const feedbackEl = document.getElementById(`feedback-${i}`);\n          const itemButtons = document.querySelectorAll(`.collocation-btn[data-item=\"${i}\"]`);\n\n          itemButtons.forEach(b => {\n            b.disabled = true; // Bloquear cambios tras verificar\n            if (b.getAttribute('data-value') === correct) {\n              b.classList.add('ring-2', 'ring-emerald-500');\n            }\n          });\n\n          if (selected === correct) {\n            correctCount++;\n            if (feedbackEl) {\n              feedbackEl.textContent = '✓ Correct';\n              feedbackEl.className = 'text-sm font-semibold text-emerald-600 block';\n            }\n          } else {\n            if (feedbackEl) {\n              feedbackEl.textContent = `✗ Correct: ${correct}`;\n              feedbackEl.className = 'text-sm font-semibold text-rose-600 block';\n            }\n          }\n        }\n\n        // Actualizar marcador visual\n        scoreDisplay.textContent = `${correctCount} / ${totalItems}`;\n\n        // Despachar eventos requeridos para integración LMS y analítica\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: totalItems,\n            completed: correctCount === totalItems\n          }\n        }));\n\n        if (window.parent && window.parent !== window) {\n          window.parent.postMessage({\n            type: 'ACTIVITY_SCORE',\n            score: correctCount,\n            total: totalItems\n          }, '*');\n        }\n      });\n\n      // Botón Reset\n      resetBtn.addEventListener('click', () => {\n        Object.keys(userSelections).forEach(key => delete userSelections[key]);\n\n        buttons.forEach(b => {\n          b.disabled = false;\n          b.classList.remove('bg-indigo-600', 'text-white', 'shadow', 'ring-2', 'ring-emerald-500', 'ring-rose-500');\n          b.classList.add('bg-white', 'text-slate-700');\n        });\n\n        for (let i = 1; i <= 10; i++) {\n          const feedbackEl = document.getElementById(`feedback-${i}`);\n          if (feedbackEl) {\n            feedbackEl.textContent = '';\n            feedbackEl.className = 'text-sm font-semibold hidden sm:block';\n          }\n        }\n\n        scoreDisplay.textContent = `0 / ${Object.keys(answerKey).length}`;\n      });\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793473194258,
      "title": "Listening & Grammar - In Praise of Slow",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Listening & Grammar - In Praise of Slow</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .custom-shadow { box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.08); }\n        .transition-all-custom { transition: all 0.3s ease; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY TOP AUDIO BAR -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"w-full max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-indigo-100 p-2 rounded-xl text-indigo-700\">\n                    <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\"/></svg>\n                </div>\n                <div>\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600\">Audio Track R2.1</span>\n                    <h2 class=\"text-sm font-semibold text-slate-800\">Radio Programme: Kim and Rob discussing \"In Praise of Slow\"</h2>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 w-full sm:w-auto justify-end\">\n                <audio id=\"audioPlayer\" preload=\"metadata\" class=\"hidden\" src=\"data:audio/mpeg;base64,\"></audio>\n                <button id=\"playAudioBtn\" onclick=\"toggleAudio()\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white px-5 py-2 rounded-xl text-sm font-medium flex items-center justify-center gap-2 transition-all-custom cursor-pointer shadow-sm\">\n                    <svg id=\"playIcon\" class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n                    <span id=\"playBtnText\">Play Audio (R2.1)</span>\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 flex-grow\">\n        <div class=\"bg-white border border-slate-200 rounded-2xl custom-shadow p-6 sm:p-8 space-y-8\">\n\n            <!-- SECTION HEADER -->\n            <div class=\"border-b border-slate-100 pb-5\">\n                <div class=\"flex items-center gap-2 text-indigo-600 font-semibold text-sm mb-1\">\n                    <span class=\"bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider\">Listening & Grammar</span>\n                    <span>•</span>\n                    <span>Unit 2</span>\n                </div>\n                <h1 class=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">In Praise of Slow</h1>\n            </div>\n\n            <!-- EXERCISE 2A -->\n            <section class=\"space-y-4\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-900 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">2a</span>\n                    <div class=\"space-y-1\">\n                        <h3 class=\"font-semibold text-slate-900 text-base\">Look at the photo and the cartoon. What is the book about and what is happening in the cartoon, do you think?</h3>\n                        <p class=\"text-sm text-slate-500\">Write your initial predictions below before listening to the audio.</p>\n                    </div>\n                </div>\n\n                <!-- STUDENT IMAGE 1 -->\n                <div class=\"my-4 p-2 bg-slate-50 rounded-2xl border border-slate-100\">\n                    <div class=\"flex justify-center items-center overflow-visible\">\n                        <img src=\"data:image/png;base64,\" alt=\"In Praise of Slow book cover and cartoons\" class=\"max-h-64 md:max-h-72 w-auto mx-auto object-contain rounded-xl shadow-sm block\">\n                    </div>\n                </div>\n\n                <!-- PREDICTION INPUTS -->\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-2\">\n                    <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2\">\n                        <label for=\"predBook\" class=\"block text-xs font-bold uppercase text-slate-600 tracking-wider\">1. What is the book about?</label>\n                        <textarea id=\"predBook\" rows=\"3\" class=\"w-full p-3 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none bg-white\" placeholder=\"Type your ideas here...\" data-answer=\"fast living slow down\"></textarea>\n                    </div>\n                    <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2\">\n                        <label for=\"predCartoon\" class=\"block text-xs font-bold uppercase text-slate-600 tracking-wider\">2. What is happening in the cartoon?</label>\n                        <textarea id=\"predCartoon\" rows=\"3\" class=\"w-full p-3 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none bg-white\" placeholder=\"Type your ideas here...\" data-answer=\"walk tortoise puppet slow\"></textarea>\n                    </div>\n                </div>\n            </section>\n\n            <hr class=\"border-slate-100\">\n\n            <!-- EXERCISE 2B & LOCKED REFERENCE TEXT -->\n            <section class=\"space-y-6\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"bg-slate-900 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">2b</span>\n                    <div class=\"space-y-1\">\n                        <h3 class=\"font-semibold text-slate-900 text-base\">Listen to the beginning of a radio programme. Two journalists, Kim and Rob, are discussing <span class=\"italic\">In Praise of Slow</span> by Carl Honoré. Check your answers to 2a.</h3>\n                    </div>\n                </div>\n\n                <!-- LOCKED CONTENT CONTAINER -->\n                <div id=\"lockedContainer\" class=\"relative bg-amber-50/60 border border-amber-200/80 rounded-2xl p-6 transition-all-custom\">\n                    <div id=\"lockOverlay\" class=\"absolute inset-0 bg-white/80 backdrop-blur-xs rounded-2xl flex flex-col items-center justify-center p-6 text-center z-10 transition-all-custom\">\n                        <div class=\"bg-amber-100 text-amber-800 p-3 rounded-full mb-3 shadow-sm\">\n                            <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/></svg>\n                        </div>\n                        <h4 class=\"font-bold text-slate-900 text-lg mb-1\">Audio Listening Required</h4>\n                        <p class=\"text-sm text-slate-600 max-w-md mb-4\">Please listen to the audio track <span class=\"font-semibold text-amber-700\">R2.1</span> completely at least once to unlock the official textbook reference text and check your predictions.</p>\n                        <button onclick=\"unlockContent()\" id=\"forceUnlockBtn\" class=\"bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-sm cursor-pointer\">\n                            I have listened to the audio\n                        </button>\n                    </div>\n\n                    <!-- UNLOCKED TEXT CONTENT -->\n                    <div class=\"space-y-3 opacity-40 filter blur-[1px] transition-all-custom\" id=\"textContent\">\n                        <div class=\"flex items-center justify-between\">\n                            <span class=\"inline-flex items-center gap-1.5 text-xs font-bold text-amber-800 uppercase tracking-wider bg-amber-100 px-3 py-1 rounded-full\">\n                                <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n                                Textbook Reference Answer (Unlocked)\n                            </span>\n                        </div>\n                        <p class=\"text-slate-700 text-base leading-relaxed bg-white p-5 rounded-xl border border-amber-200/50 shadow-xs font-serif\">\n                            \"In Praise of Slow tells us that we are living too fast and should all slow down. The cartoon on SB p12 shows one of the members of the group in Austria called The Society for the Deceleration of Time, which tries to stop people hurrying. If members of the society think a person is walking too fast without a good reason, that person has to walk behind a puppet tortoise for 50 metres.\"\n                        </p>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ACTION CONTROLS & SCORE -->\n            <div class=\"pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4\">\n                <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                    <button onclick=\"checkAnswers()\" class=\"w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-medium px-6 py-3 rounded-xl text-sm flex items-center justify-center gap-2 transition-all-custom shadow-sm cursor-pointer\">\n                        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/></svg>\n                        Check Answers\n                    </button>\n                    <button onclick=\"resetActivity()\" class=\"w-full sm:w-auto bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-700 font-medium px-5 py-3 rounded-xl text-sm flex items-center justify-center gap-2 transition-all-custom cursor-pointer\">\n                        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\n                        Reset\n                    </button>\n                </div>\n                \n                <div id=\"scoreDisplay\" class=\"hidden items-center gap-3 bg-slate-100 px-4 py-2.5 rounded-xl font-semibold text-sm text-slate-700\">\n                    <span>Score:</span>\n                    <span id=\"scoreText\" class=\"text-indigo-600 font-bold\">0 / 2</span>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"w-full py-4 text-center text-xs text-slate-400 border-t border-slate-200 bg-white\">\n        Interactive ELT Lesson • Responsive Touch Design\n    </footer>\n\n    <!-- JAVASCRIPT LOGIC -->\n    <script>\n        // METRICS DECLARATION MANDATORY CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Listening',\n            skill: 'listening_for_gist_and_prediction',\n            maxScore: 2\n        };\n\n        let hasListened = false;\n\n        const audioPlayer = document.getElementById('audioPlayer');\n        const playAudioBtn = document.getElementById('playAudioBtn');\n        const playIcon = document.getElementById('playIcon');\n        const playBtnText = document.getElementById('playBtnText');\n\n        function toggleAudio() {\n            if (audioPlayer.paused) {\n                audioPlayer.play().then(() => {\n                    hasListened = true;\n                    playIcon.innerHTML = '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z\"/>';\n                    playBtnText.textContent = 'Pause Audio';\n                    // Auto unlock after playing once\n                    unlockContent();\n                }).catch(e => {\n                    console.log(\"Audio playback simulated or blocked:\", e);\n                    // Fallback simulation if browser blocks\n                    hasListened = true;\n                    unlockContent();\n                });\n            } else {\n                audioPlayer.pause();\n                playIcon.innerHTML = '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/>';\n                playBtnText.textContent = 'Play Audio (R2.1)';\n                unlockContent();\n            }\n        }\n\n        audioPlayer.onended = function() {\n            hasListened = true;\n            playIcon.innerHTML = '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/>';\n            playBtnText.textContent = 'Play Audio Again';\n            unlockContent();\n        };\n\n        function unlockContent() {\n            hasListened = true;\n            const overlay = document.getElementById('lockOverlay');\n            const textContent = document.getElementById('textContent');\n            \n            overlay.classList.add('opacity-0', 'pointer-events-none');\n            setTimeout(() => {\n                overlay.style.display = 'none';\n            }, 300);\n            \n            textContent.classList.remove('opacity-40', 'filter', 'blur-[1px]');\n        }\n\n        function checkAnswers() {\n            if (!hasListened) {\n                alert(\"Please listen to the audio track R2.1 first before checking your answers!\");\n                return;\n            }\n\n            const predBook = document.getElementById('predBook');\n            const predCartoon = document.getElementById('predCartoon');\n            let correctCount = 0;\n\n            // Evaluation logic for open text predictions based on keywords\n            const bookVal = predBook.value.toLowerCase();\n            const bookKeywords = ['fast', 'slow', 'book', 'life', 'hurry', 'speed'];\n            const hasBookKeyword = bookKeywords.some(kw => bookVal.includes(kw));\n\n            if (bookVal.trim().length > 5 && hasBookKeyword) {\n                predBook.classList.remove('border-slate-300', 'border-red-500', 'bg-red-50');\n                predBook.classList.add('border-emerald-500', 'bg-emerald-50/30');\n                correctCount++;\n            } else {\n                predBook.classList.remove('border-slate-300', 'border-emerald-500', 'bg-emerald-50/30');\n                predBook.classList.add('border-red-500', 'bg-red-50/30');\n            }\n\n            const cartoonVal = predCartoon.value.toLowerCase();\n            const cartoonKeywords = ['tortoise', 'turtle', 'puppet', 'walk', 'slow', 'man', 'person', 'street'];\n            const hasCartoonKeyword = cartoonKeywords.some(kw => cartoonVal.includes(kw));\n\n            if (cartoonVal.trim().length > 5 && hasCartoonKeyword) {\n                predCartoon.classList.remove('border-slate-300', 'border-red-500', 'bg-red-50');\n                predCartoon.classList.add('border-emerald-500', 'bg-emerald-50/30');\n                correctCount++;\n            } else {\n                predCartoon.classList.remove('border-slate-300', 'border-emerald-500', 'bg-emerald-50/30');\n                predCartoon.classList.add('border-red-500', 'bg-red-50/30');\n            }\n\n            // Score display update\n            const scoreDisplay = document.getElementById('scoreDisplay');\n            const scoreText = document.getElementById('scoreText');\n            scoreDisplay.classList.remove('hidden');\n            scoreDisplay.classList.add('flex');\n            scoreText.textContent = `${correctCount} / 2`;\n\n            // Dispatch mandatory custom events\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: 2,\n                    completed: correctCount === 2\n                }\n            }));\n\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: 2 }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const predBook = document.getElementById('predBook');\n            const predCartoon = document.getElementById('predCartoon');\n            \n            predBook.value = '';\n            predCartoon.value = '';\n            \n            [predBook, predCartoon].forEach(el => {\n                el.classList.remove('border-emerald-500', 'bg-emerald-50/30', 'border-red-500', 'bg-red-50/30');\n                el.classList.add('border-slate-300', 'bg-white');\n            });\n\n            document.getElementById('scoreDisplay').classList.add('hidden');\n            document.getElementById('scoreDisplay').classList.remove('flex');\n\n            audioPlayer.pause();\n            audioPlayer.currentTime = 0;\n            hasListened = false;\n            playIcon.innerHTML = '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/>';\n            playBtnText.textContent = 'Play Audio (R2.1)';\n\n            // Re-lock\n            const overlay = document.getElementById('lockOverlay');\n            const textContent = document.getElementById('textContent');\n            overlay.style.display = 'flex';\n            setTimeout(() => {\n                overlay.classList.remove('opacity-0', 'pointer-events-none');\n            }, 10);\n            textContent.classList.add('opacity-40', 'filter', 'blur-[1px]');\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793473801595,
      "title": "Working Hours & Culture - Listening & Vocabulary",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Working Hours & Culture - Listening & Vocabulary</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY AUDIO HEADER (LOCKED INITIALLY) -->\n    <div id=\"audioContainer\" class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm transition-all duration-300\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2\">\n            <div id=\"audioMsg\" class=\"flex items-center gap-2 text-sm font-medium text-amber-700 bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-200 w-full sm:w-auto justify-center\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2px 2px 0 002-2v-6a2px 2px 0 00-2-2H6a2px 2px 0 00-2 2v6a2px 2px 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/>\n                </svg>\n                <span>Complete exercise 3a first to unlock audio check!</span>\n            </div>\n            <!-- Audio Player Locked by default -->\n            <div id=\"audioPlayerWrapper\" class=\"w-full sm:w-auto opacity-40 pointer-events-none select-none transition-opacity duration-300\">\n                <audio id=\"lessonAudio\" controls class=\"w-full sm:w-72 md:w-96 h-10\" src=\"data:audio/mpeg;base64,\"></audio>\n            </div>\n        </div>\n    </div>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- HEADER INSTRUCTION CARD -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-sm mb-6\">\n            <div class=\"flex items-start gap-4\">\n                <div class=\"bg-slate-900 text-white font-bold rounded-xl w-10 h-10 flex items-center justify-center shrink-0 text-lg shadow-sm\">\n                    3\n                </div>\n                <div>\n                    <div class=\"inline-block bg-indigo-50 text-indigo-700 font-semibold text-xs px-2.5 py-1 rounded-md mb-2 border border-indigo-100\">\n                        Vocabulary & Listening Activity\n                    </div>\n                    <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900 mb-2\">Work Culture Around the World</h1>\n                    <p class=\"text-slate-600 text-sm sm:text-base leading-relaxed\">\n                        <strong class=\"text-slate-700\">a)</strong> Try to fill in the gaps in sentences 1–6 with these countries. Use one country twice.\n                    </p>\n                </div>\n            </div>\n\n            <!-- COUNTRY BANK -->\n            <div class=\"mt-6 pt-5 border-t border-slate-100\">\n                <div class=\"text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 text-center sm:text-left\">Available Countries (Word Bank):</div>\n                <div class=\"flex flex-wrap gap-2 justify-center sm:justify-start\">\n                    <span class=\"bg-slate-100 text-slate-700 border border-slate-200 px-3 py-1.5 rounded-xl text-sm font-semibold shadow-2xs\">the USA</span>\n                    <span class=\"bg-slate-100 text-slate-700 border border-slate-200 px-3 py-1.5 rounded-xl text-sm font-semibold shadow-2xs\">France</span>\n                    <span class=\"bg-slate-100 text-slate-700 border border-slate-200 px-3 py-1.5 rounded-xl text-sm font-semibold shadow-2xs\">Japan</span>\n                    <span class=\"bg-slate-100 text-slate-700 border border-slate-200 px-3 py-1.5 rounded-xl text-sm font-semibold shadow-2xs\">Germany</span>\n                    <span class=\"bg-slate-100 text-slate-700 border border-slate-200 px-3 py-1.5 rounded-xl text-sm font-semibold shadow-2xs\">the UK</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- SENTENCES FORM -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-sm mb-6\">\n            <form id=\"activityForm\" class=\"space-y-4\" onsubmit=\"return false;\">\n                \n                <!-- Item 1 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n                    <div class=\"flex items-start gap-3 text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 bg-slate-100 w-7 h-7 rounded-lg flex items-center justify-center shrink-0\">1</span>\n                        <span class=\"pt-1\">Some companies in <span class=\"inline-block mx-1\">\n                            <select data-answer=\"France\" class=\"gap-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-hidden cursor-pointer shadow-2xs\">\n                                <option value=\"\">--- choose country ---</option>\n                                <option value=\"the USA\">the USA</option>\n                                <option value=\"France\">France</option>\n                                <option value=\"Japan\">Japan</option>\n                                <option value=\"Germany\">Germany</option>\n                                <option value=\"the UK\">the UK</option>\n                            </select>\n                        </span> give their employees three days off at the weekend.</span>\n                    </div>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n                    <div class=\"flex items-start gap-3 text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 bg-slate-100 w-7 h-7 rounded-lg flex items-center justify-center shrink-0\">2</span>\n                        <span class=\"pt-1\">People in <span class=\"inline-block mx-1\">\n                            <select data-answer=\"Germany\" class=\"gap-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-hidden cursor-pointer shadow-2xs\">\n                                <option value=\"\">--- choose country ---</option>\n                                <option value=\"the USA\">the USA</option>\n                                <option value=\"France\">France</option>\n                                <option value=\"Japan\">Japan</option>\n                                <option value=\"Germany\">Germany</option>\n                                <option value=\"the UK\">the UK</option>\n                            </select>\n                        </span> spend 15% less time at work now than they did in 1980.</span>\n                    </div>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n                    <div class=\"flex items-start gap-3 text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 bg-slate-100 w-7 h-7 rounded-lg flex items-center justify-center shrink-0\">3</span>\n                        <span class=\"pt-1\">In <span class=\"inline-block mx-1\">\n                            <select data-answer=\"the UK\" class=\"gap-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-hidden cursor-pointer shadow-2xs\">\n                                <option value=\"\">--- choose country ---</option>\n                                <option value=\"the USA\">the USA</option>\n                                <option value=\"France\">France</option>\n                                <option value=\"Japan\">Japan</option>\n                                <option value=\"Germany\">Germany</option>\n                                <option value=\"the UK\">the UK</option>\n                            </select>\n                        </span> 20% of people work more than 60 hours a week.</span>\n                    </div>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n                    <div class=\"flex items-start gap-3 text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 bg-slate-100 w-7 h-7 rounded-lg flex items-center justify-center shrink-0\">4</span>\n                        <span class=\"pt-1\">60% of people in <span class=\"inline-block mx-1\">\n                            <select data-answer=\"the UK\" class=\"gap-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-hidden cursor-pointer shadow-2xs\">\n                                <option value=\"\">--- choose country ---</option>\n                                <option value=\"the USA\">the USA</option>\n                                <option value=\"France\">France</option>\n                                <option value=\"Japan\">Japan</option>\n                                <option value=\"Germany\">Germany</option>\n                                <option value=\"the UK\">the UK</option>\n                            </select>\n                        </span> said they didn't take all their paid holiday.</span>\n                    </div>\n                </div>\n\n                <!-- Item 5 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n                    <div class=\"flex items-start gap-3 text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 bg-slate-100 w-7 h-7 rounded-lg flex items-center justify-center shrink-0\">5</span>\n                        <span class=\"pt-1\">In <span class=\"inline-block mx-1\">\n                            <select data-answer=\"the USA\" class=\"gap-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-hidden cursor-pointer shadow-2xs\">\n                                <option value=\"\">--- choose country ---</option>\n                                <option value=\"the USA\">the USA</option>\n                                <option value=\"France\">France</option>\n                                <option value=\"Japan\">Japan</option>\n                                <option value=\"Germany\">Germany</option>\n                                <option value=\"the UK\">the UK</option>\n                            </select>\n                        </span> 20% of people don't take time off when they're ill.</span>\n                    </div>\n                </div>\n\n                <!-- Item 6 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n                    <div class=\"flex items-start gap-3 text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 bg-slate-100 w-7 h-7 rounded-lg flex items-center justify-center shrink-0\">6</span>\n                        <span class=\"pt-1\">In <span class=\"inline-block mx-1\">\n                            <select data-answer=\"Japan\" class=\"gap-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-hidden cursor-pointer shadow-2xs\">\n                                <option value=\"\">--- choose country ---</option>\n                                <option value=\"the USA\">the USA</option>\n                                <option value=\"France\">France</option>\n                                <option value=\"Japan\">Japan</option>\n                                <option value=\"Germany\">Germany</option>\n                                <option value=\"the UK\">the UK</option>\n                            </select>\n                        </span> they have a word that means 'death from working too hard'.</span>\n                    </div>\n                </div>\n\n                <!-- ACTION BUTTONS -->\n                <div class=\"flex flex-wrap items-center justify-between gap-4 pt-6 mt-6 border-t border-slate-100\">\n                    <div id=\"scoreDisplay\" class=\"text-sm font-bold text-slate-700 bg-slate-100 px-4 py-2.5 rounded-xl\">\n                        Score: 0 / 6\n                    </div>\n                    <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                        <button type=\"button\" onclick=\"resetActivity()\" class=\"flex-1 sm:flex-none px-5 py-2.5 rounded-xl border border-slate-300 font-semibold text-slate-700 hover:bg-slate-100 transition-all text-sm cursor-pointer\">\n                            🔄 Reset\n                        </button>\n                        <button type=\"button\" onclick=\"checkAnswers()\" class=\"flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-slate-900 text-white font-semibold hover:bg-slate-800 transition-all shadow-sm text-sm cursor-pointer\">\n                            ✓ Check Answers\n                        </button>\n                    </div>\n                </div>\n\n            </form>\n        </section>\n\n        <!-- PART B LISTENING PROMPT ACCORDION -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-sm\">\n            <details class=\"group\">\n                <summary class=\"flex items-center justify-between cursor-pointer list-none font-bold text-slate-800 text-base sm:text-lg\">\n                    <div class=\"flex items-center gap-3\">\n                        <div class=\"bg-emerald-100 text-emerald-800 font-bold rounded-xl w-10 h-10 flex items-center justify-center shrink-0 text-sm\">\n                            3b\n                        </div>\n                        <span>Listen to the radio programme & check</span>\n                    </div>\n                    <span class=\"transition group-open:rotate-180 bg-slate-100 p-2 rounded-xl\">\n                        <svg fill=\"none\" height=\"20\" shape-rendering=\"geometricPrecision\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\" width=\"20\"><path d=\"M6 9l6 6 6-6\"></path></svg>\n                    </span>\n                </summary>\n                <div class=\"mt-4 pt-4 border-t border-slate-100 text-slate-600 text-sm leading-relaxed space-y-3\">\n                    <p class=\"font-medium text-slate-700\">Audio Script Transcription Reference:</p>\n                    <p><em>\"Welcome back to World Work Culture. Today we are looking at how different nationalities manage their time... In France, some companies give their employees three days off at the weekend... In Germany, people spend 15% less time at work now than they did in 1980... In the UK, 20% of people work more than 60 hours a week, and 60% said they didn't take all their paid holiday... In the USA, 20% of people don't take time off when they're ill... And finally, in Japan, they even have a specific word—karoshi—that means 'death from working too hard'.\"</em></p>\n                </div>\n            </details>\n        </section>\n\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-100 bg-white\">\n        ELT Interactive Micro-App • Designed for Touch & Responsive Viewports\n    </footer>\n\n    <!-- SCRIPT LOGIC & METRICS -->\n    <script>\n        // CONTRACT OBLIGATORY METRICS\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'work_culture_countries',\n            maxScore: 6\n        };\n\n        function checkAnswers() {\n            const selects = document.querySelectorAll('.gap-select');\n            let correctCount = 0;\n\n            selects.forEach(select => {\n                const userAnswer = select.value.trim();\n                const correctAnswer = select.getAttribute('data-answer');\n\n                select.classList.remove('is-correct', 'is-wrong');\n\n                if (userAnswer === correctAnswer) {\n                    select.classList.add('is-correct');\n                    correctCount++;\n                } else if (userAnswer !== \"\") {\n                    select.classList.add('is-wrong');\n                }\n            });\n\n            // Update score badge\n            const scoreDisplay = document.getElementById('scoreDisplay');\n            scoreDisplay.textContent = `Score: ${correctCount} / 6`;\n\n            // If all correct or completed, unlock audio!\n            if (correctCount === 6) {\n                const audioPlayerWrapper = document.getElementById('audioPlayerWrapper');\n                const audioMsg = document.getElementById('audioMsg');\n                \n                audioPlayerWrapper.classList.remove('opacity-40', 'pointer-events-none', 'select-none');\n                audioMsg.className = \"flex items-center gap-2 text-sm font-medium text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-lg border border-emerald-200 w-full sm:w-auto justify-center\";\n                audioMsg.innerHTML = `\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/>\n                    </svg>\n                    <span>🎧 Great job! Now listen and check your answers.</span>\n                `;\n            }\n\n            // Dispatch global events for parent / LMS integration\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: selects.length,\n                    completed: correctCount === selects.length\n                }\n            }));\n\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: selects.length }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const selects = document.querySelectorAll('.gap-select');\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('is-correct', 'is-wrong');\n            });\n\n            document.getElementById('scoreDisplay').textContent = 'Score: 0 / 6';\n\n            // Relock audio\n            const audioPlayerWrapper = document.getElementById('audioPlayerWrapper');\n            const audioMsg = document.getElementById('audioMsg');\n            \n            audioPlayerWrapper.classList.add('opacity-40', 'pointer-events-none', 'select-none');\n            audioMsg.className = \"flex items-center gap-2 text-sm font-medium text-amber-700 bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-200 w-full sm:w-auto justify-center\";\n            audioMsg.innerHTML = `\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2px 2px 0 002-2v-6a2px 2px 0 00-2-2H6a2px 2px 0 00-2 2v6a2px 2px 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/>\n                </svg>\n                <span>Complete exercise 3a first to unlock audio check!</span>\n            `;\n\n            document.getElementById('lessonAudio').pause();\n            document.getElementById('lessonAudio').currentTime = 0;\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793473929831,
      "title": "Listening & Fill-in-the-Gaps Activity R2.2",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Listening & Fill-in-the-Gaps Activity R2.2</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- STICKY TOP AUDIO PLAYER (Locked initially per rules) -->\n  <div class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"w-full max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2\">\n      <div id=\"audioStatus\" class=\"flex items-center gap-2 text-xs sm:text-sm font-medium text-amber-700 bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-200 w-full sm:w-auto\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/></svg>\n        <span>Audio locked. Click \"Check Answers\" to unlock and listen.</span>\n      </div>\n      <!-- Locked Audio Element -->\n      <div id=\"audioContainer\" class=\"opacity-40 pointer-events-none select-none transition-all duration-300 w-full sm:w-auto\">\n        <audio id=\"lessonAudio\" controls class=\"w-full sm:w-80 h-10\" src=\"data:audio/mpeg;base64,\"></audio>\n      </div>\n    </div>\n  </div>\n\n  <!-- MAIN CONTAINER -->\n  <main class=\"w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-6 my-auto flex-grow\">\n    \n    <!-- ACTIVITY HEADER CARD -->\n    <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-6 mb-6\">\n      <div class=\"flex items-center gap-3 mb-2\">\n        <span class=\"bg-slate-900 text-white text-xs font-bold px-2.5 py-1 rounded-md\">4 a) R2.2</span>\n        <h1 class=\"text-lg sm:text-xl font-bold text-slate-900\">Radio Programme Comprehension</h1>\n      </div>\n      <p class=\"text-sm text-slate-600\">\n        Listen to the second part of the radio programme again. Fill in the gaps with <span class=\"font-semibold text-slate-700\">one or two words</span>.\n      </p>\n    </div>\n\n    <!-- QUESTIONS FORM -->\n    <form id=\"activityForm\" class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-6 space-y-5\" onsubmit=\"event.preventDefault();\">\n      \n      <!-- Item 1 (Example completed in book) -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-slate-50 border border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-500 w-5 shrink-0\">1</span>\n          <span class=\"text-slate-700\">Rob says he <strong class=\"text-slate-900\">must</strong> take more time off</span>\n        </div>\n        <div class=\"self-start sm:self-auto pl-8 sm:pl-0\">\n          <span class=\"inline-block bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-semibold select-none\">work</span>\n        </div>\n      </div>\n\n      <!-- Item 2 -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-900 w-5 shrink-0\">2</span>\n          <span class=\"text-slate-700\">Honoré thinks people <strong class=\"text-slate-900\">should</strong> only work</span>\n        </div>\n        <div class=\"flex items-center gap-2 pl-8 sm:pl-0\">\n          <input type=\"text\" data-answer=\"thirty-five\" placeholder=\"type answer...\" \n                 class=\"gap-input w-full sm:w-44 px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-900 w-5 shrink-0\">3</span>\n          <span class=\"text-slate-700\">Some French employees <strong class=\"text-slate-900\">are allowed to</strong> begin their weekend at</span>\n        </div>\n        <div class=\"flex items-center gap-2 pl-8 sm:pl-0\">\n          <input type=\"text\" data-answer=\"3 p.m.\" data-alts=\"3pm, 3 p. m., three p.m.\" placeholder=\"type answer...\" \n                 class=\"gap-input w-full sm:w-44 px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 4 -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-900 w-5 shrink-0\">4</span>\n          <span class=\"text-slate-700\">Honoré says we <strong class=\"text-slate-900\">ought to</strong> spend more time relaxing with</span>\n        </div>\n        <div class=\"flex items-center gap-2 pl-8 sm:pl-0\">\n          <input type=\"text\" data-answer=\"our families\" placeholder=\"type answer...\" \n                 class=\"gap-input w-full sm:w-44 px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 5 -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-900 w-5 shrink-0\">5</span>\n          <span class=\"text-slate-700\">People <strong class=\"text-slate-900\">can</strong> get their best</span>\n        </div>\n        <div class=\"flex items-center gap-2 pl-8 sm:pl-0\">\n          <input type=\"text\" data-answer=\"ideas\" placeholder=\"type answer...\" \n                 class=\"gap-input w-full sm:w-44 px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all\">\n          <span class=\"text-sm text-slate-600 hidden sm:inline\">when they're doing nothing.</span>\n        </div>\n      </div>\n\n      <!-- Item 6 -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-900 w-5 shrink-0\">6</span>\n          <span class=\"text-slate-700\">In some American companies, employees <strong class=\"text-slate-900\">can</strong></span>\n        </div>\n        <div class=\"flex items-center gap-2 pl-8 sm:pl-0\">\n          <input type=\"text\" data-answer=\"sleep\" placeholder=\"type answer...\" \n                 class=\"gap-input w-full sm:w-44 px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all\">\n          <span class=\"text-sm text-slate-600 hidden sm:inline\">whenever they want.</span>\n        </div>\n      </div>\n\n      <!-- Item 7 -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-900 w-5 shrink-0\">7</span>\n          <span class=\"text-slate-700\">In the UK people <strong class=\"text-slate-900\">are supposed to</strong> have a break every</span>\n        </div>\n        <div class=\"flex items-center gap-2 pl-8 sm:pl-0\">\n          <input type=\"text\" data-answer=\"four\" data-alts=\"4\" placeholder=\"type answer...\" \n                 class=\"gap-input w-full sm:w-44 px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all\">\n          <span class=\"text-sm text-slate-600 hidden sm:inline\">hours.</span>\n        </div>\n      </div>\n\n      <!-- Item 8 -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-900 w-5 shrink-0\">8</span>\n          <span class=\"text-slate-700\">Kim says that lots of people <strong class=\"text-slate-900\">have to take</strong></span>\n        </div>\n        <div class=\"flex items-center gap-2 pl-8 sm:pl-0\">\n          <input type=\"text\" data-answer=\"work home\" placeholder=\"type answer...\" \n                 class=\"gap-input w-full sm:w-44 px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all\">\n        </div>\n      </div>\n\n      <!-- Item 9 -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition-colors border border-transparent hover:border-slate-100\">\n        <div class=\"flex items-start sm:items-center gap-3 text-sm sm:text-base\">\n          <span class=\"font-bold text-slate-900 w-5 shrink-0\">9</span>\n          <span class=\"text-slate-700\">Rob says that we're <strong class=\"text-slate-900\">able to</strong> continue working when we're</span>\n        </div>\n        <div class=\"flex items-center gap-2 pl-8 sm:pl-0\">\n          <input type=\"text\" data-answer=\"travelling\" data-alts=\"traveling\" placeholder=\"type answer...\" \n                 class=\"gap-input w-full sm:w-44 px-3 py-2 text-sm sm:text-base border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all\">\n        </div>\n      </div>\n\n      <!-- CONTROLS & SCORE -->\n      <div class=\"pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4\">\n        <div id=\"scoreDisplay\" class=\"text-sm font-semibold text-slate-700 bg-slate-100 px-4 py-2.5 rounded-xl w-full sm:w-auto text-center\">\n          Score: <span id=\"correctCount\">0</span> / <span id=\"totalCount\">8</span>\n        </div>\n        <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n          <button type=\"button\" onclick=\"resetActivity()\" class=\"flex-1 sm:flex-none px-5 py-2.5 text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all cursor-pointer\">\n            🔄 Reset\n          </button>\n          <button type=\"button\" onclick=\"checkAnswers()\" class=\"flex-1 sm:flex-none px-6 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition-all cursor-pointer\">\n            ✓ Check Answers\n          </button>\n        </div>\n      </div>\n\n    </form>\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 mt-8\">\n    Interactive Listening Comprehension • ELT Framework\n  </footer>\n\n  <!-- SCRIPT LOGIC -->\n  <script>\n    // Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Listening',\n      skill: 'radio_programme_fill_gaps',\n      maxScore: 8\n    };\n\n    function normalizeText(text) {\n      return text.toLowerCase().trim().replace(/[\\s\\-_]+/g, ' ').replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\");\n    }\n\n    function checkAnswers() {\n      const inputs = document.querySelectorAll('.gap-input');\n      let correctCount = 0;\n\n      inputs.forEach(input => {\n        const userVal = normalizeText(input.value);\n        const primaryAnswer = normalizeText(input.getAttribute('data-answer') || '');\n        const altAnswersAttr = input.getAttribute('data-alts');\n        \n        let isCorrect = (userVal === primaryAnswer);\n        \n        if (!isCorrect && altAnswersAttr) {\n          const alts = altAnswersAttr.split(',').map(a => normalizeText(a));\n          if (alts.includes(userVal)) {\n            isCorrect = true;\n          }\n        }\n\n        // Apply styles\n        input.classList.remove('border-slate-300', 'border-emerald-500', 'border-red-500', 'bg-emerald-50', 'bg-red-50', 'text-emerald-900', 'text-red-900');\n        \n        if (userVal === '') {\n          input.classList.add('border-slate-300');\n        } else if (isCorrect) {\n          input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-medium');\n          correctCount++;\n        } else {\n          input.classList.add('border-red-500', 'bg-red-50', 'text-red-900', 'font-medium');\n        }\n      });\n\n      // Update Score Display\n      document.getElementById('correctCount').textContent = correctCount;\n      const total = inputs.length;\n\n      // Unlock Audio Player per rules on check\n      const audioContainer = document.getElementById('audioContainer');\n      const audioStatus = document.getElementById('audioStatus');\n      audioContainer.classList.remove('opacity-40', 'pointer-events-none', 'select-none');\n      audioStatus.className = \"flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-lg border border-emerald-200 w-full sm:w-auto\";\n      audioStatus.innerHTML = `\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 11.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\"/></svg>\n        <span>🎧 Now listen and check your answers.</span>\n      `;\n\n      // Dispatch tracking events\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: total,\n          completed: correctCount === total\n        }\n      }));\n\n      if (window.parent && window.parent !== window) {\n        window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: total }, '*');\n      }\n    }\n\n    function resetActivity() {\n      const inputs = document.querySelectorAll('.gap-input');\n      inputs.forEach(input => {\n        input.value = '';\n        input.classList.remove('border-emerald-500', 'border-red-500', 'bg-emerald-50', 'bg-red-50', 'text-emerald-900', 'text-red-900', 'font-medium');\n        input.classList.add('border-slate-300');\n      });\n\n      document.getElementById('correctCount').textContent = '0';\n\n      // Re-lock audio\n      const audioContainer = document.getElementById('audioContainer');\n      const audioStatus = document.getElementById('audioStatus');\n      audioContainer.classList.add('opacity-40', 'pointer-events-none', 'select-none');\n      audioStatus.className = \"flex items-center gap-2 text-xs sm:text-sm font-medium text-amber-700 bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-200 w-full sm:w-auto\";\n      audioStatus.innerHTML = `\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/></svg>\n        <span>Audio locked. Click \"Check Answers\" to unlock and listen.</span>\n      `;\n    }\n\n    // Set dynamic total count on load\n    document.addEventListener('DOMContentLoaded', () => {\n      document.getElementById('totalCount').textContent = document.querySelectorAll('.gap-input').length;\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793474238656,
      "title": "Modal Verbs Interactive Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Modal Verbs Interactive Practice</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY HEADER & SCOREBOARD -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 shadow-sm w-full\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"/>\n                    </svg>\n                </span>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Grammar: Modal Verbs (1)</h1>\n                    <p class=\"text-xs text-slate-500\">be able to, be allowed to, be supposed to</p>\n                </div>\n            </div>\n\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-indigo-50 border border-indigo-100 px-3 py-1.5 rounded-xl flex items-center gap-2\">\n                    <span class=\"text-xs font-semibold text-indigo-700 uppercase tracking-wide\">Score:</span>\n                    <span id=\"score-display\" class=\"text-base font-bold text-indigo-900\">0 / 14</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 space-y-8 my-6 flex-grow\">\n\n        <!-- SECTION 1: REFERENCE EXERCISE 4a -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8 space-y-4\">\n            <div class=\"flex items-start justify-between border-b pb-4\">\n                <div>\n                    <span class=\"bg-amber-100 text-amber-800 text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wider\">Reference</span>\n                    <h2 class=\"text-xl font-bold text-slate-900 mt-2\">Exercise 4a: Complete Sentences</h2>\n                    <p class=\"text-sm text-slate-600 mt-1\">Review these complete sentences from the listening track. You will need them for the grammar tasks below.</p>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-slate-700\">\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2\">\n                    <span class=\"font-bold text-indigo-600\">1.</span>\n                    <p>Rob says he <strong class=\"text-slate-900\">must</strong> take more time off <strong class=\"text-indigo-700\">work</strong>.</p>\n                </div>\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2\">\n                    <span class=\"font-bold text-indigo-600\">2.</span>\n                    <p>Honoré thinks people <strong class=\"text-slate-900\">should</strong> only work <strong class=\"text-indigo-700\">thirty-five</strong> hours a week.</p>\n                </div>\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2\">\n                    <span class=\"font-bold text-indigo-600\">3.</span>\n                    <p>Some French employees <strong class=\"text-slate-900\">are allowed to</strong> begin their weekend at <strong class=\"text-indigo-700\">3 p.m.</strong> on Thursday.</p>\n                </div>\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2\">\n                    <span class=\"font-bold text-indigo-600\">4.</span>\n                    <p>Honoré says we <strong class=\"text-slate-900\">ought to</strong> spend more time relaxing with <strong class=\"text-indigo-700\">our families</strong>.</p>\n                </div>\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2\">\n                    <span class=\"font-bold text-indigo-600\">5.</span>\n                    <p>People <strong class=\"text-slate-900\">can</strong> get their best <strong class=\"text-indigo-700\">ideas</strong> when they're doing nothing.</p>\n                </div>\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2\">\n                    <span class=\"font-bold text-indigo-600\">6.</span>\n                    <p>In some American companies, employees can <strong class=\"text-indigo-700\">sleep</strong> whenever they want.</p>\n                </div>\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2\">\n                    <span class=\"font-bold text-indigo-600\">7.</span>\n                    <p>In the UK people <strong class=\"text-slate-900\">are supposed to</strong> have a break every <strong class=\"text-indigo-700\">four</strong> hours.</p>\n                </div>\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2\">\n                    <span class=\"font-bold text-indigo-600\">8.</span>\n                    <p>Kim says that lots of people <strong class=\"text-slate-900\">have to</strong> take <strong class=\"text-indigo-700\">work home</strong>.</p>\n                </div>\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2 md:col-span-2\">\n                    <span class=\"font-bold text-indigo-600\">9.</span>\n                    <p>Rob says that we're <strong class=\"text-slate-900\">able to</strong> continue working when we're <strong class=\"text-indigo-700\">travelling</strong>.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- SECTION 2: EXERCISE 5a (GRAMMAR RULES) -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8 space-y-6\">\n            <div class=\"border-b pb-4\">\n                <span class=\"bg-indigo-100 text-indigo-800 text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wider\">Exercise 5a</span>\n                <h2 class=\"text-xl font-bold text-slate-900 mt-2\">Help with Grammar: Modal Verbs</h2>\n                <p class=\"text-sm text-slate-600 mt-1\">Look at the sentences in 4a above and complete the rules with the correct verb forms.</p>\n            </div>\n\n            <div class=\"space-y-4 text-sm sm:text-base text-slate-700\">\n                <!-- Item 1 -->\n                <div class=\"flex flex-wrap items-center gap-2 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                    <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                    <span>We use</span>\n                    <input type=\"text\" data-answer=\"be supposed to\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-40 transition-colors\">\n                    <span>to say a person is expected to do something.</span>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"flex flex-wrap items-center gap-2 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                    <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                    <span>We use</span>\n                    <input type=\"text\" data-answer=\"can\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 transition-colors\">\n                    <span>and</span>\n                    <input type=\"text\" data-answer=\"be able to\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 transition-colors\">\n                    <span>to talk about ability or possibility.</span>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"flex flex-wrap items-center gap-2 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                    <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                    <span>We use</span>\n                    <input type=\"text\" data-answer=\"must\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 transition-colors\">\n                    <span>and</span>\n                    <input type=\"text\" data-answer=\"have to\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 transition-colors\">\n                    <span>to say something is necessary.</span>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"flex flex-wrap items-center gap-2 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                    <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                    <span>We use</span>\n                    <input type=\"text\" data-answer=\"should\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 transition-colors\">\n                    <span>and</span>\n                    <input type=\"text\" data-answer=\"ought to\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 transition-colors\">\n                    <span>to give advice.</span>\n                </div>\n\n                <!-- Item 5 -->\n                <div class=\"flex flex-wrap items-center gap-2 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                    <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                    <span>We use</span>\n                    <input type=\"text\" data-answer=\"be allowed to\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 transition-colors\">\n                    <span>and</span>\n                    <input type=\"text\" data-answer=\"can\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 transition-colors\">\n                    <span>to say we have permission to do something.</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- SECTION 3: EXERCISE 5c (NECESSITY & PERMISSION) -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8 space-y-6\">\n            <div class=\"border-b pb-4\">\n                <span class=\"bg-indigo-100 text-indigo-800 text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wider\">Exercise 5c</span>\n                <h2 class=\"text-xl font-bold text-slate-900 mt-2\">Necessity and Prohibition</h2>\n                <p class=\"text-sm text-slate-600 mt-1\">Complete the rules with <strong class=\"text-slate-900\">mustn't</strong> or <strong class=\"text-slate-900\">don't have to</strong>.</p>\n            </div>\n\n            <div class=\"space-y-4 text-sm sm:text-base text-slate-700\">\n                <div class=\"flex flex-wrap items-center gap-2 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                    <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                    <span>We use</span>\n                    <input type=\"text\" data-answer=\"don't have to\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 transition-colors\">\n                    <span>to say something isn't necessary.</span>\n                </div>\n\n                <div class=\"flex flex-wrap items-center gap-2 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                    <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                    <span>We use</span>\n                    <input type=\"text\" data-answer=\"mustn't\" placeholder=\"type answer\" class=\"border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 w-32 transition-colors\">\n                    <span>to say something is not allowed.</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- ACTION BUTTONS -->\n        <div class=\"flex flex-wrap items-center justify-center gap-4 pt-4\">\n            <button id=\"check-btn\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-8 py-3 rounded-xl shadow-md transition-all active:scale-95 min-h-[48px] flex items-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/>\n                </svg>\n                Check Answers\n            </button>\n            <button id=\"reset-btn\" class=\"bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-6 py-3 rounded-xl transition-all active:scale-95 min-h-[48px] flex items-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/>\n                </svg>\n                Reset Activity\n            </button>\n        </div>\n\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"w-full text-center py-6 text-xs text-slate-400 border-t border-slate-200 mt-auto bg-white\">\n        Interactive ELT Practice Module • Modal Verbs (1)\n    </footer>\n\n    <!-- INTERACTION SCRIPT -->\n    <script>\n        // METRICS DECLARATION CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'modal_verbs_rules',\n            maxScore: 12\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const scoreDisplay = document.getElementById('score-display');\n            const inputs = document.querySelectorAll('input[data-answer]');\n\n            function normalize(text) {\n                return text.trim().toLowerCase().replace(/\\s+/g, ' ');\n            }\n\n            checkBtn.addEventListener('click', () => {\n                let correctCount = 0;\n\n                inputs.forEach(input => {\n                    const userVal = normalize(input.value);\n                    const expected = normalize(input.getAttribute('data-answer'));\n\n                    input.classList.remove('is-correct', 'is-wrong');\n\n                    if (userVal === expected && userVal !== '') {\n                        input.classList.add('is-correct');\n                        correctCount++;\n                    } else {\n                        input.classList.add('is-wrong');\n                    }\n                });\n\n                scoreDisplay.textContent = `${correctCount} / ${inputs.length}`;\n\n                // Dispatch mandatory custom event\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                // PostMessage for external wrapper if any\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: inputs.length\n                    }, '*');\n                }\n            });\n\n            resetBtn.addEventListener('click', () => {\n                inputs.forEach(input => {\n                    input.value = '';\n                    input.classList.remove('is-correct', 'is-wrong');\n                });\n                scoreDisplay.textContent = `0 / ${inputs.length}`;\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: inputs.length,\n                        completed: false\n                    }\n                }));\n            });\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793474411685,
      "title": "G2.1 Modal Verbs (1) Interactive Reference & Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"h-full\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>G2.1 Modal Verbs (1) Interactive Reference & Practice</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n        .transition-all { transition: all 0.2s ease-in-out; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 h-full flex flex-col antialiased selection:bg-indigo-100 selection:text-indigo-800\">\n\n    <!-- Sticky Header / Top Navigation & Metrics Bar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n        <div class=\"w-full max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm flex items-center justify-center\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </div>\n                <div>\n                    <span class=\"text-xs font-semibold tracking-wider text-indigo-600 uppercase bg-indigo-50 px-2 py-0.5 rounded-full\">Grammar Reference</span>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Modal Verbs (1): be able to, be allowed to, be supposed to</h1>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 text-sm font-medium text-slate-700 flex items-center gap-1.5\">\n                    <span>Score:</span>\n                    <span id=\"score-display\" class=\"font-bold text-indigo-600\">0 / 6</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto flex-1 p-4 sm:p-6 md:p-8 space-y-8 my-auto\">\n\n        <!-- SECTION 1: INTERACTIVE GRAMMAR REFERENCE CARDS (Accordion Style) -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden\">\n            <div class=\"bg-gradient-to-r from-indigo-900 to-slate-900 p-5 text-white flex items-center justify-between\">\n                <div class=\"flex items-center space-x-3\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6 text-indigo-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                    <h2 class=\"text-lg font-bold\">Key Grammar Rules & Usage</h2>\n                </div>\n                <span class=\"text-xs bg-indigo-800/80 text-indigo-200 px-2.5 py-1 rounded-full font-medium\">Study Guide</span>\n            </div>\n            \n            <div class=\"p-5 sm:p-6 space-y-6 text-slate-700 text-sm leading-relaxed\">\n                <!-- Rule 1 -->\n                <div class=\"border-l-4 border-indigo-500 pl-4 py-1 space-y-1\">\n                    <h3 class=\"font-semibold text-slate-900 flex items-center gap-2\">\n                        <span class=\"w-2 h-2 rounded-full bg-indigo-500\"></span>\n                        Basic Modals & General Meaning\n                    </h3>\n                    <p><strong>Can, must, have to, should</strong> and <strong>ought to</strong> are modal verbs. We use <strong>be supposed to</strong> to say a person is expected to do something (e.g., <em>In the UK people are supposed to have a break every four hours.</em>).</p>\n                </div>\n\n                <!-- Rule 2 -->\n                <div class=\"border-l-4 border-sky-500 pl-4 py-1 space-y-1\">\n                    <h3 class=\"font-semibold text-slate-900 flex items-center gap-2\">\n                        <span class=\"w-2 h-2 rounded-full bg-sky-500\"></span>\n                        Ability, Necessity & Advice\n                    </h3>\n                    <ul class=\"list-disc list-inside space-y-1 text-slate-600\">\n                        <li><strong>Can / be able to:</strong> Ability or possibility (e.g., <em>We're able to continue working when we're travelling.</em>).</li>\n                        <li><strong>Must / have to:</strong> Necessity (e.g., <em>Lots of people have to take work home.</em>).</li>\n                        <li><strong>Should / ought to:</strong> Advice (e.g., <em>We ought to spend more time relaxing.</em>).</li>\n                        <li><strong>Be allowed to / can:</strong> Permission (e.g., <em>Some French employees are allowed to begin their weekend at 3 p.m.</em>).</li>\n                    </ul>\n                </div>\n\n                <!-- Rule 3 -->\n                <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-4 text-amber-900 space-y-2\">\n                    <div class=\"flex items-center space-x-2 font-semibold text-amber-900\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-amber-600 flex-shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z\" />\n                        </svg>\n                        <span>Important Tips & Structure</span>\n                    </div>\n                    <ul class=\"list-disc list-inside text-xs sm:text-sm space-y-1 text-amber-800\">\n                        <li>We use the <strong>infinitive</strong> after *can, must, have to, should, ought to, be able to, be allowed to* and *be supposed to* (e.g., *He must take...* NOT *He must taking...*).</li>\n                        <li>We make negatives and questions of *have to* using **do / does** (*I don't have to go*).</li>\n                        <li>We make negatives and questions of *be able to, be allowed to, be supposed to* by changing the form of the verb **be** (*He isn't able to come*).</li>\n                        <li>**Mustn't** = Not allowed / prohibited. **Don't have to** = Not necessary / optional.</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n\n        <!-- SECTION 2: INTERACTIVE PRACTICE EXERCISE -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-8 space-y-6\">\n            <div class=\"border-b border-slate-100 pb-4\">\n                <span class=\"text-xs font-semibold tracking-wider text-emerald-600 uppercase bg-emerald-50 px-2.5 py-0.5 rounded-full\">Practice Activity</span>\n                <h2 class=\"text-lg sm:text-xl font-bold text-slate-900 mt-2\">Modal Verbs Application & Check</h2>\n                <p class=\"text-sm text-slate-600 mt-1\">Select the correct modal verb or phrase to complete each sentence accurately based on the grammar rules above.</p>\n            </div>\n\n            <!-- Quiz Questions Container -->\n            <div id=\"quiz-container\" class=\"space-y-6\">\n\n                <!-- Question 1 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-id=\"1\">\n                    <div class=\"flex items-start justify-between gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white font-bold text-xs flex items-center justify-center\">1</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium flex-1\">\n                            You <select data-answer=\"don't have to\" class=\"mx-1 px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                                <option value=\"\">--- select ---</option>\n                                <option value=\"don't have to\">don't have to</option>\n                                <option value=\"mustn't\">mustn't</option>\n                            </select> wear a suit to work; it's a completely casual office.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Question 2 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-id=\"2\">\n                    <div class=\"flex items-start justify-between gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white font-bold text-xs flex items-center justify-center\">2</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium flex-1\">\n                            Employees <select data-answer=\"mustn't\" class=\"mx-1 px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                                <option value=\"\">--- select ---</option>\n                                <option value=\"don't have to\">don't have to</option>\n                                <option value=\"mustn't\">mustn't</option>\n                            </select> send personal emails from company computers. It's strictly prohibited.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Question 3 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-id=\"3\">\n                    <div class=\"flex items-start justify-between gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white font-bold text-xs flex items-center justify-center\">3</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium flex-1\">\n                            We <select data-answer=\"are supposed to\" class=\"mx-1 px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                                <option value=\"\">--- select ---</option>\n                                <option value=\"are supposed to\">are supposed to</option>\n                                <option value=\"have to go\">have to go</option>\n                            </select> arrive at the meeting by 9:00 a.m. sharp; that is the expectation.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Question 4 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-id=\"4\">\n                    <div class=\"flex items-start justify-between gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white font-bold text-xs flex items-center justify-center\">4</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium flex-1\">\n                            Due to the new policy, Sarah <select data-answer=\"isn't allowed to\" class=\"mx-1 px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                                <option value=\"\">--- select ---</option>\n                                <option value=\"isn't allowed to\">isn't allowed to</option>\n                                <option value=\"doesn't have to\">doesn't have to</option>\n                            </select> work from home on Fridays anymore.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Question 5 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-id=\"5\">\n                    <div class=\"flex items-start justify-between gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white font-bold text-xs flex items-center justify-center\">5</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium flex-1\">\n                            I was so busy yesterday that I <select data-answer=\"had to\" class=\"mx-1 px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                                <option value=\"\">--- select ---</option>\n                                <option value=\"must\">must</option>\n                                <option value=\"had to\">had to</option>\n                            </select> cancel all my afternoon appointments.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Question 6 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3 question-card\" data-id=\"6\">\n                    <div class=\"flex items-start justify-between gap-3\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-800 text-white font-bold text-xs flex items-center justify-center\">6</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium flex-1\">\n                            People <select data-answer=\"ought to\" class=\"mx-1 px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                                <option value=\"\">--- select ---</option>\n                                <option value=\"ought to\">ought to</option>\n                                <option value=\"mustn't\">mustn't</option>\n                            </select> take regular breaks to maintain productivity and wellbeing.\n                        </p>\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100\">\n                <button id=\"reset-btn\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-100 transition-all flex items-center gap-2 min-h-[42px]\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    Reset Answers\n                </button>\n                <button id=\"check-btn\" class=\"px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold hover:bg-indigo-700 shadow-sm transition-all flex items-center gap-2 min-h-[42px]\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                    Check Answers\n                </button>\n            </div>\n        </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full text-center py-6 text-xs text-slate-400 border-t border-slate-200 mt-auto\">\n        Interactive Grammar Practice &bull; ELT Modular Content Engine\n    </footer>\n\n    <!-- Script / Logic & Analytics Integration -->\n    <script>\n        // Mandatory Pedagogical Metrics Contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'modal_verbs_be_able_to_allowed_to',\n            maxScore: 6\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const scoreDisplay = document.getElementById('score-display');\n            const selects = document.querySelectorAll('#quiz-container select');\n\n            function checkAnswers() {\n                let correctCount = 0;\n                const total = selects.length;\n\n                selects.forEach(select => {\n                    const userAnswer = select.value.trim().toLowerCase();\n                    const correctAnswer = select.getAttribute('data-answer').trim().toLowerCase();\n\n                    // Remove previous status styles\n                    select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900');\n\n                    if (userAnswer === correctAnswer) {\n                        correctCount++;\n                        select.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-bold');\n                    } else {\n                        select.classList.add('border-red-500', 'bg-red-50', 'text-red-900', 'font-bold');\n                    }\n                });\n\n                // Update Score Display\n                scoreDisplay.textContent = `${correctCount} / ${total}`;\n\n                // Dispatch Custom ELT Event for Live Tracking\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: total,\n                        completed: correctCount === total\n                    }\n                }));\n\n                // Post Message for parent window integration\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: total\n                    }, '*');\n                }\n            }\n\n            function resetActivity() {\n                selects.forEach(select => {\n                    select.value = \"\";\n                    select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900', 'font-bold');\n                });\n                scoreDisplay.textContent = `0 / ${selects.length}`;\n            }\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793474581095,
      "title": "Grammar Practice: Working Conditions",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Grammar Practice: Working Conditions</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .dialogue-pair {\n      transition: all 0.2s ease-in-out;\n    }\n    select.item-select {\n      appearance: none;\n      background-image: url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23475569' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e\");\n      background-repeat: no-repeat;\n      background-position: right 0.5rem center;\n      background-size: 1rem;\n      padding-right: 2rem;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between font-sans\">\n\n  <!-- STICKY TOP AUDIO PLAYER (Locked initially for Listen & Check activity) -->\n  <div id=\"audioContainer\" class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-2.5 px-4 border-b border-slate-200 w-full shadow-sm opacity-40 pointer-events-none select-none transition-opacity duration-300\">\n    <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2\">\n      <div class=\"flex items-center gap-2 text-xs font-medium text-slate-600\" id=\"audioStatusText\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 text-amber-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/>\n        </svg>\n        <span>Locked: Check your answers first to unlock audio verification (R2.3)</span>\n      </div>\n      <audio id=\"lessonAudio\" controls class=\"w-full sm:w-72 h-10\" src=\"data:audio/mpeg;base64,\"></audio>\n    </div>\n  </div>\n\n  <!-- MAIN CONTAINER -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n    \n    <!-- HEADER INTRO -->\n    <header class=\"mb-6 bg-white border border-slate-200 rounded-2xl p-5 shadow-sm\">\n      <div class=\"flex items-center gap-3 mb-2\">\n        <span class=\"bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider\">Exercise 6a & b</span>\n        <span class=\"text-xs text-slate-500 font-medium\">Modal & Auxiliary Verbs</span>\n      </div>\n      <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900 mb-2\">Working Conditions Dialogue</h1>\n      <p class=\"text-sm sm:text-base text-slate-600 leading-relaxed\">\n        Kim and Rob are talking after the radio programme. Read their conversation and choose the correct verb forms.\n      </p>\n    </header>\n\n    <!-- INTERACTIVE DIALOGUE FORM -->\n    <form id=\"quizForm\" class=\"bg-white border border-slate-200 rounded-2xl p-4 sm:p-6 md:p-8 shadow-sm space-y-5\">\n      \n      <!-- ITEM 1 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-indigo-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-indigo-500\"></span> KIM:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          So, do you think you \n          <select data-answer=\"should\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"should\">should</option>\n            <option value=\"are allowed to\">are allowed to</option>\n          </select>\n          <span>relax more?</span>\n        </div>\n      </div>\n\n      <!-- ITEM 2 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-emerald-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-emerald-500\"></span> ROB:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          Absolutely! I \n          <select data-answer=\"must\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"am able to\">am able to</option>\n            <option value=\"must\">must</option>\n          </select>\n          <span>try to slow down a bit.</span>\n        </div>\n      </div>\n\n      <!-- ITEM 3 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-indigo-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-indigo-500\"></span> KIM:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          <select data-answer=\"Are you able to\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"Are you able to\">Are you able to</option>\n            <option value=\"Should you\">Should you</option>\n          </select>\n          <span>start work when you want?</span>\n        </div>\n      </div>\n\n      <!-- ITEM 4 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-emerald-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-emerald-500\"></span> ROB:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          <select data-answer=\"I'm supposed to\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"I'm supposed to\">I'm supposed to</option>\n            <option value=\"I can\">I can</option>\n          </select>\n          <span>be in the office at eight. What about you?</span>\n        </div>\n      </div>\n\n      <!-- ITEM 5 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-indigo-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-indigo-500\"></span> KIM:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          <span>I</span>\n          <select data-answer=\"don't have to\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"don't have to\">don't have to</option>\n            <option value=\"mustn't\">mustn't</option>\n          </select>\n          <span>be at work until ten.</span>\n        </div>\n      </div>\n\n      <!-- ITEM 6 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-emerald-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-emerald-500\"></span> ROB:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          <span>Lucky you.</span>\n          <select data-answer=\"Are you allowed to\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"Are you allowed to\">Are you allowed to</option>\n            <option value=\"Should you\">Should you</option>\n          </select>\n          <span>work at home?</span>\n        </div>\n      </div>\n\n      <!-- ITEM 7 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-indigo-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-indigo-500\"></span> KIM:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          <span>Yes, we</span>\n          <select data-answer=\"can\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"ought to\">ought to</option>\n            <option value=\"can\">can</option>\n          </select>\n          <span>work at home two days a week.</span>\n        </div>\n      </div>\n\n      <!-- ITEM 8 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-emerald-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-emerald-500\"></span> ROB:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          <span>Oh, we</span>\n          <select data-answer=\"have to\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"have to\">have to</option>\n            <option value=\"are able to\">are able to</option>\n          </select>\n          <span>be in the office every day.</span>\n        </div>\n      </div>\n\n      <!-- ITEM 9 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-indigo-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-indigo-500\"></span> KIM:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          <span>Perhaps you</span>\n          <select data-answer=\"ought to\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"ought to\">ought to</option>\n            <option value=\"are supposed to\">are supposed to</option>\n          </select>\n          <span>look for another job.</span>\n        </div>\n      </div>\n\n      <!-- ITEM 10 & 11 -->\n      <div class=\"dialogue-pair p-3 rounded-xl hover:bg-slate-50/80 border border-transparent hover:border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3\">\n        <div class=\"w-20 shrink-0 font-bold text-emerald-900 text-sm sm:text-base flex items-center gap-1.5\">\n          <span class=\"inline-block w-2 h-2 rounded-full bg-emerald-500\"></span> ROB:\n        </div>\n        <div class=\"flex-grow text-slate-700 text-sm sm:text-base leading-relaxed flex flex-wrap items-center gap-1.5\">\n          <span>Yes, maybe. Anyway, I</span>\n          <select data-answer=\"have to\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"have to\">have to</option>\n            <option value=\"can\">can</option>\n          </select>\n          <span>go. I</span>\n          <select data-answer=\"mustn't\" class=\"item-select bg-white border border-slate-300 rounded-lg py-1.5 px-3 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"\">-- choose --</option>\n            <option value=\"mustn't\">mustn't</option>\n            <option value=\"don't have to\">don't have to</option>\n          </select>\n          <span>be late for my next meeting. Bye!</span>\n        </div>\n      </div>\n\n      <!-- DISCUSSION QUESTION BOX -->\n      <div class=\"mt-6 p-4 bg-indigo-50/60 border border-indigo-100 rounded-xl\">\n        <h3 class=\"text-sm font-semibold text-indigo-900 mb-1 flex items-center gap-1.5\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/>\n          </svg>\n          Critical Thinking Question:\n        </h3>\n        <p class=\"text-xs sm:text-sm text-indigo-800 mb-3\">Who has the best working conditions according to the conversation?</p>\n        <div class=\"flex flex-col sm:flex-row gap-2\">\n          <label class=\"flex items-center gap-2 p-2.5 bg-white border border-indigo-200 rounded-lg cursor-pointer hover:bg-indigo-50/50 text-xs sm:text-sm font-medium text-indigo-900\">\n            <input type=\"radio\" name=\"bestConditions\" value=\"kim\" class=\"text-indigo-600 focus:ring-indigo-500\"> Kim (can work from home 2 days/week, starts later)\n          </label>\n          <label class=\"flex items-center gap-2 p-2.5 bg-white border border-indigo-200 rounded-lg cursor-pointer hover:bg-indigo-50/50 text-xs sm:text-sm font-medium text-indigo-900\">\n            <input type=\"radio\" name=\"bestConditions\" value=\"rob\" class=\"text-indigo-600 focus:ring-indigo-500\"> Rob (must be in office daily, strict schedule)\n          </label>\n        </div>\n      </div>\n\n      <!-- ACTION CONTROLS -->\n      <div class=\"pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4\">\n        <div class=\"text-sm font-medium text-slate-600\" id=\"scoreDisplay\">\n          Score: <span id=\"currentScore\" class=\"font-bold text-slate-900\">0</span> / <span id=\"totalScore\">11</span>\n        </div>\n        <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n          <button type=\"button\" id=\"resetBtn\" class=\"w-full sm:w-auto px-4 py-2.5 text-sm font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors cursor-pointer\">\n            🔄 Reset\n          </button>\n          <button type=\"button\" id=\"checkBtn\" class=\"w-full sm:w-auto px-6 py-2.5 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm rounded-xl transition-colors cursor-pointer\">\n            ✓ Check Answers\n          </button>\n        </div>\n      </div>\n\n    </form>\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"w-full py-4 text-center text-xs text-slate-400 border-t border-slate-100 mt-8\">\n    Interactive ELT Micro-Application • Responsive Touch Optimized\n  </footer>\n\n  <!-- SCRIPT LOGIC & METRICS CONTRACT -->\n  <script>\n    // Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Grammar',\n      skill: 'modal_and_auxiliary_verbs_working_conditions',\n      maxScore: 11\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const checkBtn = document.getElementById('checkBtn');\n      const resetBtn = document.getElementById('resetBtn');\n      const selects = document.querySelectorAll('.item-select');\n      const currentScoreEl = document.getElementById('currentScore');\n      const audioContainer = document.getElementById('audioContainer');\n      const audioStatusText = document.getElementById('audioStatusText');\n\n      checkBtn.addEventListener('click', () => {\n        let correctCount = 0;\n\n        selects.forEach(select => {\n          const expected = select.getAttribute('data-answer');\n          const userVal = select.value.trim();\n\n          select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n          if (userVal === expected) {\n            correctCount++;\n            select.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n          } else {\n            select.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n          }\n        });\n\n        currentScoreEl.textContent = correctCount;\n\n        // Unlock Audio Player (Listen & Check feature)\n        audioContainer.classList.remove('opacity-40', 'pointer-events-none', 'select-none');\n        audioStatusText.innerHTML = `\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 text-emerald-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/>\n          </svg>\n          <span class=\"text-emerald-700 font-semibold\">🎧 Now listen and check your answers (R2.3)</span>\n        `;\n\n        // Dispatch Activity Update Event\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: selects.length,\n            completed: correctCount === selects.length\n          }\n        }));\n\n        // Post message for parent frame embedding\n        if (window.parent && window.parent !== window) {\n          window.parent.postMessage({\n            type: 'ACTIVITY_SCORE',\n            score: correctCount,\n            total: selects.length\n          }, '*');\n        }\n      });\n\n      resetBtn.addEventListener('click', () => {\n        selects.forEach(select => {\n          select.value = \"\";\n          select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n        });\n        document.querySelectorAll('input[name=\"bestConditions\"]').forEach(radio => radio.checked = false);\n        currentScoreEl.textContent = \"0\";\n\n        // Re-lock audio player on reset\n        audioContainer.classList.add('opacity-40', 'pointer-events-none', 'select-none');\n        audioStatusText.innerHTML = `\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 text-amber-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/>\n          </svg>\n          <span>Locked: Check your answers first to unlock audio verification (R2.3)</span>\n        `;\n\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: 0,\n            total: selects.length,\n            completed: false\n          }\n        }));\n      });\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793474690257,
      "title": "ELT Pronunciation Activity - Listen and Practise",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ELT Pronunciation Activity - Listen and Practise</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- STICKY TOP-0 AUDIO PLAYER CONTAINER (LOCKED AT START) -->\n  <div id=\"stickyAudioContainer\" class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"inline-flex items-center justify-center p-1.5 bg-indigo-100 text-indigo-700 rounded-lg\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 11.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\"/></svg>\n        </span>\n        <div>\n          <h2 id=\"audioStatusText\" class=\"text-xs sm:text-sm font-semibold text-slate-700 flex items-center gap-1.5\">\n            <svg class=\"w-4 h-4 text-amber-600 inline\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/></svg>\n            Audio locked. Check answers to unlock listening.\n          </h2>\n        </div>\n      </div>\n      <!-- Locked Audio Element -->\n      <div id=\"audioWrapper\" class=\"w-full sm:w-auto opacity-40 pointer-events-none select-none transition-opacity duration-300\">\n        <audio id=\"lessonAudio\" controls class=\"w-full sm:w-80 h-10\" src=\"data:audio/mpeg;base64,\"></audio>\n      </div>\n    </div>\n  </div>\n\n  <!-- MAIN ACTIVITY CONTAINER -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n    \n    <!-- Header card -->\n    <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-6 mb-6\">\n      <div class=\"flex flex-wrap items-center justify-between gap-4 mb-3\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"px-2.5 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-md\">R2.4</span>\n          <span class=\"px-2.5 py-1 bg-purple-100 text-purple-800 text-xs font-bold rounded-md\">Pronunciation</span>\n        </div>\n        <div class=\"text-sm font-medium text-slate-500\">\n          Score: <span id=\"scoreDisplay\" class=\"font-bold text-slate-800\">0</span> / <span id=\"totalDisplay\">4</span>\n        </div>\n      </div>\n      \n      <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900 mb-2\">Listen and Practise</h1>\n      <p class=\"text-slate-600 text-sm sm:text-base\">\n        Read the sentence below, identify the weak forms or stress patterns, and test your understanding before listening.\n      </p>\n    </div>\n\n    <!-- Interactive Exercise Card -->\n    <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-6 mb-6\">\n      <div class=\"mb-6 p-4 bg-slate-50 border border-slate-100 rounded-xl\">\n        <span class=\"text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1\">Instruction reference</span>\n        <p class=\"text-slate-700 font-medium text-sm sm:text-base\">Listen and practise the sentences in 6a.</p>\n      </div>\n\n      <div class=\"space-y-6\">\n        <!-- Sentence item with interactive element -->\n        <div class=\"p-4 sm:p-5 bg-white border border-slate-200 rounded-xl hover:border-slate-300 transition-colors\">\n          <div class=\"flex items-start gap-3\">\n            <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-sm\">1</span>\n            <div class=\"flex-grow space-y-3\">\n              <p class=\"text-base sm:text-lg text-slate-800 font-medium italic\">\n                Do you <span class=\"inline-block px-2 py-0.5 bg-indigo-50 text-indigo-700 font-mono text-sm rounded border border-indigo-100\">/dəzə/</span> think you should relax more?\n              </p>\n              \n              <div class=\"pt-2 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <label for=\"blank1\" class=\"text-sm font-medium text-slate-600\">What word does <span class=\"font-mono text-indigo-600\">/dəzə/</span> represent in fast speech?</label>\n                <input \n                  type=\"text\" \n                  id=\"blank1\" \n                  data-answer=\"do you\" \n                  class=\"w-full sm:w-48 px-3 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-slate-800 font-medium\"\n                  placeholder=\"Type answer...\"\n                  autocomplete=\"off\"\n                >\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Additional targeted comprehension/phonetic sub-items to make 4 total testable items -->\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n          <!-- Item 2 -->\n          <div class=\"p-4 bg-white border border-slate-200 rounded-xl flex flex-col justify-between\">\n            <div>\n              <span class=\"text-xs font-bold text-slate-400 block mb-1\">Item 2</span>\n              <p class=\"text-sm font-medium text-slate-800 mb-3\">Which auxiliary verb is weakened here?</p>\n            </div>\n            <select id=\"blank2\" data-answer=\"do\" class=\"w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none\">\n              <option value=\"\">Select option...</option>\n              <option value=\"do\">Do</option>\n              <option value=\"does\">Does</option>\n              <option value=\"did\">Did</option>\n            </select>\n          </div>\n\n          <!-- Item 3 -->\n          <div class=\"p-4 bg-white border border-slate-200 rounded-xl flex flex-col justify-between\">\n            <div>\n              <span class=\"text-xs font-bold text-slate-400 block mb-1\">Item 3</span>\n              <p class=\"text-sm font-medium text-slate-800 mb-3\">What is the main stress verb in the sentence?</p>\n            </div>\n            <select id=\"blank3\" data-answer=\"relax\" class=\"w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none\">\n              <option value=\"\">Select option...</option>\n              <option value=\"think\">think</option>\n              <option value=\"should\">should</option>\n              <option value=\"relax\">relax</option>\n            </select>\n          </div>\n\n          <!-- Item 4 -->\n          <div class=\"p-4 bg-white border border-slate-200 rounded-xl flex flex-col justify-between\">\n            <div>\n              <span class=\"text-xs font-bold text-slate-400 block mb-1\">Item 4</span>\n              <p class=\"text-sm font-medium text-slate-800 mb-3\">Intonation pattern at the end:</p>\n            </div>\n            <select id=\"blank4\" data-answer=\"rising\" class=\"w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none\">\n              <option value=\"\">Select option...</option>\n              <option value=\"rising\">Rising (↗)</option>\n              <option value=\"falling\">Falling (↘)</option>\n              <option value=\"flat\">Flat (→)</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"mt-8 flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100\">\n        <button \n          id=\"resetBtn\" \n          onclick=\"resetActivity()\"\n          class=\"px-5 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors min-h-[42px] flex items-center gap-2 cursor-pointer\"\n        >\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\n          Reset\n        </button>\n\n        <button \n          id=\"checkBtn\" \n          onclick=\"checkAnswers()\"\n          class=\"px-6 py-2.5 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl transition-colors min-h-[42px] shadow-sm flex items-center gap-2 cursor-pointer\"\n        >\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/></svg>\n          Check Answers\n        </button>\n      </div>\n    </div>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-100 bg-white\">\n    Interactive ELT Learning Module • Responsive Touch Optimized\n  </footer>\n\n  <!-- Script Logic & Pedagogy Contract -->\n  <script>\n    // Mandatory Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Listening',\n      skill: 'pronunciation_weak_forms',\n      maxScore: 4\n    };\n\n    function normalizeText(txt) {\n      return (txt || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n    }\n\n    function checkAnswers() {\n      let correctCount = 0;\n      const inputs = [\n        document.getElementById('blank1'),\n        document.getElementById('blank2'),\n        document.getElementById('blank3'),\n        document.getElementById('blank4')\n      ];\n\n      inputs.forEach(input => {\n        const userVal = normalizeText(input.value);\n        const expectedVal = normalizeText(input.getAttribute('data-answer'));\n        \n        // Remove previous status classes\n        input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n        if (userVal === expectedVal) {\n          correctCount++;\n          input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n        } else {\n          input.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n        }\n      });\n\n      // Update score display\n      document.getElementById('scoreDisplay').textContent = correctCount;\n\n      // Unlock Audio Player on Check (Locked Audio Rule)\n      const audioWrapper = document.getElementById('audioWrapper');\n      const audioStatusText = document.getElementById('audioStatusText');\n      \n      audioWrapper.classList.remove('opacity-40', 'pointer-events-none', 'select-none');\n      audioStatusText.innerHTML = `\n        <svg class=\"w-4 h-4 text-emerald-600 inline\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n        🎧 Now listen and check your answers.\n      `;\n      audioStatusText.className = \"text-xs sm:text-sm font-semibold text-emerald-700 flex items-center gap-1.5\";\n\n      // Dispatch decoupled update event for parent frames / analytics\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: inputs.length,\n          completed: correctCount === inputs.length\n        }\n      }));\n\n      // Post message for wrapper integration\n      if (window.parent && window.parent !== window) {\n        window.parent.postMessage({\n          type: 'ACTIVITY_SCORE',\n          score: correctCount,\n          total: inputs.length\n        }, '*');\n      }\n    }\n\n    function resetActivity() {\n      const inputs = [\n        document.getElementById('blank1'),\n        document.getElementById('blank2'),\n        document.getElementById('blank3'),\n        document.getElementById('blank4')\n      ];\n\n      inputs.forEach(input => {\n        if (input.tagName === 'SELECT') {\n          input.selectedIndex = 0;\n        } else {\n          input.value = '';\n        }\n        input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n      });\n\n      document.getElementById('scoreDisplay').textContent = '0';\n\n      // Re-lock audio player\n      const audioWrapper = document.getElementById('audioWrapper');\n      const audioStatusText = document.getElementById('audioStatusText');\n      const audioElement = document.getElementById('lessonAudio');\n      \n      audioElement.pause();\n      audioElement.currentTime = 0;\n      audioWrapper.classList.add('opacity-40', 'pointer-events-none', 'select-none');\n      audioStatusText.innerHTML = `\n        <svg class=\"w-4 h-4 text-amber-600 inline\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"/></svg>\n        Audio locked. Check answers to unlock listening.\n      `;\n      audioStatusText.className = \"text-xs sm:text-sm font-semibold text-slate-700 flex items-center gap-1.5\";\n    }\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793474760205,
      "title": "Get ready... Get it right! - Company Profile Workshop",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Get ready... Get it right! - Company Profile Workshop</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Top Header with Score & Status -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n    <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n      <div class=\"flex items-center space-x-3\">\n        <span class=\"bg-amber-500 text-white font-bold text-xs uppercase px-2.5 py-1 rounded-md tracking-wider\">Get Ready</span>\n        <h1 class=\"text-base sm:text-lg font-bold text-slate-800 flex items-center gap-2\">\n          🏢 Working Conditions Planner\n        </h1>\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <div id=\"score-display\" class=\"text-sm font-semibold bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg border border-slate-200\">\n          Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">7</span>\n        </div>\n        <button id=\"reset-btn\" class=\"text-xs font-semibold bg-slate-200 hover:bg-slate-300 text-slate-700 px-3 py-2 rounded-lg transition-colors flex items-center gap-1 cursor-pointer\">\n          🔄 Reset\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-4\">\n    \n    <!-- Introduction Banner / Task Card -->\n    <section class=\"bg-gradient-to-r from-amber-500 to-amber-600 rounded-2xl p-6 text-white shadow-sm mb-8 relative overflow-hidden\">\n      <div class=\"absolute -right-10 -bottom-10 opacity-10 text-9xl font-black\">7</div>\n      <div class=\"flex items-start gap-4\">\n        <div class=\"bg-white/20 p-3 rounded-xl backdrop-blur-sm text-white font-black text-xl\">7</div>\n        <div>\n          <h2 class=\"text-xl sm:text-2xl font-black mb-2\">Build Your Ideal Company Profile</h2>\n          <p class=\"text-amber-100 text-sm sm:text-base leading-relaxed\">\n            Imagine you run a company with fantastic working conditions. Complete your company notes below based on the key areas. Then, vote for the best company to work for!\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <!-- Interactive Company Profile Form -->\n    <form id=\"company-form\" class=\"space-y-6\">\n      \n      <!-- Item 1 -->\n      <div class=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm transition-all hover:border-amber-300\">\n        <label for=\"input-1\" class=\"block font-bold text-slate-700 mb-2 flex items-center gap-2 text-sm sm:text-base\">\n          <span class=\"w-2.5 h-2.5 rounded-full bg-amber-500 inline-block\"></span>\n          1. The name of the company:\n        </label>\n        <input type=\"text\" id=\"input-1\" data-answer=\"TechNova\" placeholder=\"e.g., TechNova Solutions\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all\">\n      </div>\n\n      <!-- Item 2 -->\n      <div class=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm transition-all hover:border-amber-300\">\n        <label for=\"input-2\" class=\"block font-bold text-slate-700 mb-2 flex items-center gap-2 text-sm sm:text-base\">\n          <span class=\"w-2.5 h-2.5 rounded-full bg-amber-500 inline-block\"></span>\n          2. What your company does:\n        </label>\n        <input type=\"text\" id=\"input-2\" data-answer=\"Software development\" placeholder=\"e.g., Develops eco-friendly software\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all\">\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm transition-all hover:border-amber-300\">\n        <label for=\"input-3\" class=\"block font-bold text-slate-700 mb-2 flex items-center gap-2 text-sm sm:text-base\">\n          <span class=\"w-2.5 h-2.5 rounded-full bg-amber-500 inline-block\"></span>\n          3. The number of employees:\n        </label>\n        <input type=\"text\" id=\"input-3\" data-answer=\"50\" placeholder=\"e.g., 50 employees\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all\">\n      </div>\n\n      <!-- Item 4 -->\n      <div class=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm transition-all hover:border-amber-300\">\n        <label for=\"input-4\" class=\"block font-bold text-slate-700 mb-2 flex items-center gap-2 text-sm sm:text-base\">\n          <span class=\"w-2.5 h-2.5 rounded-full bg-amber-500 inline-block\"></span>\n          4. Working hours and overtime:\n        </label>\n        <input type=\"text\" id=\"input-4\" data-answer=\"35 hours\" placeholder=\"e.g., 35 hours a week, no overtime\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all\">\n      </div>\n\n      <!-- Item 5 -->\n      <div class=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm transition-all hover:border-amber-300\">\n        <label for=\"input-5\" class=\"block font-bold text-slate-700 mb-2 flex items-center gap-2 text-sm sm:text-base\">\n          <span class=\"w-2.5 h-2.5 rounded-full bg-amber-500 inline-block\"></span>\n          5. What employees can wear:\n        </label>\n        <input type=\"text\" id=\"input-5\" data-answer=\"Casual\" placeholder=\"e.g., Casual clothes every day\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all\">\n      </div>\n\n      <!-- Item 6 -->\n      <div class=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm transition-all hover:border-amber-300\">\n        <label for=\"input-6\" class=\"block font-bold text-slate-700 mb-2 flex items-center gap-2 text-sm sm:text-base\">\n          <span class=\"w-2.5 h-2.5 rounded-full bg-amber-500 inline-block\"></span>\n          6. Breaks and holidays:\n        </label>\n        <input type=\"text\" id=\"input-6\" data-answer=\"30 days\" placeholder=\"e.g., 1 hour lunch break, 30 days holiday\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all\">\n      </div>\n\n      <!-- Item 7 -->\n      <div class=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm transition-all hover:border-amber-300\">\n        <label for=\"input-7\" class=\"block font-bold text-slate-700 mb-2 flex items-center gap-2 text-sm sm:text-base\">\n          <span class=\"w-2.5 h-2.5 rounded-full bg-amber-500 inline-block\"></span>\n          7. Any other interesting information:\n        </label>\n        <input type=\"text\" id=\"input-7\" data-answer=\"Free lunch\" placeholder=\"e.g., Free daily lunch and remote options\" class=\"w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all\">\n      </div>\n\n      <!-- Check Answers Action Bar -->\n      <div class=\"pt-4 flex flex-col sm:flex-row items-center justify-between gap-4\">\n        <button type=\"button\" id=\"check-btn\" class=\"w-full sm:w-auto bg-amber-500 hover:bg-amber-600 text-white font-bold px-8 py-3.5 rounded-xl shadow-md transition-all active:scale-95 cursor-pointer min-h-[48px] flex items-center justify-center gap-2\">\n          ✓ Check Answers\n        </button>\n        <div id=\"feedback-msg\" class=\"text-sm font-medium text-slate-600 hidden\"></div>\n      </div>\n\n    </form>\n\n    <!-- Follow up Discussion Card (Exercise 8) -->\n    <section class=\"mt-10 bg-slate-100 border border-slate-200 rounded-2xl p-6\">\n      <div class=\"flex items-start gap-4\">\n        <div class=\"bg-slate-800 text-white font-bold p-3 rounded-xl text-xl\">8</div>\n        <div class=\"space-y-3\">\n          <h3 class=\"text-lg font-bold text-slate-800\">Discussion & Peer Review</h3>\n          <p class=\"text-sm text-slate-600 leading-relaxed\">\n            <strong>a)</strong> Work with students from different groups. Take turns to describe your companies. Ask questions to find out more information. Which is the best company to work for? Why?\n          </p>\n          <p class=\"text-sm text-slate-600 leading-relaxed\">\n            <strong>b)</strong> Tell the class which company you think is the best to work for. Which is the most popular company in the class?\n          </p>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"text-center py-6 text-xs text-slate-400 border-t border-slate-100 mt-auto\">\n    Interactive ELT Activity &bull; Get ready... Get it right!\n  </footer>\n\n  <!-- Script & Metrics Contract -->\n  <script>\n    // Mandatory Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'company_profile_planning',\n      maxScore: 7\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const form = document.getElementById('company-form');\n      const checkBtn = document.getElementById('check-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const currentScoreEl = document.getElementById('current-score');\n      const totalScoreEl = document.getElementById('total-score');\n      const feedbackMsg = document.getElementById('feedback-msg');\n      const inputs = form.querySelectorAll('input[data-answer]');\n\n      totalScoreEl.textContent = inputs.length;\n\n      // Helper function to normalize strings for flexible evaluation\n      const normalize = (str) => str.trim().toLowerCase().replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\");\n\n      // Check Answers Handler\n      checkBtn.addEventListener('click', () => {\n        let correctCount = 0;\n\n        inputs.forEach(input => {\n          const userVal = normalize(input.value);\n          const expectedAnswer = normalize(input.getAttribute('data-answer'));\n          \n          // Check if user answer includes the keyword or matches closely\n          if (userVal.length > 0 && (userVal === expectedAnswer || userVal.includes(expectedAnswer) || expectedAnswer.includes(userVal))) {\n            input.classList.remove('border-slate-300', 'bg-slate-50', 'border-red-500', 'bg-red-50');\n            input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n            correctCount++;\n          } else {\n            input.classList.remove('border-slate-300', 'bg-slate-50', 'border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n            input.classList.add('border-red-500', 'bg-red-50', 'text-red-900');\n          }\n        });\n\n        // Update score display\n        currentScoreEl.textContent = correctCount;\n\n        // Feedback message\n        feedbackMsg.classList.remove('hidden');\n        if (correctCount === inputs.length) {\n          feedbackMsg.textContent = \"🌟 Excellent! All company notes look fantastic!\";\n          feedbackMsg.className = \"text-sm font-bold text-emerald-600\";\n        } else {\n          feedbackMsg.textContent = `You got ${correctCount} out of ${inputs.length} correct. Review your notes!`;\n          feedbackMsg.className = \"text-sm font-bold text-amber-600\";\n        }\n\n        // Dispatch Custom Event for live analytics integration\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: inputs.length,\n            completed: correctCount === inputs.length\n          }\n        }));\n\n        // Post message to parent container if embedded in iframe\n        if (window.parent !== window) {\n          window.parent.postMessage({ \n            type: 'ACTIVITY_SCORE', \n            score: correctCount, \n            total: inputs.length \n          }, '*');\n        }\n      });\n\n      // Reset Button Handler\n      resetBtn.addEventListener('click', () => {\n        inputs.forEach(input => {\n          input.value = '';\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900');\n          input.classList.add('border-slate-300', 'bg-slate-50');\n        });\n        currentScoreEl.textContent = '0';\n        feedbackMsg.classList.add('hidden');\n\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: 0,\n            total: inputs.length,\n            completed: false\n          }\n        }));\n      });\n    });\n  </script>\n</body>\n</html>"
    }
  ]
}