{
  "version": "2.0",
  "title": "Int SB U2 Lesson C",
  "updatedAt": "2026-11-02T00:04:28.794Z",
  "slides": [
    {
      "id": 1793575237445,
      "title": "It's a Nightmare - Vocabulary & Listening",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>It's a Nightmare - Vocabulary & Listening</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            -webkit-tap-highlight-color: transparent;\n        }\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header / Audio Simulation bar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                <span class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm flex items-center justify-center\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z\"></path></svg>\n                </span>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">It's a nightmare</h1>\n                    <p class=\"text-xs text-slate-500\">Vocabulary & Listening (Sleep)</p>\n                </div>\n            </div>\n\n            <!-- Interactive Audio Bar Simulation -->\n            <div class=\"flex items-center gap-3 bg-slate-100 px-3 py-1.5 rounded-full w-full sm:w-auto justify-between sm:justify-start\">\n                <button id=\"playAudioBtn\" onclick=\"toggleAudio()\" class=\"w-9 h-9 flex items-center justify-center bg-indigo-600 hover:bg-indigo-700 text-white rounded-full transition shadow-sm focus:outline-none\">\n                    <svg id=\"playIcon\" class=\"w-4 h-4 ml-0.5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n                </button>\n                <div class=\"flex flex-col flex-1 sm:w-36\">\n                    <div class=\"flex justify-between text-[10px] text-slate-500 font-medium mb-0.5\">\n                        <span id=\"audioTime\">0:00</span>\n                        <span>0:45</span>\n                    </div>\n                    <div class=\"w-full bg-slate-300 h-1.5 rounded-full overflow-hidden\">\n                        <div id=\"audioProgress\" class=\"bg-indigo-600 h-full w-0 transition-all duration-300\"></div>\n                    </div>\n                </div>\n                <span class=\"text-xs font-semibold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-100\">Track 2.3</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-1\">\n        \n        <!-- Intro Instructions Box -->\n        <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 mb-6\">\n            <div class=\"flex items-start gap-4\">\n                <div class=\"bg-amber-100 text-amber-800 p-3 rounded-xl font-bold text-lg flex items-center justify-center min-w-[48px] min-h-[48px]\">\n                    1\n                </div>\n                <div class=\"flex-1\">\n                    <h2 class=\"text-lg font-bold text-slate-900 mb-1\">Vocabulary Check</h2>\n                    <p class=\"text-sm text-slate-600 mb-4\">Click/tick the words and phrases you already know. Then check new definitions in the reference drawer below.</p>\n                    \n                    <!-- Vocabulary Interactive Checklist Grid -->\n                    <div id=\"vocabChecklist\" class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5\">\n                        <!-- Items populated via JS or static interactive chips -->\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Reference Drawer (As requested by professor instruction) -->\n        <section class=\"bg-indigo-50/60 rounded-2xl border border-indigo-100 p-5 mb-6\">\n            <details class=\"group\">\n                <summary class=\"flex items-center justify-between cursor-pointer list-none font-semibold text-indigo-900 text-sm sm:text-base py-1 select-none\">\n                    <div class=\"flex items-center gap-2.5\">\n                        <svg class=\"w-5 h-5 text-indigo-600 group-open:rotate-90 transition-transform\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5l7 7-7 7\"></path></svg>\n                        <span>📖 Reference Glossary: Sleep Definitions (v2.3 p116)</span>\n                    </div>\n                    <span class=\"text-xs bg-indigo-200 text-indigo-800 px-2.5 py-1 rounded-full font-medium\">Click to reveal</span>\n                </summary>\n                \n                <div class=\"mt-4 pt-4 border-t border-indigo-200/60 grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-slate-700\">\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">have a dream</p>\n                        <p class=\"text-slate-600\">have stories and pictures in your head while sleeping: <span class=\"italic\">I had a very strange dream last night.</span></p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">fall asleep / be asleep</p>\n                        <p class=\"text-slate-600\">start sleeping: <span class=\"italic\">She fell asleep on the train home.</span></p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">wake up</p>\n                        <p class=\"text-slate-600\">stop sleeping: <span class=\"italic\">I woke up at six thirty this morning.</span></p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">get (back) to sleep</p>\n                        <p class=\"text-slate-600\">start sleeping (again): <span class=\"italic\">It took me a long time to get back to sleep.</span></p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">snore</p>\n                        <p class=\"text-slate-600\">breathe noisily while sleeping: <span class=\"italic\">Steve was snoring so loudly.</span></p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">be fast asleep / wide awake</p>\n                        <p class=\"text-slate-600\">completely asleep / completely awake: <span class=\"italic\">I was wide awake at 3 a.m.</span></p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">have insomnia / not sleep a wink</p>\n                        <p class=\"text-slate-600\">not be able to sleep / sleep not at all: <span class=\"italic\">I didn't sleep a wink last night.</span></p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">have nightmares</p>\n                        <p class=\"text-slate-600\">have frightening dreams: <span class=\"italic\">I had a terrible nightmare last night.</span></p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">be a light/heavy sleeper</p>\n                        <p class=\"text-slate-600\">wakes up easily / doesn't wake up easily.</p>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl border border-indigo-100 shadow-sm\">\n                        <p class=\"font-bold text-indigo-900\">take a nap / doze off / lie-in</p>\n                        <p class=\"text-slate-600\">short daytime sleep / fall asleep slowly / stay in bed later.</p>\n                    </div>\n                </div>\n            </details>\n        </section>\n\n        <!-- Practice Section: Complete sentences or Fill in gaps -->\n        <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 mb-6\">\n            <div class=\"flex items-start gap-4 mb-4\">\n                <div class=\"bg-indigo-600 text-white p-3 rounded-xl font-bold text-lg flex items-center justify-center min-w-[48px] min-h-[48px]\">\n                    2\n                </div>\n                <div>\n                    <h2 class=\"text-lg font-bold text-slate-900 mb-1\">Practice: Complete the Sentences</h2>\n                    <p class=\"text-sm text-slate-600\">Type the correct sleep expression based on the definitions and context.</p>\n                </div>\n            </div>\n\n            <div id=\"exerciseContainer\" class=\"space-y-4\">\n                <!-- Dynamic Exercise Items -->\n            </div>\n        </section>\n\n        <!-- Action Buttons & Scoreboard -->\n        <div class=\"flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-5 rounded-2xl shadow-sm border border-slate-200\">\n            <div class=\"flex items-center gap-3 w-full sm:w-auto justify-center sm:justify-start\">\n                <span class=\"text-sm font-semibold text-slate-600\">Score:</span>\n                <span id=\"scoreDisplay\" class=\"text-xl font-bold text-indigo-600 bg-indigo-50 px-4 py-1.5 rounded-xl border border-indigo-100\">0 / 6</span>\n            </div>\n\n            <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                <button onclick=\"resetActivity()\" class=\"flex-1 sm:flex-none px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-medium text-sm transition min-h-[42px] flex items-center justify-center gap-2\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    Reset\n                </button>\n                <button onclick=\"checkAnswers()\" class=\"flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-sm min-h-[42px] flex items-center justify-center gap-2\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    Check Answers\n                </button>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-6 text-xs text-slate-400 border-t border-slate-200 bg-white\">\n        Interactive ELT Micro-App &bull; English Vocabulary & Listening Module\n    </footer>\n\n    <!-- Script Application Logic -->\n    <script>\n        // PEDAGOGICAL METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'sleep_expressions_and_collocations',\n            maxScore: 6\n        };\n\n        // Vocabulary List from Recurrent OCR\n        const vocabWords = [\n            \"have a dream\", \"fall asleep\", \"wake up\", \n            \"get (back) to sleep\", \"snore\", \"be fast asleep\", \n            \"be wide awake\", \"have insomnia\", \"not sleep a wink\", \n            \"have nightmares\", \"be a light/heavy sleeper\", \"take a nap\", \n            \"doze off\", \"have a lie-in\", \"talk in your sleep\"\n        ];\n\n        // Fill in the blank exercises truth table\n        const exerciseData = [\n            {\n                id: 1,\n                prompt: \"I was so exhausted after the conference that I ___________ in the middle of the afternoon presentation.\",\n                answer: \"dozed off\",\n                alts: [\"dozed off\", \"fell asleep\"]\n            },\n            {\n                id: 2,\n                prompt: \"My husband makes a very loud whistling sound through his nose when he breathes at night. He loves to ___________.\",\n                answer: \"snore\",\n                alts: [\"snore\"]\n            },\n            {\n                id: 3,\n                prompt: \"I drank three espressos late at night, so at 3:00 a.m. I was still ___________.\",\n                answer: \"wide awake\",\n                alts: [\"wide awake\"]\n            },\n            {\n                id: 4,\n                prompt: \"Fiona is a very ___________ sleeper; even a small whisper outside her bedroom door wakes her up immediately.\",\n                answer: \"light\",\n                alts: [\"light\"]\n            },\n            {\n                id: 5,\n                prompt: \"After having that horrifying monster dream, I woke up sweating from a terrible ___________.\",\n                answer: \"nightmare\",\n                alts: [\"nightmare\", \"nightmares\"]\n            },\n            {\n                id: 6,\n                prompt: \"I was worried about the exam tomorrow and couldn't sleep at all. Literally, I didn't sleep ___________ last night.\",\n                answer: \"a wink\",\n                alts: [\"a wink\"]\n            }\n        ];\n\n        // Render Vocabulary Checklist\n        function renderVocabulary() {\n            const container = document.getElementById('vocabChecklist');\n            container.innerHTML = vocabWords.map((word, idx) => `\n                <label class=\"flex items-center space-x-2 p-2 rounded-xl bg-slate-50 hover:bg-indigo-50/50 border border-slate-200 cursor-pointer text-xs sm:text-sm font-medium transition select-none\">\n                    <input type=\"checkbox\" class=\"w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300\">\n                    <span class=\"text-slate-700 truncate\">${word}</span>\n                </label>\n            `).join('');\n        }\n\n        // Render Exercises\n        function renderExercises() {\n            const container = document.getElementById('exerciseContainer');\n            container.innerHTML = exerciseData.map((item, idx) => `\n                <div class=\"p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"flex items-start gap-3 flex-1\">\n                        <span class=\"bg-slate-200 text-slate-700 font-bold text-xs px-2.5 py-1 rounded-lg mt-0.5\">${idx + 1}</span>\n                        <p class=\"text-sm text-slate-700 leading-relaxed\">\n                            ${item.prompt.replace('___________', `<input type=\"text\" data-answer=\"${item.answer}\" data-alts='${JSON.stringify(item.alts)}' class=\"exercise-input px-3 py-1.5 mx-1 border border-slate-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 font-semibold text-slate-800 w-36 sm:w-44 inline-block\" placeholder=\"type here...\">`)}\n                        </p>\n                    </div>\n                </div>\n            `).join('');\n        }\n\n        // Check Answers Logic\n        function checkAnswers() {\n            const inputs = document.querySelectorAll('.exercise-input');\n            let correctCount = 0;\n\n            inputs.forEach(input => {\n                const userVal = input.value.trim().toLowerCase();\n                const primaryAnswer = input.getAttribute('data-answer').toLowerCase();\n                const alts = JSON.parse(input.getAttribute('data-alts') || '[]');\n\n                const isCorrect = userVal === primaryAnswer || alts.includes(userVal);\n\n                input.classList.remove('is-correct', 'is-wrong');\n                if (isCorrect) {\n                    input.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    input.classList.add('is-wrong');\n                }\n            });\n\n            // Update Score display\n            document.getElementById('scoreDisplay').textContent = `${correctCount} / ${inputs.length}`;\n\n            // Dispatch Custom Event for parent platforms / live session tracking\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: inputs.length,\n                    completed: correctCount === inputs.length\n                }\n            }));\n\n            // Post message for iframe container communication\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: inputs.length\n                }, '*');\n            }\n        }\n\n        // Reset Activity\n        function resetActivity() {\n            const inputs = document.querySelectorAll('.exercise-input');\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('is-correct', 'is-wrong');\n            });\n            document.getElementById('scoreDisplay').textContent = `0 / ${inputs.length}`;\n        }\n\n        // Audio simulation handler\n        let isPlaying = false;\n        let audioInterval = null;\n        function toggleAudio() {\n            const btn = document.getElementById('playAudioBtn');\n            const icon = document.getElementById('playIcon');\n            const progress = document.getElementById('audioProgress');\n            const timeDisplay = document.getElementById('audioTime');\n\n            isPlaying = !isPlaying;\n            if (isPlaying) {\n                btn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');\n                btn.classList.add('bg-amber-600', 'hover:bg-amber-700');\n                icon.innerHTML = '<path d=\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"/>'; // Pause icon\n                \n                let seconds = 0;\n                audioInterval = setInterval(() => {\n                    seconds++;\n                    if (seconds > 45) {\n                        toggleAudio();\n                        return;\n                    }\n                    const mins = Math.floor(seconds / 60);\n                    const secs = seconds % 60;\n                    timeDisplay.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;\n                    progress.style.width = `${(seconds / 45) * 100}%`;\n                }, 1000);\n            } else {\n                btn.classList.remove('bg-amber-600', 'hover:bg-amber-700');\n                btn.classList.add('bg-indigo-600', 'hover:bg-indigo-700');\n                icon.innerHTML = '<path d=\"M8 5v14l11-7z\"/>'; // Play icon\n                clearInterval(audioInterval);\n            }\n        }\n\n        // Initialize on load\n        window.addEventListener('DOMContentLoaded', () => {\n            renderVocabulary();\n            renderExercises();\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793575409685,
      "title": "Vocabulary: Sleep & Daily Routines - ELT Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"h-full\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Vocabulary: Sleep &amp; Daily Routines - ELT Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n        .is-correct { border-color: #059669 !important; background-color: #ecfdf5 !important; color: #065f46 !important; }\n        .is-wrong { border-color: #dc2626 !important; background-color: #fef2f2 !important; color: #991b1b !important; }\n    </style>\n<style>*, ::before, ::after{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }::backdrop{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }/* ! tailwindcss v3.4.17 | MIT License | https://tailwindcss.com */*,::after,::before{box-sizing:border-box;border-width:0;border-style:solid;border-color:#e5e7eb}::after,::before{--tw-content:''}:host,html{line-height:1.5;-webkit-text-size-adjust:100%;-moz-tab-size:4;tab-size:4;font-family:ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\";font-feature-settings:normal;font-variation-settings:normal;-webkit-tap-highlight-color:transparent}body{margin:0;line-height:inherit}hr{height:0;color:inherit;border-top-width:1px}abbr:where([title]){-webkit-text-decoration:underline dotted;text-decoration:underline dotted}h1,h2,h3,h4,h5,h6{font-size:inherit;font-weight:inherit}a{color:inherit;text-decoration:inherit}b,strong{font-weight:bolder}code,kbd,pre,samp{font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;font-feature-settings:normal;font-variation-settings:normal;font-size:1em}small{font-size:80%}sub,sup{font-size:75%;line-height:0;position:relative;vertical-align:baseline}sub{bottom:-.25em}sup{top:-.5em}table{text-indent:0;border-color:inherit;border-collapse:collapse}button,input,optgroup,select,textarea{font-family:inherit;font-feature-settings:inherit;font-variation-settings:inherit;font-size:100%;font-weight:inherit;line-height:inherit;letter-spacing:inherit;color:inherit;margin:0;padding:0}button,select{text-transform:none}button,input:where([type=button]),input:where([type=reset]),input:where([type=submit]){-webkit-appearance:button;background-color:transparent;background-image:none}:-moz-focusring{outline:auto}:-moz-ui-invalid{box-shadow:none}progress{vertical-align:baseline}::-webkit-inner-spin-button,::-webkit-outer-spin-button{height:auto}[type=search]{-webkit-appearance:textfield;outline-offset:-2px}::-webkit-search-decoration{-webkit-appearance:none}::-webkit-file-upload-button{-webkit-appearance:button;font:inherit}summary{display:list-item}blockquote,dd,dl,figure,h1,h2,h3,h4,h5,h6,hr,p,pre{margin:0}fieldset{margin:0;padding:0}legend{padding:0}menu,ol,ul{list-style:none;margin:0;padding:0}dialog{padding:0}textarea{resize:vertical}input::placeholder,textarea::placeholder{opacity:1;color:#9ca3af}[role=button],button{cursor:pointer}:disabled{cursor:default}audio,canvas,embed,iframe,img,object,svg,video{display:block;vertical-align:middle}img,video{max-width:100%;height:auto}[hidden]:where(:not([hidden=until-found])){display:none}.sticky{position:sticky}.top-0{top:0px}.z-20{z-index:20}.mx-auto{margin-left:auto;margin-right:auto}.mb-1{margin-bottom:0.25rem}.mb-3{margin-bottom:0.75rem}.mb-6{margin-bottom:1.5rem}.mt-0\\.5{margin-top:0.125rem}.mt-1{margin-top:0.25rem}.mt-6{margin-top:1.5rem}.mt-auto{margin-top:auto}.flex{display:flex}.h-4{height:1rem}.h-5{height:1.25rem}.h-7{height:1.75rem}.h-full{height:100%}.min-h-\\[44px\\]{min-height:44px}.w-4{width:1rem}.w-5{width:1.25rem}.w-7{width:1.75rem}.w-full{width:100%}.max-w-4xl{max-width:56rem}.flex-shrink-0{flex-shrink:0}.flex-grow{flex-grow:1}.flex-col{flex-direction:column}.flex-wrap{flex-wrap:wrap}.items-start{align-items:flex-start}.items-center{align-items:center}.justify-end{justify-content:flex-end}.justify-center{justify-content:center}.justify-between{justify-content:space-between}.gap-1{gap:0.25rem}.gap-1\\.5{gap:0.375rem}.gap-2{gap:0.5rem}.gap-3{gap:0.75rem}.space-y-4 > :not([hidden]) ~ :not([hidden]){--tw-space-y-reverse:0;margin-top:calc(1rem * calc(1 - var(--tw-space-y-reverse)));margin-bottom:calc(1rem * var(--tw-space-y-reverse))}.rounded-2xl{border-radius:1rem}.rounded-full{border-radius:9999px}.rounded-lg{border-radius:0.5rem}.rounded-md{border-radius:0.375rem}.rounded-xl{border-radius:0.75rem}.border{border-width:1px}.border-b{border-bottom-width:1px}.border-t{border-top-width:1px}.border-indigo-100{--tw-border-opacity:1;border-color:rgb(224 231 255 / var(--tw-border-opacity, 1))}.border-slate-100{--tw-border-opacity:1;border-color:rgb(241 245 249 / var(--tw-border-opacity, 1))}.border-slate-200{--tw-border-opacity:1;border-color:rgb(226 232 240 / var(--tw-border-opacity, 1))}.border-slate-300{--tw-border-opacity:1;border-color:rgb(203 213 225 / var(--tw-border-opacity, 1))}.bg-indigo-50{--tw-bg-opacity:1;background-color:rgb(238 242 255 / var(--tw-bg-opacity, 1))}.bg-indigo-50\\/70{background-color:rgb(238 242 255 / 0.7)}.bg-indigo-600{--tw-bg-opacity:1;background-color:rgb(79 70 229 / var(--tw-bg-opacity, 1))}.bg-slate-100{--tw-bg-opacity:1;background-color:rgb(241 245 249 / var(--tw-bg-opacity, 1))}.bg-slate-200{--tw-bg-opacity:1;background-color:rgb(226 232 240 / var(--tw-bg-opacity, 1))}.bg-slate-50{--tw-bg-opacity:1;background-color:rgb(248 250 252 / var(--tw-bg-opacity, 1))}.bg-slate-800{--tw-bg-opacity:1;background-color:rgb(30 41 59 / var(--tw-bg-opacity, 1))}.bg-white{--tw-bg-opacity:1;background-color:rgb(255 255 255 / var(--tw-bg-opacity, 1))}.bg-white\\/95{background-color:rgb(255 255 255 / 0.95)}.p-2{padding:0.5rem}.p-4{padding:1rem}.p-5{padding:1.25rem}.px-2{padding-left:0.5rem;padding-right:0.5rem}.px-2\\.5{padding-left:0.625rem;padding-right:0.625rem}.px-3{padding-left:0.75rem;padding-right:0.75rem}.px-4{padding-left:1rem;padding-right:1rem}.px-6{padding-left:1.5rem;padding-right:1.5rem}.py-1{padding-top:0.25rem;padding-bottom:0.25rem}.py-1\\.5{padding-top:0.375rem;padding-bottom:0.375rem}.py-2{padding-top:0.5rem;padding-bottom:0.5rem}.py-3{padding-top:0.75rem;padding-bottom:0.75rem}.py-4{padding-top:1rem;padding-bottom:1rem}.pt-2{padding-top:0.5rem}.pt-4{padding-top:1rem}.text-center{text-align:center}.text-base{font-size:1rem;line-height:1.5rem}.text-sm{font-size:0.875rem;line-height:1.25rem}.text-xs{font-size:0.75rem;line-height:1rem}.font-bold{font-weight:700}.font-medium{font-weight:500}.font-semibold{font-weight:600}.text-indigo-600{--tw-text-opacity:1;color:rgb(79 70 229 / var(--tw-text-opacity, 1))}.text-slate-400{--tw-text-opacity:1;color:rgb(148 163 184 / var(--tw-text-opacity, 1))}.text-slate-600{--tw-text-opacity:1;color:rgb(71 85 105 / var(--tw-text-opacity, 1))}.text-slate-700{--tw-text-opacity:1;color:rgb(51 65 85 / var(--tw-text-opacity, 1))}.text-slate-800{--tw-text-opacity:1;color:rgb(30 41 59 / var(--tw-text-opacity, 1))}.text-slate-900{--tw-text-opacity:1;color:rgb(15 23 42 / var(--tw-text-opacity, 1))}.text-white{--tw-text-opacity:1;color:rgb(255 255 255 / var(--tw-text-opacity, 1))}.antialiased{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.shadow-sm{--tw-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05);--tw-shadow-colored:0 1px 2px 0 var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)}.backdrop-blur{--tw-backdrop-blur:blur(8px);-webkit-backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia)}.transition-all{transition-property:all;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms}.transition-colors{transition-property:color, background-color, border-color, fill, stroke, -webkit-text-decoration-color;transition-property:color, background-color, border-color, text-decoration-color, fill, stroke;transition-property:color, background-color, border-color, text-decoration-color, fill, stroke, -webkit-text-decoration-color;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms}.hover\\:bg-indigo-700:hover{--tw-bg-opacity:1;background-color:rgb(67 56 202 / var(--tw-bg-opacity, 1))}.hover\\:bg-slate-300:hover{--tw-bg-opacity:1;background-color:rgb(203 213 225 / var(--tw-bg-opacity, 1))}.hover\\:shadow:hover{--tw-shadow:0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);--tw-shadow-colored:0 1px 3px 0 var(--tw-shadow-color), 0 1px 2px -1px var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)}.focus\\:outline-none:focus{outline:2px solid transparent;outline-offset:2px}.focus\\:ring-2:focus{--tw-ring-offset-shadow:var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);--tw-ring-shadow:var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);box-shadow:var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000)}.focus\\:ring-indigo-500:focus{--tw-ring-opacity:1;--tw-ring-color:rgb(99 102 241 / var(--tw-ring-opacity, 1))}.active\\:scale-\\[0\\.98\\]:active{--tw-scale-x:0.98;--tw-scale-y:0.98;transform:translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))}@media (min-width: 640px){.sm\\:mt-0{margin-top:0px}.sm\\:w-auto{width:auto}.sm\\:flex-row{flex-direction:row}.sm\\:items-center{align-items:center}.sm\\:justify-end{justify-content:flex-end}.sm\\:p-5{padding:1.25rem}.sm\\:p-6{padding:1.5rem}.sm\\:text-base{font-size:1rem;line-height:1.5rem}.sm\\:text-lg{font-size:1.125rem;line-height:1.75rem}.sm\\:text-sm{font-size:0.875rem;line-height:1.25rem}}@media (min-width: 768px){.md\\:p-8{padding:2rem}}</style></head>\n<body class=\"bg-slate-50 text-slate-800 h-full flex flex-col justify-between antialiased\">\n\n    <!-- Sticky Header / Instructions -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2\">\n            <div class=\"flex items-center gap-2\">\n                <span class=\"bg-indigo-600 text-white font-bold text-sm px-2.5 py-1 rounded-lg\">2</span>\n                <h1 class=\"font-semibold text-slate-900 text-base sm:text-lg\">Sleep &amp; Night Expressions</h1>\n            </div>\n            <div class=\"flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end\">\n                <div id=\"score-counter\" class=\"text-sm font-medium text-slate-600 bg-slate-100 px-3 py-1 rounded-full\">\n                    Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">6</span>\n                </div>\n                <button id=\"reset-btn\" class=\"text-xs sm:text-sm bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    Reset\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Activity Instructions Card -->\n        <div class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 mb-6\">\n            <div class=\"flex items-start gap-3\">\n                <div class=\"p-2 bg-indigo-50 text-indigo-600 rounded-xl mt-0.5\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n                </div>\n                <div>\n                    <h2 class=\"text-base sm:text-lg font-bold text-slate-900 mb-1\">Vocabulary Personalization &amp; Context</h2>\n                    <p class=\"text-sm text-slate-600 mb-3\">\n                        <strong>a)</strong> Choose six words or phrases from the sleep vocabulary bank that are connected to you, or people you know, and write personalized statements below.\n                    </p>\n                    <!-- Vocabulary Bank Reference Pills -->\n                    <div class=\"flex flex-wrap gap-1.5 pt-2 border-t border-slate-100\">\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">have a dream</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">fall asleep</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">wake up</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">get back to sleep</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">snore</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">be fast asleep</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">be wide awake</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">have insomnia</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">not sleep a wink</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">have nightmares</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">be a light/heavy sleeper</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">take a nap</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">doze off</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">have a lie-in</span>\n                        <span class=\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-md\">talk in your sleep</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Interactive Sentences Form -->\n        <form id=\"activity-form\" class=\"space-y-4\">\n            \n            <!-- Item 1 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 w-full\">\n                    <span class=\"flex-shrink-0 w-7 h-7 bg-slate-800 text-white text-xs font-bold rounded-full flex items-center justify-center mt-1 sm:mt-0\">1</span>\n                    <div class=\"text-sm sm:text-base text-slate-700 w-full flex flex-col gap-2\">\n                        <span class=\"font-medium text-slate-800\">Write a sentence about you or someone you know connected to a sleep term:</span>\n                        <input type=\"text\" data-answer=\"snore\" data-alts=\"fall asleep,wake up,get back to sleep,be fast asleep,be wide awake,have insomnia,not sleep a wink,have nightmares,be a light sleeper,be a heavy sleeper,take a nap,doze off,have a lie-in,talk in your sleep,have a dream\" class=\"interactive-input border border-slate-300 bg-white rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full\" placeholder=\"e.g., My grandfather tends to snore loudly...\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 w-full\">\n                    <span class=\"flex-shrink-0 w-7 h-7 bg-slate-800 text-white text-xs font-bold rounded-full flex items-center justify-center mt-1 sm:mt-0\">2</span>\n                    <div class=\"text-sm sm:text-base text-slate-700 w-full flex flex-col gap-2\">\n                        <span class=\"font-medium text-slate-800\">Write a second personalized sentence using a different sleep expression:</span>\n                        <input type=\"text\" data-answer=\"take a nap\" data-alts=\"fall asleep,wake up,get back to sleep,snore,be fast asleep,be wide awake,have insomnia,not sleep a wink,have nightmares,be a light sleeper,be a heavy sleeper,doze off,have a lie-in,talk in your sleep,have a dream\" class=\"interactive-input border border-slate-300 bg-white rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full\" placeholder=\"e.g., I usually take a nap after lunch...\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 w-full\">\n                    <span class=\"flex-shrink-0 w-7 h-7 bg-slate-800 text-white text-xs font-bold rounded-full flex items-center justify-center mt-1 sm:mt-0\">3</span>\n                    <div class=\"text-sm sm:text-base text-slate-700 w-full flex flex-col gap-2\">\n                        <span class=\"font-medium text-slate-800\">Write a third personalized sentence based on your sleep habits:</span>\n                        <input type=\"text\" data-answer=\"have insomnia\" data-alts=\"fall asleep,wake up,get back to sleep,snore,be fast asleep,be wide awake,not sleep a wink,have nightmares,be a light sleeper,be a heavy sleeper,take a nap,doze off,have a lie-in,talk in your sleep,have a dream\" class=\"interactive-input border border-slate-300 bg-white rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full\" placeholder=\"e.g., When I drink coffee late, I have insomnia...\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 w-full\">\n                    <span class=\"flex-shrink-0 w-7 h-7 bg-slate-800 text-white text-xs font-bold rounded-full flex items-center justify-center mt-1 sm:mt-0\">4</span>\n                    <div class=\"text-sm sm:text-base text-slate-700 w-full flex flex-col gap-2\">\n                        <span class=\"font-medium text-slate-800\">Write a fourth personalized sentence about someone you know:</span>\n                        <input type=\"text\" data-answer=\"light sleeper\" data-alts=\"fall asleep,wake up,get back to sleep,snore,be fast asleep,be wide awake,have insomnia,not sleep a wink,have nightmares,heavy sleeper,take a nap,doze off,have a lie-in,talk in your sleep,have a dream,a light sleeper\" class=\"interactive-input border border-slate-300 bg-white rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full\" placeholder=\"e.g., My sister is a light sleeper...\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 w-full\">\n                    <span class=\"flex-shrink-0 w-7 h-7 bg-slate-800 text-white text-xs font-bold rounded-full flex items-center justify-center mt-1 sm:mt-0\">5</span>\n                    <div class=\"text-sm sm:text-base text-slate-700 w-full flex flex-col gap-2\">\n                        <span class=\"font-medium text-slate-800\">Write a fifth personalized sentence about a night experience:</span>\n                        <input type=\"text\" data-answer=\"have nightmares\" data-alts=\"fall asleep,wake up,get back to sleep,snore,be fast asleep,be wide awake,have insomnia,not sleep a wink,be a light sleeper,be a heavy sleeper,take a nap,doze off,have a lie-in,talk in your sleep,have a dream\" class=\"interactive-input border border-slate-300 bg-white rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full\" placeholder=\"e.g., I sometimes have nightmares after scary movies...\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                <div class=\"flex items-start gap-3 w-full\">\n                    <span class=\"flex-shrink-0 w-7 h-7 bg-slate-800 text-white text-xs font-bold rounded-full flex items-center justify-center mt-1 sm:mt-0\">6</span>\n                    <div class=\"text-sm sm:text-base text-slate-700 w-full flex flex-col gap-2\">\n                        <span class=\"font-medium text-slate-800\">Write a sixth personalized sentence about weekend routines:</span>\n                        <input type=\"text\" data-answer=\"have a lie-in\" data-alts=\"fall asleep,wake up,get back to sleep,snore,be fast asleep,be wide awake,have insomnia,not sleep a wink,have nightmares,be a light sleeper,be a heavy sleeper,take a nap,doze off,talk in your sleep,have a dream\" class=\"interactive-input border border-slate-300 bg-white rounded-lg px-3 py-2 text-sm sm:text-base font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full\" placeholder=\"e.g., On Saturdays I love to have a lie-in...\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Exercise 2b Section (Moved to the end) -->\n            <div class=\"bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5 sm:p-6 mt-6\">\n                <div class=\"flex items-start gap-3\">\n                    <div class=\"p-2 bg-indigo-600 text-white rounded-xl mt-0.5\">\n                        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.99 1.99 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z\"></path></svg>\n                    </div>\n                    <div>\n                        <h3 class=\"text-base sm:text-lg font-bold text-slate-900 mb-1\">Speaking Practice</h3>\n                        <p class=\"text-sm text-slate-700\">\n                            <strong>b)</strong> Work in groups. Take turns to talk about the words/phrases you chose. Ask follow-up questions if possible.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Action Buttons Bar -->\n            <div class=\"flex items-center justify-end gap-3 pt-4\">\n                <button type=\"button\" id=\"check-btn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl transition-all shadow-sm hover:shadow active:scale-[0.98] min-h-[44px]\">\n                    Check Answers\n                </button>\n            </div>\n        </form>\n\n    </main>\n\n    <!-- Footer / Branding -->\n    <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-100 bg-white mt-auto\">\n        Interactive ELT Learning Module • Sleep Vocabulary\n    </footer>\n\n    <!-- Script Logic & Metrics Contract -->\n    <script>\n        // MANDATORY PEDAGOGICAL METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'sleep_expressions_personalization',\n            maxScore: 6\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const form = document.getElementById('activity-form');\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const currentScoreSpan = document.getElementById('current-score');\n            const inputs = form.querySelectorAll('.interactive-input');\n\n            function checkAnswers() {\n                let correctCount = 0;\n\n                inputs.forEach(input => {\n                    const userAnswer = input.value.trim().toLowerCase();\n                    const altAnswers = input.getAttribute('data-alts') ? input.getAttribute('data-alts').toLowerCase().split(',') : [];\n\n                    input.classList.remove('is-correct', 'is-wrong');\n\n                    // For open personalization sentences, checking if user wrote something meaningful containing vocabulary keywords or alternate acceptable sleep terms\n                    const containsValidTerm = altAnswers.some(term => userAnswer.includes(term.trim()));\n\n                    if (userAnswer !== \"\" && (userAnswer.length >= 3 || containsValidTerm)) {\n                        input.classList.add('is-correct');\n                        correctCount++;\n                    } else if (userAnswer !== \"\") {\n                        input.classList.add('is-wrong');\n                    }\n                });\n\n                currentScoreSpan.textContent = correctCount;\n\n                // Dispatch mandatory custom event\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                // Post message for parent frame integration\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: inputs.length\n                    }, '*');\n                }\n            }\n\n            function resetActivity() {\n                inputs.forEach(input => {\n                    input.value = \"\";\n                    input.classList.remove('is-correct', 'is-wrong');\n                });\n                currentScoreSpan.textContent = \"0\";\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: inputs.length,\n                        completed: false\n                    }\n                }));\n            }\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n        });\n    </script>\n\n</body></html>"
    },
    {
      "id": 1793575797768,
      "title": "Sleep Science - ELT Interactive Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Sleep Science - ELT Interactive Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8fafc;\n            color: #1e293b;\n        }\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY TOP AUDIO & INSTRUCTION BAR -->\n    <div id=\"audioContainer\" class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm transition-all duration-300\">\n        <div class=\"w-full max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-2.5 w-full sm:w-auto\">\n                <div class=\"bg-indigo-100 text-indigo-700 p-2 rounded-xl flex items-center justify-center\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 11.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\"></path></svg>\n                </div>\n                <div>\n                    <h1 id=\"audioStatusText\" class=\"text-sm font-semibold text-slate-800\">Exercise 3a: Choose the correct words/phrases</h1>\n                    <p id=\"audioSubText\" class=\"text-xs text-amber-600 font-medium flex items-center gap-1\">\n                        <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"></path></svg>\n                        Audio locked. Complete Exercise 3a first to unlock listening!\n                    </p>\n                </div>\n            </div>\n            <!-- AUDIO PLAYER (Locked initially via classes) -->\n            <div id=\"playerWrapper\" class=\"w-full sm:w-72 opacity-40 pointer-events-none select-none transition-all duration-300\">\n                <audio id=\"lessonAudio\" controls class=\"w-full h-10 rounded-lg\" src=\"data:audio/mpeg;base64,\"></audio>\n            </div>\n        </div>\n    </div>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- INTRO & ILLUSTRATIONS -->\n        <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 mb-6\">\n            <div class=\"flex items-center gap-3 mb-4\">\n                <span class=\"bg-indigo-600 text-white font-bold text-sm px-3 py-1 rounded-lg\">3</span>\n                <h2 class=\"text-base sm:text-lg font-bold text-slate-800\">a) Work in pairs. Look at these sentences about sleep. Choose the correct words/phrases.</h2>\n            </div>\n            \n            <!-- Student illustrations placeholder / container -->\n            <div class=\"w-full mb-6\">\n                <div class=\"bg-slate-50 border border-slate-100 p-4 rounded-xl flex justify-center items-center overflow-visible\">\n                    <img src=\"data:image/png;base64,\" alt=\"Illustrations of sleep science context\" class=\"max-h-64 md:max-h-72 w-auto mx-auto object-contain rounded-xl shadow-sm block\">\n                </div>\n            </div>\n\n            <!-- EXERCISE 3a QUESTIONS -->\n            <div id=\"exercise3a\" class=\"space-y-4\">\n                \n                <!-- Item 1 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-sm font-medium text-slate-700\">\n                        <span class=\"font-bold text-indigo-600 mr-2\">1</span>Tiredness causes \n                        <select data-answer=\"more\" class=\"inline-block mx-1 px-3 py-1.5 text-sm font-semibold bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"more\">more</option>\n                            <option value=\"less\">less</option>\n                        </select> than 50% of all road accidents in the USA.\n                    </div>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-sm font-medium text-slate-700\">\n                        <span class=\"font-bold text-indigo-600 mr-2\">2</span>\n                        <select data-answer=\"30%\" class=\"inline-block mx-1 px-3 py-1.5 text-sm font-semibold bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"10%\">10%</option>\n                            <option value=\"30%\">30%</option>\n                        </select> of people in the UK have problems getting to sleep or staying asleep.\n                    </div>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-sm font-medium text-slate-700\">\n                        <span class=\"font-bold text-indigo-600 mr-2\">3</span>Nowadays people are sleeping \n                        <select data-answer=\"one and a half hours\" class=\"inline-block mx-1 px-3 py-1.5 text-sm font-semibold bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"half an hour\">half an hour</option>\n                            <option value=\"one and a half hours\">one and a half hours</option>\n                        </select> less than they did 100 years ago.\n                    </div>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-sm font-medium text-slate-700\">\n                        <span class=\"font-bold text-indigo-600 mr-2\">4</span>Teenagers need \n                        <select data-answer=\"more\" class=\"inline-block mx-1 px-3 py-1.5 text-sm font-semibold bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"more\">more</option>\n                            <option value=\"less\">less</option>\n                        </select> sleep than adults.\n                    </div>\n                </div>\n\n                <!-- Item 5 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-sm font-medium text-slate-700\">\n                        <span class=\"font-bold text-indigo-600 mr-2\">5</span>We use \n                        <select data-answer=\"the same amount of\" class=\"inline-block mx-1 px-3 py-1.5 text-sm font-semibold bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"less\">less</option>\n                            <option value=\"the same amount of\">the same amount of</option>\n                        </select> energy when we're asleep compared to when we're resting.\n                    </div>\n                </div>\n\n                <!-- Item 6 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div class=\"text-sm font-medium text-slate-700\">\n                        <span class=\"font-bold text-indigo-600 mr-2\">6</span>A thirty-minute nap at work can improve people's performance for \n                        <select data-answer=\"a few hours\" class=\"inline-block mx-1 px-3 py-1.5 text-sm font-semibold bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"an hour\">an hour</option>\n                            <option value=\"a few hours\">a few hours</option>\n                        </select>.\n                    </div>\n                </div>\n\n            </div>\n        </section>\n\n        <!-- EXERCISE 3c: LISTENING COMPREHENSION OPEN QUESTIONS -->\n        <section id=\"exercise3cSection\" class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 mb-6 transition-all duration-300 opacity-60 pointer-events-none\">\n            <div class=\"flex items-center gap-3 mb-4\">\n                <span class=\"bg-slate-700 text-white font-bold text-sm px-3 py-1 rounded-lg\">c</span>\n                <div>\n                    <h2 class=\"text-base sm:text-lg font-bold text-slate-800\">Listen again. Answer these questions.</h2>\n                    <p id=\"cStatusMsg\" class=\"text-xs text-amber-600 font-medium\">Complete and check Exercise 3a to unlock these questions!</p>\n                </div>\n            </div>\n\n            <div id=\"exercise3cInputs\" class=\"space-y-4\">\n                <!-- Q1 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                    <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">\n                        <span class=\"font-bold text-slate-800 mr-2\">1</span>How many British people have serious insomnia?\n                    </label>\n                    <input type=\"text\" data-answer=\"10%\" data-alt=\"10 percent\" placeholder=\"Type your answer...\" class=\"w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                </div>\n\n                <!-- Q2 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                    <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">\n                        <span class=\"font-bold text-slate-800 mr-2\">2</span>How were sleeping habits different 100 years ago?\n                    </label>\n                    <input type=\"text\" data-answer=\"People went to sleep when it got dark and got up when it got light\" data-alt=\"went to sleep when it got dark and got up when it got light\" placeholder=\"Type your answer...\" class=\"w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                </div>\n\n                <!-- Q3 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                    <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">\n                        <span class=\"font-bold text-slate-800 mr-2\">3</span>Who needs the least amount of sleep?\n                    </label>\n                    <input type=\"text\" data-answer=\"Older people\" data-alt=\"older people\" placeholder=\"Type your answer...\" class=\"w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                </div>\n\n                <!-- Q4 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                    <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">\n                        <span class=\"font-bold text-slate-800 mr-2\">4</span>What do our brains do when we're asleep?\n                    </label>\n                    <input type=\"text\" data-answer=\"They organise information they've collected during the day\" data-alt=\"organise information they have collected during the day,organise information collected during the day\" placeholder=\"Type your answer...\" class=\"w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                </div>\n\n                <!-- Q5 -->\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                    <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">\n                        <span class=\"font-bold text-slate-800 mr-2\">5</span>What is a siesta salon?\n                    </label>\n                    <input type=\"text\" data-answer=\"A place where you can go for a quick nap during the day\" data-alt=\"a place where you can go for a quick nap during the day,place for a quick nap during the day\" placeholder=\"Type your answer...\" class=\"w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500\">\n                </div>\n            </div>\n        </section>\n\n        <!-- ACTION CONTROLS & SCORE -->\n        <div class=\"flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-5 rounded-2xl shadow-sm border border-slate-200 mb-8\">\n            <div class=\"flex items-center gap-3 w-full sm:w-auto justify-center sm:justify-start\">\n                <button id=\"checkBtn\" onclick=\"checkAnswers()\" class=\"w-full sm:w-auto px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all flex items-center justify-center gap-2 min-h-[44px]\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    Check Answers\n                </button>\n                <button id=\"resetBtn\" onclick=\"resetActivity()\" class=\"w-full sm:w-auto px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-xl transition-all flex items-center justify-center gap-2 min-h-[44px]\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    Reset\n                </button>\n            </div>\n            <div id=\"scoreDisplay\" class=\"text-sm font-bold text-slate-700 bg-slate-50 px-4 py-2.5 rounded-xl border border-slate-200 w-full sm:w-auto text-center\">\n                Score: <span id=\"correctCount\">0</span> / <span id=\"totalCount\">11</span>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500\">\n        Interactive ELT Activity &bull; Designed for Responsive Touch Interfaces\n    </footer>\n\n    <!-- SCRIPT LOGIC & METRICS -->\n    <script>\n        // MANDATORY PEDAGOGICAL METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Listening',\n            skill: 'sleep_science_facts_and_comprehension',\n            maxScore: 11\n        };\n\n        function normalizeText(txt) {\n            if (!txt) return '';\n            return txt.toLowerCase().replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\").replace(/\\s+/g,\" \").trim();\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            \n            // Check Exercise 3a (Selects)\n            const selects = document.querySelectorAll('#exercise3a select');\n            let ex3aAllCorrect = true;\n            selects.forEach(sel => {\n                const userVal = sel.value.trim();\n                const correctVal = sel.getAttribute('data-answer');\n                if (userVal === correctVal) {\n                    sel.classList.remove('is-wrong');\n                    sel.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    sel.classList.remove('is-correct');\n                    sel.classList.add('is-wrong');\n                    ex3aAllCorrect = false;\n                }\n            });\n\n            // Check Exercise 3c (Inputs)\n            const inputs = document.querySelectorAll('#exercise3cInputs input');\n            inputs.forEach(inp => {\n                const userVal = normalizeText(inp.value);\n                const correctVal = normalizeText(inp.getAttribute('data-answer'));\n                const alts = inp.getAttribute('data-alt') ? inp.getAttribute('data-alt').split(',').map(a => normalizeText(a)) : [];\n                \n                if (userVal === correctVal || alts.includes(userVal)) {\n                    inp.classList.remove('is-wrong');\n                    inp.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    inp.classList.remove('is-correct');\n                    inp.classList.add('is-wrong');\n                }\n            });\n\n            const total = selects.length + inputs.length;\n            document.getElementById('correctCount').innerText = correctCount;\n            document.getElementById('totalCount').innerText = total;\n\n            // UNLOCK LISTENING & EXERCISE 3c IF 3a IS COMPLETED/CHECKED\n            if (ex3aAllCorrect) {\n                // Unlock Audio Player in sticky header\n                const audioWrapper = document.getElementById('playerWrapper');\n                audioWrapper.classList.remove('opacity-40', 'pointer-events-none', 'select-none');\n                \n                document.getElementById('audioStatusText').innerText = \"Exercise 3a Checked Successfully!\";\n                document.getElementById('audioSubText').innerHTML = '<svg class=\"w-3.5 h-3.5 text-emerald-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg> 🎧 Now listen to R2.6 and check your answers / complete Ex. 3c';\n                document.getElementById('audioSubText').className = \"text-xs text-emerald-600 font-semibold flex items-center gap-1\";\n\n                // Unlock Exercise 3c section\n                const ex3cSec = document.getElementById('exercise3cSection');\n                ex3cSec.classList.remove('opacity-60', 'pointer-events-none');\n                document.getElementById('cStatusMsg').innerText = \"🎧 Listen to the audio and answer questions 1-5.\";\n                document.getElementById('cStatusMsg').className = \"text-xs text-emerald-600 font-semibold\";\n            }\n\n            // DISPATCH REQUIRED METRICS EVENTS\n            const isCompleted = (correctCount === total);\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: total,\n                    completed: isCompleted\n                }\n            }));\n\n            // PostMessage for iframe integrations\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: total,\n                    completed: isCompleted\n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            // Reset Selects\n            const selects = document.querySelectorAll('#exercise3a select');\n            selects.forEach(sel => {\n                sel.value = \"\";\n                sel.classList.remove('is-correct', 'is-wrong');\n            });\n\n            // Reset Inputs\n            const inputs = document.querySelectorAll('#exercise3cInputs input');\n            inputs.forEach(inp => {\n                inp.value = \"\";\n                inp.classList.remove('is-correct', 'is-wrong');\n            });\n\n            // Re-lock audio and 3c\n            const audioWrapper = document.getElementById('playerWrapper');\n            audioWrapper.classList.add('opacity-40', 'pointer-events-none', 'select-none');\n            \n            document.getElementById('audioStatusText').innerText = \"Exercise 3a: Choose the correct words/phrases\";\n            document.getElementById('audioSubText').innerHTML = '<svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"></path></svg> Audio locked. Complete Exercise 3a first to unlock listening!';\n            document.getElementById('audioSubText').className = \"text-xs text-amber-600 font-medium flex items-center gap-1\";\n\n            const ex3cSec = document.getElementById('exercise3cSection');\n            ex3cSec.classList.add('opacity-60', 'pointer-events-none');\n            document.getElementById('cStatusMsg').innerText = \"Complete and check Exercise 3a to unlock these questions!\";\n            document.getElementById('cStatusMsg').className = \"text-xs text-amber-600 font-medium\";\n\n            // Stop audio if playing\n            const audio = document.getElementById('lessonAudio');\n            audio.pause();\n            audio.currentTime = 0;\n\n            document.getElementById('correctCount').innerText = \"0\";\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793576290323,
      "title": "Reading and Vocabulary - I just can't sleep!",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Reading and Vocabulary - I just can't sleep!</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .transition-all { transition: all 0.2s ease-in-out; }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen py-6 px-3 sm:px-6\">\n\n  <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden\">\n    \n    <!-- Header -->\n    <header class=\"bg-slate-900 text-white p-6 sm:p-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n      <div>\n        <div class=\"flex items-center gap-2 text-indigo-400 text-sm font-semibold uppercase tracking-wider mb-1\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"/></svg>\n          Reading and Vocabulary\n        </div>\n        <h1 class=\"text-2xl sm:text-3xl font-bold tracking-tight\">I just can't sleep!</h1>\n      </div>\n      <div class=\"bg-slate-800 border border-slate-700 px-4 py-2 rounded-xl flex items-center gap-3\">\n        <span class=\"text-xs text-slate-400 uppercase font-medium\">Score:</span>\n        <span id=\"score-display\" class=\"text-lg font-bold text-emerald-400\">0 / 2</span>\n      </div>\n    </header>\n\n    <div class=\"p-4 sm:p-8 space-y-8\">\n\n      <!-- Reading Article Section (Accordion for mobile friendliness) -->\n      <section class=\"border border-indigo-100 bg-indigo-50/40 rounded-xl p-4 sm:p-6\">\n        <details open class=\"group\">\n          <summary class=\"flex justify-between items-center font-semibold text-indigo-900 cursor-pointer list-none select-none text-base sm:text-lg\">\n            <span class=\"flex items-center gap-2\">\n              <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z\"/></svg>\n              Read the Article: \"I just can't sleep!\"\n            </span>\n            <span class=\"transition group-open:rotate-180 text-indigo-600\">\n              <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"/></svg>\n            </span>\n          </summary>\n          \n          <div class=\"mt-4 pt-4 border-t border-indigo-100 text-slate-700 text-sm sm:text-base leading-relaxed space-y-4\">\n            <p class=\"font-medium text-slate-900 italic\">Emma talks about how her stressful life has made getting a good night's sleep impossible.</p>\n            \n            <p>Last night I was fast asleep by 11 p.m., but I woke up again at 1 a.m. Even though I was <strong>exhausted</strong> when I went to bed, I was suddenly wide awake and it was <strong>impossible</strong> to get back to sleep again. So I just lay there watching the clock change from three to four to five without sleeping a wink – it was <strong>very</strong> frustrating. Finally, I got up at 6.15 and went off to work feeling <strong>terrible</strong>. That's a typical night for me. I've had insomnia for so long I'm <strong>amazed</strong> that anyone else actually sleeps through the night. And when this goes on for too many nights I feel <strong>really</strong> shattered.</p>\n            \n            <p>I'm a sales manager, and I work <strong>really</strong> long hours and have to do a lot of travelling. I worry about work all the time, which makes it <strong>incredibly</strong> difficult to get to sleep. Sometimes I get home from work <strong>extremely</strong> late and when I go to bed everything is still going round my head. Money's also a <strong>huge</strong> worry for me. I borrowed a lot when I was a student and I still owe £15,000. I only get a full night's sleep once a month – but when I do I feel <strong>absolutely</strong> fantastic the next day.</p>\n            \n            <p>I've tried nearly everything to cure my insomnia – herbal teas, yoga, meditation – you name it, I've tried it. I've also started going to the gym three times a week, but it hasn't made any difference. I have a <strong>fairly</strong> healthy diet and I don't smoke or drink coffee. I haven't tried hypnosis because it's very expensive and that would just add to my money worries. I don't want to start taking sleeping pills because I'm <strong>terrified</strong> of becoming addicted to them. Although I know it's an <strong>awful</strong> way to live, I've learned to accept that insomnia is part of my life.</p>\n            <p class=\"text-xs text-slate-500 italic text-right\">Adapted from the Evening Standard 3/12/02</p>\n          </div>\n        </details>\n      </section>\n\n      <!-- Comprehension Questions Section based on OCR Reference -->\n      <section class=\"space-y-6\">\n        <div class=\"border-b border-slate-200 pb-3\">\n          <h2 class=\"text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <span class=\"bg-slate-900 text-white w-7 h-7 rounded-full inline-flex items-center justify-center text-sm\">5b</span>\n            Reading Comprehension\n          </h2>\n          <p class=\"text-sm text-slate-600 mt-1\">Answer the questions based on the article above.</p>\n        </div>\n\n        <div class=\"space-y-6\">\n          <!-- Question 1 -->\n          <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm space-y-3\">\n            <label for=\"q1-input\" class=\"block font-semibold text-slate-800 text-sm sm:text-base\">\n              1. Why does Emma have insomnia?\n            </label>\n            <p class=\"text-xs text-slate-500\">Tip: Refer to her thoughts about work and personal responsibilities.</p>\n            <textarea id=\"q1-input\" rows=\"2\" \n              data-answer=\"she worries about work all the time\" \n              class=\"w-full p-3 border border-slate-300 rounded-lg text-sm sm:text-base focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all resize-none\"\n              placeholder=\"Type your answer here...\"></textarea>\n          </div>\n\n          <!-- Question 2 -->\n          <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm space-y-3\">\n            <label for=\"q2-input\" class=\"block font-semibold text-slate-800 text-sm sm:text-base\">\n              2. What has she tried to do to get a good night's sleep?\n            </label>\n            <p class=\"text-xs text-slate-500\">Tip: Mention specific activities or treatments she tested in the final section.</p>\n            <textarea id=\"q2-input\" rows=\"2\" \n              data-answer=\"herbal teas, yoga, meditation and going to the gym\" \n              class=\"w-full p-3 border border-slate-300 rounded-lg text-sm sm:text-base focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all resize-none\"\n              placeholder=\"Type your answer here...\"></textarea>\n          </div>\n        </div>\n      </section>\n\n      <!-- Action Buttons -->\n      <div class=\"flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-200\">\n        <button id=\"reset-btn\" class=\"w-full sm:w-auto px-6 py-3 border border-slate-300 hover:bg-slate-100 text-slate-700 font-medium rounded-xl transition-all min-h-[44px]\">\n          Reset Activity\n        </button>\n        <button id=\"check-btn\" class=\"w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-md transition-all min-h-[44px]\">\n          Check Answers\n        </button>\n      </div>\n\n    </div>\n  </main>\n\n  <script>\n    // Mandatory Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Reading',\n      skill: 'reading_for_detail',\n      maxScore: 2\n    };\n\n    function normalize(text) {\n      return text\n        .toLowerCase()\n        .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g, \"\")\n        .replace(/\\s{2,}/g, \" \")\n        .trim();\n    }\n\n    const checkBtn = document.getElementById('check-btn');\n    const resetBtn = document.getElementById('reset-btn');\n    const scoreDisplay = document.getElementById('score-display');\n\n    checkBtn.addEventListener('click', () => {\n      const inputs = [\n        document.getElementById('q1-input'),\n        document.getElementById('q2-input')\n      ];\n\n      let correctCount = 0;\n\n      inputs.forEach(input => {\n        const userVal = normalize(input.value);\n        const expectedAnswers = input.getAttribute('data-answer').toLowerCase().split(' and ');\n        \n        // Simple flexible evaluation\n        let isCorrect = false;\n        if (input.id === 'q1-input') {\n          if (userVal.includes('worries about work') || userVal.includes('worry about work')) {\n            isCorrect = true;\n          }\n        } else if (input.id === 'q2-input') {\n          // Check if at least 2 or 3 mentioned methods are present\n          const methods = ['herbal teas', 'yoga', 'meditation', 'gym'];\n          const matchedMethods = methods.filter(m => userVal.includes(m));\n          if (matchedMethods.length >= 2 || userVal.includes('herbal teas') && userVal.includes('yoga')) {\n            isCorrect = true;\n          }\n        }\n\n        // Fallback exact match or subset match\n        if (!isCorrect && (userVal === normalize(input.getAttribute('data-answer')) || userVal.includes(normalize(input.getAttribute('data-answer'))))) {\n          isCorrect = true;\n        }\n\n        input.classList.remove('border-slate-300', 'border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n        \n        if (isCorrect && userVal !== \"\") {\n          input.classList.add('border-emerald-500', 'bg-emerald-50');\n          correctCount++;\n        } else {\n          input.classList.add('border-rose-500', 'bg-rose-50');\n        }\n      });\n\n      scoreDisplay.textContent = `${correctCount} / ${inputs.length}`;\n\n      // Dispatch Custom Event for platform integration\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: inputs.length,\n          completed: correctCount === inputs.length\n        }\n      }));\n\n      // Post message for iframe environments\n      if (window.parent && window.parent !== window) {\n        window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: inputs.length }, '*');\n      }\n    });\n\n    resetBtn.addEventListener('click', () => {\n      const inputs = [\n        document.getElementById('q1-input'),\n        document.getElementById('q2-input')\n      ];\n\n      inputs.forEach(input => {\n        input.value = '';\n        input.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n        input.classList.add('border-slate-300');\n      });\n\n      scoreDisplay.textContent = `0 / ${inputs.length}`;\n\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: 0,\n          total: inputs.length,\n          completed: false\n        }\n      }));\n    });\n  </script>\n\n</body>\n</html>"
    },
    {
      "id": 1793576604907,
      "title": "I Just Can't Sleep! - Reading Comprehension",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>I Just Can't Sleep! - Reading Comprehension</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 6px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: #f1f5f9;\n            border-radius: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: #cbd5e1;\n            border-radius: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n            background: #94a3b8;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Top Header / Score Bar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 sm:px-8 border-b border-slate-200 shadow-sm w-full\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm flex items-center justify-center\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"/></svg>\n                </div>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">I just can't sleep!</h1>\n                    <p class=\"text-xs text-slate-500\">Reading Comprehension & Analysis</p>\n                </div>\n            </div>\n\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-xl text-sm font-medium text-slate-700 flex items-center space-x-2 shadow-inner\">\n                    <span>Score:</span>\n                    <span id=\"score-display\" class=\"font-bold text-indigo-600 text-base\">0 / 5</span>\n                </div>\n                <button id=\"reset-btn\" class=\"bg-slate-100 hover:bg-slate-200 text-slate-700 p-2 rounded-xl transition text-sm font-medium flex items-center space-x-1 cursor-pointer\" title=\"Reset Activity\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\n                    <span class=\"hidden sm:inline\">Reset</span>\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-4\">\n        \n        <!-- Student Photo & Intro Card -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm mb-6\">\n            <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-center\">\n                <div class=\"md:col-span-5 flex justify-center items-center overflow-visible\">\n                    <img src=\"data:image/png;base64,\" alt=\"Emma in her room\" class=\"max-h-64 md:max-h-72 w-auto mx-auto object-contain rounded-xl shadow-sm block border border-slate-100\">\n                </div>\n                <div class=\"md:col-span-7 space-y-3\">\n                    <div class=\"inline-flex items-center space-x-1.5 bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider\">\n                        <svg class=\"w-3.5 h-3.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z\"/></svg>\n                        <span>Reading Unit</span>\n                    </div>\n                    <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight\">I just can't sleep!</h2>\n                    <p class=\"text-sm text-slate-600 leading-relaxed\">\n                        Emma talks about how her stressful life has made getting a good night's sleep impossible. Read the article below carefully and answer the comprehension questions based on her testimony.\n                    </p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Reading Text Accordion -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm mb-6 overflow-hidden\">\n            <details open class=\"group\">\n                <summary class=\"bg-slate-50 hover:bg-slate-100 px-5 py-4 cursor-pointer font-semibold text-slate-800 flex items-center justify-between transition border-b border-slate-200\">\n                    <div class=\"flex items-center space-x-2\">\n                        <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"/></svg>\n                        <span>Read the Article: \"I just can't sleep!\"</span>\n                    </div>\n                    <span class=\"text-xs text-indigo-600 font-medium group-open:rotate-180 transition-transform\">▼ Toggle text</span>\n                </summary>\n                <div class=\"p-5 sm:p-6 text-sm sm:text-base text-slate-700 space-y-4 leading-relaxed bg-white max-h-96 overflow-y-auto custom-scrollbar\">\n                    <p>\n                        Last night I was fast asleep by 11 p.m., but I woke up again at 1 a.m. Even though I was <strong>exhausted</strong> when I went to bed, I was suddenly wide awake and it was <strong>impossible</strong> to get back to sleep again. So I just lay there watching the clock change from three to four to five without sleeping a wink – it was <strong>very</strong> frustrating. Finally, I got up at 6.15 and went off to work feeling <strong>terrible</strong>. That’s a typical night for me. I’ve had insomnia for so long I’m <strong>amazed</strong> that anyone else actually sleeps through the night. And when this goes on for too many nights I feel <strong>really</strong> shattered.\n                    </p>\n                    <p>\n                        I’m a sales manager, and I work <strong>really</strong> long hours and have to do a lot of travelling. I worry about work all the time, which makes it <strong>incredibly</strong> difficult to get to sleep. Sometimes I get home from work <strong>extremely</strong> late and when I go to bed everything is still going round my head. Money’s also a <strong>huge</strong> worry for me. I borrowed a lot when I was a student and I still owe £15,000. I only get a full night’s sleep once a month – but when I do I feel <strong>absolutely</strong> fantastic the next day.\n                    </p>\n                    <p>\n                        I’ve tried nearly everything to cure my insomnia – herbal teas, yoga, meditation – you name it, I’ve tried it. I’ve also started going to the gym three times a week, but it hasn’t made any difference. I have a <strong>fairly</strong> healthy diet and I don’t smoke or drink coffee. I haven’t tried hypnosis because it’s very expensive and that would just add to my money worries. I don’t want to start taking sleeping pills because I’m <strong>terrified</strong> of becoming addicted to them. Although I know it’s an <strong>awful</strong> way to live, I’ve learned to accept that insomnia is part of my life.\n                    </p>\n                    <p class=\"text-xs text-slate-400 italic pt-2 border-t border-slate-100\">Adapted from the Evening Standard 3/12/02</p>\n                </div>\n            </details>\n        </section>\n\n        <!-- Questions Section -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm mb-6\">\n            <h3 class=\"text-lg font-bold text-slate-900 mb-4 flex items-center space-x-2\">\n                <span class=\"bg-indigo-600 text-white w-7 h-7 rounded-lg flex items-center justify-center text-sm\">a</span>\n                <span>Comprehension Questions</span>\n            </h3>\n            <p class=\"text-sm text-slate-600 mb-5\">Read the article again and answer the questions below based on the text. Write your answers clearly.</p>\n\n            <div class=\"space-y-6\">\n                \n                <!-- Question 1 -->\n                <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl transition-all hover:border-slate-300\">\n                    <label for=\"q1\" class=\"block text-sm font-semibold text-slate-800 mb-2\">\n                        <span class=\"text-indigo-600 font-bold mr-1.5\">1.</span> How much sleep did Emma get last night?\n                    </label>\n                    <div class=\"relative\">\n                        <input type=\"text\" id=\"q1\" data-answer=\"two hours\" class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition\" placeholder=\"Type your answer here...\">\n                    </div>\n                </div>\n\n                <!-- Question 2 -->\n                <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl transition-all hover:border-slate-300\">\n                    <label for=\"q2\" class=\"block text-sm font-semibold text-slate-800 mb-2\">\n                        <span class=\"text-indigo-600 font-bold mr-1.5\">2.</span> What happens on a typical night?\n                    </label>\n                    <div class=\"relative\">\n                        <input type=\"text\" id=\"q2\" data-answer=\"she falls asleep by 11 p.m. but wakes up at 1 a.m. and cannot sleep again\" class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition\" placeholder=\"Type your answer here...\">\n                    </div>\n                </div>\n\n                <!-- Question 3 -->\n                <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl transition-all hover:border-slate-300\">\n                    <label for=\"q3\" class=\"block text-sm font-semibold text-slate-800 mb-2\">\n                        <span class=\"text-indigo-600 font-bold mr-1.5\">3.</span> Why is her job very tiring?\n                    </label>\n                    <div class=\"relative\">\n                        <input type=\"text\" id=\"q3\" data-answer=\"she works long hours and travels a lot\" class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition\" placeholder=\"Type your answer here...\">\n                    </div>\n                </div>\n\n                <!-- Question 4 -->\n                <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl transition-all hover:border-slate-300\">\n                    <label for=\"q4\" class=\"block text-sm font-semibold text-slate-800 mb-2\">\n                        <span class=\"text-indigo-600 font-bold mr-1.5\">4.</span> Why does she have money problems?\n                    </label>\n                    <div class=\"relative\">\n                        <input type=\"text\" id=\"q4\" data-answer=\"she borrowed a lot when she was a student and owes £15,000\" class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition\" placeholder=\"Type your answer here...\">\n                    </div>\n                </div>\n\n                <!-- Question 5 -->\n                <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl transition-all hover:border-slate-300\">\n                    <label for=\"q5\" class=\"block text-sm font-semibold text-slate-800 mb-2\">\n                        <span class=\"text-indigo-600 font-bold mr-1.5\">5.</span> Which cures for insomnia hasn't she tried? Why not?\n                    </label>\n                    <div class=\"relative\">\n                        <input type=\"text\" id=\"q5\" data-answer=\"hypnosis and sleeping pills because hypnosis is expensive and she is terrified of becoming addicted to pills\" class=\"w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition\" placeholder=\"Type your answer here...\">\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"mt-8 flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100\">\n                <button id=\"check-btn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-sm transition flex items-center justify-center space-x-2 cursor-pointer min-h-[44px]\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"/></svg>\n                    <span>Check Answers</span>\n                </button>\n                <div id=\"feedback-message\" class=\"text-sm font-medium text-slate-600 hidden\"></div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-slate-200 py-4 px-6 text-center text-xs text-slate-500\">\n        Interactive English Learning Tool &bull; Reading Comprehension Module\n    </footer>\n\n    <!-- Script Logic & Metrics Contract -->\n    <script>\n        // OBLIGATORY METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Reading',\n            skill: 'reading_for_detail',\n            maxScore: 5\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const scoreDisplay = document.getElementById('score-display');\n            const feedbackMessage = document.getElementById('feedback-message');\n            const inputs = document.querySelectorAll('input[type=\"text\"][data-answer]');\n\n            // Normalization helper for flexible checking\n            function normalize(text) {\n                return text.toLowerCase()\n                    .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()£]/g, \"\")\n                    .replace(/\\s+/g, \" \")\n                    .trim();\n            }\n\n            // Keyword validation logic for short descriptive answers\n            function validateAnswer(userText, expectedText, questionId) {\n                const u = normalize(userText);\n                if (!u) return false;\n\n                if (questionId === 'q1') {\n                    return u.includes('two') || u.includes('2') || u.includes('sleep from 11');\n                }\n                if (questionId === 'q2') {\n                    return (u.includes('11') || u.includes('eleven')) && (u.includes('1') || u.includes('one'));\n                }\n                if (questionId === 'q3') {\n                    return (u.includes('long hour') || u.includes('work') || u.includes('travell'));\n                }\n                if (questionId === 'q4') {\n                    return (u.includes('borrow') || u.includes('owe') || u.includes('15000') || u.includes('student'));\n                }\n                if (questionId === 'q5') {\n                    return (u.includes('hypnos') || u.includes('pill')) && (u.includes('expens') || u.includes('addict') || u.includes('fear') || u.includes('terrifi'));\n                }\n\n                // Fallback direct check\n                const keywords = expectedText.toLowerCase().split(' ').filter(w => w.length > 3);\n                let matched = 0;\n                keywords.forEach(kw => {\n                    if (u.includes(kw)) matched++;\n                });\n                return matched >= Math.ceil(keywords.length * 0.4);\n            }\n\n            function checkAnswers() {\n                let correctCount = 0;\n\n                inputs.forEach((input, index) => {\n                    const qId = input.id;\n                    const expected = input.getAttribute('data-answer');\n                    const isCorrect = validateAnswer(input.value, expected, qId);\n\n                    input.classList.remove('border-slate-300', 'border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n                    \n                    if (isCorrect) {\n                        input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n                        correctCount++;\n                    } else {\n                        input.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n                    }\n                });\n\n                scoreDisplay.textContent = `${correctCount} / ${inputs.length}`;\n                feedbackMessage.textContent = correctCount === inputs.length ? '🎉 Excellent! All answers are correct!' : 'Some answers need review. Check highlighted fields.';\n                feedbackMessage.classList.remove('hidden');\n\n                // Dispatch global ELT event\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                // Post message for parent frame integration\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: inputs.length\n                    }, '*');\n                }\n            }\n\n            function resetActivity() {\n                inputs.forEach(input => {\n                    input.value = '';\n                    input.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50', 'text-emerald-900', 'text-rose-900');\n                    input.classList.add('border-slate-300');\n                });\n                scoreDisplay.textContent = `0 / ${inputs.length}`;\n                feedbackMessage.classList.add('hidden');\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: inputs.length,\n                        completed: false\n                    }\n                }));\n            }\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793576798042,
      "title": "I just can't sleep! - Gradable & Strong Adjectives",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>I just can't sleep! - Gradable & Strong Adjectives</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom scrollbar and interactive feedback */\n        .highlight-pink { background-color: #fbcfe8; color: #831843; padding: 0.1rem 0.3rem; border-radius: 0.25rem; font-weight: 500; }\n        .highlight-blue { background-color: #bae6fd; color: #0369a1; padding: 0.1rem 0.3rem; border-radius: 0.25rem; font-weight: 500; }\n        \n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n        \n        /* Smooth transitions */\n        .transition-all {\n            transition: all 0.2s ease-in-out;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header with Score & Title -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur-md z-30 py-3 px-4 sm:px-6 border-b border-slate-200 shadow-sm w-full\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-inner\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </div>\n                <div>\n                    <h1 class=\"text-lg font-bold text-slate-900 leading-tight\">I just can't sleep!</h1>\n                    <p class=\"text-xs text-slate-500\">Vocabulary: Gradable & Strong Adjectives & Adverbs</p>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center gap-3 w-full sm:w-auto justify-end\">\n                <div class=\"bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-xl text-sm font-semibold flex items-center gap-2\">\n                    <span class=\"text-slate-500\">Score:</span>\n                    <span id=\"score-display\" class=\"text-indigo-600\">0 / 22</span>\n                </div>\n                <button onclick=\"resetActivity()\" title=\"Reset Activity\" class=\"p-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl transition active:scale-95 flex items-center gap-1 text-xs font-medium\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" stroke-height=\"2.5\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    <span class=\"hidden md:inline\">Reset</span>\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 my-6 bg-white border border-slate-200 rounded-2xl shadow-sm space-y-8 flex-grow\">\n\n        <!-- Section 1: Reading Text with highlighted clues -->\n        <section aria-labelledby=\"reading-heading\" class=\"space-y-4\">\n            <div class=\"flex items-center justify-between border-b pb-3\">\n                <h2 id=\"reading-heading\" class=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n                    <span class=\"bg-indigo-100 text-indigo-700 w-7 h-7 rounded-lg inline-flex items-center justify-center text-sm\">1</span>\n                    Reading: Emma's Insomnia Story\n                </h2>\n                <span class=\"text-xs font-medium px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg border border-amber-200\">\n                    💡 Notice the <span class=\"highlight-pink\">pink</span> (strong adjectives) and <span class=\"highlight-blue\">blue</span> (adverbs) highlights!\n                </span>\n            </div>\n\n            <!-- Reading collapsible box -->\n            <details class=\"group bg-slate-50 border border-slate-200 rounded-xl overflow-hidden\" open>\n                <summary class=\"px-4 py-3 font-medium text-sm text-slate-700 cursor-pointer bg-slate-100 hover:bg-slate-200 transition flex justify-between items-center select-none\">\n                    <span>📖 Read the article (Click to collapse/expand)</span>\n                    <span class=\"text-xs text-slate-500 group-open:rotate-180 transition-transform\">▼</span>\n                </summary>\n                <div class=\"p-4 sm:p-6 text-sm sm:text-base leading-relaxed space-y-4 text-slate-700\">\n                    <p>Last night I was fast asleep by 11 p.m., but I woke up again at 1 a.m. Even though I was <span class=\"highlight-pink\" title=\"Strong adjective\">exhausted</span> when I went to bed, I was suddenly wide awake and it was <span class=\"highlight-pink\" title=\"Strong adjective\">impossible</span> to get back to sleep again. So I just lay there watching the clock change from three to four to five without sleeping a wink – it was <span class=\"highlight-blue\" title=\"Adverb\">very</span> frustrating. Finally, I got up at 6.15 and went off to work feeling <span class=\"highlight-pink\" title=\"Strong adjective\">terrible</span>. That’s a typical night for me. I’ve had insomnia for so long I’m <span class=\"highlight-pink\" title=\"Strong adjective\">amazed</span> that anyone else actually sleeps through the night. And when this goes on for too many nights I feel <span class=\"highlight-blue\" title=\"Adverb\">really</span> <span class=\"highlight-pink\" title=\"Strong adjective\">shattered</span>.</p>\n                    \n                    <p>I’m a sales manager, and I work <span class=\"highlight-blue\" title=\"Adverb\">really</span> long hours and have to do a lot of travelling. I worry about work all the time, which makes it <span class=\"highlight-blue\" title=\"Adverb\">incredibly</span> difficult to get to sleep. Sometimes I get home from work <span class=\"highlight-blue\" title=\"Adverb\">extremely</span> late and when I go to bed everything is still going round my head. Money’s also a <span class=\"highlight-pink\" title=\"Strong adjective\">huge</span> worry for me. I borrowed a lot when I was a student and I still owe £15,000. I only get a full night’s sleep once a month – but when I do I feel <span class=\"highlight-blue\" title=\"Adverb\">absolutely</span> <span class=\"highlight-pink\" title=\"Strong adjective\">fantastic</span> the next day.</p>\n                    \n                    <p>I’ve tried nearly everything to cure my insomnia – herbal teas, yoga, meditation – you name it, I’ve tried it. I’ve also started going to the gym three times a week, but it hasn’t made any difference. I have a <span class=\"highlight-blue\" title=\"Adverb\">fairly</span> healthy diet and I don’t smoke or drink coffee. I haven’t tried hypnosis because it’s very expensive and that would just add to my money worries. I don’t want to start taking sleeping pills because I’m <span class=\"highlight-pink\" title=\"Strong adjective\">terrified</span> of becoming addicted to them. Although I know it’s an <span class=\"highlight-pink\" title=\"Strong adjective\">awful</span> way to live, I’ve learned to accept that insomnia is part of my life.</p>\n                    <p class=\"text-xs text-slate-400 italic pt-2\">Adapted from the Evening Standard 3/12/02</p>\n                </div>\n            </details>\n        </section>\n\n        <!-- Section 2: Complete the table (Task 7a) -->\n        <section aria-labelledby=\"vocab-table-heading\" class=\"space-y-4 pt-4 border-t border-slate-100\">\n            <div class=\"border-b pb-3\">\n                <h2 id=\"vocab-table-heading\" class=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n                    <span class=\"bg-indigo-100 text-indigo-700 w-7 h-7 rounded-lg inline-flex items-center justify-center text-sm\">7a</span>\n                    Complete the table with the strong adjectives in pink in the article\n                </h2>\n                <p class=\"text-xs text-slate-500 mt-1\">Type the corresponding strong adjective for each gradable adjective based on the text.</p>\n            </div>\n\n            <div class=\"overflow-x-auto\">\n                <table class=\"w-full text-left border-collapse text-sm sm:text-base\">\n                    <thead>\n                        <tr class=\"bg-slate-100 text-slate-700 border-b border-slate-200\">\n                            <th class=\"p-3 font-semibold rounded-tl-xl w-1/2\">Gradable Adjectives</th>\n                            <th class=\"p-3 font-semibold rounded-tr-xl w-1/2\">Strong Adjectives</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"divide-y divide-slate-100\">\n                        <tr>\n                            <td class=\"p-3 text-slate-700 font-medium\">1. tired</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"exhausted\" placeholder=\"e.g. exhausted\" class=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 text-slate-700 font-medium\">2. bad</td>\n                            <td class=\"p-3 space-y-2\">\n                                <input type=\"text\" data-answer=\"terrible\" placeholder=\"First strong adj.\" class=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                                <input type=\"text\" data-answer=\"awful\" placeholder=\"Second strong adj.\" class=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 text-slate-700 font-medium\">3. good</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"fantastic\" placeholder=\"e.g. fantastic\" class=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 text-slate-700 font-medium\">4. big</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"huge\" placeholder=\"e.g. huge\" class=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 text-slate-700 font-medium\">5. difficult</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"impossible\" placeholder=\"e.g. impossible\" class=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 text-slate-700 font-medium\">6. frightened</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"terrified\" placeholder=\"e.g. terrified\" class=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 text-slate-700 font-medium\">7. surprised</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"amazed\" placeholder=\"e.g. amazed\" class=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </section>\n\n        <!-- Section 3: Match gradable to strong adjectives (Task 7b) -->\n        <section aria-labelledby=\"match-heading\" class=\"space-y-4 pt-4 border-t border-slate-100\">\n            <div class=\"border-b pb-3\">\n                <h2 id=\"match-heading\" class=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n                    <span class=\"bg-indigo-100 text-indigo-700 w-7 h-7 rounded-lg inline-flex items-center justify-center text-sm\">7b</span>\n                    Match the gradable adjectives in A to the strong adjectives in B\n                </h2>\n                <p class=\"text-xs text-slate-500 mt-1\">Select the correct strong adjective from column B for each gradable word.</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200\">\n                <div class=\"bg-white p-3 rounded-lg border shadow-sm\">\n                    <h3 class=\"font-bold text-xs text-indigo-600 uppercase tracking-wider mb-2\">Column A (Gradable)</h3>\n                    <div class=\"flex flex-wrap gap-2 text-xs font-semibold text-slate-700\">\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">tasty</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">small</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">cold</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">hot</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">beautiful</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">big</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">interested</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">angry</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">happy</span>\n                        <span class=\"px-2 py-1 bg-slate-100 rounded\">dirty</span>\n                    </div>\n                </div>\n                <div class=\"bg-white p-3 rounded-lg border shadow-sm\">\n                    <h3 class=\"font-bold text-xs text-indigo-600 uppercase tracking-wider mb-2\">Column B (Strong Options)</h3>\n                    <div class=\"flex flex-wrap gap-2 text-xs font-semibold text-slate-600\">\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">filthy</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">furious</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">delicious</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">delighted</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">fascinated</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">gorgeous</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">boiling</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">tiny</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">enormous</span>\n                        <span class=\"px-2 py-1 bg-indigo-50 text-indigo-700 rounded\">freezing</span>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3 pt-2\">\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">1. tasty</span>\n                    <select data-answer=\"delicious\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">2. small</span>\n                    <select data-answer=\"tiny\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">3. cold</span>\n                    <select data-answer=\"freezing\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">4. hot</span>\n                    <select data-answer=\"boiling\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">5. beautiful</span>\n                    <select data-answer=\"gorgeous\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">6. big</span>\n                    <select data-answer=\"enormous\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">7. interested</span>\n                    <select data-answer=\"fascinated\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">8. angry</span>\n                    <select data-answer=\"furious\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">9. happy</span>\n                    <select data-answer=\"delighted\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                    <span class=\"font-medium text-sm\">10. dirty</span>\n                    <select data-answer=\"filthy\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- select --</option>\n                        <option value=\"delicious\">delicious</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n            </div>\n        </section>\n\n        <!-- Section 4: Adverbs classification (Task 7c) -->\n        <section aria-labelledby=\"adverbs-heading\" class=\"space-y-4 pt-4 border-t border-slate-100\">\n            <div class=\"border-b pb-3\">\n                <h2 id=\"adverbs-heading\" class=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n                    <span class=\"bg-indigo-100 text-indigo-700 w-7 h-7 rounded-lg inline-flex items-center justify-center text-sm\">7c</span>\n                    Look at the adverbs in blue in the article. Which type of adjective do they go with?\n                </h2>\n                <p class=\"text-xs text-slate-500 mt-1\">Select whether each adverb is used with Gradable adjectives (G), Strong adjectives (S), or Both (B).</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3\">\n                <div class=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex flex-col justify-between gap-2\">\n                    <span class=\"font-medium text-sm\">1. very</span>\n                    <select data-answer=\"G\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- Select type --</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n                <div class=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex flex-col justify-between gap-2\">\n                    <span class=\"font-medium text-sm\">2. really</span>\n                    <select data-answer=\"B\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- Select type --</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n                <div class=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex flex-col justify-between gap-2\">\n                    <span class=\"font-medium text-sm\">3. incredibly</span>\n                    <select data-answer=\"G\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- Select type --</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n                <div class=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex flex-col justify-between gap-2\">\n                    <span class=\"font-medium text-sm\">4. extremely</span>\n                    <select data-answer=\"G\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- Select type --</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n                <div class=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex flex-col justify-between gap-2\">\n                    <span class=\"font-medium text-sm\">5. absolutely</span>\n                    <select data-answer=\"S\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- Select type --</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n                <div class=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex flex-col justify-between gap-2\">\n                    <span class=\"font-medium text-sm\">6. fairly</span>\n                    <select data-answer=\"G\" class=\"px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">-- Select type --</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n            </div>\n        </section>\n\n        <!-- Action Buttons -->\n        <div class=\"flex flex-col sm:flex-row items-center justify-end gap-3 pt-6 border-t border-slate-200\">\n            <button onclick=\"checkAnswers()\" class=\"w-full sm:w-auto px-6 py-3 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-semibold rounded-xl shadow-md transition flex items-center justify-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                Check Answers\n            </button>\n        </div>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-4 text-xs text-slate-400\">\n        Interactive ELT Activity &bull; Gradable and Strong Adjectives\n    </footer>\n\n    <!-- Script Logic -->\n    <script>\n        // Mandatory pedagogical metrics contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'gradable_and_strong_adjectives',\n            maxScore: 22\n        };\n\n        function normalize(text) {\n            return (text || '').trim().toLowerCase().replace(/['\"]/g, '');\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalInputs = 22; // 8 inputs in table 7a + 10 selects in 7b + 6 selects in 7c\n\n            // Check table inputs (7a)\n            const inputs = document.querySelectorAll('main input[type=\"text\"]');\n            inputs.forEach(input => {\n                const userVal = normalize(input.value);\n                const expected = normalize(input.getAttribute('data-answer'));\n                \n                input.classList.remove('is-correct', 'is-wrong');\n                if (userVal === expected && userVal !== '') {\n                    input.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    input.classList.add('is-wrong');\n                }\n            });\n\n            // Check selects (7b & 7c)\n            const selects = document.querySelectorAll('main select');\n            selects.forEach(select => {\n                const userVal = normalize(select.value);\n                const expected = normalize(select.getAttribute('data-answer'));\n                \n                select.classList.remove('is-correct', 'is-wrong');\n                if (userVal === expected && userVal !== '') {\n                    select.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    select.classList.add('is-wrong');\n                }\n            });\n\n            // Update UI Score\n            document.getElementById('score-display').textContent = `${correctCount} / ${totalInputs}`;\n\n            // Dispatch global ELT event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: totalInputs,\n                    completed: correctCount === totalInputs\n                }\n            }));\n\n            // Post message for parent frame embedding\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalInputs\n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const inputs = document.querySelectorAll('main input[type=\"text\"]');\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('is-correct', 'is-wrong');\n            });\n\n            const selects = document.querySelectorAll('main select');\n            selects.forEach(select => {\n                select.value = '';\n                select.classList.remove('is-correct', 'is-wrong');\n            });\n\n            document.getElementById('score-display').textContent = `0 / 22`;\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793577210165,
      "title": "I Just Can't Sleep! - Vocabulary & Reading Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>I Just Can't Sleep! - Vocabulary & Reading Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header with Title and Score -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-inner\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </div>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">I just can't sleep!</h1>\n                    <p class=\"text-xs text-slate-500\">Gradable & Strong Adjectives</p>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center gap-3\">\n                <div id=\"score-badge\" class=\"bg-slate-100 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 border border-slate-200\">\n                    Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">19</span>\n                </div>\n                <button id=\"check-btn\" onclick=\"checkAnswers()\" class=\"bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium px-4 py-2 rounded-xl text-sm transition shadow-sm min-h-[42px] flex items-center justify-center\">\n                    Check Answers\n                </button>\n                <button id=\"reset-btn\" onclick=\"resetActivity()\" class=\"bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium p-2 rounded-xl text-sm transition min-h-[42px] min-w-[42px] flex items-center justify-center\" title=\"Reset\">\n                    🔄\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 space-y-6 flex-grow\">\n\n        <!-- Reading & Article Accordion -->\n        <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden\">\n            <details class=\"group\" open>\n                <summary class=\"flex justify-between items-center p-4 sm:p-6 bg-slate-50 cursor-pointer select-none font-semibold text-slate-700 hover:bg-slate-100 transition\">\n                    <span class=\"flex items-center gap-2 text-base\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z\" />\n                        >\n                        Reading Article: Emma's Insomnia Story\n                    </span>\n                    <span class=\"text-xs text-indigo-600 group-open:rotate-180 transition transform\">▼</span>\n                </summary>\n                <div class=\"p-4 sm:p-6 text-sm sm:text-base leading-relaxed text-slate-600 border-t border-slate-100 space-y-4\">\n                    <p>Last night I was fast asleep by 11 p.m., but I woke up again at 1 a.m. Even though I was <span class=\"text-pink-600 font-medium\">exhausted</span> when I went to bed, I was suddenly wide awake and it was <span class=\"text-pink-600 font-medium\">impossible</span> to get back to sleep again. So I just lay there watching the clock change from three to four to five without sleeping a wink – it was <span class=\"text-blue-600 font-medium\">very</span> frustrating. Finally, I got up at 6.15 and went off to work feeling <span class=\"text-pink-600 font-medium\">terrible</span>. That’s a typical night for me. I’ve had insomnia for so long I’m <span class=\"text-pink-600 font-medium\">amazed</span> that anyone else actually sleeps through the night. And when this goes on for too many nights I feel <span class=\"text-blue-600 font-medium\">really</span> <span class=\"text-pink-600 font-medium\">shattered</span>.</p>\n                    \n                    <p>I’m a sales manager, and I work <span class=\"text-blue-600 font-medium\">really</span> long hours and have to do a lot of travelling. I worry about work all the time, which makes it <span class=\"text-blue-600 font-medium\">incredibly</span> difficult to get to sleep. Sometimes I get home from work <span class=\"text-blue-600 font-medium\">extremely</span> late and when I go to bed everything is still going round my head. Money’s also a <span class=\"text-pink-600 font-medium\">huge</span> worry for me. I borrowed a lot when I was a student and I still owe £15,000. I only get a full night’s sleep once a month – but when I do I feel <span class=\"text-blue-600 font-medium\">absolutely</span> <span class=\"text-pink-600 font-medium\">fantastic</span> the next day.</p>\n                    \n                    <p>I’ve tried nearly everything to cure my insomnia – herbal teas, yoga, meditation – you name it, I’ve tried it. I’ve also started going to the gym three times a week, but it hasn’t made any difference. I have a <span class=\"text-blue-600 font-medium\">fairly</span> healthy diet and I don’t smoke or drink coffee. I haven’t tried hypnosis because it’s very expensive and that would just add to my money worries. I don’t want to start taking sleeping pills because I’m <span class=\"text-pink-600 font-medium\">terrified</span> of becoming addicted to them. Although I know it’s an <span class=\"text-pink-600 font-medium\">awful</span> way to live, I’ve learned to accept that insomnia is part of my life.</p>\n                    <p class=\"text-xs text-slate-400 italic\">Adapted from the Evening Standard 3/12/02</p>\n                </div>\n            </details>\n        </section>\n\n        <!-- Exercise 7a: Gradable & Strong Adjectives -->\n        <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-6 space-y-4\">\n            <div class=\"flex items-center gap-3\">\n                <span class=\"bg-slate-900 text-white text-xs font-bold px-2.5 py-1 rounded-lg\">7a</span>\n                <h2 class=\"text-base sm:text-lg font-semibold text-slate-900\">Complete the table with the strong adjectives in <span class=\"text-pink-600 font-bold\">pink</span> in the article.</h2>\n            </div>\n            <p class=\"text-xs sm:text-sm text-slate-500\">Match each gradable adjective with its corresponding strong adjective from the article text.</p>\n\n            <div class=\"overflow-x-auto\">\n                <table class=\"w-full text-left border-collapse\">\n                    <thead>\n                        <tr class=\"border-b border-slate-200 text-xs sm:text-sm font-bold text-slate-700 bg-slate-50\">\n                            <th class=\"p-3 w-1/2\">Gradable Adjective</th>\n                            <th class=\"p-3 w-1/2\">Strong Adjective</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"divide-y divide-slate-100 text-sm\">\n                        <tr>\n                            <td class=\"p-3 font-medium text-slate-700\">tired</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"shattered\" placeholder=\"\" class=\"vocab-input w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 font-medium text-slate-700\">bad</td>\n                            <td class=\"p-3 space-y-2\">\n                                <input type=\"text\" data-answer=\"terrible\" placeholder=\"\" class=\"vocab-input w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition mb-1\">\n                                <input type=\"text\" data-answer=\"awful\" placeholder=\"\" class=\"vocab-input w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 font-medium text-slate-700\">good</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"fantastic\" placeholder=\"\" class=\"vocab-input w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 font-medium text-slate-700\">big</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"huge\" placeholder=\"\" class=\"vocab-input w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 font-medium text-slate-700\">difficult</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"impossible\" placeholder=\"\" class=\"vocab-input w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 font-medium text-slate-700\">frightened</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"terrified\" placeholder=\"\" class=\"vocab-input w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-3 font-medium text-slate-700\">surprised</td>\n                            <td class=\"p-3\">\n                                <input type=\"text\" data-answer=\"amazed\" placeholder=\"\" class=\"vocab-input w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition\">\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </section>\n\n        <!-- Exercise 7b: Matching Gradable to Strong Adjectives -->\n        <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-6 space-y-4\">\n            <div class=\"flex items-center gap-3\">\n                <span class=\"bg-slate-900 text-white text-xs font-bold px-2.5 py-1 rounded-lg\">7b</span>\n                <h2 class=\"text-base sm:text-lg font-semibold text-slate-900\">Match the gradable adjectives in A to the strong adjectives in B.</h2>\n            </div>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs sm:text-sm\">\n                <div>\n                    <span class=\"font-bold text-slate-700 block mb-1\">List A (Gradable):</span>\n                    <p class=\"text-slate-600\">tasty, small, cold, hot, beautiful, big, interested, angry, happy, dirty</p>\n                </div>\n                <div>\n                    <span class=\"font-bold text-slate-700 block mb-1\">List B (Strong):</span>\n                    <p class=\"text-slate-600\">filthy, furious, delicious, delighted, fascinated, gorgeous, boiling, tiny, enormous, freezing</p>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\">\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">small <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"tiny\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">cold <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"freezing\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">hot <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"boiling\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">beautiful <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"gorgeous\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">big <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"enormous\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">interested <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"fascinated\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">angry <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"furious\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">happy <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"delighted\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200 sm:col-span-2\">\n                    <span class=\"font-medium text-sm text-slate-700\">dirty <span class=\"text-indigo-600 font-bold\">→</span></span>\n                    <select data-answer=\"filthy\" class=\"match-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none w-1/2\">\n                        <option value=\"\">Choose...</option>\n                        <option value=\"tiny\">tiny</option>\n                        <option value=\"freezing\">freezing</option>\n                        <option value=\"boiling\">boiling</option>\n                        <option value=\"gorgeous\">gorgeous</option>\n                        <option value=\"enormous\">enormous</option>\n                        <option value=\"fascinated\">fascinated</option>\n                        <option value=\"furious\">furious</option>\n                        <option value=\"delighted\">delighted</option>\n                        <option value=\"filthy\">filthy</option>\n                    </select>\n                </div>\n            </div>\n        </section>\n\n        <!-- Exercise 7c: Adverbs with Gradable/Strong Adjectives -->\n        <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-6 space-y-4\">\n            <div class=\"flex items-center gap-3\">\n                <span class=\"bg-slate-900 text-white text-xs font-bold px-2.5 py-1 rounded-lg\">7c</span>\n                <h2 class=\"text-base sm:text-lg font-semibold text-slate-900\">Look at the adverbs in <span class=\"text-blue-600 font-bold\">blue</span> in the article. Which type of adjective do they go with?</h2>\n            </div>\n            <p class=\"text-xs sm:text-sm text-slate-500\">Select whether each adverb is used with Gradable adjectives (G), Strong adjectives (S), or Both (B).</p>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\">\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">1. very</span>\n                    <select data-answer=\"G\" class=\"adverb-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">2. really</span>\n                    <select data-answer=\"B\" class=\"adverb-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">3. incredibly</span>\n                    <select data-answer=\"G\" class=\"adverb-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">4. extremely</span>\n                    <select data-answer=\"G\" class=\"adverb-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">5. absolutely</span>\n                    <select data-answer=\"S\" class=\"adverb-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n\n                <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <span class=\"font-medium text-sm text-slate-700\">6. fairly</span>\n                    <select data-answer=\"G\" class=\"adverb-select bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"G\">Gradable (G)</option>\n                        <option value=\"S\">Strong (S)</option>\n                        <option value=\"B\">Both (B)</option>\n                    </select>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full text-center py-4 border-t border-slate-200 bg-white text-xs text-slate-400 mt-8\">\n        Interactive ELT Learning Unit • Gradable & Strong Adjectives\n    </footer>\n\n    <!-- Interactive Script & Pedagogy Contract -->\n    <script>\n        // Mandatory Metrics Contract Declaration\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'gradable_and_strong_adjectives',\n            maxScore: 19\n        };\n\n        function normalizeText(txt) {\n            return (txt || \"\").trim().toLowerCase().replace(/['‘’]/g, \"'\");\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            let totalCount = 0;\n\n            // 1. Check Vocab inputs (Exercise 7a)\n            const vocabInputs = document.querySelectorAll('.vocab-input');\n            vocabInputs.forEach(input => {\n                totalCount++;\n                const userVal = normalizeText(input.value);\n                const expected = normalizeText(input.getAttribute('data-answer'));\n                \n                input.classList.remove('is-correct', 'is-wrong');\n                if (userVal === expected) {\n                    input.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    input.classList.add('is-wrong');\n                }\n            });\n\n            // 2. Check Matching selects (Exercise 7b)\n            const matchSelects = document.querySelectorAll('.match-select');\n            matchSelects.forEach(select => {\n                totalCount++;\n                const userVal = select.value;\n                const expected = select.getAttribute('data-answer');\n                \n                select.classList.remove('is-correct', 'is-wrong');\n                if (userVal === expected) {\n                    select.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    select.classList.add('is-wrong');\n                }\n            });\n\n            // 3. Check Adverb selects (Exercise 7c)\n            const adverbSelects = document.querySelectorAll('.adverb-select');\n            adverbSelects.forEach(select => {\n                totalCount++;\n                const userVal = select.value;\n                const expected = select.getAttribute('data-answer');\n                \n                select.classList.remove('is-correct', 'is-wrong');\n                if (userVal === expected) {\n                    select.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    select.classList.add('is-wrong');\n                }\n            });\n\n            // Update score display\n            document.getElementById('current-score').textContent = correctCount;\n            document.getElementById('total-score').textContent = totalCount;\n\n            // Dispatch Required ELT Events & PostMessage\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: totalCount,\n                    completed: correctCount === totalCount\n                }\n            }));\n\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalCount\n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            // Clear inputs\n            document.querySelectorAll('.vocab-input').forEach(input => {\n                input.value = '';\n                input.classList.remove('is-correct', 'is-wrong');\n            });\n\n            // Reset selects\n            document.querySelectorAll('.match-select, .adverb-select').forEach(select => {\n                select.value = '';\n                select.classList.remove('is-correct', 'is-wrong');\n            });\n\n            // Reset score counter\n            document.getElementById('current-score').textContent = '0';\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793577345110,
      "title": "Gradable and Strong Adjectives",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Gradable and Strong Adjectives</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen py-6 px-3 sm:px-6\">\n\n    <div class=\"w-full max-w-4xl mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden\">\n        \n        <!-- Header / Title Bar -->\n        <div class=\"bg-gradient-to-r from-indigo-900 to-indigo-800 text-white p-6 sm:p-8\">\n            <div class=\"flex flex-wrap items-center justify-between gap-4\">\n                <div>\n                    <span class=\"inline-block bg-indigo-700/60 text-indigo-200 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-2 border border-indigo-600/50\">\n                        V2.4 • Grammar Reference • 2C p17\n                    </span>\n                    <h1 class=\"text-2xl sm:text-3xl font-bold tracking-tight\">Gradable and strong adjectives; adverbs</h1>\n                </div>\n            </div>\n        </div>\n\n        <!-- Main Content Container -->\n        <div class=\"p-4 sm:p-8 space-y-8\">\n\n            <!-- Intro Rule Box -->\n            <div class=\"bg-amber-50 border-l-4 border-amber-400 p-4 sm:p-5 rounded-r-xl shadow-xs flex items-start gap-3\">\n                <svg class=\"w-6 h-6 text-amber-600 shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                </svg>\n                <div class=\"text-amber-900 text-sm sm:text-base leading-relaxed\">\n                    <strong class=\"font-semibold text-amber-950\">Core Concept:</strong> Strong adjectives already include the idea of <em>very</em>. For example, <span class=\"font-medium\">exhausted</span> means <span class=\"italic\">'very tired'</span>.\n                </div>\n            </div>\n\n            <!-- Adjective Comparison Table -->\n            <div>\n                <h2 class=\"text-lg font-bold text-slate-900 mb-4 flex items-center gap-2\">\n                    <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"></path></svg>\n                    Adjective Pairs\n                </h2>\n                \n                <div class=\"overflow-x-auto border border-slate-200 rounded-xl shadow-xs\">\n                    <table class=\"w-full text-left border-collapse\">\n                        <thead>\n                            <tr class=\"bg-slate-100 text-slate-700 text-xs sm:text-sm uppercase tracking-wider font-semibold border-b border-slate-200\">\n                                <th class=\"py-3 px-4 sm:px-6 w-1/2\">Gradable Adjectives</th>\n                                <th class=\"py-3 px-4 sm:px-6 w-1/2\">Strong Adjectives</th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"divide-y divide-slate-100 text-sm sm:text-base\">\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">tired</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">exhausted <span class=\"text-xs text-slate-400 font-normal\">/ɪɡˈzɔːstɪd/</span>, shattered</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">bad</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">terrible, awful <span class=\"text-xs text-slate-400 font-normal\">/ˈɔːfəl/</span></td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">good</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">fantastic</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">big</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">huge <span class=\"text-xs text-slate-400 font-normal\">/hjuːdʒ/</span></td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">difficult</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">impossible</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">frightened</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">terrified</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">surprised</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">amazed</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">tasty</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">delicious <span class=\"text-xs text-slate-400 font-normal\">/dɪˈlɪʃəs/</span></td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">small</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">tiny <span class=\"text-xs text-slate-400 font-normal\">/ˈtaɪni/</span></td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">cold</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">freezing</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">hot</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">boiling</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">beautiful</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">gorgeous <span class=\"text-xs text-slate-400 font-normal\">/ˈɡɔːdʒəs/</span></td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">big</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">enormous</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">interested</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">fascinated</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">angry</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">furious <span class=\"text-xs text-slate-400 font-normal\">/ˈfjʊəriəs/</span></td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">happy</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">delighted</td></tr>\n                            <tr class=\"hover:bg-slate-50/85 transition-colors\"><td class=\"py-2.5 px-4 sm:px-6 text-slate-700 font-medium\">dirty</td><td class=\"py-2.5 px-4 sm:px-6 text-indigo-900 font-medium\">filthy <span class=\"text-xs text-slate-400 font-normal\">/ˈfɪlθi/</span></td></tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n\n            <!-- Rules & Adverb Usage Grid -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                \n                <!-- Rule 1 -->\n                <div class=\"bg-slate-50 p-5 rounded-xl border border-slate-200\">\n                    <div class=\"flex items-center gap-2 text-indigo-900 font-semibold mb-2\">\n                        <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                        Gradable Adverbs Rule\n                    </div>\n                    <p class=\"text-sm text-slate-600 leading-relaxed mb-3\">\n                        We can use <span class=\"font-medium text-slate-800\">very</span>, <span class=\"font-medium text-slate-800\">incredibly</span>, <span class=\"font-medium text-slate-800\">extremely</span> and <span class=\"font-medium text-slate-800\">fairly</span> with <strong>gradable adjectives</strong>, but not with strong adjectives.\n                    </p>\n                    <div class=\"bg-white p-3 rounded-lg border border-slate-200 text-xs sm:text-sm space-y-1\">\n                        <div class=\"text-emerald-700 font-medium\">✓ very tired / incredibly difficult</div>\n                        <div class=\"text-rose-600 line-through\">✗ very shattered / incredibly impossible</div>\n                    </div>\n                </div>\n\n                <!-- Rule 2 -->\n                <div class=\"bg-slate-50 p-5 rounded-xl border border-slate-200\">\n                    <div class=\"flex items-center gap-2 text-indigo-900 font-semibold mb-2\">\n                        <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                        Adverb Strength Intensity\n                    </div>\n                    <p class=\"text-sm text-slate-600 leading-relaxed\">\n                        <span class=\"font-medium text-slate-800\">Incredibly</span> and <span class=\"font-medium text-slate-800\">extremely</span> are stronger than <span class=\"font-medium text-slate-800\">very</span>. <span class=\"font-medium text-slate-800\">Fairly</span> is less strong than <span class=\"font-medium text-slate-800\">very</span>.\n                    </p>\n                </div>\n\n                <!-- Rule 3 -->\n                <div class=\"bg-slate-50 p-5 rounded-xl border border-slate-200\">\n                    <div class=\"flex items-center gap-2 text-indigo-900 font-semibold mb-2\">\n                        <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                        Absolute Adverbs Rule\n                    </div>\n                    <p class=\"text-sm text-slate-600 leading-relaxed mb-3\">\n                        We can use <span class=\"font-medium text-slate-800\">absolutely</span> with <strong>strong adjectives</strong>, but not gradable adjectives.\n                    </p>\n                    <div class=\"bg-white p-3 rounded-lg border border-slate-200 text-xs sm:text-sm space-y-1\">\n                        <div class=\"text-emerald-700 font-medium\">✓ absolutely terrified</div>\n                        <div class=\"text-rose-600 line-through\">✗ absolutely frightened</div>\n                    </div>\n                </div>\n\n                <!-- Rule 4 -->\n                <div class=\"bg-slate-50 p-5 rounded-xl border border-slate-200\">\n                    <div class=\"flex items-center gap-2 text-indigo-900 font-semibold mb-2\">\n                        <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n                        Flexible Adverbs\n                    </div>\n                    <p class=\"text-sm text-slate-600 leading-relaxed mb-3\">\n                        We can use <span class=\"font-medium text-slate-800\">really</span> with <strong>both</strong> gradable and strong adjectives.\n                    </p>\n                    <div class=\"bg-white p-3 rounded-lg border border-slate-200 text-xs sm:text-sm space-y-1\">\n                        <div class=\"text-emerald-700 font-medium\">✓ really tired / really exhausted</div>\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- TIP Section: Synonyms of \"Very Good\" -->\n            <div class=\"bg-indigo-50/70 border border-indigo-100 p-5 rounded-xl\">\n                <div class=\"flex items-center gap-2 text-indigo-900 font-bold mb-2\">\n                    <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z\"></path></svg>\n                    TIP! Strong Adjectives meaning \"Very Good\"\n                </div>\n                <p class=\"text-sm text-slate-700 mb-3\">\n                    These strong adjectives all mean <em>very good</em>:\n                </p>\n                <div class=\"flex flex-wrap gap-2\">\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">amazing</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">brilliant</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">excellent</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">fabulous</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">fantastic</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">incredible</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">marvellous</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">superb</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">terrific</span>\n                    <span class=\"bg-white px-3 py-1.5 rounded-lg border border-indigo-200 text-sm font-medium text-indigo-900 shadow-xs\">wonderful</span>\n                </div>\n            </div>\n\n        </div>\n    </div>\n\n    <script>\n        // Declaración obligatoria de métricas pedagógicas\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'gradable_and_strong_adjectives',\n            maxScore: 0\n        };\n\n        window.addEventListener('DOMContentLoaded', () => {\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: 0,\n                    total: 0,\n                    completed: true\n                }\n            }));\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793577477888,
      "title": "Exercise 8a - Adverbs of Degree",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Exercise 8a - Adverbs of Degree</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8fafc;\n            color: #1e293b;\n        }\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen py-4 sm:py-8 px-2 sm:px-4 flex flex-col justify-between\">\n\n    <!-- MAIN CONTAINER (W-full max-w-4xl mx-auto per instructions) -->\n    <main class=\"w-full max-w-4xl mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col flex-grow\">\n        \n        <!-- HEADER STICKY BAR -->\n        <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-6 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4 shadow-sm\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"w-9 h-9 rounded-xl bg-indigo-600 text-white font-bold flex items-center justify-center text-lg shadow-sm\">\n                    8\n                </div>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-800 leading-tight\">Adverbs of Degree</h1>\n                    <p class=\"text-xs text-slate-500\">Complete the sentences with adverbs and your personal ideas.</p>\n                </div>\n            </div>\n            \n            <!-- SCORE & METRICS DISPLAY -->\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-xl text-sm font-semibold border border-slate-200\">\n                    Score: <span id=\"score-display\">0</span> / <span id=\"total-display\">6</span>\n                </div>\n            </div>\n        </header>\n\n        <!-- CONTENT SECTION -->\n        <div class=\"p-4 sm:p-6 md:p-8 flex-grow space-y-6\">\n\n            <!-- INSTRUCTIONS CARD -->\n            <div class=\"bg-indigo-50/60 border border-indigo-100 rounded-2xl p-4 sm:p-5 flex items-start space-x-4\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl mt-0.5 shrink-0\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                </div>\n                <div class=\"text-sm text-indigo-900 space-y-1\">\n                    <p class=\"font-semibold text-base\">a) Fill in the gaps with an adverb.</p>\n                    <p class=\"text-indigo-700 leading-relaxed\">\n                        Use adverbs of degree (e.g., <span class=\"italic font-medium\">really, absolutely, quite, incredibly, extremely, a bit, totally, fairly</span>) and complete the second part of each sentence for you.\n                    </p>\n                </div>\n            </div>\n\n            <!-- REFERENCE ADVERBS BANK (ACCORDION / PILLS) -->\n            <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-3 sm:p-4\">\n                <p class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2\">💡 Useful Adverbs Reference Bank:</p>\n                <div class=\"flex flex-wrap gap-2\">\n                    <span class=\"bg-white border border-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-lg font-medium shadow-2xs\">really</span>\n                    <span class=\"bg-white border border-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-lg font-medium shadow-2xs\">absolutely</span>\n                    <span class=\"bg-white border border-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-lg font-medium shadow-2xs\">quite</span>\n                    <span class=\"bg-white border border-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-lg font-medium shadow-2xs\">incredibly</span>\n                    <span class=\"bg-white border border-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-lg font-medium shadow-2xs\">extremely</span>\n                    <span class=\"bg-white border border-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-lg font-medium shadow-2xs\">a bit</span>\n                    <span class=\"bg-white border border-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-lg font-medium shadow-2xs\">totally</span>\n                    <span class=\"bg-white border border-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-lg font-medium shadow-2xs\">fairly</span>\n                </div>\n            </div>\n\n            <!-- INTERACTIVE EXERCISE FORM -->\n            <form id=\"activity-form\" class=\"space-y-4 sm:space-y-5\" onsubmit=\"event.preventDefault();\">\n                \n                <!-- ITEM 1 -->\n                <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-2xs hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center gap-3\">\n                    <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                        <span class=\"w-7 h-7 bg-slate-800 text-white rounded-lg text-xs font-bold flex items-center justify-center shrink-0\">1</span>\n                        <span class=\"text-sm font-medium text-slate-700 whitespace-nowrap\">I'm usually</span>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-2 flex-grow\">\n                        <input type=\"text\" \n                               data-answer=\"really,absolutely,quite,incredibly,extremely,a bit,totally,fairly\" \n                               data-any-valid=\"true\"\n                               placeholder=\"adverb...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-40 transition-colors\">\n                        <span class=\"text-sm font-medium text-slate-700\">exhausted after</span>\n                        <input type=\"text\" \n                               data-answer=\"custom\" \n                               data-free-input=\"true\"\n                               placeholder=\"e.g. working out at the gym...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 flex-grow min-w-[200px] transition-colors\">\n                    </div>\n                </div>\n\n                <!-- ITEM 2 -->\n                <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-2xs hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center gap-3\">\n                    <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                        <span class=\"w-7 h-7 bg-slate-800 text-white rounded-lg text-xs font-bold flex items-center justify-center shrink-0\">2</span>\n                        <span class=\"text-sm font-medium text-slate-700 whitespace-nowrap\">It's</span>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-2 flex-grow\">\n                        <input type=\"text\" \n                               data-answer=\"really,quite,incredibly,extremely,a bit,fairly\" \n                               data-any-valid=\"true\"\n                               placeholder=\"adverb...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-40 transition-colors\">\n                        <span class=\"text-sm font-medium text-slate-700\">difficult for me to</span>\n                        <input type=\"text\" \n                               data-answer=\"custom\" \n                               data-free-input=\"true\"\n                               placeholder=\"e.g. wake up early on Mondays...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 flex-grow min-w-[200px] transition-colors\">\n                    </div>\n                </div>\n\n                <!-- ITEM 3 -->\n                <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-2xs hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center gap-3\">\n                    <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                        <span class=\"w-7 h-7 bg-slate-800 text-white rounded-lg text-xs font-bold flex items-center justify-center shrink-0\">3</span>\n                        <span class=\"text-sm font-medium text-slate-700 whitespace-nowrap\">The last time I felt</span>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-2 flex-grow\">\n                        <input type=\"text\" \n                               data-answer=\"really,absolutely,totally,incredibly,extremely\" \n                               data-any-valid=\"true\"\n                               placeholder=\"adverb...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-40 transition-colors\">\n                        <span class=\"text-sm font-medium text-slate-700\">awful was</span>\n                        <input type=\"text\" \n                               data-answer=\"custom\" \n                               data-free-input=\"true\"\n                               placeholder=\"e.g. when I had the flu last winter...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 flex-grow min-w-[200px] transition-colors\">\n                    </div>\n                </div>\n\n                <!-- ITEM 4 -->\n                <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-2xs hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center gap-3\">\n                    <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                        <span class=\"w-7 h-7 bg-slate-800 text-white rounded-lg text-xs font-bold flex items-center justify-center shrink-0\">4</span>\n                        <span class=\"text-sm font-medium text-slate-700 whitespace-nowrap\">I'm</span>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-2 flex-grow\">\n                        <input type=\"text\" \n                               data-answer=\"really,quite,incredibly,extremely,fairly\" \n                               data-any-valid=\"true\"\n                               placeholder=\"adverb...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-40 transition-colors\">\n                        <span class=\"text-sm font-medium text-slate-700\">interested in</span>\n                        <input type=\"text\" \n                               data-answer=\"custom\" \n                               data-free-input=\"true\"\n                               placeholder=\"e.g. learning artificial intelligence...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 flex-grow min-w-[200px] transition-colors\">\n                    </div>\n                </div>\n\n                <!-- ITEM 5 -->\n                <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-2xs hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center gap-3\">\n                    <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                        <span class=\"w-7 h-7 bg-slate-800 text-white rounded-lg text-xs font-bold flex items-center justify-center shrink-0\">5</span>\n                        <span class=\"text-sm font-medium text-slate-700 whitespace-nowrap\">I've got a/an</span>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-2 flex-grow\">\n                        <input type=\"text\" \n                               data-answer=\"really,absolutely,incredibly,extremely\" \n                               data-any-valid=\"true\"\n                               placeholder=\"adverb...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-40 transition-colors\">\n                        <span class=\"text-sm font-medium text-slate-700\">gorgeous</span>\n                        <input type=\"text\" \n                               data-answer=\"custom\" \n                               data-free-input=\"true\"\n                               placeholder=\"e.g. view from my bedroom window...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 flex-grow min-w-[200px] transition-colors\">\n                    </div>\n                </div>\n\n                <!-- ITEM 6 -->\n                <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-2xs hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center gap-3\">\n                    <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                        <span class=\"w-7 h-7 bg-slate-800 text-white rounded-lg text-xs font-bold flex items-center justify-center shrink-0\">6</span>\n                        <span class=\"text-sm font-medium text-slate-700 whitespace-nowrap\">The last place I went to that was</span>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-2 flex-grow\">\n                        <input type=\"text\" \n                               data-answer=\"really,quite,extremely,incredibly\" \n                               data-any-valid=\"true\"\n                               placeholder=\"adverb...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-36 sm:w-40 transition-colors\">\n                        <span class=\"text-sm font-medium text-slate-700\">cold was</span>\n                        <input type=\"text\" \n                               data-answer=\"custom\" \n                               data-free-input=\"true\"\n                               placeholder=\"e.g. the mountains last December...\" \n                               class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 flex-grow min-w-[200px] transition-colors\">\n                    </div>\n                </div>\n\n                <!-- ACTION BUTTONS -->\n                <div class=\"pt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100\">\n                    <button type=\"button\" \n                            onclick=\"resetActivity()\" \n                            class=\"px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium text-sm hover:bg-slate-50 active:scale-95 transition-all flex items-center space-x-2 min-h-[42px]\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                        </svg>\n                        <span>Reset</span>\n                    </button>\n\n                    <button type=\"button\" \n                            onclick=\"checkAnswers()\" \n                            class=\"px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold text-sm hover:bg-indigo-700 active:scale-95 transition-all shadow-sm flex items-center space-x-2 min-h-[42px]\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                        </svg>\n                        <span>Check Answers</span>\n                    </button>\n                </div>\n\n            </form>\n\n        </div>\n\n    </main>\n\n    <!-- FOOTER INFO -->\n    <footer class=\"w-full text-center py-4 text-xs text-slate-400\">\n        Interactive ELT Activity &bull; Designed for Responsive Touch Interfaces\n    </footer>\n\n    <!-- JAVASCRIPT LOGIC & METRICS CONTRACT -->\n    <script>\n        // MANDATORY PEDAGOGICAL METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'adverbs_of_degree',\n            maxScore: 6\n        };\n\n        function checkAnswers() {\n            // We evaluate the 6 adverb slots (the first input in each row that has data-any-valid=\"true\")\n            const rows = document.querySelectorAll('#activity-form > div');\n            let correctCount = 0;\n            const totalItems = rows.length;\n\n            rows.forEach((row, index) => {\n                const adverbInput = row.querySelector('input[data-any-valid=\"true\"]');\n                const freeInput = row.querySelector('input[data-free-input=\"true\"]');\n                \n                if (!adverbInput) return;\n\n                const val = adverbInput.value.trim().toLowerCase();\n                const allowedAnswers = adverbInput.getAttribute('data-answer').split(',').map(s => s.trim().toLowerCase());\n                \n                // Check adverb validity\n                const isAdverbCorrect = allowedAnswers.includes(val);\n                // Free text completion is accepted as long as it's not empty\n                const isFreeTextValid = freeInput && freeInput.value.trim().length > 0;\n\n                // Visual feedback for adverb input\n                adverbInput.classList.remove('is-correct', 'is-wrong');\n                if (isAdverbCorrect) {\n                    adverbInput.classList.add('is-correct');\n                } else {\n                    adverbInput.classList.add('is-wrong');\n                }\n\n                // Visual feedback for free completion input\n                if (freeInput) {\n                    freeInput.classList.remove('is-correct', 'is-wrong');\n                    if (isFreeTextValid) {\n                        freeInput.classList.add('is-correct');\n                    } else {\n                        freeInput.classList.add('is-wrong');\n                    }\n                }\n\n                // Count as correct if adverb is recognized and free text is filled\n                if (isAdverbCorrect && isFreeTextValid) {\n                    correctCount++;\n                }\n            });\n\n            // Update score display\n            document.getElementById('score-display').textContent = correctCount;\n\n            // Dispatch global event for live session integration\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: totalItems,\n                    completed: correctCount === totalItems\n                }\n            }));\n\n            // PostMessage to parent frame if embedded\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalItems\n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const inputs = document.querySelectorAll('#activity-form input');\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('is-correct', 'is-wrong');\n            });\n            document.getElementById('score-display').textContent = '0';\n\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: 0,\n                    total: 6,\n                    completed: false\n                }\n            }));\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793577528689,
      "title": "Sleep Survey Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Sleep Survey Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header with Title and Metrics -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm\">9</span>\n                <h1 class=\"text-base sm:text-lg font-bold text-slate-900 tracking-tight\">Sleep Survey & Practice</h1>\n            </div>\n            <div class=\"flex items-center space-x-3 text-sm font-medium\">\n                <div id=\"score-display\" class=\"bg-slate-100 text-slate-700 px-3 py-1 rounded-full border border-slate-200\">\n                    Score: <span id=\"current-score\" class=\"font-bold text-indigo-600\">0</span> / <span id=\"max-score\">6</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Instruction Card -->\n        <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 mb-6\">\n            <div class=\"flex items-start space-x-3\">\n                <div class=\"p-2 bg-indigo-50 text-indigo-600 rounded-xl mt-0.5\">\n                    <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"/></svg>\n                </div>\n                <div>\n                    <h2 class=\"text-lg font-bold text-slate-900\">a) Write a sleep survey</h2>\n                    <p class=\"text-sm text-slate-600 mt-1\">\n                        Complete the survey questions below about sleep habits. Use standard sleep-related terms or your own ideas.\n                    </p>\n                    <div class=\"mt-3 inline-block bg-slate-100 text-slate-700 text-xs sm:text-sm font-medium px-3 py-1.5 rounded-lg border border-slate-200\">\n                        <span class=\"font-semibold text-slate-900\">Example:</span> How many hours do you usually sleep a night?\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Interactive Survey Questions Form -->\n        <form id=\"survey-form\" class=\"space-y-4 sm:space-y-6\">\n            \n            <!-- Question 1 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm transition hover:border-slate-300\">\n                <label for=\"q1\" class=\"block text-sm sm:text-base font-semibold text-slate-800 mb-2\">\n                    <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full mr-1.5\">1</span>\n                    How many hours do you usually <input type=\"text\" id=\"q1\" data-answer=\"sleep\" placeholder=\"type verb...\" class=\"inline-block border border-slate-300 rounded-lg px-3 py-1 text-sm sm:text-base w-36 mx-1 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500\"> a night?\n                </label>\n                <p class=\"text-xs text-slate-500 ml-8\">Hint: Refers to rest duration.</p>\n            </div>\n\n            <!-- Question 2 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm transition hover:border-slate-300\">\n                <label for=\"q2\" class=\"block text-sm sm:text-base font-semibold text-slate-800 mb-2\">\n                    <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full mr-1.5\">2</span>\n                    What time do you usually <input type=\"text\" id=\"q2\" data-answer=\"wake up\" data-alts=\"get up,awake\" placeholder=\"type phrase...\" class=\"inline-block border border-slate-300 rounded-lg px-3 py-1 text-sm sm:text-base w-40 mx-1 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500\"> in the morning?\n                </label>\n                <p class=\"text-xs text-slate-500 ml-8\">Hint: Phrasal verb for stopping sleep.</p>\n            </div>\n\n            <!-- Question 3 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm transition hover:border-slate-300\">\n                <label for=\"q3\" class=\"block text-sm sm:text-base font-semibold text-slate-800 mb-2\">\n                    <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full mr-1.5\">3</span>\n                    Do you ever take a <input type=\"text\" id=\"q3\" data-answer=\"nap\" data-alts=\"siesta,sleep\" placeholder=\"type noun...\" class=\"inline-block border border-slate-300 rounded-lg px-3 py-1 text-sm sm:text-base w-36 mx-1 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500\"> during the day?\n                </label>\n                <p class=\"text-xs text-slate-500 ml-8\">Hint: A short sleep during the day.</p>\n            </div>\n\n            <!-- Question 4 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm transition hover:border-slate-300\">\n                <label for=\"q4\" class=\"block text-sm sm:text-base font-semibold text-slate-800 mb-2\">\n                    <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full mr-1.5\">4</span>\n                    How often do you have trouble <input type=\"text\" id=\"q4\" data-answer=\"sleeping\" data-alts=\"fall asleep,to sleep\" placeholder=\"type verb form...\" class=\"inline-block border border-slate-300 rounded-lg px-3 py-1 text-sm sm:text-base w-36 mx-1 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500\"> at night?\n                </label>\n                <p class=\"text-xs text-slate-500 ml-8\">Hint: Experiencing insomnia or restlessness.</p>\n            </div>\n\n            <!-- Question 5 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm transition hover:border-slate-300\">\n                <label for=\"q5\" class=\"block text-sm sm:text-base font-semibold text-slate-800 mb-2\">\n                    <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full mr-1.5\">5</span>\n                    Do you <input type=\"text\" id=\"q5\" data-answer=\"dream\" data-alts=\"remember dreams\" placeholder=\"type verb...\" class=\"inline-block border border-slate-300 rounded-lg px-3 py-1 text-sm sm:text-base w-36 mx-1 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500\"> very often when you sleep?\n                </label>\n                <p class=\"text-xs text-slate-500 ml-8\">Hint: Mental images during sleep.</p>\n            </div>\n\n            <!-- Question 6 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm transition hover:border-slate-300\">\n                <label for=\"q6\" class=\"block text-sm sm:text-base font-semibold text-slate-800 mb-2\">\n                    <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full mr-1.5\">6</span>\n                    What time do you usually go to <input type=\"text\" id=\"q6\" data-answer=\"bed\" placeholder=\"type noun...\" class=\"inline-block border border-slate-300 rounded-lg px-3 py-1 text-sm sm:text-base w-36 mx-1 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500\"> on weekends?\n                </label>\n                <p class=\"text-xs text-slate-500 ml-8\">Hint: Furniture/place where you sleep.</p>\n            </div>\n\n            <!-- Action Buttons Bar -->\n            <div class=\"flex flex-wrap items-center justify-end gap-3 pt-4\">\n                <button type=\"button\" id=\"reset-btn\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-100 transition min-h-[42px]\">\n                    🔄 Reset\n                </button>\n                <button type=\"button\" id=\"check-btn\" class=\"px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 shadow-sm transition min-h-[42px]\">\n                    ✓ Check Answers\n                </button>\n            </div>\n        </form>\n\n        <!-- Additional Guidance Section (b, c, d from OCR) -->\n        <section class=\"mt-8 bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6\">\n            <h3 class=\"text-md font-bold text-slate-900 mb-3 flex items-center\">\n                <svg class=\"w-5 h-5 mr-2 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\"/></svg>\n                Classroom Extension Tasks\n            </h3>\n            <ul class=\"space-y-2 text-sm text-slate-600\">\n                <li class=\"flex items-start\"><span class=\"font-semibold text-slate-800 mr-2\">b)</span> Ask other students in the class and write down their answers.</li>\n                <li class=\"flex items-start\"><span class=\"font-semibold text-slate-800 mr-2\">c)</span> Work in your groups and compare your answers.</li>\n                <li class=\"flex items-start\"><span class=\"font-semibold text-slate-800 mr-2\">d)</span> Tell the class what you found out about other students' sleeping habits.</li>\n            </ul>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full text-center py-4 border-t border-slate-200 text-xs text-slate-500 mt-8 bg-white\">\n        Interactive ELT Activity &bull; Designed for Touch & Responsive Viewports\n    </footer>\n\n    <!-- Script Logic and Metrics -->\n    <script>\n        // Mandatory Metrics Declaration\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'sleep_survey_questions',\n            maxScore: 6\n        };\n\n        function normalizeText(text) {\n            return text.trim().toLowerCase().replace(/['\".,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\");\n        }\n\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const scoreSpan = document.getElementById('current-score');\n        const inputs = document.querySelectorAll('#survey-form input[type=\"text\"]');\n\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n\n            inputs.forEach(input => {\n                const userVal = normalizeText(input.value);\n                const primaryAnswer = normalizeText(input.getAttribute('data-answer'));\n                const altAnswersAttr = input.getAttribute('data-alt');\n                let altAnswers = altAnswersAttr ? altAnswersAttr.split(',').map(a => normalizeText(a)) : [];\n                \n                // Also check data-alts if plural attribute used\n                const altsAttr2 = input.getAttribute('data-alts');\n                if (altsAttr2) {\n                    altAnswers = altAnswers.concat(altsAttr2.split(',').map(a => normalizeText(a)));\n                }\n\n                input.classList.remove('is-correct', 'is-wrong');\n\n                if (userVal === primaryAnswer || altAnswers.includes(userVal)) {\n                    input.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    input.classList.add('is-wrong');\n                }\n            });\n\n            scoreSpan.textContent = correctCount;\n\n            // Dispatch mandatory custom event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: inputs.length,\n                    completed: correctCount === inputs.length\n                }\n            }));\n\n            // Post message for parent frame embedding\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: inputs.length\n                }, '*');\n            }\n        });\n\n        resetBtn.addEventListener('click', () => {\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('is-correct', 'is-wrong');\n            });\n            scoreSpan.textContent = '0';\n\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: 0,\n                    total: inputs.length,\n                    completed: false\n                }\n            }));\n\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: 0,\n                    total: inputs.length\n                }, '*');\n            }\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793577709064,
      "title": "Sleep Survey Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Sleep Survey Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .custom-input {\n            transition: all 0.2s ease-in-out;\n        }\n        .custom-input:focus {\n            outline: none;\n            border-color: #3b82f6;\n            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen py-6 px-3 sm:px-6\">\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-12\">\n        \n        <!-- HEADER -->\n        <header class=\"bg-gradient-to-r from-slate-900 to-indigo-950 text-white p-6 sm:p-8\">\n            <div class=\"flex items-center space-x-3 mb-2\">\n                <span class=\"bg-indigo-600 text-white text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md\">Exercise 9</span>\n                <span class=\"text-indigo-200 text-sm font-medium\">Vocabulary & Speaking Practice</span>\n            </div>\n            <h1 class=\"text-2xl sm:text-3xl font-extrabold tracking-tight\">Sleep Survey Project</h1>\n            <p class=\"text-slate-300 text-sm sm:text-base mt-1\">Create survey questions about sleeping habits, interview your classmates, and share your findings.</p>\n        </header>\n\n        <!-- SCORE BANNER / STICKY CONTROLS -->\n        <div class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-8 border-b border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-4\">\n            <div class=\"flex items-center space-x-2\">\n                <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                </svg>\n                <span class=\"text-sm font-bold text-slate-700\">Progress: <span id=\"score-display\" class=\"text-indigo-600 font-extrabold\">0 / 6</span> completed</span>\n            </div>\n            <div class=\"flex items-center space-x-2\">\n                <button id=\"check-btn\" onclick=\"checkAnswers()\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-2 px-5 rounded-xl shadow-sm transition active:scale-95 flex items-center space-x-1.5 min-h-[42px]\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    <span>Check Survey Questions</span>\n                </button>\n                <button id=\"reset-btn\" onclick=\"resetActivity()\" class=\"bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold py-2 px-4 rounded-xl transition active:scale-95 flex items-center space-x-1 min-h-[42px]\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    <span>Reset</span>\n                </button>\n            </div>\n        </div>\n\n        <!-- CONTENT CONTAINER -->\n        <div class=\"p-5 sm:p-8 space-y-8\">\n\n            <!-- SECTION A: CREATE A SLEEP SURVEY -->\n            <section class=\"space-y-4\">\n                <div class=\"flex items-start space-x-3\">\n                    <span class=\"flex-shrink-0 w-8 h-8 bg-slate-900 text-white rounded-full flex items-center justify-center font-bold text-sm\">9a</span>\n                    <div>\n                        <h2 class=\"text-lg font-bold text-slate-900\">Work in groups. Write a sleep survey.</h2>\n                        <p class=\"text-sm text-slate-600\">Write at least six questions. Use words/phrases from previous lessons or your own ideas.</p>\n                    </div>\n                </div>\n\n                <!-- Example Reference Box -->\n                <div class=\"bg-indigo-50 border border-indigo-100 rounded-xl p-4 flex items-start space-x-3\">\n                    <svg class=\"w-5 h-5 text-indigo-600 flex-shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                    </svg>\n                    <div>\n                        <span class=\"text-xs font-bold text-indigo-800 uppercase tracking-wide block mb-0.5\">Example Question (Reference):</span>\n                        <p class=\"text-indigo-950 font-medium italic\">\"How many hours do you usually sleep a night?\"</p>\n                    </div>\n                </div>\n\n                <!-- 6 Survey Question Inputs -->\n                <div class=\"grid grid-cols-1 gap-4 pt-2\" id=\"survey-questions-container\">\n                    \n                    <!-- Q1 -->\n                    <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                            <span class=\"w-7 h-7 bg-slate-200 text-slate-700 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0\">1</span>\n                            <span class=\"text-sm font-semibold text-slate-700\">Question 1:</span>\n                        </div>\n                        <input type=\"text\" \n                               class=\"custom-input flex-1 bg-white border border-slate-300 text-slate-800 text-sm rounded-lg py-2.5 px-3.5 w-full min-h-[42px]\" \n                               placeholder=\"e.g., Do you usually take naps during the day?\" \n                               data-answer=\"survey_q1\">\n                    </div>\n\n                    <!-- Q2 -->\n                    <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                            <span class=\"w-7 h-7 bg-slate-200 text-slate-700 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0\">2</span>\n                            <span class=\"text-sm font-semibold text-slate-700\">Question 2:</span>\n                        </div>\n                        <input type=\"text\" \n                               class=\"custom-input flex-1 bg-white border border-slate-300 text-slate-800 text-sm rounded-lg py-2.5 px-3.5 w-full min-h-[42px]\" \n                               placeholder=\"e.g., What time do you usually go to bed on weekends?\" \n                               data-answer=\"survey_q2\">\n                    </div>\n\n                    <!-- Q3 -->\n                    <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                            <span class=\"w-7 h-7 bg-slate-200 text-slate-700 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0\">3</span>\n                            <span class=\"text-sm font-semibold text-slate-700\">Question 3:</span>\n                        </div>\n                        <input type=\"text\" \n                               class=\"custom-input flex-1 bg-white border border-slate-300 text-slate-800 text-sm rounded-lg py-2.5 px-3.5 w-full min-h-[42px]\" \n                               placeholder=\"e.g., Do you wake up easily in the morning?\" \n                               data-answer=\"survey_q3\">\n                    </div>\n\n                    <!-- Q4 -->\n                    <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                            <span class=\"w-7 h-7 bg-slate-200 text-slate-700 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0\">4</span>\n                            <span class=\"text-sm font-semibold text-slate-700\">Question 4:</span>\n                        </div>\n                        <input type=\"text\" \n                               class=\"custom-input flex-1 bg-white border border-slate-300 text-slate-800 text-sm rounded-lg py-2.5 px-3.5 w-full min-h-[42px]\" \n                               placeholder=\"e.g., Do you drink coffee or tea before sleeping?\" \n                               data-answer=\"survey_q4\">\n                    </div>\n\n                    <!-- Q5 -->\n                    <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                            <span class=\"w-7 h-7 bg-slate-200 text-slate-700 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0\">5</span>\n                            <span class=\"text-sm font-semibold text-slate-700\">Question 5:</span>\n                        </div>\n                        <input type=\"text\" \n                               class=\"custom-input flex-1 bg-white border border-slate-300 text-slate-800 text-sm rounded-lg py-2.5 px-3.5 w-full min-h-[42px]\" \n                               placeholder=\"e.g., Do you use your phone in bed?\" \n                               data-answer=\"survey_q5\">\n                    </div>\n\n                    <!-- Q6 -->\n                    <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"flex items-center space-x-3 w-full sm:w-auto\">\n                            <span class=\"w-7 h-7 bg-slate-200 text-slate-700 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0\">6</span>\n                            <span class=\"text-sm font-semibold text-slate-700\">Question 6:</span>\n                        </div>\n                        <input type=\"text\" \n                               class=\"custom-input flex-1 bg-white border border-slate-300 text-slate-800 text-sm rounded-lg py-2.5 px-3.5 w-full min-h-[42px]\" \n                               placeholder=\"e.g., Do you ever have trouble falling asleep?\" \n                               data-answer=\"survey_q6\">\n                    </div>\n\n                </div>\n            </section>\n\n            <hr class=\"border-slate-200 my-6\">\n\n            <!-- SECTION B, C & D: INTERVIEW & COMPARE -->\n            <section class=\"space-y-6\">\n                \n                <!-- Part B -->\n                <div class=\"flex items-start space-x-3\">\n                    <span class=\"flex-shrink-0 w-8 h-8 bg-slate-900 text-white rounded-full flex items-center justify-center font-bold text-sm\">9b</span>\n                    <div>\n                        <h2 class=\"text-base font-bold text-slate-900\">Ask other students in the class. Write the answers.</h2>\n                        <p class=\"text-sm text-slate-600\">Use this interactive notepad to record the responses of your classmates during the interview.</p>\n                    </div>\n                </div>\n                \n                <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-6\">\n                    <label for=\"interview-notes\" class=\"block text-sm font-semibold text-slate-700 mb-2\">Classmate Interview Notes:</label>\n                    <textarea id=\"interview-notes\" rows=\"4\" class=\"custom-input w-full bg-white border border-slate-300 text-slate-800 text-sm rounded-lg p-3\" placeholder=\"Write classmate names and their answers here... (e.g., Anna sleeps 8 hours, goes to bed at 11 PM)\"></textarea>\n                </div>\n\n                <!-- Part C -->\n                <div class=\"flex items-start space-x-3 pt-2\">\n                    <span class=\"flex-shrink-0 w-8 h-8 bg-slate-900 text-white rounded-full flex items-center justify-center font-bold text-sm\">9c</span>\n                    <div>\n                        <h2 class=\"text-base font-bold text-slate-900\">Work in your groups. Compare answers.</h2>\n                        <p class=\"text-sm text-slate-600\">Summarize what your group found out together.</p>\n                    </div>\n                </div>\n\n                <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-6\">\n                    <label for=\"group-comparison\" class=\"block text-sm font-semibold text-slate-700 mb-2\">Group Comparison Notes:</label>\n                    <textarea id=\"group-comparison\" rows=\"4\" class=\"custom-input w-full bg-white border border-slate-300 text-slate-800 text-sm rounded-lg p-3\" placeholder=\"Compare similarities and differences in your group's sleep habits...\"></textarea>\n                </div>\n\n                <!-- Part D -->\n                <div class=\"flex items-start space-x-3 pt-2\">\n                    <span class=\"flex-shrink-0 w-8 h-8 bg-slate-900 text-white rounded-full flex items-center justify-center font-bold text-sm\">9d</span>\n                    <div>\n                        <h2 class=\"text-base font-bold text-slate-900\">Tell the class what you found out about other students.</h2>\n                        <p class=\"text-sm text-slate-600\">Draft your final presentation or summary sentence below.</p>\n                    </div>\n                </div>\n\n                <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-6\">\n                    <label for=\"class-presentation\" class=\"block text-sm font-semibold text-slate-700 mb-2\">Presentation Draft:</label>\n                    <textarea id=\"class-presentation\" rows=\"3\" class=\"custom-input w-full bg-white border border-slate-300 text-slate-800 text-sm rounded-lg p-3\" placeholder=\"e.g., Most students in our group sleep about 7 hours a night, but two people usually stay up late studying...\"></textarea>\n                </div>\n\n            </section>\n\n        </div>\n\n        <!-- FOOTER ACTIONS -->\n        <footer class=\"bg-slate-100 border-t border-slate-200 p-4 sm:p-6 flex items-center justify-between\">\n            <span class=\"text-xs text-slate-500 font-medium\">Interactive ELT Activity &bull; Exercise 9</span>\n            <button onclick=\"checkAnswers()\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-2.5 px-6 rounded-xl shadow-sm transition active:scale-95 min-h-[42px]\">\n                Validate Survey Questions\n            </button>\n        </footer>\n\n    </main>\n\n    <!-- ELT SCRIPT & METRICS CONTRACT -->\n    <script>\n        // Mandated Pedagogical Metrics Contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Speaking',\n            skill: 'sleep_survey_creation',\n            maxScore: 6\n        };\n\n        function checkAnswers() {\n            const inputs = document.querySelectorAll('#survey-questions-container input[data-answer]');\n            let correctCount = 0;\n\n            inputs.forEach(input => {\n                const val = input.value.trim();\n                // A valid question must not be empty and should ideally end with a question mark or contain typical interrogative words\n                if (val.length > 5) {\n                    input.classList.remove('border-slate-300', 'bg-white', 'border-red-500', 'bg-red-50');\n                    input.classList.add('border-emerald-500', 'bg-emerald-50');\n                    correctCount++;\n                } else {\n                    input.classList.remove('border-slate-300', 'bg-white', 'border-emerald-500', 'bg-emerald-50');\n                    input.classList.add('border-red-500', 'bg-red-50');\n                }\n            });\n\n            // Update Score Display\n            document.getElementById('score-display').textContent = `${correctCount} / ${inputs.length}`;\n\n            // Dispatch Mandated Custom Event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: inputs.length,\n                    completed: correctCount === inputs.length\n                }\n            }));\n\n            // PostMessage for iframe parent container\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ \n                    type: 'ACTIVITY_SCORE', \n                    score: correctCount, \n                    total: inputs.length \n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const inputs = document.querySelectorAll('#survey-questions-container input[data-answer]');\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('border-emerald-500', 'bg-emerald-50', 'border-red-500', 'bg-red-50');\n                input.classList.add('border-slate-300', 'bg-white');\n            });\n\n            document.getElementById('interview-notes').value = '';\n            document.getElementById('group-comparison').value = '';\n            document.getElementById('class-presentation').value = '';\n            document.getElementById('score-display').textContent = `0 / ${inputs.length}`;\n        }\n    </script>\n</body>\n</html>"
    }
  ]
}