{
  "version": "2.0",
  "title": "Int WB U2 Lesson 2A",
  "updatedAt": "2026-10-27T23:25:16.053Z",
  "slides": [
    {
      "id": 1793128271254,
      "title": "Actividad IA #3",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>2A Slow down! - Work collocations</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            touch-action: manipulation;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY TOP HEADER / SCORE PANEL -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center gap-2\">\n                <span class=\"bg-amber-100 text-amber-800 text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wide\">2A</span>\n                <h1 class=\"text-base font-bold text-slate-900 truncate\">Slow down! <span class=\"hidden sm:inline font-normal text-slate-500 text-sm\">| Work collocations</span></h1>\n            </div>\n            <div id=\"score-badge\" class=\"text-sm font-semibold bg-slate-100 text-slate-700 px-3 py-1 rounded-full border border-slate-200\">\n                Score: <span id=\"current-score\">0</span> / 10\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTENT AREA -->\n    <main class=\"w-full max-w-xl mx-auto p-4 md:p-6 flex-grow pb-24\">\n        \n        <!-- INSTRUCTIONS CARD -->\n        <div class=\"bg-blue-50 border border-blue-100 rounded-2xl p-4 mb-6 shadow-sm\">\n            <div class=\"flex items-start gap-3\">\n                <div class=\"bg-blue-500 text-white p-2 rounded-xl mt-0.5 shrink-0\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                </div>\n                <div>\n                    <h2 class=\"font-bold text-blue-900 text-sm md:text-base\">Put sentences a)–j) in the correct order</h2>\n                    <p class=\"text-blue-700 text-xs md:text-sm mt-0.5 font-medium\">Do you live to work ... or work to live?</p>\n                    <p class=\"text-slate-600 text-xs mt-2\">Select the correct sequence number (1 to 10) for each sentence fragment to form a cohesive text.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- EXERCISE CONTAINER -->\n        <div id=\"sentences-container\" class=\"space-y-3\">\n            <!-- Dynamically populated via JS for robust interaction & validation -->\n        </div>\n\n        <!-- ACTION BUTTONS -->\n        <div class=\"mt-8 flex items-center gap-3\">\n            <button id=\"check-btn\" onclick=\"checkAnswers()\" class=\"flex-1 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition-all text-sm md:text-base flex items-center justify-center gap-2 min-h-[46px]\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                Check Answers\n            </button>\n            <button id=\"reset-btn\" onclick=\"resetActivity()\" class=\"bg-slate-200 hover:bg-slate-300 active:bg-slate-400 text-slate-700 font-semibold py-3 px-4 rounded-xl transition-all text-sm md:text-base min-h-[46px] flex items-center justify-center\">\n                Reset\n            </button>\n        </div>\n\n        <!-- FEEDBACK BANNER -->\n        <div id=\"feedback-banner\" class=\"hidden mt-6 p-4 rounded-xl text-center font-medium text-sm transition-all\"></div>\n\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"text-center py-4 text-xs text-slate-400 border-t bg-white\">\n        Interactive English Learning Activity &bull; ELT Responsive App\n    </footer>\n\n    <!-- APP LOGIC -->\n    <script>\n        // Source sentences definition based on OCR Reference #1 & #2 Answer Key\n        const items = [\n            { id: 'a', text: \"Count the hours! Do you spend more than\", correctOrder: 1 },\n            { id: 'g', text: \"50 hours at work every week? Do you work\", correctOrder: 2 },\n            { id: 'b', text: \"long hours? And weekends? Do you often take\", correctOrder: 3 },\n            { id: 'd', text: \"work home with you or regularly work\", correctOrder: 4 },\n            { id: 'h', text: \"a few hours overtime? Of course, everyone has\", correctOrder: 5 },\n            { id: 'f', text: \"to meet deadlines and sometimes everyone is\", correctOrder: 6 },\n            { id: 'j', text: \"under pressure at work. But working\", correctOrder: 7 },\n            { id: 'c', text: \"long hours is an early sign you might be\", correctOrder: 8 },\n            { id: 'i', text: \"a workaholic. Find time to plan a holiday and take\", correctOrder: 9 },\n            { id: 'e', text: \"some time off. It's good for you!\", correctOrder: 10 }\n        ];\n\n        function renderActivity() {\n            const container = document.getElementById('sentences-container');\n            container.innerHTML = '';\n\n            items.forEach((item) => {\n                const card = document.createElement('div');\n                card.className = `flex items-center justify-between bg-white border border-slate-200 rounded-xl p-3 shadow-sm transition-all gap-3`;\n                card.id = `card-${item.id}`;\n\n                // Left side: letter badge and sentence text\n                const textWrapper = document.createElement('div');\n                textWrapper.className = 'flex items-center gap-3 flex-grow min-w-0';\n                \n                const letterBadge = document.createElement('span');\n                letterBadge.className = 'flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 font-bold text-slate-700 text-sm shrink-0 border border-slate-200';\n                letterBadge.textContent = item.id + ')';\n\n                const sentenceText = document.createElement('p');\n                sentenceText.className = 'text-slate-700 text-sm md:text-base truncate sm:text-clip sm:whitespace-normal font-normal';\n                sentenceText.textContent = item.text;\n\n                textWrapper.appendChild(letterBadge);\n                textWrapper.appendChild(sentenceText);\n\n                // Right side: Order Selector (1-10)\n                const selectWrapper = document.createElement('div');\n                selectWrapper.className = 'shrink-0';\n\n                const select = document.createElement('select');\n                select.id = `select-${item.id}`;\n                select.className = 'w-16 h-11 text-center font-bold text-slate-800 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none text-base cursor-pointer shadow-inner';\n                \n                // Default option\n                const defaultOpt = document.createElement('option');\n                defaultOpt.value = \"\";\n                defaultOpt.textContent = \"—\";\n                select.appendChild(defaultOpt);\n\n                // Populate options 1 to 10\n                for (let i = 1; i <= 10; i++) {\n                    const opt = document.createElement('option');\n                    opt.value = i;\n                    opt.textContent = i;\n                    select.appendChild(opt);\n                }\n\n                selectWrapper.appendChild(select);\n\n                card.appendChild(textWrapper);\n                card.appendChild(selectWrapper);\n                container.appendChild(card);\n            });\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalCount = items.length;\n\n            items.forEach((item) => {\n                const select = document.getElementById(`select-${item.id}`);\n                const card = document.getElementById(`card-${item.id}`);\n                const userVal = parseInt(select.value);\n\n                // Reset styles\n                card.classList.remove('border-emerald-500', 'bg-emerald-50/50', 'border-rose-500', 'bg-rose-50/50');\n                select.classList.remove('border-emerald-500', 'text-emerald-700', 'bg-emerald-50', 'border-rose-500', 'text-rose-700', 'bg-rose-50');\n\n                if (userVal === item.correctOrder) {\n                    correctCount++;\n                    card.classList.add('border-emerald-500', 'bg-emerald-50/40');\n                    select.classList.add('border-emerald-500', 'text-emerald-700', 'bg-emerald-50');\n                } else {\n                    card.classList.add('border-rose-300', 'bg-rose-50/30');\n                    select.classList.add('border-rose-400', 'text-rose-700', 'bg-rose-50');\n                }\n            });\n\n            // Update Score Badge\n            document.getElementById('current-score').textContent = correctCount;\n\n            // Feedback Banner\n            const banner = document.getElementById('feedback-banner');\n            banner.classList.remove('hidden');\n\n            if (correctCount === totalCount) {\n                banner.className = \"mt-6 p-4 rounded-xl text-center font-bold text-sm bg-emerald-100 text-emerald-800 border border-emerald-200 shadow-sm\";\n                banner.innerHTML = `🎉 Excellent! All sentences are in the correct order (${correctCount}/${totalCount}). Perfect work!`;\n            } else {\n                banner.className = \"mt-6 p-4 rounded-xl text-center font-bold text-sm bg-amber-100 text-amber-900 border border-amber-200 shadow-sm\";\n                banner.innerHTML = `⚠️ You got ${correctCount} out of ${totalCount} correct. Review the highlighted items and try again!`;\n            }\n\n            // Post score to parent container if embedded in iframe\n            window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: totalCount }, '*');\n        }\n\n        function resetActivity() {\n            renderActivity();\n            document.getElementById('current-score').textContent = '0';\n            const banner = document.getElementById('feedback-banner');\n            banner.classList.add('hidden');\n            banner.innerHTML = '';\n        }\n\n        // Initialize on load\n        window.addEventListener('DOMContentLoaded', renderActivity);\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793128382339,
      "title": "Actividad IA #3",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Modal Verbs Exercise - ELT Interactive</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .custom-select {\n            -webkit-appearance: none;\n            -moz-appearance: none;\n            appearance: none;\n            background-image: url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e\");\n            background-repeat: no-repeat;\n            background-position: right 0.5rem center;\n            background-size: 1em;\n            padding-right: 2rem;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY TOP-0 HEADER & SCOREBAR -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-2.5 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-3xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-indigo-100 text-indigo-700 font-semibold px-2.5 py-1 rounded-lg text-xs md:text-sm\">G2.1</span>\n                <h1 class=\"text-sm md:text-base font-bold text-slate-900 truncate\">Modal Verbs: Conversation</h1>\n            </div>\n            <div id=\"score-display\" class=\"text-xs md:text-sm font-medium bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full border border-slate-200\">\n                Score: <span id=\"correct-count\" class=\"font-bold text-indigo-600\">0</span> / <span id=\"total-count\">11</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTENT -->\n    <main class=\"w-full max-w-3xl mx-auto p-3 md:p-6 flex-grow mb-16\">\n        \n        <!-- INSTRUCTIONS & PHOTO CARD -->\n        <section class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-6 mb-6\">\n            <div class=\"flex items-start space-x-3 mb-4\">\n                <div class=\"bg-indigo-50 p-2 rounded-xl text-indigo-600 flex-shrink-0 mt-0.5\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"16\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"8\" x2=\"12.01\" y2=\"8\"></line></svg>\n                </div>\n                <div>\n                    <h2 class=\"font-bold text-slate-900 text-base md:text-lg\">Read the conversation and choose the correct verb form.</h2>\n                    <p class=\"text-xs md:text-sm text-slate-500\">Tap each dropdown to select the correct modal or semi-modal verb in context.</p>\n                </div>\n            </div>\n\n            <div class=\"w-full overflow-hidden rounded-xl border border-slate-100 mb-6 bg-slate-100\">\n                <img src=\"data:image/png;base64,\" alt=\"Conversation partners\" class=\"h-40 md:h-52 w-full object-cover rounded-xl shadow-sm\">\n            </div>\n\n            <!-- CONVERSATION INTERACTIVE CONTAINER -->\n            <div id=\"conversation-form\" class=\"space-y-4 text-sm md:text-base leading-relaxed bg-slate-50/50 p-4 md:p-6 rounded-xl border border-slate-100\">\n                \n                <!-- Line 1 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">JAKE:</span>\n                    <span>I'm really fed up with work.</span>\n                </div>\n\n                <!-- Line 2 (Item 1 is completed/example in OCR, let's include it or make interactive based on answer key. OCR answer key starts at item 2: \"2 have to\". Item 1 in text is \"don't have to/mustn't\". Let's make Item 1 interactive too! Answer key for #1 according to standard English: \"don't have to\") -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">KAY:</span>\n                    <div>\n                        Why? You \n                        <select data-id=\"1\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"don't have to\">don't have to</option>\n                            <option value=\"mustn't\">mustn't</option>\n                        </select>\n                        take work home like me.\n                    </div>\n                </div>\n\n                <!-- Line 3 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">JAKE:</span>\n                    <div>\n                        I know, but I \n                        <select data-id=\"2\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"have to\">have to</option>\n                            <option value=\"m able to\">'m able to</option>\n                        </select>\n                        work long hours and we're not \n                        <select data-id=\"3\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"allowed\">allowed</option>\n                            <option value=\"supposed\">supposed</option>\n                        </select>\n                        to be paid overtime.\n                    </div>\n                </div>\n\n                <!-- Line 4 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">KAY:</span>\n                    <div>\n                        You aren't paid overtime! You \n                        <select data-id=\"4\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"ought\">ought</option>\n                            <option value=\"'re supposed\">'re supposed</option>\n                        </select>\n                        to speak to your boss about that.\n                    </div>\n                </div>\n\n                <!-- Line 5 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">JAKE:</span>\n                    <div>\n                        I know. I \n                        <select data-id=\"5\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"should\">should</option>\n                            <option value=\"can\">can</option>\n                        </select>\n                        ask him about a promotion, too.\n                    </div>\n                </div>\n\n                <!-- Line 6 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">KAY:</span>\n                    <div>\n                        Are you \n                        <select data-id=\"6\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"allowed\">allowed</option>\n                            <option value=\"supposed\">supposed</option>\n                        </select>\n                        to work flexible hours?\n                    </div>\n                </div>\n\n                <!-- Line 7 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">JAKE:</span>\n                    <div>\n                        Yes, but we're \n                        <select data-id=\"7\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"allowed\">allowed</option>\n                            <option value=\"supposed\">supposed</option>\n                        </select>\n                        to be at work between ten and four.\n                    </div>\n                </div>\n\n                <!-- Line 8 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">KAY:</span>\n                    <div>\n                        And what about working at home? \n                        <select data-id=\"8\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"Can\">Can</option>\n                            <option value=\"Must\">Must</option>\n                        </select>\n                        you do that?\n                    </div>\n                </div>\n\n                <!-- Line 9 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">JAKE:</span>\n                    <div>\n                        We \n                        <select data-id=\"9\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"'re allowed to\">'re allowed to</option>\n                            <option value=\"must\">must</option>\n                        </select>\n                        work at home – but we have to ask our manager first. But I won't \n                        <select data-id=\"10\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"be able to\">be able to</option>\n                            <option value=\"can\">can</option>\n                        </select>\n                        work at home until I get my own flat.\n                    </div>\n                </div>\n\n                <!-- Line 10 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">KAY:</span>\n                    <div>\n                        Well, you \n                        <select data-id=\"11\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"must\">must</option>\n                            <option value=\"'re able to\">'re able to</option>\n                        </select>\n                        start saving!\n                    </div>\n                </div>\n\n                <!-- Line 11 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">JAKE:</span>\n                    <span>Yes, I know. I think I'm just a bit bored.</span>\n                </div>\n\n                <!-- Line 12 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2\">\n                    <span class=\"font-bold text-slate-700 min-w-[60px]\">KAY:</span>\n                    <div>\n                        Most work isn't interesting, I'm afraid. You \n                        <select data-id=\"12\" class=\"custom-select mx-1 my-1 bg-white border border-slate-300 rounded-lg py-2 px-3 text-sm md:text-base font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\">\n                            <option value=\"\">-- choose --</option>\n                            <option value=\"can\">can</option>\n                            <option value=\"ought\">ought</option>\n                        </select>\n                        to know that by now!\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- ACTION BUTTONS -->\n            <div class=\"mt-6 flex flex-col sm:flex-row items-center justify-between gap-3\">\n                <button id=\"reset-btn\" class=\"w-full sm:w-auto px-5 py-3 rounded-xl border border-slate-300 text-slate-700 font-semibold hover:bg-slate-100 active:bg-slate-200 transition-all min-h-[44px]\">\n                    Reset Answers\n                </button>\n                <button id=\"check-btn\" class=\"w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 text-white font-semibold hover:bg-indigo-700 active:bg-indigo-800 shadow-sm shadow-indigo-200 transition-all min-h-[44px]\">\n                    Check Answers\n                </button>\n            </div>\n        </section>\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"text-center py-4 text-xs text-slate-400 border-t border-slate-200 bg-white\">\n        Interactive ELT Exercise &bull; Modal Verbs Practice\n    </footer>\n\n    <!-- INTERACTION LOGIC SCRIPT -->\n    <script>\n        // Truth table based strictly on Answer Key OCR reference\n        const answerKey = {\n            \"1\": \"don't have to\",\n            \"2\": \"have to\",\n            \"3\": \"allowed\",\n            \"4\": \"ought\",\n            \"5\": \"should\",\n            \"6\": \"allowed\",\n            \"7\": \"supposed\",\n            \"8\": \"Can\",\n            \"9\": \"'re allowed to\",\n            \"10\": \"be able to\",\n            \"11\": \"must\",\n            \"12\": \"ought\"\n        };\n\n        const totalItems = Object.keys(answerKey).length;\n        document.getElementById('total-count').textContent = totalItems;\n\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const correctCountSpan = document.getElementById('correct-count');\n        const selects = document.querySelectorAll('select[data-id]');\n\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n\n            selects.forEach(select => {\n                const id = select.getAttribute('data-id');\n                const userVal = select.value.trim();\n                const correctVal = answerKey[id];\n\n                // Remove previous states\n                select.classList.remove('border-emerald-600', 'bg-emerald-50', 'text-emerald-900', 'border-rose-600', 'bg-rose-50', 'text-rose-900');\n\n                if (userVal === correctVal) {\n                    correctCount++;\n                    select.classList.add('border-emerald-600', 'bg-emerald-50', 'text-emerald-900', 'font-bold');\n                } else {\n                    select.classList.add('border-rose-600', 'bg-rose-50', 'text-rose-900');\n                }\n            });\n\n            correctCountSpan.textContent = correctCount;\n\n            // Post message to parent container if inside iframe\n            try {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalItems\n                }, '*');\n            } catch (e) {\n                console.log('Score transmission not available.');\n            }\n        });\n\n        resetBtn.addEventListener('click', () => {\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('border-emerald-600', 'bg-emerald-50', 'text-emerald-900', 'border-rose-600', 'bg-rose-50', 'text-rose-900', 'font-bold');\n            });\n            correctCountSpan.textContent = \"0\";\n\n            try {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: 0,\n                    total: totalItems\n                }, '*');\n            } catch (e) {}\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793141912287,
      "title": "Rewrite Sentences Exercise",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Rewrite Sentences Exercise</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .input-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .input-incorrect {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY HEADER / SCORE BAR -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-2.5 px-4 border-b w-full shadow-sm flex items-center justify-between\">\n        <div class=\"flex items-center space-x-2\">\n            <span class=\"bg-indigo-100 text-indigo-700 p-1.5 rounded-lg\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z\" />\n                </svg>\n            </span>\n            <h1 class=\"font-bold text-sm md:text-base text-slate-800\">Grammar Practice: Modals & Semi-Modals</h1>\n        </div>\n        <div id=\"score-display\" class=\"text-xs md:text-sm font-semibold bg-slate-100 px-3 py-1.5 rounded-full text-slate-600 border border-slate-200\">\n            Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">7</span>\n        </div>\n    </header>\n\n    <!-- MAIN CONTENT CONTAINER -->\n    <main class=\"w-full max-w-2xl mx-auto p-3 md:p-6 flex-grow mb-16\">\n        \n        <!-- INSTRUCTIONS CARD -->\n        <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 mb-5\">\n            <div class=\"flex items-start space-x-3\">\n                <div class=\"bg-amber-100 text-amber-700 p-2 rounded-xl mt-0.5\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                </div>\n                <div>\n                    <h2 class=\"font-bold text-slate-900 text-sm md:text-base\">3. Rewrite these sentences</h2>\n                    <p class=\"text-xs md:text-sm text-slate-600 mt-0.5\">Use the words in brackets to rewrite each sentence. Pay attention to structure and form (contractions are accepted where natural).</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- FORM / EXERCISE LIST -->\n        <form id=\"quiz-form\" class=\"space-y-4\" onsubmit=\"event.preventDefault();\">\n\n            <!-- Example (Read-only) -->\n            <div class=\"bg-slate-100/70 border border-slate-200/80 rounded-xl p-3.5 opacity-90\">\n                <div class=\"flex items-baseline space-x-2 text-xs md:text-sm\">\n                    <span class=\"font-bold text-slate-500\">1</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-slate-600\">My advice is to ask for a promotion. <span class=\"font-semibold text-indigo-600\">(should)</span></p>\n                        <p class=\"mt-1 text-slate-800 font-medium italic text-sm\">You <span class=\"text-emerald-700 font-semibold not-italic\">should ask for a promotion</span>.</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm\">\n                <div class=\"flex items-start space-x-2 text-xs md:text-sm\">\n                    <span class=\"font-bold text-slate-700 mt-2\">2</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-slate-700 mb-2\">If I were you, I'd take a week off. <span class=\"font-semibold text-indigo-600\">(ought)</span></p>\n                        <div class=\"flex items-center flex-wrap gap-1.5\">\n                            <span class=\"text-slate-700 font-medium\">You</span>\n                            <input type=\"text\" data-answer=\"ought to take a week off\" class=\"flex-1 min-w-[200px] border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\" placeholder=\"type answer...\">\n                        </div>\n                        <div class=\"feedback-msg text-xs mt-1.5 hidden font-medium\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm\">\n                <div class=\"flex items-start space-x-2 text-xs md:text-sm\">\n                    <span class=\"font-bold text-slate-700 mt-2\">3</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-slate-700 mb-2\">I can't meet you tonight. <span class=\"font-semibold text-indigo-600\">(not be able to)</span></p>\n                        <div class=\"flex items-center flex-wrap gap-1.5\">\n                            <span class=\"text-slate-700 font-medium\">I</span>\n                            <input type=\"text\" data-answer=\"am not able to meet you tonight\" class=\"flex-1 min-w-[200px] border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\" placeholder=\"type answer...\">\n                        </div>\n                        <div class=\"feedback-msg text-xs mt-1.5 hidden font-medium\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm\">\n                <div class=\"flex items-start space-x-2 text-xs md:text-sm\">\n                    <span class=\"font-bold text-slate-700 mt-2\">4</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-slate-700 mb-2\">It's against the rules to work at weekends. <span class=\"font-semibold text-indigo-600\">(allowed)</span></p>\n                        <div class=\"flex items-center flex-wrap gap-1.5\">\n                            <span class=\"text-slate-700 font-medium\">You</span>\n                            <input type=\"text\" data-answer=\"aren't allowed to work at weekends\" class=\"flex-1 min-w-[200px] border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\" placeholder=\"type answer...\">\n                        </div>\n                        <div class=\"feedback-msg text-xs mt-1.5 hidden font-medium\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm\">\n                <div class=\"flex items-start space-x-2 text-xs md:text-sm\">\n                    <span class=\"font-bold text-slate-700 mt-2\">5</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-slate-700 mb-2\">It isn't necessary to wear a tie. <span class=\"font-semibold text-indigo-600\">(not have to)</span></p>\n                        <div class=\"flex items-center flex-wrap gap-1.5\">\n                            <span class=\"text-slate-700 font-medium\">You</span>\n                            <input type=\"text\" data-answer=\"don't have to wear a tie\" class=\"flex-1 min-w-[200px] border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\" placeholder=\"type answer...\">\n                        </div>\n                        <div class=\"feedback-msg text-xs mt-1.5 hidden font-medium\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm\">\n                <div class=\"flex items-start space-x-2 text-xs md:text-sm\">\n                    <span class=\"font-bold text-slate-700 mt-2\">6</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-slate-700 mb-2\">It's necessary to arrive before 9 a.m. <span class=\"font-semibold text-indigo-600\">(must)</span></p>\n                        <div class=\"flex items-center flex-wrap gap-1.5\">\n                            <span class=\"text-slate-700 font-medium\">You</span>\n                            <input type=\"text\" data-answer=\"must arrive before 9 a.m.\" class=\"flex-1 min-w-[200px] border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\" placeholder=\"type answer...\">\n                        </div>\n                        <div class=\"feedback-msg text-xs mt-1.5 hidden font-medium\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm\">\n                <div class=\"flex items-start space-x-2 text-xs md:text-sm\">\n                    <span class=\"font-bold text-slate-700 mt-2\">7</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-slate-700 mb-2\">The company should give us holiday pay. <span class=\"font-semibold text-indigo-600\">(be supposed to)</span></p>\n                        <div class=\"flex items-center flex-wrap gap-1.5\">\n                            <span class=\"text-slate-700 font-medium\">The company</span>\n                            <input type=\"text\" data-answer=\"is supposed to give us holiday pay\" class=\"flex-1 min-w-[200px] border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\" placeholder=\"type answer...\">\n                        </div>\n                        <div class=\"feedback-msg text-xs mt-1.5 hidden font-medium\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm\">\n                <div class=\"flex items-start space-x-2 text-xs md:text-sm\">\n                    <span class=\"font-bold text-slate-700 mt-2\">8</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-slate-700 mb-2\">You aren't allowed to leave work before 4 p.m. <span class=\"font-semibold text-indigo-600\">(mustn't)</span></p>\n                        <div class=\"flex items-center flex-wrap gap-1.5\">\n                            <span class=\"text-slate-700 font-medium\">You</span>\n                            <input type=\"text\" data-answer=\"mustn't leave work before 4 p.m.\" class=\"flex-1 min-w-[200px] border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors\" placeholder=\"type answer...\">\n                        </div>\n                        <div class=\"feedback-msg text-xs mt-1.5 hidden font-medium\"></div>\n                    </div>\n                </div>\n            </div>\n\n        </form>\n    </main>\n\n    <!-- FIXED BOTTOM ACTION BAR -->\n    <nav class=\"fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 p-3 shadow-lg z-20 flex justify-center space-x-3\">\n        <button id=\"reset-btn\" type=\"button\" class=\"w-1/2 max-w-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 px-4 rounded-xl text-sm transition-colors min-h-[42px] flex items-center justify-center space-x-2\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n            </svg>\n            <span>Reset</span>\n        </button>\n        <button id=\"check-btn\" type=\"button\" class=\"w-1/2 max-w-xs bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-xl text-sm transition-colors min-h-[42px] flex items-center justify-center space-x-2 shadow-sm\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n            </svg>\n            <span>Check Answers</span>\n        </button>\n    </nav>\n\n    <!-- JAVASCRIPT LOGIC -->\n    <script>\n        const inputs = document.querySelectorAll('#quiz-form input[type=\"text\"]');\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const currentScoreEl = document.getElementById('current-score');\n        const totalScoreEl = document.getElementById('total-score');\n\n        const totalItems = inputs.length;\n        totalScoreEl.textContent = totalItems;\n\n        // Normalizer for flexible checking (removes punctuation variations, multiple spaces, lowercase conversion)\n        function normalizeText(text) {\n            return text.toLowerCase().trim().replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\").replace(/\\s{2,}/g,\" \");\n        }\n\n        // Acceptable alternative variations for specific items\n        const acceptableAnswers = {\n            1: [\"ought to take a week off\", \"ought to take a few days off\"], // index 0 refers to item 2 in UI\n            2: [\"am not able to meet you tonight\", \"'m not able to meet you tonight\"],\n            3: [\"aren't allowed to work at weekends\", \"are not allowed to work at weekends\"],\n            4: [\"don't have to wear a tie\", \"do not have to wear a tie\"],\n            5: [\"must arrive before 9 a.m.\", \"must arrive before 9 am\", \"must arrive before nine\"],\n            6: [\"is supposed to give us holiday pay\"],\n            7: [\"mustn't leave work before 4 p.m.\", \"must not leave work before 4 p.m.\", \"mustn't leave work before 4 pm\"]\n        };\n\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n\n            inputs.forEach((input, idx) => {\n                const userVal = input.value;\n                const feedbackDiv = input.parentElement.nextElementSibling;\n                const standardAnswer = input.getAttribute('data-answer');\n                \n                // Gather potential variants\n                let validOptions = [standardAnswer];\n                if (acceptableAnswers[idx]) {\n                    validOptions = validOptions.concat(acceptableAnswers[idx]);\n                }\n\n                const isMatch = validOptions.some(opt => normalizeText(userVal) === normalizeText(opt));\n\n                feedbackDiv.classList.remove('hidden');\n                input.classList.remove('input-correct', 'input-incorrect');\n\n                if (isMatch && userVal.trim() !== \"\") {\n                    input.classList.add('input-correct');\n                    feedbackDiv.textContent = \"Correct!\";\n                    feedbackDiv.className = \"feedback-msg text-xs mt-1.5 font-medium text-emerald-600\";\n                    correctCount++;\n                } else {\n                    input.classList.add('input-incorrect');\n                    feedbackDiv.textContent = `Correct answer: ${standardAnswer}`;\n                    feedbackDiv.className = \"feedback-msg text-xs mt-1.5 font-medium text-rose-600\";\n                }\n            });\n\n            currentScoreEl.textContent = correctCount;\n\n            // Post score to parent container/LMS iframe sandbox\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalItems\n            }, '*');\n        });\n\n        resetBtn.addEventListener('click', () => {\n            inputs.forEach(input => {\n                input.value = \"\";\n                input.classList.remove('input-correct', 'input-incorrect');\n                const feedbackDiv = input.parentElement.nextElementSibling;\n                feedbackDiv.classList.add('hidden');\n                feedbackDiv.textContent = \"\";\n            });\n            currentScoreEl.textContent = \"0\";\n            \n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: 0,\n                total: totalItems\n            }, '*');\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793142076163,
      "title": "Make Questions Exercise - ELT",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Make Questions Exercise - ELT</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom smooth transitions and focus states */\n        input:focus {\n            outline: none;\n            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY TOP HEADER / SCORE & CONTROLS -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n        <div class=\"max-w-3xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-blue-600 text-white p-2 rounded-xl flex items-center justify-center shadow-sm\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                    </svg>\n                </span>\n                <div>\n                    <h1 class=\"text-base font-bold text-slate-900 leading-tight\">Exercise 4a</h1>\n                    <p class=\"text-xs text-slate-500\">Make questions with these words</p>\n                </div>\n            </div>\n\n            <!-- Score Display -->\n            <div id=\"score-badge\" class=\"hidden items-center bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-full text-sm font-semibold text-slate-700\">\n                Score: <span id=\"score-val\" class=\"ml-1 text-blue-600 font-bold\">0 / 7</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTENT AREA -->\n    <main class=\"w-full max-w-3xl mx-auto p-4 md:p-6 flex-grow mb-12\">\n        \n        <!-- Instructions Card -->\n        <div class=\"bg-blue-50 border border-blue-200 rounded-2xl p-4 mb-6 shadow-sm flex items-start space-x-3\">\n            <svg class=\"w-6 h-6 text-blue-600 flex-shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n            </svg>\n            <div class=\"text-sm text-blue-900\">\n                <p class=\"font-semibold mb-0.5\">Instructions:</p>\n                Put the scrambled words in the correct order to form grammatically correct questions. Pay attention to punctuation and capitalization (include the question mark ?).\n            </div>\n        </div>\n\n        <!-- Questions Form -->\n        <form id=\"quiz-form\" class=\"space-y-6\" onsubmit=\"event.preventDefault();\">\n            \n            <!-- Item 1 (Example) -->\n            <div class=\"bg-white border border-slate-200 rounded-2xl p-4 shadow-sm relative\">\n                <div class=\"flex items-center justify-between mb-2\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Example</span>\n                    <span class=\"text-xs bg-emerald-100 text-emerald-800 font-medium px-2 py-0.5 rounded-full\">Completed</span>\n                </div>\n                <p class=\"text-xs sm:text-sm font-mono text-slate-600 bg-slate-50 p-2.5 rounded-xl mb-3 border border-slate-100\">\n                    ought / do / we / about / What / to / overtime ?\n                </p>\n                <div class=\"w-full bg-slate-100 text-slate-700 font-medium text-sm sm:text-base px-4 py-3 rounded-xl border border-slate-200\">\n                    What ought we to do about overtime?\n                </div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"question-card bg-white border border-slate-200 rounded-2xl p-4 shadow-sm transition-all\" data-id=\"2\">\n                <div class=\"flex items-center justify-between mb-2\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Question 2</span>\n                </div>\n                <p class=\"text-xs sm:text-sm font-mono text-slate-600 bg-slate-50 p-2.5 rounded-xl mb-3 border border-slate-100 select-all\">\n                    long hours / you / when you / have a / able / How are / to work / family ?\n                </p>\n                <input type=\"text\" data-answer=\"How are you able to work long hours when you have a family?\" \n                    class=\"w-full bg-white text-slate-800 text-sm sm:text-base px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 transition-colors\" \n                    placeholder=\"Type your question here...\">\n                <p class=\"feedback-text text-xs mt-2 hidden font-medium\"></p>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"question-card bg-white border border-slate-200 rounded-2xl p-4 shadow-sm transition-all\" data-id=\"3\">\n                <div class=\"flex items-center justify-between mb-2\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Question 3</span>\n                </div>\n                <p class=\"text-xs sm:text-sm font-mono text-slate-600 bg-slate-50 p-2.5 rounded-xl mb-3 border border-slate-100 select-all\">\n                    be / Should / at / of / work / we / pressure / a lot / under ?\n                </p>\n                <input type=\"text\" data-answer=\"Should we be under a lot of pressure at work?\" \n                    class=\"w-full bg-white text-slate-800 text-sm sm:text-base px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 transition-colors\" \n                    placeholder=\"Type your question here...\">\n                <p class=\"feedback-text text-xs mt-2 hidden font-medium\"></p>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"question-card bg-white border border-slate-200 rounded-2xl p-4 shadow-sm transition-all\" data-id=\"4\">\n                <div class=\"flex items-center justify-between mb-2\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Question 4</span>\n                </div>\n                <p class=\"text-xs sm:text-sm font-mono text-slate-600 bg-slate-50 p-2.5 rounded-xl mb-3 border border-slate-100 select-all\">\n                    we / to / he's / a / tell him that / workaholic / becoming / Ought ?\n                </p>\n                <input type=\"text\" data-answer=\"Ought we to tell him that he's becoming a workaholic?\" \n                    class=\"w-full bg-white text-slate-800 text-sm sm:text-base px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 transition-colors\" \n                    placeholder=\"Type your question here...\">\n                <p class=\"feedback-text text-xs mt-2 hidden font-medium\"></p>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"question-card bg-white border border-slate-200 rounded-2xl p-4 shadow-sm transition-all\" data-id=\"5\">\n                <div class=\"flex items-center justify-between mb-2\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Question 5</span>\n                </div>\n                <p class=\"text-xs sm:text-sm font-mono text-slate-600 bg-slate-50 p-2.5 rounded-xl mb-3 border border-slate-100 select-all\">\n                    wear / you / Are / informal / at your / allowed / clothes / to / work ?\n                </p>\n                <input type=\"text\" data-answer=\"Are you allowed to wear informal clothes at your work?\" \n                    class=\"w-full bg-white text-slate-800 text-sm sm:text-base px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 transition-colors\" \n                    placeholder=\"Type your question here...\">\n                <p class=\"feedback-text text-xs mt-2 hidden font-medium\"></p>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"question-card bg-white border border-slate-200 rounded-2xl p-4 shadow-sm transition-all\" data-id=\"6\">\n                <div class=\"flex items-center justify-between mb-2\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Question 6</span>\n                </div>\n                <p class=\"text-xs sm:text-sm font-mono text-slate-600 bg-slate-50 p-2.5 rounded-xl mb-3 border border-slate-100 select-all\">\n                    Do / to / the summer / time off / in / take / we / have ?\n                </p>\n                <input type=\"text\" data-answer=\"Do we have to take time off in the summer?\" \n                    class=\"w-full bg-white text-slate-800 text-sm sm:text-base px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 transition-colors\" \n                    placeholder=\"Type your question here...\">\n                <p class=\"feedback-text text-xs mt-2 hidden font-medium\"></p>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"question-card bg-white border border-slate-200 rounded-2xl p-4 shadow-sm transition-all\" data-id=\"7\">\n                <div class=\"flex items-center justify-between mb-2\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Question 7</span>\n                </div>\n                <p class=\"text-xs sm:text-sm font-mono text-slate-600 bg-slate-50 p-2.5 rounded-xl mb-3 border border-slate-100 select-all\">\n                    before December / take / all our / Are / supposed / we / holiday / to ?\n                </p>\n                <input type=\"text\" data-answer=\"Are we supposed to take all our holiday before December?\" \n                    class=\"w-full bg-white text-slate-800 text-sm sm:text-base px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 transition-colors\" \n                    placeholder=\"Type your question here...\">\n                <p class=\"feedback-text text-xs mt-2 hidden font-medium\"></p>\n            </div>\n\n            <!-- Action Buttons Container -->\n            <div class=\"flex items-center justify-between pt-4 pb-8 space-x-3\">\n                <button type=\"button\" id=\"reset-btn\" \n                    class=\"flex-1 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold py-3 px-4 rounded-xl transition-all min-h-[44px] flex items-center justify-center shadow-sm\">\n                    Reset\n                </button>\n                <button type=\"button\" id=\"check-btn\" \n                    class=\"flex-[2] bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl transition-all min-h-[44px] flex items-center justify-center shadow-md\">\n                    Check Answers\n                </button>\n            </div>\n        </form>\n    </main>\n\n    <!-- Footer sticky or regular -->\n    <footer class=\"bg-white border-t border-slate-200 py-3 text-center text-xs text-slate-400\">\n        Interactive ELT Learning Module &bull; Responsive Touch Optimized\n    </footer>\n\n    <!-- INTERACTIVE LOGIC SCRIPT -->\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const scoreBadge = document.getElementById('score-badge');\n            const scoreVal = document.getElementById('score-val');\n            const questionCards = document.querySelectorAll('.question-card');\n\n            // Helper to clean and normalize strings for precise checking (ignores extra whitespace & case)\n            function normalize(str) {\n                return str.trim().replace(/\\s+/g, ' ').toLowerCase().replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\");\n            }\n\n            checkBtn.addEventListener('click', () => {\n                let correctCount = 0;\n                const totalCount = questionCards.length;\n\n                questionCards.forEach(card => {\n                    const input = card.querySelector('input');\n                    const feedback = card.querySelector('.feedback-text');\n                    const correctAnswer = input.getAttribute('data-answer');\n                    const userVal = input.value;\n\n                    // Normalize comparison\n                    const isCorrect = normalize(userVal) === normalize(correctAnswer);\n\n                    // Remove previous styling\n                    card.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50/30', 'bg-rose-50/30');\n                    input.classList.remove('border-emerald-500', 'border-rose-500', 'text-emerald-900', 'text-rose-900');\n\n                    if (isCorrect) {\n                        correctCount++;\n                        card.classList.add('border-emerald-500', 'bg-emerald-50/30');\n                        input.classList.add('border-emerald-500', 'text-emerald-900');\n                        feedback.textContent = \"Correct! Great job.\";\n                        feedback.className = \"feedback-text text-xs mt-2 font-medium text-emerald-600 block\";\n                    } else {\n                        card.classList.add('border-rose-500', 'bg-rose-50/30');\n                        input.classList.add('border-rose-500', 'text-rose-900');\n                        feedback.textContent = `Correct answer: \"${correctAnswer}\"`;\n                        feedback.className = \"feedback-text text-xs mt-2 font-medium text-rose-600 block\";\n                    }\n                });\n\n                // Update UI Score\n                scoreVal.textContent = `${correctCount} / ${totalCount}`;\n                scoreBadge.classList.remove('hidden');\n                scoreBadge.classList.add('flex');\n\n                // Broadcast score to parent frame if embedded\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalCount\n                }, '*');\n\n                // Smooth scroll to top to see score badge easily on mobile\n                window.scrollTo({ top: 0, behavior: 'smooth' });\n            });\n\n            resetBtn.addEventListener('click', () => {\n                questionCards.forEach(card => {\n                    const input = card.querySelector('input');\n                    const feedback = card.querySelector('.feedback-text');\n\n                    input.value = '';\n                    card.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50/30', 'bg-rose-50/30');\n                    input.classList.remove('border-emerald-500', 'border-rose-500', 'text-emerald-900', 'text-rose-900');\n                    feedback.textContent = '';\n                    feedback.classList.add('hidden');\n                });\n\n                scoreBadge.classList.add('hidden');\n                scoreBadge.classList.remove('flex');\n                scoreVal.textContent = '0 / 7';\n            });\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 5,
      "title": "Match Questions & Answers - ELT Interactive",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Match Questions & Answers - ELT Interactive</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col\">\n\n    <!-- Sticky Header / Score & Title Bar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm flex items-center justify-between\">\n        <div class=\"flex items-center space-x-2\">\n            <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-inner flex items-center justify-center\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                </svg>\n            </div>\n            <div>\n                <h1 class=\"font-bold text-base md:text-lg text-slate-900 leading-tight\">Exercise 4b: Match Questions</h1>\n                <p class=\"text-xs text-slate-500\">Match questions 1–7 in 4a to answers a–g</p>\n            </div>\n        </div>\n        <div class=\"flex items-center space-x-3\">\n            <div class=\"bg-indigo-50 border border-indigo-100 text-indigo-700 px-3 py-1.5 rounded-xl font-semibold text-sm flex items-center gap-1.5 shadow-sm\">\n                <span>Score:</span>\n                <span id=\"score-display\">0</span>/<span id=\"total-display\">7</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-3 md:p-6 flex-1 space-y-6 pb-24\">\n\n        <!-- Reference Section: 4a Questions (Read-only as requested by teacher) -->\n        <section class=\"bg-white border border-slate-200/80 rounded-2xl p-4 md:p-6 shadow-sm\">\n            <div class=\"flex items-center justify-between mb-3 border-b pb-2\">\n                <h2 class=\"text-sm font-bold uppercase tracking-wider text-indigo-600 flex items-center gap-2\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                    Reference: 4a) Questions (Already solved)\n                </h2>\n                <span class=\"text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full font-medium\">Read-Only Help</span>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-slate-700\">\n                <div class=\"p-2.5 bg-slate-50 rounded-xl border border-slate-100\"><strong class=\"text-indigo-600\">1.</strong> What ought we to do about overtime?</div>\n                <div class=\"p-2.5 bg-slate-50 rounded-xl border border-slate-100\"><strong class=\"text-indigo-600\">2.</strong> How are you able to work long hours when you have a family?</div>\n                <div class=\"p-2.5 bg-slate-50 rounded-xl border border-slate-100\"><strong class=\"text-indigo-600\">3.</strong> Should we be under a lot of pressure at work?</div>\n                <div class=\"p-2.5 bg-slate-50 rounded-xl border border-slate-100\"><strong class=\"text-indigo-600\">4.</strong> Ought we to tell him that he's becoming a workaholic?</div>\n                <div class=\"p-2.5 bg-slate-50 rounded-xl border border-slate-100\"><strong class=\"text-indigo-600\">5.</strong> Are you allowed to wear informal clothes at your work?</div>\n                <div class=\"p-2.5 bg-slate-50 rounded-xl border border-slate-100\"><strong class=\"text-indigo-600\">6.</strong> Do we have to take time off in the summer?</div>\n                <div class=\"p-2.5 bg-slate-50 rounded-xl border border-slate-100 md:col-span-2\"><strong class=\"text-indigo-600\">7.</strong> Are we supposed to take all our holiday before December?</div>\n            </div>\n        </section>\n\n        <!-- Interactive Section: 4b Matching Activity -->\n        <section class=\"bg-white border border-slate-200/80 rounded-2xl p-4 md:p-6 shadow-sm\">\n            <div class=\"mb-4\">\n                <h2 class=\"text-base font-bold text-slate-900\">Interactive Matching (4b)</h2>\n                <p class=\"text-xs md:text-sm text-slate-500\">Select the corresponding question number (1–7) for each answer (a–g).</p>\n            </div>\n\n            <div id=\"matching-container\" class=\"space-y-3\">\n                <!-- Dynamic Items injected via JS -->\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Sticky Footer Actions -->\n    <footer class=\"fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur border-t p-3 shadow-lg z-20\">\n        <div class=\"max-w-4xl mx-auto flex items-center justify-between gap-3\">\n            <button id=\"reset-btn\" class=\"w-1/3 min-h-[46px] bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-xl transition-all flex items-center justify-center gap-2 active:scale-95\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                </svg>\n                Reset\n            </button>\n            <button id=\"check-btn\" class=\"w-2/3 min-h-[46px] bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl transition-all shadow-md shadow-indigo-200 flex items-center justify-center gap-2 active:scale-95\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                Check Answers\n            </button>\n        </div>\n    </footer>\n\n    <script>\n        // Data derived from OCR Reference Answer Key\n        // a) 1 (Given in book)\n        // b) 6\n        // c) 3\n        // d) 5\n        // e) 4\n        // f) 2\n        // g) 7\n        const items = [\n            { letter: 'a', text: \"I'm not sure. Perhaps we should speak to the manager.\", correct: '1', prefilled: true },\n            { letter: 'b', text: \"Yes, we do.\", correct: '6' },\n            { letter: 'c', text: \"No, but sometimes stress is good for your work.\", correct: '3' },\n            { letter: 'd', text: \"Yes, you are.\", correct: '5' },\n            { letter: 'e', text: \"Yes, we should. I don't think he knows.\", correct: '4' },\n            { letter: 'f', text: \"I get up early.\", correct: '2' },\n            { letter: 'g', text: \"Yes, we are.\", correct: '7' }\n        ];\n\n        const container = document.getElementById('matching-container');\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const scoreDisplay = document.getElementById('score-display');\n\n        function renderItems() {\n            container.innerHTML = '';\n            items.forEach((item, index) => {\n                const row = document.createElement('div');\n                row.className = \"flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 bg-slate-50 border border-slate-200/70 rounded-xl gap-3 transition-all\";\n                row.id = `row-${index}`;\n\n                const leftCol = document.createElement('div');\n                leftCol.className = \"flex items-start gap-3 w-full sm:w-auto flex-1\";\n                \n                const badge = document.createElement('span');\n                badge.className = \"font-bold text-indigo-600 bg-white border border-indigo-100 shadow-sm w-8 h-8 rounded-lg flex items-center justify-center shrink-0 text-sm\";\n                badge.textContent = item.letter + ')';\n\n                const textSpan = document.createElement('span');\n                textSpan.className = \"text-sm md:text-base text-slate-700 font-medium pt-1 sm:pt-0\";\n                textSpan.textContent = item.text;\n\n                leftCol.appendChild(badge);\n                leftCol.appendChild(textSpan);\n\n                const rightCol = document.createElement('div');\n                rightCol.className = \"flex items-center gap-2 w-full sm:w-auto justify-end\";\n\n                const selectLabel = document.createElement('span');\n                selectLabel.className = \"text-xs text-slate-400 font-medium sm:hidden\";\n                selectLabel.textContent = \"Match Q#:\";\n\n                const select = document.createElement('select');\n                select.className = \"w-full sm:w-24 min-h-[42px] px-3 bg-white border border-slate-300 rounded-xl text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm\";\n                select.id = `select-${index}`;\n\n                // Options\n                const defaultOpt = document.createElement('option');\n                defaultOpt.value = \"\";\n                defaultOpt.textContent = \"— Select —\";\n                select.appendChild(defaultOpt);\n\n                for (let i = 1; i <= 7; i++) {\n                    const opt = document.createElement('option');\n                    opt.value = i;\n                    opt.textContent = `Q ${i}`;\n                    select.appendChild(opt);\n                }\n\n                if (item.prefilled) {\n                    select.value = item.correct;\n                    select.disabled = true;\n                    row.classList.add('bg-indigo-50/40', 'border-indigo-100');\n                }\n\n                rightCol.appendChild(selectLabel);\n                rightCol.appendChild(select);\n\n                row.appendChild(leftCol);\n                row.appendChild(rightCol);\n                container.appendChild(row);\n            });\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            let totalCount = items.length;\n\n            items.forEach((item, index) => {\n                const select = document.getElementById(`select-${index}`);\n                const row = document.getElementById(`row-${index}`);\n                const val = select.value;\n\n                // Remove previous styles\n                row.classList.remove('bg-emerald-50', 'border-emerald-300', 'bg-rose-50', 'border-rose-300', 'bg-indigo-50/40');\n                select.classList.remove('border-emerald-500', 'text-emerald-700', 'border-rose-500', 'text-rose-700', 'bg-emerald-50', 'bg-rose-50');\n\n                if (val === item.correct) {\n                    correctCount++;\n                    if (!item.prefilled) {\n                        row.classList.add('bg-emerald-50/70', 'border-emerald-200');\n                        select.classList.add('border-emerald-400', 'text-emerald-800', 'bg-emerald-50');\n                    } else {\n                        row.classList.add('bg-indigo-50/40', 'border-indigo-100');\n                    }\n                } else {\n                    if (!item.prefilled) {\n                        row.classList.add('bg-rose-50/70', 'border-rose-200');\n                        select.classList.add('border-rose-400', 'text-rose-800', 'bg-rose-50');\n                    }\n                }\n            });\n\n            scoreDisplay.textContent = correctCount;\n\n            // Post message for parent frame reporting score\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        }\n\n        function resetActivity() {\n            items.forEach((item, index) => {\n                const select = document.getElementById(`select-${index}`);\n                const row = document.getElementById(`row-${index}`);\n                \n                row.classList.remove('bg-emerald-50/70', 'border-emerald-200', 'bg-rose-50/70', 'border-rose-200', 'bg-indigo-50/40', 'border-indigo-100');\n                select.classList.remove('border-emerald-400', 'text-emerald-800', 'bg-emerald-50', 'border-rose-400', 'text-rose-800', 'bg-rose-50');\n\n                if (!item.prefilled) {\n                    select.value = \"\";\n                } else {\n                    row.classList.add('bg-indigo-50/40', 'border-indigo-100');\n                }\n            });\n            scoreDisplay.textContent = '0';\n        }\n\n        checkBtn.addEventListener('click', checkAnswers);\n        resetBtn.addEventListener('click', resetActivity);\n\n        // Initial render\n        renderItems();\n        // Set prefilled initial score reflection\n        scoreDisplay.textContent = '1'; // item 'a' is prefilled correct\n    </script>\n</body>\n</html>"
    }
  ]
}