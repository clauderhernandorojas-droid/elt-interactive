{
  "version": "2.0",
  "title": "Int WB U2 Lesson 2C",
  "updatedAt": "2026-10-28T18:27:09.642Z",
  "slides": [
    {
      "id": 1793210232091,
      "title": "Sleep - Vocabulary Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Sleep - Vocabulary Practice</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            -webkit-tap-highlight-color: transparent;\n        }\n        .touch-target {\n            min-height: 44px;\n            min-width: 44px;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col\">\n\n    <!-- Sticky Top Bar / Score Header -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm flex items-center justify-between\">\n        <div class=\"flex items-center space-x-2\">\n            <span class=\"bg-indigo-100 text-indigo-700 p-2 rounded-xl\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z\" />\n                </svg>\n            </span>\n            <div>\n                <h1 class=\"text-base font-bold text-slate-900 leading-tight\">Sleep & Dreams</h1>\n                <p class=\"text-xs text-slate-500\">Vocabulary Builder</p>\n            </div>\n        </div>\n        \n        <div class=\"flex items-center space-x-3\">\n            <div id=\"score-badge\" class=\"hidden items-center bg-indigo-50 border border-indigo-100 text-indigo-700 px-3 py-1 rounded-full text-xs font-semibold\">\n                Score: <span id=\"score-count\" class=\"ml-1 font-bold\">0</span>/<span id=\"total-count\">7</span>\n            </div>\n            <button onclick=\"resetActivity()\" class=\"touch-target flex items-center justify-center p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-xl transition\" title=\"Reset activity\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                </svg>\n            </button>\n        </div>\n    </header>\n\n    <!-- Main Content Container -->\n    <main class=\"w-full max-w-2xl mx-auto p-4 md:p-6 flex-grow flex flex-col space-y-6 pb-24\">\n        \n        <!-- Instructions Card -->\n        <section class=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-100\">\n            <div class=\"flex items-start space-x-3\">\n                <span class=\"bg-amber-100 text-amber-700 p-2 rounded-xl flex-shrink-0 mt-0.5\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                </span>\n                <div>\n                    <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-500\">Exercise 1</h2>\n                    <p class=\"text-slate-700 text-sm md:text-base font-medium mt-0.5\">\n                        Replace the phrases in <strong>bold</strong> with the correct form of the phrases in the box.\n                    </p>\n                </div>\n            </div>\n\n            <!-- Vocabulary Bank -->\n            <div class=\"mt-4 pt-4 border-t border-slate-100\">\n                <p class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2\">Word Bank</p>\n                <div class=\"flex flex-wrap gap-2\">\n                    <span class=\"inline-block bg-slate-100 text-slate-600 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium line-through opacity-75\">take a nap</span>\n                    <span class=\"inline-block bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium border border-indigo-100\">have a lie-in</span>\n                    <span class=\"inline-block bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium border border-indigo-100\">have nightmares</span>\n                    <span class=\"inline-block bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium border border-indigo-100\">not sleep a wink</span>\n                    <span class=\"inline-block bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium border border-indigo-100\">doze off</span>\n                    <span class=\"inline-block bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium border border-indigo-100\">get back to sleep</span>\n                    <span class=\"inline-block bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium border border-indigo-100\">be fast asleep</span>\n                    <span class=\"inline-block bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium border border-indigo-100\">be a light sleeper</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- Interactive Sentences Form -->\n        <form id=\"quiz-form\" class=\"space-y-4\" onsubmit=\"event.preventDefault(); checkAnswers();\">\n            \n            <!-- Item 1 (Example Completed) -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 flex items-start space-x-3 opacity-80\">\n                <span class=\"flex-shrink-0 bg-slate-100 text-slate-600 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">1</span>\n                <div class=\"flex-grow text-sm md:text-base text-slate-700\">\n                    My grandparents often <span class=\"line-through text-slate-400\">have a short sleep</span> <span class=\"inline-block bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded font-semibold text-xs ml-1\">take a nap</span> after lunch.\n                </div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 flex items-start space-x-3\">\n                <span class=\"flex-shrink-0 bg-indigo-50 text-indigo-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">2</span>\n                <div class=\"flex-grow space-y-2\">\n                    <p class=\"text-sm md:text-base text-slate-800\">\n                        I <span class=\"font-semibold underline decoration-indigo-300 decoration-2\">haven't had bad dreams</span> for a long time.\n                    </p>\n                    <select name=\"q2\" data-answer=\"haven't had nightmares\" class=\"touch-target w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                        <option value=\"\">-- Choose correct phrase --</option>\n                        <option value=\"haven't had nightmares\">haven't had nightmares</option>\n                        <option value=\"didn't sleep a wink\">didn't sleep a wink</option>\n                        <option value=\"dozes off\">dozes off</option>\n                        <option value=\"having a lie-in\">having a lie-in</option>\n                        <option value=\"get back to sleep\">get back to sleep</option>\n                        <option value=\"is fast asleep\">is fast asleep</option>\n                        <option value=\"is a light sleeper\">is a light sleeper</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 flex items-start space-x-3\">\n                <span class=\"flex-shrink-0 bg-indigo-50 text-indigo-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">3</span>\n                <div class=\"flex-grow space-y-2\">\n                    <p class=\"text-sm md:text-base text-slate-800\">\n                        I <span class=\"font-semibold underline decoration-indigo-300 decoration-2\">didn't sleep at all</span> last night.\n                    </p>\n                    <select name=\"q3\" data-answer=\"didn't sleep a wink\" class=\"touch-target w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                        <option value=\"\">-- Choose correct phrase --</option>\n                        <option value=\"haven't had nightmares\">haven't had nightmares</option>\n                        <option value=\"didn't sleep a wink\">didn't sleep a wink</option>\n                        <option value=\"dozes off\">dozes off</option>\n                        <option value=\"having a lie-in\">having a lie-in</option>\n                        <option value=\"get back to sleep\">get back to sleep</option>\n                        <option value=\"is fast asleep\">is fast asleep</option>\n                        <option value=\"is a light sleeper\">is a light sleeper</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 flex items-start space-x-3\">\n                <span class=\"flex-shrink-0 bg-indigo-50 text-indigo-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">4</span>\n                <div class=\"flex-grow space-y-2\">\n                    <p class=\"text-sm md:text-base text-slate-800\">\n                        My dad often <span class=\"font-semibold underline decoration-indigo-300 decoration-2\">falls asleep for a short time</span> in front of the TV.\n                    </p>\n                    <select name=\"q4\" data-answer=\"dozes off\" class=\"touch-target w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                        <option value=\"\">-- Choose correct phrase --</option>\n                        <option value=\"haven't had nightmares\">haven't had nightmares</option>\n                        <option value=\"didn't sleep a wink\">didn't sleep a wink</option>\n                        <option value=\"dozes off\">dozes off</option>\n                        <option value=\"having a lie-in\">having a lie-in</option>\n                        <option value=\"get back to sleep\">get back to sleep</option>\n                        <option value=\"is fast asleep\">is fast asleep</option>\n                        <option value=\"is a light sleeper\">is a light sleeper</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 flex items-start space-x-3\">\n                <span class=\"flex-shrink-0 bg-indigo-50 text-indigo-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">5</span>\n                <div class=\"flex-grow space-y-2\">\n                    <p class=\"text-sm md:text-base text-slate-800\">\n                        I love <span class=\"font-semibold underline decoration-indigo-300 decoration-2\">staying in bed</span> on a Sunday morning.\n                    </p>\n                    <select name=\"q5\" data-answer=\"having a lie-in\" class=\"touch-target w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                        <option value=\"\">-- Choose correct phrase --</option>\n                        <option value=\"haven't had nightmares\">haven't had nightmares</option>\n                        <option value=\"didn't sleep a wink\">didn't sleep a wink</option>\n                        <option value=\"dozes off\">dozes off</option>\n                        <option value=\"having a lie-in\">having a lie-in</option>\n                        <option value=\"get back to sleep\">get back to sleep</option>\n                        <option value=\"is fast asleep\">is fast asleep</option>\n                        <option value=\"is a light sleeper\">is a light sleeper</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 flex items-start space-x-3\">\n                <span class=\"flex-shrink-0 bg-indigo-50 text-indigo-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">6</span>\n                <div class=\"flex-grow space-y-2\">\n                    <p class=\"text-sm md:text-base text-slate-800\">\n                        He often wakes up early, but he finds it easy to <span class=\"font-semibold underline decoration-indigo-300 decoration-2\">go to sleep again</span>.\n                    </p>\n                    <select name=\"q6\" data-answer=\"get back to sleep\" class=\"touch-target w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                        <option value=\"\">-- Choose correct phrase --</option>\n                        <option value=\"haven't had nightmares\">haven't had nightmares</option>\n                        <option value=\"didn't sleep a wink\">didn't sleep a wink</option>\n                        <option value=\"dozes off\">dozes off</option>\n                        <option value=\"having a lie-in\">having a lie-in</option>\n                        <option value=\"get back to sleep\">get back to sleep</option>\n                        <option value=\"is fast asleep\">is fast asleep</option>\n                        <option value=\"is a light sleeper\">is a light sleeper</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 flex items-start space-x-3\">\n                <span class=\"flex-shrink-0 bg-indigo-50 text-indigo-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">7</span>\n                <div class=\"flex-grow space-y-2\">\n                    <p class=\"text-sm md:text-base text-slate-800\">\n                        You won't be able to wake him up. He's <span class=\"font-semibold underline decoration-indigo-300 decoration-2\">in a deep sleep</span>.\n                    </p>\n                    <select name=\"q7\" data-answer=\"is fast asleep\" class=\"touch-target w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                        <option value=\"\">-- Choose correct phrase --</option>\n                        <option value=\"haven't had nightmares\">haven't had nightmares</option>\n                        <option value=\"didn't sleep a wink\">didn't sleep a wink</option>\n                        <option value=\"dozes off\">dozes off</option>\n                        <option value=\"having a lie-in\">having a lie-in</option>\n                        <option value=\"get back to sleep\">get back to sleep</option>\n                        <option value=\"is fast asleep\">is fast asleep</option>\n                        <option value=\"is a light sleeper\">is a light sleeper</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 flex items-start space-x-3\">\n                <span class=\"flex-shrink-0 bg-indigo-50 text-indigo-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">8</span>\n                <div class=\"flex-grow space-y-2\">\n                    <p class=\"text-sm md:text-base text-slate-800\">\n                        Shhhh! My brother <span class=\"font-semibold underline decoration-indigo-300 decoration-2\">wakes up very easily</span>.\n                    </p>\n                    <select name=\"q8\" data-answer=\"is a light sleeper\" class=\"touch-target w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                        <option value=\"\">-- Choose correct phrase --</option>\n                        <option value=\"haven't had nightmares\">haven't had nightmares</option>\n                        <option value=\"didn't sleep a wink\">didn't sleep a wink</option>\n                        <option value=\"dozes off\">dozes off</option>\n                        <option value=\"having a lie-in\">having a lie-in</option>\n                        <option value=\"get back to sleep\">get back to sleep</option>\n                        <option value=\"is fast asleep\">is fast asleep</option>\n                        <option value=\"is a light sleeper\">is a light sleeper</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Action Buttons Footer -->\n            <div class=\"pt-4 flex items-center justify-end space-x-3\">\n                <button type=\"button\" onclick=\"resetActivity()\" class=\"touch-target px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-100 transition\">\n                    Reset\n                </button>\n                <button type=\"submit\" class=\"touch-target px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold text-sm hover:bg-indigo-700 shadow-sm shadow-indigo-200 transition\">\n                    Check Answers\n                </button>\n            </div>\n        </form>\n\n    </main>\n\n    <!-- Interactive Script -->\n    <script>\n        const totalItems = 7; // Items 2 through 8\n\n        function checkAnswers() {\n            const form = document.getElementById('quiz-form');\n            const selects = form.querySelectorAll('select');\n            let correctCount = 0;\n\n            selects.forEach(select => {\n                const userAnswer = select.value.trim().toLowerCase();\n                const correctAnswer = select.getAttribute('data-answer').toLowerCase();\n\n                // Remove previous validation styles\n                select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900');\n\n                if (!userAnswer) {\n                    select.classList.add('border-slate-300');\n                    return;\n                }\n\n                if (userAnswer === correctAnswer) {\n                    select.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n                    correctCount++;\n                } else {\n                    select.classList.add('border-red-500', 'bg-red-50', 'text-red-900');\n                }\n            });\n\n            // Update UI Score Badge\n            const scoreBadge = document.getElementById('score-badge');\n            const scoreCount = document.getElementById('score-count');\n            const totalCount = document.getElementById('total-count');\n\n            scoreCount.textContent = correctCount;\n            totalCount.textContent = totalItems;\n            scoreBadge.classList.remove('hidden');\n            scoreBadge.classList.add('flex');\n\n            // Post score to parent container if applicable\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalItems\n                }, '*');\n            }\n\n            // Smooth scroll to top to see score indicator if on mobile\n            window.scrollTo({ top: 0, behavior: 'smooth' });\n        }\n\n        function resetActivity() {\n            const form = document.getElementById('quiz-form');\n            const selects = form.querySelectorAll('select');\n\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900');\n                select.classList.add('border-slate-300');\n            });\n\n            const scoreBadge = document.getElementById('score-badge');\n            scoreBadge.classList.add('hidden');\n            scoreBadge.classList.remove('flex');\n            \n            window.scrollTo({ top: 0, behavior: 'smooth' });\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793210388777,
      "title": "Reading - The science of sleep",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Reading - The science of sleep</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- Header / Barra superior sticky para máxima ergonomía móvil -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-6 border-b border-slate-200 shadow-sm w-full\">\n    <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n      <div>\n        <span class=\"inline-block bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md mb-1\">\n          Reading • Exercise 2\n        </span>\n        <h1 class=\"text-xl sm:text-2xl font-black text-slate-900 tracking-tight\">\n          The science of sleep\n        </h1>\n      </div>\n      <div class=\"flex items-center gap-2.5 w-full sm:w-auto justify-end\">\n        <button onclick=\"checkHeadings()\" class=\"flex-1 sm:flex-none bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-5 py-2.5 rounded-xl shadow-sm transition-all active:scale-95 min-h-[42px] flex items-center justify-center gap-2 cursor-pointer\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"></path></svg>\n          Check Answers\n        </button>\n        <button onclick=\"resetHeadings()\" class=\"bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold px-3.5 py-2.5 rounded-xl transition-all active:scale-95 min-h-[42px] min-w-[42px] flex items-center justify-center cursor-pointer\" title=\"Reset activity\">\n          🔄\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Contenedor Principal -->\n  <main class=\"w-full max-w-4xl mx-auto p-3 sm:p-6 flex-grow\">\n    \n    <!-- Banco de Headings (Pool) -->\n    <section class=\"bg-slate-100/80 border border-slate-200 rounded-2xl p-4 sm:p-5 mb-6 shadow-xs\">\n      <h2 class=\"text-xs font-black uppercase tracking-wider text-slate-500 mb-2 flex items-center gap-1.5\">\n        <svg class=\"w-4 h-4 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n        Headings a)–c)\n      </h2>\n      <ul class=\"list-none space-y-1.5 text-sm sm:text-base text-slate-700 font-medium\">\n        <li class=\"flex items-start gap-2\">\n          <span class=\"font-bold text-indigo-600\">a)</span> <span>How much sleep do we need?</span>\n        </li>\n        <li class=\"flex items-start gap-2\">\n          <span class=\"font-bold text-indigo-600\">b)</span> <span>Why do we sleep?</span>\n        </li>\n        <li class=\"flex items-start gap-2\">\n          <span class=\"font-bold text-indigo-600\">c)</span> <span>What happens when we go to sleep?</span>\n        </li>\n      </ul>\n    </section>\n\n    <!-- Tarjeta del Artículo -->\n    <article class=\"bg-white border border-slate-200/80 rounded-2xl p-4 sm:p-7 shadow-xs\">\n      \n      <!-- Lead / Introducción -->\n      <blockquote class=\"text-sm sm:text-base leading-relaxed text-slate-600 italic bg-indigo-50/40 p-4 sm:p-5 border-l-4 border-indigo-500 rounded-xl mb-6\">\n        \"Sleep is one of the body's most mysterious experiences. Scientists don't completely understand the process, but it seems that all living things need some sleep. And some need a lot more than others!\"\n      </blockquote>\n\n      <!-- Párrafo 1 -->\n      <section class=\"mb-6 bg-slate-50/50 border border-slate-200/60 rounded-xl p-4 sm:p-5\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center gap-3 mb-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-extrabold text-sm flex items-center justify-center\">1</span>\n          <select class=\"heading-select w-full sm:max-w-md px-3.5 py-2.5 rounded-xl border-2 border-slate-300 bg-white text-sm sm:text-base font-semibold text-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all cursor-pointer min-h-[44px]\" data-answer=\"c\">\n            <option value=\"\">-- Choose heading for paragraph 1 --</option>\n            <option value=\"a\">a) How much sleep do we need?</option>\n            <option value=\"b\">b) Why do we sleep?</option>\n            <option value=\"c\">c) What happens when we go to sleep?</option>\n          </select>\n        </div>\n        <p class=\"text-sm sm:text-base leading-relaxed text-slate-700 m-0 pl-0 sm:pl-11\">\n          There are five stages of sleep: stages 1, 2, 3, 4 and REM (rapid* eye movement). In stages 1 to 4 our body becomes more relaxed. Our muscles and heart rate slow down and our brain becomes less active. Stage 5 is called REM sleep. Our heart beats faster and our eyes move quickly in different directions. People dream during this stage and we cannot move at all – probably to stop us from doing the actions in our dreams.\n        </p>\n      </section>\n\n      <!-- Párrafo 2 -->\n      <section class=\"mb-6 bg-slate-50/50 border border-slate-200/60 rounded-xl p-4 sm:p-5\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center gap-3 mb-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-extrabold text-sm flex items-center justify-center\">2</span>\n          <select class=\"heading-select w-full sm:max-w-md px-3.5 py-2.5 rounded-xl border-2 border-slate-300 bg-white text-sm sm:text-base font-semibold text-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all cursor-pointer min-h-[44px]\" data-answer=\"b\">\n            <option value=\"\">-- Choose heading for paragraph 2 --</option>\n            <option value=\"a\">a) How much sleep do we need?</option>\n            <option value=\"b\">b) Why do we sleep?</option>\n            <option value=\"c\">c) What happens when we go to sleep?</option>\n          </select>\n        </div>\n        <p class=\"text-sm sm:text-base leading-relaxed text-slate-700 m-0 pl-0 sm:pl-11\">\n          An average person spends almost a third of their life sleeping! Is it a waste of time? Scientists believe that when the heart and brain slow down, the body is recovering* after the day's work. They also think that REM sleep is important for memory and learning – babies have twice as much REM sleep as adults.\n        </p>\n      </section>\n\n      <!-- Párrafo 3 -->\n      <section class=\"mb-4 bg-slate-50/50 border border-slate-200/60 rounded-xl p-4 sm:p-5\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center gap-3 mb-3\">\n          <span class=\"flex-shrink-0 w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-extrabold text-sm flex items-center justify-center\">3</span>\n          <select class=\"heading-select w-full sm:max-w-md px-3.5 py-2.5 rounded-xl border-2 border-slate-300 bg-white text-sm sm:text-base font-semibold text-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all cursor-pointer min-h-[44px]\" data-answer=\"a\">\n            <option value=\"\">-- Choose heading for paragraph 3 --</option>\n            <option value=\"a\">a) How much sleep do we need?</option>\n            <option value=\"b\">b) Why do we sleep?</option>\n            <option value=\"c\">c) What happens when we go to sleep?</option>\n          </select>\n        </div>\n        <p class=\"text-sm sm:text-base leading-relaxed text-slate-700 m-0 pl-0 sm:pl-11\">\n          On average an adult needs about 7–8 hours' sleep every day. A baby needs 12–16. In the animal world, bats sleep for about 20 hours every day. But a giraffe sleeps for only an hour or two every night.\n        </p>\n      </section>\n\n      <!-- Glosario -->\n      <footer class=\"mt-6 pt-4 border-t border-dashed border-slate-200 text-xs sm:text-sm text-slate-500 space-y-1\">\n        <div><strong>*rapid</strong> = very quick</div>\n        <div><strong>*recover</strong> = get back your strength</div>\n      </footer>\n\n    </article>\n  </main>\n\n  <!-- Footer general -->\n  <footer class=\"w-full py-4 text-center text-xs text-slate-400 border-t border-slate-100 mt-6\">\n    Interactive Reading Exercise • ELT Digital Content\n  </footer>\n\n  <!-- Script de Interactividad y Calificación -->\n  <script>\n    function checkHeadings() {\n      const selects = document.querySelectorAll('.heading-select');\n      let correctCount = 0;\n      const totalCount = selects.length;\n\n      selects.forEach(sel => {\n        const selected = sel.value;\n        const correct = sel.dataset.answer;\n        \n        // Limpiar clases previas\n        sel.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900', 'border-slate-300');\n\n        if (selected === correct) {\n          sel.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n          correctCount++;\n        } else if (selected !== '') {\n          sel.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n        } else {\n          sel.classList.add('border-slate-300');\n        }\n      });\n\n      // Emitir evento de puntuación al contenedor padre si existe\n      if (window.parent) {\n        window.parent.postMessage({\n          type: 'ACTIVITY_SCORE',\n          score: correctCount,\n          total: totalCount\n        }, '*');\n      }\n    }\n\n    function resetHeadings() {\n      const selects = document.querySelectorAll('.heading-select');\n      selects.forEach(sel => {\n        sel.value = '';\n        sel.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n        sel.classList.add('border-slate-300');\n      });\n\n      if (window.parent) {\n        window.parent.postMessage({\n          type: 'ACTIVITY_SCORE',\n          score: 0,\n          total: selects.length\n        }, '*');\n      }\n    }\n  </script>\n\n</body>\n</html>"
    },
    {
      "id": 1793211818955,
      "title": "The Science of Sleep - Interactive Reading Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>The Science of Sleep - Interactive Reading Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY HEADER WITH SCORE COUNTER & PROGRESS -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-2.5 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-3xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-indigo-100 text-indigo-700 font-bold p-2 rounded-lg text-xs md:text-sm flex items-center gap-1.5\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                    Reading Comprehension\n                </span>\n            </div>\n            <div id=\"score-badge\" class=\"font-semibold text-sm bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full border border-slate-200 transition-all\">\n                Score: <span id=\"current-score\" class=\"text-indigo-600 font-bold\">0</span> / <span id=\"total-questions\">6</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTENT CONTAINER -->\n    <main class=\"w-full max-w-3xl mx-auto p-3 md:p-6 flex-grow space-y-6\">\n\n        <!-- TITLE & INTRO -->\n        <section class=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-100\">\n            <h1 class=\"text-xl md:text-2xl font-bold text-slate-900 mb-2\">The science of sleep</h1>\n            <p class=\"text-sm text-slate-600 leading-relaxed\">\n                Sleep is one of the body's most mysterious experiences. Scientists don't completely understand the process, but it seems that all living things need some sleep. And some need a lot more than others!\n            </p>\n        </section>\n\n        <!-- REFERENCE ARTICLE ACCORDION / TOGGLE -->\n        <section class=\"bg-indigo-50/50 rounded-2xl border border-indigo-100 overflow-hidden\">\n            <button onclick=\"toggleArticle()\" class=\"w-full p-4 flex items-center justify-between text-left font-semibold text-indigo-900 bg-indigo-50 hover:bg-indigo-100/70 transition-colors focus:outline-none min-h-[48px]\">\n                <span class=\"flex items-center gap-2 text-sm md:text-base\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z\" />\n                    </svg>\n                    Read the Reference Article (Click to toggle)\n                </span>\n                <svg id=\"arrow-icon\" xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-indigo-600 transform transition-transform duration-200\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\" />\n                </svg>\n            </button>\n            <div id=\"article-content\" class=\"p-5 space-y-4 text-sm text-slate-700 bg-white border-t border-indigo-100\">\n                <div>\n                    <h3 class=\"font-bold text-indigo-900 mb-1\">1. Stages of Sleep</h3>\n                    <p>There are five stages of sleep: stages 1, 2, 3, 4 and REM (rapid* eye movement). In stages 1 to 4 our body becomes more relaxed. Our muscles and heart rate slow down and our brain becomes less active. Stage 5 is called REM sleep. Our heart beats faster and our eyes move quickly in different directions. People dream during this stage and we cannot move at all – probably to stop us from doing the actions in our dreams.</p>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-indigo-900 mb-1\">2. Why We Sleep</h3>\n                    <p>An average person spends almost a third of their life sleeping! Is it a waste of time? Scientists believe that when the heart and brain slow down, the body is recovering* after the day's work. They also think that REM sleep is important for memory and learning – babies have twice as much REM sleep as adults.</p>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-indigo-900 mb-1\">3. Sleep Duration</h3>\n                    <p>On average an adult needs about 7–8 hours' sleep every day. A baby needs 12–16. In the animal world, bats sleep for about 20 hours every day. But a giraffe sleeps for only an hour or two every night.</p>\n                </div>\n                <div class=\"text-xs text-slate-500 pt-2 border-t border-slate-100\">\n                    <p>*rapid = very quick</p>\n                    <p>*recover = get back your strength</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- INTERACTIVE EXERCISE SECTION -->\n        <section class=\"bg-white rounded-2xl p-4 md:p-6 shadow-sm border border-slate-100 space-y-6\">\n            <div>\n                <h2 class=\"text-base md:text-lg font-bold text-slate-900\">3. Read the article again and answer the questions.</h2>\n                <p class=\"text-xs text-slate-500 mt-0.5\">Select the correct answer for each question based on the text.</p>\n            </div>\n\n            <div class=\"space-y-6\">\n                <!-- Question 1 -->\n                <div class=\"p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3\" id=\"q1-container\">\n                    <label class=\"block font-medium text-sm text-slate-900\">\n                        <span class=\"font-bold text-indigo-600 mr-1.5\">1.</span> What happens to your heart in stages 1 to 4 of sleep?\n                    </label>\n                    <div class=\"space-y-2\">\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q1\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">It beats faster and pumps extra blood.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q1\" value=\"correct\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">It slows down.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q1\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">It stops completely for short moments.</span>\n                        </label>\n                    </div>\n                </div>\n\n                <!-- Question 2 -->\n                <div class=\"p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3\" id=\"q2-container\">\n                    <label class=\"block font-medium text-sm text-slate-900\">\n                        <span class=\"font-bold text-indigo-600 mr-1.5\">2.</span> Why is stage 5 called REM?\n                    </label>\n                    <div class=\"space-y-2\">\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q2\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Because our eyes are completely still and closed.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q2\" value=\"correct\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Because our eyes move quickly in different directions.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q2\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Because we wake up rapidly during this stage.</span>\n                        </label>\n                    </div>\n                </div>\n\n                <!-- Question 3 -->\n                <div class=\"p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3\" id=\"q3-container\">\n                    <label class=\"block font-medium text-sm text-slate-900\">\n                        <span class=\"font-bold text-indigo-600 mr-1.5\">3.</span> Why do we need stages 1 to 4 of sleep?\n                    </label>\n                    <div class=\"space-y-2\">\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q3\" value=\"correct\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Because our body becomes more relaxed.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q3\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">To help us learn new foreign languages faster.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q3\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">To process complex mathematical problems.</span>\n                        </label>\n                    </div>\n                </div>\n\n                <!-- Question 4 -->\n                <div class=\"p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3\" id=\"q4-container\">\n                    <label class=\"block font-medium text-sm text-slate-900\">\n                        <span class=\"font-bold text-indigo-600 mr-1.5\">4.</span> What happens during REM sleep?\n                    </label>\n                    <div class=\"space-y-2\">\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q4\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">We run around and perform actions in our sleep.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q4\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">We remember everything we did during the day clearly.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q4\" value=\"correct\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">We dream and we cannot move at all.</span>\n                        </label>\n                    </div>\n                </div>\n\n                <!-- Question 5 -->\n                <div class=\"p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3\" id=\"q5-container\">\n                    <label class=\"block font-medium text-sm text-slate-900\">\n                        <span class=\"font-bold text-indigo-600 mr-1.5\">5.</span> Why is REM sleep important to babies?\n                    </label>\n                    <div class=\"space-y-2\">\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q5\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Because it helps them grow taller physically.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q5\" value=\"correct\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Because scientists think it is important for memory and learning.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q5\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Because it stops them from waking up hungry.</span>\n                        </label>\n                    </div>\n                </div>\n\n                <!-- Question 6 -->\n                <div class=\"p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3\" id=\"q6-container\">\n                    <label class=\"block font-medium text-sm text-slate-900\">\n                        <span class=\"font-bold text-indigo-600 mr-1.5\">6.</span> Put these in order of the amount of sleep they need (least to most):\n                    </label>\n                    <div class=\"space-y-2\">\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q6\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Babies, adults, bats, giraffes.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q6\" value=\"wrong\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Adults, babies, giraffes, bats.</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 cursor-pointer min-h-[42px]\">\n                            <input type=\"radio\" name=\"q6\" value=\"correct\" class=\"h-4 w-4 text-indigo-600\">\n                            <span class=\"text-sm\">Giraffes, adults, babies, bats.</span>\n                        </label>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ACTION BUTTONS -->\n            <div class=\"flex flex-col sm:flex-row gap-3 pt-4 border-t border-slate-100\">\n                <button onclick=\"checkAnswers()\" class=\"w-full sm:flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-6 rounded-xl transition-colors shadow-sm active:scale-[0.99] min-h-[48px]\">\n                    Check Answers\n                </button>\n                <button onclick=\"resetActivity()\" class=\"w-full sm:w-auto bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium py-3 px-6 rounded-xl transition-colors min-h-[48px]\">\n                    Reset\n                </button>\n            </div>\n        </section>\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"text-center py-6 text-xs text-slate-400 border-t border-slate-200/60 mt-8\">\n        Interactive ELT Reading Activity • The Science of Sleep\n    </footer>\n\n    <!-- INTERACTION LOGIC SCRIPT -->\n    <script>\n        function toggleArticle() {\n            const content = document.getElementById('article-content');\n            const arrow = document.getElementById('arrow-icon');\n            if (content.style.maxHeight && content.style.maxHeight !== '0px') {\n                content.style.maxHeight = '0px';\n                content.style.overflow = 'hidden';\n                arrow.style.transform = 'rotate(0deg)';\n            } else {\n                content.style.maxHeight = content.scrollHeight + 'px';\n                content.style.overflow = 'visible';\n                arrow.style.transform = 'rotate(180deg)';\n            }\n        }\n\n        // Initialize article open by default or closed smoothly\n        window.addEventListener('DOMContentLoaded', () => {\n            const content = document.getElementById('article-content');\n            content.style.transition = 'max-height 0.3s ease-in-out';\n            content.style.maxHeight = content.scrollHeight + 'px';\n        });\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const total = 6;\n\n            for (let i = 1; i <= total; i++) {\n                const container = document.getElementById(`q${i}-container`);\n                const selected = document.querySelector(`input[name=\"q${i}\"]:checked`);\n                \n                // Clear previous validation styling\n                container.classList.remove('bg-emerald-50', 'border-emerald-300', 'bg-rose-50', 'border-rose-300');\n                \n                if (selected) {\n                    if (selected.value === 'correct') {\n                        correctCount++;\n                        container.classList.add('bg-emerald-50/70', 'border-emerald-300');\n                    } else {\n                        container.classList.add('bg-rose-50/70', 'border-rose-300');\n                    }\n                } else {\n                    container.classList.add('bg-rose-50/70', 'border-rose-300');\n                }\n            }\n\n            // Update score display\n            document.getElementById('current-score').textContent = correctCount;\n            const badge = document.getElementById('score-badge');\n            badge.className = `font-semibold text-sm px-3 py-1.5 rounded-full border transition-all ${correctCount === total ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : 'bg-indigo-50 text-indigo-800 border-indigo-200'}`;\n\n            // Send score to parent frame if embedded\n            try {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: total }, '*');\n            } catch (e) {\n                console.log('Score posted locally:', correctCount, '/', total);\n            }\n        }\n\n        function resetActivity() {\n            for (let i = 1; i <= 6; i++) {\n                const container = document.getElementById(`q${i}-container`);\n                container.classList.remove('bg-emerald-50/70', 'border-emerald-300', 'bg-rose-50/70', 'border-rose-300');\n                const radios = document.querySelectorAll(`input[name=\"q${i}\"]`);\n                radios.forEach(radio => radio.checked = false);\n            }\n\n            document.getElementById('current-score').textContent = '0';\n            const badge = document.getElementById('score-badge');\n            badge.className = 'font-semibold text-sm bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full border border-slate-200 transition-all';\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793211956002,
      "title": "Gradable and Strong Adjectives; Adverbs",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Gradable and Strong Adjectives; Adverbs</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- STICKY TOP-0 HEADER / DASHBOARD -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-indigo-100 text-indigo-700 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wide\">Exercise 4</span>\n                <h1 class=\"text-sm md:text-base font-semibold text-slate-800 truncate\">Gradable & Strong Adjectives</h1>\n            </div>\n            <div id=\"score-display\" class=\"text-xs md:text-sm font-bold bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full border border-slate-200\">\n                Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">10</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-xl mx-auto p-4 md:p-6 flex-grow pb-24\">\n        \n        <!-- INSTRUCTIONS CARD -->\n        <section class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-100 mb-5\">\n            <div class=\"flex items-start space-x-3\">\n                <div class=\"bg-indigo-50 text-indigo-600 p-2 rounded-xl flex-shrink-0 mt-0.5\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                </div>\n                <div>\n                    <h2 class=\"font-semibold text-slate-900 text-sm md:text-base\">Fill in the gaps with the correct adverbs.</h2>\n                    <p class=\"text-xs md:text-sm text-slate-500 mt-0.5\">Choose the best modifier for each adjective. Note that more than one answer is sometimes possible.</p>\n                </div>\n            </div>\n\n            <!-- ADVERB BANK -->\n            <div class=\"mt-4 pt-3 border-t border-slate-100\">\n                <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-2\">Available Adverbs:</span>\n                <div class=\"flex flex-wrap gap-2\">\n                    <span class=\"bg-slate-100 text-slate-700 text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200\">really</span>\n                    <span class=\"bg-slate-100 text-slate-700 text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200\">incredibly</span>\n                    <span class=\"bg-slate-100 text-slate-700 text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200\">absolutely</span>\n                    <span class=\"bg-slate-100 text-slate-700 text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200\">extremely</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- INTERACTIVE FORM -->\n        <form id=\"quiz-form\" class=\"space-y-3\" onsubmit=\"event.preventDefault();\">\n            \n            <!-- Item 1 (Example Completed) -->\n            <div class=\"bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between opacity-80\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">1.</span>\n                    <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-semibold border border-slate-200\">really</span>\n                    <span class=\"text-sm font-medium text-slate-700\">hot</span>\n                </div>\n                <span class=\"text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-1 rounded\">Example</span>\n            </div>\n\n            <!-- Item 2 (Example Completed) -->\n            <div class=\"bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between opacity-80\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">2.</span>\n                    <span class=\"bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-semibold border border-slate-200\">absolutely</span>\n                    <span class=\"text-sm font-medium text-slate-700\">shattered</span>\n                </div>\n                <span class=\"text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-1 rounded\">Example</span>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"question-card bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">3.</span>\n                    <select name=\"q3\" class=\"flex-grow bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 min-h-[44px]\">\n                        <option value=\"\">-- select adverb --</option>\n                        <option value=\"really\">really</option>\n                        <option value=\"incredibly\">incredibly</option>\n                        <option value=\"absolutely\">absolutely</option>\n                        <option value=\"extremely\">extremely</option>\n                    </select>\n                    <span class=\"text-sm font-medium text-slate-700 w-28 md:w-36\">beautiful</span>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"question-card bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">4.</span>\n                    <select name=\"q4\" class=\"flex-grow bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 min-h-[44px]\">\n                        <option value=\"\">-- select adverb --</option>\n                        <option value=\"really\">really</option>\n                        <option value=\"incredibly\">incredibly</option>\n                        <option value=\"absolutely\">absolutely</option>\n                        <option value=\"extremely\">extremely</option>\n                    </select>\n                    <span class=\"text-sm font-medium text-slate-700 w-28 md:w-36\">small</span>\n                </div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"question-card bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">5.</span>\n                    <select name=\"q5\" class=\"flex-grow bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 min-h-[44px]\">\n                        <option value=\"\">-- select adverb --</option>\n                        <option value=\"really\">really</option>\n                        <option value=\"incredibly\">incredibly</option>\n                        <option value=\"absolutely\">absolutely</option>\n                        <option value=\"extremely\">extremely</option>\n                    </select>\n                    <span class=\"text-sm font-medium text-slate-700 w-28 md:w-36\">filthy</span>\n                </div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"question-card bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">6.</span>\n                    <select name=\"q6\" class=\"flex-grow bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 min-h-[44px]\">\n                        <option value=\"\">-- select adverb --</option>\n                        <option value=\"really\">really</option>\n                        <option value=\"incredibly\">incredibly</option>\n                        <option value=\"absolutely\">absolutely</option>\n                        <option value=\"extremely\">extremely</option>\n                    </select>\n                    <span class=\"text-sm font-medium text-slate-700 w-28 md:w-36\">boiling</span>\n                </div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"question-card bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">7.</span>\n                    <select name=\"q7\" class=\"flex-grow bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 min-h-[44px]\">\n                        <option value=\"\">-- select adverb --</option>\n                        <option value=\"really\">really</option>\n                        <option value=\"incredibly\">incredibly</option>\n                        <option value=\"absolutely\">absolutely</option>\n                        <option value=\"extremely\">extremely</option>\n                    </select>\n                    <span class=\"text-sm font-medium text-slate-700 w-28 md:w-36\">dirty</span>\n                </div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"question-card bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">8.</span>\n                    <select name=\"q8\" class=\"flex-grow bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 min-h-[44px]\">\n                        <option value=\"\">-- select adverb --</option>\n                        <option value=\"really\">really</option>\n                        <option value=\"incredibly\">incredibly</option>\n                        <option value=\"absolutely\">absolutely</option>\n                        <option value=\"extremely\">extremely</option>\n                    </select>\n                    <span class=\"text-sm font-medium text-slate-700 w-28 md:w-36\">tired</span>\n                </div>\n            </div>\n\n            <!-- Item 9 -->\n            <div class=\"question-card bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">9.</span>\n                    <select name=\"q9\" class=\"flex-grow bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 min-h-[44px]\">\n                        <option value=\"\">-- select adverb --</option>\n                        <option value=\"really\">really</option>\n                        <option value=\"incredibly\">incredibly</option>\n                        <option value=\"absolutely\">absolutely</option>\n                        <option value=\"extremely\">extremely</option>\n                    </select>\n                    <span class=\"text-sm font-medium text-slate-700 w-28 md:w-36\">gorgeous</span>\n                </div>\n            </div>\n\n            <!-- Item 10 -->\n            <div class=\"question-card bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all\">\n                <div class=\"flex items-center space-x-3 w-full\">\n                    <span class=\"text-xs font-bold text-slate-400 w-5\">10.</span>\n                    <select name=\"q10\" class=\"flex-grow bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 min-h-[44px]\">\n                        <option value=\"\">-- select adverb --</option>\n                        <option value=\"really\">really</option>\n                        <option value=\"incredibly\">incredibly</option>\n                        <option value=\"absolutely\">absolutely</option>\n                        <option value=\"extremely\">extremely</option>\n                    </select>\n                    <span class=\"text-sm font-medium text-slate-700 w-28 md:w-36\">tiny</span>\n                </div>\n            </div>\n\n        </form>\n    </main>\n\n    <!-- STICKY BOTTOM ACTION BAR -->\n    <footer class=\"fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur border-t p-3 md:p-4 z-20 shadow-lg\">\n        <div class=\"max-w-xl mx-auto flex items-center justify-between gap-3\">\n            <button type=\"button\" onclick=\"resetQuiz()\" class=\"flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 px-4 rounded-xl text-sm transition-all min-h-[44px] flex items-center justify-center space-x-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                </svg>\n                <span>Reset</span>\n            </button>\n            <button type=\"button\" onclick=\"checkAnswers()\" class=\"flex-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl text-sm transition-all min-h-[44px] shadow-sm flex items-center justify-center space-x-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                <span>Check Answers</span>\n            </button>\n        </div>\n    </footer>\n\n    <!-- INTERACTION LOGIC -->\n    <script>\n        // Answer key based precisely on provided Answer Key OCR\n        const answerKey = {\n            q3: ['really', 'incredibly', 'extremely'],\n            q4: ['really', 'incredibly', 'extremely'],\n            q5: ['really', 'absolutely'],\n            q6: ['really', 'absolutely'],\n            q7: ['really', 'incredibly', 'extremely'],\n            q8: ['really', 'incredibly', 'extremely'],\n            q9: ['really', 'absolutely'],\n            q10: ['really', 'absolutely']\n        };\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalCount = 8; // items 3 to 10 are interactive\n\n            for (let i = 3; i <= 10; i++) {\n                const selectElement = document.querySelector(`[name=\"q${i}\"]`);\n                const card = selectElement.closest('.question-card');\n                const userVal = selectElement.value.trim().toLowerCase();\n\n                // Reset border state\n                card.classList.remove('border-emerald-500', 'bg-emerald-50/30', 'border-red-500', 'bg-red-50/30');\n\n                if (userVal && answerKey[`q${i}`].includes(userVal)) {\n                    correctCount++;\n                    card.classList.add('border-emerald-500', 'bg-emerald-50/30');\n                } else {\n                    card.classList.add('border-red-500', 'bg-red-50/30');\n                }\n            }\n\n            // Update Score Dashboard\n            document.getElementById('current-score').textContent = correctCount;\n\n            // Emit event to parent container\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        }\n\n        function resetQuiz() {\n            for (let i = 3; i <= 10; i++) {\n                const selectElement = document.querySelector(`[name=\"q${i}\"]`);\n                const card = selectElement.closest('.question-card');\n                selectElement.value = '';\n                card.classList.remove('border-emerald-500', 'bg-emerald-50/30', 'border-red-500', 'bg-red-50/30');\n            }\n            document.getElementById('current-score').textContent = '0';\n        }\n    </script>\n</body>\n</html>"
    }
  ]
}