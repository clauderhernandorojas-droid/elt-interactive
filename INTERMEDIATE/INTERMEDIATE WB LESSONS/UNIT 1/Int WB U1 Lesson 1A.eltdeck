{
  "version": "2.0",
  "title": "Int WB U1 Lesson A",
  "updatedAt": "2026-10-27T18:44:35.280Z",
  "slides": [
    {
      "id": 1793070742986,
      "title": "Actividad IA #2",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Weekend Activities - Vocabulary Exercise</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .tap-target {\n            min-height: 44px;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Header Section -->\n    <header class=\"bg-indigo-600 text-white shadow-md p-4 sticky top-0 z-10\">\n        <div class=\"max-w-xl mx-auto flex justify-between items-center\">\n            <div>\n                <span class=\"text-xs uppercase tracking-wider bg-indigo-500 px-2 py-0.5 rounded font-semibold\">V1.1</span>\n                <h1 class=\"text-lg font-bold mt-0.5\">Weekend Activities</h1>\n            </div>\n            <div id=\"score-display\" class=\"text-sm font-medium bg-indigo-700 px-3 py-1.5 rounded-full hidden\">\n                Score: <span id=\"score-val\">0</span> / <span id=\"total-val\">4</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content Container -->\n    <main class=\"w-full max-w-xl mx-auto p-4 md:p-6 flex-grow\">\n        \n        <!-- Instruction Card -->\n        <section class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 md:p-5 mb-6\">\n            <div class=\"flex items-start gap-3\">\n                <div class=\"bg-indigo-100 text-indigo-700 font-bold rounded-full w-8 h-8 flex items-center justify-center shrink-0 text-sm\">\n                    1\n                </div>\n                <div>\n                    <h2 class=\"text-base font-bold text-slate-900\">a) Which words/phrases do <span class=\"underline decoration-2 decoration-indigo-500\">not</span> go with the verbs?</h2>\n                    <p class=\"text-sm text-slate-500 mt-1\">Tap the incorrect option for each verb phrase below.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Exercise Form -->\n        <form id=\"vocab-form\" class=\"space-y-4\">\n            \n            <!-- Item 1 -->\n            <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 transition-all\" data-item=\"1\">\n                <div class=\"font-medium text-slate-800 mb-3 text-sm md:text-base\">\n                    <span class=\"font-bold text-indigo-600 mr-1\">1.</span> go\n                </div>\n                <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                    <button type=\"button\" data-question=\"1\" data-option=\"clubbing\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        clubbing\n                    </button>\n                    <button type=\"button\" data-question=\"1\" data-option=\"for a walk\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        for a walk\n                    </button>\n                    <button type=\"button\" data-question=\"1\" data-option=\"exhibitions\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        exhibitions\n                    </button>\n                </div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 transition-all\" data-item=\"2\">\n                <div class=\"font-medium text-slate-800 mb-3 text-sm md:text-base\">\n                    <span class=\"font-bold text-indigo-600 mr-1\">2.</span> have\n                </div>\n                <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                    <button type=\"button\" data-question=\"2\" data-option=\"a quiet night in\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        a quiet night in\n                    </button>\n                    <button type=\"button\" data-question=\"2\" data-option=\"the house\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        the house\n                    </button>\n                    <button type=\"button\" data-question=\"2\" data-option=\"a lie-in\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        a lie-in\n                    </button>\n                </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 transition-all\" data-item=\"3\">\n                <div class=\"font-medium text-slate-800 mb-3 text-sm md:text-base\">\n                    <span class=\"font-bold text-indigo-600 mr-1\">3.</span> visit\n                </div>\n                <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                    <button type=\"button\" data-question=\"3\" data-option=\"friends\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        friends\n                    </button>\n                    <button type=\"button\" data-question=\"3\" data-option=\"relatives\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        relatives\n                    </button>\n                    <button type=\"button\" data-question=\"3\" data-option=\"to people online\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        to people online\n                    </button>\n                </div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 transition-all\" data-item=\"4\">\n                <div class=\"font-medium text-slate-800 mb-3 text-sm md:text-base\">\n                    <span class=\"font-bold text-indigo-600 mr-1\">4.</span> do\n                </div>\n                <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                    <button type=\"button\" data-question=\"4\" data-option=\"relatives\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        relatives\n                    </button>\n                    <button type=\"button\" data-question=\"4\" data-option=\"some gardening\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        some gardening\n                    </button>\n                    <button type=\"button\" data-question=\"4\" data-option=\"some exercise\" class=\"option-btn tap-target text-left sm:text-center px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-medium bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 transition-all\">\n                        some exercise\n                    </button>\n                </div>\n            </div>\n\n            <!-- Action Controls -->\n            <div class=\"flex items-center gap-3 pt-2\">\n                <button type=\"button\" id=\"check-btn\" class=\"tap-target flex-1 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold py-3 px-6 rounded-xl shadow-md transition-all text-sm md:text-base\">\n                    Check Answers\n                </button>\n                <button type=\"button\" id=\"reset-btn\" class=\"tap-target bg-slate-200 hover:bg-slate-300 active:bg-slate-400 text-slate-700 font-semibold py-3 px-5 rounded-xl transition-all text-sm md:text-base\">\n                    Reset\n                </button>\n            </div>\n        </form>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-4 text-xs text-slate-400\">\n        Interactive English Learning Activity\n    </footer>\n\n    <!-- Script Logic -->\n    <script>\n        // Answer Key based on the textbook snippet\n        const answerKey = {\n            1: \"exhibitions\",\n            2: \"the house\",\n            3: \"to people online\",\n            4: \"relatives\"\n        };\n\n        const userSelections = {};\n\n        const optionButtons = document.querySelectorAll('.option-btn');\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const scoreDisplay = document.getElementById('score-display');\n        const scoreVal = document.getElementById('score-val');\n\n        // Handle selection state\n        optionButtons.forEach(btn => {\n            btn.addEventListener('click', () => {\n                const qNum = btn.getAttribute('data-question');\n                const optVal = btn.getAttribute('data-option');\n\n                // Clear active state for options in the same question group\n                document.querySelectorAll(`.option-btn[data-question=\"${qNum}\"]`).forEach(b => {\n                    b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-sm');\n                    b.classList.add('bg-slate-50', 'text-slate-800', 'border-slate-200');\n                });\n\n                // Set active state on clicked option\n                btn.classList.remove('bg-slate-50', 'text-slate-800', 'border-slate-200');\n                btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-sm');\n\n                userSelections[qNum] = optVal;\n            });\n        });\n\n        // Check answers logic\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n            const totalCount = Object.keys(answerKey).length;\n            let answeredCount = Object.keys(userSelections).length;\n\n            if (answeredCount < totalCount) {\n                alert('Please select an option for all 4 items before checking.');\n                return;\n            }\n\n            optionButtons.forEach(btn => {\n                const qNum = btn.getAttribute('data-question');\n                const optVal = btn.getAttribute('data-option');\n                const isSelected = userSelections[qNum] === optVal;\n                const isCorrectAnswer = answerKey[qNum] === optVal;\n\n                // Remove previous evaluation styles\n                btn.classList.remove('bg-emerald-600', 'bg-rose-600', 'text-white', 'border-emerald-600', 'border-rose-600', 'bg-slate-50');\n\n                if (isCorrectAnswer) {\n                    // Correct answer highlighting (Emerald)\n                    btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600', 'font-bold');\n                    if (isSelected) {\n                        correctCount++;\n                    }\n                } else if (isSelected && !isCorrectAnswer) {\n                    // Incorrect user selection highlighting (Rose)\n                    btn.classList.add('bg-rose-600', 'text-white', 'border-rose-600', 'font-bold');\n                } else {\n                    // Unselected wrong options\n                    btn.classList.add('bg-slate-100', 'text-slate-400', 'border-slate-200');\n                }\n\n                // Disable buttons after check\n                btn.disabled = true;\n            });\n\n            // Update UI Score\n            scoreVal.textContent = correctCount;\n            scoreDisplay.classList.remove('hidden');\n\n            // Disable check button\n            checkBtn.disabled = true;\n            checkBtn.classList.add('opacity-50', 'cursor-not-allowed');\n\n            // Post score to parent frame\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        });\n\n        // Reset logic\n        resetBtn.addEventListener('click', () => {\n            Object.keys(userSelections).forEach(key => delete userSelections[key]);\n\n            optionButtons.forEach(btn => {\n                btn.disabled = false;\n                btn.classList.remove(\n                    'bg-indigo-600', 'bg-emerald-600', 'bg-rose-600', 'bg-slate-100',\n                    'text-white', 'text-slate-400', 'border-indigo-600', 'border-emerald-600', \n                    'border-rose-600', 'font-bold', 'shadow-sm'\n                );\n                btn.classList.add('bg-slate-50', 'text-slate-800', 'border-slate-200');\n            });\n\n            scoreDisplay.classList.add('hidden');\n            scoreVal.textContent = '0';\n\n            checkBtn.disabled = false;\n            checkBtn.classList.remove('opacity-50', 'cursor-not-allowed');\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793070917407,
      "title": "Actividad IA #2",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Weekend Activities Matching Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .touch-target {\n            min-height: 48px;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-2xl mx-auto p-4 md:p-6 space-y-6\">\n        \n        <!-- Header / Instructions -->\n        <header class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100\">\n            <div class=\"flex items-center justify-between mb-2\">\n                <span class=\"text-xs font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full\">Vocabulary Practice</span>\n                <span id=\"score-display\" class=\"text-sm font-bold text-slate-500\">Score: 0 / 4</span>\n            </div>\n            <h1 class=\"text-xl md:text-2xl font-bold text-slate-900 mb-2\">Weekend Activities</h1>\n            <p class=\"text-sm md:text-base text-slate-600 leading-relaxed\">\n                Match the action verbs (<span class=\"font-semibold text-slate-700\">go to, chat, visit, tidy up</span>) with the correct phrases from 1a to make four weekend activities. Drag or tap a verb into each phrase slot.\n            </p>\n        </header>\n\n        <!-- Interactive Section -->\n        <section class=\"space-y-4\">\n            \n            <!-- Verbs Bank (Tokens) -->\n            <div class=\"bg-white rounded-2xl shadow-sm p-4 md:p-5 border border-slate-100\">\n                <h2 class=\"text-xs font-bold uppercase tracking-wider text-slate-400 mb-3\">Available Verbs</h2>\n                <div id=\"verbs-bank\" class=\"flex flex-wrap gap-2.5 min-h-[56px] items-center p-2 bg-slate-50 rounded-xl border border-dashed border-slate-200\">\n                    <!-- Tokens injected via JS -->\n                </div>\n            </div>\n\n            <!-- Phrases Matching Rows -->\n            <div class=\"bg-white rounded-2xl shadow-sm p-4 md:p-6 border border-slate-100 space-y-4\">\n                <h2 class=\"text-xs font-bold uppercase tracking-wider text-slate-400 mb-1\">Phrases</h2>\n                \n                <div id=\"rows-container\" class=\"space-y-3\">\n                    <!-- Row 1 -->\n                    <div class=\"flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 transition-all duration-200\" data-index=\"1\">\n                        <div class=\"flex items-center gap-3 w-full\">\n                            <span class=\"font-bold text-slate-400 text-sm md:text-base w-5\">1.</span>\n                            <div class=\"drop-zone flex-1 flex items-center h-12 px-3 rounded-lg bg-white border-2 border-dashed border-slate-300 text-sm md:text-base font-medium text-slate-700 cursor-pointer transition-colors\" data-slot=\"1\">\n                                <span class=\"placeholder text-slate-400 italic\">Tap verb here...</span>\n                            </div>\n                            <span class=\"text-sm md:text-base font-medium text-slate-700 whitespace-nowrap\">exhibitions</span>\n                        </div>\n                    </div>\n\n                    <!-- Row 2 -->\n                    <div class=\"flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 transition-all duration-200\" data-index=\"2\">\n                        <div class=\"flex items-center gap-3 w-full\">\n                            <span class=\"font-bold text-slate-400 text-sm md:text-base w-5\">2.</span>\n                            <div class=\"drop-zone flex-1 flex items-center h-12 px-3 rounded-lg bg-white border-2 border-dashed border-slate-300 text-sm md:text-base font-medium text-slate-700 cursor-pointer transition-colors\" data-slot=\"2\">\n                                <span class=\"placeholder text-slate-400 italic\">Tap verb here...</span>\n                            </div>\n                            <span class=\"text-sm md:text-base font-medium text-slate-700 whitespace-nowrap\">the house</span>\n                        </div>\n                    </div>\n\n                    <!-- Row 3 -->\n                    <div class=\"flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 transition-all duration-200\" data-index=\"3\">\n                        <div class=\"flex items-center gap-3 w-full\">\n                            <span class=\"font-bold text-slate-400 text-sm md:text-base w-5\">3.</span>\n                            <div class=\"drop-zone flex-1 flex items-center h-12 px-3 rounded-lg bg-white border-2 border-dashed border-slate-300 text-sm md:text-base font-medium text-slate-700 cursor-pointer transition-colors\" data-slot=\"3\">\n                                <span class=\"placeholder text-slate-400 italic\">Tap verb here...</span>\n                            </div>\n                            <span class=\"text-sm md:text-base font-medium text-slate-700 whitespace-nowrap\">to people online</span>\n                        </div>\n                    </div>\n\n                    <!-- Row 4 -->\n                    <div class=\"flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 transition-all duration-200\" data-index=\"4\">\n                        <div class=\"flex items-center gap-3 w-full\">\n                            <span class=\"font-bold text-slate-400 text-sm md:text-base w-5\">4.</span>\n                            <div class=\"drop-zone flex-1 flex items-center h-12 px-3 rounded-lg bg-white border-2 border-dashed border-slate-300 text-sm md:text-base font-medium text-slate-700 cursor-pointer transition-colors\" data-slot=\"4\">\n                                <span class=\"placeholder text-slate-400 italic\">Tap verb here...</span>\n                            </div>\n                            <span class=\"text-sm md:text-base font-medium text-slate-700 whitespace-nowrap\">relatives</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </section>\n\n        <!-- Control Buttons -->\n        <footer class=\"flex flex-col sm:flex-row gap-3 pt-2\">\n            <button id=\"check-btn\" class=\"touch-target flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-md shadow-indigo-100 transition active:scale-[0.98] text-base px-6 py-3 flex items-center justify-center\">\n                Check Answers\n            </button>\n            <button id=\"reset-btn\" class=\"touch-target sm:w-auto bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 font-semibold rounded-xl transition active:scale-[0.98] text-base px-6 py-3 flex items-center justify-center\">\n                Reset\n            </button>\n        </footer>\n\n    </main>\n\n    <!-- App Logic Script -->\n    <script>\n        const verbs = [\n            { id: 'v1', text: 'go to' },\n            { id: 'v2', text: 'tidy up' },\n            { id: 'v3', text: 'chat' },\n            { id: 'v4', text: 'visit' }\n        ];\n\n        // Answer Key based on official textbook solution\n        const correctMapping = {\n            1: 'go to',\n            2: 'tidy up',\n            3: 'chat',\n            4: 'visit'\n        };\n\n        let selectedVerb = null;\n        const userAnswers = { 1: null, 2: null, 3: null, 4: null };\n\n        const verbsBankEl = document.getElementById('verbs-bank');\n        const dropZones = document.querySelectorAll('.drop-zone');\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const scoreDisplay = document.getElementById('score-display');\n\n        function initApp() {\n            renderVerbsBank();\n            setupListeners();\n        }\n\n        function renderVerbsBank() {\n            verbsBankEl.innerHTML = '';\n            \n            // Find which verbs are currently placed in slots\n            const placedVerbs = Object.values(userAnswers);\n\n            verbs.forEach(verb => {\n                const isPlaced = placedVerbs.includes(verb.text);\n                \n                const pill = document.createElement('div');\n                pill.className = `touch-target px-4 py-2 rounded-xl text-sm md:text-base font-semibold cursor-pointer transition-all flex items-center justify-center select-none ${\n                    isPlaced \n                        ? 'bg-slate-100 text-slate-300 border border-slate-200 pointer-events-none' \n                        : selectedVerb === verb.text \n                            ? 'bg-indigo-600 text-white shadow-md shadow-indigo-100 ring-2 ring-indigo-400 ring-offset-2' \n                            : 'bg-white text-slate-700 border border-slate-200 hover:border-indigo-300 shadow-sm'\n                }`;\n                pill.textContent = verb.text;\n                pill.dataset.verb = verb.text;\n\n                if (!isPlaced) {\n                    pill.addEventListener('click', () => {\n                        selectedVerb = (selectedVerb === verb.text) ? null : verb.text;\n                        renderVerbsBank();\n                        highlightDropZones(true);\n                    });\n                }\n\n                verbsBankEl.appendChild(pill);\n            });\n        }\n\n        function highlightDropZones(active) {\n            dropZones.forEach(zone => {\n                if (active && selectedVerb) {\n                    zone.classList.add('border-indigo-400', 'bg-indigo-50/30');\n                } else {\n                    zone.classList.remove('border-indigo-400', 'bg-indigo-50/30');\n                }\n            });\n        }\n\n        function setupListeners() {\n            dropZones.forEach(zone => {\n                zone.addEventListener('click', () => {\n                    const slotId = zone.dataset.slot;\n\n                    // If slot has a verb and no verb is currently selected, click removes it\n                    if (userAnswers[slotId] && !selectedVerb) {\n                        userAnswers[slotId] = null;\n                        updateSlots();\n                        renderVerbsBank();\n                        return;\n                    }\n\n                    // If a verb is selected, place it in this slot\n                    if (selectedVerb) {\n                        // Remove previous occurrence if placed elsewhere\n                        for (let key in userAnswers) {\n                            if (userAnswers[key] === selectedVerb) {\n                                userAnswers[key] = null;\n                            }\n                        }\n                        userAnswers[slotId] = selectedVerb;\n                        selectedVerb = null;\n                        updateSlots();\n                        renderVerbsBank();\n                        highlightDropZones(false);\n                    }\n                });\n            });\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n        }\n\n        function updateSlots() {\n            dropZones.forEach(zone => {\n                const slotId = zone.dataset.slot;\n                const val = userAnswers[slotId];\n                \n                // Clear previous validation styling\n                const row = zone.closest('[data-index]');\n                row.className = \"flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 transition-all duration-200\";\n\n                if (val) {\n                    zone.innerHTML = `<span class=\"font-semibold text-indigo-600\">${val}</span>`;\n                    zone.classList.remove('border-dashed', 'border-slate-300');\n                    zone.classList.add('border-solid', 'border-indigo-200', 'bg-indigo-50/20');\n                } else {\n                    zone.innerHTML = `<span class=\"placeholder text-slate-400 italic\">Tap verb here...</span>`;\n                    zone.classList.remove('border-solid', 'border-indigo-200', 'bg-indigo-50/20');\n                    zone.classList.add('border-dashed', 'border-slate-300');\n                }\n            });\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalCount = 4;\n\n            dropZones.forEach(zone => {\n                const slotId = zone.dataset.slot;\n                const userVal = userAnswers[slotId];\n                const row = zone.closest('[data-index]');\n                \n                // Remove previous border state\n                row.className = \"flex items-center justify-between gap-3 p-3 rounded-xl border transition-all duration-200 \";\n\n                if (userVal === correctMapping[slotId]) {\n                    correctCount++;\n                    row.classList.add('bg-emerald-50/50', 'border-emerald-200');\n                    zone.classList.remove('border-indigo-200');\n                    zone.classList.add('border-emerald-400', 'text-emerald-700', 'bg-emerald-50');\n                } else {\n                    row.classList.add('bg-rose-50/50', 'border-rose-200');\n                    zone.classList.remove('border-indigo-200');\n                    zone.classList.add('border-rose-400', 'text-rose-700', 'bg-rose-50');\n                }\n            });\n\n            scoreDisplay.textContent = `Score: ${correctCount} / ${totalCount}`;\n\n            // Post score to parent container securely\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        }\n\n        function resetActivity() {\n            selectedVerb = null;\n            for (let key in userAnswers) {\n                userAnswers[key] = null;\n            }\n            scoreDisplay.textContent = `Score: 0 / 4`;\n            \n            dropZones.forEach(zone => {\n                const row = zone.closest('[data-index]');\n                row.className = \"flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 transition-all duration-200\";\n                zone.className = \"drop-zone flex-1 flex items-center h-12 px-3 rounded-lg bg-white border-2 border-dashed border-slate-300 text-sm md:text-base font-medium text-slate-700 cursor-pointer transition-colors\";\n            });\n\n            updateSlots();\n            renderVerbsBank();\n        }\n\n        // Initialize on load\n        window.addEventListener('DOMContentLoaded', initApp);\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793070972929,
      "title": "Actividad IA #3",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Question Forms G1.1 - Interactive English Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom animations & touch enhancements */\n        .touch-target {\n            min-height: 44px;\n        }\n        input, select {\n            font-size: 16px !important; /* Prevent iOS auto-zoom */\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Header / Instructions -->\n    <header class=\"w-full bg-white border-b border-slate-200 sticky top-0 z-20 shadow-xs\">\n        <div class=\"max-w-3xl mx-auto px-4 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2\">\n            <div>\n                <span class=\"inline-block bg-amber-100 text-amber-800 text-xs font-semibold px-2.5 py-0.5 rounded-md mb-1\">G1.1</span>\n                <h1 class=\"text-lg md:text-xl font-bold text-slate-900\">Question forms</h1>\n                <p class=\"text-sm text-slate-600\">Make questions with the scrambled words. Pay attention to punctuation and capitalization.</p>\n            </div>\n            <div id=\"score-badge\" class=\"hidden items-center bg-indigo-50 border border-indigo-100 px-3 py-1.5 rounded-lg text-indigo-700 font-medium text-sm self-start sm:self-auto\">\n                Score: <span id=\"score-val\" class=\"font-bold ml-1\">0</span> / <span id=\"total-val\">8</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Activity Container -->\n    <main class=\"w-full max-w-3xl mx-auto p-4 md:p-6 flex-grow\">\n        <form id=\"activity-form\" class=\"space-y-6\" onsubmit=\"return false;\">\n            \n            <!-- Example (Already done) -->\n            <div class=\"bg-slate-100 border border-slate-200 rounded-xl p-4 opacity-80\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-500 text-sm mt-0.5\">a)</span>\n                    <div class=\"flex-1\">\n                        <p class=\"text-xs text-slate-500 font-mono mb-1\">house / you / at weekends / tidy up / Do / your ?</p>\n                        <p class=\"text-sm font-semibold text-slate-700 italic\">Do you tidy up your house at weekends?</p>\n                        <span class=\"inline-block mt-1 text-[11px] bg-slate-200 text-slate-600 px-2 py-0.5 rounded\">Example (Completed)</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Dynamic Questions Generated via JS -->\n            <div id=\"questions-container\" class=\"space-y-4\">\n                <!-- Injected via script -->\n            </div>\n\n            <!-- Action Controls -->\n            <div class=\"pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 border-t border-slate-200\">\n                <button type=\"button\" id=\"check-btn\" onclick=\"checkAnswers()\" class=\"touch-target w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium px-6 py-2.5 rounded-xl transition-colors shadow-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\">\n                    Check Answers\n                </button>\n                <button type=\"button\" id=\"reset-btn\" onclick=\"resetActivity()\" class=\"touch-target w-full sm:w-auto bg-white hover:bg-slate-100 active:bg-slate-200 text-slate-700 border border-slate-300 font-medium px-6 py-2.5 rounded-xl transition-colors focus:ring-2 focus:ring-slate-400 focus:outline-none\">\n                    Reset Activity\n                </button>\n            </div>\n        </form>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full bg-white border-t border-slate-200 py-3 text-center text-xs text-slate-500 mt-8\">\n        Interactive English Language Learning &bull; Touch & Mobile Optimized\n    </footer>\n\n    <!-- App Logic -->\n    <script>\n        const questionsData = [\n            {\n                id: 'b',\n                scrambled: 'been / in / the / you / last / clubbing / month / Have ?',\n                answer: 'Have you been clubbing in the last month?'\n            },\n            {\n                id: 'c',\n                scrambled: 'quiet / having / you / next / When / a / night / in / are ?',\n                answer: 'When are you next having a quiet night in?'\n            },\n            {\n                id: 'd',\n                scrambled: 'round / you / have / How often / do / for dinner / people ?',\n                answer: 'How often do you have people round for dinner?'\n            },\n            {\n                id: 'e',\n                scrambled: 'people / online / ever / Have / chatted / you / to ?',\n                answer: 'Have you ever chatted to people online?'\n            },\n            {\n                id: 'f',\n                scrambled: 'you / a / have / Did / last weekend / lie-in ?',\n                answer: 'Did you have a lie-in last weekend?'\n            },\n            {\n                id: 'g',\n                scrambled: 'friends / visiting / you / weekend / this / Are / or relatives ?',\n                answer: 'Are you visiting friends or relatives this weekend?'\n            },\n            {\n                id: 'h',\n                scrambled: 'many / How / last year / go / did / you / exhibitions / to ?',\n                answer: 'How many exhibitions did you go to last year?'\n            }\n        ];\n\n        // Normalize text for comparison (remove punctuation, extra spaces, lowercase)\n        function normalizeText(text) {\n            return text\n                .toLowerCase()\n                .replace(/[?.,!]/g, '')\n                .replace(/\\s+/g, ' ')\n                .trim();\n        }\n\n        function renderActivity() {\n            const container = document.getElementById('questions-container');\n            container.innerHTML = '';\n\n            questionsData.forEach((q) => {\n                const card = document.createElement('div');\n                card.className = 'bg-white border border-slate-200 rounded-xl p-4 shadow-2xs transition-all';\n                card.id = `card-${q.id}`;\n\n                card.innerHTML = `\n                    <div class=\"flex items-start gap-3\">\n                        <span class=\"font-bold text-slate-700 text-sm mt-2\">${q.id})</span>\n                        <div class=\"flex-1 space-y-2\">\n                            <p class=\"text-xs text-slate-500 font-mono bg-slate-50 p-2 rounded border border-slate-100\">${q.scrambled}</p>\n                            <div class=\"relative\">\n                                <input type=\"text\" id=\"input-${q.id}\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"Type your question here...\"\n                                    class=\"touch-target w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all\">\n                            </div>\n                            <div id=\"feedback-${q.id}\" class=\"hidden text-xs font-medium mt-1 flex items-center gap-1\"></div>\n                        </div>\n                    </div>\n                `;\n                container.appendChild(card);\n            });\n            document.getElementById('total-val').textContent = questionsData.length;\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n\n            questionsData.forEach((q) => {\n                const input = document.getElementById(`input-${q.id}`);\n                const card = document.getElementById(`card-${q.id}`);\n                const feedback = document.getElementById(`feedback-${q.id}`);\n                const userVal = input.value;\n                \n                const isCorrect = normalizeText(userVal) === normalizeText(q.answer);\n\n                // Reset styles\n                input.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n                card.classList.remove('border-emerald-300', 'border-rose-300', 'bg-emerald-50/20', 'bg-rose-50/20');\n\n                feedback.classList.remove('hidden', 'text-emerald-700', 'text-rose-700');\n\n                if (isCorrect) {\n                    correctCount++;\n                    input.classList.add('border-emerald-500', 'bg-emerald-50');\n                    card.classList.add('border-emerald-300', 'bg-emerald-50/20');\n                    feedback.innerHTML = `\n                        <svg class=\"w-4 h-4 text-emerald-600 inline\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"></path></svg>\n                        <span class=\"text-emerald-700 font-semibold\">Correct!</span>\n                    `;\n                } else {\n                    input.classList.add('border-rose-500', 'bg-rose-50');\n                    card.classList.add('border-rose-300', 'bg-rose-50/20');\n                    feedback.innerHTML = `\n                        <svg class=\"w-4 h-4 text-rose-600 inline\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"></path></svg>\n                        <span class=\"text-rose-700\">Correct answer: <strong class=\"italic\">${q.answer}</strong></span>\n                    `;\n                }\n            });\n\n            // Show Score Badge\n            const scoreBadge = document.getElementById('score-badge');\n            const scoreVal = document.getElementById('score-val');\n            scoreVal.textContent = correctCount;\n            scoreBadge.classList.remove('hidden');\n            scoreBadge.classList.add('inline-flex');\n\n            // Post message to parent container if inside sandbox iframe\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: questionsData.length\n            }, '*');\n\n            // Scroll gently to top or score on mobile if needed\n            window.scrollTo({ top: 0, behavior: 'smooth' });\n        }\n\n        function resetActivity() {\n            questionsData.forEach((q) => {\n                const input = document.getElementById(`input-${q.id}`);\n                const card = document.getElementById(`card-${q.id}`);\n                const feedback = document.getElementById(`feedback-${q.id}`);\n\n                input.value = '';\n                input.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n                card.classList.remove('border-emerald-300', 'border-rose-300', 'bg-emerald-50/20', 'bg-rose-50/20');\n                feedback.classList.add('hidden');\n                feedback.innerHTML = '';\n            });\n\n            const scoreBadge = document.getElementById('score-badge');\n            scoreBadge.classList.add('hidden');\n            scoreBadge.classList.remove('inline-flex');\n        }\n\n        // Initialize on load\n        window.addEventListener('DOMContentLoaded', renderActivity);\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793071018265,
      "title": "Actividad IA #4",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Weekends in or weekends out?</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .touch-target {\n            min-height: 44px;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased\">\n\n    <div class=\"w-full max-w-4xl mx-auto p-3 md:p-6\">\n        \n        <!-- Header / Instructions -->\n        <header class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-6 mb-6\">\n            <div class=\"flex items-center gap-3 mb-2\">\n                <span class=\"flex items-center justify-center w-8 h-8 rounded-full bg-indigo-600 text-white font-bold text-sm\">3</span>\n                <h1 class=\"text-lg md:text-xl font-bold text-slate-900\">Weekends in or weekends out?</h1>\n            </div>\n            <p class=\"text-sm md:text-base text-slate-600 mb-4\">\n                Read the article and drag or select the correct question from the options (2–5) into the correct places (1–5). Question 1 is already placed as an example.\n            </p>\n\n            <!-- Available Questions Bank -->\n            <div class=\"bg-indigo-50 border border-indigo-100 rounded-xl p-3 md:p-4\">\n                <h2 class=\"text-xs md:text-sm font-semibold text-indigo-900 uppercase tracking-wider mb-2\">Available Questions:</h2>\n                <div id=\"question-bank\" class=\"grid grid-cols-1 gap-2\">\n                    <div class=\"bg-white p-3 rounded-lg border border-indigo-200 text-sm md:text-base text-indigo-950 shadow-sm flex items-center justify-between\" data-qid=\"2\">\n                      <span><strong class=\"text-indigo-600 mr-2\">2.</strong> When are you next having a quiet night in?</span>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-lg border border-indigo-200 text-sm md:text-base text-indigo-950 shadow-sm flex items-center justify-between\" data-qid=\"3\">\n                      <span><strong class=\"text-indigo-600 mr-2\">3.</strong> Did you have a lie-in last weekend?</span>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-lg border border-indigo-200 text-sm md:text-base text-indigo-950 shadow-sm flex items-center justify-between\" data-qid=\"4\">\n                      <span><strong class=\"text-indigo-600 mr-2\">4.</strong> Have you ever chatted to people online?</span>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-lg border border-indigo-200 text-sm md:text-base text-indigo-950 shadow-sm flex items-center justify-between\" data-qid=\"5\">\n                      <span><strong class=\"text-indigo-600 mr-2\">5.</strong> Have you been clubbing in the last month?</span>\n                    </div>\n                </div>\n            </div>\n        </header>\n\n        <!-- Main Article / Conversation Container -->\n        <main class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-6 mb-6\">\n            \n            <!-- Profiles Visual -->\n            <div class=\"grid grid-cols-2 gap-4 mb-6 pb-6 border-b border-slate-100\">\n                <div class=\"text-center\">\n                    <div class=\"w-20 h-20 md:w-28 md:h-28 mx-auto rounded-full bg-amber-100 overflow-hidden mb-2 border-2 border-amber-200 flex items-center justify-center text-amber-800 font-bold text-xl\">Megan</div>\n                    <span class=\"text-xs md:text-sm font-semibold text-slate-700\">Megan</span>\n                </div>\n                <div class=\"text-center\">\n                    <div class=\"w-20 h-20 md:w-28 md:h-28 mx-auto rounded-full bg-sky-100 overflow-hidden mb-2 border-2 border-sky-200 flex items-center justify-center text-sky-800 font-bold text-xl\">K & A</div>\n                    <span class=\"text-xs md:text-sm font-semibold text-slate-700\">Karen and Andy</span>\n                </div>\n            </div>\n\n            <!-- Conversation Flow -->\n            <div class=\"space-y-4 text-sm md:text-base\">\n                \n                <!-- Line 1 (Example) -->\n                <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                    <div class=\"flex items-center gap-2 mb-1\">\n                        <span class=\"text-xs font-bold uppercase tracking-wider text-slate-500 w-16\">Megan</span>\n                        <span class=\"text-xs bg-slate-200 text-slate-700 px-2 py-0.5 rounded font-mono\">1</span>\n                    </div>\n                    <p class=\"text-slate-800 italic pl-0 md:pl-18\">\"How often do you have people round for dinner?\"</p>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3 pl-0 md:pl-18\">\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Megan</span>\n                        <p class=\"text-slate-700\">Never. But last month I ate out with friends at least five times.</p>\n                    </div>\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Karen</span>\n                        <p class=\"text-slate-700\">About once a month. My husband always cooks. This weekend we're visiting friends for dinner.</p>\n                    </div>\n                </div>\n\n                <!-- Gap 2 -->\n                <div class=\"p-4 bg-amber-50/50 rounded-xl border-2 border-dashed border-amber-200 drop-zone\" data-slot=\"2\">\n                    <div class=\"flex items-center justify-between mb-2\">\n                        <span class=\"text-xs font-bold uppercase tracking-wider text-amber-800\">Gap 2</span>\n                        <span class=\"text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-bold\">Select Question 2</span>\n                    </div>\n                    <select class=\"touch-target w-full bg-white border border-amber-300 rounded-lg px-3 py-2 text-sm md:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 answer-select\" data-index=\"2\">\n                        <option value=\"\">-- Choose the correct question --</option>\n                        <option value=\"2\">When are you next having a quiet night in?</option>\n                        <option value=\"3\">Did you have a lie-in last weekend?</option>\n                        <option value=\"4\">Have you ever chatted to people online?</option>\n                        <option value=\"5\">Have you been clubbing in the last month?</option>\n                    </select>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3 pl-0 md:pl-18\">\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Megan</span>\n                        <p class=\"text-slate-700\">I haven't had a quiet night in since I was a teenager!</p>\n                    </div>\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Andy</span>\n                        <p class=\"text-slate-700\">Next Friday. We always have a quiet night in on Fridays.</p>\n                    </div>\n                </div>\n\n                <!-- Gap 3 -->\n                <div class=\"p-4 bg-amber-50/50 rounded-xl border-2 border-dashed border-amber-200 drop-zone\" data-slot=\"3\">\n                    <div class=\"flex items-center justify-between mb-2\">\n                        <span class=\"text-xs font-bold uppercase tracking-wider text-amber-800\">Gap 3</span>\n                        <span class=\"text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-bold\">Select Question 3</span>\n                    </div>\n                    <select class=\"touch-target w-full bg-white border border-amber-300 rounded-lg px-3 py-2 text-sm md:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 answer-select\" data-index=\"3\">\n                        <option value=\"\">-- Choose the correct question --</option>\n                        <option value=\"2\">When are you next having a quiet night in?</option>\n                        <option value=\"3\">Did you have a lie-in last weekend?</option>\n                        <option value=\"4\">Have you ever chatted to people online?</option>\n                        <option value=\"5\">Have you been clubbing in the last month?</option>\n                    </select>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3 pl-0 md:pl-18\">\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Megan</span>\n                        <p class=\"text-slate-700\">Yes, of course. Sunday mornings are perfect for lie-ins!</p>\n                    </div>\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Karen</span>\n                        <p class=\"text-slate-700\">No! Lie-ins are impossible with two young children.</p>\n                    </div>\n                </div>\n\n                <!-- Gap 4 -->\n                <div class=\"p-4 bg-amber-50/50 rounded-xl border-2 border-dashed border-amber-200 drop-zone\" data-slot=\"4\">\n                    <div class=\"flex items-center justify-between mb-2\">\n                        <span class=\"text-xs font-bold uppercase tracking-wider text-amber-800\">Gap 4</span>\n                        <span class=\"text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-bold\">Select Question 4</span>\n                    </div>\n                    <select class=\"touch-target w-full bg-white border border-amber-300 rounded-lg px-3 py-2 text-sm md:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 answer-select\" data-index=\"4\">\n                        <option value=\"\">-- Choose the correct question --</option>\n                        <option value=\"2\">When are you next having a quiet night in?</option>\n                        <option value=\"3\">Did you have a lie-in last weekend?</option>\n                        <option value=\"4\">Have you ever chatted to people online?</option>\n                        <option value=\"5\">Have you been clubbing in the last month?</option>\n                    </select>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3 pl-0 md:pl-18\">\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Megan</span>\n                        <p class=\"text-slate-700\">Yes, I have. My brother lives abroad and it's cheaper than phoning.</p>\n                    </div>\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Karen</span>\n                        <p class=\"text-slate-700\">The children chat to their friends online, but I haven't tried it yet.</p>\n                    </div>\n                </div>\n\n                <!-- Gap 5 -->\n                <div class=\"p-4 bg-amber-50/50 rounded-xl border-2 border-dashed border-amber-200 drop-zone\" data-slot=\"5\">\n                    <div class=\"flex items-center justify-between mb-2\">\n                        <span class=\"text-xs font-bold uppercase tracking-wider text-amber-800\">Gap 5</span>\n                        <span class=\"text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-bold\">Select Question 5</span>\n                    </div>\n                    <select class=\"touch-target w-full bg-white border border-amber-300 rounded-lg px-3 py-2 text-sm md:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 answer-select\" data-index=\"5\">\n                        <option value=\"\">-- Choose the correct question --</option>\n                        <option value=\"2\">When are you next having a quiet night in?</option>\n                        <option value=\"3\">Did you have a lie-in last weekend?</option>\n                        <option value=\"4\">Have you ever chatted to people online?</option>\n                        <option value=\"5\">Have you been clubbing in the last month?</option>\n                    </select>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3 pl-0 md:pl-18\">\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Megan</span>\n                        <p class=\"text-slate-700\">No, but I'm looking forward to going next week. It's my best friend's birthday.</p>\n                    </div>\n                    <div class=\"bg-slate-50 p-2.5 rounded-lg border border-slate-100\">\n                        <span class=\"font-semibold text-xs text-slate-500 uppercase block mb-1\">Andy</span>\n                        <p class=\"text-slate-700\">The last time I went to a club it was called a disco and I was about 18!</p>\n                    </div>\n                </div>\n\n            </div>\n        </main>\n\n        <!-- Action Footer -->\n        <footer class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-6 flex flex-col md:flex-row items-center justify-between gap-4\">\n            <div id=\"score-display\" class=\"text-base font-semibold text-slate-700\">\n                Score: <span id=\"correct-count\">0</span> / 4\n            </div>\n            \n            <div class=\"flex items-center gap-3 w-full md:w-auto\">\n                <button id=\"reset-btn\" class=\"touch-target flex-1 md:flex-none px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold hover:bg-slate-100 active:bg-slate-200 transition-colors\">\n                    Reset\n                </button>\n                <button id=\"check-btn\" class=\"touch-target flex-1 md:flex-none px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold hover:bg-indigo-700 active:bg-indigo-800 transition-colors shadow-sm\">\n                    Check Answers\n                </button>\n            </div>\n        </footer>\n\n    </div>\n\n    <script>\n        const correctAnswers = {\n            \"2\": \"2\",\n            \"3\": \"3\",\n            \"4\": \"4\",\n            \"5\": \"5\"\n        };\n\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const selects = document.querySelectorAll('.answer-select');\n        const correctCountSpan = document.getElementById('correct-count');\n\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n            const total = Object.keys(correctAnswers).length;\n\n            selects.forEach(select => {\n                const slot = select.getAttribute('data-index');\n                const val = select.value;\n                \n                // Remove previous color rings\n                select.classList.remove('border-emerald-600', 'bg-emerald-50', 'border-red-600', 'bg-red-50');\n\n                if (val === correctAnswers[slot]) {\n                    correctCount++;\n                    select.classList.add('border-emerald-600', 'bg-emerald-50', 'text-emerald-900');\n                } else {\n                    select.classList.add('border-red-600', 'bg-red-50', 'text-red-900');\n                }\n            });\n\n            correctCountSpan.textContent = correctCount;\n\n            // Send score to parent container if embedded\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: total\n            }, '*');\n        });\n\n        resetBtn.addEventListener('click', () => {\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('border-emerald-600', 'bg-emerald-50', 'text-emerald-900', 'border-red-600', 'bg-red-50', 'text-red-900');\n            });\n            correctCountSpan.textContent = \"0\";\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: 0,\n                total: 4\n            }, '*');\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793071072822,
      "title": "Actividad IA #5",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Complete the questions with an auxiliary</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom styles for touch optimization and smooth transitions */\n        input:focus {\n            outline: none;\n            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.4);\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-2xl mx-auto p-4 md:p-6 my-auto\">\n        \n        <!-- Header Card -->\n        <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5 mb-5\">\n            <div class=\"flex items-center gap-3 mb-2\">\n                <span class=\"flex items-center justify-center bg-indigo-600 text-white font-bold text-sm w-7 h-7 rounded-full shadow-sm flex-shrink-0\">4</span>\n                <h1 class=\"text-base md:text-lg font-bold text-slate-900 leading-snug\">\n                    a) Complete the questions with an auxiliary if necessary.\n                </h1>\n            </div>\n            <p class=\"text-xs md:text-sm text-slate-500 pl-10\">\n                Type the correct auxiliary verb (e.g., <code class=\"bg-slate-100 text-indigo-600 px-1 py-0.5 rounded font-mono\">did</code>, <code class=\"bg-slate-100 text-indigo-600 px-1 py-0.5 rounded font-mono\">is</code>, <code class=\"bg-slate-100 text-indigo-600 px-1 py-0.5 rounded font-mono\">has</code>) or leave blank (<code class=\"bg-slate-100 text-slate-600 px-1 py-0.5 rounded font-mono\">-</code>) if no auxiliary is needed.\n            </p>\n        </div>\n\n        <!-- Exercise Form -->\n        <form id=\"quiz-form\" class=\"space-y-4 mb-6\">\n\n            <!-- Item 1 (Example) -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-2xs flex flex-col gap-2\">\n                <div class=\"text-sm md:text-base leading-relaxed flex flex-wrap items-center gap-y-2\">\n                    <span class=\"font-semibold text-slate-500 mr-2\">1</span>\n                    <span>How many times</span>\n                    <input type=\"text\" value=\"did\" disabled class=\"mx-2 bg-slate-100 text-slate-700 font-semibold px-3 py-2 rounded-lg border border-slate-300 w-28 text-center text-sm cursor-not-allowed\">\n                    <span>Megan eat out last month?</span>\n                </div>\n                <span class=\"text-xs text-emerald-600 font-medium pl-6\">✓ Example given</span>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-2xs flex flex-col gap-2\">\n                <div class=\"text-sm md:text-base leading-relaxed flex flex-wrap items-center gap-y-2\">\n                    <span class=\"font-semibold text-slate-500 mr-2\">2</span>\n                    <span>Who</span>\n                    <input type=\"text\" data-answer=\"-\" placeholder=\"aux / -\" class=\"mx-2 bg-slate-50 font-semibold text-slate-800 px-3 py-2 rounded-lg border border-slate-300 w-28 text-center text-base transition-colors\">\n                    <span>cooks when Karen and Andy have friends round for dinner?</span>\n                </div>\n                <div id=\"feedback-2\" class=\"text-xs font-medium pl-6 hidden\"></div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-2xs flex flex-col gap-2\">\n                <div class=\"text-sm md:text-base leading-relaxed flex flex-wrap items-center gap-y-2\">\n                    <span class=\"font-semibold text-slate-500 mr-2\">3</span>\n                    <span>When</span>\n                    <input type=\"text\" data-answer=\"did\" placeholder=\"aux / -\" class=\"mx-2 bg-slate-50 font-semibold text-slate-800 px-3 py-2 rounded-lg border border-slate-300 w-28 text-center text-base transition-colors\">\n                    <span>Megan last have a quiet night in?</span>\n                </div>\n                <div id=\"feedback-3\" class=\"text-xs font-medium pl-6 hidden\"></div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-2xs flex flex-col gap-2\">\n                <div class=\"text-sm md:text-base leading-relaxed flex flex-wrap items-center gap-y-2\">\n                    <span class=\"font-semibold text-slate-500 mr-2\">4</span>\n                    <span>How often</span>\n                    <input type=\"text\" data-answer=\"do\" placeholder=\"aux / -\" class=\"mx-2 bg-slate-50 font-semibold text-slate-800 px-3 py-2 rounded-lg border border-slate-300 w-28 text-center text-base transition-colors\">\n                    <span>Karen and Andy have quiet nights in?</span>\n                </div>\n                <div id=\"feedback-4\" class=\"text-xs font-medium pl-6 hidden\"></div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-2xs flex flex-col gap-2\">\n                <div class=\"text-sm md:text-base leading-relaxed flex flex-wrap items-center gap-y-2\">\n                    <span class=\"font-semibold text-slate-500 mr-2\">5</span>\n                    <span>Why</span>\n                    <input type=\"text\" data-answer=\"do\" placeholder=\"aux / -\" class=\"mx-2 bg-slate-50 font-semibold text-slate-800 px-3 py-2 rounded-lg border border-slate-300 w-28 text-center text-base transition-colors\">\n                    <span>Karen and Andy never have lie-ins?</span>\n                </div>\n                <div id=\"feedback-5\" class=\"text-xs font-medium pl-6 hidden\"></div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-2xs flex flex-col gap-2\">\n                <div class=\"text-sm md:text-base leading-relaxed flex flex-wrap items-center gap-y-2\">\n                    <span class=\"font-semibold text-slate-500 mr-2\">6</span>\n                    <span>Why</span>\n                    <input type=\"text\" data-answer=\"is\" placeholder=\"aux / -\" class=\"mx-2 bg-slate-50 font-semibold text-slate-800 px-3 py-2 rounded-lg border border-slate-300 w-28 text-center text-base transition-colors\">\n                    <span>Megan going clubbing next week?</span>\n                </div>\n                <div id=\"feedback-6\" class=\"text-xs font-medium pl-6 hidden\"></div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-2xs flex flex-col gap-2\">\n                <div class=\"text-sm md:text-base leading-relaxed flex flex-wrap items-center gap-y-2\">\n                    <span class=\"font-semibold text-slate-500 mr-2\">7</span>\n                    <span>How many clubs</span>\n                    <input type=\"text\" data-answer=\"has\" placeholder=\"aux / -\" class=\"mx-2 bg-slate-50 font-semibold text-slate-800 px-3 py-2 rounded-lg border border-slate-300 w-28 text-center text-base transition-colors\">\n                    <span>Andy been to in the last year?</span>\n                </div>\n                <div id=\"feedback-7\" class=\"text-xs font-medium pl-6 hidden\"></div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-2xs flex flex-col gap-2\">\n                <div class=\"text-sm md:text-base leading-relaxed flex flex-wrap items-center gap-y-2\">\n                    <span class=\"font-semibold text-slate-500 mr-2\">8</span>\n                    <span>Who</span>\n                    <input type=\"text\" data-answer=\"-\" placeholder=\"aux / -\" class=\"mx-2 bg-slate-50 font-semibold text-slate-800 px-3 py-2 rounded-lg border border-slate-300 w-28 text-center text-base transition-colors\">\n                    <span>chatted to people online at the weekend?</span>\n                </div>\n                <div id=\"feedback-8\" class=\"text-xs font-medium pl-6 hidden\"></div>\n            </div>\n\n            <!-- Controls & Scoreboard -->\n            <div class=\"sticky bottom-4 bg-white/90 backdrop-blur-md p-4 rounded-2xl shadow-lg border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 mt-8\">\n                <div id=\"score-display\" class=\"text-sm font-semibold text-slate-600\">\n                    Score: <span id=\"current-score\">0</span> / 7\n                </div>\n                <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                    <button type=\"button\" id=\"reset-btn\" class=\"flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium text-sm hover:bg-slate-100 active:scale-95 transition-all min-h-[42px]\">\n                        Reset\n                    </button>\n                    <button type=\"button\" id=\"check-btn\" class=\"flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-medium text-sm hover:bg-indigo-700 active:scale-95 shadow-md shadow-indigo-200 transition-all min-h-[42px]\">\n                        Check Answers\n                    </button>\n                </div>\n            </div>\n\n        </form>\n    </main>\n\n    <!-- Footer Script Logic -->\n    <script>\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const inputs = document.querySelectorAll('input[data-answer]');\n        const scoreDisplay = document.getElementById('current-score');\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalCount = inputs.length;\n\n            inputs.forEach((input, index) => {\n                const userVal = input.value.trim().toLowerCase();\n                const expected = input.getAttribute('data-answer').toLowerCase();\n                const feedbackEl = document.getElementById(`feedback-${index + 2}`);\n\n                input.classList.remove('border-slate-300', 'border-emerald-500', 'border-red-500', 'bg-emerald-50', 'bg-red-50', 'text-emerald-900', 'text-red-900');\n                feedbackEl.classList.remove('hidden', 'text-emerald-600', 'text-red-600');\n\n                if (userVal === expected) {\n                    correctCount++;\n                    input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n                    feedbackEl.textContent = '✓ Correct!';\n                    feedbackEl.classList.add('text-emerald-600');\n                } else {\n                    input.classList.add('border-red-500', 'bg-red-50', 'text-red-900');\n                    feedbackEl.textContent = `✗ Incorrect. Expected: \"${expected}\"`;\n                    feedbackEl.classList.add('text-red-600');\n                }\n            });\n\n            scoreDisplay.textContent = correctCount;\n\n            // Emit score to parent container/LMS\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        }\n\n        function resetActivity() {\n            inputs.forEach((input, index) => {\n                input.value = '';\n                input.classList.remove('border-emerald-500', 'border-red-500', 'bg-emerald-50', 'bg-red-50', 'text-emerald-900', 'text-red-900');\n                input.classList.add('border-slate-300', 'bg-slate-50', 'text-slate-800');\n                \n                const feedbackEl = document.getElementById(`feedback-${index + 2}`);\n                feedbackEl.textContent = '';\n                feedbackEl.classList.add('hidden');\n            });\n            scoreDisplay.textContent = '0';\n        }\n\n        checkBtn.addEventListener('click', checkAnswers);\n        resetBtn.addEventListener('click', resetActivity);\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793071631846,
      "title": "Actividad IA #6",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Weekends in or weekends out? - Interactive Exercise</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .touch-target {\n            min-height: 42px;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col\">\n\n    <!-- Header / Navbar -->\n    <header class=\"bg-indigo-600 text-white shadow-md py-4 px-4 sticky top-0 z-50\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2\">\n            <div>\n                <h1 class=\"text-lg md:text-xl font-bold\">Weekends in or weekends out?</h1>\n                <p class=\"text-xs md:text-sm text-indigo-100\">Exercise 4b: Answer the questions based on the article.</p>\n            </div>\n            <div id=\"score-badge\" class=\"bg-indigo-700 px-3 py-1.5 rounded-full text-sm font-semibold tracking-wide border border-indigo-500\">\n                Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">8</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-3 md:p-6 flex-grow flex flex-col gap-6\">\n\n        <!-- Reading Reference Section (Accordion / Collapsible or Clean Card for Mobile-First) -->\n        <section class=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden\">\n            <button onclick=\"toggleReading()\" class=\"w-full bg-slate-100 hover:bg-slate-200 p-4 text-left font-semibold text-slate-700 flex justify-between items-center touch-target transition-colors\">\n                <span class=\"flex items-center gap-2\">\n                    <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"/></svg>\n                    Reference Article & Complete Interview (Ex. 3)\n                </span>\n                <span id=\"toggle-icon\" class=\"text-sm text-indigo-600 font-bold\">Show / Hide</span>\n            </button>\n            <div id=\"reading-content\" class=\"p-4 md:p-6 text-sm md:text-base space-y-3 bg-amber-50/50 border-t border-slate-100\">\n                <p class=\"text-xs text-slate-500 italic mb-2\">Note: The article includes the completed questions from Exercise 3 in their correct places (1-5) as context for answering Exercise 4b.</p>\n                <div class=\"space-y-3 font-sans\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">MEGAN:</span>\n                        <span class=\"md:col-span-3 text-slate-700\"><sup>1</sup>How often do you have people round for dinner? <br><strong>Never. But last month I ate out with friends at least five times.</strong></span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">KAREN:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">About once a month. My husband always cooks. This weekend we're visiting friends for dinner. <br><sup class=\"text-indigo-600 font-semibold\">[2 When are you next having a quiet night in?]</sup> <strong class=\"text-indigo-800\">-> Andy (always cooks).</strong></span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">MEGAN:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">I haven't had a quiet night in since I was a teenager!</span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">ANDY:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">Next Friday. We always have a quiet night in on Fridays. <br><sup class=\"text-indigo-600 font-semibold\">[3 Did you have a lie-in last weekend?]</sup></span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">MEGAN:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">Yes, of course. Sunday mornings are perfect for lie-ins!</span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">KAREN:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">No! Lie-ins are impossible with two young children. <br><sup class=\"text-indigo-600 font-semibold\">[4 Have you ever chatted to people online?]</sup></span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">MEGAN:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">Yes, I have. My brother lives abroad and it's cheaper than phoning.</span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">KAREN:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">The children chat to their friends online, but I haven't tried it yet. <br><sup class=\"text-indigo-600 font-semibold\">[5 Have you been clubbing in the last month?]</sup></span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1 border-b pb-2\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">MEGAN:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">No, but I'm looking forward to going next week. It's my best friend's birthday.</span>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-1\">\n                        <span class=\"font-bold text-indigo-900 md:col-span-1\">ANDY:</span>\n                        <span class=\"md:col-span-3 text-slate-700\">The last time I went to a club it was called a disco and I was about 18!</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Interactive Activity Section (Exercise 4b) -->\n        <section class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 md:p-6\">\n            <h2 class=\"text-base md:text-lg font-bold text-slate-800 mb-1\">Exercise 4b: Answer the questions in 4a</h2>\n            <p class=\"text-xs md:text-sm text-slate-500 mb-6\">Type short, natural answers based on the article and answer key.</p>\n\n            <form id=\"quiz-form\" class=\"space-y-4\" onsubmit=\"event.preventDefault();\">\n\n                <!-- Question 1 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                    <span class=\"font-bold text-indigo-600 w-6 flex-shrink-0\">1.</span>\n                    <div class=\"flex-grow w-full\">\n                        <p class=\"text-xs md:text-sm text-slate-600 mb-1 font-medium\">How many times did Megan eat out last month?</p>\n                        <input type=\"text\" id=\"q1\" disabled value=\"She ate out with friends at least five times.\" class=\"w-full px-3 py-2 text-sm md:text-base border rounded-md bg-emerald-50 text-emerald-900 border-emerald-300 font-medium\">\n                    </div>\n                    <span class=\"text-xs text-emerald-600 font-semibold px-2 py-1 bg-emerald-100 rounded\">Example</span>\n                </div>\n\n                <!-- Question 2 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                    <span class=\"font-bold text-indigo-600 w-6 flex-shrink-0\">2.</span>\n                    <div class=\"flex-grow w-full\">\n                        <p class=\"text-xs md:text-sm text-slate-600 mb-1 font-medium\">Who cooks when Karen and Andy have friends round for dinner?</p>\n                        <input type=\"text\" id=\"q2\" placeholder=\"Type answer...\" class=\"w-full px-3 py-2 text-sm md:text-base border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                    </div>\n                </div>\n\n                <!-- Question 3 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                    <span class=\"font-bold text-indigo-600 w-6 flex-shrink-0\">3.</span>\n                    <div class=\"flex-grow w-full\">\n                        <p class=\"text-xs md:text-sm text-slate-600 mb-1 font-medium\">When did Megan last have a quiet night in?</p>\n                        <input type=\"text\" id=\"q3\" placeholder=\"Type answer...\" class=\"w-full px-3 py-2 text-sm md:text-base border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                    </div>\n                </div>\n\n                <!-- Question 4 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                    <span class=\"font-bold text-indigo-600 w-6 flex-shrink-0\">4.</span>\n                    <div class=\"flex-grow w-full\">\n                        <p class=\"text-xs md:text-sm text-slate-600 mb-1 font-medium\">How often do Karen and Andy have quiet nights in?</p>\n                        <input type=\"text\" id=\"q4\" placeholder=\"Type answer...\" class=\"w-full px-3 py-2 text-sm md:text-base border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                    </div>\n                </div>\n\n                <!-- Question 5 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                    <span class=\"font-bold text-indigo-600 w-6 flex-shrink-0\">5.</span>\n                    <div class=\"flex-grow w-full\">\n                        <p class=\"text-xs md:text-sm text-slate-600 mb-1 font-medium\">Why do Karen and Andy never have lie-ins?</p>\n                        <input type=\"text\" id=\"q5\" placeholder=\"Type answer...\" class=\"w-full px-3 py-2 text-sm md:text-base border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                    </div>\n                </div>\n\n                <!-- Question 6 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                    <span class=\"font-bold text-indigo-600 w-6 flex-shrink-0\">6.</span>\n                    <div class=\"flex-grow w-full\">\n                        <p class=\"text-xs md:text-sm text-slate-600 mb-1 font-medium\">Why is Megan going clubbing next week?</p>\n                        <input type=\"text\" id=\"q6\" placeholder=\"Type answer...\" class=\"w-full px-3 py-2 text-sm md:text-base border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                    </div>\n                </div>\n\n                <!-- Question 7 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                    <span class=\"font-bold text-indigo-600 w-6 flex-shrink-0\">7.</span>\n                    <div class=\"flex-grow w-full\">\n                        <p class=\"text-xs md:text-sm text-slate-600 mb-1 font-medium\">How many clubs has Andy been to in the last year?</p>\n                        <input type=\"text\" id=\"q7\" placeholder=\"Type answer...\" class=\"w-full px-3 py-2 text-sm md:text-base border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                    </div>\n                </div>\n\n                <!-- Question 8 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200\">\n                    <span class=\"font-bold text-indigo-600 w-6 flex-shrink-0\">8.</span>\n                    <div class=\"flex-grow w-full\">\n                        <p class=\"text-xs md:text-sm text-slate-600 mb-1 font-medium\">Who chatted to people online at the weekend?</p>\n                        <input type=\"text\" id=\"q8\" placeholder=\"Type answer...\" class=\"w-full px-3 py-2 text-sm md:text-base border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                    </div>\n                </div>\n\n                <!-- Action Buttons -->\n                <div class=\"flex flex-col sm:flex-row gap-3 pt-4\">\n                    <button type=\"button\" onclick=\"checkAnswers()\" class=\"flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow transition-colors touch-target\">\n                        Check Answers\n                    </button>\n                    <button type=\"button\" onclick=\"resetQuiz()\" class=\"sm:w-auto bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold py-3 px-6 rounded-xl transition-colors touch-target\">\n                        Reset\n                    </button>\n                </div>\n            </form>\n        </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-400 mt-auto\">\n        Interactive ELT Learning Module &bull; Mobile Optimized Responsive Design\n    ></footer>\n\n    <!-- JavaScript Logic -->\n    <script>\n        // Answer Key based exactly on textbook answer key\n        const answerKey = {\n            q2: [\"andy\", \"andy always cooks\", \"always cooks\"],\n            q3: [\"when she was a teenager\", \"she was a teenager\"],\n            q4: [\"every friday\", \"on fridays\"],\n            q5: [\"because they've got two young children\", \"they've got two young children\", \"because they have two young children\", \"have two young children\"],\n            q6: [\"because it's her best friend's birthday\", \"it's her best friend's birthday\", \"because it is her best friend's birthday\"],\n            q7: [\"none\", \"zero\"],\n            q8: [\"megan\", \"megan did\"]\n        };\n\n        function toggleReading() {\n            const content = document.getElementById('reading-content');\n            const icon = document.getElementById('toggle-icon');\n            if (content.style.display === 'none') {\n                content.style.display = 'block';\n                icon.textContent = 'Hide';\n            } else {\n                content.style.display = 'none';\n                icon.textContent = 'Show';\n            }\n        }\n\n        function normalizeText(text) {\n            return text.toLowerCase()\n                       .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g, \"\")\n                       .replace(/\\s+/g, \" \")\n                       .trim();\n        }\n\n        function checkAnswers() {\n            let correctCount = 1; // Question 1 is pre-solved example\n            const totalCount = 8;\n\n            for (let i = 2; i <= 8; i++) {\n                const input = document.getElementById(`q2`); // handled in loop dynamically\n            }\n\n            Object.keys(answerKey).forEach((qId, index) => {\n                const input = document.getElementById(qId);\n                const userVal = normalizeText(input.value);\n                const validAnswers = answerKey[qId];\n\n                let isCorrect = validAnswers.some(ans => userVal.includes(normalizeText(ans)));\n\n                // Special strict checks for specific short answers\n                if (qId === 'q7') {\n                    isCorrect = (userVal === 'none' || userVal === '0' || userVal === 'zero');\n                }\n                if (qId === 'q8') {\n                    isCorrect = (userVal === 'megan' || userVal === 'megan did');\n                }\n\n                input.classList.remove('bg-emerald-50', 'text-emerald-900', 'border-emerald-300', 'bg-rose-50', 'text-rose-900', 'border-rose-300', 'border-slate-300');\n\n                if (isCorrect && userVal !== \"\") {\n                    input.classList.add('bg-emerald-50', 'text-emerald-900', 'border-emerald-500');\n                    correctCount++;\n                } else {\n                    input.classList.add('bg-rose-50', 'text-rose-900', 'border-rose-500');\n                }\n            });\n\n            document.getElementById('current-score').textContent = correctCount;\n\n            // Post message to parent container if embedded in iframe\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        }\n\n        function resetQuiz() {\n            Object.keys(answerKey).forEach(qId => {\n                const input = document.getElementById(qId);\n                input.value = \"\";\n                input.classList.remove('bg-emerald-50', 'text-emerald-900', 'border-emerald-500', 'bg-rose-50', 'text-rose-900', 'border-rose-500');\n                input.classList.add('border-slate-300');\n            });\n            document.getElementById('current-score').textContent = '0';\n        }\n    </script>\n</body>\n</html>"
    }
  ]
}