      "title": "Actividad IA #2",
      "html": "<!DOCTYPE html>\n<html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Auxiliary Verbs Practice</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom smooth transition styles */\n        .input-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .input-incorrect {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n<style>*, ::before, ::after{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }::backdrop{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }/* ! tailwindcss v3.4.17 | MIT License | https://tailwindcss.com */*,::after,::before{box-sizing:border-box;border-width:0;border-style:solid;border-color:#e5e7eb}::after,::before{--tw-content:''}:host,html{line-height:1.5;-webkit-text-size-adjust:100%;-moz-tab-size:4;tab-size:4;font-family:ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\";font-feature-settings:normal;font-variation-settings:normal;-webkit-tap-highlight-color:transparent}body{margin:0;line-height:inherit}hr{height:0;color:inherit;border-top-width:1px}abbr:where([title]){-webkit-text-decoration:underline dotted;text-decoration:underline dotted}h1,h2,h3,h4,h5,h6{font-size:inherit;font-weight:inherit}a{color:inherit;text-decoration:inherit}b,strong{font-weight:bolder}code,kbd,pre,samp{font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;font-feature-settings:normal;font-variation-settings:normal;font-size:1em}small{font-size:80%}sub,sup{font-size:75%;line-height:0;position:relative;vertical-align:baseline}sub{bottom:-.25em}sup{top:-.5em}table{text-indent:0;border-color:inherit;border-collapse:collapse}button,input,optgroup,select,textarea{font-family:inherit;font-feature-settings:inherit;font-variation-settings:inherit;font-size:100%;font-weight:inherit;line-height:inherit;letter-spacing:inherit;color:inherit;margin:0;padding:0}button,select{text-transform:none}button,input:where([type=button]),input:where([type=reset]),input:where([type=submit]){-webkit-appearance:button;background-color:transparent;background-image:none}:-moz-focusring{outline:auto}:-moz-ui-invalid{box-shadow:none}progress{vertical-align:baseline}::-webkit-inner-spin-button,::-webkit-outer-spin-button{height:auto}[type=search]{-webkit-appearance:textfield;outline-offset:-2px}::-webkit-search-decoration{-webkit-appearance:none}::-webkit-file-upload-button{-webkit-appearance:button;font:inherit}summary{display:list-item}blockquote,dd,dl,figure,h1,h2,h3,h4,h5,h6,hr,p,pre{margin:0}fieldset{margin:0;padding:0}legend{padding:0}menu,ol,ul{list-style:none;margin:0;padding:0}dialog{padding:0}textarea{resize:vertical}input::placeholder,textarea::placeholder{opacity:1;color:#9ca3af}[role=button],button{cursor:pointer}:disabled{cursor:default}audio,canvas,embed,iframe,img,object,svg,video{display:block;vertical-align:middle}img,video{max-width:100%;height:auto}[hidden]:where(:not([hidden=until-found])){display:none}.mx-auto{margin-left:auto;margin-right:auto}.mb-2{margin-bottom:0.5rem}.mb-6{margin-bottom:1.5rem}.ml-2{margin-left:0.5rem}.mt-0\\.5{margin-top:0.125rem}.mt-2{margin-top:0.5rem}.block{display:block}.flex{display:flex}.hidden{display:none}.h-11{height:2.75rem}.h-12{height:3rem}.h-5{height:1.25rem}.h-7{height:1.75rem}.min-h-screen{min-height:100vh}.w-36{width:9rem}.w-5{width:1.25rem}.w-7{width:1.75rem}.w-full{width:100%}.max-w-3xl{max-width:48rem}.flex-1{flex:1 1 0%}.flex-shrink-0{flex-shrink:0}.flex-grow{flex-grow:1}.flex-col{flex-direction:column}.flex-wrap{flex-wrap:wrap}.items-start{align-items:flex-start}.items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}.gap-2{gap:0.5rem}.gap-3{gap:0.75rem}.gap-4{gap:1rem}.space-y-4 > :not([hidden]) ~ :not([hidden]){--tw-space-y-reverse:0;margin-top:calc(1rem * calc(1 - var(--tw-space-y-reverse)));margin-bottom:calc(1rem * var(--tw-space-y-reverse))}.rounded{border-radius:0.25rem}.rounded-2xl{border-radius:1rem}.rounded-full{border-radius:9999px}.rounded-lg{border-radius:0.5rem}.rounded-xl{border-radius:0.75rem}.border{border-width:1px}.border-slate-200{--tw-border-opacity:1;border-color:rgb(226 232 240 / var(--tw-border-opacity, 1))}.border-slate-200\\/80{border-color:rgb(226 232 240 / 0.8)}.border-slate-300{--tw-border-opacity:1;border-color:rgb(203 213 225 / var(--tw-border-opacity, 1))}.bg-indigo-100{--tw-bg-opacity:1;background-color:rgb(224 231 255 / var(--tw-bg-opacity, 1))}.bg-indigo-600{--tw-bg-opacity:1;background-color:rgb(79 70 229 / var(--tw-bg-opacity, 1))}.bg-slate-100{--tw-bg-opacity:1;background-color:rgb(241 245 249 / var(--tw-bg-opacity, 1))}.bg-slate-200\\/60{background-color:rgb(226 232 240 / 0.6)}.bg-slate-300{--tw-bg-opacity:1;background-color:rgb(203 213 225 / var(--tw-bg-opacity, 1))}.bg-slate-50{--tw-bg-opacity:1;background-color:rgb(248 250 252 / var(--tw-bg-opacity, 1))}.bg-white{--tw-bg-opacity:1;background-color:rgb(255 255 255 / var(--tw-bg-opacity, 1))}.p-3\\.5{padding:0.875rem}.p-4{padding:1rem}.p-5{padding:1.25rem}.px-2{padding-left:0.5rem;padding-right:0.5rem}.px-3{padding-left:0.75rem;padding-right:0.75rem}.px-5{padding-left:1.25rem;padding-right:1.25rem}.px-6{padding-left:1.5rem;padding-right:1.5rem}.py-0\\.5{padding-top:0.125rem;padding-bottom:0.125rem}.py-1{padding-top:0.25rem;padding-bottom:0.25rem}.text-center{text-align:center}.font-sans{font-family:ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"}.text-2xl{font-size:1.5rem;line-height:2rem}.text-base{font-size:1rem;line-height:1.5rem}.text-sm{font-size:0.875rem;line-height:1.25rem}.text-xl{font-size:1.25rem;line-height:1.75rem}.text-xs{font-size:0.75rem;line-height:1rem}.font-black{font-weight:900}.font-bold{font-weight:700}.font-medium{font-weight:500}.font-semibold{font-weight:600}.uppercase{text-transform:uppercase}.not-italic{font-style:normal}.leading-loose{line-height:2}.leading-relaxed{line-height:1.625}.tracking-wider{letter-spacing:0.05em}.text-indigo-600{--tw-text-opacity:1;color:rgb(79 70 229 / var(--tw-text-opacity, 1))}.text-indigo-700{--tw-text-opacity:1;color:rgb(67 56 202 / var(--tw-text-opacity, 1))}.text-slate-400{--tw-text-opacity:1;color:rgb(148 163 184 / var(--tw-text-opacity, 1))}.text-slate-600{--tw-text-opacity:1;color:rgb(71 85 105 / var(--tw-text-opacity, 1))}.text-slate-700{--tw-text-opacity:1;color:rgb(51 65 85 / var(--tw-text-opacity, 1))}.text-slate-800{--tw-text-opacity:1;color:rgb(30 41 59 / var(--tw-text-opacity, 1))}.text-slate-900{--tw-text-opacity:1;color:rgb(15 23 42 / var(--tw-text-opacity, 1))}.text-white{--tw-text-opacity:1;color:rgb(255 255 255 / var(--tw-text-opacity, 1))}.underline{-webkit-text-decoration-line:underline;text-decoration-line:underline}.decoration-indigo-400{-webkit-text-decoration-color:#818cf8;text-decoration-color:#818cf8}.underline-offset-4{text-underline-offset:4px}.antialiased{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.shadow-sm{--tw-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05);--tw-shadow-colored:0 1px 2px 0 var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)}.transition-all{transition-property:all;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms}.transition-colors{transition-property:color, background-color, border-color, fill, stroke, -webkit-text-decoration-color;transition-property:color, background-color, border-color, text-decoration-color, fill, stroke;transition-property:color, background-color, border-color, text-decoration-color, fill, stroke, -webkit-text-decoration-color;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms}.selection\\:bg-indigo-100 *::selection{--tw-bg-opacity:1;background-color:rgb(224 231 255 / var(--tw-bg-opacity, 1))}.selection\\:bg-indigo-100::selection{--tw-bg-opacity:1;background-color:rgb(224 231 255 / var(--tw-bg-opacity, 1))}.hover\\:border-slate-300:hover{--tw-border-opacity:1;border-color:rgb(203 213 225 / var(--tw-border-opacity, 1))}.hover\\:bg-indigo-700:hover{--tw-bg-opacity:1;background-color:rgb(67 56 202 / var(--tw-bg-opacity, 1))}.hover\\:bg-slate-200:hover{--tw-bg-opacity:1;background-color:rgb(226 232 240 / var(--tw-bg-opacity, 1))}.focus\\:border-indigo-500:focus{--tw-border-opacity:1;border-color:rgb(99 102 241 / var(--tw-border-opacity, 1))}.focus\\:outline-none:focus{outline:2px solid transparent;outline-offset:2px}.focus\\:ring-2:focus{--tw-ring-offset-shadow:var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);--tw-ring-shadow:var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);box-shadow:var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000)}.focus\\:ring-indigo-500:focus{--tw-ring-opacity:1;--tw-ring-color:rgb(99 102 241 / var(--tw-ring-opacity, 1))}.active\\:bg-indigo-800:active{--tw-bg-opacity:1;background-color:rgb(55 48 163 / var(--tw-bg-opacity, 1))}.active\\:bg-slate-300:active{--tw-bg-opacity:1;background-color:rgb(203 213 225 / var(--tw-bg-opacity, 1))}@media (min-width: 640px){.sm\\:w-auto{width:auto}.sm\\:flex-initial{flex:0 1 auto}.sm\\:flex-row{flex-direction:row}.sm\\:p-4{padding:1rem}.sm\\:p-6{padding:1.5rem}.sm\\:text-right{text-align:right}.sm\\:text-2xl{font-size:1.5rem;line-height:2rem}.sm\\:text-base{font-size:1rem;line-height:1.5rem}}@media (min-width: 768px){.md\\:p-8{padding:2rem}}</style></head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased selection:bg-indigo-100\">\n\n    <main class=\"w-full max-w-3xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        <!-- Header / Banner -->\n        <header class=\"bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 mb-6\">\n            <div class=\"flex items-center gap-3 mb-2\">\n                <span class=\"bg-indigo-100 text-indigo-700 font-bold text-xs uppercase tracking-wider px-3 py-1 rounded-full\">\n                    Grammar • RW1.1\n                </span>\n                <span class=\"text-xs text-slate-400 font-medium\">Question Tags &amp; Auxiliaries</span>\n            </div>\n            <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900\">\n                Auxiliaries with <em class=\"not-italic text-indigo-600\">not</em>\n            </h1>\n            <p class=\"mt-2 text-sm sm:text-base text-slate-600 leading-relaxed\">\n                Fill in the gaps with <strong>not</strong> and the correct form of the auxiliaries <em>do</em>, <em>be</em>, or <em>have</em>. Use negative contractions (e.g., <em>don't</em>, <em>hasn't</em>).\n            </p>\n        </header>\n\n        <!-- Exercise Card -->\n        <section class=\"bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 mb-6\">\n            \n            <!-- Example Item -->\n            <div class=\"mb-6 p-4 bg-slate-50 border border-slate-200 rounded-xl flex items-start gap-3\">\n                <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-300 text-slate-700 font-bold text-xs flex items-center justify-center mt-0.5\">\n                    1\n                </span>\n                <div class=\"text-base text-slate-700 leading-relaxed\">\n                    You <span class=\"font-bold text-indigo-700 underline underline-offset-4 decoration-indigo-400\">aren't</span> coming tomorrow.\n                    <span class=\"ml-2 text-xs font-semibold uppercase tracking-wider text-slate-400 bg-slate-200/60 px-2 py-0.5 rounded\">Example</span>\n                </div>\n            </div>\n\n            <!-- Questions Form -->\n            <form id=\"exerciseForm\" onsubmit=\"event.preventDefault();\" class=\"space-y-4\">\n                \n                <!-- Q2 -->\n                <div class=\"p-3.5 sm:p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors bg-white\">\n                    <div class=\"flex flex-wrap items-center gap-2 text-base leading-loose\">\n                        <span class=\"font-bold text-slate-400 text-sm w-5\">2.</span>\n                        <span>I</span>\n                        <input type=\"text\" id=\"q2\" data-answer=\"don't\" data-alt=\"do not\" autocomplete=\"off\" spellcheck=\"false\" class=\"h-11 px-3 text-base sm:text-base font-medium rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-36 transition-all\" placeholder=\"...\">\n                        <span>need to bring anything to the barbecue.</span>\n                    </div>\n                    <div id=\"fb-q2\" class=\"hidden text-xs mt-2 font-medium\"></div>\n                </div>\n\n                <!-- Q3 -->\n                <div class=\"p-3.5 sm:p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors bg-white\">\n                    <div class=\"flex flex-wrap items-center gap-2 text-base leading-loose\">\n                        <span class=\"font-bold text-slate-400 text-sm w-5\">3.</span>\n                        <span>Clare</span>\n                        <input type=\"text\" id=\"q3\" data-answer=\"doesn't\" data-alt=\"does not\" autocomplete=\"off\" spellcheck=\"false\" class=\"h-11 px-3 text-base sm:text-base font-medium rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-36 transition-all\" placeholder=\"...\">\n                        <span>eat beef.</span>\n                    </div>\n                    <div id=\"fb-q3\" class=\"hidden text-xs mt-2 font-medium\"></div>\n                </div>\n\n                <!-- Q4 -->\n                <div class=\"p-3.5 sm:p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors bg-white\">\n                    <div class=\"flex flex-wrap items-center gap-2 text-base leading-loose\">\n                        <span class=\"font-bold text-slate-400 text-sm w-5\">4.</span>\n                        <span>He</span>\n                        <input type=\"text\" id=\"q4\" data-answer=\"hasn't\" data-alt=\"has not\" autocomplete=\"off\" spellcheck=\"false\" class=\"h-11 px-3 text-base sm:text-base font-medium rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-36 transition-all\" placeholder=\"...\">\n                        <span>been here before.</span>\n                    </div>\n                    <div id=\"fb-q4\" class=\"hidden text-xs mt-2 font-medium\"></div>\n                </div>\n\n                <!-- Q5 -->\n                <div class=\"p-3.5 sm:p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors bg-white\">\n                    <div class=\"flex flex-wrap items-center gap-2 text-base leading-loose\">\n                        <span class=\"font-bold text-slate-400 text-sm w-5\">5.</span>\n                        <span>They</span>\n                        <input type=\"text\" id=\"q5\" data-answer=\"haven't\" data-alt=\"have not\" autocomplete=\"off\" spellcheck=\"false\" class=\"h-11 px-3 text-base sm:text-base font-medium rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-36 transition-all\" placeholder=\"...\">\n                        <span>got any children.</span>\n                    </div>\n                    <div id=\"fb-q5\" class=\"hidden text-xs mt-2 font-medium\"></div>\n                </div>\n\n                <!-- Q6 -->\n                <div class=\"p-3.5 sm:p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors bg-white\">\n                    <div class=\"flex flex-wrap items-center gap-2 text-base leading-loose\">\n                        <span class=\"font-bold text-slate-400 text-sm w-5\">6.</span>\n                        <span>We</span>\n                        <input type=\"text\" id=\"q6\" data-answer=\"didn't\" data-alt=\"did not\" autocomplete=\"off\" spellcheck=\"false\" class=\"h-11 px-3 text-base sm:text-base font-medium rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-36 transition-all\" placeholder=\"...\">\n                        <span>see him yesterday.</span>\n                    </div>\n                    <div id=\"fb-q6\" class=\"hidden text-xs mt-2 font-medium\"></div>\n                </div>\n\n                <!-- Q7 -->\n                <div class=\"p-3.5 sm:p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors bg-white\">\n                    <div class=\"flex flex-wrap items-center gap-2 text-base leading-loose\">\n                        <span class=\"font-bold text-slate-400 text-sm w-5\">7.</span>\n                        <span>It</span>\n                        <input type=\"text\" id=\"q7\" data-answer=\"isn't\" data-alt=\"is not\" autocomplete=\"off\" spellcheck=\"false\" class=\"h-11 px-3 text-base sm:text-base font-medium rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-36 transition-all\" placeholder=\"...\">\n                        <span>going to rain.</span>\n                    </div>\n                    <div id=\"fb-q7\" class=\"hidden text-xs mt-2 font-medium\"></div>\n                </div>\n\n                <!-- Q8 -->\n                <div class=\"p-3.5 sm:p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors bg-white\">\n                    <div class=\"flex flex-wrap items-center gap-2 text-base leading-loose\">\n                        <span class=\"font-bold text-slate-400 text-sm w-5\">8.</span>\n                        <span>You</span>\n                        <input type=\"text\" id=\"q8\" data-answer=\"haven't\" data-alt=\"have not\" autocomplete=\"off\" spellcheck=\"false\" class=\"h-11 px-3 text-base sm:text-base font-medium rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-36 transition-all\" placeholder=\"...\">\n                        <span>told him yet.</span>\n                    </div>\n                    <div id=\"fb-q8\" class=\"hidden text-xs mt-2 font-medium\"></div>\n                </div>\n\n            </form>\n        </section>\n\n        <!-- Controls & Score Footer -->\n        <section class=\"bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4\">\n            <!-- Action Buttons -->\n            <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                <button type=\"button\" onclick=\"checkAnswers()\" class=\"flex-1 sm:flex-initial h-12 px-6 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold rounded-xl transition-colors flex items-center justify-center gap-2 shadow-sm text-base\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n                    </svg>\n                    Check Answers\n                </button>\n                <button type=\"button\" onclick=\"resetAnswers()\" class=\"h-12 px-5 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-700 font-semibold rounded-xl transition-colors flex items-center justify-center gap-2 text-base\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path>\n                    </svg>\n                    Reset\n                </button>\n            </div>\n\n            <!-- Score Display -->\n            <div id=\"scoreDisplay\" class=\"hidden w-full sm:w-auto text-center sm:text-right\">\n                <span class=\"text-xs uppercase tracking-wider text-slate-400 font-bold block\">Your Score</span>\n                <span id=\"scoreText\" class=\"text-2xl font-black text-indigo-600\">0 / 7</span>\n            </div>\n        </section>\n    </main>\n\n    <script>\n        const questionIds = ['q2', 'q3', 'q4', 'q5', 'q6', 'q7', 'q8'];\n\n        // Normalize string helper (handles smart apostrophes and case/spaces)\n        function cleanInput(val) {\n            return val ? val.trim().toLowerCase().replace(/’/g, \"'\") : '';\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalCount = questionIds.length;\n\n            questionIds.forEach(id => {\n                const inputEl = document.getElementById(id);\n                const fbEl = document.getElementById('fb-' + id);\n                const userAnswer = cleanInput(inputEl.value);\n                const correctAnswer = cleanInput(inputEl.getAttribute('data-answer'));\n                const altAnswer = cleanInput(inputEl.getAttribute('data-alt'));\n\n                // Clear previous state styles\n                inputEl.classList.remove('input-correct', 'input-incorrect');\n\n                if (userAnswer === correctAnswer || (altAnswer && userAnswer === altAnswer)) {\n                    correctCount++;\n                    inputEl.classList.add('input-correct');\n                    fbEl.className = \"text-xs mt-2 font-medium text-emerald-600 flex items-center gap-1\";\n                    fbEl.innerHTML = `\n                        <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                            <path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"></path>\n                        </svg> Correct!\n                    `;\n                } else {\n                    inputEl.classList.add('input-incorrect');\n                    fbEl.className = \"text-xs mt-2 font-medium text-rose-600 flex items-center gap-1\";\n                    fbEl.innerHTML = `\n                        <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                            <path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z\" clip-rule=\"evenodd\"></path>\n                        </svg> Correct answer: <strong class=\"underline\">${inputEl.getAttribute('data-answer')}</strong>\n                    `;\n                }\n                fbEl.classList.remove('hidden');\n            });\n\n            // Update score display\n            const scoreDisplay = document.getElementById('scoreDisplay');\n            const scoreText = document.getElementById('scoreText');\n            scoreText.textContent = `${correctCount} / ${totalCount}`;\n            scoreDisplay.classList.remove('hidden');\n\n            // Send postMessage event for external score tracking\n            if (window.parent) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalCount\n                }, '*');\n            }\n        }\n\n        function resetAnswers() {\n            questionIds.forEach(id => {\n                const inputEl = document.getElementById(id);\n                const fbEl = document.getElementById('fb-' + id);\n                \n                inputEl.value = '';\n                inputEl.classList.remove('input-correct', 'input-incorrect');\n                fbEl.classList.add('hidden');\n                fbEl.innerHTML = '';\n            });\n\n            const scoreDisplay = document.getElementById('scoreDisplay');\n            scoreDisplay.classList.add('hidden');\n        }\n    </script>\n\n</body></html>"
    },
    {
      "id": 1793065957385,
      "title": "Actividad IA #2",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Question Tags Exercise</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom styling for drop-down arrows and smooth focus states */\n    select {\n      background-image: url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%6b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e\");\n      background-position: right 0.75rem center;\n      background-repeat: no-repeat;\n      background-size: 1.5em 1.5em;\n      padding-right: 2.5rem;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen text-slate-800 p-3 sm:p-6 font-sans\">\n  <div class=\"max-w-3xl mx-auto bg-white rounded-2xl shadow-md border border-slate-200 overflow-hidden\">\n    \n    <!-- Header -->\n    <header class=\"bg-indigo-600 text-white p-4 sm:p-6\">\n      <div class=\"flex items-center justify-between flex-wrap gap-2\">\n        <span class=\"bg-indigo-500 text-indigo-100 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full\">\n          Grammar Practice • 1b\n        </span>\n        <div id=\"score-badge\" class=\"hidden bg-indigo-700 text-white text-sm font-bold px-3 py-1 rounded-lg\">\n          Score: <span id=\"score-text\">0 / 7</span>\n        </div>\n      </div>\n      <h1 class=\"text-xl sm:text-2xl font-extrabold mt-2\">Question Tags</h1>\n      <p class=\"text-indigo-100 text-xs sm:text-sm mt-1\">\n        Match each sentence with its correct question tag from the drop-down menu.\n      </p>\n    </header>\n\n    <main class=\"p-4 sm:p-6 space-y-4\">\n      \n      <!-- Example Box -->\n      <div class=\"bg-amber-50 border-2 border-amber-200 rounded-xl p-3.5 sm:p-4 text-amber-900\">\n        <div class=\"flex items-center gap-2 mb-1\">\n          <span class=\"bg-amber-500 text-white text-xs font-bold uppercase px-2 py-0.5 rounded\">Example</span>\n          <span class=\"font-bold text-amber-800\">a)</span>\n        </div>\n        <p class=\"text-base sm:text-lg font-medium\">\n          <span class=\"underline decoration-amber-400 font-semibold\">You aren't coming tomorrow</span>, are you?\n        </p>\n      </div>\n\n      <!-- Exercise Items b to h -->\n      <form id=\"quiz-form\" class=\"space-y-3 sm:space-y-4\">\n\n        <!-- Item b -->\n        <div id=\"card-b\" class=\"p-3.5 sm:p-4 rounded-xl border-2 border-slate-200 bg-white transition-all shadow-sm\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n            <span class=\"font-bold text-slate-600 text-base sm:text-lg shrink-0\">b)</span>\n            <div class=\"grow\">\n              <select id=\"select-b\" data-correct=\"It isn't going to rain\" class=\"w-full min-h-[46px] text-base px-3 py-2.5 border border-slate-300 rounded-lg bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 text-slate-800 appearance-none cursor-pointer font-medium transition-colors\">\n                <option value=\"\">-- Choose matching sentence --</option>\n                <option value=\"Clare doesn't eat beef\">Clare doesn't eat beef</option>\n                <option value=\"He hasn't been here before\">He hasn't been here before</option>\n                <option value=\"I don't need to bring anything to the barbecue\">I don't need to bring anything to the barbecue</option>\n                <option value=\"It isn't going to rain\">It isn't going to rain</option>\n                <option value=\"They haven't got any children\">They haven't got any children</option>\n                <option value=\"We didn't see him yesterday\">We didn't see him yesterday</option>\n                <option value=\"You haven't told him yet\">You haven't told him yet</option>\n              </select>\n            </div>\n            <div class=\"text-slate-900 font-bold text-base sm:text-lg shrink-0 sm:min-w-[70px]\">\n              , is it?\n            </div>\n          </div>\n          <div id=\"feedback-b\" class=\"hidden mt-2 text-xs sm:text-sm font-semibold flex items-center gap-1.5 pl-6\"></div>\n        </div>\n\n        <!-- Item c -->\n        <div id=\"card-c\" class=\"p-3.5 sm:p-4 rounded-xl border-2 border-slate-200 bg-white transition-all shadow-sm\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n            <span class=\"font-bold text-slate-600 text-base sm:text-lg shrink-0\">c)</span>\n            <div class=\"grow\">\n              <select id=\"select-c\" data-correct=\"They haven't got any children\" class=\"w-full min-h-[46px] text-base px-3 py-2.5 border border-slate-300 rounded-lg bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 text-slate-800 appearance-none cursor-pointer font-medium transition-colors\">\n                <option value=\"\">-- Choose matching sentence --</option>\n                <option value=\"Clare doesn't eat beef\">Clare doesn't eat beef</option>\n                <option value=\"He hasn't been here before\">He hasn't been here before</option>\n                <option value=\"I don't need to bring anything to the barbecue\">I don't need to bring anything to the barbecue</option>\n                <option value=\"It isn't going to rain\">It isn't going to rain</option>\n                <option value=\"They haven't got any children\">They haven't got any children</option>\n                <option value=\"We didn't see him yesterday\">We didn't see him yesterday</option>\n                <option value=\"You haven't told him yet\">You haven't told him yet</option>\n              </select>\n            </div>\n            <div class=\"text-slate-900 font-bold text-base sm:text-lg shrink-0 sm:min-w-[100px]\">\n              , have they?\n            </div>\n          </div>\n          <div id=\"feedback-c\" class=\"hidden mt-2 text-xs sm:text-sm font-semibold flex items-center gap-1.5 pl-6\"></div>\n        </div>\n\n        <!-- Item d -->\n        <div id=\"card-d\" class=\"p-3.5 sm:p-4 rounded-xl border-2 border-slate-200 bg-white transition-all shadow-sm\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n            <span class=\"font-bold text-slate-600 text-base sm:text-lg shrink-0\">d)</span>\n            <div class=\"grow\">\n              <select id=\"select-d\" data-correct=\"We didn't see him yesterday\" class=\"w-full min-h-[46px] text-base px-3 py-2.5 border border-slate-300 rounded-lg bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 text-slate-800 appearance-none cursor-pointer font-medium transition-colors\">\n                <option value=\"\">-- Choose matching sentence --</option>\n                <option value=\"Clare doesn't eat beef\">Clare doesn't eat beef</option>\n                <option value=\"He hasn't been here before\">He hasn't been here before</option>\n                <option value=\"I don't need to bring anything to the barbecue\">I don't need to bring anything to the barbecue</option>\n                <option value=\"It isn't going to rain\">It isn't going to rain</option>\n                <option value=\"They haven't got any children\">They haven't got any children</option>\n                <option value=\"We didn't see him yesterday\">We didn't see him yesterday</option>\n                <option value=\"You haven't told him yet\">You haven't told him yet</option>\n              </select>\n            </div>\n            <div class=\"text-slate-900 font-bold text-base sm:text-lg shrink-0 sm:min-w-[80px]\">\n              , did we?\n            </div>\n          </div>\n          <div id=\"feedback-d\" class=\"hidden mt-2 text-xs sm:text-sm font-semibold flex items-center gap-1.5 pl-6\"></div>\n        </div>\n\n        <!-- Item e -->\n        <div id=\"card-e\" class=\"p-3.5 sm:p-4 rounded-xl border-2 border-slate-200 bg-white transition-all shadow-sm\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n            <span class=\"font-bold text-slate-600 text-base sm:text-lg shrink-0\">e)</span>\n            <div class=\"grow\">\n              <select id=\"select-e\" data-correct=\"He hasn't been here before\" class=\"w-full min-h-[46px] text-base px-3 py-2.5 border border-slate-300 rounded-lg bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 text-slate-800 appearance-none cursor-pointer font-medium transition-colors\">\n                <option value=\"\">-- Choose matching sentence --</option>\n                <option value=\"Clare doesn't eat beef\">Clare doesn't eat beef</option>\n                <option value=\"He hasn't been here before\">He hasn't been here before</option>\n                <option value=\"I don't need to bring anything to the barbecue\">I don't need to bring anything to the barbecue</option>\n                <option value=\"It isn't going to rain\">It isn't going to rain</option>\n                <option value=\"They haven't got any children\">They haven't got any children</option>\n                <option value=\"We didn't see him yesterday\">We didn't see him yesterday</option>\n                <option value=\"You haven't told him yet\">You haven't told him yet</option>\n              </select>\n            </div>\n            <div class=\"text-slate-900 font-bold text-base sm:text-lg shrink-0 sm:min-w-[80px]\">\n              , has he?\n            </div>\n          </div>\n          <div id=\"feedback-e\" class=\"hidden mt-2 text-xs sm:text-sm font-semibold flex items-center gap-1.5 pl-6\"></div>\n        </div>\n\n        <!-- Item f -->\n        <div id=\"card-f\" class=\"p-3.5 sm:p-4 rounded-xl border-2 border-slate-200 bg-white transition-all shadow-sm\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n            <span class=\"font-bold text-slate-600 text-base sm:text-lg shrink-0\">f)</span>\n            <div class=\"grow\">\n              <select id=\"select-f\" data-correct=\"You haven't told him yet\" class=\"w-full min-h-[46px] text-base px-3 py-2.5 border border-slate-300 rounded-lg bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 text-slate-800 appearance-none cursor-pointer font-medium transition-colors\">\n                <option value=\"\">-- Choose matching sentence --</option>\n                <option value=\"Clare doesn't eat beef\">Clare doesn't eat beef</option>\n                <option value=\"He hasn't been here before\">He hasn't been here before</option>\n                <option value=\"I don't need to bring anything to the barbecue\">I don't need to bring anything to the barbecue</option>\n                <option value=\"It isn't going to rain\">It isn't going to rain</option>\n                <option value=\"They haven't got any children\">They haven't got any children</option>\n                <option value=\"We didn't see him yesterday\">We didn't see him yesterday</option>\n                <option value=\"You haven't told him yet\">You haven't told him yet</option>\n              </select>\n            </div>\n            <div class=\"text-slate-900 font-bold text-base sm:text-lg shrink-0 sm:min-w-[90px]\">\n              , have you?\n            </div>\n          </div>\n          <div id=\"feedback-f\" class=\"hidden mt-2 text-xs sm:text-sm font-semibold flex items-center gap-1.5 pl-6\"></div>\n        </div>\n\n        <!-- Item g -->\n        <div id=\"card-g\" class=\"p-3.5 sm:p-4 rounded-xl border-2 border-slate-200 bg-white transition-all shadow-sm\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n            <span class=\"font-bold text-slate-600 text-base sm:text-lg shrink-0\">g)</span>\n            <div class=\"grow\">\n              <select id=\"select-g\" data-correct=\"Clare doesn't eat beef\" class=\"w-full min-h-[46px] text-base px-3 py-2.5 border border-slate-300 rounded-lg bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 text-slate-800 appearance-none cursor-pointer font-medium transition-colors\">\n                <option value=\"\">-- Choose matching sentence --</option>\n                <option value=\"Clare doesn't eat beef\">Clare doesn't eat beef</option>\n                <option value=\"He hasn't been here before\">He hasn't been here before</option>\n                <option value=\"I don't need to bring anything to the barbecue\">I don't need to bring anything to the barbecue</option>\n                <option value=\"It isn't going to rain\">It isn't going to rain</option>\n                <option value=\"They haven't got any children\">They haven't got any children</option>\n                <option value=\"We didn't see him yesterday\">We didn't see him yesterday</option>\n                <option value=\"You haven't told him yet\">You haven't told him yet</option>\n              </select>\n            </div>\n            <div class=\"text-slate-900 font-bold text-base sm:text-lg shrink-0 sm:min-w-[95px]\">\n              , does she?\n            </div>\n          </div>\n          <div id=\"feedback-g\" class=\"hidden mt-2 text-xs sm:text-sm font-semibold flex items-center gap-1.5 pl-6\"></div>\n        </div>\n\n        <!-- Item h -->\n        <div id=\"card-h\" class=\"p-3.5 sm:p-4 rounded-xl border-2 border-slate-200 bg-white transition-all shadow-sm\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n            <span class=\"font-bold text-slate-600 text-base sm:text-lg shrink-0\">h)</span>\n            <div class=\"grow\">\n              <select id=\"select-h\" data-correct=\"I don't need to bring anything to the barbecue\" class=\"w-full min-h-[46px] text-base px-3 py-2.5 border border-slate-300 rounded-lg bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 text-slate-800 appearance-none cursor-pointer font-medium transition-colors\">\n                <option value=\"\">-- Choose matching sentence --</option>\n                <option value=\"Clare doesn't eat beef\">Clare doesn't eat beef</option>\n                <option value=\"He hasn't been here before\">He hasn't been here before</option>\n                <option value=\"I don't need to bring anything to the barbecue\">I don't need to bring anything to the barbecue</option>\n                <option value=\"It isn't going to rain\">It isn't going to rain</option>\n                <option value=\"They haven't got any children\">They haven't got any children</option>\n                <option value=\"We didn't see him yesterday\">We didn't see him yesterday</option>\n                <option value=\"You haven't told him yet\">You haven't told him yet</option>\n              </select>\n            </div>\n            <div class=\"text-slate-900 font-bold text-base sm:text-lg shrink-0 sm:min-w-[65px]\">\n              , do I?\n            </div>\n          </div>\n          <div id=\"feedback-h\" class=\"hidden mt-2 text-xs sm:text-sm font-semibold flex items-center gap-1.5 pl-6\"></div>\n        </div>\n\n      </form>\n\n      <!-- Action Buttons -->\n      <div class=\"pt-4 flex flex-col sm:flex-row gap-3\">\n        <button type=\"button\" onclick=\"checkAnswers()\" class=\"w-full sm:w-auto flex-1 min-h-[48px] bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base py-3 px-6 rounded-xl transition-colors shadow-sm active:scale-[0.99] flex items-center justify-center gap-2\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M5 13l4 4L19 7\"/></svg>\n          Check Answers\n        </button>\n        <button type=\"button\" onclick=\"resetQuiz()\" class=\"w-full sm:w-auto min-h-[48px] bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-base py-3 px-6 rounded-xl transition-colors active:scale-[0.99] flex items-center justify-center gap-2\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\n          Reset\n        </button>\n      </div>\n\n    </main>\n  </div>\n\n  <script>\n    const itemKeys = ['b', 'c', 'd', 'e', 'f', 'g', 'h'];\n\n    function checkAnswers() {\n      let correctCount = 0;\n      const totalCount = itemKeys.length;\n\n      itemKeys.forEach(key => {\n        const selectEl = document.getElementById(`select-${key}`);\n        const cardEl = document.getElementById(`card-${key}`);\n        const feedbackEl = document.getElementById(`feedback-${key}`);\n        \n        const userValue = selectEl.value;\n        const correctValue = selectEl.getAttribute('data-correct');\n\n        // Reset classes\n        cardEl.classList.remove('border-slate-200', 'border-emerald-500', 'border-red-500', 'bg-emerald-50/40', 'bg-red-50/40');\n        selectEl.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900');\n        feedbackEl.classList.add('hidden');\n        feedbackEl.innerHTML = '';\n\n        if (userValue === correctValue) {\n          correctCount++;\n          cardEl.classList.add('border-emerald-500', 'bg-emerald-50/40');\n          selectEl.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n          \n          feedbackEl.innerHTML = `<span class=\"text-emerald-600 flex items-center gap-1\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M5 13l4 4L19 7\"/></svg>\n            Correct!\n          </span>`;\n          feedbackEl.classList.remove('hidden');\n        } else {\n          cardEl.classList.add('border-red-500', 'bg-red-50/40');\n          selectEl.classList.add('border-red-500', 'bg-red-50', 'text-red-900');\n          \n          if (!userValue) {\n            feedbackEl.innerHTML = `<span class=\"text-red-600 flex items-center gap-1\">\n              <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/></svg>\n              Please select an option.\n            </span>`;\n          } else {\n            feedbackEl.innerHTML = `<span class=\"text-red-600 flex items-center gap-1\">\n              <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/></svg>\n              Incorrect\n            </span>`;\n          }\n          feedbackEl.classList.remove('hidden');\n        }\n      });\n\n      // Update score display\n      const scoreBadge = document.getElementById('score-badge');\n      const scoreText = document.getElementById('score-text');\n      scoreText.textContent = `${correctCount} / ${totalCount}`;\n      scoreBadge.classList.remove('hidden');\n\n      // Post score event to parent frame\n      window.parent.postMessage({\n        type: 'ACTIVITY_SCORE',\n        score: correctCount,\n        total: totalCount\n      }, '*');\n    }\n\n    function resetQuiz() {\n      itemKeys.forEach(key => {\n        const selectEl = document.getElementById(`select-${key}`);\n        const cardEl = document.getElementById(`card-${key}`);\n        const feedbackEl = document.getElementById(`feedback-${key}`);\n\n        selectEl.value = '';\n        cardEl.className = 'p-3.5 sm:p-4 rounded-xl border-2 border-slate-200 bg-white transition-all shadow-sm';\n        selectEl.className = 'w-full min-h-[46px] text-base px-3 py-2.5 border border-slate-300 rounded-lg bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 text-slate-800 appearance-none cursor-pointer font-medium transition-colors';\n        feedbackEl.classList.add('hidden');\n        feedbackEl.innerHTML = '';\n      });\n\n      const scoreBadge = document.getElementById('score-badge');\n      scoreBadge.classList.add('hidden');\n    }\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793066081247,
      "title": "Actividad IA #4",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Question Tags Exercise</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .input-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .input-incorrect {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-100 text-slate-800 font-sans min-h-screen p-3 sm:p-6 flex flex-col justify-between\">\n    <div class=\"max-w-2xl mx-auto w-full bg-white rounded-2xl shadow-md p-4 sm:p-8 mb-6\">\n        <!-- Header Section -->\n        <header class=\"border-b border-slate-200 pb-4 mb-6\">\n            <div class=\"flex items-center gap-3 mb-2\">\n                <span class=\"w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-lg\">2</span>\n                <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900\">Question Tags</h1>\n            </div>\n            <p class=\"text-slate-600 text-sm sm:text-base\">Complete the sentences by writing the correct question tags.</p>\n        </header>\n\n        <!-- Example Card -->\n        <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-3 sm:p-4 mb-6 text-amber-900 text-sm sm:text-base\">\n            <span class=\"inline-block px-2 py-0.5 text-xs font-semibold bg-amber-200 text-amber-800 rounded uppercase tracking-wider mb-1\">Example</span>\n            <p class=\"font-medium mt-1\">1. You eat fish, <span class=\"underline font-bold text-indigo-700\">don't you</span>?</p>\n        </div>\n\n        <!-- Exercise Form -->\n        <form id=\"tag-exercise-form\" onsubmit=\"event.preventDefault();\" class=\"space-y-4\">\n            \n            <!-- Item 2 -->\n            <div class=\"p-3 sm:p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors\">\n                <label for=\"q2\" class=\"block text-base sm:text-lg font-medium text-slate-800 mb-2\">\n                    2. You're vegetarian,\n                </label>\n                <div class=\"flex items-center gap-2\">\n                    <input type=\"text\" id=\"q2\" data-answer=\"aren't you\" autocomplete=\"off\" spellcheck=\"false\" \n                           placeholder=\"type question tag...\" \n                           class=\"w-full max-w-xs h-11 px-3 text-base rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all\">\n                    <span class=\"text-lg font-bold text-slate-700\">?</span>\n                </div>\n                <div id=\"feedback-q2\" class=\"hidden mt-2 text-sm font-semibold\"></div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"p-3 sm:p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors\">\n                <label for=\"q3\" class=\"block text-base sm:text-lg font-medium text-slate-800 mb-2\">\n                    3. Children love barbecues,\n                </label>\n                <div class=\"flex items-center gap-2\">\n                    <input type=\"text\" id=\"q3\" data-answer=\"don't they\" autocomplete=\"off\" spellcheck=\"false\" \n                           placeholder=\"type question tag...\" \n                           class=\"w-full max-w-xs h-11 px-3 text-base rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all\">\n                    <span class=\"text-lg font-bold text-slate-700\">?</span>\n                </div>\n                <div id=\"feedback-q3\" class=\"hidden mt-2 text-sm font-semibold\"></div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"p-3 sm:p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors\">\n                <label for=\"q4\" class=\"block text-base sm:text-lg font-medium text-slate-800 mb-2\">\n                    4. They came round for dinner once,\n                </label>\n                <div class=\"flex items-center gap-2\">\n                    <input type=\"text\" id=\"q4\" data-answer=\"didn't they\" autocomplete=\"off\" spellcheck=\"false\" \n                           placeholder=\"type question tag...\" \n                           class=\"w-full max-w-xs h-11 px-3 text-base rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all\">\n                    <span class=\"text-lg font-bold text-slate-700\">?</span>\n                </div>\n                <div id=\"feedback-q4\" class=\"hidden mt-2 text-sm font-semibold\"></div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"p-3 sm:p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors\">\n                <label for=\"q5\" class=\"block text-base sm:text-lg font-medium text-slate-800 mb-2\">\n                    5. He's being very sociable,\n                </label>\n                <div class=\"flex items-center gap-2\">\n                    <input type=\"text\" id=\"q5\" data-answer=\"isn't he\" autocomplete=\"off\" spellcheck=\"false\" \n                           placeholder=\"type question tag...\" \n                           class=\"w-full max-w-xs h-11 px-3 text-base rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all\">\n                    <span class=\"text-lg font-bold text-slate-700\">?</span>\n                </div>\n                <div id=\"feedback-q5\" class=\"hidden mt-2 text-sm font-semibold\"></div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"p-3 sm:p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors\">\n                <label for=\"q6\" class=\"block text-base sm:text-lg font-medium text-slate-800 mb-2\">\n                    6. Their garden is looking very nice,\n                </label>\n                <div class=\"flex items-center gap-2\">\n                    <input type=\"text\" id=\"q6\" data-answer=\"isn't it\" autocomplete=\"off\" spellcheck=\"false\" \n                           placeholder=\"type question tag...\" \n                           class=\"w-full max-w-xs h-11 px-3 text-base rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all\">\n                    <span class=\"text-lg font-bold text-slate-700\">?</span>\n                </div>\n                <div id=\"feedback-q6\" class=\"hidden mt-2 text-sm font-semibold\"></div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"p-3 sm:p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors\">\n                <label for=\"q7\" class=\"block text-base sm:text-lg font-medium text-slate-800 mb-2\">\n                    7. I've cooked too much food,\n                </label>\n                <div class=\"flex items-center gap-2\">\n                    <input type=\"text\" id=\"q7\" data-answer=\"haven't I\" autocomplete=\"off\" spellcheck=\"false\" \n                           placeholder=\"type question tag...\" \n                           class=\"w-full max-w-xs h-11 px-3 text-base rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all\">\n                    <span class=\"text-lg font-bold text-slate-700\">?</span>\n                </div>\n                <div id=\"feedback-q7\" class=\"hidden mt-2 text-sm font-semibold\"></div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"p-3 sm:p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors\">\n                <label for=\"q8\" class=\"block text-base sm:text-lg font-medium text-slate-800 mb-2\">\n                    8. We've got a barbecue like yours,\n                </label>\n                <div class=\"flex items-center gap-2\">\n                    <input type=\"text\" id=\"q8\" data-answer=\"haven't we\" autocomplete=\"off\" spellcheck=\"false\" \n                           placeholder=\"type question tag...\" \n                           class=\"w-full max-w-xs h-11 px-3 text-base rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all\">\n                    <span class=\"text-lg font-bold text-slate-700\">?</span>\n                </div>\n                <div id=\"feedback-q8\" class=\"hidden mt-2 text-sm font-semibold\"></div>\n            </div>\n\n            <!-- Score Banner -->\n            <div id=\"score-banner\" class=\"hidden p-4 rounded-xl bg-slate-100 text-center border border-slate-200 mt-6\">\n                <p class=\"text-sm uppercase tracking-wider text-slate-500 font-bold mb-1\">Your Result</p>\n                <p id=\"score-text\" class=\"text-2xl font-extrabold text-slate-800\"></p>\n            </div>\n\n            <!-- Actions Bar -->\n            <div class=\"flex flex-col sm:flex-row gap-3 pt-4\">\n                <button type=\"button\" onclick=\"checkAnswers()\" \n                        class=\"h-12 px-6 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold text-base transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 flex-1 flex items-center justify-center\">\n                    Check Answers\n                </button>\n                <button type=\"button\" onclick=\"resetForm()\" \n                        class=\"h-12 px-6 rounded-xl bg-slate-200 hover:bg-slate-300 active:bg-slate-400 text-slate-700 font-semibold text-base transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 flex items-center justify-center\">\n                    Reset\n                </button>\n            </div>\n        </form>\n    </div>\n\n    <script>\n        function normalizeText(text) {\n            return text\n                .trim()\n                .toLowerCase()\n                .replace(/[’']/g, \"'\")\n                .replace(/\\?$/, '')\n                .replace(/\\s+/g, ' ');\n        }\n\n        function checkAnswers() {\n            const inputs = document.querySelectorAll('input[id^=\"q\"]');\n            let correctCount = 0;\n            const totalCount = inputs.length;\n\n            inputs.forEach(input => {\n                const userAnswer = normalizeText(input.value);\n                const expectedAnswer = normalizeText(input.dataset.answer);\n                const feedbackDiv = document.getElementById('feedback-' + input.id);\n\n                // Clear styling classes\n                input.classList.remove('input-correct', 'input-incorrect');\n                feedbackDiv.classList.remove('text-emerald-700', 'text-rose-600', 'hidden');\n\n                if (userAnswer === expectedAnswer) {\n                    correctCount++;\n                    input.classList.add('input-correct');\n                    feedbackDiv.textContent = '✓ Correct!';\n                    feedbackDiv.classList.add('text-emerald-700');\n                } else {\n                    input.classList.add('input-incorrect');\n                    feedbackDiv.textContent = `✗ Correct answer: ${input.dataset.answer}`;\n                    feedbackDiv.classList.add('text-rose-600');\n                }\n            });\n\n            // Display Score\n            const scoreBanner = document.getElementById('score-banner');\n            const scoreText = document.getElementById('score-text');\n            scoreBanner.classList.remove('hidden');\n            scoreText.textContent = `${correctCount} / ${totalCount}`;\n\n            // Emit Score Event\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        }\n\n        function resetForm() {\n            const inputs = document.querySelectorAll('input[id^=\"q\"]');\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('input-correct', 'input-incorrect');\n                const feedbackDiv = document.getElementById('feedback-' + input.id);\n                feedbackDiv.classList.add('hidden');\n                feedbackDiv.textContent = '';\n            });\n\n            const scoreBanner = document.getElementById('score-banner');\n            scoreBanner.classList.add('hidden');\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793066412010,
      "title": "Actividad IA #4",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Question Tags Exercise</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* iOS input zoom prevention & smooth styling */\n    input[type=\"text\"] {\n      font-size: 16px !important;\n    }\n    .custom-shadow {\n      box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.08);\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen pb-12 font-sans antialiased\">\n\n  <!-- Header / Container -->\n  <div class=\"max-w-2xl mx-auto px-3 py-4 md:px-6 md:py-8\">\n    \n    <!-- Exercise Header Card -->\n    <header class=\"bg-white rounded-2xl p-4 md:p-6 mb-6 custom-shadow border border-slate-100\">\n      <div class=\"flex items-center gap-3 mb-2\">\n        <span class=\"flex items-center justify-center bg-indigo-600 text-white font-bold w-8 h-8 rounded-full text-sm\">\n          3\n        </span>\n        <h1 class=\"text-lg md:text-xl font-bold text-slate-900\">\n          Question Tags Practice\n        </h1>\n      </div>\n      \n      <p class=\"text-sm md:text-base text-slate-600 leading-relaxed mb-4\">\n        Change these questions into positive <strong class=\"text-emerald-600 font-bold\">(+)</strong> or negative <strong class=\"text-rose-600 font-bold\">(&minus;)</strong> statements with question tags.\n      </p>\n\n      <!-- Examples Accordion/Box -->\n      <div class=\"bg-indigo-50/70 rounded-xl p-3 md:p-4 border border-indigo-100 text-xs md:text-sm\">\n        <span class=\"font-semibold text-indigo-900 block mb-2 uppercase tracking-wide\">Examples:</span>\n        <div class=\"space-y-1.5 text-indigo-950\">\n          <div class=\"flex flex-wrap items-center gap-x-2\">\n            <span class=\"font-medium text-slate-600\">1. Is she a teacher? <strong class=\"text-emerald-600 font-bold\">(+)</strong></span>\n            <span class=\"text-indigo-700 font-semibold\">&rarr; She's a teacher, isn't she?</span>\n          </div>\n          <div class=\"flex flex-wrap items-center gap-x-2\">\n            <span class=\"font-medium text-slate-600\">2. Are they married? <strong class=\"text-rose-600 font-bold\">(&minus;)</strong></span>\n            <span class=\"text-indigo-700 font-semibold\">&rarr; They aren't married, are they?</span>\n          </div>\n        </div>\n      </div>\n    </header>\n\n    <!-- Score Bar -->\n    <div id=\"scoreBar\" class=\"bg-white rounded-xl p-3 mb-4 custom-shadow border border-slate-100 flex items-center justify-between transition-all\">\n      <span class=\"text-sm font-medium text-slate-600\">Your Progress:</span>\n      <div id=\"scoreDisplay\" class=\"text-sm font-bold text-slate-700 bg-slate-100 px-3 py-1 rounded-full\">\n        0 / 10 completed\n      </div>\n    </div>\n\n    <!-- Questions Form -->\n    <form id=\"exerciseForm\" onsubmit=\"return false;\" class=\"space-y-4\">\n      \n      <!-- Question 3 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"3\">\n        <label for=\"q3\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          3. Are we going home soon? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800\">(+)</span>\n        </label>\n        <input type=\"text\" id=\"q3\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 4 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"4\">\n        <label for=\"q4\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          4. Have you met our neighbours? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-rose-100 text-rose-800\">(&minus;)</span>\n        </label>\n        <input type=\"text\" id=\"q4\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 5 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"5\">\n        <label for=\"q5\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          5. Did you drive here? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-rose-100 text-rose-800\">(&minus;)</span>\n        </label>\n        <input type=\"text\" id=\"q5\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 6 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"6\">\n        <label for=\"q6\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          6. Is it warm outside? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800\">(+)</span>\n        </label>\n        <input type=\"text\" id=\"q6\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 7 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"7\">\n        <label for=\"q7\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          7. Does he want something to eat? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800\">(+)</span>\n        </label>\n        <input type=\"text\" id=\"q7\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 8 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"8\">\n        <label for=\"q8\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          8. Do you know Sam? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-rose-100 text-rose-800\">(&minus;)</span>\n        </label>\n        <input type=\"text\" id=\"q8\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 9 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"9\">\n        <label for=\"q9\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          9. Has he got the address? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800\">(+)</span>\n        </label>\n        <input type=\"text\" id=\"q9\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 10 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"10\">\n        <label for=\"q10\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          10. Have you ever tried English sausages? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800\">(+)</span>\n        </label>\n        <input type=\"text\" id=\"q10\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 11 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"11\">\n        <label for=\"q11\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          11. Is he working this weekend? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-rose-100 text-rose-800\">(&minus;)</span>\n        </label>\n        <input type=\"text\" id=\"q11\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Question 12 -->\n      <div class=\"q-card bg-white rounded-xl p-4 custom-shadow border border-slate-100 transition-all\" data-id=\"12\">\n        <label for=\"q12\" class=\"block text-sm md:text-base font-semibold text-slate-800 mb-2\">\n          12. Am I late? <span class=\"inline-block px-2 py-0.5 rounded text-xs font-bold bg-rose-100 text-rose-800\">(&minus;)</span>\n        </label>\n        <input type=\"text\" id=\"q12\" autocomplete=\"off\" placeholder=\"Write full statement with tag...\" \n          class=\"w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 transition-colors\">\n        <div class=\"feedback-box hidden mt-2.5 text-sm font-medium rounded-lg p-2.5\"></div>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"pt-4 flex flex-col sm:flex-row gap-3\">\n        <button type=\"button\" onclick=\"checkAnswers()\" \n          class=\"w-full sm:w-1/2 min-h-[48px] py-3 px-6 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 text-base\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n          </svg>\n          Check Answers\n        </button>\n        \n        <button type=\"button\" onclick=\"resetForm()\" \n          class=\"w-full sm:w-1/2 min-h-[48px] py-3 px-6 bg-slate-500 hover:bg-slate-600 active:bg-slate-700 text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 text-base\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path>\n          </svg>\n          Reset\n        </button>\n      </div>\n\n    </form>\n  </div>\n\n  <script>\n    // Strict Answer Key & Acceptable Variations derived from textbook answer key\n    const answersData = {\n      3: {\n        primary: \"We're going home soon, aren't we?\",\n        valid: [\n          \"we're going home soon, aren't we\",\n          \"we are going home soon, aren't we\"\n        ]\n      },\n      4: {\n        primary: \"You haven't met our neighbours, have you?\",\n        valid: [\n          \"you haven't met our neighbours, have you\",\n          \"you have not met our neighbours, have you\",\n          \"you haven't met our neighbors, have you\",\n          \"you have not met our neighbors, have you\"\n        ]\n      },\n      5: {\n        primary: \"You didn't drive here, did you?\",\n        valid: [\n          \"you didn't drive here, did you\",\n          \"you did not drive here, did you\"\n        ]\n      },\n      6: {\n        primary: \"It's warm outside, isn't it?\",\n        valid: [\n          \"it's warm outside, isn't it\",\n          \"it is warm outside, isn't it\"\n        ]\n      },\n      7: {\n        primary: \"He wants something to eat, doesn't he?\",\n        valid: [\n          \"he wants something to eat, doesn't he\"\n        ]\n      },\n      8: {\n        primary: \"You don't know Sam, do you?\",\n        valid: [\n          \"you don't know sam, do you\",\n          \"you do not know sam, do you\"\n        ]\n      },\n      9: {\n        primary: \"He's got the address, hasn't he?\",\n        valid: [\n          \"he's got the address, hasn't he\",\n          \"he has got the address, hasn't he\"\n        ]\n      },\n      10: {\n        primary: \"You've tried English sausages, haven't you?\",\n        valid: [\n          \"you've tried english sausages, haven't you\",\n          \"you have tried english sausages, haven't you\"\n        ]\n      },\n      11: {\n        primary: \"He isn't working this weekend, is he?\",\n        valid: [\n          \"he isn't working this weekend, is he\",\n          \"he is not working this weekend, is he\"\n        ]\n      },\n      12: {\n        primary: \"I'm not late, am I?\",\n        valid: [\n          \"i'm not late, am i\",\n          \"i am not late, am i\"\n        ]\n      }\n    };\n\n    // Normalize helper function\n    function normalizeText(text) {\n      if (!text) return \"\";\n      return text\n        .trim()\n        .toLowerCase()\n        .replace(/[’']/g, \"'\") // Standardize apostrophes\n        .replace(/[?.,!]/g, '') // Ignore trailing punctuation differences\n        .replace(/\\s+/g, ' '); // Collapse multiple spaces\n    }\n\n    function checkAnswers() {\n      let correctCount = 0;\n      const totalCount = Object.keys(answersData).length;\n\n      for (let id in answersData) {\n        const inputEl = document.getElementById(`q${id}`);\n        const cardEl = inputEl.closest('.q-card');\n        const feedbackEl = cardEl.querySelector('.feedback-box');\n        \n        const userVal = normalizeText(inputEl.value);\n        const itemData = answersData[id];\n\n        const isCorrect = itemData.valid.some(val => normalizeText(val) === userVal);\n\n        feedbackEl.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200', 'bg-rose-50', 'text-rose-900', 'border-rose-200', 'border');\n        inputEl.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50/20', 'bg-rose-50/20');\n\n        if (isCorrect) {\n          correctCount++;\n          inputEl.classList.add('border-emerald-500', 'bg-emerald-50/20');\n          feedbackEl.classList.add('bg-emerald-50', 'text-emerald-900', 'border', 'border-emerald-200');\n          feedbackEl.innerHTML = `<span class=\"flex items-center gap-1.5 font-bold text-emerald-700\">\n            <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"></path></svg>\n            Correct!\n          </span>`;\n        } else {\n          inputEl.classList.add('border-rose-500', 'bg-rose-50/20');\n          feedbackEl.classList.add('bg-rose-50', 'text-rose-900', 'border', 'border-rose-200');\n          feedbackEl.innerHTML = `<div class=\"space-y-1\">\n            <span class=\"flex items-center gap-1.5 font-bold text-rose-700\">\n              <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z\" clip-rule=\"evenodd\"></path></svg>\n              Incorrect\n            </span>\n            <div class=\"text-xs md:text-sm text-slate-700\">Answer: <strong class=\"text-slate-900 font-semibold\">${itemData.primary}</strong></div>\n          </div>`;\n        }\n      }\n\n      // Update score display\n      const scoreDisplay = document.getElementById('scoreDisplay');\n      scoreDisplay.textContent = `Score: ${correctCount} / ${totalCount}`;\n      \n      if (correctCount === totalCount) {\n        scoreDisplay.className = 'text-sm font-bold text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full';\n      } else {\n        scoreDisplay.className = 'text-sm font-bold text-indigo-800 bg-indigo-100 px-3 py-1 rounded-full';\n      }\n\n      // Emit event for LMS / parent frame\n      window.parent.postMessage({\n        type: 'ACTIVITY_SCORE',\n        score: correctCount,\n        total: totalCount\n      }, '*');\n    }\n\n    function resetForm() {\n      for (let id in answersData) {\n        const inputEl = document.getElementById(`q${id}`);\n        const cardEl = inputEl.closest('.q-card');\n        const feedbackEl = cardEl.querySelector('.feedback-box');\n\n        inputEl.value = '';\n        inputEl.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50/20', 'bg-rose-50/20');\n        \n        feedbackEl.classList.add('hidden');\n        feedbackEl.innerHTML = '';\n      }\n\n      const scoreDisplay = document.getElementById('scoreDisplay');\n      scoreDisplay.textContent = '0 / 10 completed';\n      scoreDisplay.className = 'text-sm font-bold text-slate-700 bg-slate-100 px-3 py-1 rounded-full';\n    }\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793066580812,
      "title": "Actividad IA #5",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Review: Common Mistakes</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .strikethrough-red {\n      text-decoration: line-through;\n      text-decoration-color: #dc2626;\n      text-decoration-thickness: 2px;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans min-h-screen antialiased p-3 sm:p-5 md:p-8\">\n\n  <div class=\"max-w-3xl mx-auto w-full space-y-4 sm:space-y-6\">\n\n    <!-- Header Card -->\n    <header class=\"bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm\">\n      <div class=\"flex items-center gap-2 mb-2\">\n        <span class=\"bg-amber-100 text-amber-800 text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wide\">\n          Grammar Review\n        </span>\n        <span class=\"text-xs text-slate-500 font-medium\">Common Mistakes</span>\n      </div>\n      <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2\">\n        <span class=\"bg-amber-600 text-white rounded-full w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center text-sm sm:text-base font-extrabold flex-shrink-0\">4</span>\n        Correct the mistake in each sentence.\n      </h1>\n      <p class=\"text-sm text-slate-600 mt-2\">\n        Identify the highlighted mistake in each sentence and type the correct word or phrase.\n      </p>\n    </header>\n\n    <!-- Example Card (Item 1) -->\n    <div class=\"bg-amber-50/60 rounded-xl p-4 sm:p-5 border border-amber-200/80 shadow-sm\">\n      <div class=\"flex items-start gap-3\">\n        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-amber-200 text-amber-900 font-bold text-sm flex items-center justify-center mt-0.5\">1</span>\n        <div class=\"flex-1 space-y-2\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"text-xs font-bold uppercase tracking-wider text-amber-800 bg-amber-200/60 px-2 py-0.5 rounded\">Example</span>\n          </div>\n          <p class=\"text-base sm:text-lg text-slate-800 leading-relaxed\">\n            I'm really <span class=\"strikethrough-red text-red-600 font-medium px-1\">interesting</span> in gardening.\n          </p>\n          <div class=\"flex items-center gap-2 text-sm text-emerald-800 font-semibold bg-emerald-50 border border-emerald-200 rounded-lg p-2.5 w-full sm:w-fit\">\n            <svg class=\"w-5 h-5 text-emerald-600 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/>\n            </svg>\n            <span>Correction: <span class=\"underline decoration-2 text-emerald-700\">interested</span></span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Interactive Questions Container -->\n    <div class=\"space-y-4\" id=\"questions-container\">\n\n      <!-- Item 2 -->\n      <div class=\"question-card bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-all\" data-id=\"2\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm flex items-center justify-center mt-0.5\">2</span>\n          <div class=\"flex-1 space-y-3\">\n            <p class=\"text-base sm:text-lg text-slate-800 leading-relaxed font-medium\">\n              Everyone <span class=\"strikethrough-red text-red-600 font-semibold px-0.5\">want</span> to go clubbing tonight.\n            </p>\n            <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n              <label for=\"q2\" class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Your Correction:</label>\n              <input type=\"text\" id=\"q2\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"none\" spellcheck=\"false\"\n                class=\"w-full sm:w-72 px-3.5 py-2.5 text-base border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400\" \n                placeholder=\"Type correct word...\" />\n            </div>\n            <div class=\"feedback hidden text-sm font-medium rounded-lg p-3\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"question-card bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-all\" data-id=\"3\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm flex items-center justify-center mt-0.5\">3</span>\n          <div class=\"flex-1 space-y-3\">\n            <p class=\"text-base sm:text-lg text-slate-800 leading-relaxed font-medium\">\n              <span class=\"strikethrough-red text-red-600 font-semibold px-0.5\">Their</span> going to have a lie-in tomorrow.\n            </p>\n            <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n              <label for=\"q3\" class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Your Correction:</label>\n              <input type=\"text\" id=\"q3\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"none\" spellcheck=\"false\"\n                class=\"w-full sm:w-72 px-3.5 py-2.5 text-base border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400\" \n                placeholder=\"Type correct word...\" />\n            </div>\n            <div class=\"feedback hidden text-sm font-medium rounded-lg p-3\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 4 -->\n      <div class=\"question-card bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-all\" data-id=\"4\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm flex items-center justify-center mt-0.5\">4</span>\n          <div class=\"flex-1 space-y-3\">\n            <p class=\"text-base sm:text-lg text-slate-800 leading-relaxed font-medium\">\n              I often <span class=\"strikethrough-red text-red-600 font-semibold px-0.5\">loose</span> against my brother when we play tennis.\n            </p>\n            <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n              <label for=\"q4\" class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Your Correction:</label>\n              <input type=\"text\" id=\"q4\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"none\" spellcheck=\"false\"\n                class=\"w-full sm:w-72 px-3.5 py-2.5 text-base border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400\" \n                placeholder=\"Type correct word...\" />\n            </div>\n            <div class=\"feedback hidden text-sm font-medium rounded-lg p-3\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 5 -->\n      <div class=\"question-card bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-all\" data-id=\"5\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm flex items-center justify-center mt-0.5\">5</span>\n          <div class=\"flex-1 space-y-3\">\n            <p class=\"text-base sm:text-lg text-slate-800 leading-relaxed font-medium\">\n              He's worked here <span class=\"strikethrough-red text-red-600 font-semibold px-0.5\">for</span> the year before last.\n            </p>\n            <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n              <label for=\"q5\" class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Your Correction:</label>\n              <input type=\"text\" id=\"q5\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"none\" spellcheck=\"false\"\n                class=\"w-full sm:w-72 px-3.5 py-2.5 text-base border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400\" \n                placeholder=\"Type correct word...\" />\n            </div>\n            <div class=\"feedback hidden text-sm font-medium rounded-lg p-3\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 6 -->\n      <div class=\"question-card bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-all\" data-id=\"6\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm flex items-center justify-center mt-0.5\">6</span>\n          <div class=\"flex-1 space-y-3\">\n            <p class=\"text-base sm:text-lg text-slate-800 leading-relaxed font-medium\">\n              I've <span class=\"strikethrough-red text-red-600 font-semibold px-0.5\">gone</span> to France and I thought it was beautiful.\n            </p>\n            <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n              <label for=\"q6\" class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Your Correction:</label>\n              <input type=\"text\" id=\"q6\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"none\" spellcheck=\"false\"\n                class=\"w-full sm:w-72 px-3.5 py-2.5 text-base border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400\" \n                placeholder=\"Type correct word...\" />\n            </div>\n            <div class=\"feedback hidden text-sm font-medium rounded-lg p-3\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 7 -->\n      <div class=\"question-card bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-all\" data-id=\"7\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm flex items-center justify-center mt-0.5\">7</span>\n          <div class=\"flex-1 space-y-3\">\n            <p class=\"text-base sm:text-lg text-slate-800 leading-relaxed font-medium\">\n              I can't bear Paul and <span class=\"strikethrough-red text-red-600 font-semibold px-0.5\">Sallys'</span> dog.\n            </p>\n            <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n              <label for=\"q7\" class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Your Correction:</label>\n              <input type=\"text\" id=\"q7\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"none\" spellcheck=\"false\"\n                class=\"w-full sm:w-72 px-3.5 py-2.5 text-base border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400\" \n                placeholder=\"Type correct word...\" />\n            </div>\n            <div class=\"feedback hidden text-sm font-medium rounded-lg p-3\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 8 -->\n      <div class=\"question-card bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-sm transition-all\" data-id=\"8\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm flex items-center justify-center mt-0.5\">8</span>\n          <div class=\"flex-1 space-y-3\">\n            <p class=\"text-base sm:text-lg text-slate-800 leading-relaxed font-medium\">\n              Nobody <span class=\"strikethrough-red text-red-600 font-semibold px-0.5\">doesn't want</span> to come.\n            </p>\n            <div class=\"flex flex-col sm:flex-row sm:items-center gap-2\">\n              <label for=\"q8\" class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Your Correction:</label>\n              <input type=\"text\" id=\"q8\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"none\" spellcheck=\"false\"\n                class=\"w-full sm:w-72 px-3.5 py-2.5 text-base border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400\" \n                placeholder=\"Type correct word...\" />\n            </div>\n            <div class=\"feedback hidden text-sm font-medium rounded-lg p-3\"></div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Action Controls & Score Display -->\n    <div class=\"bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-4\">\n      <div id=\"score-banner\" class=\"hidden rounded-xl p-4 bg-slate-100 text-center transition-all\">\n        <span id=\"score-text\" class=\"text-lg font-bold text-slate-800\">Score: 0 / 7</span>\n        <p id=\"score-subtext\" class=\"text-sm text-slate-600 mt-0.5\"></p>\n      </div>\n\n      <div class=\"flex flex-col sm:flex-row gap-3\">\n        <button id=\"btn-check\" onclick=\"checkAnswers()\" \n          class=\"flex-1 min-h-[44px] py-3 px-5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-base rounded-xl transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 flex items-center justify-center gap-2\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/>\n          </svg>\n          Check Answers\n        </button>\n        <button id=\"btn-reset\" onclick=\"resetQuiz()\" \n          class=\"min-h-[44px] py-3 px-5 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-700 font-bold text-base rounded-xl transition-all focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 flex items-center justify-center gap-2\">\n          <svg class=\"w-5 h-5 text-slate-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/>\n          </svg>\n          Reset\n        </button>\n      </div>\n    </div>\n\n  </div>\n\n  <script>\n    const answerKey = {\n      2: {\n        answers: [\"wants\"],\n        explanation: \"Use singular verb 'wants' with 'everyone'.\"\n      },\n      3: {\n        answers: [\"they're\", \"they are\"],\n        explanation: \"'They're' is the contraction for 'They are'. 'Their' is possessive.\"\n      },\n      4: {\n        answers: [\"lose\"],\n        explanation: \"'Lose' is a verb. 'Loose' is an adjective meaning not tight.\"\n      },\n      5: {\n        answers: [\"since\"],\n        explanation: \"Use 'since' with a specific point in time ('the year before last').\"\n      },\n      6: {\n        answers: [\"been\"],\n        explanation: \"Use 'been' when someone visited a place and returned. 'Gone' means they are still there.\"\n      },\n      7: {\n        answers: [\"sally's\", \"sally’s\"],\n        explanation: \"Joint possession for Paul and Sally uses 'Sally's'.\"\n      },\n      8: {\n        answers: [\"wants\"],\n        explanation: \"Avoid double negatives ('nobody doesn't'). Correct form: 'Nobody wants to come'.\"\n      }\n    };\n\n    function normalizeString(str) {\n      return str.trim().toLowerCase().replace(/’/g, \"'\");\n    }\n\n    function checkAnswers() {\n      let correctCount = 0;\n      const totalCount = Object.keys(answerKey).length;\n\n      for (const [id, config] of Object.entries(answerKey)) {\n        const inputEl = document.getElementById(`q${id}`);\n        const cardEl = inputEl.closest('.question-card');\n        const feedbackEl = cardEl.querySelector('.feedback');\n        \n        const userVal = normalizeString(inputEl.value);\n        const isCorrect = config.answers.some(ans => normalizeString(ans) === userVal);\n\n        feedbackEl.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200', 'bg-red-50', 'text-red-900', 'border-red-200');\n        feedbackEl.classList.add('border');\n\n        if (isCorrect) {\n          correctCount++;\n          inputEl.className = \"w-full sm:w-72 px-3.5 py-2.5 text-base border-2 border-emerald-600 bg-emerald-50/30 text-emerald-900 rounded-lg outline-none font-semibold transition-all\";\n          feedbackEl.classList.add('bg-emerald-50', 'text-emerald-900', 'border-emerald-200');\n          feedbackEl.innerHTML = `\n            <div class=\"flex items-center gap-2\">\n              <svg class=\"w-5 h-5 text-emerald-600 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/></svg>\n              <span><strong>Correct!</strong> ${config.explanation}</span>\n            </div>\n          `;\n        } else {\n          inputEl.className = \"w-full sm:w-72 px-3.5 py-2.5 text-base border-2 border-red-500 bg-red-50/30 text-red-900 rounded-lg outline-none font-semibold transition-all\";\n          feedbackEl.classList.add('bg-red-50', 'text-red-900', 'border-red-200');\n          const primaryAnswer = config.answers[0];\n          feedbackEl.innerHTML = `\n            <div class=\"flex items-start gap-2\">\n              <svg class=\"w-5 h-5 text-red-600 flex-shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/></svg>\n              <div>\n                <div><strong>Incorrect.</strong> Correct answer: <span class=\"underline font-bold text-red-700\">${primaryAnswer}</span></div>\n                <div class=\"text-xs text-slate-600 mt-1\">${config.explanation}</div>\n              </div>\n            </div>\n          `;\n        }\n      }\n\n      // Display Score\n      const scoreBanner = document.getElementById('score-banner');\n      const scoreText = document.getElementById('score-text');\n      const scoreSubtext = document.getElementById('score-subtext');\n      \n      scoreBanner.classList.remove('hidden', 'bg-emerald-100', 'bg-amber-100', 'bg-red-100');\n      \n      const percentage = Math.round((correctCount / totalCount) * 100);\n      scoreText.innerText = `Score: ${correctCount} / ${totalCount} (${percentage}%)`;\n\n      if (percentage === 100) {\n        scoreBanner.classList.add('bg-emerald-100');\n        scoreSubtext.innerText = \"Excellent work! All corrections are accurate.\";\n      } else if (percentage >= 60) {\n        scoreBanner.classList.add('bg-amber-100');\n        scoreSubtext.innerText = \"Good effort! Review the highlighted mistakes above.\";\n      } else {\n        scoreBanner.classList.add('bg-red-100');\n        scoreSubtext.innerText = \"Keep practicing! Review grammar rules and try again.\";\n      }\n\n      // Send event message to parent container\n      window.parent.postMessage({\n        type: 'ACTIVITY_SCORE',\n        score: correctCount,\n        total: totalCount\n      }, '*');\n    }\n\n    function resetQuiz() {\n      for (const id of Object.keys(answerKey)) {\n        const inputEl = document.getElementById(`q${id}`);\n        const cardEl = inputEl.closest('.question-card');\n        const feedbackEl = cardEl.querySelector('.feedback');\n\n        inputEl.value = '';\n        inputEl.className = \"w-full sm:w-72 px-3.5 py-2.5 text-base border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400\";\n        feedbackEl.classList.add('hidden');\n      }\n\n      const scoreBanner = document.getElementById('score-banner');\n      scoreBanner.classList.add('hidden');\n    }\n  </script>\n\n</body>\n</html>"
    }
  ]
}