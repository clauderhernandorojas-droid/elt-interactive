{
  "version": "2.0",
  "title": "Int WB U1 Lesson 1B",
  "updatedAt": "2026-10-27T18:45:45.204Z",
  "slides": [
    {
      "id": 1793069309664,
      "title": "Actividad IA #2",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Likes and dislikes - ELT Interactive Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom styles for smooth transitions and touch target enforcement */\n        .touch-target {\n            min-height: 44px;\n        }\n        select, button {\n            touch-action: manipulation;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Header / Instructions -->\n    <header class=\"w-full bg-indigo-600 text-white shadow-md p-4 md:p-6\">\n        <div class=\"max-w-2xl mx-auto\">\n            <span class=\"text-xs uppercase tracking-wider bg-indigo-500 px-2.5 py-1 rounded-full font-semibold\">Vocabulary & Grammar</span>\n            <h1 class=\"text-xl md:text-2xl font-bold mt-2\">Likes and dislikes</h1>\n            <p class=\"text-indigo-100 text-sm mt-1\">Match sentence beginnings (1–9) with the correct endings (a–i).</p>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-2xl mx-auto p-4 md:p-6 flex-grow\">\n        \n        <!-- Reference Box for Endings (Mobile friendly collapsible or permanent top block) -->\n        <section aria-label=\"Sentence Endings Reference\" class=\"bg-white border border-slate-200 rounded-xl p-4 shadow-sm mb-6\">\n            <h2 class=\"text-sm font-bold text-slate-700 uppercase tracking-wide mb-3 flex items-center justify-between\">\n                <span>Sentence Endings (a–i)</span>\n                <span class=\"text-xs text-indigo-600 font-normal\">Tap dropdowns below to select</span>\n            </h2>\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-600\">\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100\"><strong>a)</strong> keen on joining my local gym.</div>\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100\"><strong>b)</strong> mind going food shopping.</div>\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100\"><strong>c)</strong> working at weekends.</div>\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100\"><strong>d)</strong> a quiet night in.</div>\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100\"><strong>e)</strong> in working abroad.</div>\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100\"><strong>f)</strong> to the dentist at all.</div>\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100\"><strong>g)</strong> drives me crazy.</div>\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100\"><strong>h)</strong> on takeaway food.</div>\n                <div class=\"p-1.5 bg-slate-50 rounded border border-slate-100 sm:col-span-2\"><strong>i)</strong> at the weekends are wonderful.</div>\n            </div>\n        </section>\n\n        <!-- Activity Form / Question List -->\n        <form id=\"activity-form\" class=\"space-y-3\">\n            \n            <!-- Item generator template via JS or explicit HTML for ultimate reliability -->\n            <div id=\"questions-container\" class=\"space-y-3\">\n                <!-- Injected via JavaScript to keep code clean and maintainable -->\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"pt-4 flex flex-col sm:flex-row gap-3\">\n                <button type=\"button\" id=\"check-btn\" class=\"touch-target w-full sm:flex-1 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold rounded-xl shadow transition-all px-6 py-2.5 text-base flex items-center justify-center gap-2\">\n                    Check Answers\n                </button>\n                <button type=\"button\" id=\"reset-btn\" class=\"touch-target w-full sm:w-auto bg-slate-200 hover:bg-slate-300 active:bg-slate-400 text-slate-700 font-semibold rounded-xl transition-all px-6 py-2.5 text-base flex items-center justify-center\">\n                    Reset\n                </button>\n            </div>\n        </form>\n\n        <!-- Feedback & Score Display Box -->\n        <div id=\"feedback-container\" class=\"hidden mt-6 p-4 rounded-xl border text-center transition-all\">\n            <p id=\"score-text\" class=\"text-lg font-bold\"></p>\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 bg-white mt-auto\">\n        Interactive ELT Task &bull; Mobile Optimized\n    </footer>\n\n    <!-- Script Logic -->\n    <script>\n        // Answer Key based precisely on the provided teacher key: 1a, 2a, 3b, 4f, 5g, 6i, 7h, 8c, 9d\n        // Note: Number 1 has 'e' pre-filled in the book sample, but official answer key states 1a. We respect the Answer Key!\n        const activityData = [\n            { id: 1, beginning: \"I'm very interested\", answer: \"a\" },\n            { id: 2, beginning: \"I'm quite\", answer: \"a\" },\n            { id: 3, beginning: \"I don't\", answer: \"b\" },\n            { id: 4, beginning: \"I don't like going\", answer: \"f\" },\n            { id: 5, beginning: \"Tidying up my house\", answer: \"g\" },\n            { id: 6, beginning: \"I think lie-ins\", answer: \"i\" },\n            { id: 7, beginning: \"I'm not very keen\", answer: \"h\" },\n            { id: 8, beginning: \"I can't stand\", answer: \"c\" },\n            { id: 9, beginning: \"I enjoy having\", answer: \"d\" }\n        ];\n\n        const endings = [\n            { letter: \"a\", text: \"keen on joining my local gym.\" },\n            { letter: \"b\", text: \"mind going food shopping.\" },\n            { letter: \"c\", text: \"working at weekends.\" },\n            { letter: \"d\", text: \"a quiet night in.\" },\n            { letter: \"e\", text: \"in working abroad.\" },\n            { letter: \"f\", text: \"to the dentist at all.\" },\n            { letter: \"g\", text: \"drives me crazy.\" },\n            { letter: \"h\", text: \"on takeaway food.\" },\n            { letter: \"i\", text: \"at the weekends are wonderful.\" }\n        ];\n\n        const container = document.getElementById('questions-container');\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const feedbackContainer = document.getElementById('feedback-container');\n        const scoreText = document.getElementById('score-text');\n\n        // Render Questions\n        function renderActivity() {\n            container.innerHTML = '';\n            activityData.forEach((item) => {\n                const row = document.createElement('div');\n                row.className = \"flex flex-col sm:flex-row sm:items-center justify-between bg-white border border-slate-200 rounded-xl p-3 shadow-sm gap-2 transition-colors\";\n                row.id = `row-${item.id}`;\n\n                let optionsHTML = `<option value=\"\" disabled selected>Choose ending...</option>`;\n                endings.forEach(end => {\n                    optionsHTML += `<option value=\"${end.letter}\">${end.letter}) ${end.text}</option>`;\n                });\n\n                row.innerHTML = `\n                    <div class=\"flex items-start sm:items-center gap-3 text-slate-700 text-sm md:text-base flex-grow\">\n                        <span class=\"font-bold text-indigo-600 min-w-[20px]\">${item.id}.</span>\n                        <span class=\"font-medium\">${item.beginning}</span>\n                    </div>\n                    <div class=\"w-full sm:w-auto\">\n                        <select id=\"select-${item.id}\" class=\"touch-target w-full sm:w-64 bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-slate-800 text-base focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all\">\n                            ${optionsHTML}\n                        </select>\n                    </div>\n                `;\n                container.appendChild(row);\n            });\n        }\n\n        // Check Answers Logic\n        function checkAnswers() {\n            let correctCount = 0;\n            const total = activityData.length;\n\n            activityData.forEach(item => {\n                const select = document.getElementById(`select-${item.id}`);\n                const row = document.getElementById(`row-${item.id}`);\n                const userChoice = select.value;\n\n                // Reset classes\n                row.classList.remove('bg-emerald-50', 'border-emerald-300', 'bg-rose-50', 'border-rose-300');\n                select.classList.remove('border-emerald-500', 'bg-emerald-50', 'border-rose-500', 'bg-rose-50', 'text-emerald-900', 'text-rose-900');\n\n                if (userChoice === item.answer) {\n                    correctCount++;\n                    row.classList.add('bg-emerald-50/60', 'border-emerald-300');\n                    select.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-semibold');\n                } else {\n                    row.classList.add('bg-rose-50/60', 'border-rose-300');\n                    select.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900', 'font-semibold');\n                }\n            });\n\n            // Show feedback box\n            feedbackContainer.classList.remove('hidden');\n            if (correctCount === total) {\n                feedbackContainer.className = \"mt-6 p-4 rounded-xl border bg-emerald-100 border-emerald-300 text-emerald-800 text-center shadow-sm\";\n                scoreText.innerHTML = `🎉 Excellent! Perfect Score: ${correctCount} / ${total}`;\n            } else {\n                feedbackContainer.className = \"mt-6 p-4 rounded-xl border bg-amber-50 border-amber-200 text-amber-900 text-center shadow-sm\";\n                scoreText.innerHTML = `Good effort! You got ${correctCount} out of ${total} correct. Review the highlighted items.`;\n            }\n\n            // Send score to parent frame if embedded\n            try {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: total\n                }, '*');\n            } catch (e) {\n                console.log('Parent postMessage not available');\n            }\n        }\n\n        // Reset Logic\n        function resetActivity() {\n            renderActivity();\n            feedbackContainer.classList.add('hidden');\n            window.scrollTo({ top: 0, behavior: 'smooth' });\n        }\n\n        // Event Listeners\n        checkBtn.addEventListener('click', checkAnswers);\n        resetBtn.addEventListener('click', resetActivity);\n\n        // Initial Load\n        renderActivity();\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793069503686,
      "title": "Actividad IA #2",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Likes and dislikes - Categorization</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Touch target improvements & custom animations */\n        .touch-target {\n            min-height: 44px;\n            min-width: 44px;\n        }\n        .sentence-card {\n            transition: all 0.2s ease-in-out;\n        }\n        .category-dropzone {\n            min-height: 120px;\n            transition: background-color 0.2s, border-color 0.2s;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-3 md:p-6 flex-grow flex flex-col gap-6\">\n        \n        <!-- Header -->\n        <header class=\"bg-white rounded-2xl p-4 md:p-6 shadow-sm border border-slate-200\">\n            <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                <div>\n                    <span class=\"bg-indigo-100 text-indigo-700 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wide\">Exercise 1b</span>\n                    <h1 class=\"text-xl md:text-2xl font-bold text-slate-900 mt-1\">Likes and dislikes</h1>\n                    <p class=\"text-sm text-slate-600 mt-0.5\">Categorize the complete sentences from Exercise 1a into the correct group.</p>\n                </div>\n                <div id=\"score-badge\" class=\"hidden items-center gap-2 bg-slate-100 px-4 py-2 rounded-xl text-sm font-medium self-start md:self-auto\">\n                    <span>Score:</span>\n                    <span id=\"score-text\" class=\"font-bold text-indigo-600\">0 / 9</span>\n                </div>\n            </div>\n        </header>\n\n        <!-- Reference Section (Accordion / Collapsible or Fixed Card for Mobile-First) -->\n        <section class=\"bg-indigo-50/60 rounded-2xl p-4 md:p-6 border border-indigo-100\">\n            <div class=\"flex items-center justify-between cursor-pointer\" onclick=\"toggleReference()\">\n                <div class=\"flex items-center gap-2\">\n                    <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"/></svg>\n                    <h2 class=\"font-semibold text-indigo-900 text-sm md:text-base\">Reference: Exercise 1a (Completed Sentences)</h2>\n                </div>\n                <button id=\"ref-toggle-btn\" class=\"text-indigo-600 text-sm font-medium touch-target flex items-center\">Hide</button>\n            </div>\n            \n            <div id=\"reference-content\" class=\"mt-3 grid grid-cols-1 md:grid-cols-2 gap-2 text-xs md:text-sm text-indigo-950/80\">\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>1.</strong> I'm very interested <strong>in working abroad.</strong></div>\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>2.</strong> I'm quite <strong>keen on joining my local gym.</strong></div>\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>3.</strong> I don't <strong>mind going food shopping.</strong></div>\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>4.</strong> I don't like going <strong>to the dentist at all.</strong></div>\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>5.</strong> Tidying up my house <strong>drives me crazy.</strong></div>\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>6.</strong> I think lie-ins <strong>at the weekends are wonderful.</strong></div>\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>7.</strong> I'm not very keen <strong>on takeaway food.</strong></div>\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>8.</strong> I can't stand <strong>working at weekends.</strong></div>\n                <div class=\"bg-white/80 p-2 rounded-lg border border-indigo-100/60\"><strong>9.</strong> I enjoy having <strong>a quiet night in.</strong></div>\n            </div>\n        </section>\n\n        <!-- Interactive Workspace -->\n        <section class=\"flex flex-col gap-6\">\n            \n            <!-- Bank of Sentences to categorize -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-6 shadow-sm border border-slate-200\">\n                <h3 class=\"font-semibold text-slate-800 text-sm md:text-base mb-3 flex items-center justify-between\">\n                    <span>Tap a sentence, then tap a category (or drag & drop):</span>\n                    <span class=\"text-xs text-slate-500 font-normal\">Sentences left: <span id=\"remaining-count\" class=\"font-bold text-slate-700\">9</span></span>\n                </h3>\n                \n                <div id=\"sentence-bank\" class=\"flex flex-wrap gap-2.5 min-h-[70px] p-2 bg-slate-50 rounded-xl border border-dashed border-slate-300\">\n                    <!-- Dynamic Sentences will be injected here -->\n                </div>\n            </div>\n\n            <!-- Categories Dropzones -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                \n                <!-- Category A: Like -->\n                <div class=\"bg-emerald-50/40 rounded-2xl p-4 border border-emerald-200 flex flex-col justify-between category-dropzone\" data-category=\"A\" ondragover=\"allowDrop(event)\" ondrop=\"drop(event, 'A')\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-2\">\n                            <span class=\"bg-emerald-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg\">A</span>\n                            <span class=\"text-xs font-semibold text-emerald-800 uppercase tracking-wider\">Like something</span>\n                        </div>\n                        <p class=\"text-xs text-emerald-900/70 mb-3\">Phrases to say you like something:</p>\n                        <div class=\"category-items flex flex-col gap-2 min-h-[80px]\" data-category=\"A\">\n                            <!-- Dropped items go here -->\n                        </div>\n                    </div>\n                    <div class=\"mt-3 text-right\">\n                        <button onclick=\"selectCategoryForActive('A')\" class=\"md:hidden w-full bg-emerald-600 text-white text-xs font-medium py-2 rounded-lg touch-target\">Place here</button>\n                    </div>\n                </div>\n\n                <!-- Category B: OK -->\n                <div class=\"bg-amber-50/40 rounded-2xl p-4 border border-amber-200 flex flex-col justify-between category-dropzone\" data-category=\"B\" ondragover=\"allowDrop(event)\" ondrop=\"drop(event, 'B')\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-2\">\n                            <span class=\"bg-amber-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg\">B</span>\n                            <span class=\"text-xs font-semibold text-amber-800 uppercase tracking-wider\">Something is OK</span>\n                        </div>\n                        <p class=\"text-xs text-amber-900/70 mb-3\">Phrases to say something is OK:</p>\n                        <div class=\"category-items flex flex-col gap-2 min-h-[80px]\" data-category=\"B\">\n                            <!-- Dropped items go here -->\n                        </div>\n                    </div>\n                    <div class=\"mt-3 text-right\">\n                        <button onclick=\"selectCategoryForActive('B')\" class=\"md:hidden w-full bg-amber-600 text-white text-xs font-medium py-2 rounded-lg touch-target\">Place here</button>\n                    </div>\n                </div>\n\n                <!-- Category C: Dislike -->\n                <div class=\"bg-rose-50/40 rounded-2xl p-4 border border-rose-200 flex flex-col justify-between category-dropzone\" data-category=\"C\" ondragover=\"allowDrop(event)\" ondrop=\"drop(event, 'C')\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-2\">\n                            <span class=\"bg-rose-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg\">C</span>\n                            <span class=\"text-xs font-semibold text-rose-800 uppercase tracking-wider\">Don't like something</span>\n                        </div>\n                        <p class=\"text-xs text-rose-900/70 mb-3\">Phrases to say you don't like something:</p>\n                        <div class=\"category-items flex flex-col gap-2 min-h-[80px]\" data-category=\"C\">\n                            <!-- Dropped items go here -->\n                        </div>\n                    </div>\n                    <div class=\"mt-3 text-right\">\n                        <button onclick=\"selectCategoryForActive('C')\" class=\"md:hidden w-full bg-rose-600 text-white text-xs font-medium py-2 rounded-lg touch-target\">Place here</button>\n                    </div>\n                </div>\n\n            </div>\n\n        </section>\n\n        <!-- Action Buttons Bar -->\n        <div class=\"flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-200\">\n            <button onclick=\"resetActivity()\" class=\"px-5 py-2.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 font-medium rounded-xl text-sm touch-target transition-colors shadow-sm\">\n                Reset\n            </button>\n            <button onclick=\"checkAnswers()\" class=\"px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-sm touch-target transition-colors shadow-sm flex items-center gap-2\">\n                Check Answers\n            </button>\n        </div>\n\n    </main>\n\n    <!-- Footer / Branding -->\n    <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-100 bg-white mt-auto\">\n        Interactive ELT Learning Module &bull; Responsive Touch Interface\n    </footer>\n\n    <!-- JavaScript Logic -->\n    <script>\n        // Data model based on Answer Key\n        // Answer Key 1b: A: 2, 6, 9 | B: 3 | C: 4, 5, 7, 8\n        const sentencesData = [\n            { id: 1, text: \"1. I'm very interested in working abroad.\", category: null },\n            { id: 2, text: \"2. I'm quite keen on joining my local gym.\", targetCategory: \"A\" },\n            { id: 3, text: \"3. I don't mind going food shopping.\", targetCategory: \"B\" },\n            { id: 4, text: \"4. I don't like going to the dentist at all.\", targetCategory: \"C\" },\n            { id: 5, text: \"5. Tidying up my house drives me crazy.\", targetCategory: \"C\" },\n            { id: 6, text: \"6. I think lie-ins at the weekends are wonderful.\", targetCategory: \"A\" },\n            { id: 7, text: \"7. I'm not very keen on takeaway food.\", targetCategory: \"C\" },\n            { id: 8, text: \"8. I can't stand working at weekends.\", targetCategory: \"C\" },\n            { id: 9, text: \"9. I enjoy having a quiet night in.\", targetCategory: \"A\" }\n        ];\n\n        let activeSentenceId = null;\n\n        // Initialize App\n        function initApp() {\n            renderSentences();\n        }\n\n        function toggleReference() {\n            const content = document.getElementById('reference-content');\n            const btn = document.getElementById('ref-toggle-btn');\n            if (content.classList.contains('hidden')) {\n                content.classList.remove('hidden');\n                btn.textContent = 'Hide';\n            } else {\n                content.classList.add('hidden');\n                btn.textContent = 'Show';\n            }\n        }\n\n        function renderSentences() {\n            const bank = document.getElementById('sentence-bank');\n            bank.innerHTML = '';\n            \n            // Clear category dropzones\n            document.querySelectorAll('.category-items').forEach(el => el.innerHTML = '');\n\n            let remaining = 0;\n\n            sentencesData.forEach(item => {\n                const card = document.createElement('div');\n                card.className = `sentence-card bg-white border border-slate-200 px-3 py-2 rounded-xl text-xs md:text-sm font-medium shadow-sm cursor-grab active:cursor-grabbing touch-target flex items-center select-none ${activeSentenceId === item.id ? 'ring-2 ring-indigo-600 border-indigo-600 bg-indigo-50/50' : ''}`;\n                card.textContent = item.text;\n                card.draggable = true;\n                card.dataset.id = item.id;\n\n                // Touch & Click selection for mobile ergonomics\n                card.onclick = (e) => {\n                    e.stopPropagation();\n                    selectSentence(item.id);\n                };\n\n                // Drag events\n                card.ondragstart = (e) => {\n                    e.dataTransfer.setData('text/plain', item.id);\n                };\n\n                if (!item.currentCategory) {\n                    remaining++;\n                    bank.appendChild(card);\n                } else {\n                    // Append to respective category container\n                    const container = document.querySelector(`.category-items[data-category=\"${item.currentCategory}\"]`);\n                    if (container) {\n                        container.appendChild(card);\n                    }\n                }\n            });\n\n            document.getElementById('remaining-count').textContent = remaining;\n        }\n\n        function selectSentence(id) {\n            if (activeSentenceId === id) {\n                activeSentenceId = null;\n            } else {\n                activeSentenceId = id;\n            }\n            renderSentences();\n        }\n\n        function selectCategoryForActive(category) {\n            if (activeSentenceId !== null) {\n                const item = sentencesData.find(s => s.id === activeSentenceId);\n                if (item) {\n                    item.currentCategory = category;\n                    activeSentenceId = null;\n                    renderSentences();\n                }\n            }\n        }\n\n        // Drag and Drop handlers\n        function allowDrop(ev) {\n            ev.preventDefault();\n        }\n\n        function drop(ev, category) {\n            ev.preventDefault();\n            const id = parseInt(ev.dataTransfer.getData('text/plain'));\n            const item = sentencesData.find(s => s.id === id);\n            if (item) {\n                item.currentCategory = category;\n                activeSentenceId = null;\n                renderSentences();\n            }\n        }\n\n        // Scoring and Verification\n        function checkAnswers() {\n            let correctCount = 0;\n            let totalCount = sentencesData.length;\n\n            sentencesData.forEach(item => {\n                // Find the DOM card for this item\n                const card = document.querySelector(`[data-id=\"${item.id}\"]`);\n                if (card) {\n                    card.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n                    if (item.currentCategory === item.targetCategory) {\n                        correctCount++;\n                        card.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n                    } else {\n                        card.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n                    }\n                }\n            });\n\n            // Show score badge\n            const scoreBadge = document.getElementById('score-badge');\n            const scoreText = document.getElementById('score-text');\n            scoreText.textContent = `${correctCount} / ${totalCount}`;\n            scoreBadge.classList.remove('hidden');\n            scoreBadge.classList.add('flex');\n\n            // Post message for LMS integration\n            window.parent.postMessage({ \n                type: 'ACTIVITY_SCORE', \n                score: correctCount, \n                total: totalCount \n            }, '*');\n        }\n\n        function resetActivity() {\n            sentencesData.forEach(item => {\n                item.currentCategory = null;\n            });\n            activeSentenceId = null;\n            document.getElementById('score-badge').classList.add('hidden');\n            document.getElementById('score-badge').classList.remove('flex');\n            renderSentences();\n        }\n\n        // Run initialization on load\n        window.onload = initApp;\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793069867616,
      "title": "Actividad IA #3",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Positive and Negative Verb Forms, Words and Phrases - ELT Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom font smoothing and touch improvements */\n        body {\n            -webkit-tap-highlight-color: transparent;\n        }\n        .gap-custom {\n            line-height: 2.5rem;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Header / Navbar -->\n    <header class=\"bg-indigo-600 text-white shadow-md py-4 px-4 md:px-8\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2\">\n            <div>\n                <span class=\"bg-indigo-700 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wider\">G1.2 Grammar</span>\n                <h1 class=\"text-lg md:text-xl font-bold mt-1\">Positive and negative verb forms, words and phrases</h1>\n            </div>\n            <div id=\"score-badge\" class=\"bg-indigo-700 px-3 py-1.5 rounded-lg text-sm font-medium hidden\">\n                Score: <span id=\"score-val\">0</span> / <span id=\"total-val\">8</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 md:p-8 flex-grow\">\n        \n        <!-- Instructions Card -->\n        <section class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 md:p-6 mb-6\">\n            <h2 class=\"text-base md:text-lg font-semibold text-slate-900 mb-2\">\n                <span class=\"bg-indigo-100 text-indigo-700 rounded-full w-7 h-7 inline-flex items-center justify-center text-sm font-bold mr-2\">2</span>\n                Read Martin's opinion of computers and fill in the gaps. Choose a), b) or c).\n            </h2>\n            <p class=\"text-sm text-slate-500 italic\">Tap the highlighted dropdowns within the text to choose the correct verb form or phrase.</p>\n        </section>\n\n        <!-- Interactive Reading Text Section -->\n        <section class=\"bg-white rounded-xl shadow-md border border-slate-200 p-5 md:p-8 mb-6\">\n            <div id=\"reading-text\" class=\"text-base md:text-lg text-slate-700 leading-loose\">\n                There aren't many things I \n                <span class=\"inline-block my-1 mx-1\">\n                    <select id=\"gap-1\" class=\"gap-select bg-slate-100 border-2 border-slate-300 rounded-lg px-3 py-2 text-base font-medium text-indigo-700 focus:outline-none focus:border-indigo-500 transition-colors\">\n                        <option value=\"\" disabled selected>1...</option>\n                        <option value=\"a\">'m not liking</option>\n                        <option value=\"b\">don't like</option>\n                        <option value=\"c\">didn't like</option>\n                    </select>\n                </span> \n                in life, but computers drive me crazy. Of course, everyone \n                <span class=\"inline-block my-1 mx-1\">\n                    <select id=\"gap-2\" class=\"gap-select bg-slate-100 border-2 border-slate-300 rounded-lg px-3 py-2 text-base font-medium text-indigo-700 focus:outline-none focus:border-indigo-500 transition-colors\">\n                        <option value=\"\" disabled selected>2...</option>\n                        <option value=\"a\">says</option>\n                        <option value=\"b\">said</option>\n                        <option value=\"c\">is saying</option>\n                    </select>\n                </span> \n                they are a wonderful invention and we've got one at home for the children. Both of them \n                <span class=\"inline-block my-1 mx-1\">\n                    <select id=\"gap-3\" class=\"gap-select bg-slate-100 border-2 border-slate-300 rounded-lg px-3 py-2 text-base font-medium text-indigo-700 focus:outline-none focus:border-indigo-500 transition-colors\">\n                        <option value=\"\" disabled selected>3...</option>\n                        <option value=\"a\">are using</option>\n                        <option value=\"b\">use</option>\n                        <option value=\"c\">have used</option>\n                    </select>\n                </span> \n                a computer since they \n                <span class=\"inline-block my-1 mx-1\">\n                    <select id=\"gap-4\" class=\"gap-select bg-slate-100 border-2 border-slate-300 rounded-lg px-3 py-2 text-base font-medium text-indigo-700 focus:outline-none focus:border-indigo-500 transition-colors\">\n                        <option value=\"\" disabled selected>4...</option>\n                        <option value=\"a\">have been</option>\n                        <option value=\"b\">are</option>\n                        <option value=\"c\">were</option>\n                    </select>\n                </span> \n                young and they hardly ever \n                <span class=\"inline-block my-1 mx-1\">\n                    <select id=\"gap-5\" class=\"gap-select bg-slate-100 border-2 border-slate-300 rounded-lg px-3 py-2 text-base font-medium text-indigo-700 focus:outline-none focus:border-indigo-500 transition-colors\">\n                        <option value=\"\" disabled selected>5...</option>\n                        <option value=\"a\">have</option>\n                        <option value=\"b\">had</option>\n                        <option value=\"c\">are having</option>\n                    </select>\n                </span> \n                any problems. But when I \n                <span class=\"inline-block my-1 mx-1\">\n                    <select id=\"gap-6\" class=\"gap-select bg-slate-100 border-2 border-slate-300 rounded-lg px-3 py-2 text-base font-medium text-indigo-700 focus:outline-none focus:border-indigo-500 transition-colors\">\n                        <option value=\"\" disabled selected>6...</option>\n                        <option value=\"a\">tried</option>\n                        <option value=\"b\">'m trying</option>\n                        <option value=\"c\">try</option>\n                    </select>\n                </span> \n                to send an email or use the Internet, it <strong>never</strong> works properly. I \n                <span class=\"inline-block my-1 mx-1\">\n                    <select id=\"gap-7\" class=\"gap-select bg-slate-100 border-2 border-slate-300 rounded-lg px-3 py-2 text-base font-medium text-indigo-700 focus:outline-none focus:border-indigo-500 transition-colors\">\n                        <option value=\"\" disabled selected>7...</option>\n                        <option value=\"a\">haven't made</option>\n                        <option value=\"b\">didn't make</option>\n                        <option value=\"c\">'m not making</option>\n                    </select>\n                </span> \n                excuses — I know it's my problem rather than the computer's. None of my friends like computers so maybe it \n                <span class=\"inline-block my-1 mx-1\">\n                    <select id=\"gap-8\" class=\"gap-select bg-slate-100 border-2 border-slate-300 rounded-lg px-3 py-2 text-base font-medium text-indigo-700 focus:outline-none focus:border-indigo-500 transition-colors\">\n                        <option value=\"\" disabled selected>8...</option>\n                        <option value=\"a\">has been</option>\n                        <option value=\"b\">was</option>\n                        <option value=\"c\">'s</option>\n                    </select>\n                </span> \n                something to do with our age. I don't think we'll ever understand them.\n            </div>\n        </section>\n\n        <!-- Action Buttons -->\n        <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4 mb-8\">\n            <button id=\"check-btn\" class=\"w-full sm:w-auto min-h-[48px] px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow transition-all transform active:scale-95 flex items-center justify-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                    <path fill-rule=\"evenodd\" d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\" clip-rule=\"evenodd\" />\n                </svg>\n                Check Answers\n            </button>\n            <button id=\"reset-btn\" class=\"w-full sm:w-auto min-h-[48px] px-6 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-xl shadow transition-all transform active:scale-95 flex items-center justify-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                    <path fill-rule=\"evenodd\" d=\"M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z\" clip-rule=\"evenodd\" />\n                </svg>\n                Reset\n            </button>\n        </div>\n\n        <!-- Feedback Box -->\n        <div id=\"feedback-container\" class=\"hidden rounded-xl p-4 text-center font-medium shadow-sm transition-all mb-8\"></div>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-slate-200 py-4 px-6 text-center text-xs text-slate-400\">\n        Interactive ELT Practice Module &bull; Responsive Design for Mobile & Tablet\n    </footer>\n\n    <!-- JavaScript Application Logic -->\n    <script>\n        // Answer Key derived strictly from textbook answer key (Image 2 + Image 1)\n        const answerKey = {\n            1: 'b',\n            2: 'a',\n            3: 'c',\n            4: 'c',\n            5: 'a',\n            6: 'c',\n            7: 'c',\n            8: 'c'\n        };\n\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const feedbackContainer = document.getElementById('feedback-container');\n        const scoreBadge = document.getElementById('score-badge');\n        const scoreVal = document.getElementById('score-val');\n        const totalVal = document.getElementById('total-val');\n\n        const totalItems = Object.keys(answerKey).length;\n        totalVal.textContent = totalItems;\n\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n            let answeredCount = 0;\n\n            for (let i = 1; i <= totalItems; i++) {\n                const selectElement = document.getElementById(`gap-${i}`);\n                const userChoice = selectElement.value;\n                const correctChoice = answerKey[i];\n\n                // Remove previous evaluation styles\n                selectElement.classList.remove('border-emerald-600', 'bg-emerald-50', 'text-emerald-800', 'border-rose-600', 'bg-rose-50', 'text-rose-800');\n\n                if (userChoice !== \"\") {\n                    answeredCount++;\n                    if (userChoice === correctChoice) {\n                        correctCount++;\n                        selectElement.classList.add('border-emerald-600', 'bg-emerald-50', 'text-emerald-800');\n                    } else {\n                        selectElement.classList.add('border-rose-600', 'bg-rose-50', 'text-rose-800');\n                    }\n                } else {\n                    // Unanswered items treated as error\n                    selectElement.classList.add('border-rose-600', 'bg-rose-50', 'text-rose-800');\n                }\n            }\n\n            // Display Score Badge\n            scoreVal.textContent = correctCount;\n            scoreBadge.classList.remove('hidden');\n\n            // Display Feedback message\n            feedbackContainer.classList.remove('hidden');\n            if (correctCount === totalItems) {\n                feedbackContainer.className = \"rounded-xl p-4 text-center font-medium shadow-sm transition-all mb-8 bg-emerald-100 text-emerald-800 border border-emerald-300\";\n                feedbackContainer.textContent = \"Outstanding! All answers are correct.\";\n            } else {\n                feedbackContainer.className = \"rounded-xl p-4 text-center font-medium shadow-sm transition-all mb-8 bg-amber-100 text-amber-800 border border-amber-300\";\n                feedbackContainer.textContent = `You got ${correctCount} out of ${totalItems} correct. Review the highlighted items and try again!`;\n            }\n\n            // Emit postMessage to parent container / LMS framework\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalItems\n            }, '*');\n\n            // Scroll feedback into view smoothly on mobile\n            feedbackContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n        });\n\n        resetBtn.addEventListener('click', () => {\n            for (let i = 1; i <= totalItems; i++) {\n                const selectElement = document.getElementById(`gap-${i}`);\n                selectElement.value = \"\";\n                selectElement.classList.remove('border-emerald-600', 'bg-emerald-50', 'text-emerald-800', 'border-rose-600', 'bg-rose-50', 'text-rose-800');\n                selectElement.classList.add('border-slate-300', 'bg-slate-100', 'text-indigo-700');\n            }\n            scoreBadge.classList.add('hidden');\n            feedbackContainer.classList.add('hidden');\n            feedbackContainer.textContent = \"\";\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793070004355,
      "title": "Actividad IA #4",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Diane's Opinion on Computers - Verb Tenses Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .input-gap {\n            min-height: 42px;\n            font-size: 16px;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col items-center justify-start p-3 md:p-6\">\n\n    <div class=\"w-full max-w-3xl bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200\">\n        <!-- Header -->\n        <div class=\"bg-indigo-600 text-white p-4 md:p-6\">\n            <span class=\"bg-indigo-500 text-indigo-100 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider\">Grammar Practice</span>\n            <h1 class=\"text-xl md:text-2xl font-bold mt-2\">Diane's Opinion on Computers</h1>\n            <p class=\"text-indigo-100 text-sm mt-1\">Fill in the gaps with the correct form of the verbs in brackets: Present Simple, Present Continuous, Past Simple, or Present Perfect Simple.</p>\n        </div>\n\n        <!-- Main Content Area -->\n        <div class=\"p-4 md:p-8 space-y-6\">\n            \n            <!-- Instructions box -->\n            <div class=\"bg-amber-50 border-l-4 border-amber-400 p-4 rounded-r-lg text-sm text-amber-900\">\n                <span class=\"font-bold\">Instructions:</span> Read the text below carefully. Tap each input box to type the correct verb form. Pay attention to contractions and punctuation if applicable.\n            </div>\n\n            <!-- Reading Text Container -->\n            <div class=\"bg-slate-50 p-4 md:p-6 rounded-xl border border-slate-200 text-base md:text-lg leading-relaxed\">\n                <p class=\"mb-4\">\n                    <span class=\"font-bold text-indigo-900\">I think</span> computers are amazing. We <span class=\"font-semibold text-emerald-700 underline decoration-dotted\">1 've had</span> (have) one in our family for almost 20 years – since I \n                    <span class=\"inline-flex items-center my-1 mx-1\">\n                        <span class=\"bg-slate-200 px-2 py-1 rounded text-xs font-mono text-slate-600 mr-1\">(be)</span>\n                        <input type=\"text\" id=\"gap2\" data-answer=\"was\" placeholder=\"2...\" class=\"input-gap w-28 px-3 py-2 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors text-center font-medium bg-white shadow-sm\">\n                    </span>\n                    about 12. At that time we \n                    <span class=\"inline-flex items-center my-1 mx-1\">\n                        <span class=\"bg-slate-200 px-2 py-1 rounded text-xs font-mono text-slate-600 mr-1\">(not use)</span>\n                        <input type=\"text\" id=\"gap3\" data-answer=\"didn't use\" placeholder=\"3...\" class=\"input-gap w-36 px-3 py-2 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors text-center font-medium bg-white shadow-sm\">\n                    </span>\n                    it for anything serious – <span class=\"font-bold\">no one did</span>. My sister and I <span class=\"font-bold\">usually played</span> games on it. Then at university I <span class=\"font-bold\">always</span>\n                    <span class=\"inline-flex items-center my-1 mx-1\">\n                        <span class=\"bg-slate-200 px-2 py-1 rounded text-xs font-mono text-slate-600 mr-1\">(write)</span>\n                        <input type=\"text\" id=\"gap4\" data-answer=\"wrote\" placeholder=\"4...\" class=\"input-gap w-32 px-3 py-2 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors text-center font-medium bg-white shadow-sm\">\n                    </span>\n                    my essays on it and I soon realised <span class=\"font-bold\">there are lots of</span> things a computer can help with. Since then I \n                    <span class=\"inline-flex items-center my-1 mx-1\">\n                        <span class=\"bg-slate-200 px-2 py-1 rounded text-xs font-mono text-slate-600 mr-1\">(not be able to)</span>\n                        <input type=\"text\" id=\"gap5\" data-answer=\"haven't been able to\" placeholder=\"5...\" class=\"input-gap w-48 px-3 py-2 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors text-center font-medium bg-white shadow-sm\">\n                    </span>\n                    leave it alone! <span class=\"font-bold\">All of</span> my friends \n                    <span class=\"inline-flex items-center my-1 mx-1\">\n                        <span class=\"bg-slate-200 px-2 py-1 rounded text-xs font-mono text-slate-600 mr-1\">(call)</span>\n                        <input type=\"text\" id=\"gap6\" data-answer=\"call\" placeholder=\"6...\" class=\"input-gap w-32 px-3 py-2 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors text-center font-medium bg-white shadow-sm\">\n                    </span>\n                    me with their computer problems. I \n                    <span class=\"inline-flex items-center my-1 mx-1\">\n                        <span class=\"bg-slate-200 px-2 py-1 rounded text-xs font-mono text-slate-600 mr-1\">(not get)</span>\n                        <input type=\"text\" id=\"gap7\" data-answer=\"don't get\" placeholder=\"7...\" class=\"input-gap w-32 px-3 py-2 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors text-center font-medium bg-white shadow-sm\">\n                    </span>\n                    paid or anything – I just do it as a favour. I \n                    <span class=\"inline-flex items-center my-1 mx-1\">\n                        <span class=\"bg-slate-200 px-2 py-1 rounded text-xs font-mono text-slate-600 mr-1\">(help)</span>\n                        <input type=\"text\" id=\"gap8\" data-answer=\"'m helping\" placeholder=\"8...\" class=\"input-gap w-32 px-3 py-2 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors text-center font-medium bg-white shadow-sm\">\n                    </span>\n                    two of my friends with their computers at the moment – they're broken. <span class=\"font-bold\">Neither of them</span> know anything about computers, but they know how to take me out for a meal!\n                </p>\n            </div>\n\n            <!-- Feedback & Score Banner -->\n            <div id=\"feedback-banner\" class=\"hidden p-4 rounded-xl text-center font-semibold text-lg transition-all\"></div>\n\n            <!-- Action Buttons -->\n            <div class=\"flex flex-col sm:flex-row gap-3 pt-2\">\n                <button id=\"check-btn\" onclick=\"checkAnswers()\" class=\"flex-1 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold py-3 px-6 rounded-xl shadow-md transition duration-200 min-h-[48px] flex items-center justify-center text-base\">\n                    Check Answers\n                </button>\n                <button id=\"reset-btn\" onclick=\"resetActivity()\" class=\"flex-1 bg-slate-200 hover:bg-slate-300 active:bg-slate-400 text-slate-700 font-bold py-3 px-6 rounded-xl transition duration-200 min-h-[48px] flex items-center justify-center text-base\">\n                    Reset\n                </button>\n            </div>\n\n        </div>\n        \n        <!-- Footer Info -->\n        <div class=\"bg-slate-100 px-6 py-3 border-t border-slate-200 text-xs text-slate-500 text-center\">\n            Interactive ELT Micro-App • Mobile First Responsive Design\n        </div>\n    </div>\n\n    <script>\n        const totalItems = 7; // Gaps 2 through 8\n\n        function normalizeText(text) {\n            return text.trim().toLowerCase().replace(/\\s+/g, ' ');\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const inputs = document.querySelectorAll('input[data-answer]');\n\n            inputs.forEach(input => {\n                const userVal = normalizeText(input.value);\n                const expectedVal = normalizeText(input.getAttribute('data-answer'));\n\n                // Remove previous styles\n                input.classList.remove('border-emerald-600', 'bg-emerald-50', 'text-emerald-900', 'border-rose-600', 'bg-rose-50', 'text-rose-900');\n\n                if (userVal === expectedVal) {\n                    correctCount++;\n                    input.classList.add('border-emerald-600', 'bg-emerald-50', 'text-emerald-900');\n                } else {\n                    input.classList.add('border-rose-600', 'bg-rose-50', 'text-rose-900');\n                }\n            });\n\n            // Show feedback banner\n            const banner = document.getElementById('feedback-banner');\n            banner.classList.remove('hidden');\n            \n            if (correctCount === totalItems) {\n                banner.className = \"p-4 rounded-xl text-center font-bold text-lg bg-emerald-100 text-emerald-800 border border-emerald-300\";\n                banner.innerHTML = `🎉 Excellent! All ${correctCount} of ${totalItems} answers are correct!`;\n            } else {\n                banner.className = \"p-4 rounded-xl text-center font-bold text-lg bg-amber-100 text-amber-900 border border-amber-300\";\n                banner.innerHTML = `You got ${correctCount} out of ${totalItems} correct. Check the red boxes and try again!`;\n            }\n\n            // Post score to parent container\n            window.parent.postMessage({ \n                type: 'ACTIVITY_SCORE', \n                score: correctCount, \n                total: totalItems \n            }, '*');\n        }\n\n        function resetActivity() {\n            const inputs = document.querySelectorAll('input[data-answer]');\n            inputs.forEach(input => {\n                input.value = '';\n                input.classList.remove('border-emerald-600', 'bg-emerald-50', 'text-emerald-900', 'border-rose-600', 'bg-rose-50', 'text-rose-900');\n            });\n\n            const banner = document.getElementById('feedback-banner');\n            banner.classList.add('hidden');\n            banner.innerHTML = '';\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793070437331,
      "title": "Actividad IA #5",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Vocabulary Practice - Opposites</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .touch-target {\n            min-height: 44px;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col\">\n\n    <!-- Header / Score Bar -->\n    <header class=\"bg-indigo-600 text-white shadow-md sticky top-0 z-50\">\n        <div class=\"max-w-3xl mx-auto px-4 py-3 flex justify-between items-center\">\n            <h1 class=\"text-base md:text-lg font-bold tracking-wide\">Exercise Match: Opposites</h1>\n            <div id=\"score-display\" class=\"bg-indigo-700 px-3 py-1 rounded-full text-sm font-semibold border border-indigo-500\">\n                Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">7</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container (Mobile First: Single Column Fluid) -->\n    <main class=\"w-full max-w-3xl mx-auto p-3 md:p-6 flex-grow flex flex-col gap-6\">\n\n        <!-- Reference Section (Exercise 3 Text with specific Bolds) -->\n        <section class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 md:p-6\">\n            <h2 class=\"text-sm font-bold uppercase tracking-wider text-indigo-600 mb-2\">Reference Text</h2>\n            <p class=\"text-xs text-slate-500 mb-4\">Read Diane's opinion. Notice the bold phrases which correspond to the opposites in the interactive exercise below.</p>\n            <div class=\"bg-slate-50 p-4 rounded-lg text-sm leading-relaxed text-slate-700 border border-slate-100\">\n                <p>\n                    <strong>I think</strong> computers are amazing. We 've had one in our family for almost 20 years – since I was about 12. At that time we didn't use it for anything serious – <strong>no one</strong> did. My sister and I <strong>usually</strong> played games on it. Then at university I <strong>always</strong> wrote my essays on it and I soon realised <strong>there are lots of</strong> things a computer can help with. Since then I haven't been able to leave it alone! <strong>All of</strong> my friends call me with their computer problems. I don't get paid or anything – I just do it as a favour. I 'm helping two of my friends with their computers at the moment – they're broken. <strong>Neither of them</strong> know anything about computers, but they know how to take me out for a meal!\n                </p>\n            </div>\n        </section>\n\n        <!-- Interactive Exercise Section (Exercise 4) -->\n        <section class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 md:p-6 flex flex-col gap-4\">\n            <div>\n                <h2 class=\"text-base md:text-lg font-bold text-slate-900\">4. Match phrases with their opposites</h2>\n                <p class=\"text-sm text-slate-600 mt-1\">Select the correct opposite phrase from the text above for each item.</p>\n            </div>\n\n            <div id=\"activity-form\" class=\"flex flex-col gap-3 mt-2\">\n                <!-- Item 1 (Example given) -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200 gap-2\">\n                    <span class=\"text-sm font-medium text-slate-700\">1. There aren't many</span>\n                    <div class=\"bg-slate-200 text-slate-700 px-3 py-2 rounded-lg text-sm font-medium italic touch-target flex items-center\">\n                        there are lots of (Example)\n                    </div>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200 gap-2 item-row\" data-index=\"2\">\n                    <label for=\"select-2\" class=\"text-sm font-medium text-slate-700\">2. everyone</label>\n                    <select id=\"select-2\" class=\"answer-select w-full sm:w-64 bg-white border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                        <option value=\"\">-- Choose opposite --</option>\n                        <option value=\"no one\">no one</option>\n                        <option value=\"Neither of them\">Neither of them</option>\n                        <option value=\"usually\">usually</option>\n                        <option value=\"always\">always</option>\n                        <option value=\"All of\">All of</option>\n                        <option value=\"I think\">I think</option>\n                    </select>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200 gap-2 item-row\" data-index=\"3\">\n                    <label for=\"select-3\" class=\"text-sm font-medium text-slate-700\">3. Both of them</label>\n                    <select id=\"select-3\" class=\"answer-select w-full sm:w-64 bg-white border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                        <option value=\"\">-- Choose opposite --</option>\n                        <option value=\"no one\">no one</option>\n                        <option value=\"Neither of them\">Neither of them</option>\n                        <option value=\"usually\">usually</option>\n                        <option value=\"always\">always</option>\n                        <option value=\"All of\">All of</option>\n                        <option value=\"I think\">I think</option>\n                    </select>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200 gap-2 item-row\" data-index=\"4\">\n                    <label for=\"select-4\" class=\"text-sm font-medium text-slate-700\">4. hardly ever</label>\n                    <select id=\"select-4\" class=\"answer-select w-full sm:w-64 bg-white border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                        <option value=\"\">-- Choose opposite --</option>\n                        <option value=\"no one\">no one</option>\n                        <option value=\"Neither of them\">Neither of them</option>\n                        <option value=\"usually\">usually</option>\n                        <option value=\"always\">always</option>\n                        <option value=\"All of\">All of</option>\n                        <option value=\"I think\">I think</option>\n                    </select>\n                </div>\n\n                <!-- Item 5 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200 gap-2 item-row\" data-index=\"5\">\n                    <label for=\"select-5\" class=\"text-sm font-medium text-slate-700\">5. never</label>\n                    <select id=\"select-5\" class=\"answer-select w-full sm:w-64 bg-white border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                        <option value=\"\">-- Choose opposite --</option>\n                        <option value=\"no one\">no one</option>\n                        <option value=\"Neither of them\">Neither of them</option>\n                        <option value=\"usually\">usually</option>\n                        <option value=\"always\">always</option>\n                        <option value=\"All of\">All of</option>\n                        <option value=\"I think\">I think</option>\n                    </select>\n                </div>\n\n                <!-- Item 6 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200 gap-2 item-row\" data-index=\"6\">\n                    <label for=\"select-6\" class=\"text-sm font-medium text-slate-700\">6. None of</label>\n                    <select id=\"select-6\" class=\"answer-select w-full sm:w-64 bg-white border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                        <option value=\"\">-- Choose opposite --</option>\n                        <option value=\"no one\">no one</option>\n                        <option value=\"Neither of them\">Neither of them</option>\n                        <option value=\"usually\">usually</option>\n                        <option value=\"always\">always</option>\n                        <option value=\"All of\">All of</option>\n                        <option value=\"I think\">I think</option>\n                    </select>\n                </div>\n\n                <!-- Item 7 -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200 gap-2 item-row\" data-index=\"7\">\n                    <label for=\"select-7\" class=\"text-sm font-medium text-slate-700\">7. I don't think</label>\n                    <select id=\"select-7\" class=\"answer-select w-full sm:w-64 bg-white border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 touch-target\">\n                        <option value=\"\">-- Choose opposite --</option>\n                        <option value=\"no one\">no one</option>\n                        <option value=\"Neither of them\">Neither of them</option>\n                        <option value=\"usually\">usually</option>\n                        <option value=\"always\">always</option>\n                        <option value=\"All of\">All of</option>\n                        <option value=\"I think\">I think</option>\n                    </select>\n                </div>\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"flex flex-col sm:flex-row gap-3 mt-4\">\n                <button id=\"check-btn\" class=\"flex-1 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold py-3 px-6 rounded-xl transition-colors touch-target shadow-sm\">\n                    Check Answers\n                </button>\n                <button id=\"reset-btn\" class=\"bg-slate-200 hover:bg-slate-300 active:bg-slate-400 text-slate-700 font-semibold py-3 px-6 rounded-xl transition-colors touch-target\">\n                    Reset\n                </button>\n            </div>\n        </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-4 text-xs text-slate-400\">\n        Interactive English Learning Activity &bull; Responsive Design\n    </footer>\n\n    <!-- Script Logic -->\n    <script>\n        const answerKey = {\n            2: \"no one\",\n            3: \"Neither of them\",\n            4: \"usually\",\n            5: \"always\",\n            6: \"All of\",\n            7: \"I think\"\n        };\n\n        const totalItems = 6; // Items 2 through 7 (6 questions total)\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const currentScoreEl = document.getElementById('current-score');\n        const totalScoreEl = document.getElementById('total-score');\n        \n        totalScoreEl.textContent = totalItems;\n\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n            const selects = document.querySelectorAll('.answer-select');\n\n            selects.forEach(select => {\n                const rowIndex = select.closest('.item-row').dataset.index;\n                const userVal = select.value.trim();\n                const correctVal = answerKey[rowIndex];\n\n                // Reset styles\n                select.classList.remove('border-emerald-500', 'bg-emerald-50', 'border-rose-500', 'bg-rose-50');\n\n                if (userVal === \"\") {\n                    select.classList.add('border-slate-300');\n                } else if (userVal.toLowerCase() === correctVal.toLowerCase()) {\n                    select.classList.add('border-emerald-500', 'bg-emerald-50');\n                    correctCount++;\n                } else {\n                    select.classList.add('border-rose-500', 'bg-rose-50');\n                }\n            });\n\n            currentScoreEl.textContent = correctCount;\n\n            // Post message score to parent container/LMS\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalItems\n            }, '*');\n        });\n\n        resetBtn.addEventListener('click', () => {\n            const selects = document.querySelectorAll('.answer-select');\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('border-emerald-500', 'bg-emerald-50', 'border-rose-500', 'bg-rose-50');\n                select.classList.add('border-slate-300');\n            });\n            currentScoreEl.textContent = \"0\";\n\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: 0,\n                total: totalItems\n            }, '*');\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793070546203,
      "title": "Actividad IA #6",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Transforming Sentences - Positive/Negative</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom styles for touch targets and transitions */\n        .touch-target {\n            min-height: 48px;\n        }\n        input:focus {\n            font-size: 16px !important; /* Prevent iOS zoom */\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col items-center justify-between\">\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-3xl p-4 md:p-6 my-auto\">\n        \n        <!-- Header Card -->\n        <header class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5 mb-6\">\n            <div class=\"flex items-center gap-3 mb-2\">\n                <span class=\"bg-indigo-600 text-white text-sm font-bold px-3 py-1 rounded-full\">5</span>\n                <h1 class=\"text-lg md:text-xl font-bold text-slate-900\">Polarity Transformation</h1>\n            </div>\n            <p class=\"text-sm md:text-base text-slate-600\">\n                Make these sentences positive or negative by changing the <span class=\"underline decoration-indigo-500 font-semibold\">underlined words</span>. Type the complete new sentence.\n            </p>\n            <div class=\"mt-3 text-xs md:text-sm bg-indigo-50 text-indigo-700 p-3 rounded-xl border border-indigo-100 flex items-center justify-between\">\n                <span>Example 1: <span class=\"italic\">I hardly ever send emails from home.</span></span>\n                <span class=\"font-semibold hidden sm:inline\">➜ I usually send...</span>\n            </div>\n        </header>\n\n        <!-- Quiz Form / List -->\n        <form id=\"quiz-form\" class=\"space-y-4\">\n            \n            <!-- Item 2 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">2</span> He <span class=\"underline decoration-indigo-500 font-medium\">thinks</span> the computer's got a virus.\n                </div>\n                <input type=\"text\" data-id=\"2\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">3</span> I <span class=\"underline decoration-indigo-500 font-medium\">understood everything</span> he said.\n                </div>\n                <input type=\"text\" data-id=\"3\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">4</span> We <span class=\"underline decoration-indigo-500 font-medium\">never used</span> our computer to do serious things.\n                </div>\n                <input type=\"text\" data-id=\"4\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">5</span> <span class=\"underline decoration-indigo-500 font-medium\">There aren't many</span> computers at my school.\n                </div>\n                <input type=\"text\" data-id=\"5\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">6</span> <span class=\"underline decoration-indigo-500 font-medium\">Joe's repaired</span> my laptop.\n                </div>\n                <input type=\"text\" data-id=\"6\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">7</span> <span class=\"underline decoration-indigo-500 font-medium\">None of</span> my colleagues can type quickly.\n                </div>\n                <input type=\"text\" data-id=\"7\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">8</span> <span class=\"underline decoration-indigo-500 font-medium\">Neither of</span> our parents can use computers.\n                </div>\n                <input type=\"text\" data-id=\"8\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Item 9 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">9</span> He works with computers all day so he <span class=\"underline decoration-indigo-500 font-medium\">doesn't need</span> one at home.\n                </div>\n                <input type=\"text\" data-id=\"9\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Item 10 -->\n            <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-4 md:p-5 transition-all\">\n                <div class=\"text-sm md:text-base text-slate-700 mb-2\">\n                    <span class=\"font-bold text-indigo-600 mr-2\">10</span> We <span class=\"underline decoration-indigo-500 font-medium\">aren't using</span> the latest software.\n                </div>\n                <input type=\"text\" data-id=\"10\" placeholder=\"Type the changed sentence...\" \n                    class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-base outline-none focus:border-indigo-500 focus:bg-white touch-target transition-all\">\n                <div class=\"feedback-container mt-2 hidden text-sm font-medium\"></div>\n            </div>\n\n            <!-- Action Controls -->\n            <div class=\"flex flex-col sm:flex-row gap-3 pt-4\">\n                <button type=\"button\" id=\"check-btn\" \n                    class=\"flex-1 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-semibold py-3 px-6 rounded-xl shadow-md transition-all touch-target flex items-center justify-center gap-2\">\n                    Check Answers\n                </button>\n                <button type=\"button\" id=\"reset-btn\" \n                    class=\"bg-slate-200 hover:bg-slate-300 active:scale-[0.99] text-slate-700 font-semibold py-3 px-6 rounded-xl transition-all touch-target flex items-center justify-center gap-2\">\n                    Reset\n                </button>\n            </div>\n        </form>\n\n        <!-- Score Display Card -->\n        <div id=\"score-card\" class=\"hidden mt-6 bg-slate-900 text-white p-5 rounded-2xl text-center shadow-lg animate-fade-in\">\n            <h3 class=\"text-base font-medium text-slate-400\">Activity Score</h3>\n            <div id=\"score-text\" class=\"text-3xl font-extrabold my-1 text-indigo-400\">0 / 9</div>\n            <p id=\"score-message\" class=\"text-sm text-slate-300\"></p>\n        </div>\n\n    </main>\n\n    <!-- Footer Status -->\n    <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 mt-8\">\n        Interactive Language Learning Module &bull; ELT Responsive Content\n    </footer>\n\n    <!-- Script Logic -->\n    <script>\n        // Answer Key mappings (Normalized: lowercase, trim, remove punctuation at the end)\n        const answerKey = {\n            \"2\": [\"he doesn't think the computer's got a virus\", \"he does not think the computer's got a virus\", \"he doesn't think the computers got a virus\"],\n            \"3\": [\"i didn't understand anything he said\", \"i did not understand anything he said\"],\n            \"4\": [\"we always used our computer to do serious things\"],\n            \"5\": [\"there are lots of computers at my school\", \"there are a lot of computers at my school\"],\n            \"6\": [\"joe hasn't repaired my laptop\", \"joe has not repaired my laptop\"],\n            \"7\": [\"all of my colleagues can type quickly\"],\n            \"8\": [\"both of our parents can use computers\"],\n            \"9\": [\"he works with computers all day so he needs one at home\"],\n            \"10\": [\"we are using the latest software\", \"we're using the latest software\"]\n        };\n\n        const quizForm = document.getElementById('quiz-form');\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const scoreCard = document.getElementById('score-card');\n        const scoreText = document.getElementById('score-text');\n        const scoreMessage = document.getElementById('score-message');\n\n        function normalizeText(text) {\n            return text.toLowerCase().trim().replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\").replace(/\\s{2,}/g,\" \");\n        }\n\n        checkBtn.addEventListener('click', () => {\n            let correctCount = 0;\n            const totalCount = Object.keys(answerKey).length;\n\n            const inputs = quizForm.querySelectorAll('input[data-id]');\n            \n            inputs.forEach(input => {\n                const id = input.getAttribute('data-id');\n                const userVal = normalizeText(input.value);\n                const feedbackDiv = input.nextElementSibling;\n                const parentBox = input.parentElement;\n\n                feedbackDiv.classList.remove('hidden');\n                \n                // Check if user answer matches any valid variation\n                const validOptions = answerKey[id];\n                const isCorrect = validOptions.some(opt => normalizeText(opt) === userVal);\n\n                input.classList.remove('border-slate-300', 'border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n                \n                if (userVal === \"\") {\n                    input.classList.add('border-rose-500', 'bg-rose-50');\n                    feedbackDiv.textContent = `⚠️ Please enter an answer. Correct: \"${validOptions[0]}\"`;\n                    feedbackDiv.className = \"feedback-container mt-2 text-sm font-medium text-rose-600\";\n                } else if (isCorrect) {\n                    input.classList.add('border-emerald-500', 'bg-emerald-50');\n                    feedbackDiv.textContent = \"✓ Correct!\";\n                    feedbackDiv.className = \"feedback-container mt-2 text-sm font-medium text-emerald-600\";\n                    correctCount++;\n                } else {\n                    input.classList.add('border-rose-500', 'bg-rose-50');\n                    feedbackDiv.textContent = `✗ Incorrect. Expected: \"${validOptions[0]}\"`;\n                    feedbackDiv.className = \"feedback-container mt-2 text-sm font-medium text-rose-600\";\n                }\n            });\n\n            // Show Score Card\n            scoreCard.classList.remove('hidden');\n            scoreText.textContent = `${correctCount} / ${totalCount}`;\n            \n            if (correctCount === totalCount) {\n                scoreMessage.textContent = \"Fantastic! Outstanding grammar precision!\";\n            } else if (correctCount >= totalCount / 2) {\n                scoreMessage.textContent = \"Good job! Review the incorrect answers and try again.\";\n            } else {\n                scoreMessage.textContent = \"Keep practicing! Pay attention to auxiliary verbs and opposites.\";\n            }\n\n            // Post message to parent container framework\n            window.parent.postMessage({ \n                type: 'ACTIVITY_SCORE', \n                score: correctCount, \n                total: totalCount \n            }, '*');\n\n            // Smooth scroll to score summary on mobile\n            scoreCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n        });\n\n        resetBtn.addEventListener('click', () => {\n            const inputs = quizForm.querySelectorAll('input[data-id]');\n            inputs.forEach(input => {\n                input.value = \"\";\n                input.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n                input.classList.add('border-slate-300', 'bg-slate-50');\n                const feedbackDiv = input.nextElementSibling;\n                feedbackDiv.classList.add('hidden');\n                feedbackDiv.textContent = \"\";\n            });\n            scoreCard.classList.add('hidden');\n            window.scrollTo({ top: 0, behavior: 'smooth' });\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793070596247,
      "title": "Actividad IA #7",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Review: Verb Forms - ELT Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom animations & feedback styling */\n        .shake {\n            animation: shake 0.42s cubic-bezier(.36,.07,.19,.97) both;\n        }\n        @keyframes shake {\n            10%, 90% { transform: translate3d(-1px, 0, 0); }\n            20%, 80% { transform: translate3d(2px, 0, 0); }\n            30%, 50%, 70% { transform: translate3d(-3px, 0, 0); }\n            40%, 60% { transform: translate3d(3px, 0, 0); }\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col justify-between antialiased selection:bg-indigo-100 selection:text-indigo-700\">\n\n    <!-- Header Section -->\n    <header class=\"w-full bg-white border-b border-slate-200 sticky top-0 z-20 shadow-xs\">\n        <div class=\"max-w-3xl mx-auto px-4 py-3 flex items-center justify-between\">\n            <div>\n                <span class=\"text-xs font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full\">Grammar Review</span>\n                <h1 class=\"text-lg md:text-xl font-bold text-slate-900 mt-1\">Review: Verb Forms</h1>\n            </div>\n            <div id=\"score-badge\" class=\"hidden items-center bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-full text-sm font-medium text-slate-700\">\n                Score: <span id=\"current-score\" class=\"font-bold text-indigo-600 ml-1\">0</span>/<span id=\"total-score\">10</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content Area -->\n    <main class=\"w-full max-w-3xl mx-auto p-4 md:p-6 flex-grow\">\n        \n        <!-- Instruction Card -->\n        <div class=\"bg-indigo-900 text-white p-4 md:p-5 rounded-2xl shadow-sm mb-6 flex items-start gap-3\">\n            <div class=\"bg-indigo-800 p-2 rounded-xl text-indigo-200 shrink-0 mt-0.5\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z\" />\n                </svg>\n            </div>\n            <div>\n                <h2 class=\"font-bold text-base md:text-lg\">Correct the mistake in each sentence</h2>\n                <p class=\"text-xs md:text-sm text-indigo-200 mt-1\">Tap each input box to type the corrected word or phrase. Pay attention to verb tenses, auxiliaries, and state verbs.</p>\n            </div>\n        </div>\n\n        <!-- Activity Form / List of Items -->\n        <form id=\"quiz-form\" class=\"space-y-4\" onsubmit=\"event.preventDefault();\">\n            \n            <!-- Item 1 (Example in book solved, let's make it interactive as shown) -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-1\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">1.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">My parents</span>\n                        <span class=\"relative inline-block\">\n                            <span class=\"line-through text-red-500 font-medium\">drives</span>\n                        </span>\n                        <span class=\"text-slate-700\">me crazy at times. (Correction:</span>\n                        <input type=\"text\" data-index=\"1\" placeholder=\"type correction...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white w-40 min-h-[42px] transition-all\">\n                        <span class=\"text-slate-700\">)</span>\n                    </div>\n                </div>\n                <div id=\"feedback-1\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-2\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">2.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">I'm going swimming about three times a week.</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"2\" placeholder=\"Rewrite full sentence or corrected part...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-2\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-3\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">3.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">Who does works with you?</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"3\" placeholder=\"Rewrite corrected sentence...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-3\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-4\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">4.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">How many countries have you gone to?</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"4\" placeholder=\"Rewrite corrected sentence...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-4\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-5\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">5.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">In the past I walk to school.</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"5\" placeholder=\"Rewrite corrected sentence...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-5\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-6\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">6.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">I am think you are correct.</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"6\" placeholder=\"Rewrite corrected sentence...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-6\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-7\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">7.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">I'm playing a lot of tennis in my free time.</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"7\" placeholder=\"Rewrite corrected sentence...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-7\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 8 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-8\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">8.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">I live in London for three years and I love it.</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"8\" placeholder=\"Rewrite corrected sentence...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-8\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 9 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-9\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">9.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">I've been to Brazil last year.</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"9\" placeholder=\"Rewrite corrected sentence...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-9\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Item 10 -->\n            <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-xs transition-all duration-200\" id=\"item-container-10\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"font-bold text-slate-400 text-sm mt-2 shrink-0\">10.</span>\n                    <div class=\"flex-grow text-base flex flex-wrap items-center gap-2 leading-relaxed\">\n                        <span class=\"text-slate-700\">Who does they work with?</span>\n                        <div class=\"w-full mt-2\">\n                            <input type=\"text\" data-index=\"10\" placeholder=\"Rewrite corrected sentence...\" autocomplete=\"off\" autocapitalize=\"off\" class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-base md:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white min-h-[42px] transition-all\">\n                        </div>\n                    </div>\n                </div>\n                <div id=\"feedback-10\" class=\"mt-2 text-xs font-medium hidden pl-7\"></div>\n            </div>\n\n            <!-- Action Controls -->\n            <div class=\"pt-4 flex flex-col sm:flex-row gap-3\">\n                <button type=\"button\" onclick=\"checkAnswers()\" class=\"flex-1 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold py-3 px-6 rounded-xl shadow-md min-h-[48px] flex items-center justify-center gap-2 transition-all cursor-pointer\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                    Check Answers\n                </button>\n                <button type=\"button\" onclick=\"resetActivity()\" class=\"bg-white border border-slate-300 hover:bg-slate-100 active:bg-slate-200 text-slate-700 font-semibold py-3 px-6 rounded-xl min-h-[48px] flex items-center justify-center gap-2 transition-all cursor-pointer\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    Reset\n                </button>\n            </div>\n        </form>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full border-t border-slate-200 py-4 text-center text-xs text-slate-500 bg-white mt-8\">\n        Interactive ELT Micro-App &bull; Mobile-First Touch Optimized\n    </footer>\n\n    <!-- JavaScript Logic & Validation -->\n    <script>\n        // Answer Key based on provided textbook snippets and grammatical rules\n        const answerKey = {\n            1: [\"drive\"],\n            2: [\n                \"i go swimming about three times a week\", \n                \"i go swimming\", \n                \"i go swimming...\"\n            ],\n            3: [\n                \"who works with you\", \n                \"who works with you?\"\n            ],\n            4: [\n                \"how many countries have you been to\", \n                \"how many countries have you been to?\"\n            ],\n            5: [\n                \"in the past i walked to school\", \n                \"i walked to school\", \n                \"in the past i walked to school.\"\n            ],\n            6: [\n                \"i think you are correct\", \n                \"i think you are correct.\"\n            ],\n            7: [\n                \"i play a lot of tennis in my free time\", \n                \"i play a lot\", \n                \"i play a lot of tennis\"\n            ],\n            8: [\n                \"i've lived in london for three years and i love it\", \n                \"i have lived in london for three years and i love it\",\n                \"ive lived in london for three years and i love it\"\n            ],\n            9: [\n                \"i went to brazil last year\", \n                \"i went to brazil last year.\"\n            ],\n            10: [\n                \"who do they work with\", \n                \"who do they work with?\", \n                \"who does he work with?\", \n                \"who does she work with?\",\n                \"who does he work with\",\n                \"who does she work with\"\n            ]\n        };\n\n        function normalizeText(str) {\n            return str.toLowerCase().trim().replace(/[.,?!]/g, \"\").replace(/\\s+/g, \" \");\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalCount = Object.keys(answerKey).length;\n\n            for (let i = 1; i <= totalCount; i++) {\n                const input = document.querySelector(`input[data-index=\"${i}\"]`);\n                const container = document.getElementById(`item-container-${i}`);\n                const feedback = document.getElementById(`feedback-${i}`);\n                \n                const userVal = normalizeText(input.value);\n                const allowedAnswers = answerKey[i];\n\n                // Reset classes\n                container.classList.remove('border-emerald-500', 'bg-emerald-50/30', 'border-red-500', 'bg-red-50/30', 'shake');\n                input.classList.remove('border-emerald-500', 'text-emerald-700', 'bg-emerald-50', 'border-red-500', 'text-red-700', 'bg-red-50');\n\n                if (userVal === \"\") {\n                    container.classList.add('border-red-300');\n                    feedback.textContent = \"Please enter an answer.\";\n                    feedback.className = \"mt-2 text-xs font-medium text-amber-600 block pl-7\";\n                    continue;\n                }\n\n                let isCorrect = allowedAnswers.some(ans => userVal === normalizeText(ans));\n\n                if (isCorrect) {\n                    correctCount++;\n                    container.classList.add('border-emerald-500', 'bg-emerald-50/30');\n                    input.classList.add('border-emerald-500', 'text-emerald-700', 'bg-emerald-50');\n                    feedback.textContent = \"Correct! Great job.\";\n                    feedback.className = \"mt-2 text-xs font-medium text-emerald-600 block pl-7\";\n                } else {\n                    container.classList.add('border-red-500', 'bg-red-50/30', 'shake');\n                    input.classList.add('border-red-500', 'text-red-700', 'bg-red-50');\n                    feedback.textContent = `Incorrect. Hint: Check verb form/tense. (Example valid: \"${allowedAnswers[0]}\")`;\n                    feedback.className = \"mt-2 text-xs font-medium text-red-600 block pl-7\";\n                }\n            }\n\n            // Display Score Badge\n            const scoreBadge = document.getElementById('score-badge');\n            const currentScoreEl = document.getElementById('current-score');\n            currentScoreEl.textContent = correctCount;\n            scoreBadge.classList.remove('hidden');\n            scoreBadge.classList.add('flex');\n\n            // Post score to parent window\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        }\n\n        function resetActivity() {\n            const totalCount = Object.keys(answerKey).length;\n            for (let i = 1; i <= totalCount; i++) {\n                const input = document.querySelector(`input[data-index=\"${i}\"]`);\n                const container = document.getElementById(`item-container-${i}`);\n                const feedback = document.getElementById(`feedback-${i}`);\n\n                input.value = \"\";\n                container.classList.remove('border-emerald-500', 'bg-emerald-50/30', 'border-red-500', 'bg-red-50/30', 'shake', 'border-red-300');\n                input.classList.remove('border-emerald-500', 'text-emerald-700', 'bg-emerald-50', 'border-red-500', 'text-red-700', 'bg-red-50');\n                feedback.classList.add('hidden');\n                feedback.textContent = \"\";\n            }\n\n            const scoreBadge = document.getElementById('score-badge');\n            scoreBadge.classList.add('hidden');\n            scoreBadge.classList.remove('flex');\n        }\n    </script>\n</body>\n</html>"
    }
  ]
}