{
  "version": "2.0",
  "title": "Int Unit Review",
  "updatedAt": "2026-10-30T14:15:23.554Z",
  "slides": [
    {
      "id": 1793366878933,
      "title": "Complete Questions - Weekend Activities",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Complete Questions - Weekend Activities</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom smooth transitions and touch optimizations */\n    .touch-target {\n      min-height: 44px;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen py-6 px-3 sm:px-6\">\n\n  <!-- Sticky Top Bar for Metrics & Status -->\n  <div class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-2.5 px-4 border-b w-full max-w-4xl mx-auto mb-6 shadow-sm rounded-xl flex flex-wrap items-center justify-between gap-3\">\n    <div class=\"flex items-center gap-2\">\n      <span class=\"bg-indigo-100 text-indigo-800 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider\">Grammar</span>\n      <h1 class=\"text-sm sm:text-base font-bold text-slate-700\">Last weekend did you...</h1>\n    </div>\n    <div class=\"flex items-center gap-3\">\n      <div id=\"score-display\" class=\"text-sm font-semibold text-slate-600\">\n        Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">8</span>\n      </div>\n      <button id=\"check-btn\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors touch-target shadow-sm cursor-pointer\">\n        Check Answers\n      </button>\n      <button id=\"reset-btn\" class=\"bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-medium px-3 py-2 rounded-lg transition-colors touch-target cursor-pointer\">\n        Reset\n      </button>\n    </div>\n  </div>\n\n  <!-- Main Container (Strictly w-full max-w-4xl mx-auto as requested) -->\n  <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm p-4 sm:p-6 md:p-8\">\n    \n    <!-- Instructions & Word Bank Header -->\n    <header class=\"mb-6 pb-4 border-b border-slate-100\">\n      <div class=\"flex items-start gap-3\">\n        <span class=\"flex-shrink-0 bg-slate-900 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">1</span>\n        <div>\n          <h2 class=\"text-base sm:text-lg font-bold text-slate-900 mb-1\">\n            a) Complete questions 1–8 with these verbs.\n          </h2>\n          <p class=\"text-xs sm:text-sm text-slate-500 mb-4\">\n            Select the correct verb for each question based on the activity.\n          </p>\n\n          <!-- Word Bank Display -->\n          <div class=\"bg-slate-50 border border-slate-200 p-3 sm:p-4 rounded-xl\">\n            <span class=\"text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-2\">Word Bank</span>\n            <div class=\"flex flex-wrap gap-2 text-sm font-medium text-indigo-900\">\n              <span class=\"bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs line-through text-slate-400\">do <span class=\"text-[10px] bg-slate-100 px-1 rounded ml-1 text-slate-500\">used</span></span>\n              <span class=\"bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs\">have</span>\n              <span class=\"bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs\">go to</span>\n              <span class=\"bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs\">meet up</span>\n              <span class=\"bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs\">go</span>\n              <span class=\"bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs\">tidy up</span>\n              <span class=\"bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs\">chat</span>\n              <span class=\"bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs\">visit</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </header>\n\n    <!-- Activity Form / Questions -->\n    <section>\n      <div class=\"text-sm font-bold text-slate-800 mb-4 bg-slate-100/70 p-2.5 rounded-lg inline-block\">\n        Last weekend did you <span class=\"text-indigo-600\">...</span> ?\n      </div>\n\n      <form id=\"quiz-form\" class=\"space-y-4\">\n        \n        <!-- Question 1 (Pre-filled / Answered as per OCR reference) -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-slate-50 border border-slate-200/80\">\n          <div class=\"flex items-center gap-3 text-sm sm:text-base\">\n            <span class=\"font-bold text-slate-500 w-5\">1</span>\n            <div class=\"flex items-center flex-wrap gap-2\">\n              <input type=\"text\" value=\"do\" disabled data-answer=\"do\" class=\"w-28 bg-slate-200/70 border border-slate-300 rounded-lg px-3 py-1.5 text-slate-600 font-medium text-sm sm:text-base cursor-not-allowed\">\n              <span>any exercise?</span>\n            </div>\n          </div>\n          <span class=\"text-xs font-medium text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md self-start sm:self-center\">Example (Done)</span>\n        </div>\n\n        <!-- Question 2 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-all\">\n          <div class=\"flex items-center gap-3 text-sm sm:text-base\">\n            <span class=\"font-bold text-slate-500 w-5\">2</span>\n            <div class=\"flex items-center flex-wrap gap-2\">\n              <select data-answer=\"go\" class=\"activity-input w-36 sm:w-40 bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-800 font-medium text-sm sm:text-base touch-target focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n                <option value=\"\">-- select verb --</option>\n                <option value=\"have\">have</option>\n                <option value=\"go\">go</option>\n                <option value=\"go to\">go to</option>\n                <option value=\"meet up\">meet up</option>\n                <option value=\"tidy up\">tidy up</option>\n                <option value=\"chat\">chat</option>\n                <option value=\"visit\">visit</option>\n              </select>\n              <span>clubbing?</span>\n            </div>\n          </div>\n          <div class=\"feedback-icon hidden text-sm font-semibold px-2.5 py-1 rounded-md\"></div>\n        </div>\n\n        <!-- Question 3 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-all\">\n          <div class=\"flex items-center gap-3 text-sm sm:text-base\">\n            <span class=\"font-bold text-slate-500 w-5\">3</span>\n            <div class=\"flex items-center flex-wrap gap-2\">\n              <select data-answer=\"tidy up\" class=\"activity-input w-36 sm:w-40 bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-800 font-medium text-sm sm:text-base touch-target focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n                <option value=\"\">-- select verb --</option>\n                <option value=\"have\">have</option>\n                <option value=\"go\">go</option>\n                <option value=\"go to\">go to</option>\n                <option value=\"meet up\">meet up</option>\n                <option value=\"tidy up\">tidy up</option>\n                <option value=\"chat\">chat</option>\n                <option value=\"visit\">visit</option>\n              </select>\n              <span>the house/flat?</span>\n            </div>\n          </div>\n          <div class=\"feedback-icon hidden text-sm font-semibold px-2.5 py-1 rounded-md\"></div>\n        </div>\n\n        <!-- Question 4 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-all\">\n          <div class=\"flex items-center gap-3 text-sm sm:text-base\">\n            <span class=\"font-bold text-slate-500 w-5\">4</span>\n            <div class=\"flex items-center flex-wrap gap-2\">\n              <select data-answer=\"go to\" class=\"activity-input w-36 sm:w-40 bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-800 font-medium text-sm sm:text-base touch-target focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n                <option value=\"\">-- select verb --</option>\n                <option value=\"have\">have</option>\n                <option value=\"go\">go</option>\n                <option value=\"go to\">go to</option>\n                <option value=\"meet up\">meet up</option>\n                <option value=\"tidy up\">tidy up</option>\n                <option value=\"chat\">chat</option>\n                <option value=\"visit\">visit</option>\n              </select>\n              <span>any exhibitions?</span>\n            </div>\n          </div>\n          <div class=\"feedback-icon hidden text-sm font-semibold px-2.5 py-1 rounded-md\"></div>\n        </div>\n\n        <!-- Question 5 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-all\">\n          <div class=\"flex items-center gap-3 text-sm sm:text-base\">\n            <span class=\"font-bold text-slate-500 w-5\">5</span>\n            <div class=\"flex items-center flex-wrap gap-2\">\n              <select data-answer=\"visit\" class=\"activity-input w-36 sm:w-40 bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-800 font-medium text-sm sm:text-base touch-target focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n                <option value=\"\">-- select verb --</option>\n                <option value=\"have\">have</option>\n                <option value=\"go\">go</option>\n                <option value=\"go to\">go to</option>\n                <option value=\"meet up\">meet up</option>\n                <option value=\"tidy up\">tidy up</option>\n                <option value=\"chat\">chat</option>\n                <option value=\"visit\">visit</option>\n              </select>\n              <span>relatives?</span>\n            </div>\n          </div>\n          <div class=\"feedback-icon hidden text-sm font-semibold px-2.5 py-1 rounded-md\"></div>\n        </div>\n\n        <!-- Question 6 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-all\">\n          <div class=\"flex items-center gap-3 text-sm sm:text-base\">\n            <span class=\"font-bold text-slate-500 w-5\">6</span>\n            <div class=\"flex items-center flex-wrap gap-2\">\n              <select data-answer=\"chat\" class=\"activity-input w-36 sm:w-40 bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-800 font-medium text-sm sm:text-base touch-target focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n                <option value=\"\">-- select verb --</option>\n                <option value=\"have\">have</option>\n                <option value=\"go\">go</option>\n                <option value=\"go to\">go to</option>\n                <option value=\"meet up\">meet up</option>\n                <option value=\"tidy up\">tidy up</option>\n                <option value=\"chat\">chat</option>\n                <option value=\"visit\">visit</option>\n              </select>\n              <span>to friends online?</span>\n            </div>\n          </div>\n          <div class=\"feedback-icon hidden text-sm font-semibold px-2.5 py-1 rounded-md\"></div>\n        </div>\n\n        <!-- Question 7 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-all\">\n          <div class=\"flex items-center gap-3 text-sm sm:text-base\">\n            <span class=\"font-bold text-slate-500 w-5\">7</span>\n            <div class=\"flex items-center flex-wrap gap-2\">\n              <select data-answer=\"have\" class=\"activity-input w-36 sm:w-40 bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-800 font-medium text-sm sm:text-base touch-target focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n                <option value=\"\">-- select verb --</option>\n                <option value=\"have\">have</option>\n                <option value=\"go\">go</option>\n                <option value=\"go to\">go to</option>\n                <option value=\"meet up\">meet up</option>\n                <option value=\"tidy up\">tidy up</option>\n                <option value=\"chat\">chat</option>\n                <option value=\"visit\">visit</option>\n              </select>\n              <span>a lie-in?</span>\n            </div>\n          </div>\n          <div class=\"feedback-icon hidden text-sm font-semibold px-2.5 py-1 rounded-md\"></div>\n        </div>\n\n        <!-- Question 8 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-all\">\n          <div class=\"flex items-center gap-3 text-sm sm:text-base\">\n            <span class=\"font-bold text-slate-500 w-5\">8</span>\n            <div class=\"flex items-center flex-wrap gap-2\">\n              <select data-answer=\"meet up\" class=\"activity-input w-36 sm:w-40 bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-800 font-medium text-sm sm:text-base touch-target focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n                <option value=\"\">-- select verb --</option>\n                <option value=\"have\">have</option>\n                <option value=\"go\">go</option>\n                <option value=\"go to\">go to</option>\n                <option value=\"meet up\">meet up</option>\n                <option value=\"tidy up\">tidy up</option>\n                <option value=\"chat\">chat</option>\n                <option value=\"visit\">visit</option>\n              </select>\n              <span>with friends?</span>\n            </div>\n          </div>\n          <div class=\"feedback-icon hidden text-sm font-semibold px-2.5 py-1 rounded-md\"></div>\n        </div>\n\n      </form>\n    </section>\n\n    <!-- Footer Note (Part B context from prompt/OCR) -->\n    <footer class=\"mt-8 pt-4 border-t border-slate-100 text-xs text-slate-400\">\n      <p><strong class=\"text-slate-600\">b)</strong> Work in pairs. Take turns to ask and answer the questions.</p>\n    </footer>\n\n  </main>\n\n  <!-- Script for Interactivity, Analytics, & Evaluation Contract -->\n  <script>\n    // Mandatory Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Grammar',\n      skill: 'past_simple_questions',\n      maxScore: 8\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const inputs = document.querySelectorAll('.activity-input');\n      const checkBtn = document.getElementById('check-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const currentScoreEl = document.getElementById('current-score');\n      const totalScoreEl = document.getElementById('total-score');\n      \n      totalScoreEl.textContent = window.ACTIVITY_METRICS.maxScore;\n\n      function checkAnswers() {\n        let correctCount = 1; // Item 1 is pre-filled and correct\n\n        inputs.forEach(input => {\n          const userAnswer = input.value.trim().toLowerCase();\n          const correctAnswer = input.getAttribute('data-answer').toLowerCase();\n          const parentRow = input.closest('div.flex').parentElement;\n          const feedbackEl = parentRow.querySelector('.feedback-icon');\n\n          feedbackEl.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-700', 'bg-red-50', 'text-red-700');\n\n          if (userAnswer === correctAnswer) {\n            correctCount++;\n            input.classList.remove('border-slate-300', 'border-red-500', 'bg-red-50');\n            input.classList.add('border-emerald-500', 'bg-emerald-50');\n            feedbackEl.textContent = 'Correct';\n            feedbackEl.classList.add('bg-emerald-50', 'text-emerald-700');\n          } else {\n            input.classList.remove('border-slate-300', 'border-emerald-500', 'bg-emerald-50');\n            input.classList.add('border-red-500', 'bg-red-50');\n            feedbackEl.textContent = `Correct: ${correctAnswer}`;\n            feedbackEl.classList.add('bg-red-50', 'text-red-700');\n          }\n        });\n\n        currentScoreEl.textContent = correctCount;\n\n        // Dispatch Custom Event for Live Sessions / Analytics\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: window.ACTIVITY_METRICS.maxScore,\n            completed: correctCount === window.ACTIVITY_METRICS.maxScore\n          }\n        }));\n\n        // Post Message for Parent Frames\n        if (window.parent && window.parent !== window) {\n          window.parent.postMessage({\n            type: 'ACTIVITY_SCORE',\n            score: correctCount,\n            total: window.ACTIVITY_METRICS.maxScore\n          }, '*');\n        }\n      }\n\n      function resetActivity() {\n        inputs.forEach(input => {\n          input.value = '';\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'border-red-500', 'bg-red-50');\n          input.classList.add('border-slate-300');\n          const parentRow = input.closest('div.flex').parentElement;\n          const feedbackEl = parentRow.querySelector('.feedback-icon');\n          feedbackEl.classList.add('hidden');\n        });\n        currentScoreEl.textContent = '0';\n      }\n\n      checkBtn.addEventListener('click', checkAnswers);\n      resetBtn.addEventListener('click', resetActivity);\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793368268313,
      "title": "Auxiliary Verbs Exercise",
      "html": "<!DOCTYPE html>\n<html lang=\"en\"><head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Auxiliary Verbs Exercise</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    window.ACTIVITY_METRICS = {\n      domain: 'Grammar',\n      skill: 'auxiliary_verbs_questions',\n      maxScore: 8\n    };\n  </script>\n<style>*, ::before, ::after{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }::backdrop{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }/* ! tailwindcss v3.4.17 | MIT License | https://tailwindcss.com */*,::after,::before{box-sizing:border-box;border-width:0;border-style:solid;border-color:#e5e7eb}::after,::before{--tw-content:''}:host,html{line-height:1.5;-webkit-text-size-adjust:100%;-moz-tab-size:4;tab-size:4;font-family:ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\";font-feature-settings:normal;font-variation-settings:normal;-webkit-tap-highlight-color:transparent}body{margin:0;line-height:inherit}hr{height:0;color:inherit;border-top-width:1px}abbr:where([title]){-webkit-text-decoration:underline dotted;text-decoration:underline dotted}h1,h2,h3,h4,h5,h6{font-size:inherit;font-weight:inherit}a{color:inherit;text-decoration:inherit}b,strong{font-weight:bolder}code,kbd,pre,samp{font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;font-feature-settings:normal;font-variation-settings:normal;font-size:1em}small{font-size:80%}sub,sup{font-size:75%;line-height:0;position:relative;vertical-align:baseline}sub{bottom:-.25em}sup{top:-.5em}table{text-indent:0;border-color:inherit;border-collapse:collapse}button,input,optgroup,select,textarea{font-family:inherit;font-feature-settings:inherit;font-variation-settings:inherit;font-size:100%;font-weight:inherit;line-height:inherit;letter-spacing:inherit;color:inherit;margin:0;padding:0}button,select{text-transform:none}button,input:where([type=button]),input:where([type=reset]),input:where([type=submit]){-webkit-appearance:button;background-color:transparent;background-image:none}:-moz-focusring{outline:auto}:-moz-ui-invalid{box-shadow:none}progress{vertical-align:baseline}::-webkit-inner-spin-button,::-webkit-outer-spin-button{height:auto}[type=search]{-webkit-appearance:textfield;outline-offset:-2px}::-webkit-search-decoration{-webkit-appearance:none}::-webkit-file-upload-button{-webkit-appearance:button;font:inherit}summary{display:list-item}blockquote,dd,dl,figure,h1,h2,h3,h4,h5,h6,hr,p,pre{margin:0}fieldset{margin:0;padding:0}legend{padding:0}menu,ol,ul{list-style:none;margin:0;padding:0}dialog{padding:0}textarea{resize:vertical}input::placeholder,textarea::placeholder{opacity:1;color:#9ca3af}[role=button],button{cursor:pointer}:disabled{cursor:default}audio,canvas,embed,iframe,img,object,svg,video{display:block;vertical-align:middle}img,video{max-width:100%;height:auto}[hidden]:where(:not([hidden=until-found])){display:none}.sticky{position:sticky}.top-0{top:0px}.z-20{z-index:20}.mx-auto{margin-left:auto;margin-right:auto}.mb-6{margin-bottom:1.5rem}.ml-auto{margin-left:auto}.mt-0\\.5{margin-top:0.125rem}.mt-1{margin-top:0.25rem}.mt-8{margin-top:2rem}.flex{display:flex}.h-7{height:1.75rem}.min-h-screen{min-height:100vh}.w-24{width:6rem}.w-6{width:1.5rem}.w-7{width:1.75rem}.w-full{width:100%}.max-w-4xl{max-width:56rem}.flex-shrink-0{flex-shrink:0}.cursor-pointer{cursor:pointer}.flex-wrap{flex-wrap:wrap}.items-start{align-items:flex-start}.items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}.gap-2{gap:0.5rem}.gap-3{gap:0.75rem}.gap-4{gap:1rem}.space-x-2 > :not([hidden]) ~ :not([hidden]){--tw-space-x-reverse:0;margin-right:calc(0.5rem * var(--tw-space-x-reverse));margin-left:calc(0.5rem * calc(1 - var(--tw-space-x-reverse)))}.space-x-4 > :not([hidden]) ~ :not([hidden]){--tw-space-x-reverse:0;margin-right:calc(1rem * var(--tw-space-x-reverse));margin-left:calc(1rem * calc(1 - var(--tw-space-x-reverse)))}.space-y-4 > :not([hidden]) ~ :not([hidden]){--tw-space-y-reverse:0;margin-top:calc(1rem * calc(1 - var(--tw-space-y-reverse)));margin-bottom:calc(1rem * var(--tw-space-y-reverse))}.space-y-6 > :not([hidden]) ~ :not([hidden]){--tw-space-y-reverse:0;margin-top:calc(1.5rem * calc(1 - var(--tw-space-y-reverse)));margin-bottom:calc(1.5rem * var(--tw-space-y-reverse))}.rounded{border-radius:0.25rem}.rounded-2xl{border-radius:1rem}.rounded-full{border-radius:9999px}.rounded-lg{border-radius:0.5rem}.rounded-xl{border-radius:0.75rem}.border{border-width:1px}.border-b{border-bottom-width:1px}.border-t{border-top-width:1px}.border-slate-100{--tw-border-opacity:1;border-color:rgb(241 245 249 / var(--tw-border-opacity, 1))}.border-slate-200{--tw-border-opacity:1;border-color:rgb(226 232 240 / var(--tw-border-opacity, 1))}.border-slate-300{--tw-border-opacity:1;border-color:rgb(203 213 225 / var(--tw-border-opacity, 1))}.border-transparent{border-color:transparent}.bg-emerald-700{--tw-bg-opacity:1;background-color:rgb(4 120 87 / var(--tw-bg-opacity, 1))}.bg-indigo-100{--tw-bg-opacity:1;background-color:rgb(224 231 255 / var(--tw-bg-opacity, 1))}.bg-indigo-600{--tw-bg-opacity:1;background-color:rgb(79 70 229 / var(--tw-bg-opacity, 1))}.bg-slate-100{--tw-bg-opacity:1;background-color:rgb(241 245 249 / var(--tw-bg-opacity, 1))}.bg-slate-200{--tw-bg-opacity:1;background-color:rgb(226 232 240 / var(--tw-bg-opacity, 1))}.bg-slate-50{--tw-bg-opacity:1;background-color:rgb(248 250 252 / var(--tw-bg-opacity, 1))}.bg-slate-900{--tw-bg-opacity:1;background-color:rgb(15 23 42 / var(--tw-bg-opacity, 1))}.bg-white{--tw-bg-opacity:1;background-color:rgb(255 255 255 / var(--tw-bg-opacity, 1))}.bg-white\\/95{background-color:rgb(255 255 255 / 0.95)}.p-3{padding:0.75rem}.p-4{padding:1rem}.px-1{padding-left:0.25rem;padding-right:0.25rem}.px-2\\.5{padding-left:0.625rem;padding-right:0.625rem}.px-3{padding-left:0.75rem;padding-right:0.75rem}.px-4{padding-left:1rem;padding-right:1rem}.py-0\\.5{padding-top:0.125rem;padding-bottom:0.125rem}.py-1{padding-top:0.25rem;padding-bottom:0.25rem}.py-2{padding-top:0.5rem;padding-bottom:0.5rem}.py-3{padding-top:0.75rem;padding-bottom:0.75rem}.py-6{padding-top:1.5rem;padding-bottom:1.5rem}.pb-4{padding-bottom:1rem}.pt-6{padding-top:1.5rem}.text-center{text-align:center}.font-mono{font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace}.font-sans{font-family:ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"}.text-base{font-size:1rem;line-height:1.5rem}.text-lg{font-size:1.125rem;line-height:1.75rem}.text-sm{font-size:0.875rem;line-height:1.25rem}.text-xs{font-size:0.75rem;line-height:1rem}.font-bold{font-weight:700}.font-medium{font-weight:500}.font-semibold{font-weight:600}.uppercase{text-transform:uppercase}.leading-relaxed{line-height:1.625}.tracking-wider{letter-spacing:0.05em}.text-indigo-600{--tw-text-opacity:1;color:rgb(79 70 229 / var(--tw-text-opacity, 1))}.text-indigo-700{--tw-text-opacity:1;color:rgb(67 56 202 / var(--tw-text-opacity, 1))}.text-slate-500{--tw-text-opacity:1;color:rgb(100 116 139 / var(--tw-text-opacity, 1))}.text-slate-600{--tw-text-opacity:1;color:rgb(71 85 105 / var(--tw-text-opacity, 1))}.text-slate-700{--tw-text-opacity:1;color:rgb(51 65 85 / var(--tw-text-opacity, 1))}.text-slate-800{--tw-text-opacity:1;color:rgb(30 41 59 / var(--tw-text-opacity, 1))}.text-slate-900{--tw-text-opacity:1;color:rgb(15 23 42 / var(--tw-text-opacity, 1))}.text-white{--tw-text-opacity:1;color:rgb(255 255 255 / var(--tw-text-opacity, 1))}.antialiased{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.shadow-sm{--tw-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05);--tw-shadow-colored:0 1px 2px 0 var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)}.backdrop-blur{--tw-backdrop-blur:blur(8px);-webkit-backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia)}.transition{transition-property:color, background-color, border-color, fill, stroke, opacity, box-shadow, transform, filter, -webkit-text-decoration-color, -webkit-backdrop-filter;transition-property:color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;transition-property:color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter, -webkit-text-decoration-color, -webkit-backdrop-filter;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms}.hover\\:border-slate-100:hover{--tw-border-opacity:1;border-color:rgb(241 245 249 / var(--tw-border-opacity, 1))}.hover\\:bg-indigo-700:hover{--tw-bg-opacity:1;background-color:rgb(67 56 202 / var(--tw-bg-opacity, 1))}.hover\\:bg-slate-300:hover{--tw-bg-opacity:1;background-color:rgb(203 213 225 / var(--tw-bg-opacity, 1))}.hover\\:bg-slate-50\\/80:hover{background-color:rgb(248 250 252 / 0.8)}.focus\\:bg-white:focus{--tw-bg-opacity:1;background-color:rgb(255 255 255 / var(--tw-bg-opacity, 1))}.focus\\:outline-none:focus{outline:2px solid transparent;outline-offset:2px}.focus\\:ring-2:focus{--tw-ring-offset-shadow:var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);--tw-ring-shadow:var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);box-shadow:var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000)}.focus\\:ring-indigo-500:focus{--tw-ring-opacity:1;--tw-ring-color:rgb(99 102 241 / var(--tw-ring-opacity, 1))}.active\\:scale-95:active{--tw-scale-x:.95;--tw-scale-y:.95;transform:translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))}@media (min-width: 640px){.sm\\:w-28{width:7rem}.sm\\:p-6{padding:1.5rem}.sm\\:text-base{font-size:1rem;line-height:1.5rem}.sm\\:text-lg{font-size:1.125rem;line-height:1.75rem}.sm\\:text-sm{font-size:0.875rem;line-height:1.25rem}}@media (min-width: 768px){.md\\:p-8{padding:2rem}}</style></head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen py-6 px-4\">\n\n  <!-- Sticky Header / Score Bar -->\n  <div class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full max-w-4xl mx-auto mb-6 shadow-sm rounded-xl flex flex-wrap items-center justify-between gap-4\">\n    <div class=\"flex items-center space-x-2\">\n      <span class=\"bg-indigo-100 text-indigo-700 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider\">Grammar G1.1</span>\n      <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">Auxiliary Verbs</h1>\n    </div>\n    <div class=\"flex items-center space-x-4\">\n      <div class=\"text-sm font-medium text-slate-600\">\n        Score: <span id=\"score-display\" class=\"font-bold text-indigo-600\">0</span> / <span id=\"total-display\">8</span>\n      </div>\n      <button id=\"check-btn\" class=\"bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-sm font-medium py-2 px-4 rounded-lg transition shadow-sm cursor-pointer\">\n        Check Answers\n      </button>\n      <button id=\"reset-btn\" class=\"bg-slate-200 hover:bg-slate-300 active:scale-95 text-slate-700 text-sm font-medium py-2 px-3 rounded-lg transition cursor-pointer\">\n        Reset\n      </button>\n    </div>\n  </div>\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm p-4 sm:p-6 md:p-8 space-y-6\">\n    \n    <!-- Exercise Header -->\n    <div class=\"border-b border-slate-100 pb-4\">\n      <div class=\"flex items-start gap-3\">\n        <span class=\"flex-shrink-0 bg-slate-900 text-white text-sm font-bold w-7 h-7 rounded-full flex items-center justify-center\">2</span>\n        <div>\n          <h2 class=\"text-base sm:text-lg font-semibold text-slate-900\">a) Fill in the gaps with an auxiliary where necessary.</h2>\n          <p class=\"text-xs sm:text-sm text-slate-500 mt-0.5\">Type the correct auxiliary verb in each gap (e.g., *do*, *did*, *are*, *have*, *does*, etc.). If no auxiliary is needed, type <span class=\"font-mono bg-slate-100 px-1 py-0.5 rounded text-slate-700\">-</span>.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Questions Form / List -->\n    <form id=\"quiz-form\" class=\"space-y-4 text-sm sm:text-base\">\n      \n      <!-- Item 1 -->\n      <div class=\"flex flex-wrap items-center gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100\">\n        <span class=\"font-semibold text-slate-700 w-6\">1.</span>\n        <span class=\"text-slate-800\">What</span>\n        <input type=\"text\" data-answer=\"do\" placeholder=\"...\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" class=\"w-24 sm:w-28 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-base\">\n        <span class=\"text-slate-800\">you do to relax?</span>\n        <span class=\"feedback-icon ml-auto text-lg font-bold\"></span>\n      </div>\n\n      <!-- Item 2 -->\n      <div class=\"flex flex-wrap items-center gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100\">\n        <span class=\"font-semibold text-slate-700 w-6\">2.</span>\n        <span class=\"text-slate-800\">Who</span>\n        <input type=\"text\" data-answer=\"-\" placeholder=\"[ - ]\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" class=\"w-24 sm:w-28 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-base\">\n        <span class=\"text-slate-800\">watches TV the most in your family?</span>\n        <span class=\"feedback-icon ml-auto text-lg font-bold\"></span>\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"flex flex-wrap items-center gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100\">\n        <span class=\"font-semibold text-slate-700 w-6\">3.</span>\n        <input type=\"text\" data-answer=\"Did\" placeholder=\"...\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" class=\"w-24 sm:w-28 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-base\">\n        <span class=\"text-slate-800\">you go anywhere interesting last week?</span>\n        <span class=\"feedback-icon ml-auto text-lg font-bold\"></span>\n      </div>\n\n      <!-- Item 4 -->\n      <div class=\"flex flex-wrap items-center gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100\">\n        <span class=\"font-semibold text-slate-700 w-6\">4.</span>\n        <span class=\"text-slate-800\">What</span>\n        <input type=\"text\" data-answer=\"are\" placeholder=\"...\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" class=\"w-24 sm:w-28 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-base\">\n        <span class=\"text-slate-800\">you going to do after class?</span>\n        <span class=\"feedback-icon ml-auto text-lg font-bold\"></span>\n      </div>\n\n      <!-- Item 5 -->\n      <div class=\"flex flex-wrap items-center gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100\">\n        <span class=\"font-semibold text-slate-700 w-6\">5.</span>\n        <span class=\"text-slate-800\">How many times</span>\n        <input type=\"text\" data-answer=\"have\" placeholder=\"...\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" class=\"w-24 sm:w-28 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-base\">\n        <span class=\"text-slate-800\">you moved house?</span>\n        <span class=\"feedback-icon ml-auto text-lg font-bold\"></span>\n      </div>\n\n      <!-- Item 6 -->\n      <div class=\"flex flex-wrap items-center gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100\">\n        <span class=\"font-semibold text-slate-700 w-6\">6.</span>\n        <span class=\"text-slate-800\">Which of your friends</span>\n        <input type=\"text\" data-answer=\"does\" placeholder=\"...\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" class=\"w-24 sm:w-28 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-base\">\n        <span class=\"text-slate-800\">the most exercise?</span>\n        <span class=\"feedback-icon ml-auto text-lg font-bold\"></span>\n      </div>\n\n      <!-- Item 7 -->\n      <div class=\"flex flex-wrap items-center gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100\">\n        <span class=\"font-semibold text-slate-700 w-6\">7.</span>\n        <span class=\"text-slate-800\">How long</span>\n        <input type=\"text\" data-answer=\"have\" placeholder=\"...\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" class=\"w-24 sm:w-28 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-base\">\n        <span class=\"text-slate-800\">you known your best friend?</span>\n        <span class=\"feedback-icon ml-auto text-lg font-bold\"></span>\n      </div>\n\n      <!-- Item 8 -->\n      <div class=\"flex flex-wrap items-center gap-2 p-3 rounded-xl hover:bg-slate-50/80 transition border border-transparent hover:border-slate-100\">\n        <span class=\"font-semibold text-slate-700 w-6\">8.</span>\n        <input type=\"text\" data-answer=\"Are\" placeholder=\"...\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" class=\"w-24 sm:w-28 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-base\">\n        <span class=\"text-slate-800\">you studying any other languages at the moment?</span>\n        <span class=\"feedback-icon ml-auto text-lg font-bold\"></span>\n      </div>\n\n    </form>\n\n    <!-- Part B Section (As requested by the teacher's note) -->\n    <div class=\"mt-8 pt-6 border-t border-slate-200 bg-slate-50 p-4 sm:p-6 rounded-xl\">\n      <div class=\"flex items-start gap-3\">\n        <span class=\"flex-shrink-0 bg-emerald-700 text-white text-sm font-bold w-7 h-7 rounded-full flex items-center justify-center\">b</span>\n        <div>\n          <h3 class=\"text-base font-semibold text-slate-900\">Work in groups.</h3>\n          <p class=\"text-sm text-slate-600 mt-1 leading-relaxed\">\n            Take turns to ask and answer the questions. Who has similar answers to you?\n          </p>\n        </div>\n      </div>\n    </div>\n\n  </main>\n\n  <!-- Interactive Logic Script -->\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      const form = document.getElementById('quiz-form');\n      const checkBtn = document.getElementById('check-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const scoreDisplay = document.getElementById('score-display');\n      const inputs = form.querySelectorAll('input');\n\n      function checkAnswers() {\n        let correctCount = 0;\n\n        inputs.forEach(input => {\n          const userAnswer = input.value.trim().toLowerCase();\n          const expectedAnswer = input.getAttribute('data-answer').toLowerCase();\n          const parentRow = input.closest('div');\n          const feedbackIcon = parentRow.querySelector('.feedback-icon');\n\n          // Remove prior validation classes\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-800', 'border-red-500', 'bg-red-50', 'text-red-800');\n\n          if (userAnswer === expectedAnswer) {\n            correctCount++;\n            input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-800');\n            feedbackIcon.textContent = '✓';\n            feedbackIcon.className = 'feedback-icon ml-auto text-lg font-bold text-emerald-600';\n          } else {\n            input.classList.add('border-red-500', 'bg-red-50', 'text-red-800');\n            feedbackIcon.textContent = '✗';\n            feedbackIcon.className = 'feedback-icon ml-auto text-lg font-bold text-red-600';\n          }\n        });\n\n        scoreDisplay.textContent = correctCount;\n\n        // Dispatch events for parent integration / telemetry\n        const completed = (correctCount === inputs.length);\n        \n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: inputs.length,\n            completed: completed\n          }\n        }));\n\n        if (window.parent && window.parent !== window) {\n          window.parent.postMessage({ \n            type: 'ACTIVITY_SCORE', \n            score: correctCount, \n            total: inputs.length,\n            completed: completed\n          }, '*');\n        }\n      }\n\n      function resetActivity() {\n        inputs.forEach(input => {\n          input.value = '';\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-800', 'border-red-500', 'bg-red-50', 'text-red-800');\n          const parentRow = input.closest('div');\n          const feedbackIcon = parentRow.querySelector('.feedback-icon');\n          feedbackIcon.textContent = '';\n        });\n        scoreDisplay.textContent = '0';\n\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: 0,\n            total: inputs.length,\n            completed: false\n          }\n        }));\n      }\n\n      checkBtn.addEventListener('click', checkAnswers);\n      resetBtn.addEventListener('click', resetActivity);\n    });\n  </script>\n\n</body></html>"
    },
    {
      "id": 1793369001012,
      "title": "Entertainment, Food and Sport - Sentence Builder",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Entertainment, Food and Sport - Sentence Builder</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    input[type=\"text\"] {\n      font-size: 16px; /* Prevents auto-zoom on iOS */\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen py-4 px-2 sm:px-4\">\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm p-4 sm:p-6 md:p-8\">\n\n    <!-- Sticky Header with Metrics & Title -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-100 mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n      <div>\n        <div class=\"flex items-center gap-2\">\n          <span class=\"bg-indigo-100 text-indigo-800 text-xs font-bold px-2.5 py-1 rounded-md\">3 a)</span>\n          <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">Preferences: Entertainment, Food and Sport</h1>\n        </div>\n        <p class=\"text-xs text-slate-500 mt-0.5\">Use the target phrases to build true sentences about your preferences.</p>\n      </div>\n      <div class=\"flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end\">\n        <div class=\"text-sm font-medium text-slate-600 bg-slate-100 px-3 py-1.5 rounded-lg\">\n          Score: <span id=\"score-display\" class=\"font-bold text-indigo-600\">0</span> / <span id=\"total-display\">4</span>\n        </div>\n      </div>\n    </header>\n\n    <!-- Reference Word Bank / Instructions -->\n    <section class=\"mb-6 bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-5\">\n      <h2 class=\"text-xs font-bold uppercase tracking-wider text-slate-500 mb-3\">Available Words / Phrases</h2>\n      <div class=\"flex flex-wrap gap-2\">\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">(not) keen on</span>\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">can't stand</span>\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">don't mind</span>\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">enjoy</span>\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">really hate</span>\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">get on my nerves</span>\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">drive me crazy</span>\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">(not) very interested in</span>\n        <span class=\"bg-white border border-slate-200 text-slate-700 text-sm px-3 py-1.5 rounded-lg shadow-sm font-medium\">love</span>\n      </div>\n    </section>\n\n    <!-- Interactive Activity Area (Sentence Builder) -->\n    <section class=\"space-y-6 mb-8\">\n      <p class=\"text-sm font-medium text-slate-700\">Write 4 sentences about entertainment, food, and sport using any of the phrases above. Make sure your sentences are grammatically correct (remember to use gerunds -ing after verbs/phrases of preference where necessary).</p>\n\n      <div class=\"space-y-4\">\n        <!-- Sentence 1 -->\n        <div class=\"p-4 bg-slate-50/50 border border-slate-200 rounded-xl space-y-2\">\n          <label for=\"sentence-1\" class=\"block text-xs font-bold text-slate-600 uppercase\">Sentence 1 (Entertainment)</label>\n          <input \n            type=\"text\" \n            id=\"sentence-1\" \n            data-answer=\"free_form\" \n            placeholder=\"e.g., I really hate watching reality shows on TV.\"\n            class=\"w-full bg-white border border-slate-300 rounded-lg py-2.5 px-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all\"\n          >\n          <p class=\"text-xs text-slate-400\">Must include one of the phrases and correct gerund form.</p>\n        </div>\n\n        <!-- Sentence 2 -->\n        <div class=\"p-4 bg-slate-50/50 border border-slate-200 rounded-xl space-y-2\">\n          <label for=\"sentence-2\" class=\"block text-xs font-bold text-slate-600 uppercase\">Sentence 2 (Food)</label>\n          <input \n            type=\"text\" \n            id=\"sentence-2\" \n            data-answer=\"free_form\" \n            placeholder=\"e.g., I love eating spicy food on weekends.\"\n            class=\"w-full bg-white border border-slate-300 rounded-lg py-2.5 px-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all\"\n          >\n          <p class=\"text-xs text-slate-400\">Must include one of the phrases and correct gerund form.</p>\n        </div>\n\n        <!-- Sentence 3 -->\n        <div class=\"p-4 bg-slate-50/50 border border-slate-200 rounded-xl space-y-2\">\n          <label for=\"sentence-3\" class=\"block text-xs font-bold text-slate-600 uppercase\">Sentence 3 (Sport)</label>\n          <input \n            type=\"text\" \n            id=\"sentence-3\" \n            data-answer=\"free_form\" \n            placeholder=\"e.g., I'm not keen on playing football in the rain.\"\n            class=\"w-full bg-white border border-slate-300 rounded-lg py-2.5 px-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all\"\n          >\n          <p class=\"text-xs text-slate-400\">Must include one of the phrases and correct gerund form.</p>\n        </div>\n\n        <!-- Sentence 4 -->\n        <div class=\"p-4 bg-slate-50/50 border border-slate-200 rounded-xl space-y-2\">\n          <label for=\"sentence-4\" class=\"block text-xs font-bold text-slate-600 uppercase\">Sentence 4 (Free Choice)</label>\n          <input \n            type=\"text\" \n            id=\"sentence-4\" \n            data-answer=\"free_form\" \n            placeholder=\"e.g., Heavy metal music drives me crazy.\"\n            class=\"w-full bg-white border border-slate-300 rounded-lg py-2.5 px-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all\"\n          >\n          <p class=\"text-xs text-slate-400\">Must include one of the phrases and correct structure.</p>\n        </div>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"flex flex-wrap items-center justify-between gap-3 pt-2\">\n        <button \n          id=\"reset-btn\" \n          type=\"button\" \n          class=\"px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl transition-all min-h-[42px]\"\n        >\n          Reset\n        </button>\n        <button \n          id=\"check-btn\" \n          type=\"button\" \n          class=\"px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-sm transition-all min-h-[42px]\"\n        >\n          Check Sentences\n        </button>\n      </div>\n    </section>\n\n    <!-- Requested Section: Part b text requirement -->\n    <section class=\"border-t border-slate-200 pt-6 mt-6 bg-indigo-50/40 p-4 sm:p-5 rounded-2xl\">\n      <div class=\"flex items-center gap-2 mb-2\">\n        <span class=\"bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-md\">3 b)</span>\n        <h2 class=\"text-sm sm:text-base font-bold text-slate-900\">Work in pairs. Are any of your sentences the same?</h2>\n      </div>\n      <p class=\"text-xs sm:text-sm text-slate-600\">Compare your sentences with a partner. Discuss if you share the same preferences regarding entertainment, food, and sport.</p>\n    </section>\n\n  </main>\n\n  <script>\n    // Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'preferences_and_opinions',\n      maxScore: 4\n    };\n\n    const checkBtn = document.getElementById('check-btn');\n    const resetBtn = document.getElementById('reset-btn');\n    const scoreDisplay = document.getElementById('score-display');\n    const inputs = [\n      document.getElementById('sentence-1'),\n      document.getElementById('sentence-2'),\n      document.getElementById('sentence-3'),\n      document.getElementById('sentence-4')\n    ];\n\n    const phrases = [\n      \"keen on\", \"can't stand\", \"don't mind\", \"enjoy\", \"really hate\", \n      \"get on my nerves\", \"drive me crazy\", \"interested in\", \"love\"\n    ];\n\n    checkBtn.addEventListener('click', () => {\n      let correctCount = 0;\n\n      inputs.forEach(input => {\n        const val = input.value.trim().toLowerCase();\n        \n        // Validation logic: checks if input has reasonable length and contains at least one target phrase\n        const hasContent = val.length > 5;\n        const containsPhrase = phrases.some(phrase => val.includes(phrase));\n\n        input.classList.remove('border-slate-300', 'border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n\n        if (hasContent && containsPhrase) {\n          input.classList.add('border-emerald-500', 'bg-emerald-50');\n          correctCount++;\n        } else {\n          input.classList.add('border-rose-500', 'bg-rose-50');\n        }\n      });\n\n      scoreDisplay.textContent = correctCount;\n\n      // Dispatch events for parent integration & session analytics\n      const updateDetail = {\n        metrics: window.ACTIVITY_METRICS,\n        score: correctCount,\n        total: inputs.length,\n        completed: correctCount === inputs.length\n      };\n\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', { detail: updateDetail }));\n      \n      if (window.parent && window.parent !== window) {\n        window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: inputs.length }, '*');\n      }\n    });\n\n    resetBtn.addEventListener('click', () => {\n      inputs.forEach(input => {\n        input.value = '';\n        input.classList.remove('border-emerald-500', 'border-rose-500', 'bg-emerald-50', 'bg-rose-50');\n        input.classList.add('border-slate-300');\n      });\n      scoreDisplay.textContent = '0';\n\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: 0,\n          total: inputs.length,\n          completed: false\n        }\n      }));\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793369245471,
      "title": "Grammar Practice - Opposite Meanings",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Grammar Practice - Opposite Meanings</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Prevent iOS auto-zoom on inputs */\n    @media screen and (max-width: 768px) {\n      input, select, textarea {\n        font-size: 16px !important;\n      }\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Header for Score / Metrics -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-8 border-b w-full shadow-sm flex flex-wrap items-center justify-between gap-4\">\n    <div class=\"flex items-center gap-2\">\n      <span class=\"bg-indigo-100 text-indigo-800 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider\">Grammar G1.2</span>\n      <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">Opposite Meanings & Personalization</h1>\n    </div>\n    <div class=\"flex items-center gap-4\">\n      <div id=\"score-display\" class=\"text-sm font-medium text-slate-600 bg-slate-100 px-3 py-1.5 rounded-lg\">\n        Score: <span id=\"current-score\" class=\"font-bold text-indigo-600\">0</span> / <span id=\"total-score\">6</span>\n      </div>\n      <button id=\"check-btn\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm px-4 py-2 rounded-xl transition-all shadow-sm active:scale-95 touch-manipulation cursor-pointer\">\n        Check Answers\n      </button>\n      <button id=\"reset-btn\" class=\"bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium text-sm px-4 py-2 rounded-xl transition-all active:scale-95 touch-manipulation cursor-pointer\">\n        Reset\n      </button>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 my-6 bg-white border border-slate-200 rounded-2xl shadow-sm flex-grow\">\n    \n    <!-- Instructions Section -->\n    <section class=\"mb-6 bg-indigo-50/50 p-4 rounded-xl border border-indigo-100\">\n      <h2 class=\"font-bold text-indigo-900 text-base mb-1\">4. a) Change the underlined words</h2>\n      <p class=\"text-sm text-indigo-700\">Change the underlined words so that the sentences have an opposite meaning. Then, <strong class=\"text-indigo-900\">b) tick</strong> the sentences (either original or changed) that are true for you.</p>\n    </section>\n\n    <!-- Interactive Activity Form -->\n    <form id=\"activity-form\" class=\"space-y-6\" onsubmit=\"return false;\">\n      \n      <!-- Item 1 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:border-slate-300 transition-all flex flex-col gap-3\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div class=\"text-sm sm:text-base text-slate-700 flex-grow\">\n            <span class=\"font-semibold text-indigo-600 mr-2\">1.</span> \n            <span class=\"line-through decoration-indigo-400 font-medium text-slate-500\">No one</span> I know watches TV.\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-xs font-semibold text-slate-500 uppercase tracking-wide\">Opposite:</label>\n            <input type=\"text\" data-answer=\"Everyone\" placeholder=\"Type opposite...\" \n                   class=\"bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-48 shadow-inner\">\n          </div>\n        </div>\n        <!-- Part B Checkbox -->\n        <div class=\"flex items-center gap-2 pt-2 border-t border-slate-200/60\">\n          <input type=\"checkbox\" id=\"true-1\" class=\"w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer\">\n          <label for=\"true-1\" class=\"text-xs sm:text-sm text-slate-600 cursor-pointer select-none\">\n            <span class=\"font-medium text-indigo-700\">b)</span> This is true for me (either original or changed sentence)\n          </label>\n        </div>\n      </div>\n\n      <!-- Item 2 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:border-slate-300 transition-all flex flex-col gap-3\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div class=\"text-sm sm:text-base text-slate-700 flex-grow\">\n            <span class=\"font-semibold text-indigo-600 mr-2\">2.</span> \n            I <span class=\"line-through decoration-indigo-400 font-medium text-slate-500\">think</span> I'll go out tonight.\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-xs font-semibold text-slate-500 uppercase tracking-wide\">Opposite:</label>\n            <input type=\"text\" data-answer=\"don't think\" placeholder=\"Type opposite...\" \n                   class=\"bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-48 shadow-inner\">\n          </div>\n        </div>\n        <!-- Part B Checkbox -->\n        <div class=\"flex items-center gap-2 pt-2 border-t border-slate-200/60\">\n          <input type=\"checkbox\" id=\"true-2\" class=\"w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer\">\n          <label for=\"true-2\" class=\"text-xs sm:text-sm text-slate-600 cursor-pointer select-none\">\n            <span class=\"font-medium text-indigo-700\">b)</span> This is true for me (either original or changed sentence)\n          </label>\n        </div>\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:border-slate-300 transition-all flex flex-col gap-3\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div class=\"text-sm sm:text-base text-slate-700 flex-grow\">\n            <span class=\"font-semibold text-indigo-600 mr-2\">3.</span> \n            I <span class=\"line-through decoration-indigo-400 font-medium text-slate-500\">hardly ever</span> eat fish.\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-xs font-semibold text-slate-500 uppercase tracking-wide\">Opposite:</label>\n            <input type=\"text\" data-answer=\"always\" placeholder=\"Type opposite...\" \n                   class=\"bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-48 shadow-inner\">\n          </div>\n        </div>\n        <!-- Part B Checkbox -->\n        <div class=\"flex items-center gap-2 pt-2 border-t border-slate-200/60\">\n          <input type=\"checkbox\" id=\"true-3\" class=\"w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer\">\n          <label for=\"true-3\" class=\"text-xs sm:text-sm text-slate-600 cursor-pointer select-none\">\n            <span class=\"font-medium text-indigo-700\">b)</span> This is true for me (either original or changed sentence)\n          </label>\n        </div>\n      </div>\n\n      <!-- Item 4 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:border-slate-300 transition-all flex flex-col gap-3\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div class=\"text-sm sm:text-base text-slate-700 flex-grow\">\n            <span class=\"font-semibold text-indigo-600 mr-2\">4.</span> \n            <span class=\"line-through decoration-indigo-400 font-medium text-slate-500\">All</span> of my friends like football.\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-xs font-semibold text-slate-500 uppercase tracking-wide\">Opposite:</label>\n            <input type=\"text\" data-answer=\"None\" placeholder=\"Type opposite...\" \n                   class=\"bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-48 shadow-inner\">\n          </div>\n        </div>\n        <!-- Part B Checkbox -->\n        <div class=\"flex items-center gap-2 pt-2 border-t border-slate-200/60\">\n          <input type=\"checkbox\" id=\"true-4\" class=\"w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer\">\n          <label for=\"true-4\" class=\"text-xs sm:text-sm text-slate-600 cursor-pointer select-none\">\n            <span class=\"font-medium text-indigo-700\">b)</span> This is true for me (either original or changed sentence)\n          </label>\n        </div>\n      </div>\n\n      <!-- Item 5 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:border-slate-300 transition-all flex flex-col gap-3\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div class=\"text-sm sm:text-base text-slate-700 flex-grow\">\n            <span class=\"font-semibold text-indigo-600 mr-2\">5.</span> \n            I have two sisters and <span class=\"line-through decoration-indigo-400 font-medium text-slate-500\">both</span> of them like their jobs.\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-xs font-semibold text-slate-500 uppercase tracking-wide\">Opposite:</label>\n            <input type=\"text\" data-answer=\"neither\" placeholder=\"Type opposite...\" \n                   class=\"bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-48 shadow-inner\">\n          </div>\n        </div>\n        <!-- Part B Checkbox -->\n        <div class=\"flex items-center gap-2 pt-2 border-t border-slate-200/60\">\n          <input type=\"checkbox\" id=\"true-5\" class=\"w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer\">\n          <label for=\"true-5\" class=\"text-xs sm:text-sm text-slate-600 cursor-pointer select-none\">\n            <span class=\"font-medium text-indigo-700\">b)</span> This is true for me (either original or changed sentence)\n          </label>\n        </div>\n      </div>\n\n      <!-- Item 6 -->\n      <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:border-slate-300 transition-all flex flex-col gap-3\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div class=\"text-sm sm:text-base text-slate-700 flex-grow\">\n            <span class=\"font-semibold text-indigo-600 mr-2\">6.</span> \n            I <span class=\"line-through decoration-indigo-400 font-medium text-slate-500\">always</span> get up early at the weekend.\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-xs font-semibold text-slate-500 uppercase tracking-wide\">Opposite:</label>\n            <input type=\"text\" data-answer=\"hardly ever\" placeholder=\"Type opposite...\" \n                   class=\"bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-48 shadow-inner\">\n          </div>\n        </div>\n        <!-- Part B Checkbox -->\n        <div class=\"flex items-center gap-2 pt-2 border-t border-slate-200/60\">\n          <input type=\"checkbox\" id=\"true-6\" class=\"w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer\">\n          <label for=\"true-6\" class=\"text-xs sm:text-sm text-slate-600 cursor-pointer select-none\">\n            <span class=\"font-medium text-indigo-700\">b)</span> This is true for me (either original or changed sentence)\n          </label>\n        </div>\n      </div>\n\n    </form>\n\n    <!-- Part C: Speaking / Pair work prompt container -->\n    <section class=\"mt-8 pt-6 border-t border-slate-200 bg-amber-50/50 p-4 rounded-xl border border-amber-200\">\n      <h3 class=\"font-bold text-amber-900 text-sm sm:text-base mb-1 flex items-center gap-2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-amber-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\" />\n        </svg>\n        c) Work in pairs\n      </h3>\n      <p class=\"text-sm text-amber-800\">Tell your partner your sentences (both the original ones and the opposite ones you wrote, especially the ones you ticked as true for you).</p>\n    </section>\n\n  </main>\n\n  <!-- Footer Info -->\n  <footer class=\"text-center py-4 text-xs text-slate-400\">\n    Interactive ELT Activity &bull; Designed for Responsive Touch Interfaces\n  </footer>\n\n  <!-- Application Logic & Metrics Script -->\n  <script>\n    // Mandatory Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Grammar',\n      skill: 'opposite_meanings_quantifiers_adverbs',\n      maxScore: 6\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const checkBtn = document.getElementById('check-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const currentScoreEl = document.getElementById('current-score');\n      const inputs = document.querySelectorAll('#activity-form input[type=\"text\"]');\n\n      // Helper function to normalize strings for forgiving evaluation\n      const normalize = (str) => str.trim().toLowerCase();\n\n      // Check Answers Logic\n      checkBtn.addEventListener('click', () => {\n        let correctCount = 0;\n\n        inputs.forEach(input => {\n          const expected = normalize(input.getAttribute('data-answer'));\n          const userVal = normalize(input.value);\n\n          // Remove previous states\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n          if (userVal === expected) {\n            correctCount++;\n            input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-semibold');\n          } else {\n            input.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n          }\n        });\n\n        // Update score UI\n        currentScoreEl.textContent = correctCount;\n\n        // Dispatch Custom Event & Parent PostMessage for LMS integration\n        const isCompleted = (correctCount === inputs.length);\n        \n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: inputs.length,\n            completed: isCompleted\n          }\n        }));\n\n        try {\n          window.parent.postMessage({ \n            type: 'ACTIVITY_SCORE', \n            score: correctCount, \n            total: inputs.length \n          }, '*');\n        } catch (e) {\n          console.log('PostMessage not available in this context.');\n        }\n      });\n\n      // Reset Logic\n      resetBtn.addEventListener('click', () => {\n        inputs.forEach(input => {\n          input.value = '';\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900', 'font-semibold');\n        });\n\n        document.querySelectorAll('input[type=\"checkbox\"]').forEach(chk => chk.checked = false);\n\n        currentScoreEl.textContent = '0';\n\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: 0,\n            total: inputs.length,\n            completed: false\n          }\n        }));\n      });\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793369512979,
      "title": "Prepositions Practice & Personal Sentences",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Prepositions Practice & Personal Sentences</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Prevent iOS zoom on focus */\n    @supports (-webkit-touch-callout: none) {\n      input, select, textarea {\n        font-size: 16px !important;\n      }\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Header for Score / Progress -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-8 border-b border-slate-200 shadow-sm w-full\">\n    <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n      <div>\n        <span class=\"text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full\">Grammar & Vocabulary</span>\n        <h1 class=\"text-lg sm:text-xl font-extrabold text-slate-900 mt-1\">Adjective Prepositions</h1>\n      </div>\n      <div id=\"score-display\" class=\"flex items-center gap-3 bg-slate-100 px-4 py-2 rounded-xl text-sm font-semibold text-slate-700\">\n        <span>Score Part A: <span id=\"current-score\" class=\"text-indigo-600 font-bold\">0</span> / <span id=\"total-score\">8</span></span>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 my-4 bg-white border border-slate-200 rounded-2xl shadow-sm flex-grow\">\n    \n    <!-- SECTION A: Choose the correct prepositions -->\n    <section class=\"mb-10\">\n      <div class=\"border-l-4 border-indigo-600 pl-3 mb-4\">\n        <h2 class=\"text-base sm:text-lg font-bold text-slate-900\">5 a) Choose the correct prepositions.</h2>\n        <p class=\"text-sm text-slate-500\">Select the right preposition for each adjective.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4\" id=\"prepositions-container\">\n        \n        <!-- Item 1 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n          <span class=\"font-medium text-slate-800 text-sm sm:text-base\">1. keen</span>\n          <select data-answer=\"on\" class=\"prep-select px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all\">\n            <option value=\"\">Choose...</option>\n            <option value=\"in\">in</option>\n            <option value=\"on\">on</option>\n          </select>\n        </div>\n\n        <!-- Item 2 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n          <span class=\"font-medium text-slate-800 text-sm sm:text-base\">2. worried</span>\n          <select data-answer=\"about\" class=\"prep-select px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all\">\n            <option value=\"\">Choose...</option>\n            <option value=\"about\">about</option>\n            <option value=\"of\">of</option>\n          </select>\n        </div>\n\n        <!-- Item 3 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n          <span class=\"font-medium text-slate-800 text-sm sm:text-base\">3. interested</span>\n          <select data-answer=\"in\" class=\"prep-select px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all\">\n            <option value=\"\">Choose...</option>\n            <option value=\"of\">of</option>\n            <option value=\"in\">in</option>\n          </select>\n        </div>\n\n        <!-- Item 4 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n          <span class=\"font-medium text-slate-800 text-sm sm:text-base\">4. nervous</span>\n          <select data-answer=\"about\" class=\"prep-select px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all\">\n            <option value=\"\">Choose...</option>\n            <option value=\"with\">with</option>\n            <option value=\"about\">about</option>\n          </select>\n        </div>\n\n        <!-- Item 5 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n          <span class=\"font-medium text-slate-800 text-sm sm:text-base\">5. good</span>\n          <select data-answer=\"at\" class=\"prep-select px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all\">\n            <option value=\"\">Choose...</option>\n            <option value=\"at\">at</option>\n            <option value=\"by\">by</option>\n          </select>\n        </div>\n\n        <!-- Item 6 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n          <span class=\"font-medium text-slate-800 text-sm sm:text-base\">6. embarrassed</span>\n          <select data-answer=\"by\" class=\"prep-select px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all\">\n            <option value=\"\">Choose...</option>\n            <option value=\"of\">of</option>\n            <option value=\"by\">by</option>\n          </select>\n        </div>\n\n        <!-- Item 7 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n          <span class=\"font-medium text-slate-800 text-sm sm:text-base\">7. scared</span>\n          <select data-answer=\"of\" class=\"prep-select px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all\">\n            <option value=\"\">Choose...</option>\n            <option value=\"with\">with</option>\n            <option value=\"of\">of</option>\n          </select>\n        </div>\n\n        <!-- Item 8 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n          <span class=\"font-medium text-slate-800 text-sm sm:text-base\">8. bored</span>\n          <select data-answer=\"with\" class=\"prep-select px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all\">\n            <option value=\"\">Choose...</option>\n            <option value=\"with\">with</option>\n            <option value=\"at\">at</option>\n          </select>\n        </div>\n\n      </div>\n\n      <!-- Action Buttons for Part A -->\n      <div class=\"flex flex-wrap items-center gap-3 mt-6\">\n        <button id=\"check-btn\" class=\"bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition-all shadow-sm\">\n          Check Answers\n        </button>\n        <button id=\"reset-btn\" class=\"bg-slate-200 hover:bg-slate-300 active:bg-slate-400 text-slate-700 font-semibold px-5 py-2.5 rounded-xl text-sm transition-all\">\n          Reset\n        </button>\n      </div>\n    </section>\n\n    <!-- SECTION B: Use the phrases to write sentences -->\n    <section class=\"mb-10 pt-6 border-t border-slate-200\">\n      <div class=\"border-l-4 border-emerald-600 pl-3 mb-4\">\n        <h2 class=\"text-base sm:text-lg font-bold text-slate-900\">5 b) Use the phrases to write three true and three false sentences about when you were a child.</h2>\n        <p class=\"text-sm text-slate-500 italic\">Example: When I was a child I was keen on ...</p>\n      </div>\n\n      <div class=\"space-y-4\" id=\"sentences-container\">\n        <!-- Sentence 1 -->\n        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2\">\n            <span class=\"font-semibold text-slate-800 text-sm\">Sentence 1</span>\n            <div class=\"flex items-center gap-4\">\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-1\" value=\"true\" class=\"text-emerald-600 focus:ring-emerald-500\"> True\n              </label>\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-1\" value=\"false\" class=\"text-emerald-600 focus:ring-emerald-500\"> False\n              </label>\n            </div>\n          </div>\n          <textarea rows=\"2\" placeholder=\"Write your sentence here (e.g., When I was a child I was keen on riding my bicycle...)\" class=\"w-full p-3 bg-white border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-none\"></textarea>\n        </div>\n\n        <!-- Sentence 2 -->\n        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2\">\n            <span class=\"font-semibold text-slate-800 text-sm\">Sentence 2</span>\n            <div class=\"flex items-center gap-4\">\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-2\" value=\"true\" class=\"text-emerald-600 focus:ring-emerald-500\"> True\n              </label>\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-2\" value=\"false\" class=\"text-emerald-600 focus:ring-emerald-500\"> False\n              </label>\n            </div>\n          </div>\n          <textarea rows=\"2\" placeholder=\"Write your sentence here...\" class=\"w-full p-3 bg-white border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-none\"></textarea>\n        </div>\n\n        <!-- Sentence 3 -->\n        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2\">\n            <span class=\"font-semibold text-slate-800 text-sm\">Sentence 3</span>\n            <div class=\"flex items-center gap-4\">\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-3\" value=\"true\" class=\"text-emerald-600 focus:ring-emerald-500\"> True\n              </label>\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-3\" value=\"false\" class=\"text-emerald-600 focus:ring-emerald-500\"> False\n              </label>\n            </div>\n          </div>\n          <textarea rows=\"2\" placeholder=\"Write your sentence here...\" class=\"w-full p-3 bg-white border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-none\"></textarea>\n        </div>\n\n        <!-- Sentence 4 -->\n        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2\">\n            <span class=\"font-semibold text-slate-800 text-sm\">Sentence 4</span>\n            <div class=\"flex items-center gap-4\">\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-4\" value=\"true\" class=\"text-emerald-600 focus:ring-emerald-500\"> True\n              </label>\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-4\" value=\"false\" class=\"text-emerald-600 focus:ring-emerald-500\"> False\n              </label>\n            </div>\n          </div>\n          <textarea rows=\"2\" placeholder=\"Write your sentence here...\" class=\"w-full p-3 bg-white border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-none\"></textarea>\n        </div>\n\n        <!-- Sentence 5 -->\n        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2\">\n            <span class=\"font-semibold text-slate-800 text-sm\">Sentence 5</span>\n            <div class=\"flex items-center gap-4\">\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-5\" value=\"true\" class=\"text-emerald-600 focus:ring-emerald-500\"> True\n              </label>\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-5\" value=\"false\" class=\"text-emerald-600 focus:ring-emerald-500\"> False\n              </label>\n            </div>\n          </div>\n          <textarea rows=\"2\" placeholder=\"Write your sentence here...\" class=\"w-full p-3 bg-white border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-none\"></textarea>\n        </div>\n\n        <!-- Sentence 6 -->\n        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-xl\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2\">\n            <span class=\"font-semibold text-slate-800 text-sm\">Sentence 6</span>\n            <div class=\"flex items-center gap-4\">\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-6\" value=\"true\" class=\"text-emerald-600 focus:ring-emerald-500\"> True\n              </label>\n              <label class=\"text-xs font-semibold text-slate-600 flex items-center gap-1.5 cursor-pointer\">\n                <input type=\"radio\" name=\"truth-6\" value=\"false\" class=\"text-emerald-600 focus:ring-emerald-500\"> False\n              </label>\n            </div>\n          </div>\n          <textarea rows=\"2\" placeholder=\"Write your sentence here...\" class=\"w-full p-3 bg-white border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-none\"></textarea>\n        </div>\n      </div>\n    </section>\n\n    <!-- SECTION C: Work in pairs -->\n    <section class=\"pt-6 border-t border-slate-200\">\n      <div class=\"border-l-4 border-amber-500 pl-3 mb-3\">\n        <h2 class=\"text-base sm:text-lg font-bold text-slate-900\">5 c) Work in pairs. Guess which of your partner’s sentences are true.</h2>\n      </div>\n      <div class=\"p-4 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-900 leading-relaxed\">\n        Exchange your sentences with a classmate or discuss them aloud. Try to guess which of their statements actually happened when they were a child and which ones are made up!\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"text-center py-4 text-xs text-slate-400\">\n    Interactive ELT Learning Module &bull; Adjective Prepositions\n  </footer>\n\n  <!-- Script & Metrics -->\n  <script>\n    window.ACTIVITY_METRICS = {\n      domain: 'Grammar',\n      skill: 'adjective_prepositions',\n      maxScore: 8\n    };\n\n    const selects = document.querySelectorAll('.prep-select');\n    const checkBtn = document.getElementById('check-btn');\n    const resetBtn = document.getElementById('reset-btn');\n    const currentScoreEl = document.getElementById('current-score');\n\n    checkBtn.addEventListener('click', () => {\n      let correctCount = 0;\n\n      selects.forEach(select => {\n        const expected = select.getAttribute('data-answer');\n        const val = select.value.trim().toLowerCase();\n\n        // Remove previous styles\n        select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900');\n\n        if (val === expected) {\n          correctCount++;\n          select.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-semibold');\n        } else {\n          select.classList.add('border-red-500', 'bg-red-50', 'text-red-900');\n        }\n      });\n\n      currentScoreEl.textContent = correctCount;\n\n      // Dispatch tracking events\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: selects.length,\n          completed: correctCount === selects.length\n        }\n      }));\n\n      window.parent.postMessage({\n        type: 'ACTIVITY_SCORE',\n        score: correctCount,\n        total: selects.length\n      }, '*');\n    });\n\n    resetBtn.addEventListener('click', () => {\n      selects.forEach(select => {\n        select.value = \"\";\n        select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-red-500', 'bg-red-50', 'text-red-900', 'font-semibold');\n      });\n      currentScoreEl.textContent = \"0\";\n\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: 0,\n          total: selects.length,\n          completed: false\n        }\n      }));\n    });\n  </script>\n</body>\n</html>"
    }
  ]
}