{
  "version": "2.0",
  "title": "P1WB U1 Lesson 1A",
  "updatedAt": "2026-10-29T00:13:49.568Z",
  "slides": [
    {
      "id": 1793231295010,
      "title": "Diapositiva 1",
      "html": "<style>\n  .qw-wrap {\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n    max-width: 840px;\n    margin: 0 auto;\n    padding: 24px;\n    background: #ffffff;\n    border-radius: 20px;\n    box-shadow: 0 4px 14px rgba(0,0,0,0.05);\n    color: #0f172a;\n  }\n  .header-box {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-bottom: 2px solid #f1f5f9;\n    padding-bottom: 14px;\n    margin-bottom: 18px;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n  .badge-tag {\n    background: #eef2ff;\n    color: #4f46e5;\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    padding: 4px 10px;\n    border-radius: 6px;\n    letter-spacing: 0.5px;\n  }\n  .pool-box {\n    background: #f8fafc;\n    border: 1.5px solid #e2e8f0;\n    border-radius: 12px;\n    padding: 14px 16px;\n    margin-bottom: 20px;\n  }\n  .pool-title {\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    color: #64748b;\n    margin-bottom: 8px;\n    letter-spacing: 0.5px;\n  }\n  .pool-tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n  .pool-pill {\n    background: #ffffff;\n    border: 1px solid #cbd5e1;\n    color: #334155;\n    font-weight: 700;\n    font-size: 13px;\n    padding: 4px 12px;\n    border-radius: 20px;\n  }\n  .items-list {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .item-row {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    background: #fafaf9;\n    border: 1px solid #e7e5e4;\n    padding: 12px 16px;\n    border-radius: 12px;\n    font-size: 14px;\n    color: #334155;\n  }\n  .item-num {\n    background: #eef2ff;\n    color: #4f46e5;\n    font-weight: 800;\n    font-size: 12px;\n    width: 26px;\n    height: 26px;\n    border-radius: 50%;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .input-qw {\n    width: 130px;\n    padding: 6px 10px;\n    border: 1.5px solid #cbd5e1;\n    border-radius: 8px;\n    background: #ffffff;\n    font-size: 14px;\n    font-weight: 600;\n    color: #0f172a;\n    outline: none;\n    transition: all 0.2s;\n  }\n  .input-qw:focus {\n    border-color: #6366f1;\n    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);\n  }\n  .input-qw.is-correct {\n    border-color: #10b981 !important;\n    background-color: #ecfdf5 !important;\n    color: #065f46 !important;\n  }\n  .input-qw.is-wrong {\n    border-color: #f43f5e !important;\n    background-color: #fff1f2 !important;\n    color: #9f1239 !important;\n  }\n  .footer-acts {\n    display: flex;\n    justify-content: flex-end;\n    gap: 8px;\n    margin-top: 20px;\n    padding-top: 16px;\n    border-top: 2px solid #f1f5f9;\n  }\n  .btn-check-p1 {\n    background: #4f46e5;\n    color: white;\n    border: none;\n    font-weight: 700;\n    font-size: 13px;\n    padding: 9px 20px;\n    border-radius: 10px;\n    cursor: pointer;\n  }\n  .btn-check-p1:hover { background: #4338ca; }\n  .btn-reset-p1 {\n    background: #f1f5f9;\n    color: #64748b;\n    border: none;\n    font-size: 16px;\n    padding: 8px 12px;\n    border-radius: 10px;\n    cursor: pointer;\n  }\n</style>\n\n<div class=\"qw-wrap\">\n  <div class=\"header-box\">\n    <div>\n      <span class=\"badge-tag\">Part 1 • Question Words</span>\n      <h2 style=\"font-size: 20px; font-weight: 800; margin: 4px 0 0 0;\">Fill in the Question Words</h2>\n    </div>\n    <div id=\"scoreP1\" style=\"font-weight: 700; font-size: 13px; color: #64748b; background: #f8fafc; padding: 6px 14px; border-radius: 20px; border: 1px solid #e2e8f0;\">\n      Score: 0 / 7\n    </div>\n  </div>\n\n  <!-- Banco de palabras -->\n  <div class=\"pool-box\">\n    <div class=\"pool-title\">Question Words Box</div>\n    <div class=\"pool-tags\">\n      <span class=\"pool-pill\">Where</span>\n      <span class=\"pool-pill\">Who</span>\n      <span class=\"pool-pill\">When</span>\n      <span class=\"pool-pill\">Why</span>\n      <span class=\"pool-pill\">How long</span>\n      <span class=\"pool-pill\">How many</span>\n      <span class=\"pool-pill\">How often</span>\n    </div>\n  </div>\n\n  <div class=\"items-list\">\n    <!-- 1 Ejemplo -->\n    <div class=\"item-row\" style=\"background:#f1f5f9; border-style:dashed;\">\n      <span class=\"item-num\" style=\"background:#cbd5e1; color:#475569;\">1</span>\n      <div>\n        <input type=\"text\" class=\"input-qw is-correct\" value=\"What\" disabled style=\"width:90px;\">\n        <span>languages do you speak?</span>\n      </div>\n    </div>\n\n    <!-- 2 -->\n    <div class=\"item-row\">\n      <span class=\"item-num\">2</span>\n      <div>\n        <input type=\"text\" class=\"input-qw p1-field\" data-answer=\"Where\" placeholder=\"Question word...\">\n        <span>does Jamie Oliver come from?</span>\n      </div>\n    </div>\n\n    <!-- 3 -->\n    <div class=\"item-row\">\n      <span class=\"item-num\">3</span>\n      <div>\n        <input type=\"text\" class=\"input-qw p1-field\" data-answer=\"Who\" placeholder=\"Question word...\">\n        <span>has the most interesting job you know?</span>\n      </div>\n    </div>\n\n    <!-- 4 -->\n    <div class=\"item-row\">\n      <span class=\"item-num\">4</span>\n      <div>\n        <input type=\"text\" class=\"input-qw p1-field\" data-answer=\"When\" placeholder=\"Question word...\">\n        <span>did she get married?</span>\n      </div>\n    </div>\n\n    <!-- 5 -->\n    <div class=\"item-row\">\n      <span class=\"item-num\">5</span>\n      <div>\n        <input type=\"text\" class=\"input-qw p1-field\" data-answer=\"Why\" placeholder=\"Question word...\">\n        <span>are you studying English?</span>\n      </div>\n    </div>\n\n    <!-- 6 -->\n    <div class=\"item-row\">\n      <span class=\"item-num\">6</span>\n      <div>\n        <input type=\"text\" class=\"input-qw p1-field\" data-answer=\"How long\" placeholder=\"Question word...\" style=\"width:140px;\">\n        <span>is a university degree course in England?</span>\n      </div>\n    </div>\n\n    <!-- 7 -->\n    <div class=\"item-row\">\n      <span class=\"item-num\">7</span>\n      <div>\n        <input type=\"text\" class=\"input-qw p1-field\" data-answer=\"How many\" placeholder=\"Question word...\" style=\"width:140px;\">\n        <span>brothers and sisters have you got?</span>\n      </div>\n    </div>\n\n    <!-- 8 -->\n    <div class=\"item-row\">\n      <span class=\"item-num\">8</span>\n      <div>\n        <input type=\"text\" class=\"input-qw p1-field\" data-answer=\"How often\" placeholder=\"Question word...\" style=\"width:140px;\">\n        <span>do you go to the cinema?</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer-acts\">\n    <button onclick=\"checkP1()\" class=\"btn-check-p1\">✓ Check Answers</button>\n    <button onclick=\"resetP1()\" class=\"btn-reset-p1\" title=\"Reset\">🔄</button>\n  </div>\n</div>\n\n<script>\n  function checkP1() {\n    const inputs = document.querySelectorAll('.p1-field');\n    let correct = 0;\n    inputs.forEach(inp => {\n      const val = (inp.value || '').trim().toLowerCase();\n      const ans = (inp.dataset.answer || '').trim().toLowerCase();\n      inp.classList.remove('is-correct', 'is-wrong');\n\n      if (val === ans) {\n        inp.classList.add('is-correct');\n        correct++;\n      } else if (val.length > 0) {\n        inp.classList.add('is-wrong');\n      }\n    });\n\n    const badge = document.getElementById('scoreP1');\n    if (badge) {\n      badge.textContent = `Score: ${correct} / ${inputs.length}`;\n      badge.style.color = correct === inputs.length ? '#15803d' : '#475569';\n      badge.style.background = correct === inputs.length ? '#dcfce7' : '#f8fafc';\n    }\n  }\n\n  function resetP1() {\n    document.querySelectorAll('.p1-field').forEach(inp => {\n      inp.value = '';\n      inp.classList.remove('is-correct', 'is-wrong');\n    });\n    const badge = document.getElementById('scoreP1');\n    if (badge) {\n      badge.textContent = 'Score: 0 / 7';\n      badge.style.color = '#475569';\n      badge.style.background = '#f8fafc';\n    }\n  }\n</script>"
    },
    {
      "id": 2,
      "title": "Diapositiva 2",
      "html": "<style>\n  .match-wrap {\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n    max-width: 860px;\n    margin: 0 auto;\n    padding: 24px;\n    background: #ffffff;\n    border-radius: 20px;\n    box-shadow: 0 4px 14px rgba(0,0,0,0.05);\n    color: #0f172a;\n  }\n  .header-box {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-bottom: 2px solid #f1f5f9;\n    padding-bottom: 14px;\n    margin-bottom: 18px;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n  .badge-tag {\n    background: #eef2ff;\n    color: #4f46e5;\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    padding: 4px 10px;\n    border-radius: 6px;\n    letter-spacing: 0.5px;\n  }\n  \n  /* Respuestas Disponibles a-h */\n  .answers-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));\n    gap: 8px;\n    background: #f8fafc;\n    border: 1.5px solid #e2e8f0;\n    border-radius: 12px;\n    padding: 14px;\n    margin-bottom: 22px;\n    font-size: 13px;\n    color: #334155;\n  }\n  .ans-card {\n    background: #ffffff;\n    border: 1px solid #e2e8f0;\n    border-radius: 8px;\n    padding: 6px 10px;\n  }\n\n  /* Lista de emparejamiento */\n  .match-list {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .match-item {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background: #ffffff;\n    border: 1px solid #e2e8f0;\n    padding: 12px 16px;\n    border-radius: 12px;\n    gap: 12px;\n  }\n  .q-text {\n    font-size: 14px;\n    color: #1e293b;\n    font-weight: 600;\n  }\n  .match-select {\n    width: 90px;\n    padding: 6px 10px;\n    border-radius: 8px;\n    border: 1.5px solid #cbd5e1;\n    font-size: 13px;\n    font-weight: 700;\n    color: #334155;\n    background: #ffffff;\n    outline: none;\n    cursor: pointer;\n    flex-shrink: 0;\n  }\n  .match-select.is-correct {\n    border-color: #10b981 !important;\n    background-color: #ecfdf5 !important;\n    color: #065f46 !important;\n  }\n  .match-select.is-wrong {\n    border-color: #f43f5e !important;\n    background-color: #fff1f2 !important;\n    color: #9f1239 !important;\n  }\n  .footer-acts {\n    display: flex;\n    justify-content: flex-end;\n    gap: 8px;\n    margin-top: 20px;\n    padding-top: 16px;\n    border-top: 2px solid #f1f5f9;\n  }\n  .btn-check-m {\n    background: #4f46e5;\n    color: white;\n    border: none;\n    font-weight: 700;\n    font-size: 13px;\n    padding: 9px 20px;\n    border-radius: 10px;\n    cursor: pointer;\n  }\n  .btn-check-m:hover { background: #4338ca; }\n  .btn-reset-m {\n    background: #f1f5f9;\n    color: #64748b;\n    border: none;\n    font-size: 16px;\n    padding: 8px 12px;\n    border-radius: 10px;\n    cursor: pointer;\n  }\n</style>\n\n<div class=\"match-wrap\">\n  <div class=\"header-box\">\n    <div>\n      <span class=\"badge-tag\">Part 2 • Questions & Answers</span>\n      <h2 style=\"font-size: 20px; font-weight: 800; margin: 4px 0 0 0;\">Match Questions 1–8 to Answers a)–h)</h2>\n    </div>\n    <div id=\"scoreP2\" style=\"font-weight: 700; font-size: 13px; color: #64748b; background: #f8fafc; padding: 6px 14px; border-radius: 20px; border: 1px solid #e2e8f0;\">\n      Score: 0 / 7\n    </div>\n  </div>\n\n  <!-- Banco de Respuestas a) - h) -->\n  <div class=\"answers-grid\">\n    <div class=\"ans-card\"><strong>a)</strong> Three or four years.</div>\n    <div class=\"ans-card\"><strong>b)</strong> Every weekend. I love films.</div>\n    <div class=\"ans-card\"><strong>c)</strong> My brother – he's a musician in a band.</div>\n    <div class=\"ans-card\"><strong>d)</strong> Essex in England.</div>\n    <div class=\"ans-card\"><strong>e)</strong> About three years ago – it was a lovely wedding.</div>\n    <div class=\"ans-card\"><strong>f)</strong> French and a little Spanish. (Example)</div>\n    <div class=\"ans-card\"><strong>g)</strong> I want to get a better job.</div>\n    <div class=\"ans-card\"><strong>h)</strong> One brother and one sister.</div>\n  </div>\n\n  <!-- Lista de Preguntas con Selector -->\n  <div class=\"match-list\">\n    <!-- Ejemplo 1 -->\n    <div class=\"match-item\" style=\"background:#f1f5f9; border-style:dashed;\">\n      <span class=\"q-text\" style=\"color:#64748b;\">1. What languages do you speak?</span>\n      <select class=\"match-select is-correct\" disabled>\n        <option>f)</option>\n      </select>\n    </div>\n\n    <!-- 2 -->\n    <div class=\"match-item\">\n      <span class=\"q-text\">2. Where does Jamie Oliver come from?</span>\n      <select class=\"match-select p2-field\" data-answer=\"d\">\n        <option value=\"\">--</option>\n        <option value=\"a\">a)</option><option value=\"b\">b)</option><option value=\"c\">c)</option>\n        <option value=\"d\">d)</option><option value=\"e\">e)</option><option value=\"g\">g)</option><option value=\"h\">h)</option>\n      </select>\n    </div>\n\n    <!-- 3 -->\n    <div class=\"match-item\">\n      <span class=\"q-text\">3. Who has the most interesting job you know?</span>\n      <select class=\"match-select p2-field\" data-answer=\"c\">\n        <option value=\"\">--</option>\n        <option value=\"a\">a)</option><option value=\"b\">b)</option><option value=\"c\">c)</option>\n        <option value=\"d\">d)</option><option value=\"e\">e)</option><option value=\"g\">g)</option><option value=\"h\">h)</option>\n      </select>\n    </div>\n\n    <!-- 4 -->\n    <div class=\"match-item\">\n      <span class=\"q-text\">4. When did she get married?</span>\n      <select class=\"match-select p2-field\" data-answer=\"e\">\n        <option value=\"\">--</option>\n        <option value=\"a\">a)</option><option value=\"b\">b)</option><option value=\"c\">c)</option>\n        <option value=\"d\">d)</option><option value=\"e\">e)</option><option value=\"g\">g)</option><option value=\"h\">h)</option>\n      </select>\n    </div>\n\n    <!-- 5 -->\n    <div class=\"match-item\">\n      <span class=\"q-text\">5. Why are you studying English?</span>\n      <select class=\"match-select p2-field\" data-answer=\"g\">\n        <option value=\"\">--</option>\n        <option value=\"a\">a)</option><option value=\"b\">b)</option><option value=\"c\">c)</option>\n        <option value=\"d\">d)</option><option value=\"e\">e)</option><option value=\"g\">g)</option><option value=\"h\">h)</option>\n      </select>\n    </div>\n\n    <!-- 6 -->\n    <div class=\"match-item\">\n      <span class=\"q-text\">6. How long is a university degree course in England?</span>\n      <select class=\"match-select p2-field\" data-answer=\"a\">\n        <option value=\"\">--</option>\n        <option value=\"a\">a)</option><option value=\"b\">b)</option><option value=\"c\">c)</option>\n        <option value=\"d\">d)</option><option value=\"e\">e)</option><option value=\"g\">g)</option><option value=\"h\">h)</option>\n      </select>\n    </div>\n\n    <!-- 7 -->\n    <div class=\"match-item\">\n      <span class=\"q-text\">7. How many brothers and sisters have you got?</span>\n      <select class=\"match-select p2-field\" data-answer=\"h\">\n        <option value=\"\">--</option>\n        <option value=\"a\">a)</option><option value=\"b\">b)</option><option value=\"c\">c)</option>\n        <option value=\"d\">d)</option><option value=\"e\">e)</option><option value=\"g\">g)</option><option value=\"h\">h)</option>\n      </select>\n    </div>\n\n    <!-- 8 -->\n    <div class=\"match-item\">\n      <span class=\"q-text\">8. How often do you go to the cinema?</span>\n      <select class=\"match-select p2-field\" data-answer=\"b\">\n        <option value=\"\">--</option>\n        <option value=\"a\">a)</option><option value=\"b\">b)</option><option value=\"c\">c)</option>\n        <option value=\"d\">d)</option><option value=\"e\">e)</option><option value=\"g\">g)</option><option value=\"h\">h)</option>\n      </select>\n    </div>\n  </div>\n\n  <div class=\"footer-acts\">\n    <button onclick=\"checkP2()\" class=\"btn-check-m\">✓ Check Answers</button>\n    <button onclick=\"resetP2()\" class=\"btn-reset-m\" title=\"Reset\">🔄</button>\n  </div>\n</div>\n\n<script>\n  function checkP2() {\n    const selects = document.querySelectorAll('.p2-field');\n    let correct = 0;\n    selects.forEach(sel => {\n      sel.classList.remove('is-correct', 'is-wrong');\n      if (sel.value === sel.dataset.answer) {\n        sel.classList.add('is-correct');\n        correct++;\n      } else if (sel.value !== '') {\n        sel.classList.add('is-wrong');\n      }\n    });\n\n    const badge = document.getElementById('scoreP2');\n    if (badge) {\n      badge.textContent = `Score: ${correct} / ${selects.length}`;\n      badge.style.color = correct === selects.length ? '#15803d' : '#475569';\n      badge.style.background = correct === selects.length ? '#dcfce7' : '#f8fafc';\n    }\n  }\n\n  function resetP2() {\n    document.querySelectorAll('.p2-field').forEach(sel => {\n      sel.value = '';\n      sel.classList.remove('is-correct', 'is-wrong');\n    });\n    const badge = document.getElementById('scoreP2');\n    if (badge) {\n      badge.textContent = 'Score: 0 / 7';\n      badge.style.color = '#475569';\n      badge.style.background = '#f8fafc';\n    }\n  }\n</script>"
    }
  ]
}