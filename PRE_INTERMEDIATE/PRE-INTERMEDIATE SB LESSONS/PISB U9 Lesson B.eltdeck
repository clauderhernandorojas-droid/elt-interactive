{
  "version": "2.0",
  "title": "PISB U9 Lesson B",
  "updatedAt": "2026-10-29T19:18:36.931Z",
  "slides": [
    {
      "id": 1793296757494,
      "title": "Vocabulary: Adjectives to Describe Feelings",
      "html": "<style>\n  .vocab-card {\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n    max-width: 880px;\n    margin: 0 auto;\n    padding: 24px;\n    background: #ffffff;\n    border-radius: 20px;\n    border: 1px solid #e2e8f0;\n    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);\n    color: #0f172a;\n  }\n  .vocab-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    border-bottom: 2px solid #f1f5f9;\n    padding-bottom: 16px;\n    margin-bottom: 20px;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n  .tag-badge {\n    background: #eef2ff;\n    color: #4f46e5;\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    padding: 4px 10px;\n    border-radius: 6px;\n    letter-spacing: 0.5px;\n  }\n  .progress-pill {\n    background: #f8fafc;\n    border: 1px solid #cbd5e1;\n    color: #475569;\n    font-weight: 700;\n    font-size: 13px;\n    padding: 6px 14px;\n    border-radius: 20px;\n  }\n\n  /* Grid del Checklist */\n  .checklist-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\n    gap: 10px;\n    margin-bottom: 24px;\n  }\n  .check-item {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 10px 14px;\n    background: #f8fafc;\n    border: 1.5px solid #e2e8f0;\n    border-radius: 12px;\n    cursor: pointer;\n    user-select: none;\n    transition: all 0.2s ease;\n  }\n  .check-item:hover {\n    border-color: #cbd5e1;\n    background: #f1f5f9;\n  }\n  .check-item.checked {\n    background: #ecfdf5;\n    border-color: #10b981;\n    color: #065f46;\n  }\n  .check-item input[type=\"checkbox\"] {\n    width: 18px;\n    height: 18px;\n    accent-color: #10b981;\n    cursor: pointer;\n  }\n  .word-text {\n    font-size: 14px;\n    font-weight: 600;\n  }\n\n  /* Acordeón de Glosario V9.2 */\n  .ref-details {\n    background: #ffffff;\n    border: 1.5px solid #e2e8f0;\n    border-radius: 14px;\n    overflow: hidden;\n    margin-top: 20px;\n    transition: border-color 0.2s;\n  }\n  .ref-details:hover {\n    border-color: #cbd5e1;\n  }\n  .ref-summary {\n    padding: 14px 18px;\n    font-size: 14px;\n    font-weight: 700;\n    color: #1e293b;\n    cursor: pointer;\n    background: #f8fafc;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    user-select: none;\n    list-style: none;\n  }\n  .ref-summary::after {\n    content: \"▼\";\n    font-size: 10px;\n    color: #64748b;\n    transition: transform 0.2s;\n  }\n  details[open] .ref-summary::after {\n    transform: rotate(180deg);\n  }\n  .ref-content {\n    padding: 18px;\n    background: #ffffff;\n    border-top: 1px solid #e2e8f0;\n  }\n\n  /* Diccionario de Definiciones */\n  .def-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));\n    gap: 12px;\n    margin-bottom: 20px;\n  }\n  .def-card {\n    background: #f8fafc;\n    border: 1px solid #e2e8f0;\n    border-radius: 10px;\n    padding: 12px 14px;\n    font-size: 13px;\n    line-height: 1.5;\n  }\n  .def-word {\n    color: #4f46e5;\n    font-weight: 800;\n    font-size: 14px;\n    margin-bottom: 4px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .def-phonetic {\n    font-size: 11px;\n    color: #64748b;\n    font-weight: 500;\n  }\n  .def-example {\n    color: #475569;\n    font-style: italic;\n    margin-top: 4px;\n    display: block;\n  }\n\n  /* Cuadro de TIPS! */\n  .tips-box {\n    background: #fffbeb;\n    border: 1.5px solid #fde68a;\n    border-radius: 12px;\n    padding: 14px 18px;\n    font-size: 13px;\n    color: #92400e;\n    line-height: 1.6;\n  }\n</style>\n\n<div class=\"vocab-card\">\n  <!-- Cabecera -->\n  <div class=\"vocab-header\">\n    <div>\n      <span class=\"tag-badge\">Vocabulary • Lesson 1A</span>\n      <h2 style=\"font-size: 22px; font-weight: 800; margin: 6px 0 2px 0;\">Adjectives to Describe Feelings</h2>\n      <p style=\"font-size: 13px; color: #64748b; margin: 0;\">1 a) Tick the words you know. Check new words in V9.2.</p>\n    </div>\n    <div class=\"progress-pill\" id=\"knownCount\">\n      Known: 0 / 19\n    </div>\n  </div>\n\n  <!-- Checklist no calificable de autoevaluación -->\n  <div class=\"checklist-grid\" id=\"checklist\">\n    <!-- Generado dinámicamente -->\n  </div>\n\n  <!-- Sección desplegable oculta al inicio -->\n  <details class=\"ref-details\">\n    <summary class=\"ref-summary\">\n      <span>📖 Open Vocabulary Bank (V9.2 p137): Definitions & Tips</span>\n    </summary>\n    <div class=\"ref-content\">\n      \n      <!-- Definiciones oficiales de las imágenes 2 y 3 -->\n      <div class=\"def-grid\">\n        <div class=\"def-card\">\n          <div class=\"def-word\">stressed</div>\n          <div>worried and not able to relax.</div>\n          <span class=\"def-example\">\"He's very stressed about work.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">depressed</div>\n          <div>very unhappy, often for a long time.</div>\n          <span class=\"def-example\">\"He was very depressed when his wife left him.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">angry</div>\n          <div>a strong negative feeling you have which makes you want to shout at someone.</div>\n          <span class=\"def-example\">\"I'm really angry with my husband! He forgot my birthday!\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">pleased</div>\n          <div>happy about something that happened.</div>\n          <span class=\"def-example\">\"I'm pleased you enjoyed it.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">embarrassed <span class=\"def-phonetic\">/ɪmˈbærəst/</span></div>\n          <div>feel stupid because of something you did or something that happened.</div>\n          <span class=\"def-example\">\"I couldn't remember your father's name! I was so embarrassed.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">satisfied</div>\n          <div>pleased because you have got what you wanted.</div>\n          <span class=\"def-example\">\"He's very satisfied with his new car.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">guilty <span class=\"def-phonetic\">/ˈɡɪlti/</span></div>\n          <div>feel very bad about something you did wrong.</div>\n          <span class=\"def-example\">\"He felt guilty about leaving them on their own.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">upset</div>\n          <div>unhappy or worried because something bad has happened.</div>\n          <span class=\"def-example\">\"She got very upset when I told her the bad news.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">lonely</div>\n          <div>unhappy because you don't have any friends or anyone to talk to.</div>\n          <span class=\"def-example\">\"I was quite lonely when I was a child.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">nervous <span class=\"def-phonetic\">/ˈnɜːrvəs/</span></div>\n          <div>worried because of something that's going to happen.</div>\n          <span class=\"def-example\">\"I always get nervous before exams.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">confident</div>\n          <div>certain that you can do things well.</div>\n          <span class=\"def-example\">\"You have to be confident to be a salesman.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">fed up</div>\n          <div>annoyed or bored because you have done something for too long.</div>\n          <span class=\"def-example\">\"I'm fed up with my job.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">sad</div>\n          <div>unhappy.</div>\n          <span class=\"def-example\">\"I was sad to hear you lost your job.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">calm <span class=\"def-phonetic\">/kɑːm/</span></div>\n          <div>relaxed and peaceful.</div>\n          <span class=\"def-example\">\"I always feel very calm after yoga.\"</span>\n        </div>\n\n        <div class=\"def-card\">\n          <div class=\"def-word\">annoyed</div>\n          <div>a bit angry.</div>\n          <span class=\"def-example\">\"I get annoyed when people talk at the cinema.\"</span>\n        </div>\n\n        <div class=\"def-card\" style=\"background:#f1f5f9; border-style:dashed;\">\n          <div class=\"def-word\" style=\"color:#64748b;\">bored, worried, excited, tired</div>\n          <div>Basic feeling adjectives reviewed in previous units (see V4.4).</div>\n        </div>\n      </div>\n\n      <!-- Cuadro de TIPS! -->\n      <div class=\"tips-box\">\n        <strong>TIPS!</strong>\n        <ul style=\"margin: 6px 0 0 18px; padding: 0;\">\n          <li>We can also use these <strong>-ing adjectives</strong> to describe things, situations, places or people: <em>depressing, pleasing, embarrassing, satisfying, annoying, boring, worrying, exciting, tiring</em>.</li>\n          <li>We say a situation is <strong>stressful</strong> not <span style=\"text-decoration: line-through;\">stressing</span>.</li>\n        </ul>\n      </div>\n\n    </div>\n  </details>\n</div>\n\n<script>\n  window.ACTIVITY_METRICS = {\n    domain: 'Vocabulary',\n    skill: 'adjectives_to_describe_feelings',\n    maxScore: 19\n  };\n\n  const words = [\n    \"bored\", \"worried\", \"stressed\", \"excited\", \"depressed\",\n    \"angry\", \"pleased\", \"embarrassed\", \"tired\", \"satisfied\",\n    \"guilty\", \"upset\", \"lonely\", \"nervous\", \"confident\",\n    \"fed up\", \"sad\", \"calm\", \"annoyed\"\n  ];\n\n  function renderChecklist() {\n    const container = document.getElementById('checklist');\n    container.innerHTML = words.map((w, idx) => `\n      <label class=\"check-item\" id=\"item_${idx}\">\n        <input type=\"checkbox\" onchange=\"toggleWord(${idx})\">\n        <span class=\"word-text\">${w}</span>\n      </label>\n    `).join('');\n  }\n\n  function toggleWord(idx) {\n    const item = document.getElementById(`item_${idx}`);\n    const cb = item.querySelector('input');\n    if (cb.checked) {\n      item.classList.add('checked');\n    } else {\n      item.classList.remove('checked');\n    }\n    updateCount();\n  }\n\n  function updateCount() {\n    const checked = document.querySelectorAll('.checklist-grid input:checked').length;\n    const badge = document.getElementById('knownCount');\n    if (badge) {\n      badge.textContent = `Known: ${checked} / ${words.length}`;\n      badge.style.background = checked > 0 ? '#ecfdf5' : '#f8fafc';\n      badge.style.borderColor = checked > 0 ? '#a7f3d0' : '#cbd5e1';\n      badge.style.color = checked > 0 ? '#065f46' : '#475569';\n    }\n\n    // Notifica el progreso sin penalizar al alumno (es autoevaluación)\n    window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n      detail: {\n        metrics: window.ACTIVITY_METRICS,\n        score: checked,\n        total: words.length,\n        completed: checked === words.length\n      }\n    }));\n  }\n\n  renderChecklist();\n</script>"
    },
    {
      "id": 1793297628562,
      "title": "Feelings and Emotions - Vocabulary Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Feelings and Emotions - Vocabulary Practice</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom smooth drag and drop styles */\n    .draggable-card {\n      touch-action: none;\n      user-select: none;\n      cursor: grab;\n    }\n    .draggable-card:active {\n      cursor: grabbing;\n    }\n    .drop-zone {\n      min-height: 140px;\n      transition: all 0.2s ease-in-out;\n    }\n    .drop-zone.drag-over {\n      background-color: rgba(59, 130, 246, 0.08);\n      border-color: #3b82f6;\n      transform: scale(1.01);\n    }\n    @keyframes pulse-subtle {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.7; }\n    }\n    .animate-pulse-subtle {\n      animation: pulse-subtle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Header / Metric Bar -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 sm:px-8 border-b border-slate-200 shadow-sm w-full\">\n    <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n      <div class=\"flex items-center space-x-3\">\n        <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm flex items-center justify-center\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n          </svg>\n        </div>\n        <div>\n          <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Feelings & Emotions</h1>\n          <p class=\"text-xs text-slate-500\">Classify the vocabulary into positive and negative feelings</p>\n        </div>\n      </div>\n\n      <div class=\"flex items-center space-x-3\">\n        <div id=\"score-badge\" class=\"bg-indigo-50 border border-indigo-200 text-indigo-700 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold flex items-center shadow-inner\">\n          <span class=\"mr-1.5\">Score:</span>\n          <span id=\"score-display\">0</span> / <span id=\"total-display\">18</span>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Activity Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-auto\">\n    <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-8\">\n      \n      <!-- Instructions / Task Prompt -->\n      <div class=\"mb-6 bg-slate-50 border-l-4 border-indigo-500 p-4 rounded-r-xl\">\n        <h2 class=\"text-sm font-bold text-indigo-900 uppercase tracking-wider mb-1\">Vocabulary Task</h2>\n        <p class=\"text-sm text-slate-700\">\n          Work in pairs or individually. Drag and drop each feeling into the correct category (<strong class=\"text-emerald-700\">Positive feelings</strong> or <strong class=\"text-rose-700\">Negative feelings</strong>), or click a word then click a category!\n        </p>\n      </div>\n\n      <!-- Word Bank Container -->\n      <div class=\"mb-8\">\n        <div class=\"flex items-center justify-between mb-2\">\n          <span class=\"text-xs font-bold uppercase text-slate-400 tracking-wider\">Word Bank (<span id=\"remaining-count\">18</span> words remaining)</span>\n          <button id=\"audio-pronounce-tip\" onclick=\"playPronunciationTip()\" class=\"text-xs text-indigo-600 hover:text-indigo-800 font-medium flex items-center gap-1 transition-colors\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\" />\n            </svg>\n            Pronunciation tip\n          </button>\n        </div>\n        \n        <div id=\"word-bank\" class=\"flex flex-wrap gap-2.5 p-4 bg-slate-100/70 border border-slate-200 rounded-xl min-h-[90px] items-center justify-center\">\n          <!-- Dynamically injected draggable words -->\n        </div>\n      </div>\n\n      <!-- Categories Grid -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-8\">\n        \n        <!-- Positive Category Dropzone -->\n        <div class=\"flex flex-col h-full\">\n          <div class=\"bg-emerald-600 text-white font-bold py-2.5 px-4 rounded-t-xl flex items-center justify-between shadow-sm\">\n            <span class=\"flex items-center gap-2\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n              </svg>\n              Positive Feelings\n            </span>\n            <span id=\"positive-count\" class=\"bg-emerald-700 text-xs px-2.5 py-1 rounded-full\">0 / 5</span>\n          </div>\n          <div id=\"drop-positive\" data-category=\"positive\" class=\"drop-zone flex-grow bg-emerald-50/40 border-2 border-dashed border-emerald-300 rounded-b-xl p-4 flex flex-wrap content-start gap-2 min-h-[180px]\">\n            <p class=\"w-full text-center text-xs text-emerald-600 italic mt-6 pointer-events-none drop-placeholder\">Drop positive feelings here...</p>\n          </div>\n        </div>\n\n        <!-- Negative Category Dropzone -->\n        <div class=\"flex flex-col h-full\">\n          <div class=\"bg-rose-600 text-white font-bold py-2.5 px-4 rounded-t-xl flex items-center justify-between shadow-sm\">\n            <span class=\"flex items-center gap-2\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n              </svg>\n              Negative Feelings\n            </span>\n            <span id=\"negative-count\" class=\"bg-rose-700 text-xs px-2.5 py-1 rounded-full\">0 / 13</span>\n          </div>\n          <div id=\"drop-negative\" data-category=\"negative\" class=\"drop-zone flex-grow bg-rose-50/40 border-2 border-dashed border-rose-300 rounded-b-xl p-4 flex flex-wrap content-start gap-2 min-h-[180px]\">\n            <p class=\"w-full text-center text-xs text-rose-600 italic mt-6 pointer-events-none drop-placeholder\">Drop negative feelings here...</p>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-200\">\n        <button onclick=\"resetActivity()\" class=\"w-full sm:w-auto px-5 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-xl text-sm transition-all flex items-center justify-center gap-2 min-h-[42px]\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n          </svg>\n          Reset Activity\n        </button>\n\n        <button onclick=\"checkAnswers()\" class=\"w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-sm transition-all shadow-md hover:shadow flex items-center justify-center gap-2 min-h-[42px]\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n          </svg>\n          Check Answers\n        </button>\n      </div>\n\n      <!-- Feedback Banner -->\n      <div id=\"feedback-banner\" class=\"hidden mt-6 p-4 rounded-xl text-sm font-medium text-center transition-all\"></div>\n\n    </div>\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"text-center py-4 text-xs text-slate-400 border-t border-slate-200 bg-white\">\n    English ELT Interactive Material • Vocabulary Builder\n  </footer>\n\n  <!-- Application Logic -->\n  <script>\n    // Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'feelings_and_emotions_classification',\n      maxScore: 18\n    };\n\n    // Vocabulary Dataset based on OCR source\n    const vocabularyData = [\n      { word: 'excited', category: 'positive' },\n      { word: 'pleased', category: 'positive' },\n      { word: 'calm', category: 'positive' },\n      { word: 'satisfied', category: 'positive' },\n      { word: 'confident', category: 'positive' },\n      { word: 'bored', category: 'negative' },\n      { word: 'worried', category: 'negative' },\n      { word: 'stressed', category: 'negative' },\n      { word: 'depressed', category: 'negative' },\n      { word: 'angry', category: 'negative' },\n      { word: 'embarrassed', category: 'negative' },\n      { word: 'tired', category: 'negative' },\n      { word: 'guilty', category: 'negative' },\n      { word: 'upset', category: 'negative' },\n      { word: 'lonely', category: 'negative' },\n      { word: 'nervous', category: 'negative' },\n      { word: 'fed up', category: 'negative' },\n      { word: 'sad', category: 'negative' },\n      { word: 'annoyed', category: 'negative' } // Note: 19 total words in source list (5 positive, 14 negative). Let's adjust total to 19!\n    ];\n\n    // Adjust maxScore to actual item count (19 items)\n    window.ACTIVITY_METRICS.maxScore = vocabularyData.length;\n\n    let selectedCard = null;\n    let draggedElement = null;\n\n    function initActivity() {\n      document.getElementById('total-display').textContent = vocabularyData.length;\n      document.getElementById('negative-count').textContent = `0 / ${vocabularyData.filter(i => i.category === 'negative').length}`;\n      document.getElementById('positive-count').textContent = `0 / ${vocabularyData.filter(i => i.category === 'positive').length}`;\n      \n      const wordBank = document.getElementById('word-bank');\n      wordBank.innerHTML = '';\n      \n      const posZone = document.getElementById('drop-positive');\n      const negZone = document.getElementById('drop-negative');\n      \n      posZone.innerHTML = '<p class=\"w-full text-xs text-emerald-600 italic mt-6 pointer-events-none drop-placeholder\">Drop positive feelings here...</p>';\n      negZone.innerHTML = '<p class=\"w-full text-xs text-rose-600 italic mt-6 pointer-events-none drop-placeholder\">Drop negative feelings here...</p>';\n\n      // Shuffle items for replayability\n      const shuffled = [...vocabularyData].sort(() => Math.random() - 0.5);\n\n      shuffled.forEach((item, index) => {\n        const card = document.createElement('div');\n        card.className = 'draggable-card bg-white border border-slate-300 hover:border-indigo-400 hover:shadow-sm text-slate-700 font-medium px-3.5 py-2 rounded-xl text-sm transition-all select-none flex items-center gap-1.5 min-h-[42px]';\n        card.draggable = true;\n        card.dataset.word = item.word;\n        card.dataset.category = item.category;\n        card.id = `word-${index}`;\n        \n        card.innerHTML = `\n          <span>${item.word}</span>\n        `;\n\n        // Touch & Drag events\n        card.addEventListener('dragstart', handleDragStart);\n        card.addEventListener('dragend', handleDragEnd);\n\n        // Click-to-select fallback for mobile accessibility\n        card.addEventListener('click', (e) => {\n          e.stopPropagation();\n          selectCard(card);\n        });\n\n        wordBank.appendChild(card);\n      });\n\n      updateRemainingCount();\n      document.getElementById('feedback-banner').className = 'hidden mt-6 p-4 rounded-xl text-sm font-medium text-center transition-all';\n    }\n\n    // Drag and Drop Handlers\n    function handleDragStart(e) {\n      draggedElement = this;\n      setTimeout(() => this.classList.add('opacity-40'), 0);\n      e.dataTransfer.setData('text/plain', this.dataset.word);\n    }\n\n    function handleDragEnd(e) {\n      this.classList.remove('opacity-40');\n      draggedElement = null;\n      document.querySelectorAll('.drop-zone').forEach(z => z.classList.remove('drag-over'));\n    }\n\n    // Drop zone setup\n    const dropZones = document.querySelectorAll('.drop-zone');\n    dropZones.forEach(zone => {\n      zone.addEventListener('dragover', (e) => {\n        e.preventDefault();\n        zone.classList.add('drag-over');\n      });\n\n      zone.addEventListener('dragleave', () => {\n        zone.classList.remove('drag-over');\n      });\n\n      zone.addEventListener('drop', (e) => {\n        e.preventDefault();\n        zone.classList.remove('drag-over');\n        if (draggedElement) {\n          moveCardToZone(draggedElement, zone);\n        }\n      });\n\n      // Tap-to-place fallback listener\n      zone.addEventListener('click', () => {\n        if (selectedCard) {\n          moveCardToZone(selectedCard, zone);\n          deselectAllCards();\n        }\n      });\n    });\n\n    function selectCard(card) {\n      if (card.classList.contains('bg-indigo-50')) {\n        deselectAllCards();\n        return;\n      }\n      deselectAllCards();\n      selectedCard = card;\n      card.classList.add('ring-2', 'ring-indigo-500', 'bg-indigo-50', 'border-indigo-300');\n    }\n\n    function deselectAllCards() {\n      document.querySelectorAll('.draggable-card').forEach(c => {\n        c.classList.remove('ring-2', 'ring-indigo-500', 'bg-indigo-50', 'border-indigo-300');\n      });\n      selectedCard = null;\n    }\n\n    function moveCardToZone(card, zone) {\n      const placeholder = zone.querySelector('.drop-placeholder');\n      if (placeholder) placeholder.remove();\n      \n      zone.appendChild(card);\n      card.classList.remove('ring-2', 'ring-indigo-500', 'bg-indigo-50', 'border-indigo-300');\n      updateRemainingCount();\n      updateCategoryCounts();\n    }\n\n    function updateRemainingCount() {\n      const wordBank = document.getElementById('word-bank');\n      const cards = wordBank.querySelectorAll('.draggable-card');\n      document.getElementById('remaining-count').textContent = cards.length;\n      if (cards.length === 0 && !wordBank.querySelector('.bank-placeholder')) {\n        const ph = document.createElement('p');\n        ph.className = 'w-full text-center text-xs text-slate-400 italic bank-placeholder py-2';\n        ph.textContent = 'All words placed! Click \"Check Answers\" when ready.';\n        wordBank.appendChild(ph);\n      } else if (cards.length > 0) {\n        const ph = wordBank.querySelector('.bank-placeholder');\n        if (ph) ph.remove();\n      }\n    }\n\n    function updateCategoryCounts() {\n      const posCount = document.getElementById('drop-positive').querySelectorAll('.draggable-card').length;\n      const negCount = document.getElementById('drop-negative').querySelectorAll('.draggable-card').length;\n      \n      const totalPos = vocabularyData.filter(i => i.category === 'positive').length;\n      const totalNeg = vocabularyData.filter(i => i.category === 'negative').length;\n\n      document.getElementById('positive-count').textContent = `${posCount} / ${totalPos}`;\n      document.getElementById('negative-count').textContent = `${negCount} / ${totalNeg}`;\n    }\n\n    function checkAnswers() {\n      let correctCount = 0;\n      let totalChecked = 0;\n\n      dropZones.forEach(zone => {\n        const targetCategory = zone.dataset.category;\n        const cards = zone.querySelectorAll('.draggable-card');\n\n        cards.forEach(card => {\n          totalChecked++;\n          card.classList.remove('border-emerald-500', 'bg-emerald-50', 'border-rose-500', 'bg-rose-50');\n          \n          if (card.dataset.category === targetCategory) {\n            correctCount++;\n            card.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n          } else {\n            card.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n          }\n        });\n      });\n\n      // Update score display\n      document.getElementById('score-display').textContent = correctCount;\n\n      // Show Feedback Banner\n      const feedback = document.getElementById('feedback-banner');\n      feedback.classList.remove('hidden');\n\n      if (correctCount === vocabularyData.length && totalChecked === vocabularyData.length) {\n        feedback.className = 'mt-6 p-4 rounded-xl text-sm font-semibold text-center bg-emerald-100 text-emerald-800 border border-emerald-300';\n        feedback.innerHTML = '🎉 Excellent job! All feelings correctly classified!';\n      } else {\n        feedback.className = 'mt-6 p-4 rounded-xl text-sm font-semibold text-center bg-amber-100 text-amber-800 border border-amber-300';\n        feedback.innerHTML = `You got ${correctCount} out of ${vocabularyData.length} correct. Review items marked in red and try again!`;\n      }\n\n      // Dispatch pedagogical metrics event\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: vocabularyData.length,\n          completed: correctCount === vocabularyData.length\n        }\n      }));\n\n      // Post message for external iframe wrappers if any\n      if (window.parent !== window) {\n        window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: vocabularyData.length }, '*');\n      }\n    }\n\n    function resetActivity() {\n      initActivity();\n      document.getElementById('score-display').textContent = '0';\n    }\n\n    function playPronunciationTip() {\n      if ('speechSynthesis' in window) {\n        const utterance = new SpeechSynthesisUtterance(\"Listen carefully to the word stress. For example: em-bar-rassed, de-pressed, con-fi-dent.\");\n        utterance.rate = 0.9;\n        window.speechSynthesis.speak(utterance);\n      } else {\n        alert(\"Pronunciation tip: Pay attention to word stress on multi-syllable feelings like e-mbar-rassed and con-fi-dent.\");\n      }\n    }\n\n    // Initialize on load\n    window.addEventListener('DOMContentLoaded', initActivity);\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793297966665,
      "title": "Feelings & Adjectives Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Feelings & Adjectives Practice</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n        }\n        .adjective-chip {\n            transition: all 0.2s ease-in-out;\n            cursor: pointer;\n            user-select: none;\n        }\n        .adjective-chip:hover {\n            transform: translateY(-2px);\n        }\n        .adjective-chip.selected {\n            background-color: #0284c7;\n            color: white;\n            border-color: #0284c7;\n            box-shadow: 0 4px 6px -1px rgba(2, 132, 199, 0.2), 0 2px 4px -1px rgba(2, 132, 199, 0.1);\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between py-6 px-3 sm:px-6\">\n\n    <!-- Sticky Header / Score bar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full max-w-4xl mx-auto mb-6 shadow-sm rounded-xl flex items-center justify-between\">\n        <div class=\"flex items-center space-x-2\">\n            <span class=\"bg-sky-100 text-sky-800 p-2 rounded-lg text-sm font-semibold flex items-center gap-1\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                </svg>\n                Vocabulary Practice\n            </span>\n        </div>\n        <div class=\"flex items-center space-x-3\">\n            <div id=\"score-display\" class=\"text-sm font-semibold bg-slate-100 px-3 py-1.5 rounded-lg text-slate-700\">\n                Selected: <span id=\"selected-count\" class=\"text-sky-600 font-bold\">0</span> / 6\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm p-4 sm:p-6 md:p-8 flex-grow mb-6\">\n        \n        <!-- Instructions Section -->\n        <div class=\"mb-6 bg-sky-50/50 border-l-4 border-sky-500 p-4 rounded-r-xl\">\n            <h1 class=\"text-lg sm:text-xl font-bold text-slate-900 mb-1\">Choose six adjectives</h1>\n            <p class=\"text-sm sm:text-base text-slate-600\">\n                Select six adjectives from the vocabulary box below. Then, write down situations or moments when you feel like this in the writing boxes provided.\n            </p>\n        </div>\n\n        <!-- Vocabulary Box (Recorte #2) -->\n        <div class=\"mb-8\">\n            <h2 class=\"text-xs uppercase tracking-wider text-slate-400 font-semibold mb-3\">Vocabulary Box (Click to select/deselect up to 6)</h2>\n            <div id=\"vocab-box\" class=\"bg-slate-100 p-4 sm:p-6 rounded-2xl border border-slate-200 flex flex-wrap gap-2.5 justify-center items-center\">\n                <!-- Injected via JS -->\n            </div>\n        </div>\n\n        <!-- Writing Activity Section (Recorte #1 & Prompt) -->\n        <div class=\"space-y-6\">\n            <div class=\"flex items-center justify-between border-b pb-2\">\n                <h2 class=\"text-base sm:text-lg font-semibold text-slate-800 flex items-center gap-2\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-sky-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z\" />\n                    </svg>\n                    When do you feel like this?\n                </h2>\n                <span class=\"text-xs text-slate-500\">Write your situations below</span>\n            </div>\n\n            <!-- Example row -->\n            <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center gap-3\">\n                <div class=\"bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium italic min-w-[130px] text-center\">\n                    before an exam\n                </div>\n                <div class=\"text-sm text-slate-500 flex-grow\">\n                    <span class=\"font-semibold text-slate-700\">Example situation:</span> I usually feel <span class=\"text-sky-600 font-medium\">stressed</span> or <span class=\"text-sky-600 font-medium\">nervous</span> before taking a difficult test.\n                </div>\n            </div>\n\n            <!-- Interactive Writing Rows (6 items) -->\n            <div id=\"writing-rows\" class=\"space-y-4\">\n                <!-- Generated dynamically via JS -->\n            </div>\n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"mt-8 pt-6 border-t flex flex-wrap items-center justify-between gap-4\">\n            <button id=\"reset-btn\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-medium text-sm transition flex items-center gap-2 min-h-[42px]\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                </svg>\n                Reset Activity\n            </button>\n            <button id=\"check-btn\" class=\"px-6 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-medium text-sm transition shadow-sm flex items-center gap-2 min-h-[42px]\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                Check Answers\n            </button>\n        </div>\n\n        <!-- Feedback alert -->\n        <div id=\"feedback-container\" class=\"mt-4 hidden p-4 rounded-xl text-sm font-medium text-center\"></div>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full max-w-4xl mx-auto text-center text-xs text-slate-400 py-2\">\n        Interactive ELT Lesson &bull; CEFR B1 Vocabulary\n    </footer>\n\n    <!-- Script Logic & Pedagogy Contract -->\n    <script>\n        // Mandatory Pedagogical Metrics Contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'expressing_feelings_and_adjectives',\n            maxScore: 6\n        };\n\n        const adjectives = [\n            \"bored\", \"worried\", \"stressed\",\n            \"excited\", \"depressed\", \"angry\",\n            \"pleased\", \"embarrassed\", \"tired\",\n            \"satisfied\", \"guilty\", \"upset\", \"lonely\",\n            \"nervous\", \"confident\", \"fed up\",\n            \"sad\", \"calm\", \"annoyed\"\n        ];\n\n        let selectedAdjectives = [];\n\n        const vocabBox = document.getElementById('vocab-box');\n        const writingRows = document.getElementById('writing-rows');\n        const selectedCountEl = document.getElementById('selected-count');\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const feedbackContainer = document.getElementById('feedback-container');\n\n        // Render Vocabulary Box\n        function renderVocabBox() {\n            vocabBox.innerHTML = '';\n            adjectives.forEach(adj => {\n                const chip = document.createElement('div');\n                chip.className = `adjective-chip px-3.5 py-2 rounded-xl text-sm font-medium bg-white border border-slate-300 text-slate-700 shadow-sm`;\n                chip.textContent = adj;\n                if (selectedAdjectives.includes(adj)) {\n                    chip.classList.add('selected');\n                }\n                chip.addEventListener('click', () => toggleAdjective(adj));\n                vocabBox.appendChild(chip);\n            });\n            selectedCountEl.textContent = selectedAdjectives.length;\n        }\n\n        // Render Writing Rows\n        function renderWritingRows() {\n            writingRows.innerHTML = '';\n            for (let i = 0; i < 6; i++) {\n                const currentAdj = selectedAdjectives[i] || '';\n                const row = document.createElement('div');\n                row.className = \"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 bg-slate-50/70 p-3.5 rounded-xl border border-slate-200\";\n                \n                row.innerHTML = `\n                    <div class=\"flex items-center gap-2 min-w-[180px]\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center shrink-0\">${i + 1}</span>\n                        <input type=\"text\" readonly value=\"${currentAdj}\" placeholder=\"Select adjective ${i+1}\" class=\"w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-700 font-medium focus:outline-none placeholder:text-slate-400 placeholder:font-normal\" />\n                    </div>\n                    <div class=\"flex-grow\">\n                        <input type=\"text\" data-answer=\"situation\" placeholder=\"Write when you feel like this (e.g. When I have too much work...)\" class=\"writing-input w-full bg-white border border-slate-300 rounded-lg px-3.5 py-2 text-sm text-slate-800 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none transition min-h-[42px]\" />\n                    </div>\n                `;\n                writingRows.appendChild(row);\n            }\n        }\n\n        function toggleAdjective(adj) {\n            if (selectedAdjectives.includes(adj)) {\n                selectedAdjectives = selectedAdjectives.filter(item => item !== adj);\n            } else {\n                if (selectedAdjectives.length < 6) {\n                    selectedAdjectives.push(adj);\n                } else {\n                    alert(\"You can only select up to 6 adjectives as requested in the instructions.\");\n                    return;\n                }\n            }\n            renderVocabBox();\n            renderWritingRows();\n        }\n\n        // Check Answers Logic\n        checkBtn.addEventListener('click', () => {\n            if (selectedAdjectives.length < 6) {\n                feedbackContainer.className = \"mt-4 p-4 rounded-xl text-sm font-medium text-center bg-amber-50 text-amber-800 border border-amber-200\";\n                feedbackContainer.textContent = `Please select 6 adjectives from the box first (You currently have ${selectedAdjectives.length}).`;\n                feedbackContainer.classList.remove('hidden');\n                return;\n            }\n\n            const inputs = document.querySelectorAll('.writing-input');\n            let filledCount = 0;\n\n            inputs.forEach(input => {\n                if (input.value.trim().length > 3) {\n                    filledCount++;\n                    input.classList.remove('border-red-300', 'bg-red-50');\n                    input.classList.add('border-emerald-500', 'bg-emerald-50/30');\n                } else {\n                    input.classList.remove('border-emerald-500', 'bg-emerald-50/30');\n                    input.classList.add('border-red-300', 'bg-red-50');\n                }\n            });\n\n            const score = filledCount;\n            const total = inputs.length;\n            const completed = (score === total);\n\n            if (completed) {\n                feedbackContainer.className = \"mt-4 p-4 rounded-xl text-sm font-medium text-center bg-emerald-50 text-emerald-800 border border-emerald-200\";\n                feedbackContainer.textContent = \"Fantastic! You've successfully chosen 6 adjectives and written situations for all of them.\";\n            } else {\n                feedbackContainer.className = \"mt-4 p-4 rounded-xl text-sm font-medium text-center bg-sky-50 text-sky-800 border border-sky-200\";\n                feedbackContainer.textContent = `Great job! You completed ${score} out of ${total} writing entries. Make sure all sentences are complete.`;\n            }\n            feedbackContainer.classList.remove('hidden');\n\n            // Dispatch mandatory custom event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: score,\n                    total: total,\n                    completed: completed\n                }\n            }));\n\n            // PostMessage to parent frame if embedded\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: score, total: total }, '*');\n            }\n        });\n\n        // Reset Activity\n        resetBtn.addEventListener('click', () => {\n            selectedAdjectives = [];\n            renderVocabBox();\n            renderWritingRows();\n            feedbackContainer.classList.add('hidden');\n        });\n\n        // Initial render\n        renderVocabBox();\n        renderWritingRows();\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793298401393,
      "title": "Guess the Adjectives - Speaking Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Guess the Adjectives - Speaking Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between p-4 sm:p-6 md:p-8\">\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col my-auto\">\n        \n        <!-- Header Banner -->\n        <header class=\"bg-indigo-600 text-white p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n            <div>\n                <span class=\"inline-block bg-indigo-500 text-indigo-100 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-2\">Speaking Practice</span>\n                <h1 class=\"text-2xl sm:text-3xl font-bold tracking-tight\">Guess the Adjectives</h1>\n            </div>\n            <div class=\"flex items-center gap-2 bg-indigo-700/60 px-4 py-2 rounded-xl text-sm font-medium border border-indigo-500/30\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-indigo-200\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\" />\n                </svg>\n                <span>Pair Work Activity</span>\n            </div>\n        </header>\n\n        <!-- Instructions Section -->\n        <section class=\"p-6 sm:p-8 border-b border-slate-100 bg-slate-50/50\">\n            <div class=\"flex items-start gap-4\">\n                <div class=\"bg-indigo-100 text-indigo-700 font-bold w-8 h-8 rounded-xl flex items-center justify-center shrink-0 mt-0.5\">b</div>\n                <div>\n                    <h2 class=\"text-lg font-semibold text-slate-900 mb-1\">Work in pairs. Swap papers. Take turns to guess the adjectives.</h2>\n                    <p class=\"text-sm text-slate-600\">Practice your speaking skills by asking questions using target adjectives and responding based on personal experience.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Interactive Content / Dialogues Example Section -->\n        <section class=\"p-6 sm:p-8 space-y-6\">\n            <h3 class=\"text-xs font-bold uppercase tracking-wider text-slate-400 mb-4\">Example Conversation Flow</h3>\n\n            <!-- Dialogue Pair 1 -->\n            <div class=\"space-y-3 p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/80\">\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold px-3 py-1 rounded-full\">Student A</span>\n                        <p class=\"text-base font-medium text-slate-800\">Do you feel <span class=\"text-rose-600 font-bold underline decoration-rose-300 underline-offset-4\">confident</span> before an exam?</p>\n                    </div>\n                    <span class=\"text-xs bg-slate-200 text-slate-600 px-2.5 py-1 rounded-md font-medium\">Question 1</span>\n                </div>\n                <div class=\"border-t border-slate-200/60 pt-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pl-0 sm:pl-6\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"bg-slate-200 text-slate-700 border border-slate-300 text-xs font-bold px-3 py-1 rounded-full\">Student B</span>\n                        <p class=\"text-base text-slate-700\">No, not usually.</p>\n                    </div>\n                    <span class=\"text-xs bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-md font-medium\">Response</span>\n                </div>\n            </div>\n\n            <!-- Dialogue Pair 2 -->\n            <div class=\"space-y-3 p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/80\">\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold px-3 py-1 rounded-full\">Student A</span>\n                        <p class=\"text-base font-medium text-slate-800\">Do you feel <span class=\"text-rose-600 font-bold underline decoration-rose-300 underline-offset-4\">nervous</span>?</p>\n                    </div>\n                    <span class=\"text-xs bg-slate-200 text-slate-600 px-2.5 py-1 rounded-md font-medium\">Question 2</span>\n                </div>\n                <div class=\"border-t border-slate-200/60 pt-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pl-0 sm:pl-6\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"bg-slate-200 text-slate-700 border border-slate-300 text-xs font-bold px-3 py-1 rounded-full\">Student B</span>\n                        <p class=\"text-base text-slate-700\">Yes, I do!</p>\n                    </div>\n                    <span class=\"text-xs bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-md font-medium\">Response</span>\n                </div>\n            </div>\n\n            <!-- Interactive Practice Builder (Task completion verification) -->\n            <div class=\"mt-8 pt-6 border-t border-slate-200\">\n                <div class=\"bg-indigo-50/50 border border-indigo-100 rounded-2xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4\">\n                    <div class=\"flex items-center gap-3\">\n                        <div class=\"w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold shadow-sm shrink-0\">✓</div>\n                        <div>\n                            <h4 class=\"font-semibold text-slate-900 text-sm sm:text-base\">Ready to practice with your partner?</h4>\n                            <p class=\"text-xs sm:text-sm text-slate-600\">Click the button below once you have completed your speaking turns.</p>\n                        </div>\n                    </div>\n                    <button id=\"completeBtn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold py-3 px-6 rounded-xl transition shadow-sm min-h-[44px] flex items-center justify-center gap-2 cursor-pointer\">\n                        <span>Mark Activity as Completed</span>\n                    </button>\n                </div>\n            </div>\n\n        </section>\n\n        <!-- Footer / Feedback Status Bar -->\n        <footer class=\"bg-slate-50 border-t border-slate-200 p-4 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500\">\n            <div class=\"flex items-center gap-2\">\n                <span id=\"statusIndicator\" class=\"w-3 h-3 rounded-full bg-amber-400 inline-block\"></span>\n                <span id=\"statusText\">Activity viewed & ready for speaking practice</span>\n            </div>\n            <div class=\"font-medium text-slate-600\">\n                Score: <span id=\"scoreDisplay\">1</span> / <span id=\"totalDisplay\">1</span>\n            </div>\n        </footer>\n\n    </main>\n\n    <script>\n        // Metadata & Metrics Contract for ELT platform tracking\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'speaking_interaction_adjectives',\n            maxScore: 1\n        };\n\n        const completeBtn = document.getElementById('completeBtn');\n        const statusIndicator = document.getElementById('statusIndicator');\n        const statusText = document.getElementById('statusText');\n        const scoreDisplay = document.getElementById('scoreDisplay');\n\n        let isCompleted = false;\n\n        completeBtn.addEventListener('click', () => {\n            isCompleted = true;\n            completeBtn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');\n            completeBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');\n            completeBtn.innerHTML = '<span>Great Job! Activity Completed</span>';\n            \n            statusIndicator.classList.remove('bg-amber-400');\n            statusIndicator.classList.add('bg-emerald-500');\n            statusText.textContent = 'Speaking activity successfully completed!';\n            scoreDisplay.textContent = '1';\n\n            // Dispatch mandatory event for parent frame integration\n            const metricsEvent = new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: 1,\n                    total: 1,\n                    completed: true\n                }\n            });\n            window.dispatchEvent(metricsEvent);\n\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: 1, total: 1 }, '*');\n            }\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793298524530,
      "title": "Listening and Grammar - Discussion Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Listening and Grammar - Discussion Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen py-6 px-3 sm:px-6\">\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden\">\n\n        <!-- HEADER SECTION -->\n        <header class=\"bg-gradient-to-r from-sky-600 to-indigo-700 text-white p-6 sm:p-8\">\n            <div class=\"flex items-center gap-3 mb-2\">\n                <span class=\"bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider\">Listening and Grammar</span>\n            </div>\n            <h1 class=\"text-2xl sm:text-3xl font-bold tracking-tight\">Group Discussion</h1>\n            <p class=\"text-sky-100 text-sm sm:text-base mt-1\">Reflect and discuss the following questions with your classmates.</p>\n        </header>\n\n        <!-- CONTENT SECTION -->\n        <section class=\"p-6 sm:p-8 space-y-6\">\n            \n            <!-- INSTRUCTION CARD -->\n            <div class=\"flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100\">\n                <div class=\"bg-sky-100 text-sky-700 font-bold w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg shadow-sm\">\n                    3\n                </div>\n                <div>\n                    <h2 class=\"text-lg font-semibold text-slate-900\">Work in groups. Discuss these questions.</h2>\n                    <p class=\"text-sm text-slate-500 mt-0.5\">Take turns sharing your personal opinions, experiences, and thoughts.</p>\n                </div>\n            </div>\n\n            <!-- DISCUSSION QUESTIONS LIST -->\n            <div class=\"grid grid-cols-1 gap-4\">\n\n                <!-- Question 1 -->\n                <article class=\"p-5 rounded-xl border border-slate-200 hover:border-sky-300 transition-colors bg-white shadow-sm flex gap-4 items-start\">\n                    <span class=\"flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 text-slate-700 font-semibold text-sm shrink-0\">1</span>\n                    <div class=\"space-y-2 w-full\">\n                        <h3 class=\"font-medium text-slate-900 text-base sm:text-lg\">What's the best age to have children? Why?</h3>\n                        <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100 text-sm text-slate-600 flex items-center gap-2\">\n                            <svg class=\"w-4 h-4 text-sky-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                            <span>Consider career stability, energy levels, and personal readiness.</span>\n                        </div>\n                    </div>\n                </article>\n\n                <!-- Question 2 -->\n                <article class=\"p-5 rounded-xl border border-slate-200 hover:border-sky-300 transition-colors bg-white shadow-sm flex gap-4 items-start\">\n                    <span class=\"flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 text-slate-700 font-semibold text-sm shrink-0\">2</span>\n                    <div class=\"space-y-2 w-full\">\n                        <h3 class=\"font-medium text-slate-900 text-base sm:text-lg\">How does your life change when you have your first baby, do you think?</h3>\n                        <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100 text-sm text-slate-600 flex items-center gap-2\">\n                            <svg class=\"w-4 h-4 text-sky-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                            <span>Think about daily routines, responsibilities, and free time.</span>\n                        </div>\n                    </div>\n                </article>\n\n                <!-- Question 3 -->\n                <article class=\"p-5 rounded-xl border border-slate-200 hover:border-sky-300 transition-colors bg-white shadow-sm flex gap-4 items-start\">\n                    <span class=\"flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 text-slate-700 font-semibold text-sm shrink-0\">3</span>\n                    <div class=\"space-y-2 w-full\">\n                        <h3 class=\"font-medium text-slate-900 text-base sm:text-lg\">Do you know people with babies or young children? Tell the other students about them.</h3>\n                        <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100 text-sm text-slate-600 flex items-center gap-2\">\n                            <svg class=\"w-4 h-4 text-sky-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                            <span>Share real-life examples from family members, friends, or neighbors.</span>\n                        </div>\n                    </div>\n                </article>\n\n                <!-- Question 4 -->\n                <article class=\"p-5 rounded-xl border border-slate-200 hover:border-sky-300 transition-colors bg-white shadow-sm flex gap-4 items-start\">\n                    <span class=\"flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 text-slate-700 font-semibold text-sm shrink-0\">4</span>\n                    <div class=\"space-y-2 w-full\">\n                        <h3 class=\"font-medium text-slate-900 text-base sm:text-lg\">Do you ever look after children for friends or someone in your family? If yes, do you like doing it?</h3>\n                        <div class=\"bg-slate-50 p-3 rounded-lg border border-slate-100 text-sm text-slate-600 flex items-center gap-2\">\n                            <svg class=\"w-4 h-4 text-sky-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                            <span>Discuss your experiences babysitting or helping out relatives.</span>\n                        </div>\n                    </div>\n                </article>\n\n            </div>\n\n        </section>\n\n        <!-- FOOTER -->\n        <footer class=\"bg-slate-100 border-t border-slate-200 p-4 text-center text-xs text-slate-500\">\n            Interactive Presentation Module &bull; ELT Content Suite\n        </footer>\n\n    </main>\n\n    <script>\n        // Metrics declaration for compatibility\n        window.ACTIVITY_METRICS = {\n            domain: 'Listening',\n            skill: 'group_discussion',\n            maxScore: 0\n        };\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793298655040,
      "title": "Look at the photo - ELT Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Look at the photo - ELT Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n<style>*, ::before, ::after{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }::backdrop{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }/* ! tailwindcss v3.4.17 | MIT License | https://tailwindcss.com */*,::after,::before{box-sizing:border-box;border-width:0;border-style:solid;border-color:#e5e7eb}::after,::before{--tw-content:''}:host,html{line-height:1.5;-webkit-text-size-adjust:100%;-moz-tab-size:4;tab-size:4;font-family:ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\";font-feature-settings:normal;font-variation-settings:normal;-webkit-tap-highlight-color:transparent}body{margin:0;line-height:inherit}hr{height:0;color:inherit;border-top-width:1px}abbr:where([title]){-webkit-text-decoration:underline dotted;text-decoration:underline dotted}h1,h2,h3,h4,h5,h6{font-size:inherit;font-weight:inherit}a{color:inherit;text-decoration:inherit}b,strong{font-weight:bolder}code,kbd,pre,samp{font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;font-feature-settings:normal;font-variation-settings:normal;font-size:1em}small{font-size:80%}sub,sup{font-size:75%;line-height:0;position:relative;vertical-align:baseline}sub{bottom:-.25em}sup{top:-.5em}table{text-indent:0;border-color:inherit;border-collapse:collapse}button,input,optgroup,select,textarea{font-family:inherit;font-feature-settings:inherit;font-variation-settings:inherit;font-size:100%;font-weight:inherit;line-height:inherit;letter-spacing:inherit;color:inherit;margin:0;padding:0}button,select{text-transform:none}button,input:where([type=button]),input:where([type=reset]),input:where([type=submit]){-webkit-appearance:button;background-color:transparent;background-image:none}:-moz-focusring{outline:auto}:-moz-ui-invalid{box-shadow:none}progress{vertical-align:baseline}::-webkit-inner-spin-button,::-webkit-outer-spin-button{height:auto}[type=search]{-webkit-appearance:textfield;outline-offset:-2px}::-webkit-search-decoration{-webkit-appearance:none}::-webkit-file-upload-button{-webkit-appearance:button;font:inherit}summary{display:list-item}blockquote,dd,dl,figure,h1,h2,h3,h4,h5,h6,hr,p,pre{margin:0}fieldset{margin:0;padding:0}legend{padding:0}menu,ol,ul{list-style:none;margin:0;padding:0}dialog{padding:0}textarea{resize:vertical}input::placeholder,textarea::placeholder{opacity:1;color:#9ca3af}[role=button],button{cursor:pointer}:disabled{cursor:default}audio,canvas,embed,iframe,img,object,svg,video{display:block;vertical-align:middle}img,video{max-width:100%;height:auto}[hidden]:where(:not([hidden=until-found])){display:none}.absolute{position:absolute}.relative{position:relative}.sticky{position:sticky}.inset-x-0{left:0px;right:0px}.top-0{top:0px}.bottom-0{bottom:0px}.z-20{z-index:20}.mx-auto{margin-left:auto;margin-right:auto}.my-4{margin-top:1rem;margin-bottom:1rem}.mb-1{margin-bottom:0.25rem}.mt-1{margin-top:0.25rem}.mt-0\\.5{margin-top:0.125rem}.inline-block{display:inline-block}.flex{display:flex}.grid{display:grid}.h-7{height:1.75rem}.h-auto{height:auto}.h-4{height:1rem}.max-h-\\[450px\\]{max-height:450px}.min-h-screen{min-height:100vh}.w-7{width:1.75rem}.w-full{width:100%}.w-4{width:1rem}.max-w-4xl{max-width:56rem}.max-w-sm{max-width:24rem}.flex-shrink-0{flex-shrink:0}.flex-grow{flex-grow:1}.grid-cols-1{grid-template-columns:repeat(1, minmax(0, 1fr))}.flex-col{flex-direction:column}.items-start{align-items:flex-start}.items-end{align-items:flex-end}.items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}.gap-6{gap:1.5rem}.space-x-2 > :not([hidden]) ~ :not([hidden]){--tw-space-x-reverse:0;margin-right:calc(0.5rem * var(--tw-space-x-reverse));margin-left:calc(0.5rem * calc(1 - var(--tw-space-x-reverse)))}.space-x-3 > :not([hidden]) ~ :not([hidden]){--tw-space-x-reverse:0;margin-right:calc(0.75rem * var(--tw-space-x-reverse));margin-left:calc(0.75rem * calc(1 - var(--tw-space-x-reverse)))}.space-y-3 > :not([hidden]) ~ :not([hidden]){--tw-space-y-reverse:0;margin-top:calc(0.75rem * calc(1 - var(--tw-space-y-reverse)));margin-bottom:calc(0.75rem * var(--tw-space-y-reverse))}.space-y-4 > :not([hidden]) ~ :not([hidden]){--tw-space-y-reverse:0;margin-top:calc(1rem * calc(1 - var(--tw-space-y-reverse)));margin-bottom:calc(1rem * var(--tw-space-y-reverse))}.overflow-hidden{overflow:hidden}.rounded-2xl{border-radius:1rem}.rounded-full{border-radius:9999px}.rounded-lg{border-radius:0.5rem}.rounded-xl{border-radius:0.75rem}.rounded{border-radius:0.25rem}.border{border-width:1px}.border-b{border-bottom-width:1px}.border-t{border-top-width:1px}.border-indigo-100{--tw-border-opacity:1;border-color:rgb(224 231 255 / var(--tw-border-opacity, 1))}.border-slate-100{--tw-border-opacity:1;border-color:rgb(241 245 249 / var(--tw-border-opacity, 1))}.border-slate-200{--tw-border-opacity:1;border-color:rgb(226 232 240 / var(--tw-border-opacity, 1))}.border-amber-200\\/60{border-color:rgb(253 230 138 / 0.6)}.bg-indigo-50{--tw-bg-opacity:1;background-color:rgb(238 242 255 / var(--tw-bg-opacity, 1))}.bg-indigo-600{--tw-bg-opacity:1;background-color:rgb(79 70 229 / var(--tw-bg-opacity, 1))}.bg-sky-100{--tw-bg-opacity:1;background-color:rgb(224 242 254 / var(--tw-bg-opacity, 1))}.bg-slate-100{--tw-bg-opacity:1;background-color:rgb(241 245 249 / var(--tw-bg-opacity, 1))}.bg-slate-50{--tw-bg-opacity:1;background-color:rgb(248 250 252 / var(--tw-bg-opacity, 1))}.bg-slate-800{--tw-bg-opacity:1;background-color:rgb(30 41 59 / var(--tw-bg-opacity, 1))}.bg-white{--tw-bg-opacity:1;background-color:rgb(255 255 255 / var(--tw-bg-opacity, 1))}.bg-white\\/95{background-color:rgb(255 255 255 / 0.95)}.bg-amber-50{--tw-bg-opacity:1;background-color:rgb(255 251 235 / var(--tw-bg-opacity, 1))}.bg-indigo-100{--tw-bg-opacity:1;background-color:rgb(224 231 255 / var(--tw-bg-opacity, 1))}.bg-white\\/20{background-color:rgb(255 255 255 / 0.2)}.bg-gradient-to-r{background-image:linear-gradient(to right, var(--tw-gradient-stops))}.bg-gradient-to-t{background-image:linear-gradient(to top, var(--tw-gradient-stops))}.from-slate-50{--tw-gradient-from:#f8fafc var(--tw-gradient-from-position);--tw-gradient-to:rgb(248 250 252 / 0) var(--tw-gradient-to-position);--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to)}.from-black\\/70{--tw-gradient-from:rgb(0 0 0 / 0.7) var(--tw-gradient-from-position);--tw-gradient-to:rgb(0 0 0 / 0) var(--tw-gradient-to-position);--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to)}.via-black\\/30{--tw-gradient-to:rgb(0 0 0 / 0)  var(--tw-gradient-to-position);--tw-gradient-stops:var(--tw-gradient-from), rgb(0 0 0 / 0.3) var(--tw-gradient-via-position), var(--tw-gradient-to)}.to-white{--tw-gradient-to:#fff var(--tw-gradient-to-position)}.to-transparent{--tw-gradient-to:transparent var(--tw-gradient-to-position)}.object-cover{object-fit:cover}.p-4{padding:1rem}.p-6{padding:1.5rem}.p-1\\.5{padding:0.375rem}.p-3{padding:0.75rem}.p-3\\.5{padding:0.875rem}.px-2{padding-left:0.5rem;padding-right:0.5rem}.px-2\\.5{padding-left:0.625rem;padding-right:0.625rem}.px-3{padding-left:0.75rem;padding-right:0.75rem}.px-4{padding-left:1rem;padding-right:1rem}.py-0\\.5{padding-top:0.125rem;padding-bottom:0.125rem}.py-1{padding-top:0.25rem;padding-bottom:0.25rem}.py-3{padding-top:0.75rem;padding-bottom:0.75rem}.px-6{padding-left:1.5rem;padding-right:1.5rem}.py-4{padding-top:1rem;padding-bottom:1rem}.text-center{text-align:center}.text-lg{font-size:1.125rem;line-height:1.75rem}.text-sm{font-size:0.875rem;line-height:1.25rem}.text-xs{font-size:0.75rem;line-height:1rem}.text-\\[10px\\]{font-size:10px}.font-bold{font-weight:700}.font-medium{font-weight:500}.font-semibold{font-weight:600}.uppercase{text-transform:uppercase}.leading-relaxed{line-height:1.625}.tracking-tight{letter-spacing:-0.025em}.tracking-wide{letter-spacing:0.025em}.text-indigo-600{--tw-text-opacity:1;color:rgb(79 70 229 / var(--tw-text-opacity, 1))}.text-sky-800{--tw-text-opacity:1;color:rgb(7 89 133 / var(--tw-text-opacity, 1))}.text-slate-500{--tw-text-opacity:1;color:rgb(100 116 139 / var(--tw-text-opacity, 1))}.text-slate-700{--tw-text-opacity:1;color:rgb(51 65 85 / var(--tw-text-opacity, 1))}.text-slate-800{--tw-text-opacity:1;color:rgb(30 41 59 / var(--tw-text-opacity, 1))}.text-slate-900{--tw-text-opacity:1;color:rgb(15 23 42 / var(--tw-text-opacity, 1))}.text-white{--tw-text-opacity:1;color:rgb(255 255 255 / var(--tw-text-opacity, 1))}.text-amber-600{--tw-text-opacity:1;color:rgb(217 119 6 / var(--tw-text-opacity, 1))}.text-amber-800{--tw-text-opacity:1;color:rgb(146 64 14 / var(--tw-text-opacity, 1))}.text-amber-900{--tw-text-opacity:1;color:rgb(120 53 15 / var(--tw-text-opacity, 1))}.text-amber-900\\/90{color:rgb(120 53 15 / 0.9)}.text-indigo-700{--tw-text-opacity:1;color:rgb(67 56 202 / var(--tw-text-opacity, 1))}.text-slate-400{--tw-text-opacity:1;color:rgb(148 163 184 / var(--tw-text-opacity, 1))}.text-slate-600{--tw-text-opacity:1;color:rgb(71 85 105 / var(--tw-text-opacity, 1))}.underline{-webkit-text-decoration-line:underline;text-decoration-line:underline}.decoration-amber-300{-webkit-text-decoration-color:#fcd34d;text-decoration-color:#fcd34d}.antialiased{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.shadow-md{--tw-shadow:0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);--tw-shadow-colored:0 4px 6px -1px var(--tw-shadow-color), 0 2px 4px -2px var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)}.shadow-sm{--tw-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05);--tw-shadow-colored:0 1px 2px 0 var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)}.backdrop-blur{--tw-backdrop-blur:blur(8px);-webkit-backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia)}.backdrop-blur-sm{--tw-backdrop-blur:blur(4px);-webkit-backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia)}.transition-transform{transition-property:transform;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms}.duration-300{transition-duration:300ms}.group:hover .group-hover\\:scale-\\[1\\.02\\]{--tw-scale-x:1.02;--tw-scale-y:1.02;transform:translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))}@media (min-width: 640px){.sm\\:p-6{padding:1.5rem}.sm\\:text-base{font-size:1rem;line-height:1.5rem}.sm\\:text-sm{font-size:0.875rem;line-height:1.25rem}.sm\\:text-xl{font-size:1.25rem;line-height:1.75rem}}@media (min-width: 768px){.md\\:col-span-6{grid-column:span 6 / span 6}.md\\:grid-cols-12{grid-template-columns:repeat(12, minmax(0, 1fr))}.md\\:p-8{padding:2rem}}</style></head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Top Sticky Header / Navigation Bar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-indigo-600 text-white font-bold text-sm px-2.5 py-1 rounded-lg\">4a</span>\n                <h1 class=\"font-semibold text-slate-700 text-sm sm:text-base tracking-tight\">Vocabulary &amp; Discussion</h1>\n            </div>\n            <div class=\"text-xs sm:text-sm font-medium text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100\">\n                Visual Activity\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-4\">\n        <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden\">\n            \n            <!-- Activity Instruction Header -->\n            <div class=\"p-6 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white\">\n                <div class=\"flex items-start space-x-3\">\n                    <div class=\"bg-slate-800 text-white font-bold text-sm h-7 w-7 rounded-full flex items-center justify-center flex-shrink-0 shadow-sm\">\n                        4\n                    </div>\n                    <div>\n                        <span class=\"inline-block bg-sky-100 text-sky-800 text-xs font-semibold px-2 py-0.5 rounded-full mb-1\">Look &amp; Discuss</span>\n                        <h2 class=\"text-lg sm:text-xl font-bold text-slate-900\">\n                            Look at the photo. How do the parents feel, do you think?\n                        </h2>\n                        <p class=\"text-sm text-slate-500 mt-1\">\n                            Observe the expressions and body language of Martin and Vicky with their baby, Meg.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Content Grid: Photo + Prompt Cards -->\n            <div class=\"p-6 grid grid-cols-1 md:grid-cols-12 gap-6 items-center\">\n                \n                <!-- Student Image Column -->\n                <div class=\"md:col-span-6 flex justify-center\">\n                    <div class=\"w-full max-w-sm rounded-xl overflow-hidden shadow-md border border-slate-200 bg-slate-100 relative group\">\n                        <img src=\"data:image/png;base64,\" alt=\"Martin, Vicky and baby Meg\" class=\"w-full h-auto object-cover max-h-[450px] transition-transform duration-300 group-hover:scale-[1.02]\">\n                        <div class=\"absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent p-3 text-white text-xs flex justify-between items-end\">\n                            <span class=\"font-medium\">Martin, Vicky &amp; Meg</span>\n                            <span class=\"bg-white/20 backdrop-blur-sm px-2 py-0.5 rounded text-[10px]\">Family Portrait</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Discussion & Reflection Column -->\n                <div class=\"md:col-span-6 flex flex-col justify-center space-y-4\">\n                    <div class=\"p-4 rounded-xl bg-amber-50 border border-amber-200/60 text-amber-900\">\n                        <div class=\"flex items-center space-x-2 font-semibold text-sm mb-1 text-amber-800\">\n                            <svg class=\"w-4 h-4 text-amber-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                            <span>Observation Task</span>\n                        </div>\n                        <p class=\"text-xs sm:text-sm leading-relaxed text-amber-900/90\">\n                            This is a non-interactive presentation exercise. Take a moment to analyze the parents' facial expressions, smiles, and posture. Consider vocabulary related to emotions like <span class=\"font-semibold underline decoration-amber-300\">proud</span>, <span class=\"font-semibold underline decoration-amber-300\">happy</span>, <span class=\"font-semibold underline decoration-amber-300\">tired</span>, or <span class=\"font-semibold underline decoration-amber-300\">content.</span></p></div>\n                </div>\n\n            </div>\n\n            <!-- Footer Note / Status -->\n            <div class=\"px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500\">\n                <span>English Language Teaching Material</span>\n                <span class=\"font-medium text-slate-600\">Unit 4 • Presentation Task</span>\n            </div>\n\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-4 text-xs text-slate-400 border-t border-slate-200 bg-white\">\n        Interactive ELT Content Framework • Responsive Design\n    </footer>\n\n    <!-- Script de inicialización de métricas pedagógicas -->\n    <script>\n        // Declaración del contrato obligatorio de métricas pedagógicas\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'visual_analysis_discussion',\n            maxScore: 0\n        };\n\n        // Emisión inicial de estado vacío/completado ya que es un ejercicio no interactivo de apreciación visual\n        window.addEventListener('DOMContentLoaded', () => {\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: 0,\n                    total: 0,\n                    completed: true\n                }\n            }));\n            \n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: 0, total: 0 }, '*');\n            }\n        });\n    </script>\n\n</body></html>"
    },
    {
      "id": 1793298856716,
      "title": "Listening Activity - Vicky and Martin",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Listening Activity - Vicky and Martin</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- STICKY TOP AUDIO PLAYER & BANNER -->\n  <div class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"w-full max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n      <div class=\"flex items-center gap-2 w-full sm:w-auto\">\n        <span class=\"bg-indigo-100 text-indigo-700 font-semibold px-2.5 py-1 rounded-md text-xs tracking-wide uppercase flex items-center gap-1 shrink-0\">\n          <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\"/></svg>\n          R9.4 Listening\n        </span>\n        <span id=\"audioStatusText\" class=\"text-xs text-slate-500 font-medium italic flex items-center gap-1\">\n          <svg class=\"w-3.5 h-3.5 text-amber-500 shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\"/></svg>\n          Locked until check\n        </span>\n      </div>\n      <!-- AUDIO PLAYER (Locked initially per instructions) -->\n      <div id=\"audioContainer\" class=\"w-full sm:w-auto flex-1 max-w-md opacity-40 pointer-events-none select-none transition-all duration-300\">\n        <audio id=\"lessonAudio\" controls class=\"w-full h-10\" src=\"data:audio/mpeg;base64,\"></audio>\n      </div>\n    </div>\n  </div>\n\n  <!-- MAIN CONTAINER -->\n  <main class=\"w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-6 flex-grow\">\n    \n    <!-- ACTIVITY HEADER CARD -->\n    <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6 mb-6\">\n      <div class=\"flex items-start justify-between gap-4\">\n        <div>\n          <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2\">\n            <span>Listen and tick the things Vicky and Martin talk about</span>\n          </h1>\n          <p class=\"text-sm text-slate-600 mt-1\">\n            Read the topics below. Check the boxes for what each person discusses in the audio. You can check your answers when you're ready.\n          </p>\n        </div>\n        <div class=\"hidden sm:flex flex-col items-end shrink-0\">\n          <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Score</span>\n          <span id=\"scoreDisplay\" class=\"text-2xl font-black text-indigo-600\">0 / 16</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- INTERACTIVE TABLE / CHECKLIST -->\n    <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-6\">\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-left border-collapse\">\n          <thead>\n            <tr class=\"bg-slate-100/70 border-b border-slate-200 text-xs uppercase font-semibold text-slate-600 tracking-wider\">\n              <th class=\"py-3.5 px-4 sm:px-6 w-12 text-center\">#</th>\n              <th class=\"py-3.5 px-4 sm:px-6\">Topic / Discussion Point</th>\n              <th class=\"py-3.5 px-4 sm:px-6 w-32 text-center bg-indigo-50/50 text-indigo-900 border-x border-slate-200\">Vicky</th>\n              <th class=\"py-3.5 px-4 sm:px-6 w-32 text-center bg-teal-50/50 text-teal-900\">Martin</th>\n            </tr>\n          </thead>\n          <tbody id=\"checklistBody\" class=\"divide-y divide-slate-100 text-sm sm:text-base\">\n            <!-- Row 1 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">1</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">\n                feeling depressed\n                <span class=\"block text-xs font-normal text-emerald-600 mt-0.5\">✓ Given example (Vicky)</span>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" disabled checked class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-not-allowed accent-indigo-600\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"1\" data-answer=\"false\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 2 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">2</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">sleep problems</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"2\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"2\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 3 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">3</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">feeling lonely</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"3\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"3\" data-answer=\"false\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 4 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">4</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">social life</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"4\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"4\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 5 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">5</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">money</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"5\" data-answer=\"false\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"5\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 6 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">6</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">moving house</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"6\" data-answer=\"false\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"6\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 7 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">7</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">good things about being a parent</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"7\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"7\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 8 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">8</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">having more children</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"8\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"8\" data-answer=\"false\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- ACTION BUTTONS BAR -->\n    <div class=\"flex flex-col sm:flex-row items-center justify-between gap-4 bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm\">\n      <div class=\"flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-start\">\n        <span class=\"sm:hidden text-sm font-bold text-slate-600\">Score: <span id=\"scoreDisplayMobile\" class=\"text-indigo-600 font-black\">0 / 16</span></span>\n        <button id=\"resetBtn\" class=\"w-full sm:w-auto px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold hover:bg-slate-100 transition-colors flex items-center justify-center gap-2 min-h-[42px] text-sm\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\n          Reset\n        </button>\n      </div>\n      <button id=\"checkBtn\" class=\"w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold shadow-md shadow-indigo-200 transition-all flex items-center justify-center gap-2 min-h-[42px] text-sm sm:text-base\">\n        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/></svg>\n        Check Answers\n      </button>\n    </div>\n\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 bg-white mt-8\">\n    Interactive Listening Task &bull; ELT Activity\n  </footer>\n\n  <!-- SCRIPT LOGIC & METRICS -->\n  <script>\n    // Mandatory Educational Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Listening',\n      skill: 'listening_for_gist_and_detail',\n      maxScore: 16\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const checkBtn = document.getElementById('checkBtn');\n      const resetBtn = document.getElementById('resetBtn');\n      const scoreDisplay = document.getElementById('scoreDisplay');\n      const scoreDisplayMobile = document.getElementById('scoreDisplayMobile');\n      const audioContainer = document.getElementById('audioContainer');\n      const audioStatusText = document.getElementById('audioStatusText');\n      const checkboxes = document.querySelectorAll('#checklistBody input[type=\"checkbox\"]:not([disabled])');\n\n      // Check Answers handler\n      checkBtn.addEventListener('click', () => {\n        let correctCount = 0;\n        const totalItems = checkboxes.length + 1; // +1 for the given item 1 (Vicky checked)\n\n        checkboxes.forEach(cb => {\n          const expected = cb.getAttribute('data-answer') === 'true';\n          const isChecked = cb.checked;\n          const parentCell = cb.closest('td');\n\n          // Reset previous states\n          parentCell.classList.remove('bg-emerald-100', 'bg-rose-100', 'border-2', 'border-emerald-500', 'border-rose-500');\n\n          if (isChecked === expected) {\n            correctCount++;\n            parentCell.classList.add('bg-emerald-100');\n          } else {\n            parentCell.classList.add('bg-rose-100');\n          }\n        });\n\n        // Add 1 point for the pre-filled correct example (Vicky 1)\n        correctCount += 1;\n\n        // Update score UI\n        scoreDisplay.textContent = `${correctCount} / ${totalItems}`;\n        scoreDisplayMobile.textContent = `${correctCount} / ${totalItems}`;\n\n        // Unlock Audio Player per requirements\n        audioContainer.classList.remove('opacity-40', 'pointer-events-none', 'select-none');\n        audioStatusText.innerHTML = `\n          <svg class=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/></svg>\n          <span class=\"text-emerald-700 font-semibold\">Now listen and check your answers</span>\n        `;\n\n        // Dispatch ELT Activity Update Event\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: totalItems,\n            completed: correctCount === totalItems\n          }\n        }));\n\n        // Post message to parent container if embedded in iframe\n        if (window.parent && window.parent !== window) {\n          window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: totalItems }, '*');\n        }\n      });\n\n      // Reset handler\n      resetBtn.addEventListener('click', () => {\n        checkboxes.forEach(cb => {\n          cb.checked = false;\n          const parentCell = cb.closest('td');\n          parentCell.classList.remove('bg-emerald-100', 'bg-rose-100');\n        });\n\n        scoreDisplay.textContent = `0 / 16`;\n        scoreDisplayMobile.textContent = `0 / 16`;\n\n        // Re-lock audio\n        audioContainer.classList.add('opacity-40', 'pointer-events-none', 'select-none');\n        audioStatusText.innerHTML = `\n          <svg class=\"w-3.5 h-3.5 text-amber-500 shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\"/></svg>\n          Locked until check\n        `;\n\n        const audioElement = document.getElementById('lessonAudio');\n        if (audioElement) {\n          audioElement.pause();\n          audioElement.currentTime = 0;\n        }\n      });\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793298895398,
      "title": "Listening Activity - Vicky and Martin (Copia)",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Listening Activity - Vicky and Martin</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- STICKY TOP AUDIO PLAYER & BANNER -->\n  <div class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"w-full max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n      <div class=\"flex items-center gap-2 w-full sm:w-auto\">\n        <span class=\"bg-indigo-100 text-indigo-700 font-semibold px-2.5 py-1 rounded-md text-xs tracking-wide uppercase flex items-center gap-1 shrink-0\">\n          <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\"/></svg>\n          R9.4 Listening\n        </span>\n        <span id=\"audioStatusText\" class=\"text-xs text-slate-500 font-medium italic flex items-center gap-1\">\n          <svg class=\"w-3.5 h-3.5 text-amber-500 shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\"/></svg>\n          Locked until check\n        </span>\n      </div>\n      <!-- AUDIO PLAYER (Locked initially per instructions) -->\n      <div id=\"audioContainer\" class=\"w-full sm:w-auto flex-1 max-w-md opacity-40 pointer-events-none select-none transition-all duration-300\">\n        <audio id=\"lessonAudio\" controls class=\"w-full h-10\" src=\"data:audio/mpeg;base64,\"></audio>\n      </div>\n    </div>\n  </div>\n\n  <!-- MAIN CONTAINER -->\n  <main class=\"w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-6 flex-grow\">\n    \n    <!-- ACTIVITY HEADER CARD -->\n    <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6 mb-6\">\n      <div class=\"flex items-start justify-between gap-4\">\n        <div>\n          <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2\">\n            <span>Listen and tick the things Vicky and Martin talk about</span>\n          </h1>\n          <p class=\"text-sm text-slate-600 mt-1\">\n            Read the topics below. Check the boxes for what each person discusses in the audio. You can check your answers when you're ready.\n          </p>\n        </div>\n        <div class=\"hidden sm:flex flex-col items-end shrink-0\">\n          <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Score</span>\n          <span id=\"scoreDisplay\" class=\"text-2xl font-black text-indigo-600\">0 / 16</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- INTERACTIVE TABLE / CHECKLIST -->\n    <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-6\">\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-left border-collapse\">\n          <thead>\n            <tr class=\"bg-slate-100/70 border-b border-slate-200 text-xs uppercase font-semibold text-slate-600 tracking-wider\">\n              <th class=\"py-3.5 px-4 sm:px-6 w-12 text-center\">#</th>\n              <th class=\"py-3.5 px-4 sm:px-6\">Topic / Discussion Point</th>\n              <th class=\"py-3.5 px-4 sm:px-6 w-32 text-center bg-indigo-50/50 text-indigo-900 border-x border-slate-200\">Vicky</th>\n              <th class=\"py-3.5 px-4 sm:px-6 w-32 text-center bg-teal-50/50 text-teal-900\">Martin</th>\n            </tr>\n          </thead>\n          <tbody id=\"checklistBody\" class=\"divide-y divide-slate-100 text-sm sm:text-base\">\n            <!-- Row 1 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">1</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">\n                feeling depressed\n                <span class=\"block text-xs font-normal text-emerald-600 mt-0.5\">✓ Given example (Vicky)</span>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" disabled checked class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-not-allowed accent-indigo-600\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"1\" data-answer=\"false\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 2 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">2</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">sleep problems</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"2\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"2\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 3 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">3</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">feeling lonely</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"3\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"3\" data-answer=\"false\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 4 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">4</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">social life</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"4\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"4\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 5 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">5</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">money</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"5\" data-answer=\"false\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"5\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 6 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">6</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">moving house</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"6\" data-answer=\"false\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"6\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 7 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">7</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">good things about being a parent</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"7\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"7\" data-answer=\"true\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n            <!-- Row 8 -->\n            <tr class=\"hover:bg-slate-50/80 transition-colors\">\n              <td class=\"py-3.5 px-4 sm:px-6 text-center font-bold text-slate-400\">8</td>\n              <td class=\"py-3.5 px-4 sm:px-6 font-medium text-slate-700\">having more children</td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-indigo-50/20 border-x border-slate-100\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"vicky\" data-item=\"8\" data-answer=\"true\" class=\"w-5 h-5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 sm:px-6 text-center bg-teal-50/20\">\n                <div class=\"flex justify-center items-center h-full min-h-[42px]\">\n                  <input type=\"checkbox\" data-person=\"martin\" data-item=\"8\" data-answer=\"false\" class=\"w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer accent-teal-600 transition-transform active:scale-95\">\n                </div>\n              </td>\n            </tr>\n\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- ACTION BUTTONS BAR -->\n    <div class=\"flex flex-col sm:flex-row items-center justify-between gap-4 bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm\">\n      <div class=\"flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-start\">\n        <span class=\"sm:hidden text-sm font-bold text-slate-600\">Score: <span id=\"scoreDisplayMobile\" class=\"text-indigo-600 font-black\">0 / 16</span></span>\n        <button id=\"resetBtn\" class=\"w-full sm:w-auto px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold hover:bg-slate-100 transition-colors flex items-center justify-center gap-2 min-h-[42px] text-sm\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\n          Reset\n        </button>\n      </div>\n      <button id=\"checkBtn\" class=\"w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold shadow-md shadow-indigo-200 transition-all flex items-center justify-center gap-2 min-h-[42px] text-sm sm:text-base\">\n        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/></svg>\n        Check Answers\n      </button>\n    </div>\n\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 bg-white mt-8\">\n    Interactive Listening Task &bull; ELT Activity\n  </footer>\n\n  <!-- SCRIPT LOGIC & METRICS -->\n  <script>\n    // Mandatory Educational Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Listening',\n      skill: 'listening_for_gist_and_detail',\n      maxScore: 16\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const checkBtn = document.getElementById('checkBtn');\n      const resetBtn = document.getElementById('resetBtn');\n      const scoreDisplay = document.getElementById('scoreDisplay');\n      const scoreDisplayMobile = document.getElementById('scoreDisplayMobile');\n      const audioContainer = document.getElementById('audioContainer');\n      const audioStatusText = document.getElementById('audioStatusText');\n      const checkboxes = document.querySelectorAll('#checklistBody input[type=\"checkbox\"]:not([disabled])');\n\n      // Check Answers handler\n      checkBtn.addEventListener('click', () => {\n        let correctCount = 0;\n        const totalItems = checkboxes.length + 1; // +1 for the given item 1 (Vicky checked)\n\n        checkboxes.forEach(cb => {\n          const expected = cb.getAttribute('data-answer') === 'true';\n          const isChecked = cb.checked;\n          const parentCell = cb.closest('td');\n\n          // Reset previous states\n          parentCell.classList.remove('bg-emerald-100', 'bg-rose-100', 'border-2', 'border-emerald-500', 'border-rose-500');\n\n          if (isChecked === expected) {\n            correctCount++;\n            parentCell.classList.add('bg-emerald-100');\n          } else {\n            parentCell.classList.add('bg-rose-100');\n          }\n        });\n\n        // Add 1 point for the pre-filled correct example (Vicky 1)\n        correctCount += 1;\n\n        // Update score UI\n        scoreDisplay.textContent = `${correctCount} / ${totalItems}`;\n        scoreDisplayMobile.textContent = `${correctCount} / ${totalItems}`;\n\n        // Unlock Audio Player per requirements\n        audioContainer.classList.remove('opacity-40', 'pointer-events-none', 'select-none');\n        audioStatusText.innerHTML = `\n          <svg class=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"/></svg>\n          <span class=\"text-emerald-700 font-semibold\">Now listen and check your answers</span>\n        `;\n\n        // Dispatch ELT Activity Update Event\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: totalItems,\n            completed: correctCount === totalItems\n          }\n        }));\n\n        // Post message to parent container if embedded in iframe\n        if (window.parent && window.parent !== window) {\n          window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: totalItems }, '*');\n        }\n      });\n\n      // Reset handler\n      resetBtn.addEventListener('click', () => {\n        checkboxes.forEach(cb => {\n          cb.checked = false;\n          const parentCell = cb.closest('td');\n          parentCell.classList.remove('bg-emerald-100', 'bg-rose-100');\n        });\n\n        scoreDisplay.textContent = `0 / 16`;\n        scoreDisplayMobile.textContent = `0 / 16`;\n\n        // Re-lock audio\n        audioContainer.classList.add('opacity-40', 'pointer-events-none', 'select-none');\n        audioStatusText.innerHTML = `\n          <svg class=\"w-3.5 h-3.5 text-amber-500 shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\"/></svg>\n          Locked until check\n        `;\n\n        const audioElement = document.getElementById('lessonAudio');\n        if (audioElement) {\n          audioElement.pause();\n          audioElement.currentTime = 0;\n        }\n      });\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793299266787,
      "title": "Who said these things? - ELT Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Who said these things? - ELT Activity</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n        .transition-all-custom { transition: all 0.25s ease-in-out; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between antialiased selection:bg-indigo-100 selection:text-indigo-800\">\n\n    <!-- STICKY HEADER & AUDIO PLAYER -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur-md z-30 border-b border-slate-200 shadow-sm py-3 px-4 sm:px-6 w-full\">\n        <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z\"></path></svg>\n                </div>\n                <div>\n                    <h1 class=\"font-bold text-base sm:text-lg text-slate-900 leading-tight\">Task 5: Who said these things?</h1>\n                    <p class=\"text-xs text-slate-500 font-medium\">Grammar & Listening Practice: Too / Enough</p>\n                </div>\n            </div>\n\n            <!-- Audio Player Widget & Status -->\n            <div class=\"flex items-center gap-3 w-full sm:w-auto justify-end\">\n                <div id=\"audio-lock-notice\" class=\"text-xs font-semibold px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1.5 transition-all\">\n                    <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"></path></svg>\n                    <span>Classify all 7 items to unlock audio</span>\n                </div>\n\n                <div id=\"audio-player-container\" class=\"opacity-50 pointer-events-none flex items-center gap-2 bg-slate-100 p-1.5 rounded-xl border border-slate-200 transition-all\">\n                    <button id=\"play-btn\" onclick=\"toggleAudio()\" class=\"bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white p-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 min-h-[38px] px-3 shadow-sm transition-all\" title=\"Play / Pause Audio\">\n                        <svg id=\"play-icon\" class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n                        <span id=\"play-text\">Listen R9.4</span>\n                    </button>\n                    <div class=\"text-xs font-mono text-slate-600 px-2\" id=\"audio-timer\">0:00 / 0:35</div>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- INSTRUCTION BANNER -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 mb-6 shadow-sm\">\n            <div class=\"flex items-start gap-4\">\n                <div class=\"bg-indigo-50 text-indigo-700 font-bold p-3 rounded-xl text-lg hidden sm:flex items-center justify-center min-w-[48px] min-h-[48px]\">\n                    5\n                </div>\n                <div>\n                    <h2 class=\"text-base sm:text-lg font-bold text-slate-900 mb-1\">Part A: Prediction & Classification</h2>\n                    <p class=\"text-sm text-slate-600 leading-relaxed\">\n                        Read the sentences below. First, work in pairs/individually and decide whether <strong>Vicky</strong> or <span>Martin</span> said each sentence. \n                        Once you select a person for all 7 items, the audio player will unlock so you can listen and check your hypotheses!\n                    </p>\n                </div>\n            </div>\n        </section>\n\n        <!-- EXERCISE FORM / LIST -->\n        <form id=\"quiz-form\" class=\"space-y-4 mb-8\" onsubmit=\"return false;\">\n            \n            <!-- Item 1 -->\n            <div class=\"sentence-card bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all-custom hover:border-slate-300\" data-item=\"1\">\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                    <div class=\"flex items-start gap-3.5 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">1</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium leading-relaxed pt-0.5\">\n                            I feel a bit guilty, so I try not to get home <strong class=\"text-indigo-600\">too late</strong>.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2 self-end md:self-center\">\n                        <button type=\"button\" onclick=\"selectOption(1, 'Martin')\" class=\"speaker-btn-1 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Martin\">Martin</button>\n                        <button type=\"button\" onclick=\"selectOption(1, 'Vicky')\" class=\"speaker-btn-1 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Vicky\">Vicky</button>\n                        <input type=\"hidden\" name=\"item-1\" id=\"input-1\" data-answer=\"Martin\" value=\"\">\n                    </div>\n                </div>\n                <div class=\"feedback-msg hidden mt-2 text-xs font-semibold pl-10\"></div>\n            </div>\n\n            <!-- Item 2 -->\n            <div class=\"sentence-card bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all-custom hover:border-slate-300\" data-item=\"2\">\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                    <div class=\"flex items-start gap-3.5 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">2</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium leading-relaxed pt-0.5\">\n                            I get upset when he says he's got <strong class=\"text-indigo-600\">too much work</strong> to do.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2 self-end md:self-center\">\n                        <button type=\"button\" onclick=\"selectOption(2, 'Martin')\" class=\"speaker-btn-2 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Martin\">Martin</button>\n                        <button type=\"button\" onclick=\"selectOption(2, 'Vicky')\" class=\"speaker-btn-2 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Vicky\">Vicky</button>\n                        <input type=\"hidden\" name=\"item-2\" id=\"input-2\" data-answer=\"Vicky\" value=\"\">\n                    </div>\n                </div>\n                <div class=\"feedback-msg hidden mt-2 text-xs font-semibold pl-10\"></div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"sentence-card bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all-custom hover:border-slate-300\" data-item=\"3\">\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                    <div class=\"flex items-start gap-3.5 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">3</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium leading-relaxed pt-0.5\">\n                            I've always got <strong class=\"text-indigo-600\">too many things</strong> to do.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2 self-end md:self-center\">\n                        <button type=\"button\" onclick=\"selectOption(3, 'Martin')\" class=\"speaker-btn-3 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Martin\">Martin</button>\n                        <button type=\"button\" onclick=\"selectOption(3, 'Vicky')\" class=\"speaker-btn-3 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Vicky\">Vicky</button>\n                        <input type=\"hidden\" name=\"item-3\" id=\"input-3\" data-answer=\"Vicky\" value=\"\">\n                    </div>\n                </div>\n                <div class=\"feedback-msg hidden mt-2 text-xs font-semibold pl-10\"></div>\n            </div>\n\n            <!-- Item 4 -->\n            <div class=\"sentence-card bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all-custom hover:border-slate-300\" data-item=\"4\">\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                    <div class=\"flex items-start gap-3.5 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">4</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium leading-relaxed pt-0.5\">\n                            She's <strong class=\"text-indigo-600\">not old enough</strong> to talk.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2 self-end md:self-center\">\n                        <button type=\"button\" onclick=\"selectOption(4, 'Martin')\" class=\"speaker-btn-4 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Martin\">Martin</button>\n                        <button type=\"button\" onclick=\"selectOption(4, 'Vicky')\" class=\"speaker-btn-4 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Vicky\">Vicky</button>\n                        <input type=\"hidden\" name=\"item-4\" id=\"input-4\" data-answer=\"Martin\" value=\"\">\n                    </div>\n                </div>\n                <div class=\"feedback-msg hidden mt-2 text-xs font-semibold pl-10\"></div>\n            </div>\n\n            <!-- Item 5 -->\n            <div class=\"sentence-card bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all-custom hover:border-slate-300\" data-item=\"5\">\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                    <div class=\"flex items-start gap-3.5 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">5</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium leading-relaxed pt-0.5\">\n                            I don't have <strong class=\"text-indigo-600\">enough energy</strong> to do anything in the day.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2 self-end md:self-center\">\n                        <button type=\"button\" onclick=\"selectOption(5, 'Martin')\" class=\"speaker-btn-5 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Martin\">Martin</button>\n                        <button type=\"button\" onclick=\"selectOption(5, 'Vicky')\" class=\"speaker-btn-5 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Vicky\">Vicky</button>\n                        <input type=\"hidden\" name=\"item-5\" id=\"input-5\" data-answer=\"Vicky\" value=\"\">\n                    </div>\n                </div>\n                <div class=\"feedback-msg hidden mt-2 text-xs font-semibold pl-10\"></div>\n            </div>\n\n            <!-- Item 6 -->\n            <div class=\"sentence-card bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all-custom hover:border-slate-300\" data-item=\"6\">\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                    <div class=\"flex items-start gap-3.5 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">6</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium leading-relaxed pt-0.5\">\n                            I earn <strong class=\"text-indigo-600\">enough money</strong> for the whole family.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2 self-end md:self-center\">\n                        <button type=\"button\" onclick=\"selectOption(6, 'Martin')\" class=\"speaker-btn-6 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Martin\">Martin</button>\n                        <button type=\"button\" onclick=\"selectOption(6, 'Vicky')\" class=\"speaker-btn-6 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Vicky\">Vicky</button>\n                        <input type=\"hidden\" name=\"item-6\" id=\"input-6\" data-answer=\"Martin\" value=\"\">\n                    </div>\n                </div>\n                <div class=\"feedback-msg hidden mt-2 text-xs font-semibold pl-10\"></div>\n            </div>\n\n            <!-- Item 7 -->\n            <div class=\"sentence-card bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all-custom hover:border-slate-300\" data-item=\"7\">\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                    <div class=\"flex items-start gap-3.5 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center\">7</span>\n                        <p class=\"text-sm sm:text-base text-slate-800 font-medium leading-relaxed pt-0.5\">\n                            I think this place is <strong class=\"text-indigo-600\">big enough</strong> for us.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2 self-end md:self-center\">\n                        <button type=\"button\" onclick=\"selectOption(7, 'Martin')\" class=\"speaker-btn-7 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Martin\">Martin</button>\n                        <button type=\"button\" onclick=\"selectOption(7, 'Vicky')\" class=\"speaker-btn-7 option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all\" data-person=\"Vicky\">Vicky</button>\n                        <input type=\"hidden\" name=\"item-7\" id=\"input-7\" data-answer=\"Martin\" value=\"\">\n                    </div>\n                </div>\n                <div class=\"feedback-msg hidden mt-2 text-xs font-semibold pl-10\"></div>\n            </div>\n\n        </form>\n\n        <!-- ACTION BAR / SCOREBOARD -->\n        <div class=\"bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-slate-100 text-slate-700 p-3 rounded-xl font-bold text-sm\">\n                    Score: <span id=\"score-display\">0</span> / 7\n                </div>\n                <p id=\"completion-status\" class=\"text-xs text-slate-500 font-medium\">Select all items to enable check answers.</p>\n            </div>\n\n            <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                <button type=\"button\" onclick=\"resetActivity()\" class=\"flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 min-h-[42px] transition-all flex items-center justify-center gap-2\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    Reset\n                </button>\n                <button type=\"button\" id=\"check-btn\" onclick=\"checkAnswers()\" disabled class=\"flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold text-sm hover:bg-indigo-700 active:bg-indigo-800 disabled:opacity-40 disabled:pointer-events-none min-h-[42px] shadow-sm transition-all flex items-center justify-center gap-2\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    Check Answers\n                </button>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"w-full text-center py-6 text-xs text-slate-400 border-t border-slate-200 mt-12 bg-white\">\n        Interactive ELT Lesson &bull; English Grammar & Listening Module\n    </footer>\n\n    <!-- JAVASCRIPT LOGIC & METRICS -->\n    <script>\n        // PEDAGOGICAL CONTRACT & METRICS\n        window.ACTIVITY_METRICS = {\n            domain: 'Listening',\n            skill: 'listening_for_detail_too_enough',\n            maxScore: 7\n        };\n\n        let audioPlaying = false;\n        let audioUnlocked = false;\n\n        function selectOption(itemNum, person) {\n            // Update hidden input\n            const input = document.getElementById(`input-${itemNum}`);\n            input.value = person;\n\n            // Highlight selected button, unhighlight sibling\n            const buttons = document.querySelectorAll(`.speaker-btn-${itemNum}`);\n            buttons.forEach(btn => {\n                if(btn.getAttribute('data-person') === person) {\n                    btn.className = `speaker-btn-${itemNum} option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-indigo-600 bg-indigo-600 text-white shadow-sm min-h-[42px] transition-all`;\n                } else {\n                    btn.className = `speaker-btn-${itemNum} option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all`;\n                }\n            });\n\n            checkUnlockCondition();\n        }\n\n        function checkUnlockCondition() {\n            let allAnswered = true;\n            for(let i=1; i<=7; i++) {\n                if(!document.getElementById(`input-${i}`).value) {\n                    allAnswered = false;\n                    break;\n                }\n            }\n\n            const notice = document.getElementById('audio-lock-notice');\n            const container = document.getElementById('audio-player-container');\n            const checkBtn = document.getElementById('check-btn');\n            const statusText = document.getElementById('completion-status');\n\n            if(allAnswered && !audioUnlocked) {\n                audioUnlocked = true;\n                notice.classList.remove('bg-amber-50', 'text-amber-700', 'border-amber-200');\n                notice.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');\n                notice.innerHTML = `<svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg><span>Audio unlocked! Listen to confirm.</span>`;\n                \n                container.classList.remove('opacity-50', 'pointer-events-none');\n                checkBtn.removeAttribute('disabled');\n                statusText.innerText = \"All items classified. You can now check answers or listen to the audio.\";\n            }\n        }\n\n        function toggleAudio() {\n            if(!audioUnlocked) return;\n            const playText = document.getElementById('play-text');\n            const timer = document.getElementById('audio-timer');\n            \n            audioPlaying = !audioPlaying;\n            if(audioPlaying) {\n                playText.innerText = \"Pause\";\n                timer.innerText = \"0:12 / 0:35\";\n                // Simulate audio play state\n            } else {\n                playText.innerText = \"Listen R9.4\";\n            }\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const inputs = document.querySelectorAll('#quiz-form input[type=\"hidden\"]');\n\n            inputs.forEach((input, index) => {\n                const itemNum = index + 1;\n                const userVal = input.value;\n                const correctVal = input.getAttribute('data-answer');\n                const card = document.querySelector(`.sentence-card[data-item=\"${itemNum}\"]`);\n                const feedback = card.querySelector('.feedback-msg');\n\n                feedback.classList.remove('hidden');\n\n                if(userVal === correctVal) {\n                    correctCount++;\n                    card.classList.remove('border-rose-200', 'bg-rose-50/30');\n                    card.classList.add('border-emerald-300', 'bg-emerald-50/30');\n                    feedback.className = \"feedback-msg mt-2 text-xs font-semibold pl-10 text-emerald-600 flex items-center gap-1\";\n                    feedback.innerHTML = `<svg class=\"w-4 h-4 inline\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg> Correct! (${correctVal})`;\n                } else {\n                    card.classList.remove('border-emerald-300', 'bg-emerald-50/30');\n                    card.classList.add('border-rose-200', 'bg-rose-50/30');\n                    feedback.className = \"feedback-msg mt-2 text-xs font-semibold pl-10 text-rose-600 flex items-center gap-1\";\n                    feedback.innerHTML = `<svg class=\"w-4 h-4 inline\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path></svg> Incorrect. It was actually said by <strong>${correctVal}</strong>.`;\n                }\n            });\n\n            document.getElementById('score-display').innerText = correctCount;\n\n            // Dispatch pedagogical metrics event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: inputs.length,\n                    completed: correctCount === inputs.length\n                }\n            }));\n\n            // Post message for iframe containers\n            if(window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: inputs.length }, '*');\n            }\n        }\n\n        function resetActivity() {\n            document.getElementById('quiz-form').reset();\n            \n            // Reset buttons styling\n            const allOptionBtns = document.querySelectorAll('.option-btn');\n            allOptionBtns.forEach(btn => {\n                btn.className = `option-btn px-4 py-2 text-sm font-semibold rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 min-h-[42px] transition-all`;\n            });\n\n            // Reset cards styling\n            const cards = document.querySelectorAll('.sentence-card');\n            cards.forEach(card => {\n                card.classList.remove('border-emerald-300', 'bg-emerald-50/30', 'border-rose-200', 'bg-rose-50/30');\n                const fb = card.querySelector('.feedback-msg');\n                fb.classList.add('hidden');\n                fb.innerHTML = '';\n            });\n\n            // Reset scoreboard & audio lock\n            document.getElementById('score-display').innerText = '0';\n            document.getElementById('completion-status').innerText = \"Select all items to enable check answers.\";\n            \n            audioUnlocked = false;\n            audioPlaying = false;\n            document.getElementById('play-text').innerText = \"Listen R9.4\";\n            document.getElementById('audio-timer').innerText = \"0:00 / 0:35\";\n            \n            const notice = document.getElementById('audio-lock-notice');\n            notice.className = \"text-xs font-semibold px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1.5 transition-all\";\n            notice.innerHTML = `<svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"></path></svg><span>Classify all 7 items to unlock audio</span>`;\n\n            document.getElementById('audio-player-container').classList.add('opacity-50', 'pointer-events-none');\n            document.getElementById('check-btn').setAttribute('disabled', 'true');\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793300029888,
      "title": "Help with Grammar: too, too much, too many, (not) enough",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Help with Grammar: too, too much, too many, (not) enough</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n        /* Transición suave para feedback */\n        input, select {\n            transition: all 0.2s ease-in-out;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Contenedor Principal (w-full max-w-4xl mx-auto según directrices) -->\n    <main class=\"w-full max-w-4xl mx-auto bg-white shadow-sm border border-slate-200 rounded-2xl my-4 sm:my-8 p-4 sm:p-6 md:p-8 flex flex-col gap-6\">\n        \n        <!-- Cabecera de la Actividad -->\n        <header class=\"border-b border-slate-100 pb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n            <div>\n                <span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 mb-2\">\n                    <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.75 0-3.332.477-4.5 1.253\"/></svg>\n                    Help with Grammar\n                </span>\n                <h1 class=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight\">too, too much, too many, (not) enough</h1>\n            </div>\n            <!-- Marcador y Estado -->\n            <div class=\"flex items-center gap-3 bg-slate-50 px-4 py-2 rounded-xl border border-slate-200 w-full sm:w-auto justify-between sm:justify-start\">\n                <span class=\"text-sm font-medium text-slate-600\">Score:</span>\n                <span id=\"score-display\" class=\"text-lg font-bold text-indigo-600\">0 / 6</span>\n            </div>\n        </header>\n\n        <!-- Sección de Referencia Interactiva / Acordeón de Análisis -->\n        <section class=\"bg-indigo-50/50 border border-indigo-100 rounded-xl p-4 sm:p-5\">\n            <details class=\"group\" open>\n                <summary class=\"flex justify-between items-center font-semibold text-indigo-900 cursor-pointer list-none text-base\">\n                    <span class=\"flex items-center gap-2\">\n                        <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n                        Reference: Look at sentences 1–3 and complete the rule.\n                    </span>\n                    <span class=\"transition group-open:rotate-180\">\n                        <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"/></svg>\n                    </span>\n                </summary>\n                \n                <div class=\"mt-4 pt-3 border-t border-indigo-100 text-sm text-slate-700 flex flex-col gap-3\">\n                    <!-- Sentencias de Referencia -->\n                    <div class=\"bg-white p-3 rounded-lg border border-indigo-100 space-y-1.5 shadow-sm\">\n                        <p class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Example Sentences:</p>\n                        <p>1. I feel a bit guilty, so I try not to get home <strong class=\"text-indigo-700\">too late</strong>.</p>\n                        <p>2. I get upset when he says he's got <strong class=\"text-indigo-700\">too much work</strong> to do.</p>\n                        <p>3. I've always got <strong class=\"text-indigo-700\">too many things</strong> to do.</p>\n                    </div>\n\n                    <p class=\"font-medium text-slate-800\">We use <code class=\"bg-white px-1.5 py-0.5 rounded border border-indigo-100 font-semibold text-indigo-600\">too</code>, <code class=\"bg-white px-1.5 py-0.5 rounded border border-indigo-100 font-semibold text-indigo-600\">too much</code> and <code class=\"bg-white px-1.5 py-0.5 rounded border border-indigo-100 font-semibold text-indigo-600\">too many</code> to say something is <strong>more</strong> than we want.</p>\n                </div>\n            </details>\n        </section>\n\n        <!-- Bloque de Ejercicio Principal -->\n        <section class=\"space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <h2 class=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n                    <span class=\"flex items-center justify-center bg-slate-900 text-white w-6 h-6 rounded-full text-xs\">6a</span>\n                    Fill in the gaps with the correct grammatical category:\n                </h2>\n                <span class=\"text-xs text-slate-500 font-medium\">Select or type option</span>\n            </div>\n\n            <!-- Contenedor de Preguntas -->\n            <div class=\"grid grid-cols-1 gap-3\">\n                \n                <!-- Ítem 1 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 bg-white border border-slate-200 rounded-xl gap-3 shadow-sm hover:border-slate-300 transition\">\n                    <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-100 text-slate-700 font-semibold text-sm flex items-center justify-center\">1</span>\n                        <span class=\"text-base font-medium text-slate-800\">too +</span>\n                    </div>\n                    <div class=\"w-full sm:w-72\">\n                        <select id=\"q1\" data-answer=\"adjective\" class=\"w-full h-11 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer\">\n                            <option value=\"\">-- Choose category --</option>\n                            <option value=\"adjective\">adjective</option>\n                            <option value=\"countable noun\">countable noun</option>\n                            <option value=\"uncountable noun\">uncountable noun</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Ítem 2 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 bg-white border border-slate-200 rounded-xl gap-3 shadow-sm hover:border-slate-300 transition\">\n                    <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-100 text-slate-700 font-semibold text-sm flex items-center justify-center\">2</span>\n                        <span class=\"text-base font-medium text-slate-800\">too much +</span>\n                    </div>\n                    <div class=\"w-full sm:w-72\">\n                        <select id=\"q2\" data-answer=\"uncountable noun\" class=\"w-full h-11 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer\">\n                            <option value=\"\">-- Choose category --</option>\n                            <option value=\"adjective\">adjective</option>\n                            <option value=\"countable noun\">countable noun</option>\n                            <option value=\"uncountable noun\">uncountable noun</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Ítem 3 -->\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 bg-white border border-slate-200 rounded-xl gap-3 shadow-sm hover:border-slate-300 transition\">\n                    <div class=\"flex items-center gap-3 w-full sm:w-auto\">\n                        <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-slate-100 text-slate-700 font-semibold text-sm flex items-center justify-center\">3</span>\n                        <span class=\"text-base font-medium text-slate-800\">too many +</span>\n                    </div>\n                    <div class=\"w-full sm:w-72\">\n                        <select id=\"q3\" data-answer=\"countable noun\" class=\"w-full h-11 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer\">\n                            <option value=\"\">-- Choose category --</option>\n                            <option value=\"adjective\">adjective</option>\n                            <option value=\"countable noun\">countable noun</option>\n                            <option value=\"uncountable noun\">uncountable noun</option>\n                        </select>\n                    </div>\n                </div>\n\n            </div>\n        </section>\n\n        <!-- Bloque Adicional Extraído de los Recortes (Práctica de Consolidación o Extensión) -->\n        <section class=\"space-y-4 pt-4 border-t border-slate-100\">\n            <h2 class=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n                <span class=\"flex items-center justify-center bg-slate-900 text-white w-6 h-6 rounded-full text-xs\">6b</span>\n                Quick Practice: Choose the correct option for each sentence.\n            </h2>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n                <!-- Mini ítem 1 -->\n                <div class=\"bg-slate-50/70 border border-slate-200 p-3.5 rounded-xl flex flex-col justify-between gap-3\">\n                    <p class=\"text-sm text-slate-700\">There is <select id=\"q4\" data-answer=\"too much\" class=\"inline-block mx-1 px-2 py-1 bg-white border border-slate-300 rounded text-sm font-semibold focus:ring-2 focus:ring-indigo-500 focus:outline-none\"><option value=\"\">--?</option><option value=\"too much\">too much</option><option value=\"too many\">too many</option></select> salt in this soup.</p>\n                </div>\n                <!-- Mini ítem 2 -->\n                <div class=\"bg-slate-50/70 border border-slate-200 p-3.5 rounded-xl flex flex-col justify-between gap-3\">\n                    <p class=\"text-sm text-slate-700\">I have <select id=\"q5\" data-answer=\"too many\" class=\"inline-block mx-1 px-2 py-1 bg-white border border-slate-300 rounded text-sm font-semibold focus:ring-2 focus:ring-indigo-500 focus:outline-none\"><option value=\"\">--?</option><option value=\"too much\">too much</option><option value=\"too many\">too many</option></select> emails to answer today.</p>\n                </div>\n                <!-- Mini ítem 3 -->\n                <div class=\"bg-slate-50/70 border border-slate-200 p-3.5 rounded-xl flex flex-col justify-between gap-3\">\n                    <p class=\"text-sm text-slate-700\">The music is <select id=\"q6\" data-answer=\"too\" class=\"inline-block mx-1 px-2 py-1 bg-white border border-slate-300 rounded text-sm font-semibold focus:ring-2 focus:ring-indigo-500 focus:outline-none\"><option value=\"\">--?</option><option value=\"too\">too</option><option value=\"too much\">too much</option></select> loud.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Barra de Botones y Acciones Táctiles (Mínimo 42px) -->\n        <footer class=\"pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3\">\n            <button id=\"reset-btn\" class=\"w-full sm:w-auto px-5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm shadow-sm transition active:scale-95 flex items-center justify-center gap-2 cursor-pointer\">\n                <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\n                Reset Activity\n            </button>\n            <button id=\"check-btn\" class=\"w-full sm:w-auto px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-sm transition active:scale-95 flex items-center justify-center gap-2 cursor-pointer\">\n                <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"/></svg>\n                Check Answers\n            </button>\n        </footer>\n\n    </main>\n\n    <!-- Script de Lógica, Métricas y Calificación -->\n    <script>\n        // Declaración obligatoria del Contrato de Métricas Pedagógicas\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'too_too_much_too_many_enough',\n            maxScore: 6\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const scoreDisplay = document.getElementById('score-display');\n            \n            const inputs = ['q1', 'q2', 'q3', 'q4', 'q5', 'q6'].map(id => document.getElementById(id));\n\n            function checkAnswers() {\n                let correctCount = 0;\n                const total = inputs.length;\n\n                inputs.forEach(input => {\n                    const userAnswer = input.value.trim().toLowerCase();\n                    const correctAnswer = input.getAttribute('data-answer').toLowerCase();\n\n                    // Limpiar clases previas\n                    input.classList.remove('is-correct', 'is-wrong');\n\n                    if (userAnswer === correctAnswer) {\n                        input.classList.add('is-correct');\n                        correctCount++;\n                    } else if (userAnswer !== \"\") {\n                        input.classList.add('is-wrong');\n                    } else {\n                        // Campo vacío considerado incorrecto visualmente\n                        input.classList.add('is-wrong');\n                    }\n                });\n\n                // Actualizar display de puntuación\n                scoreDisplay.textContent = `${correctCount} / ${total}`;\n\n                // Despachar evento global requerido por el framework contenedor\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: total,\n                        completed: correctCount === total\n                    }\n                }));\n\n                // Mensaje vía postMessage para entornos iframe sandbox\n                if (window.parent !== window) {\n                    window.parent.postMessage({ \n                        type: 'ACTIVITY_SCORE', \n                        score: correctCount, \n                        total: total \n                    }, '*');\n                }\n            }\n\n            function resetActivity() {\n                inputs.forEach(input => {\n                    input.value = \"\";\n                    input.classList.remove('is-correct', 'is-wrong');\n                });\n                scoreDisplay.textContent = `0 / ${inputs.length}`;\n            }\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793300154964,
      "title": "Grammar Practice: Not + Enough",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Grammar Practice: Not + Enough</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header with Metrics & Title -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"w-full max-w-4xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-indigo-600 text-white p-2 rounded-xl text-sm shadow-sm flex items-center justify-center\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round5\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </span>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Grammar Builder: Not + Enough</h1>\n                    <p class=\"text-xs text-slate-500\">Grammar structure analysis and application</p>\n                </div>\n            </div>\n            <!-- Score Counter -->\n            <div id=\"score-display\" class=\"bg-indigo-50 border border-indigo-100 text-indigo-700 px-3 py-1.5 rounded-xl text-sm font-semibold shadow-inner\">\n                Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">2</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 my-auto flex-grow\">\n        <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8 space-y-6\">\n\n            <!-- Instruction Box -->\n            <div class=\"bg-indigo-50/60 border-l-4 border-indigo-600 p-4 rounded-r-xl\">\n                <h2 class=\"text-sm font-bold uppercase tracking-wider text-indigo-900 mb-1 flex items-center gap-1.5\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round5\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                    Grammar Rule & Practice\n                </h2>\n                <p class=\"text-slate-700 text-sm sm:text-base leading-relaxed\">\n                    We use <strong>not enough</strong> to say something is less than we want. Look at sentences 4 and 5 below, then fill in the gaps with the correct grammatical categories.\n                </p>\n            </div>\n\n            <!-- Reference Sentences Accordion / Box -->\n            <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-5\">\n                <h3 class=\"text-xs font-bold uppercase tracking-wider text-slate-500 mb-3\">Reference Sentences (from 5a)</h3>\n                <ul class=\"space-y-2 text-sm sm:text-base text-slate-800 font-medium\">\n                    <li class=\"flex items-start gap-2 bg-white p-3 rounded-lg border border-slate-100 shadow-xs\">\n                        <span class=\"bg-slate-200 text-slate-700 text-xs px-2 py-0.5 rounded-md font-bold mt-0.5\">4</span>\n                        <span>She's <strong class=\"text-indigo-600\">not old enough</strong> to talk.</span>\n                    </li>\n                    <li class=\"flex items-start gap-2 bg-white p-3 rounded-lg border border-slate-100 shadow-xs\">\n                        <span class=\"bg-slate-200 text-slate-700 text-xs px-2 py-0.5 rounded-md font-bold mt-0.5\">5</span>\n                        <span>I <strong class=\"text-indigo-600\">don't have enough energy</strong> to do anything in the day.</span>\n                    </li>\n                </ul>\n            </div>\n\n            <!-- Interactive Exercise Form -->\n            <form id=\"grammar-form\" class=\"space-y-6 pt-2\" onsubmit=\"return false;\">\n                \n                <h3 class=\"text-sm font-bold uppercase tracking-wider text-slate-600 border-b pb-2\">Complete the Formula Structure</h3>\n\n                <div class=\"space-y-5\">\n                    <!-- Item 1 -->\n                    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50 p-4 rounded-xl border border-slate-200\">\n                        <div class=\"flex items-center gap-3\">\n                            <span class=\"w-7 h-7 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold text-sm shrink-0\">1</span>\n                            <span class=\"text-slate-800 font-medium text-base\">not +</span>\n                        </div>\n                        <div class=\"flex items-center gap-2 flex-wrap\">\n                            <input type=\"text\" \n                                   data-answer=\"adjective\" \n                                   placeholder=\"type word...\" \n                                   class=\"bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-48 transition-all shadow-xs\"\n                                   autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\">\n                            <span class=\"text-slate-800 font-medium text-base ml-1\">+ enough</span>\n                        </div>\n                    </div>\n\n                    <!-- Item 2 -->\n                    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50 p-4 rounded-xl border border-slate-200\">\n                        <div class=\"flex items-center gap-3\">\n                            <span class=\"w-7 h-7 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold text-sm shrink-0\">2</span>\n                            <span class=\"text-slate-800 font-medium text-base\">not + verb + enough +</span>\n                        </div>\n                        <div class=\"flex items-center gap-2 flex-wrap\">\n                            <input type=\"text\" \n                                   data-answer=\"noun\" \n                                   placeholder=\"type word...\" \n                                   class=\"bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-48 transition-all shadow-xs\"\n                                   autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\">\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Action Buttons -->\n                <div class=\"flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-slate-100\">\n                    <button type=\"button\" id=\"check-btn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium py-3 px-6 rounded-xl transition-all shadow-sm flex items-center justify-center gap-2 min-h-[46px] cursor-pointer\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round5\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                        </svg>\n                        Check Answers\n                    </button>\n                    <button type=\"button\" id=\"reset-btn\" class=\"w-full sm:w-auto bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 font-medium py-3 px-5 rounded-xl transition-all flex items-center justify-center gap-2 min-h-[46px] cursor-pointer\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-slate-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round5\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                        </svg>\n                        Reset Activity\n                    </button>\n                </div>\n\n            </form>\n\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t bg-white mt-8\">\n        Interactive Grammar Studio • ELT Content Engine\n    </footer>\n\n    <!-- Script Logic & Metrics Contract -->\n    <script>\n        // Mandatory Metrics Declaration\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'not_enough_structures',\n            maxScore: 2\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const inputs = document.querySelectorAll('input[data-answer]');\n            const currentScoreEl = document.getElementById('current-score');\n            const totalScoreEl = document.getElementById('total-score');\n            \n            totalScoreEl.textContent = inputs.length;\n\n            function normalize(text) {\n                return text.trim().toLowerCase();\n            }\n\n            function checkAnswers() {\n                let correctCount = 0;\n\n                inputs.forEach(input => {\n                    const userVal = normalize(input.value);\n                    const expectedVal = normalize(input.getAttribute('data-answer'));\n\n                    input.classList.remove('is-correct', 'is-wrong');\n\n                    if (userVal === expectedVal && userVal !== '') {\n                        input.classList.add('is-correct');\n                        correctCount++;\n                    } else {\n                        input.classList.add('is-wrong');\n                    }\n                });\n\n                currentScoreEl.textContent = correctCount;\n\n                // Dispatch global event for live session integration\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                // Post message for iframe container wrapper sync\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: inputs.length\n                    }, '*');\n                }\n            }\n\n            function resetActivity() {\n                inputs.forEach(input => {\n                    input.value = '';\n                    input.classList.remove('is-correct', 'is-wrong');\n                });\n                currentScoreEl.textContent = '0';\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: inputs.length,\n                        completed: false\n                    }\n                }));\n\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: 0,\n                        total: inputs.length\n                    }, '*');\n                }\n            }\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793300310668,
      "title": "Grammar Focus: Enough - ELT Micro-App",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Grammar Focus: Enough - ELT Micro-App</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- MAIN APP CONTAINER -->\n    <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm my-4 sm:my-8 overflow-hidden flex flex-col\">\n\n        <!-- HEADER STICKY BAR -->\n        <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-6 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4 shadow-sm\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm flex items-center justify-center\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </div>\n                <div>\n                    <span class=\"text-xs font-semibold uppercase tracking-wider text-indigo-600 block\">Grammar Builder</span>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Position of <span class=\"text-indigo-600\">enough</span></h1>\n                </div>\n            </div>\n\n            <div class=\"flex items-center gap-3 ml-auto\">\n                <div class=\"bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200 flex items-center gap-2\">\n                    <span class=\"text-xs font-medium text-slate-500 uppercase tracking-wide\">Score:</span>\n                    <span id=\"score-display\" class=\"text-sm font-bold text-slate-800\">0 / 4</span>\n                </div>\n            </div>\n        </header>\n\n        <!-- ACTIVITY CONTENT CONTAINER -->\n        <div class=\"p-4 sm:p-6 md:p-8 space-y-6 flex-grow\">\n\n            <!-- INSTRUCTION & REFERENCE CARD -->\n            <section class=\"bg-indigo-50/60 border border-indigo-100 rounded-2xl p-4 sm:p-5\">\n                <div class=\"flex items-start gap-3\">\n                    <div class=\"bg-indigo-600 text-white rounded-full w-7 h-7 flex items-center justify-center shrink-0 font-bold text-sm mt-0.5\">c</div>\n                    <div class=\"space-y-3 text-sm sm:text-base text-slate-700\">\n                        <p class=\"leading-relaxed font-medium\">\n                            We use <strong class=\"text-indigo-700\">enough</strong> to say something is the <u>correct number or amount</u>. Look at sentences 6 and 7 below, then complete the grammar rules.\n                        </p>\n\n                        <!-- REFERENCE SENTENCES (OCR #2) -->\n                        <div class=\"bg-white/90 border border-indigo-100 rounded-xl p-3 space-y-2 shadow-xs\">\n                            <div class=\"flex items-start gap-2 text-xs sm:text-sm\">\n                                <span class=\"font-bold text-indigo-600 bg-indigo-50 px-1.5 py-0.5 rounded\">6</span>\n                                <p class=\"text-slate-800\">I earn <strong class=\"text-slate-900\">enough money</strong> for the whole family.</p>\n                            </div>\n                            <div class=\"flex items-start gap-2 text-xs sm:text-sm\">\n                                <span class=\"font-bold text-indigo-600 bg-indigo-50 px-1.5 py-0.5 rounded\">7</span>\n                                <p class=\"text-slate-800\">I think this place is <strong class=\"text-slate-900\">big enough</strong> for us.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- INTERACTIVE EXERCISE SECTION -->\n            <section class=\"space-y-4 pt-2\">\n                <h2 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider px-1\">Complete the Rules</h2>\n\n                <div class=\"space-y-3\">\n                    <!-- Rule Item 1 -->\n                    <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs hover:border-slate-300 transition\">\n                        <div class=\"flex items-center gap-3\">\n                            <span class=\"w-2.5 h-2.5 rounded-full bg-indigo-500 shrink-0\"></span>\n                            <span class=\"text-base font-semibold text-slate-800\">enough +</span>\n                        </div>\n                        <div class=\"w-full sm:w-64\">\n                            <select id=\"gap-1\" data-answer=\"noun\" class=\"w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 px-3 text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition\">\n                                <option value=\"\" disabled selected>-- choose grammar category --</option>\n                                <option value=\"noun\">noun</option>\n                                <option value=\"adjective\">adjective</option>\n                                <option value=\"verb\">verb</option>\n                            </select>\n                        </div>\n                    </div>\n\n                    <!-- Rule Item 2 -->\n                    <div class=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs hover:border-slate-300 transition\">\n                        <div class=\"flex items-center gap-3 order-1 sm:order-2\">\n                            <span class=\"text-base font-semibold text-slate-800\">+ enough</span>\n                            <span class=\"w-2.5 h-2.5 rounded-full bg-indigo-500 shrink-0\"></span>\n                        </div>\n                        <div class=\"w-full sm:w-64 order-2 sm:order-1\">\n                            <select id=\"gap-2\" data-answer=\"adjective\" class=\"w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 px-3 text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition\">\n                                <option value=\"\" disabled selected>-- choose grammar category --</option>\n                                <option value=\"noun\">noun</option>\n                                <option value=\"adjective\">adjective</option>\n                                <option value=\"adverb\">adverb</option>\n                            </select>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- EXTRA REINFORCEMENT PRACTICE (Bonus Gaps for 4 total score items) -->\n            <section class=\"space-y-4 pt-4 border-t border-slate-100\">\n                <h2 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider px-1\">Apply the Rule (Quick Check)</h2>\n                \n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    <!-- Practice Item 1 -->\n                    <div class=\"bg-slate-50/70 border border-slate-200 rounded-xl p-4 flex flex-col justify-between gap-3\">\n                        <p class=\"text-sm font-medium text-slate-700\">\n                            We don't have <input type=\"text\" id=\"gap-3\" data-answer=\"enough time\" data-alts=\"enough time,time enough\" placeholder=\"type here...\" class=\"inline-block mx-1 w-32 border border-slate-300 rounded-lg px-2 py-1 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500\" /> to finish this exercise. <span class=\"text-xs text-slate-400 block mt-1\">(Use: time)</span>\n                        </p>\n                    </div>\n\n                    <!-- Practice Item 2 -->\n                    <div class=\"bg-slate-50/70 border border-slate-200 rounded-xl p-4 flex flex-col justify-between gap-3\">\n                        <p class=\"text-sm font-medium text-slate-700\">\n                            Is your coffee <input type=\"text\" id=\"gap-4\" data-answer=\"hot enough\" data-alts=\"hot enough\" placeholder=\"type here...\" class=\"inline-block mx-1 w-32 border border-slate-300 rounded-lg px-2 py-1 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500\" /> or should I microwave it? <span class=\"text-xs text-slate-400 block mt-1\">(Use: hot)</span>\n                        </p>\n                    </div>\n                </div>\n            </section>\n\n        </div>\n\n        <!-- FOOTER ACTION BAR -->\n        <footer class=\"bg-slate-50 border-t border-slate-200 py-4 px-6 flex flex-wrap items-center justify-between gap-4\">\n            <div id=\"feedback-message\" class=\"text-sm font-medium text-slate-600\">\n                Complete all items and click \"Check Answers\".\n            </div>\n            <div class=\"flex items-center gap-3 ml-auto\">\n                <button id=\"reset-btn\" onclick=\"resetActivity()\" class=\"px-4 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-medium text-sm transition flex items-center gap-2 shadow-xs cursor-pointer min-h-[42px]\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    Reset\n                </button>\n                <button id=\"check-btn\" onclick=\"checkAnswers()\" class=\"px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition flex items-center gap-2 shadow-sm cursor-pointer min-h-[42px]\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                    Check Answers\n                </button>\n            </div>\n        </footer>\n\n    </main>\n\n    <script>\n        // CONTRACT OBLIGATORY METRICS\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'enough_position_rules',\n            maxScore: 4\n        };\n\n        function normalizeText(text) {\n            return (text || '').toLowerCase().trim().replace(/\\s+/g, ' ');\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const selects = [document.getElementById('gap-1'), document.getElementById('gap-2')];\n            const inputs = [document.getElementById('gap-3'), document.getElementById('gap-4')];\n\n            // Evaluate Selects\n            selects.forEach(el => {\n                const userVal = normalizeText(el.value);\n                const expected = normalizeText(el.getAttribute('data-answer'));\n                el.classList.remove('is-correct', 'is-wrong');\n                if (userVal === expected) {\n                    el.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    el.classList.add('is-wrong');\n                }\n            });\n\n            // Evaluate Inputs\n            inputs.forEach(el => {\n                const userVal = normalizeText(el.value);\n                const expected = normalizeText(el.getAttribute('data-answer'));\n                const alts = (el.getAttribute('data-alts') || '').split(',').map(normalizeText);\n                \n                el.classList.remove('is-correct', 'is-wrong');\n                if (userVal === expected || alts.includes(userVal)) {\n                    el.classList.add('is-correct');\n                    correctCount++;\n                } else {\n                    el.classList.add('is-wrong');\n                }\n            });\n\n            const total = selects.length + inputs.length;\n\n            // Update UI Score\n            document.getElementById('score-display').textContent = `${correctCount} / ${total}`;\n            \n            const feedbackEl = document.getElementById('feedback-message');\n            if (correctCount === total) {\n                feedbackEl.textContent = \"🎉 Excellent work! All answers are correct.\";\n                feedbackEl.className = \"text-sm font-semibold text-emerald-600\";\n            } else {\n                feedbackEl.textContent = `You got ${correctCount} out of ${total} correct. Review the errors highlighted in red.`;\n                feedbackEl.className = \"text-sm font-semibold text-amber-600\";\n            }\n\n            // Dispatch Custom Event for ELT Platform integration\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: total,\n                    completed: correctCount === total\n                }\n            }));\n\n            // Post Message to parent iframe container if applicable\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: total\n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const selects = [document.getElementById('gap-1'), document.getElementById('gap-2')];\n            const inputs = [document.getElementById('gap-3'), document.getElementById('gap-4')];\n\n            selects.forEach(el => {\n                el.value = \"\";\n                el.classList.remove('is-correct', 'is-wrong');\n            });\n\n            inputs.forEach(el => {\n                el.value = \"\";\n                el.classList.remove('is-correct', 'is-wrong');\n            });\n\n            document.getElementById('score-display').textContent = \"0 / 4\";\n            const feedbackEl = document.getElementById('feedback-message');\n            feedbackEl.textContent = 'Complete all items and click \"Check Answers\".';\n            feedbackEl.className = \"text-sm font-medium text-slate-600\";\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793300846300,
      "title": "Grammar Practice: Too, Too much, Too many, Enough",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Grammar Practice: Too, Too much, Too many, Enough</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n        .transition-all { transition: all 0.25s ease-in-out; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header with Score & Metrics info -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-8 border-b border-slate-200 shadow-sm w-full\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-2\">\n                <span class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n                </span>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Grammar Lab: Too & Enough</h1>\n                    <p class=\"text-xs text-slate-500 font-medium\">Infinitive structures with <span class=\"text-indigo-600 font-semibold\">too</span> / <span class=\"text-indigo-600 font-semibold\">enough</span></p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 ml-auto sm:ml-0\">\n                <div class=\"bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 flex items-center gap-1.5\">\n                    <span>Score:</span>\n                    <span id=\"score-display\" class=\"text-indigo-600 font-bold\">0 / 5</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n        \n        <!-- Instructional Card / Reference Section -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm mb-6\">\n            <div class=\"flex items-start gap-3\">\n                <div class=\"bg-amber-100 text-amber-700 p-2.5 rounded-xl mt-0.5\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                </div>\n                <div>\n                    <h2 class=\"text-base sm:text-lg font-bold text-slate-900\">Grammar Exploration</h2>\n                    <p class=\"text-sm text-slate-600 mt-1\">\n                        Analyze the sentences below (extracted from target structures) and answer: \n                        <strong class=\"text-slate-800\">Do we use the infinitive with <em class=\"text-indigo-600\">to</em> or <em class=\"text-indigo-600\">verb+ing</em> after these phrases?</strong>\n                    </p>\n                </div>\n            </div>\n\n            <!-- Accordion for Reference Sentences -->\n            <details class=\"mt-4 bg-slate-50 border border-slate-200 rounded-xl overflow-hidden group\">\n                <summary class=\"p-3.5 text-xs sm:text-sm font-semibold text-slate-700 cursor-pointer flex items-center justify-between hover:bg-slate-100 transition-all select-none\">\n                    <span class=\"flex items-center gap-2\">\n                        <svg class=\"w-4 h-4 text-indigo-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\"></path></svg>\n                        View Reference Sentences (1–5)\n                    </span>\n                    <span class=\"text-xs text-indigo-600 font-bold group-open:rotate-180 transition-transform\">▼</span>\n                </summary>\n                <div class=\"p-4 border-t border-slate-200 text-xs sm:text-sm space-y-2 bg-white\">\n                    <p class=\"text-slate-700\"><strong class=\"text-slate-900\">1.</strong> I feel a bit guilty, so I try not to get home <strong class=\"text-slate-900\">too late</strong>.</p>\n                    <p class=\"text-slate-700\"><strong class=\"text-slate-900\">2.</strong> I get upset when he says he's got <strong class=\"text-slate-900\">too much work</strong> to do.</p>\n                    <p class=\"text-slate-700\"><strong class=\"text-slate-900\">3.</strong> I've always got <strong class=\"text-slate-900\">too many things</strong> to do.</p>\n                    <p class=\"text-slate-700\"><strong class=\"text-slate-900\">4.</strong> She's <strong class=\"text-slate-900\">not old enough</strong> to talk.</p>\n                    <p class=\"text-slate-700\"><strong class=\"text-slate-900\">5.</strong> I don't have <strong class=\"text-slate-900\">enough energy</strong> to do anything in the day.</p>\n                </div>\n            </details>\n        </section>\n\n        <!-- Interactive Task Section -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm\">\n            <div class=\"border-b border-slate-100 pb-4 mb-5 flex items-center justify-between\">\n                <div>\n                    <h3 class=\"text-base font-bold text-slate-900\">Practice Activity</h3>\n                    <p class=\"text-xs sm:text-sm text-slate-500\">Select the correct grammatical completion for the rule or complete the sentence.</p>\n                </div>\n                <span class=\"bg-slate-800 text-white text-xs font-bold px-2.5 py-1 rounded-lg\">5 Items</span>\n            </div>\n\n            <div class=\"space-y-6\" id=\"questions-container\">\n                \n                <!-- Question 1 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 question-card\" data-id=\"1\">\n                    <div class=\"flex items-start gap-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold h-6 w-6 rounded-full flex items-center justify-center shrink-0 mt-0.5\">1</span>\n                        <div class=\"w-full\">\n                            <p class=\"text-sm sm:text-base font-medium text-slate-800 mb-3\">\n                                The phrases with <code class=\"bg-indigo-50 text-indigo-700 px-1.5 py-0.5 rounded font-semibold text-sm\">too</code>, <code class=\"bg-indigo-50 text-indigo-700 px-1.5 py-0.5 rounded font-semibold text-sm\">too much</code>, <code class=\"bg-indigo-50 text-indigo-700 px-1.5 py-0.5 rounded font-semibold text-sm\">too many</code>, and <code class=\"bg-indigo-50 text-indigo-700 px-1.5 py-0.5 rounded font-semibold text-sm\">enough</code> are followed by:\n                            </p>\n                            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q1\" value=\"infinitive with to\" data-answer=\"infinitive with to\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    Infinitive with <em class=\"ml-1\">to</em>\n                                </label>\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q1\" value=\"verb+ing\" data-answer=\"infinitive with to\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    Verb + <em class=\"ml-1\">ing</em>\n                                </label>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Question 2 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 question-card\" data-id=\"2\">\n                    <div class=\"flex items-start gap-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold h-6 w-6 rounded-full flex items-center justify-center shrink-0 mt-0.5\">2</span>\n                        <div class=\"w-full\">\n                            <p class=\"text-sm sm:text-base font-medium text-slate-800 mb-3\">\n                                Complete the rule: We use <strong class=\"text-indigo-600\">too</strong> before an adjective or an...\n                            </p>\n                            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q2\" value=\"adverb\" data-answer=\"adverb\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    adverb (e.g., <em>too late</em>)\n                                </label>\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q2\" value=\"noun\" data-answer=\"adverb\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    noun directly\n                                </label>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Question 3 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 question-card\" data-id=\"3\">\n                    <div class=\"flex items-start gap-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold h-6 w-6 rounded-full flex items-center justify-center shrink-0 mt-0.5\">3</span>\n                        <div class=\"w-full\">\n                            <p class=\"text-sm sm:text-base font-medium text-slate-800 mb-3\">\n                                We use <strong class=\"text-indigo-600\">too much</strong> before an/a...\n                            </p>\n                            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q3\" value=\"uncountable noun\" data-answer=\"uncountable noun\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    uncountable noun (e.g., <em>too much work</em>)\n                                </label>\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q3\" value=\"countable noun\" data-answer=\"uncountable noun\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    plural countable noun\n                                </label>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Question 4 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 question-card\" data-id=\"4\">\n                    <div class=\"flex items-start gap-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold h-6 w-6 rounded-full flex items-center justify-center shrink-0 mt-0.5\">4</span>\n                        <div class=\"w-full\">\n                            <p class=\"text-sm sm:text-base font-medium text-slate-800 mb-3\">\n                                We use <strong class=\"text-indigo-600\">too many</strong> before a...\n                            </p>\n                            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q4\" value=\"plural countable noun\" data-answer=\"plural countable noun\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    plural countable noun (e.g., <em>too many things</em>)\n                                </label>\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q4\" value=\"uncountable noun\" data-answer=\"plural countable noun\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    uncountable noun\n                                </label>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Question 5 -->\n                <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 question-card\" data-id=\"5\">\n                    <div class=\"flex items-start gap-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold h-6 w-6 rounded-full flex items-center justify-center shrink-0 mt-0.5\">5</span>\n                        <div class=\"w-full\">\n                            <p class=\"text-sm sm:text-base font-medium text-slate-800 mb-3\">\n                                Where does <strong class=\"text-indigo-600\">enough</strong> go in relation to adjectives and nouns?\n                            </p>\n                            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q5\" value=\"after adjectives / before nouns\" data-answer=\"after adjectives / before nouns\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    <span class=\"text-xs\"><strong>After</strong> adjectives</strong> (<em>old enough</em>) & <strong>Before</strong> nouns (<em>enough energy</em>)</span>\n                                </label>\n                                <label class=\"flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:border-indigo-300 transition-all text-sm font-medium text-slate-700\">\n                                    <input type=\"radio\" name=\"q5\" value=\"before both\" data-answer=\"after adjectives / before nouns\" class=\"text-indigo-600 focus:ring-indigo-500 h-4 w-4\">\n                                    <span class=\"text-xs\">Before adjectives & after nouns</span>\n                                </label>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"mt-8 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-100\">\n                <button id=\"reset-btn\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold transition-all flex items-center gap-2 min-h-[42px]\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    Reset Activity\n                </button>\n                <button id=\"check-btn\" class=\"px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-all shadow-sm flex items-center gap-2 min-h-[42px]\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    Check Answers\n                </button>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full py-4 text-center text-xs text-slate-400 border-t border-slate-200 mt-8\">\n        ELT Interactive Micro-App • Designed for Responsive Touch & Mobile Accessibility\n    </footer>\n\n    <!-- Script Application Logic & Metrics Contract -->\n    <script>\n        // Activity Metrics Declaration Contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'too_enough_structures',\n            maxScore: 5\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const scoreDisplay = document.getElementById('score-display');\n            const questionCards = document.querySelectorAll('.question-card');\n\n            checkBtn.addEventListener('click', () => {\n                let correctCount = 0;\n                const total = questionCards.length;\n\n                questionCards.forEach((card) => {\n                    const selectedInput = card.querySelector('input[type=\"radio\"]:checked');\n                    \n                    // Reset card visual state\n                    card.classList.remove('bg-emerald-50/60', 'border-emerald-300', 'bg-rose-50/60', 'border-rose-300');\n                    card.classList.add('bg-slate-50/50', 'border-slate-200');\n\n                    if (selectedInput) {\n                        const correctAnswer = selectedInput.getAttribute('data-answer');\n                        // In this questionnaire, the correct option values match data-answer directly\n                        if (selectedInput.value === correctAnswer) {\n                            correctCount++;\n                            card.classList.remove('bg-slate-50/50', 'border-slate-200');\n                            card.classList.add('bg-emerald-50/60', 'border-emerald-300');\n                        } else {\n                            card.classList.remove('bg-slate-50/50', 'border-slate-200');\n                            card.classList.add('bg-rose-50/60', 'border-rose-300');\n                        }\n                    } else {\n                        card.classList.remove('bg-slate-50/50', 'border-slate-200');\n                        card.classList.add('bg-rose-50/60', 'border-rose-300');\n                    }\n                });\n\n                // Update Score display\n                scoreDisplay.textContent = `${correctCount} / ${total}`;\n\n                // Dispatch mandatory custom event for live platform tracking\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: total,\n                        completed: correctCount === total\n                    }\n                }));\n\n                // Post message helper for outer iframe wrappers\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: total\n                    }, '*');\n                }\n            });\n\n            resetBtn.addEventListener('click', () => {\n                const radios = document.querySelectorAll('input[type=\"radio\"]');\n                radios.forEach(radio => radio.checked = false);\n\n                questionCards.forEach(card => {\n                    card.classList.remove('bg-emerald-50/60', 'border-emerald-300', 'bg-rose-50/60', 'border-rose-300');\n                    card.classList.add('bg-slate-50/50', 'border-slate-200');\n                });\n\n                scoreDisplay.textContent = `0 / ${questionCards.length}`;\n            });\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793301195578,
      "title": "Grammar Practice: Too, Too Much, Too Many, Enough",
      "html": "<!DOCTYPE html>\n<html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Grammar Practice: Too, Too Much, Too Many, Enough</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom smooth transitions and focus styling */\n        .transition-all {\n            transition: all 0.2s ease-in-out;\n        }\n    </style>\n<style>*, ::before, ::after{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }::backdrop{--tw-border-spacing-x:0;--tw-border-spacing-y:0;--tw-translate-x:0;--tw-translate-y:0;--tw-rotate:0;--tw-skew-x:0;--tw-skew-y:0;--tw-scale-x:1;--tw-scale-y:1;--tw-pan-x: ;--tw-pan-y: ;--tw-pinch-zoom: ;--tw-scroll-snap-strictness:proximity;--tw-gradient-from-position: ;--tw-gradient-via-position: ;--tw-gradient-to-position: ;--tw-ordinal: ;--tw-slashed-zero: ;--tw-numeric-figure: ;--tw-numeric-spacing: ;--tw-numeric-fraction: ;--tw-ring-inset: ;--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgb(59 130 246 / 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000;--tw-shadow:0 0 #0000;--tw-shadow-colored:0 0 #0000;--tw-blur: ;--tw-brightness: ;--tw-contrast: ;--tw-grayscale: ;--tw-hue-rotate: ;--tw-invert: ;--tw-saturate: ;--tw-sepia: ;--tw-drop-shadow: ;--tw-backdrop-blur: ;--tw-backdrop-brightness: ;--tw-backdrop-contrast: ;--tw-backdrop-grayscale: ;--tw-backdrop-hue-rotate: ;--tw-backdrop-invert: ;--tw-backdrop-opacity: ;--tw-backdrop-saturate: ;--tw-backdrop-sepia: ;--tw-contain-size: ;--tw-contain-layout: ;--tw-contain-paint: ;--tw-contain-style: }/* ! tailwindcss v3.4.17 | MIT License | https://tailwindcss.com */*,::after,::before{box-sizing:border-box;border-width:0;border-style:solid;border-color:#e5e7eb}::after,::before{--tw-content:''}:host,html{line-height:1.5;-webkit-text-size-adjust:100%;-moz-tab-size:4;tab-size:4;font-family:ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\";font-feature-settings:normal;font-variation-settings:normal;-webkit-tap-highlight-color:transparent}body{margin:0;line-height:inherit}hr{height:0;color:inherit;border-top-width:1px}abbr:where([title]){-webkit-text-decoration:underline dotted;text-decoration:underline dotted}h1,h2,h3,h4,h5,h6{font-size:inherit;font-weight:inherit}a{color:inherit;text-decoration:inherit}b,strong{font-weight:bolder}code,kbd,pre,samp{font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;font-feature-settings:normal;font-variation-settings:normal;font-size:1em}small{font-size:80%}sub,sup{font-size:75%;line-height:0;position:relative;vertical-align:baseline}sub{bottom:-.25em}sup{top:-.5em}table{text-indent:0;border-color:inherit;border-collapse:collapse}button,input,optgroup,select,textarea{font-family:inherit;font-feature-settings:inherit;font-variation-settings:inherit;font-size:100%;font-weight:inherit;line-height:inherit;letter-spacing:inherit;color:inherit;margin:0;padding:0}button,select{text-transform:none}button,input:where([type=button]),input:where([type=reset]),input:where([type=submit]){-webkit-appearance:button;background-color:transparent;background-image:none}:-moz-focusring{outline:auto}:-moz-ui-invalid{box-shadow:none}progress{vertical-align:baseline}::-webkit-inner-spin-button,::-webkit-outer-spin-button{height:auto}[type=search]{-webkit-appearance:textfield;outline-offset:-2px}::-webkit-search-decoration{-webkit-appearance:none}::-webkit-file-upload-button{-webkit-appearance:button;font:inherit}summary{display:list-item}blockquote,dd,dl,figure,h1,h2,h3,h4,h5,h6,hr,p,pre{margin:0}fieldset{margin:0;padding:0}legend{padding:0}menu,ol,ul{list-style:none;margin:0;padding:0}dialog{padding:0}textarea{resize:vertical}input::placeholder,textarea::placeholder{opacity:1;color:#9ca3af}[role=button],button{cursor:pointer}:disabled{cursor:default}audio,canvas,embed,iframe,img,object,svg,video{display:block;vertical-align:middle}img,video{max-width:100%;height:auto}[hidden]:where(:not([hidden=until-found])){display:none}.sticky{position:sticky}.top-0{top:0px}.z-20{z-index:20}.mx-auto{margin-left:auto;margin-right:auto}.my-1{margin-top:0.25rem;margin-bottom:0.25rem}.my-auto{margin-top:auto;margin-bottom:auto}.mb-2{margin-bottom:0.5rem}.mb-6{margin-bottom:1.5rem}.mr-2{margin-right:0.5rem}.mt-0\\.5{margin-top:0.125rem}.mt-6{margin-top:1.5rem}.mt-8{margin-top:2rem}.inline-block{display:inline-block}.flex{display:flex}.hidden{display:none}.h-4{height:1rem}.h-5{height:1.25rem}.h-9{height:2.25rem}.min-h-screen{min-height:100vh}.w-4{width:1rem}.w-9{width:2.25rem}.w-full{width:100%}.min-w-\\[140px\\]{min-width:140px}.max-w-4xl{max-width:56rem}.flex-shrink-0{flex-shrink:0}.flex-grow{flex-grow:1}.cursor-pointer{cursor:pointer}.flex-col{flex-direction:column}.items-start{align-items:flex-start}.items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}.gap-4{gap:1rem}.space-x-2 > :not([hidden]) ~ :not([hidden]){--tw-space-x-reverse:0;margin-right:calc(0.5rem * var(--tw-space-x-reverse));margin-left:calc(0.5rem * calc(1 - var(--tw-space-x-reverse)))}.space-x-3 > :not([hidden]) ~ :not([hidden]){--tw-space-x-reverse:0;margin-right:calc(0.75rem * var(--tw-space-x-reverse));margin-left:calc(0.75rem * calc(1 - var(--tw-space-x-reverse)))}.space-y-5 > :not([hidden]) ~ :not([hidden]){--tw-space-y-reverse:0;margin-top:calc(1.25rem * calc(1 - var(--tw-space-y-reverse)));margin-bottom:calc(1.25rem * var(--tw-space-y-reverse))}.rounded{border-radius:0.25rem}.rounded-2xl{border-radius:1rem}.rounded-full{border-radius:9999px}.rounded-lg{border-radius:0.5rem}.rounded-md{border-radius:0.375rem}.rounded-xl{border-radius:0.75rem}.border{border-width:1px}.border-b{border-bottom-width:1px}.border-t{border-top-width:1px}.border-amber-200{--tw-border-opacity:1;border-color:rgb(253 230 138 / var(--tw-border-opacity, 1))}.border-indigo-100{--tw-border-opacity:1;border-color:rgb(224 231 255 / var(--tw-border-opacity, 1))}.border-slate-100{--tw-border-opacity:1;border-color:rgb(241 245 249 / var(--tw-border-opacity, 1))}.border-slate-200{--tw-border-opacity:1;border-color:rgb(226 232 240 / var(--tw-border-opacity, 1))}.border-slate-300{--tw-border-opacity:1;border-color:rgb(203 213 225 / var(--tw-border-opacity, 1))}.border-transparent{border-color:transparent}.bg-amber-50{--tw-bg-opacity:1;background-color:rgb(255 251 235 / var(--tw-bg-opacity, 1))}.bg-indigo-100{--tw-bg-opacity:1;background-color:rgb(224 231 255 / var(--tw-bg-opacity, 1))}.bg-indigo-50{--tw-bg-opacity:1;background-color:rgb(238 242 255 / var(--tw-bg-opacity, 1))}.bg-indigo-600{--tw-bg-opacity:1;background-color:rgb(79 70 229 / var(--tw-bg-opacity, 1))}.bg-slate-50{--tw-bg-opacity:1;background-color:rgb(248 250 252 / var(--tw-bg-opacity, 1))}.bg-white{--tw-bg-opacity:1;background-color:rgb(255 255 255 / var(--tw-bg-opacity, 1))}.bg-white\\/95{background-color:rgb(255 255 255 / 0.95)}.p-2{padding:0.5rem}.p-3{padding:0.75rem}.p-4{padding:1rem}.p-5{padding:1.25rem}.px-2\\.5{padding-left:0.625rem;padding-right:0.625rem}.px-3{padding-left:0.75rem;padding-right:0.75rem}.px-4{padding-left:1rem;padding-right:1rem}.px-5{padding-left:1.25rem;padding-right:1.25rem}.px-6{padding-left:1.5rem;padding-right:1.5rem}.py-1{padding-top:0.25rem;padding-bottom:0.25rem}.py-1\\.5{padding-top:0.375rem;padding-bottom:0.375rem}.py-2\\.5{padding-top:0.625rem;padding-bottom:0.625rem}.py-3{padding-top:0.75rem;padding-bottom:0.75rem}.py-4{padding-top:1rem;padding-bottom:1rem}.pb-4{padding-bottom:1rem}.pt-2{padding-top:0.5rem}.pt-6{padding-top:1.5rem}.text-center{text-align:center}.font-sans{font-family:ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"}.text-lg{font-size:1.125rem;line-height:1.75rem}.text-sm{font-size:0.875rem;line-height:1.25rem}.text-xs{font-size:0.75rem;line-height:1rem}.font-bold{font-weight:700}.font-medium{font-weight:500}.font-semibold{font-weight:600}.uppercase{text-transform:uppercase}.italic{font-style:italic}.leading-relaxed{line-height:1.625}.tracking-wider{letter-spacing:0.05em}.text-amber-600{--tw-text-opacity:1;color:rgb(217 119 6 / var(--tw-text-opacity, 1))}.text-amber-800{--tw-text-opacity:1;color:rgb(146 64 14 / var(--tw-text-opacity, 1))}.text-indigo-600{--tw-text-opacity:1;color:rgb(79 70 229 / var(--tw-text-opacity, 1))}.text-indigo-700{--tw-text-opacity:1;color:rgb(67 56 202 / var(--tw-text-opacity, 1))}.text-indigo-800{--tw-text-opacity:1;color:rgb(55 48 163 / var(--tw-text-opacity, 1))}.text-slate-400{--tw-text-opacity:1;color:rgb(148 163 184 / var(--tw-text-opacity, 1))}.text-slate-500{--tw-text-opacity:1;color:rgb(100 116 139 / var(--tw-text-opacity, 1))}.text-slate-700{--tw-text-opacity:1;color:rgb(51 65 85 / var(--tw-text-opacity, 1))}.text-slate-800{--tw-text-opacity:1;color:rgb(30 41 59 / var(--tw-text-opacity, 1))}.text-slate-900{--tw-text-opacity:1;color:rgb(15 23 42 / var(--tw-text-opacity, 1))}.text-white{--tw-text-opacity:1;color:rgb(255 255 255 / var(--tw-text-opacity, 1))}.underline{-webkit-text-decoration-line:underline;text-decoration-line:underline}.decoration-indigo-300{-webkit-text-decoration-color:#a5b4fc;text-decoration-color:#a5b4fc}.decoration-2{text-decoration-thickness:2px}.antialiased{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.shadow-sm{--tw-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05);--tw-shadow-colored:0 1px 2px 0 var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)}.backdrop-blur{--tw-backdrop-blur:blur(8px);-webkit-backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);backdrop-filter:var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia)}.transition-all{transition-property:all;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms}.hover\\:border-slate-100:hover{--tw-border-opacity:1;border-color:rgb(241 245 249 / var(--tw-border-opacity, 1))}.hover\\:bg-indigo-700:hover{--tw-bg-opacity:1;background-color:rgb(67 56 202 / var(--tw-bg-opacity, 1))}.hover\\:bg-slate-100:hover{--tw-bg-opacity:1;background-color:rgb(241 245 249 / var(--tw-bg-opacity, 1))}.hover\\:bg-slate-50\\/80:hover{background-color:rgb(248 250 252 / 0.8)}.hover\\:shadow:hover{--tw-shadow:0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);--tw-shadow-colored:0 1px 3px 0 var(--tw-shadow-color), 0 1px 2px -1px var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)}.focus\\:border-indigo-500:focus{--tw-border-opacity:1;border-color:rgb(99 102 241 / var(--tw-border-opacity, 1))}.focus\\:ring-2:focus{--tw-ring-offset-shadow:var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);--tw-ring-shadow:var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);box-shadow:var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000)}.focus\\:ring-amber-500:focus{--tw-ring-opacity:1;--tw-ring-color:rgb(245 158 11 / var(--tw-ring-opacity, 1))}.focus\\:ring-indigo-500:focus{--tw-ring-opacity:1;--tw-ring-color:rgb(99 102 241 / var(--tw-ring-opacity, 1))}@media (min-width: 640px){.sm\\:my-0{margin-top:0px;margin-bottom:0px}.sm\\:w-auto{width:auto}.sm\\:flex-row{flex-direction:row}.sm\\:items-center{align-items:center}.sm\\:p-6{padding:1.5rem}.sm\\:p-8{padding:2rem}.sm\\:px-8{padding-left:2rem;padding-right:2rem}.sm\\:text-base{font-size:1rem;line-height:1.5rem}.sm\\:text-sm{font-size:0.875rem;line-height:1.25rem}.sm\\:text-xl{font-size:1.25rem;line-height:1.75rem}}@media (min-width: 768px){.md\\:p-8{padding:2rem}}</style></head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header / Top Bar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-8 border-b border-slate-200 w-full shadow-sm flex items-center justify-between\">\n        <div class=\"flex items-center space-x-3\">\n            <div class=\"bg-indigo-600 text-white w-9 h-9 rounded-xl flex items-center justify-center font-bold text-lg shadow-sm\">\n                8\n            </div>\n            <div>\n                <h1 class=\"text-sm sm:text-base font-bold text-slate-900\">Quantifiers Practice</h1>\n                <p class=\"text-xs text-slate-500\">too, too much, too many, enough</p>\n            </div>\n        </div>\n        <div class=\"flex items-center space-x-3\">\n            <div id=\"score-display\" class=\"text-xs sm:text-sm font-semibold bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-full border border-indigo-100\">\n                Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">7</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container (w-full max-w-4xl mx-auto as requested) -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 my-auto flex-grow\">\n        \n        <!-- Activity Card -->\n        <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-8 mb-6\">\n            \n            <!-- Instructions Section -->\n            <div class=\"mb-6 pb-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                <div>\n                    <span class=\"inline-block bg-indigo-100 text-indigo-800 text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wider mb-2\">Exercise a</span>\n                    <h2 class=\"text-lg sm:text-xl font-bold text-slate-900\">Fill in the gaps with <span class=\"italic text-indigo-600\">too</span>, <span class=\"italic text-indigo-600\">too much</span>, <span class=\"italic text-indigo-600\">too many</span> or <span class=\"italic text-indigo-600\">enough</span>.</h2>\n                </div>\n                <!-- Personal opinion checklist instruction badge -->\n                <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs text-amber-800 flex items-start space-x-2\">\n                    <svg class=\"w-4 h-4 text-amber-600 mt-0.5 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                    <span><strong>Bonus:</strong> Check the box next to each sentence if you personally agree with it! Then, compare your answers with your partners and give reason for them.</span>\n                </div>\n            </div>\n\n            <!-- Sentences Form / Interactive List -->\n            <form id=\"grammar-form\" class=\"space-y-5\" onsubmit=\"event.preventDefault();\">\n                \n                <!-- Item 1 -->\n                <div class=\"flex items-start space-x-3 p-3 rounded-xl hover:bg-slate-50/80 transition-all border border-transparent hover:border-slate-100\">\n                    <div class=\"pt-2 flex items-center h-5\" title=\"Tick if you agree with this sentence\">\n                        <input type=\"checkbox\" aria-label=\"Agree with sentence 1\" class=\"w-4 h-4 text-amber-600 bg-white border-slate-300 rounded focus:ring-amber-500 cursor-pointer\">\n                    </div>\n                    <div class=\"flex-grow text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 mr-2\">1.</span> \n                        Two children are <span class=\"font-semibold text-slate-800 underline decoration-indigo-300 decoration-2\">enough</span>. More than two is \n                        <span class=\"inline-block my-1 sm:my-0\">\n                            <select data-answer=\"too many\" class=\"grammar-input bg-slate-50 border border-slate-300 text-slate-800 text-sm sm:text-base rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2 min-w-[140px] font-medium transition-all\">\n                                <option value=\"\">-- select --</option>\n                                <option value=\"too\">too</option>\n                                <option value=\"too much\">too much</option>\n                                <option value=\"too many\">too many</option>\n                                <option value=\"enough\">enough</option>\n                            </select>\n                        </span>.\n                    </div>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"flex items-start space-x-3 p-3 rounded-xl hover:bg-slate-50/80 transition-all border border-transparent hover:border-slate-100\">\n                    <div class=\"pt-2 flex items-center h-5\" title=\"Tick if you agree with this sentence\">\n                        <input type=\"checkbox\" aria-label=\"Agree with sentence 2\" class=\"w-4 h-4 text-amber-600 bg-white border-slate-300 rounded focus:ring-amber-500 cursor-pointer\">\n                    </div>\n                    <div class=\"flex-grow text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 mr-2\">2.</span> \n                        Fathers don't spend \n                        <span class=\"inline-block my-1 sm:my-0\">\n                            <select data-answer=\"enough\" class=\"grammar-input bg-slate-50 border border-slate-300 text-slate-800 text-sm sm:text-base rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2 min-w-[140px] font-medium transition-all\">\n                                <option value=\"\">-- select --</option>\n                                <option value=\"too\">too</option>\n                                <option value=\"too much\">too much</option>\n                                <option value=\"too many\">too many</option>\n                                <option value=\"enough\">enough</option>\n                            </select>\n                        </span> \n                        time with their children.\n                    </div>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"flex items-start space-x-3 p-3 rounded-xl hover:bg-slate-50/80 transition-all border border-transparent hover:border-slate-100\">\n                    <div class=\"pt-2 flex items-center h-5\" title=\"Tick if you agree with this sentence\">\n                        <input type=\"checkbox\" aria-label=\"Agree with sentence 3\" class=\"w-4 h-4 text-amber-600 bg-white border-slate-300 rounded focus:ring-amber-500 cursor-pointer\">\n                    </div>\n                    <div class=\"flex-grow text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 mr-2\">3.</span> \n                        Children watch \n                        <span class=\"inline-block my-1 sm:my-0\">\n                            <select data-answer=\"too much\" class=\"grammar-input bg-slate-50 border border-slate-300 text-slate-800 text-sm sm:text-base rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2 min-w-[140px] font-medium transition-all\">\n                                <option value=\"\">-- select --</option>\n                                <option value=\"too\">too</option>\n                                <option value=\"too much\">too much</option>\n                                <option value=\"too many\">too many</option>\n                                <option value=\"enough\">enough</option>\n                            </select>\n                        </span> \n                        TV. They should play outside more.\n                    </div>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"flex items-start space-x-3 p-3 rounded-xl hover:bg-slate-50/80 transition-all border border-transparent hover:border-slate-100\">\n                    <div class=\"pt-2 flex items-center h-5\" title=\"Tick if you agree with this sentence\">\n                        <input type=\"checkbox\" aria-label=\"Agree with sentence 4\" class=\"w-4 h-4 text-amber-600 bg-white border-slate-300 rounded focus:ring-amber-500 cursor-pointer\">\n                    </div>\n                    <div class=\"flex-grow text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 mr-2\">4.</span> \n                        Eighteen-year-olds aren't mature \n                        <span class=\"inline-block my-1 sm:my-0\">\n                            <select data-answer=\"enough\" class=\"grammar-input bg-slate-50 border border-slate-300 text-slate-800 text-sm sm:text-base rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2 min-w-[140px] font-medium transition-all\">\n                                <option value=\"\">-- select --</option>\n                                <option value=\"too\">too</option>\n                                <option value=\"too much\">too much</option>\n                                <option value=\"too many\">too many</option>\n                                <option value=\"enough\">enough</option>\n                            </select>\n                        </span> \n                        to have children.\n                    </div>\n                </div>\n\n                <!-- Item 5 -->\n                <div class=\"flex items-start space-x-3 p-3 rounded-xl hover:bg-slate-50/80 transition-all border border-transparent hover:border-slate-100\">\n                    <div class=\"pt-2 flex items-center h-5\" title=\"Tick if you agree with this sentence\">\n                        <input type=\"checkbox\" aria-label=\"Agree with sentence 5\" class=\"w-4 h-4 text-amber-600 bg-white border-slate-300 rounded focus:ring-amber-500 cursor-pointer\">\n                    </div>\n                    <div class=\"flex-grow text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 mr-2\">5.</span> \n                        You should make sure you're earning \n                        <span class=\"inline-block my-1 sm:my-0\">\n                            <select data-answer=\"enough\" class=\"grammar-input bg-slate-50 border border-slate-300 text-slate-800 text-sm sm:text-base rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2 min-w-[140px] font-medium transition-all\">\n                                <option value=\"\">-- select --</option>\n                                <option value=\"too\">too</option>\n                                <option value=\"too much\">too much</option>\n                                <option value=\"too many\">too many</option>\n                                <option value=\"enough\">enough</option>\n                            </select>\n                        </span> \n                        money before you have children.\n                    </div>\n                </div>\n\n                <!-- Item 6 -->\n                <div class=\"flex items-start space-x-3 p-3 rounded-xl hover:bg-slate-50/80 transition-all border border-transparent hover:border-slate-100\">\n                    <div class=\"pt-2 flex items-center h-5\" title=\"Tick if you agree with this sentence\">\n                        <input type=\"checkbox\" aria-label=\"Agree with sentence 6\" class=\"w-4 h-4 text-amber-600 bg-white border-slate-300 rounded focus:ring-amber-500 cursor-pointer\">\n                    </div>\n                    <div class=\"flex-grow text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 mr-2\">6.</span> \n                        Forty isn't \n                        <span class=\"inline-block my-1 sm:my-0\">\n                            <select data-answer=\"too\" class=\"grammar-input bg-slate-50 border border-slate-300 text-slate-800 text-sm sm:text-base rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2 min-w-[140px] font-medium transition-all\">\n                                <option value=\"\">-- select --</option>\n                                <option value=\"too\">too</option>\n                                <option value=\"too much\">too much</option>\n                                <option value=\"too many\">too many</option>\n                                <option value=\"enough\">enough</option>\n                            </select>\n                        </span> \n                        old to have a child.\n                    </div>\n                </div>\n\n                <!-- Item 7 -->\n                <div class=\"flex items-start space-x-3 p-3 rounded-xl hover:bg-slate-50/80 transition-all border border-transparent hover:border-slate-100\">\n                    <div class=\"pt-2 flex items-center h-5\" title=\"Tick if you agree with this sentence\">\n                        <input type=\"checkbox\" aria-label=\"Agree with sentence 7\" class=\"w-4 h-4 text-amber-600 bg-white border-slate-300 rounded focus:ring-amber-500 cursor-pointer\">\n                    </div>\n                    <div class=\"flex-grow text-sm sm:text-base text-slate-700 leading-relaxed\">\n                        <span class=\"font-bold text-slate-900 mr-2\">7.</span> \n                        Children eat \n                        <span class=\"inline-block my-1 sm:my-0\">\n                            <select data-answer=\"too much\" class=\"grammar-input bg-slate-50 border border-slate-300 text-slate-800 text-sm sm:text-base rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2 min-w-[140px] font-medium transition-all\">\n                                <option value=\"\">-- select --</option>\n                                <option value=\"too\">too</option>\n                                <option value=\"too much\">too much</option>\n                                <option value=\"too many\">too many</option>\n                                <option value=\"enough\">enough</option>\n                            </select>\n                        </span> \n                        unhealthy food.\n                    </div>\n                </div>\n\n            </form>\n\n            <!-- Action Buttons Container -->\n            <div class=\"mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4\">\n                <button type=\"button\" id=\"reset-btn\" class=\"w-full sm:w-auto px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-semibold text-sm transition-all flex items-center justify-center space-x-2\">\n                    <svg class=\"w-4 h-4 text-slate-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    <span>Reset Activity</span>\n                </button>\n\n                <button type=\"button\" id=\"check-btn\" class=\"w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-sm hover:shadow transition-all flex items-center justify-center space-x-2\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    <span>Check Answers</span>\n                </button>\n            </div>\n\n            <!-- Feedback Alert Box -->\n            <div id=\"feedback-container\" class=\"hidden mt-6 p-4 rounded-xl text-sm font-medium transition-all\"></div>\n\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-4 text-xs text-slate-400 border-t border-slate-100\">\n        Interactive ELT Practice Module • Designed for Touch &amp; Responsive Viewports\n    </footer>\n\n    <!-- JavaScript Logic & Metrics Contract -->\n    <script>\n        // 1. Mandatory Pedagogical Metrics Contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'quantifiers_too_enough',\n            maxScore: 7\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const inputs = document.querySelectorAll('.grammar-input');\n            const scoreDisplay = document.getElementById('current-score');\n            const feedbackContainer = document.getElementById('feedback-container');\n\n            // Check Answers Handler\n            checkBtn.addEventListener('click', () => {\n                let correctCount = 0;\n                inputs.forEach(input => {\n                    const expected = input.getAttribute('data-answer').trim().toLowerCase();\n                    const userVal = input.value.trim().toLowerCase();\n\n                    // Reset classes\n                    input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n                    if (userVal === expected) {\n                        correctCount++;\n                        input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-bold');\n                    } else {\n                        input.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n                    }\n                });\n\n                // Update Score Display\n                scoreDisplay.textContent = correctCount;\n\n                // Show Feedback banner\n                feedbackContainer.classList.remove('hidden');\n                if (correctCount === inputs.length) {\n                    feedbackContainer.className = \"mt-6 p-4 rounded-xl text-sm font-medium bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center space-x-3\";\n                    feedbackContainer.innerHTML = `\n                        <svg class=\"w-5 h-5 text-emerald-600 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                        <span>Fantastic job! All your answers are correct. You've mastered quantifiers!</span>\n                    `;\n                } else {\n                    feedbackContainer.className = \"mt-6 p-4 rounded-xl text-sm font-medium bg-amber-50 border border-amber-200 text-amber-800 flex items-center space-x-3\";\n                    feedbackContainer.innerHTML = `\n                        <svg class=\"w-5 h-5 text-amber-600 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\"></path></svg>\n                        <span>You got ${correctCount} out of ${inputs.length} correct. Review the highlighted items and try again!</span>\n                    `;\n                }\n\n                // 2. Dispatch Custom Event for Live Analytics & Parent PostMessage\n                const updateDetail = {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: inputs.length,\n                    completed: correctCount === inputs.length\n                };\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', { detail: updateDetail }));\n\n                // Post message for iframe communication\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: inputs.length }, '*');\n                }\n            });\n\n            // Reset Handler\n            resetBtn.addEventListener('click', () => {\n                inputs.forEach(input => {\n                    input.value = \"\";\n                    input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900', 'font-bold');\n                });\n                scoreDisplay.textContent = \"0\";\n                feedbackContainer.classList.add('hidden');\n                \n                // Uncheck checkboxes too\n                document.querySelectorAll('input[type=\"checkbox\"]').forEach(cb => cb.checked = false);\n            });\n        });\n    </script>\n\n</body></html>"
    },
    {
      "id": 1793301374135,
      "title": "Get ready... Get it right! - Quantifiers & Advice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Get ready... Get it right! - Quantifiers & Advice</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n        }\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen py-6 px-3 sm:px-6\">\n\n    <!-- MAIN CONTAINER -->\n    <div class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-12\">\n        \n        <!-- HEADER STICKY -->\n        <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 sm:px-8 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4 shadow-sm\">\n            <div class=\"flex items-center space-x-3\">\n                <span class=\"bg-amber-500 text-white font-bold px-3 py-1 rounded-full text-xs uppercase tracking-wide shadow-sm\">Get ready ... Get it right!</span>\n                <h1 class=\"text-base sm:text-lg font-bold text-slate-900 hidden sm:inline-block\">Life Problems & Advice</h1>\n            </div>\n            \n            <!-- SCORE & STATUS -->\n            <div class=\"flex items-center gap-3\">\n                <div id=\"score-badge\" class=\"bg-slate-100 text-slate-700 font-semibold px-3 py-1.5 rounded-xl text-sm flex items-center gap-2\">\n                    <svg class=\"w-4 h-4 text-amber-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                    <span>Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">6</span></span>\n                </div>\n            </div>\n        </header>\n\n        <!-- ACTIVITY CONTENT -->\n        <main class=\"p-4 sm:p-8 space-y-8\">\n\n            <!-- INTRO / WORD BANK -->\n            <section class=\"bg-amber-50/60 border border-amber-200/60 rounded-2xl p-5 sm:p-6 shadow-sm\">\n                <div class=\"flex items-start gap-3\">\n                    <div class=\"bg-amber-500 text-white p-2 rounded-xl shrink-0 mt-0.5\">\n                        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\"></path></svg>\n                    </div>\n                    <div>\n                        <h2 class=\"font-bold text-amber-900 text-base sm:text-lg\">Exercise 9: Write sentences about problems in your life</h2>\n                        <p class=\"text-amber-800 text-sm mt-1\">Use ideas from the box below (or your own), adjectives, and quantifiers: <strong class=\"underline\">too</strong>, <strong class=\"underline\">too much</strong>, <strong class=\"underline\">too many</strong>, <strong class=\"underline\">(not) enough</strong>.</p>\n                        \n                        <!-- WORD BANK BADGES -->\n                        <div class=\"flex flex-wrap gap-2 mt-4\">\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">money</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">work</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">house/flat</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">family</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">the weather</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">relationships</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">clothes</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">friends</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">free time</span>\n                            <span class=\"bg-white/80 border border-amber-200 text-amber-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm\">learning English</span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- EXAMPLES -->\n            <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-600 space-y-1.5\">\n                <p class=\"font-semibold text-slate-700\">Examples from the book:</p>\n                <p class=\"italic\">\"I haven't got enough money to go on holiday.\"</p>\n                <p class=\"italic\">\"I'm very stressed because I've got too much work to do.\"</p>\n            </div>\n\n            <!-- INTERACTIVE SENTENCE BUILDER / INPUTS -->\n            <form id=\"activity-form\" class=\"space-y-4\" onsubmit=\"event.preventDefault();\">\n                \n                <h3 class=\"font-bold text-slate-900 text-base pt-2\">Complete your 6 sentences:</h3>\n                \n                <div class=\"space-y-3\">\n                    <!-- Item 1 -->\n                    <div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-slate-50 p-3.5 rounded-xl border border-slate-200\">\n                        <span class=\"bg-slate-800 text-white font-bold w-7 h-7 rounded-lg flex items-center justify-center text-xs shrink-0\">1</span>\n                        <div class=\"flex-1 flex flex-wrap items-center gap-2 text-sm\">\n                            <span>I haven't got</span>\n                            <input type=\"text\" data-answer=\"enough money\" data-alts=\"enough time, enough sleep, enough space\" placeholder=\"e.g. enough money\" class=\"flex-1 min-w-[200px] px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium\">\n                            <span>to do what I want.</span>\n                        </div>\n                    </div>\n\n                    <!-- Item 2 -->\n                    <div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-slate-50 p-3.5 rounded-xl border border-slate-200\">\n                        <span class=\"bg-slate-800 text-white font-bold w-7 h-7 rounded-lg flex items-center justify-center text-xs shrink-0\">2</span>\n                        <div class=\"flex-1 flex flex-wrap items-center gap-2 text-sm\">\n                            <span>I've got</span>\n                            <input type=\"text\" data-answer=\"too much work\" data-alts=\"too much homework, too much stress, too much to do\" placeholder=\"e.g. too much work\" class=\"flex-1 min-w-[200px] px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium\">\n                            <span>at the moment.</span>\n                        </div>\n                    </div>\n\n                    <!-- Item 3 -->\n                    <div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-slate-50 p-3.5 rounded-xl border border-slate-200\">\n                        <span class=\"bg-slate-800 text-white font-bold w-7 h-7 rounded-lg flex items-center justify-center text-xs shrink-0\">3</span>\n                        <div class=\"flex-1 flex flex-wrap items-center gap-2 text-sm\">\n                            <span>There are</span>\n                            <input type=\"text\" data-answer=\"too many people\" data-alts=\"too many cars, too many problems, too many rules\" placeholder=\"e.g. too many people\" class=\"flex-1 min-w-[200px] px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium\">\n                            <span>in my building.</span>\n                        </div>\n                    </div>\n\n                    <!-- Item 4 -->\n                    <div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-slate-50 p-3.5 rounded-xl border border-slate-200\">\n                        <span class=\"bg-slate-800 text-white font-bold w-7 h-7 rounded-lg flex items-center justify-center text-xs shrink-0\">4</span>\n                        <div class=\"flex-1 flex flex-wrap items-center gap-2 text-sm\">\n                            <span>My room is too</span>\n                            <input type=\"text\" data-answer=\"small\" data-alts=\"cold, hot, dark, messy\" placeholder=\"e.g. small\" class=\"flex-1 min-w-[200px] px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium\">\n                            <span>for all my clothes.</span>\n                        </div>\n                    </div>\n\n                    <!-- Item 5 -->\n                    <div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-slate-50 p-3.5 rounded-xl border border-slate-200\">\n                        <span class=\"bg-slate-800 text-white font-bold w-7 h-7 rounded-lg flex items-center justify-center text-xs shrink-0\">5</span>\n                        <div class=\"flex-1 flex flex-wrap items-center gap-2 text-sm\">\n                            <span>I don't have</span>\n                            <input type=\"text\" data-answer=\"enough free time\" data-alts=\"enough time, enough friends, enough sleep\" placeholder=\"e.g. enough free time\" class=\"flex-1 min-w-[200px] px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium\">\n                            <span>on weekends.</span>\n                        </div>\n                    </div>\n\n                    <!-- Item 6 -->\n                    <div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-slate-50 p-3.5 rounded-xl border border-slate-200\">\n                        <span class=\"bg-slate-800 text-white font-bold w-7 h-7 rounded-lg flex items-center justify-center text-xs shrink-0\">6</span>\n                        <div class=\"flex-1 flex flex-wrap items-center gap-2 text-sm\">\n                            <span>The weather is</span>\n                            <input type=\"text\" data-answer=\"too wet\" data-alts=\"too cold, too hot, too bad, too rainy\" placeholder=\"e.g. too wet\" class=\"flex-1 min-w-[200px] px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium\">\n                            <span>to go outside.</span>\n                        </div>\n                    </div>\n\n                </div>\n\n                <!-- EXERCISE 10 SECTION (Roleplay / Advice prompt) -->\n                <div class=\"mt-10 border-t border-slate-200 pt-6\">\n                    <div class=\"bg-sky-50 border border-sky-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-4\">\n                        <div class=\"flex items-start gap-3\">\n                            <div class=\"bg-sky-600 text-white p-2 rounded-xl shrink-0 mt-0.5\">\n                                <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z\"></path></svg>\n                            </div>\n                            <div>\n                                <h3 class=\"font-bold text-sky-900 text-base sm:text-lg\">Exercise 10: Give Advice (Speaking Practice)</h3>\n                                <p class=\"text-sky-800 text-sm mt-1\">Practice giving advice using <strong class=\"underline\">You should / shouldn't ...</strong> and <strong class=\"underline\">Why don't you ... ?</strong></p>\n                            </div>\n                        </div>\n\n                        <!-- Dialogue Bubbles Examples -->\n                        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-3 pt-2\">\n                            <div class=\"bg-white border border-sky-200 p-3 rounded-xl shadow-xs text-xs text-sky-900 font-medium\">\n                                <span class=\"block text-[10px] font-bold text-sky-600 uppercase mb-1\">Problem</span>\n                                \"I've got too much work to do.\"\n                            </div>\n                            <div class=\"bg-white border border-sky-200 p-3 rounded-xl shadow-xs text-xs text-sky-900 font-medium\">\n                                <span class=\"block text-[10px] font-bold text-sky-600 uppercase mb-1\">Advice 1</span>\n                                \"You should talk to your boss.\"\n                            </div>\n                            <div class=\"bg-white border border-sky-200 p-3 rounded-xl shadow-xs text-xs text-sky-900 font-medium\">\n                                <span class=\"block text-[10px] font-bold text-sky-600 uppercase mb-1\">Advice 2</span>\n                                \"Why don't you ask someone to help you?\"\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- ACTION BUTTONS -->\n                <div class=\"flex flex-wrap items-center justify-between gap-4 pt-6\">\n                    <button type=\"button\" id=\"reset-btn\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 font-semibold text-slate-600 hover:bg-slate-100 transition min-h-[42px] flex items-center gap-2\">\n                        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                        Reset Activity\n                    </button>\n                    \n                    <button type=\"button\" id=\"check-btn\" class=\"px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold shadow-sm transition min-h-[42px] flex items-center gap-2\">\n                        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                        Check Answers\n                    </button>\n                </div>\n\n            </form>\n        </main>\n    </div>\n\n    <!-- JAVASCRIPT LOGIC & METRICS -->\n    <script>\n        // OBLIGATORY METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Grammar',\n            skill: 'quantifiers_and_life_problems',\n            maxScore: 6\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const inputs = document.querySelectorAll('input[data-answer]');\n            const currentScoreEl = document.getElementById('current-score');\n\n            // Normalize text helper for flexible grading\n            function normalize(str) {\n                return str.toLowerCase().trim().replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\");\n            }\n\n            function checkAnswers() {\n                let correctCount = 0;\n\n                inputs.forEach(input => {\n                    const primary = normalize(input.getAttribute('data-answer'));\n                    const alts = input.getAttribute('data-alts') ? input.getAttribute('data-alts').split(',').map(a => normalize(a)) : [];\n                    const userVal = normalize(input.value);\n\n                    input.classList.remove('is-correct', 'is-wrong');\n\n                    if (userVal === \"\") {\n                        return; // Unanswered\n                    }\n\n                    let isMatch = (userVal === primary || alts.includes(userVal));\n                    \n                    // Partial matching for core structure (e.g. checking quantifier + noun)\n                    if (!isMatch) {\n                        const userWords = userVal.split(' ');\n                        const primaryWords = primary.split(' ');\n                        // If user matched at least key words like 'enough' or 'too much'/'too many'\n                        if (userWords.length > 0 && primaryWords.includes(userWords[0])) {\n                            // Check if quantifier matches\n                            if (userWords[0] === primaryWords[0]) {\n                                isMatch = true; \n                            }\n                        }\n                    }\n\n                    if (isMatch) {\n                        input.classList.add('is-correct');\n                        correctCount++;\n                    } else {\n                        input.classList.add('is-wrong');\n                    }\n                });\n\n                currentScoreEl.textContent = correctCount;\n\n                // Dispatch mandatory custom event\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                // Post message for iframe containers\n                if (window.parent && window.parent !== window) {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: inputs.length\n                    }, '*');\n                }\n            }\n\n            function resetActivity() {\n                inputs.forEach(input => {\n                    input.value = '';\n                    input.classList.remove('is-correct', 'is-wrong');\n                });\n                currentScoreEl.textContent = '0';\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: inputs.length,\n                        completed: false\n                    }\n                }));\n            }\n\n            checkBtn.addEventListener('click', checkAnswers);\n            resetBtn.addEventListener('click', resetActivity);\n        });\n    </script>\n</body>\n</html>"
    }
  ]
}