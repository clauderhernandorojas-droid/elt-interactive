{
  "version": "2.0",
  "title": "PI SB U9 Lesson 9C",
  "updatedAt": "2026-10-31T18:21:10.984Z",
  "slides": [
    {
      "id": 1793467225282,
      "title": "Vocabulary: Phrasal Verbs",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Vocabulary: Phrasal Verbs</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom smooth styles */\n    body {\n      background-color: #f8fafc;\n      color: #0f172a;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n    }\n  </style>\n</head>\n<body class=\"min-h-screen py-4 px-3 sm:px-6 md:px-8 flex flex-col justify-between\">\n\n  <!-- Main Activity Container -->\n  <main class=\"w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-8 my-auto\">\n    \n    <!-- Header Section -->\n    <header class=\"flex items-center gap-3 border-b border-slate-100 pb-4 mb-6\">\n      <div class=\"bg-indigo-600 text-white p-2.5 rounded-xl shadow-sm\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n        </svg>\n      </div>\n      <div>\n        <span class=\"text-xs font-semibold tracking-wider text-indigo-600 uppercase\">Vocabulary</span>\n        <h1 class=\"text-xl sm:text-2xl font-bold text-slate-800\">Phrasal verbs</h1>\n      </div>\n    </header>\n\n    <!-- Activity Content (Based strictly on OCR Reference #1) -->\n    <section class=\"space-y-6\">\n      \n      <!-- Numbered Exercise Card -->\n      <div class=\"flex items-start gap-4 bg-slate-50 border border-slate-200/80 rounded-xl p-5 sm:p-6 shadow-sm\">\n        \n        <!-- Badge Number 1 -->\n        <div class=\"flex-shrink-0 flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 bg-indigo-600 text-white font-bold rounded-full shadow-sm text-base sm:text-lg\">\n          1\n        </div>\n\n        <!-- Instruction Text -->\n        <div class=\"space-y-3 flex-grow\">\n          <p class=\"text-base sm:text-lg font-medium text-slate-800 leading-relaxed\">\n            Work in groups. Tell the other students about your neighbours. Who are they? What are they like? Do you have any problems with them?\n          </p>\n\n          <!-- Interactive prompt / discussion helper tags -->\n          <div class=\"flex flex-wrap gap-2 pt-2\">\n            <span class=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100\">\n              👥 Group Discussion\n            </span>\n            <span class=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200\">\n              💬 Speaking Task\n            </span>\n          </div>\n        </div>\n\n      </div>\n\n    </section>\n\n    <!-- Footer note (non-interactive design showcase) -->\n    <footer class=\"mt-8 pt-4 border-t border-slate-100 text-center\">\n      <p class=\"text-xs text-slate-400\">Interactive display presentation mode — No submission required.</p>\n    </footer>\n\n  </main>\n\n  <!-- Script Initialization for Metrics Contract Compliance -->\n  <script>\n    // Mandatory Metrics Contract Declaration\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'phrasal_verbs_discussion',\n      maxScore: 0\n    };\n  </script>\n\n</body>\n</html>"
    },
    {
      "id": 1793467611727,
      "title": "Nightmare Neighbours - Reading Comprehension",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Nightmare Neighbours - Reading Comprehension</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            border-color: #059669 !important;\n            background-color: #ecfdf5 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            border-color: #dc2626 !important;\n            background-color: #fef2f2 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Top Header & Metrics Bar -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider\">Reading</span>\n                <h1 class=\"text-base sm:text-lg font-bold text-slate-900\">Nightmare Neighbours</h1>\n            </div>\n            <div class=\"flex items-center space-x-4\">\n                <div id=\"score-counter\" class=\"text-sm font-semibold bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg border border-slate-200\">\n                    Score: <span id=\"current-score\">0</span> / <span id=\"total-score\">4</span>\n                </div>\n                <button id=\"reset-btn\" class=\"flex items-center space-x-1 text-sm bg-white hover:bg-slate-100 text-slate-700 font-medium px-3 py-1.5 rounded-lg border border-slate-300 transition shadow-sm active:scale-95\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    <span>Reset</span>\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow space-y-6\">\n\n        <!-- Instructions & Reading Text Collapsible Accordion -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden\">\n            <details open class=\"group\">\n                <summary class=\"flex items-center justify-between p-4 sm:p-5 bg-indigo-50/50 cursor-pointer select-none font-semibold text-indigo-900 hover:bg-indigo-50 transition\">\n                    <div class=\"flex items-center space-x-2\">\n                        <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n                        <span>Reading Text: Nightmare Neighbours (Click to toggle)</span>\n                    </div>\n                    <svg class=\"w-5 h-5 text-indigo-500 transform group-open:rotate-180 transition-transform\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg>\n                </summary>\n                <div class=\"p-5 sm:p-6 prose max-w-none text-slate-700 text-sm sm:text-base leading-relaxed space-y-4 border-t border-slate-100\">\n                    <h2 class=\"text-xl font-bold text-slate-900 mb-2\">NIGHTMARE NEIGHBOURS</h2>\n                    <p>I've lived in a rented flat for the last six months and until recently life has been very quiet and peaceful. But now a new couple have <strong>moved in</strong> next door and they are making my life impossible. The main problem is that they have parties during the week that <strong>go on</strong> all night. Sometimes their friends <strong>turn up</strong> at their flat at two or three in the morning and when I complain they just tell me to <strong>go away</strong>. My two children can't sleep because of the noise, so I don't get enough sleep either. I was doing evening classes twice a week, but I've had to <strong>give them up</strong> because I'm too tired to go. Now when I get home I just <strong>take off</strong> my coat, <strong>sit down</strong> in front of the TV and fall asleep – until the party starts next door, of course.</p>\n                    <p>All this is making me very depressed and fed up and I just can't <strong>put up with</strong> the noise any longer. I like living here and I <strong>get on well with</strong> all my other neighbours, but these people are a nightmare. I don't want to <strong>go back</strong> to my parents' house where we were living before, but I don't know what else to do. Do your readers have any advice for me?</p>\n                    <p class=\"font-semibold text-slate-900 italic\">Mrs Yvonne Chapman, Catford</p>\n                </div>\n            </details>\n        </section>\n\n        <!-- Exercises Section -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6 md:p-8 space-y-6\">\n            <div class=\"border-b border-slate-100 pb-4\">\n                <h3 class=\"text-lg font-bold text-slate-900 flex items-center space-x-2\">\n                    <span class=\"bg-slate-800 text-white text-xs px-2 py-1 rounded-md\">2 a</span>\n                    <span>Read the letter and answer these questions.</span>\n                </h3>\n                <p class=\"text-sm text-slate-500 mt-1\">Type your answers clearly or select the best match according to the text.</p>\n            </div>\n\n            <div class=\"space-y-6\">\n                <!-- Question 1 -->\n                <div class=\"question-card bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-5 transition-all\">\n                    <label for=\"q1\" class=\"block font-medium text-slate-900 mb-2 text-sm sm:text-base\">\n                        <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs w-6 h-6 rounded-full mr-1.5 font-bold\">1</span>\n                        What problem does Yvonne have?\n                    </label>\n                    <input type=\"text\" id=\"q1\" \n                           data-answer=\"Her neighbours are very noisy and have all-night parties during the week.\"\n                           data-alts=\"noisy neighbours,neighbours are noisy,parties all night,have all-night parties during the week\"\n                           placeholder=\"Type your answer here...\" \n                           class=\"w-full bg-white border border-slate-300 rounded-lg px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition shadow-inner\">\n                    <div class=\"feedback-text text-xs mt-2 hidden font-medium\"></div>\n                </div>\n\n                <!-- Question 2 -->\n                <div class=\"question-card bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-5 transition-all\">\n                    <label for=\"q2\" class=\"block font-medium text-slate-900 mb-2 text-sm sm:text-base\">\n                        <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs w-6 h-6 rounded-full mr-1.5 font-bold\">2</span>\n                        How has she tried to solve the problem?\n                    </label>\n                    <input type=\"text\" id=\"q2\" \n                           data-answer=\"She has been to their house to complain.\"\n                           data-alts=\"went to complain,she went to complain,complained to them,gone to their house to complain\"\n                           placeholder=\"Type your answer here...\" \n                           class=\"w-full bg-white border border-slate-300 rounded-lg px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition shadow-inner\">\n                    <div class=\"feedback-text text-xs mt-2 hidden font-medium\"></div>\n                </div>\n\n                <!-- Question 3 -->\n                <div class=\"question-card bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-5 transition-all\">\n                    <label for=\"q3\" class=\"block font-medium text-slate-900 mb-2 text-sm sm:text-base\">\n                        <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs w-6 h-6 rounded-full mr-1.5 font-bold\">3</span>\n                        How has this problem changed her day-to-day life?\n                    </label>\n                    <input type=\"text\" id=\"q3\" \n                           data-answer=\"She doesn't get enough sleep, she falls asleep as soon as she gets home and she has given up her evening classes.\"\n                           data-alts=\"she falls asleep as soon as she gets home and she has given up her evening classes,doesn't get enough sleep,given up evening classes,tired\"\n                           placeholder=\"Type your answer here...\" \n                           class=\"w-full bg-white border border-slate-300 rounded-lg px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition shadow-inner\">\n                    <div class=\"feedback-text text-xs mt-2 hidden font-medium\"></div>\n                </div>\n\n                <!-- Question 4 -->\n                <div class=\"question-card bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-5 transition-all\">\n                    <label for=\"q4\" class=\"block font-medium text-slate-900 mb-2 text-sm sm:text-base\">\n                        <span class=\"inline-flex items-center justify-center bg-slate-800 text-white text-xs w-6 h-6 rounded-full mr-1.5 font-bold\">4</span>\n                        How does she feel now?\n                    </label>\n                    <input type=\"text\" id=\"q4\" \n                           data-answer=\"She feels depressed and fed up.\"\n                           data-alts=\"depressed and fed up,fed up,depressed\"\n                           placeholder=\"Type your answer here...\" \n                           class=\"w-full bg-white border border-slate-300 rounded-lg px-4 py-2.5 text-sm sm:text-base text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition shadow-inner\">\n                    <div class=\"feedback-text text-xs mt-2 hidden font-medium\"></div>\n                </div>\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"flex flex-wrap items-center justify-end gap-3 pt-4 border-t border-slate-100\">\n                <button id=\"check-btn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl transition shadow-sm active:scale-95 text-base flex items-center justify-center space-x-2\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    <span>Check Answers</span>\n                </button>\n            </div>\n        </section>\n\n        <!-- Extra Discussion / Advice Section (Interactive Textarea) -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6 md:p-8 space-y-4\">\n            <h3 class=\"text-lg font-bold text-slate-900 flex items-center space-x-2\">\n                <span class=\"bg-indigo-100 text-indigo-800 text-xs px-2.5 py-1 rounded-md font-bold\">2 b</span>\n                <span>Work in pairs. What advice can you give Yvonne?</span>\n            </h3>\n            <p class=\"text-sm text-slate-500\">Write down your own advice or suggestions for Yvonne (Free writing practice).</p>\n            <textarea rows=\"3\" placeholder=\"I think Yvonne should call the police or talk to the landlord...\" class=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\"></textarea>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"text-center py-6 text-xs text-slate-400 border-t border-slate-200 mt-8\">\n        Interactive ELT Reading Activity &bull; Powered by Tailwind CSS\n    </footer>\n\n    <!-- Script Logic & Metrics Contract -->\n    <script>\n        // OBLIGATORY METRICS CONTRACT\n        window.ACTIVITY_METRICS = {\n            domain: 'Reading',\n            skill: 'reading_comprehension_detail',\n            maxScore: 4\n        };\n\n        const checkBtn = document.getElementById('check-btn');\n        const resetBtn = document.getElementById('reset-btn');\n        const currentScoreEl = document.getElementById('current-score');\n        const inputs = document.querySelectorAll('.question-card input');\n\n        function normalize(text) {\n            return text.toLowerCase()\n                       .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()?]/g, \"\")\n                       .replace(/\\s+/g, \" \")\n                       .trim();\n        }\n\n        function checkAnswers() {\n            let correctCount = 0;\n\n            inputs.forEach(input => {\n                const userVal = normalize(input.value);\n                const primaryAns = normalize(input.getAttribute('data-answer'));\n                const alts = input.getAttribute('data-alts') ? input.getAttribute('data-alts').split(',').map(a => normalize(a)) : [];\n\n                const card = input.closest('.question-card');\n                const feedback = card.querySelector('.feedback-text');\n\n                let isCorrect = (userVal === primaryAns) || alts.some(alt => userVal.includes(alt) && alt.length > 3);\n\n                card.classList.remove('bg-slate-50', 'border-slate-200');\n                input.classList.remove('is-correct', 'is-wrong', 'border-slate-300');\n                feedback.classList.remove('hidden', 'text-emerald-700', 'text-red-700');\n\n                if (isCorrect) {\n                    correctCount++;\n                    input.classList.add('is-correct');\n                    feedback.classList.add('text-emerald-700');\n                    feedback.textContent = '✓ Correct!';\n                } else {\n                    input.classList.add('is-wrong');\n                    feedback.classList.add('text-red-700');\n                    feedback.textContent = `✗ Incorrect. Suggested key: \"${input.getAttribute('data-answer')}\"`;\n                }\n            });\n\n            currentScoreEl.textContent = correctCount;\n\n            // Dispatch ELT Activity Update Event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: inputs.length,\n                    completed: correctCount === inputs.length\n                }\n            }));\n\n            // Post message for parent frame integration\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: inputs.length }, '*');\n            }\n        }\n\n        function resetActivity() {\n            inputs.forEach(input => {\n                input.value = '';\n                const card = input.closest('.question-card');\n                const feedback = card.querySelector('.feedback-text');\n                card.classList.add('bg-slate-50', 'border-slate-200');\n                input.classList.remove('is-correct', 'is-wrong');\n                feedback.classList.add('hidden');\n                feedback.textContent = '';\n            });\n            currentScoreEl.textContent = '0';\n        }\n\n        checkBtn.addEventListener('click', checkAnswers);\n        resetBtn.addEventListener('click', resetActivity);\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793467734961,
      "title": "Nightmare Neighbours - Phrasal Verbs Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Nightmare Neighbours - Phrasal Verbs Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .is-correct {\n            background-color: #ecfdf5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fef2f2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n        details summary::-webkit-details-marker {\n            display: none;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col\">\n\n    <!-- Sticky Header / Audio Simulation / Title -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm flex items-center justify-between\">\n        <div class=\"max-w-4xl mx-auto w-full flex items-center justify-between\">\n            <div class=\"flex items-center gap-2\">\n                <span class=\"bg-indigo-600 text-white p-2 rounded-xl flex items-center justify-center shadow-sm\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n                    </svg>\n                </span>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Nightmare Neighbours</h1>\n                    <p class=\"text-xs text-slate-500\">Vocabulary & Phrasal Verbs Practice</p>\n                </div>\n            </div>\n            <div id=\"score-display\" class=\"bg-slate-100 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700 border border-slate-200\">\n                Score: <span id=\"current-score\">0</span> / <span id=\"max-score\">10</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Container -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-1 space-y-6\">\n\n        <!-- Reading Reference Accordion -->\n        <details class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden group\" open>\n            <summary class=\"bg-slate-50 hover:bg-slate-100 p-4 sm:p-5 font-semibold text-slate-700 cursor-pointer flex items-center justify-between transition-colors select-none\">\n                <div class=\"flex items-center gap-2.5\">\n                    <span class=\"bg-amber-100 text-amber-800 p-1.5 rounded-lg text-xs font-bold uppercase tracking-wider\">Reading Text</span>\n                    <span>Click to expand/collapse letter: \"Nightmare Neighbours\"</span>\n                </div>\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-slate-400 transform group-open:rotate-180 transition-transform\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\" />\n                </svg>\n            </summary>\n            <div class=\"p-4 sm:p-6 text-sm sm:text-base leading-relaxed text-slate-600 space-y-4 border-t border-slate-100 bg-white\">\n                <p>I've lived in a rented flat for the last six months and until recently life has been very quiet and peaceful. But now a new couple have <strong>moved in</strong> next door and they are making my life impossible. The main problem is that they have parties during the week that <strong>go on</strong> all night. Sometimes their friends <strong>turn up</strong> at their flat at two or three in the morning and when I complain they just tell me to <strong>go away</strong>. My two children can't sleep because of the noise, so I don't get enough sleep either. I was doing evening classes twice a week, but I've had to <strong>give them up</strong> because I'm too tired to go. Now when I get home I just <strong>take off</strong> my coat, <strong>sit down</strong> in front of the TV and fall asleep – until the party starts next door, of course.</p>\n                <p>All this is making me very depressed and fed up and I just can't <strong>put up with</strong> the noise any longer. I like living here and I <strong>get on well with</strong> all my other neighbours, but these people are a nightmare. I don't want to <strong>go back</strong> to my parents' house where we were living before, but I don't know what else to do. Do your readers have any advice for me?</p>\n                <p class=\"font-medium text-slate-900 pt-2\">Mrs Yvonne Chapman, Catford</p>\n            </div>\n        </details>\n\n        <!-- Exercise Section -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-4 sm:p-6 md:p-8 space-y-6\">\n            <div class=\"border-b border-slate-100 pb-4\">\n                <div class=\"flex items-center gap-3\">\n                    <span class=\"bg-indigo-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0\">3</span>\n                    <h2 class=\"text-base sm:text-lg font-bold text-slate-900\">Match the phrasal verbs in bold from the letter to their meanings (a–j).</h2>\n                </div>\n                <p class=\"text-xs sm:text-sm text-slate-500 mt-1 pl-11\">Select the correct phrasal verb for each definition based on the text.</p>\n            </div>\n\n            <!-- Matching Items Grid / List -->\n            <div class=\"grid grid-cols-1 gap-4\" id=\"exercise-list\">\n                \n                <!-- Item A -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">a)</span>\n                        <span>start living in a new home</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"move in\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item B -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">b)</span>\n                        <span>like someone and be friendly to him/her</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"get on with\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item C -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">c)</span>\n                        <span>be standing and then sit in a chair</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"sit down\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item D -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">d)</span>\n                        <span>tolerate</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"put up with\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item E -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">e)</span>\n                        <span>stop doing</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"give up\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item F -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">f)</span>\n                        <span>leave a place</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"go away\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item G -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">g)</span>\n                        <span>continue</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"go on\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item H -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">h)</span>\n                        <span>arrive at a place</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"turn up\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item I -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">i)</span>\n                        <span>return</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"go back\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n                <!-- Item J -->\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 gap-3\">\n                    <div class=\"text-sm sm:text-base text-slate-700 flex items-start sm:items-center gap-2\">\n                        <span class=\"font-bold text-indigo-600 min-w-[24px]\">j)</span>\n                        <span>remove (clothing)</span>\n                    </div>\n                    <div class=\"w-full sm:w-64\">\n                        <select class=\"phrasal-select w-full bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm sm:text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500\" data-answer=\"take off\">\n                            <option value=\"\">-- Choose phrasal verb --</option>\n                            <option value=\"move in\">move in</option>\n                            <option value=\"get on with\">get on with</option>\n                            <option value=\"sit down\">sit down</option>\n                            <option value=\"put up with\">put up with</option>\n                            <option value=\"give up\">give up</option>\n                            <option value=\"go away\">go away</option>\n                            <option value=\"go on\">go on</option>\n                            <option value=\"turn up\">turn up</option>\n                            <option value=\"go back\">go back</option>\n                            <option value=\"take off\">take off</option>\n                        </select>\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100\">\n                <button id=\"check-btn\" onclick=\"checkAnswers()\" class=\"bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium px-6 py-3 rounded-xl transition-all shadow-sm flex items-center gap-2 cursor-pointer min-h-[46px] flex-1 sm:flex-none justify-center\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                    Check Answers\n                </button>\n                <button id=\"reset-btn\" onclick=\"resetActivity()\" class=\"bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-700 font-medium px-6 py-3 rounded-xl transition-all flex items-center gap-2 cursor-pointer min-h-[46px] flex-1 sm:flex-none justify-center\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    Reset Activity\n                </button>\n            </div>\n\n            <div id=\"feedback-message\" class=\"hidden p-4 rounded-xl text-center font-medium text-sm sm:text-base\"></div>\n        </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full text-center py-6 text-xs text-slate-400 border-t border-slate-100 mt-auto\">\n        Interactive ELT Activity &bull; Designed for Responsive Touch Interfaces\n    </footer>\n\n    <!-- Script / Metrics / Logic -->\n    <script>\n        // Mandatory Metrics Contract Declaration\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'phrasal_verbs_matching',\n            maxScore: 10\n        };\n\n        document.getElementById('max-score').textContent = window.ACTIVITY_METRICS.maxScore;\n\n        function checkAnswers() {\n            const selects = document.querySelectorAll('.phrasal-select');\n            let correctCount = 0;\n            let total = selects.length;\n\n            selects.forEach(select => {\n                const userAnswer = select.value.trim().toLowerCase();\n                const correctAnswer = select.getAttribute('data-answer').trim().toLowerCase();\n\n                select.classList.remove('is-correct', 'is-wrong');\n\n                if (userAnswer === correctAnswer) {\n                    select.classList.add('is-correct');\n                    correctCount++;\n                } else if (userAnswer !== \"\") {\n                    select.classList.add('is-wrong');\n                }\n            });\n\n            document.getElementById('current-score').textContent = correctCount;\n\n            const feedbackEl = document.getElementById('feedback-message');\n            feedbackEl.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'bg-amber-50', 'text-amber-800', 'bg-rose-50', 'text-rose-800');\n\n            if (correctCount === total) {\n                feedbackEl.classList.add('bg-emerald-50', 'text-emerald-800');\n                feedbackEl.innerHTML = '🎉 Excellent! All answers are correct!';\n            } else if (correctCount > 0) {\n                feedbackEl.classList.add('bg-amber-50', 'text-amber-800');\n                feedbackEl.innerHTML = `⚠️ You got ${correctCount} out of ${total} correct. Keep trying!`;\n            } else {\n                feedbackEl.classList.add('bg-rose-50', 'text-rose-800');\n                feedbackEl.innerHTML = '❌ No correct answers yet. Review the reading text and try again!';\n            }\n\n            // Dispatch Custom Event for Live Sessions / Analytics\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: total,\n                    completed: correctCount === total\n                }\n            }));\n\n            // Post Message for Parent Frames\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: total\n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            const selects = document.querySelectorAll('.phrasal-select');\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('is-correct', 'is-wrong');\n            });\n\n            document.getElementById('current-score').textContent = '0';\n            const feedbackEl = document.getElementById('feedback-message');\n            feedbackEl.classList.add('hidden');\n            feedbackEl.innerHTML = '';\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793468239997,
      "title": "Help with Vocabulary: Phrasal Verbs",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Help with Vocabulary: Phrasal Verbs</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom animations and smooth transitions */\n    .transition-all {\n      transition: all 0.25s ease-in-out;\n    }\n    input:focus, select:focus {\n      outline: none;\n      ring: 2px;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Top Bar for Progress & Audio/Context Simulator -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-30 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"w-full max-w-4xl mx-auto flex items-center justify-between\">\n      <div class=\"flex items-center space-x-2\">\n        <span class=\"bg-indigo-600 text-white p-2 rounded-xl flex items-center justify-center shadow-sm\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n          </svg>\n        </span>\n        <div>\n          <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Help with Vocabulary</h1>\n          <p class=\"text-xs text-slate-500 font-medium\">Phrasal Verbs: Structure & Meanings</p>\n        </div>\n      </div>\n      \n      <!-- Score counter display -->\n      <div id=\"score-badge\" class=\"flex items-center space-x-2 bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 text-amber-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\" />\n        </svg>\n        <span>Score: <strong id=\"current-score\" class=\"text-indigo-600\">0</strong> / <strong id=\"total-score\">4</strong></span>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 my-4 flex-grow space-y-6\">\n\n    <!-- Instructions & Reference Card (Accordion for meanings from Recorte #3) -->\n    <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm\">\n      <div class=\"flex items-start justify-between\">\n        <div>\n          <span class=\"inline-block bg-indigo-100 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wider mb-2\">Vocabulary Builder</span>\n          <h2 class=\"text-lg sm:text-xl font-extrabold text-slate-900\">4. Phrasal Verbs Structure</h2>\n          <p class=\"text-sm text-slate-600 mt-1\">\n            Phrasal verbs have two or three parts: a verb and one or two particles. Look at the table below and complete it using the definitions and phrasal verbs from the reference list.\n          </p>\n        </div>\n      </div>\n\n      <!-- Reference Guide (Definitions & Meanings from Image 3) -->\n      <details class=\"mt-4 bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm group\">\n        <summary class=\"font-semibold text-indigo-600 cursor-pointer flex items-center justify-between select-none\">\n          <span class=\"flex items-center space-x-2\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 text-indigo-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n            </svg>\n            <span>Reference List: Phrasal Verbs & Meanings (Click to toggle)</span>\n          </span>\n          <span class=\"text-xs bg-slate-200 text-slate-600 px-2 py-0.5 rounded group-open:bg-indigo-600 group-open:text-white transition-colors\">Guide</span>\n        </summary>\n        <div class=\"mt-3 pt-3 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700\">\n          <div><strong class=\"text-slate-900\">a)</strong> start living in a new home → <span class=\"font-mono text-indigo-600\">move in</span></div>\n          <div><strong class=\"text-slate-900\">b)</strong> like someone & be friendly → <span class=\"font-mono text-indigo-600\">get on with</span></div>\n          <div><strong class=\"text-slate-900\">c)</strong> be standing & sit in a chair → <span class=\"font-mono text-indigo-600\">sit down</span></div>\n          <div><strong class=\"text-slate-900\">d)</strong> tolerate → <span class=\"font-mono text-indigo-600\">put up with</span></div>\n          <div><strong class=\"text-slate-900\">e)</strong> stop doing</div>\n          <div><strong class=\"text-slate-900\">f)</strong> leave a place</div>\n          <div><strong class=\"text-slate-900\">g)</strong> continue</div>\n          <div><strong class=\"text-slate-900\">h)</strong> arrive at a place</div>\n          <div><strong class=\"text-slate-900\">i)</strong> return</div>\n          <div><strong class=\"text-slate-900\">j)</strong> remove</div>\n        </div>\n      </details>\n    </section>\n\n    <!-- Activity Section: The Table Completion (Recorte #1 & #2) -->\n    <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm\">\n      <div class=\"mb-4\">\n        <h3 class=\"font-bold text-slate-800 text-base\">Complete the Table</h3>\n        <p class=\"text-xs text-slate-500\">Write the missing phrasal verbs (<span class=\"italic\">sit down</span> and <span class=\"italic\">put up with</span>) splitting them into verb and particle(s).</p>\n      </div>\n\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full border-collapse text-left text-sm\">\n          <thead>\n            <tr class=\"bg-slate-100 border-b border-slate-200 text-slate-700\">\n              <th class=\"py-3 px-4 font-bold rounded-tl-xl w-1/2\">verb</th>\n              <th class=\"py-3 px-4 font-bold rounded-tr-xl w-1/2\">particle(s)</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-slate-200\">\n            <!-- Row 1: Pre-filled example -->\n            <tr class=\"bg-slate-50/50\">\n              <td class=\"py-3 px-4 font-medium text-slate-600\">move</td>\n              <td class=\"py-3 px-4 font-medium text-slate-600\">in</td>\n            </tr>\n            <!-- Row 2: Pre-filled example -->\n            <tr class=\"bg-slate-50/50\">\n              <td class=\"py-3 px-4 font-medium text-slate-600\">get</td>\n              <td class=\"py-3 px-4 font-medium text-slate-600\">on with</td>\n            </tr>\n            <!-- Row 3: Interactive (sit down) -->\n            <tr class=\"transition-colors hover:bg-slate-50\">\n              <td class=\"py-3 px-4\">\n                <input type=\"text\" \n                       id=\"verb-1\" \n                       data-answer=\"sit\" \n                       placeholder=\"e.g. sit\" \n                       class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all\">\n              </td>\n              <td class=\"py-3 px-4\">\n                <input type=\"text\" \n                       id=\"particle-1\" \n                       data-answer=\"down\" \n                       placeholder=\"e.g. down\" \n                       class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all\">\n              </td>\n            </tr>\n            <!-- Row 4: Interactive (put up with) -->\n            <tr class=\"transition-colors hover:bg-slate-50\">\n              <td class=\"py-3 px-4\">\n                <input type=\"text\" \n                       id=\"verb-2\" \n                       data-answer=\"put\" \n                       placeholder=\"e.g. put\" \n                       class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all\">\n              </td>\n              <td class=\"py-3 px-4\">\n                <input type=\"text\" \n                       id=\"particle-2\" \n                       data-answer=\"up with\" \n                       placeholder=\"e.g. up with\" \n                       class=\"w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all\">\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"mt-6 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-100\">\n        <button id=\"reset-btn\" type=\"button\" class=\"px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-700 text-sm font-semibold hover:bg-slate-50 active:bg-slate-100 transition-all flex items-center space-x-2 min-h-[42px]\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n          </svg>\n          <span>Reset Exercise</span>\n        </button>\n\n        <button id=\"check-btn\" type=\"button\" class=\"px-6 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 active:bg-indigo-800 shadow-sm transition-all flex items-center space-x-2 min-h-[42px]\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n          </svg>\n          <span>Check Answers</span>\n        </button>\n      </div>\n\n      <!-- Feedback banner -->\n      <div id=\"feedback-banner\" class=\"hidden mt-4 p-4 rounded-xl text-sm font-medium text-center transition-all\"></div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 mt-auto\">\n    Interactive ELT Activity &bull; Responsive Design & Mobile Optimized\n  </footer>\n\n  <!-- Script Logic & Pedagogy Contract -->\n  <script>\n    // 1. Mandatory Metrics Declaration\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'phrasal_verbs_structure',\n      maxScore: 4\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const checkBtn = document.getElementById('check-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const feedbackBanner = document.getElementById('feedback-banner');\n      const currentScoreEl = document.getElementById('current-score');\n      const inputs = document.querySelectorAll('input[data-answer]');\n\n      // Helper function to normalize user strings for fair grading\n      function normalize(str) {\n        return (str || '').toLowerCase().trim().replace(/\\s+/g, ' ');\n      }\n\n      function checkAnswers() {\n        let correctCount = 0;\n        const total = inputs.length;\n\n        inputs.forEach(input => {\n          const userAnswer = normalize(input.value);\n          const expectedAnswer = normalize(input.getAttribute('data-answer'));\n          \n          // Remove previous state classes\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n          if (userAnswer === expectedAnswer && expectedAnswer !== '') {\n            correctCount++;\n            input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n          } else {\n            input.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n          }\n        });\n\n        // Update score badge display\n        currentScoreEl.textContent = correctCount;\n\n        // Feedback Banner display\n        feedbackBanner.classList.remove('hidden');\n        if (correctCount === total) {\n          feedbackBanner.className = \"mt-4 p-4 rounded-xl text-sm font-semibold text-emerald-800 bg-emerald-100 border border-emerald-200 transition-all\";\n          feedbackBanner.innerHTML = \"🎉 Excellent job! All answers are correct. You've mastered identifying verb and particle components of phrasal verbs.\";\n        } else {\n          feedbackBanner.className = \"mt-4 p-4 rounded-xl text-sm font-semibold text-rose-800 bg-rose-100 border border-rose-200 transition-all\";\n          feedbackBanner.innerHTML = `⚠️ You got ${correctCount} out of ${total} correct. Review the definitions above and try again!`;\n        }\n\n        // 2. Dispatch mandatory custom event for live sessions/analytics\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: total,\n            completed: correctCount === total\n          }\n        }));\n\n        // 3. Parent frame communication (if inside iframe sandbox)\n        if (window.parent && window.parent !== window) {\n          window.parent.postMessage({\n            type: 'ACTIVITY_SCORE',\n            score: correctCount,\n            total: total\n          }, '*');\n        }\n      }\n\n      function resetExercise() {\n        inputs.forEach(input => {\n          input.value = '';\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n        });\n        currentScoreEl.textContent = '0';\n        feedbackBanner.classList.add('hidden');\n        feedbackBanner.innerHTML = '';\n      }\n\n      checkBtn.addEventListener('click', checkAnswers);\n      resetBtn.addEventListener('click', resetExercise);\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793468531259,
      "title": "Phrasal Verbs: Literal vs Non-Literal",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Phrasal Verbs: Literal vs Non-Literal</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom styles for smooth transitions and state colors */\n        .is-correct {\n            background-color: #d1fae5 !important;\n            border-color: #059669 !important;\n            color: #065f46 !important;\n        }\n        .is-wrong {\n            background-color: #fee2e2 !important;\n            border-color: #dc2626 !important;\n            color: #991b1b !important;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- Sticky Header / Score Tracker -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n        <div class=\"max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n            <div class=\"flex items-center space-x-3\">\n                <span class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n                </span>\n                <div>\n                    <h1 class=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">Vocabulary Builder: Phrasal Verbs</h1>\n                    <p class=\"text-xs text-slate-500\">Literal vs. Non-Literal Meanings</p>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-xl text-sm font-medium text-slate-700 flex items-center space-x-2\">\n                    <span>Score:</span>\n                    <span id=\"scoreDisplay\" class=\"font-bold text-indigo-600\">0 / 8</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content Container (Strictly w-full max-w-4xl mx-auto) -->\n    <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow space-y-6\">\n\n        <!-- Theory Section / Accordion Reference -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 shadow-sm\">\n            <details open class=\"group\">\n                <summary class=\"flex items-center justify-between cursor-pointer font-semibold text-slate-900 text-base sm:text-lg select-none\">\n                    <div class=\"flex items-center space-x-2\">\n                        <span class=\"bg-amber-100 text-amber-700 p-1.5 rounded-lg\">\n                            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                        </span>\n                        <span>Reference: Read about Phrasal Verbs</span>\n                    </div>\n                    <span class=\"text-slate-400 group-open:rotate-180 transition-transform duration-200\">\n                        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg>\n                    </span>\n                </summary>\n                \n                <div class=\"mt-4 pt-4 border-t border-slate-100 space-y-4 text-sm sm:text-base text-slate-600\">\n                    <div class=\"flex items-start space-x-3\">\n                        <span class=\"w-2 h-2 mt-2 bg-indigo-500 rounded-full flex-shrink-0\"></span>\n                        <div>\n                            <strong class=\"text-slate-800\">Literal Phrasal Verbs:</strong> We can understand the meaning directly from the verb and the particle(s).\n                            <p class=\"italic text-slate-500 mt-1 bg-slate-50 p-2 rounded-lg border border-slate-100\">Example: A new couple have <span class=\"font-semibold text-indigo-600\">moved in</span> next door.</p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start space-x-3\">\n                        <span class=\"w-2 h-2 mt-2 bg-purple-500 rounded-full flex-shrink-0\"></span>\n                        <div>\n                            <strong class=\"text-slate-800\">Non-Literal Phrasal Verbs:</strong> We can't always understand the meaning just from the individual words; they take on an idiomatic meaning.\n                            <p class=\"italic text-slate-500 mt-1 bg-slate-50 p-2 rounded-lg border border-slate-100\">Example: I <span class=\"font-semibold text-purple-600\">get on well with</span> all my other neighbours. (= like and be friendly)</p>\n                        </div>\n                    </div>\n                </div>\n            </details>\n        </section>\n\n        <!-- Interactive Exercise Section -->\n        <section class=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-6\">\n            <div class=\"border-b border-slate-100 pb-4\">\n                <h2 class=\"text-lg font-bold text-slate-900 flex items-center space-x-2\">\n                    <span class=\"bg-indigo-600 text-white w-7 h-7 rounded-lg flex items-center justify-center text-sm\">3</span>\n                    <span>Classify the Phrasal Verbs</span>\n                </h2>\n                <p class=\"text-sm text-slate-500 mt-1\">Look at the phrasal verbs below. Select whether each one is <span class=\"font-semibold text-slate-700\">Literal (L)</span> or <span class=\"font-semibold text-slate-700\">Non-Literal (NL)</span>.</p>\n            </div>\n\n            <!-- Items Grid -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n\n                <!-- Item 1 -->\n                <div class=\"flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-indigo-200 transition-colors\">\n                    <div class=\"flex items-center space-x-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0\">1</span>\n                        <span class=\"font-medium text-slate-800 text-base\">sit down</span>\n                    </div>\n                    <select class=\"ph-select py-2 px-3 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer min-w-[130px]\" data-answer=\"Literal\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"Literal\">Literal (L)</option>\n                        <option value=\"Non-Literal\">Non-Literal (NL)</option>\n                    </select>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-indigo-200 transition-colors\">\n                    <div class=\"flex items-center space-x-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0\">2</span>\n                        <span class=\"font-medium text-slate-800 text-base\">go away</span>\n                    </div>\n                    <select class=\"ph-select py-2 px-3 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer min-w-[130px]\" data-answer=\"Literal\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"Literal\">Literal (L)</option>\n                        <option value=\"Non-Literal\">Non-Literal (NL)</option>\n                    </select>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-indigo-200 transition-colors\">\n                    <div class=\"flex items-center space-x-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0\">3</span>\n                        <span class=\"font-medium text-slate-800 text-base\">take off</span>\n                    </div>\n                    <select class=\"ph-select py-2 px-3 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer min-w-[130px]\" data-answer=\"Literal\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"Literal\">Literal (L)</option>\n                        <option value=\"Non-Literal\">Non-Literal (NL)</option>\n                    </select>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-indigo-200 transition-colors\">\n                    <div class=\"flex items-center space-x-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0\">4</span>\n                        <span class=\"font-medium text-slate-800 text-base\">go back</span>\n                    </div>\n                    <select class=\"ph-select py-2 px-3 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer min-w-[130px]\" data-answer=\"Literal\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"Literal\">Literal (L)</option>\n                        <option value=\"Non-Literal\">Non-Literal (NL)</option>\n                    </select>\n                </div>\n\n                <!-- Item 5 -->\n                <div class=\"flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-indigo-200 transition-colors\">\n                    <div class=\"flex items-center space-x-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0\">5</span>\n                        <span class=\"font-medium text-slate-800 text-base\">put up with</span>\n                    </div>\n                    <select class=\"ph-select py-2 px-3 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer min-w-[130px]\" data-answer=\"Non-Literal\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"Literal\">Literal (L)</option>\n                        <option value=\"Non-Literal\">Non-Literal (NL)</option>\n                    </select>\n                </div>\n\n                <!-- Item 6 -->\n                <div class=\"flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-indigo-200 transition-colors\">\n                    <div class=\"flex items-center space-x-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0\">6</span>\n                        <span class=\"font-medium text-slate-800 text-base\">give up</span>\n                    </div>\n                    <select class=\"ph-select py-2 px-3 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer min-w-[130px]\" data-answer=\"Non-Literal\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"Literal\">Literal (L)</option>\n                        <option value=\"Non-Literal\">Non-Literal (NL)</option>\n                    </select>\n                </div>\n\n                <!-- Item 7 -->\n                <div class=\"flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-indigo-200 transition-colors\">\n                    <div class=\"flex items-center space-x-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0\">7</span>\n                        <span class=\"font-medium text-slate-800 text-base\">go on</span>\n                    </div>\n                    <select class=\"ph-select py-2 px-3 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer min-w-[130px]\" data-answer=\"Non-Literal\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"Literal\">Literal (L)</option>\n                        <option value=\"Non-Literal\">Non-Literal (NL)</option>\n                    </select>\n                </div>\n\n                <!-- Item 8 -->\n                <div class=\"flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-indigo-200 transition-colors\">\n                    <div class=\"flex items-center space-x-3\">\n                        <span class=\"bg-slate-800 text-white text-xs font-bold w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0\">8</span>\n                        <span class=\"font-medium text-slate-800 text-base\">turn up</span>\n                    </div>\n                    <select class=\"ph-select py-2 px-3 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer min-w-[130px]\" data-answer=\"Non-Literal\">\n                        <option value=\"\">Select...</option>\n                        <option value=\"Literal\">Literal (L)</option>\n                        <option value=\"Non-Literal\">Non-Literal (NL)</option>\n                    </select>\n                </div>\n\n            </div>\n\n            <!-- Action Buttons -->\n            <div class=\"flex flex-wrap items-center justify-end gap-3 pt-4 border-t border-slate-100\">\n                <button id=\"resetBtn\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition-colors flex items-center space-x-2\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    <span>Reset</span>\n                </button>\n                <button id=\"checkBtn\" class=\"px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 shadow-sm transition-colors flex items-center space-x-2\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    <span>Check Answers</span>\n                </button>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 mt-8\">\n        Interactive ELT Learning Module • Phrasal Verbs Practice\n    </footer>\n\n    <!-- Script Logic -->\n    <script>\n        // Mandatory Pedagogical Metrics Contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'phrasal_verbs_literal_non_literal',\n            maxScore: 8\n        };\n\n        const checkBtn = document.getElementById('checkBtn');\n        const resetBtn = document.getElementById('resetBtn');\n        const scoreDisplay = document.getElementById('scoreDisplay');\n        const selects = document.querySelectorAll('.ph-select');\n\n        function checkAnswers() {\n            let correctCount = 0;\n\n            selects.forEach(select => {\n                const userVal = select.value.trim();\n                const correctVal = select.getAttribute('data-answer');\n\n                // Clear previous classes\n                select.classList.remove('is-correct', 'is-wrong');\n\n                if (userVal === correctVal) {\n                    select.classList.add('is-correct');\n                    correctCount++;\n                } else if (userVal !== \"\") {\n                    select.classList.add('is-wrong');\n                } else {\n                    // Treat unselected as wrong for visual feedback\n                    select.classList.add('is-wrong');\n                }\n            });\n\n            // Update score text\n            scoreDisplay.textContent = `${correctCount} / ${selects.length}`;\n\n            // Dispatch pedagogical update event\n            window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                detail: {\n                    metrics: window.ACTIVITY_METRICS,\n                    score: correctCount,\n                    total: selects.length,\n                    completed: correctCount === selects.length\n                }\n            }));\n\n            // Post message for parent frame embedding\n            if (window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: selects.length\n                }, '*');\n            }\n        }\n\n        function resetActivity() {\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('is-correct', 'is-wrong');\n            });\n            scoreDisplay.textContent = `0 / ${selects.length}`;\n        }\n\n        checkBtn.addEventListener('click', checkAnswers);\n        resetBtn.addEventListener('click', resetActivity);\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793468639750,
      "title": "V9.3 Phrasal Verbs Interactive Grammar Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>V9.3 Phrasal Verbs Interactive Grammar Practice</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    @keyframes pulse-subtle {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.7; }\n    }\n    .animate-pulse-subtle {\n      animation: pulse-subtle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Top Bar for Metrics & Status -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm\">\n    <div class=\"w-full max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n      <div class=\"flex items-center space-x-2\">\n        <span class=\"bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wider\">V9.3</span>\n        <h1 class=\"text-base sm:text-lg font-bold text-slate-900 tracking-tight\">Phrasal Verbs</h1>\n      </div>\n      <div class=\"flex items-center space-x-4\">\n        <div id=\"score-display\" class=\"text-sm font-semibold text-slate-600 bg-slate-100 px-3 py-1 rounded-full border border-slate-200\">\n          Score: <span id=\"current-score\" class=\"text-indigo-600 font-bold\">0</span> / <span id=\"total-score\">8</span>\n        </div>\n        <button id=\"reset-btn\" class=\"text-xs font-medium bg-slate-200 hover:bg-slate-300 text-slate-700 px-3 py-1.5 rounded-lg transition active:scale-95 flex items-center gap-1 cursor-pointer\">\n          <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n          Reset\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Content Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-4 space-y-6\">\n\n    <!-- Grammar Reference Box (Accordion) -->\n    <details open class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden transition-all\">\n      <summary class=\"bg-indigo-50/70 hover:bg-indigo-100/70 p-4 font-semibold text-indigo-900 cursor-pointer flex items-center justify-between text-sm sm:text-base select-none\">\n        <div class=\"flex items-center gap-2.5\">\n          <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n          <span>Grammar Reference: Phrasal Verbs (9C p72)</span>\n        </div>\n        <span class=\"text-xs text-indigo-700 bg-indigo-100 px-2 py-0.5 rounded-full font-medium\">Click to toggle</span>\n      </summary>\n      \n      <div class=\"p-4 sm:p-6 text-sm text-slate-700 space-y-4 border-t border-indigo-100 bg-white\">\n        <p class=\"leading-relaxed\">\n          There are a lot of common verbs in English with two or three words: <span class=\"italic text-indigo-900 font-medium\">get up, eat out, stay in, look after, go out with, run out of</span>, etc. These are called <strong>phrasal verbs</strong>. They are very common in spoken English.\n        </p>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n            <h4 class=\"font-semibold text-slate-900 mb-2 text-xs uppercase tracking-wider text-slate-500\">Structure</h4>\n            <p class=\"text-xs sm:text-sm mb-3\">Phrasal verbs have two or three parts: a verb and one or two particles.</p>\n            <table class=\"w-full text-left text-xs bg-white border border-slate-200 rounded-lg overflow-hidden\">\n              <thead class=\"bg-slate-100 text-slate-700\">\n                <tr><th class=\"p-2 border-b\">verb</th><th class=\"p-2 border-b\">particle(s)</th></tr>\n              </thead>\n              <tbody class=\"divide-y divide-slate-100\">\n                <tr><td class=\"p-2\">move</td><td class=\"p-2 font-mono text-indigo-600\">in</td></tr>\n                <tr><td class=\"p-2\">get</td><td class=\"p-2 font-mono text-indigo-600\">on with</td></tr>\n                <tr><td class=\"p-2\">sit</td><td class=\"p-2 font-mono text-indigo-600\">down</td></tr>\n                <tr><td class=\"p-2\">put</td><td class=\"p-2 font-mono text-indigo-600\">up with</td></tr>\n              </tbody>\n            </table>\n          </div>\n\n          <div class=\"space-y-3\">\n            <div class=\"bg-emerald-50/50 p-3.5 rounded-xl border border-emerald-200\">\n              <h5 class=\"font-semibold text-emerald-900 text-xs uppercase tracking-wider mb-1\">Literal Phrasal Verbs</h5>\n              <p class=\"text-xs leading-relaxed text-emerald-800\">We can understand the meaning from the verb and the particle(s): <span class=\"italic\">move in, sit down, go away, take off, go back</span>.</p>\n            </div>\n            <div class=\"bg-amber-50/50 p-3.5 rounded-xl border border-amber-200\">\n              <h5 class=\"font-semibold text-amber-900 text-xs uppercase tracking-wider mb-1\">Non-literal Phrasal Verbs</h5>\n              <p class=\"text-xs leading-relaxed text-amber-800\">We can't usually understand the meaning from the individual words: <span class=\"italic\">get on with, put up with, give up, go on, turn up</span>.</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"bg-indigo-50 p-3 rounded-xl border border-indigo-200 flex items-start gap-2.5\">\n          <svg class=\"w-5 h-5 text-indigo-600 flex-shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round5\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n          <p class=\"text-xs sm:text-sm text-indigo-900\"><strong>TIP!</strong> We often use <em>well</em> with <em>get on with</em>: <span class=\"italic\">I get on well with all my other neighbours</span>.</p>\n        </div>\n      </div>\n    </details>\n\n    <!-- Interactive Practice Section -->\n    <section class=\"bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-8 space-y-6\">\n      <div>\n        <h2 class=\"text-lg sm:text-xl font-bold text-slate-900\">Practice: Categorize & Complete</h2>\n        <p class=\"text-sm text-slate-600 mt-1\">Complete the sentences using the correct particles or identify whether the phrasal verb is literal or non-literal based on the reference notes.</p>\n      </div>\n\n      <div class=\"space-y-5\" id=\"exercise-list\">\n        \n        <!-- Question 1 -->\n        <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 question-item\" data-id=\"1\">\n          <div class=\"space-y-1\">\n            <span class=\"inline-block bg-slate-800 text-white text-xs font-bold px-2 py-0.5 rounded\">1</span>\n            <span class=\"text-sm sm:text-base text-slate-800 font-medium\">Please, sit <input type=\"text\" data-answer=\"down\" class=\"inline-block mx-1 w-24 text-center px-2 py-1.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white\" placeholder=\"particle\" autocomplete=\"off\" autocapitalize=\"off\">. The class is about to start.</span>\n          </div>\n          <span class=\"text-xs text-slate-500 italic sm:text-right\">(Literal meaning)</span>\n        </div>\n\n        <!-- Question 2 -->\n        <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 question-item\" data-id=\"2\">\n          <div class=\"space-y-1\">\n            <span class=\"inline-block bg-slate-800 text-white text-xs font-bold px-2 py-0.5 rounded\">2</span>\n            <span class=\"text-sm sm:text-base text-slate-800 font-medium\">I live next door and I'm going to move <input type=\"text\" data-answer=\"in\" class=\"inline-block mx-1 w-20 text-center px-2 py-1.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white\" placeholder=\"particle\" autocomplete=\"off\" autocapitalize=\"off\"> this weekend.</span>\n          </div>\n          <span class=\"text-xs text-slate-500 italic sm:text-right\">(Literal meaning)</span>\n        </div>\n\n        <!-- Question 3 -->\n        <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 question-item\" data-id=\"3\">\n          <div class=\"space-y-1\">\n            <span class=\"inline-block bg-slate-800 text-white text-xs font-bold px-2 py-0.5 rounded\">3</span>\n            <span class=\"text-sm sm:text-base text-slate-800 font-medium\">I get <input type=\"text\" data-answer=\"on\" class=\"inline-block mx-1 w-16 text-center px-2 py-1.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white\" placeholder=\"part 1\" autocomplete=\"off\" autocapitalize=\"off\"> <input type=\"text\" data-answer=\"with\" class=\"inline-block mx-1 w-16 text-center px-2 py-1.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white\" placeholder=\"part 2\" autocomplete=\"off\" autocapitalize=\"off\"> well with all my neighbours.</span>\n          </div>\n          <span class=\"text-xs text-slate-500 italic sm:text-right\">(Non-literal meaning)</span>\n        </div>\n\n        <!-- Question 4 -->\n        <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 question-item\" data-id=\"4\">\n          <div class=\"space-y-1\">\n            <span class=\"inline-block bg-slate-800 text-white text-xs font-bold px-2 py-0.5 rounded\">4</span>\n            <span class=\"text-sm sm:text-base text-slate-800 font-medium\">It's very noisy; I can't put <input type=\"text\" data-answer=\"up\" class=\"inline-block mx-1 w-16 text-center px-2 py-1.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white\" placeholder=\"part 1\" autocomplete=\"off\" autocapitalize=\"off\"> <input type=\"text\" data-answer=\"with\" class=\"inline-block mx-1 w-16 text-center px-2 py-1.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white\" placeholder=\"part 2\" autocomplete=\"off\" autocapitalize=\"off\"> this loud music anymore!</span>\n          </div>\n          <span class=\"text-xs text-slate-500 italic sm:text-right\">(Non-literal meaning)</span>\n        </div>\n\n        <!-- Question 5 -->\n        <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 question-item\" data-id=\"5\">\n          <div class=\"space-y-1\">\n            <span class=\"inline-block bg-slate-800 text-white text-xs font-bold px-2 py-0.5 rounded\">5</span>\n            <span class=\"text-sm sm:text-base text-slate-800 font-medium\">Are these phrasal verbs literal or non-literal? <span class=\"italic text-indigo-700\">give up</span></span>\n          </div>\n          <div>\n            <select data-answer=\"non-literal\" class=\"w-full sm:w-auto px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white font-medium\">\n              <option value=\"\">-- select --</option>\n              <option value=\"literal\">Literal</option>\n              <option value=\"non-literal\">Non-literal</option>\n            </select>\n          </div>\n        </div>\n\n        <!-- Question 6 -->\n        <div class=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 question-item\" data-id=\"6\">\n          <div class=\"space-y-1\">\n            <span class=\"inline-block bg-slate-800 text-white text-xs font-bold px-2 py-0.5 rounded\">6</span>\n            <span class=\"text-sm sm:text-base text-slate-800 font-medium\">Are these phrasal verbs literal or non-literal? <span class=\"italic text-indigo-700\">take off</span></span>\n          </div>\n          <div>\n            <select data-answer=\"literal\" class=\"w-full sm:w-auto px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white font-medium\">\n              <option value=\"\">-- select --</option>\n              <option value=\"literal\">Literal</option>\n              <option value=\"non-literal\">Non-literal</option>\n            </select>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"pt-4 flex flex-wrap items-center justify-end gap-3 border-t border-slate-200\">\n        <button id=\"check-btn\" class=\"w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2.5 rounded-xl transition shadow-sm active:scale-95 flex items-center justify-center gap-2 cursor-pointer min-h-[42px]\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round5\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n          Check Answers\n        </button>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-200 bg-white\">\n    English Language Teaching (ELT) Interactive Micro-App • V9.3 Phrasal Verbs\n  </footer>\n\n  <!-- Script & Analytics Integration -->\n  <script>\n    // Mandatory Metrics Contract Declaration\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'phrasal_verbs_identification',\n      maxScore: 8 // Total individual blanks/inputs to evaluate across 6 items\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const checkBtn = document.getElementById('check-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const currentScoreEl = document.getElementById('current-score');\n      const totalScoreEl = document.getElementById('total-score');\n\n      // Collect all interactive elements that contain data-answer\n      const interactiveElements = document.querySelectorAll('[data-answer]');\n      totalScoreEl.textContent = interactiveElements.length;\n      window.ACTIVITY_METRICS.maxScore = interactiveElements.length;\n\n      function normalize(str) {\n        return (str || '').trim().toLowerCase();\n      }\n\n      function checkAnswers() {\n        let correctCount = 0;\n        let totalCount = interactiveElements.length;\n\n        interactiveElements.forEach(el => {\n          const expected = normalize(el.getAttribute('data-answer'));\n          let userVal = '';\n\n          if (el.tagName === 'INPUT' || el.tagName === 'SELECT') {\n            userVal = normalize(el.value);\n          }\n\n          // Reset previous states\n          el.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n          if (userVal === expected && userVal !== '') {\n            correctCount++;\n            el.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-semibold');\n          } else {\n            el.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n          }\n        });\n\n        // Update score display\n        currentScoreEl.textContent = correctCount;\n\n        // Dispatch Custom Event for Live Sessions & Analytics\n        const eventDetail = {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: totalCount,\n          completed: correctCount === totalCount\n        };\n\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', { detail: eventDetail }));\n\n        // Post message for parent frame embedding\n        try {\n          window.parent.postMessage({ type: 'ACTIVITY_SCORE', score: correctCount, total: totalCount }, '*');\n        } catch (e) {\n          console.error(e);\n        }\n      }\n\n      function resetActivity() {\n        interactiveElements.forEach(el => {\n          if (el.tagName === 'INPUT') {\n            el.value = '';\n          } else if (el.tagName === 'SELECT') {\n            el.selectedIndex = 0;\n          }\n          el.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900', 'font-semibold');\n        });\n        currentScoreEl.textContent = '0';\n      }\n\n      checkBtn.addEventListener('click', checkAnswers);\n      resetBtn.addEventListener('click', resetActivity);\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793470785528,
      "title": "Listening Exercise - Neighbours",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Listening Exercise - Neighbours</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom smooth transitions and focus outlines */\n    .transition-all {\n      transition-property: all;\n      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n      transition-duration: 200ms;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased selection:bg-indigo-100 selection:text-indigo-800\">\n\n  <!-- STICKY TOP AUDIO PLAYER BAR (Always visible from start per professor notes) -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur-md z-30 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"flex items-center justify-center w-8 h-8 rounded-full bg-indigo-50 text-indigo-600 font-bold text-sm\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\" />\n          </svg>\n        </span>\n        <div>\n          <h1 class=\"text-sm font-bold text-slate-900 leading-tight\">Track R9.7: Neighbours</h1>\n          <p class=\"text-xs text-slate-500\">Listen and match speakers 1–5 to pictures A–E</p>\n        </div>\n      </div>\n      <audio id=\"lessonAudio\" controls class=\"w-full sm:w-72 h-10 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\" src=\"data:audio/mpeg;base64,\"></audio>\n    </div>\n  </header>\n\n  <!-- MAIN CONTAINER -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 my-4 flex-grow\">\n    \n    <!-- INSTRUCTION CARD -->\n    <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 mb-6\">\n      <div class=\"flex items-start gap-3\">\n        <div class=\"bg-indigo-600 text-white font-black text-sm rounded-xl w-8 h-8 flex items-center justify-center shrink-0 shadow-sm\">\n          7\n        </div>\n        <div>\n          <div class=\"inline-block bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-0.5 rounded-md uppercase tracking-wider mb-1\">\n            Listening\n          </div>\n          <h2 class=\"text-lg sm:text-xl font-bold text-slate-900\">\n            Listen to five people talking about their neighbours. Put pictures A–E in order.\n          </h2>\n          <p class=\"text-xs sm:text-sm text-slate-500 mt-1\">\n            Listen to the audio and select which picture (A, B, C, D, or E) corresponds to speakers 1 through 5.\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <!-- GALLERY OF PICTURES (A-E) -->\n    <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-6 mb-6\">\n      <h3 class=\"text-sm font-bold uppercase tracking-wider text-slate-500 mb-4 flex items-center gap-2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n        </svg>\n        Reference Pictures (A – E)\n      </h3>\n\n      <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-4\">\n        <!-- Picture A -->\n        <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-2.5 flex flex-col items-center justify-between text-center hover:shadow-md transition-all\">\n          <div class=\"flex justify-center items-center overflow-visible mb-2 h-32 sm:h-36\">\n            <img src=\"data:image/png;base64,\" alt=\"Picture A\" class=\"max-h-32 sm:max-h-36 w-auto mx-auto object-contain rounded-lg shadow-sm block\">\n          </div>\n          <span class=\"inline-flex items-center justify-center w-7 h-7 bg-indigo-600 text-white font-bold text-xs rounded-full shadow-sm\">A</span>\n        </div>\n\n        <!-- Picture B -->\n        <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-2.5 flex flex-col items-center justify-between text-center hover:shadow-md transition-all\">\n          <div class=\"flex justify-center items-center overflow-visible mb-2 h-32 sm:h-36\">\n            <img src=\"data:image/png;base64,\" alt=\"Picture B\" class=\"max-h-32 sm:max-h-36 w-auto mx-auto object-contain rounded-lg shadow-sm block\">\n          </div>\n          <span class=\"inline-flex items-center justify-center w-7 h-7 bg-indigo-600 text-white font-bold text-xs rounded-full shadow-sm\">B</span>\n        </div>\n\n        <!-- Picture C -->\n        <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-2.5 flex flex-col items-center justify-between text-center hover:shadow-md transition-all\">\n          <div class=\"flex justify-center items-center overflow-visible mb-2 h-32 sm:h-36\">\n            <img src=\"data:image/png;base64,\" alt=\"Picture C\" class=\"max-h-32 sm:max-h-36 w-auto mx-auto object-contain rounded-lg shadow-sm block\">\n          </div>\n          <span class=\"inline-flex items-center justify-center w-7 h-7 bg-indigo-600 text-white font-bold text-xs rounded-full shadow-sm\">C</span>\n        </div>\n\n        <!-- Picture D -->\n        <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-2.5 flex flex-col items-center justify-between text-center hover:shadow-md transition-all\">\n          <div class=\"flex justify-center items-center overflow-visible mb-2 h-32 sm:h-36\">\n            <img src=\"data:image/png;base64,\" alt=\"Picture D\" class=\"max-h-32 sm:max-h-36 w-auto mx-auto object-contain rounded-lg shadow-sm block\">\n          </div>\n          <span class=\"inline-flex items-center justify-center w-7 h-7 bg-indigo-600 text-white font-bold text-xs rounded-full shadow-sm\">D</span>\n        </div>\n\n        <!-- Picture E -->\n        <div class=\"bg-slate-50 border border-slate-200 rounded-xl p-2.5 flex flex-col items-center justify-between text-center hover:shadow-md transition-all col-span-2 sm:col-span-1\">\n          <div class=\"flex justify-center items-center overflow-visible mb-2 h-32 sm:h-36\">\n            <img src=\"data:image/png;base64,\" alt=\"Picture E\" class=\"max-h-32 sm:max-h-36 w-auto mx-auto object-contain rounded-lg shadow-sm block\">\n          </div>\n          <span class=\"inline-flex items-center justify-center w-7 h-7 bg-indigo-600 text-white font-bold text-xs rounded-full shadow-sm\">E</span>\n        </div>\n      </div>\n    </section>\n\n    <!-- INTERACTIVE MATCHING EXERCISE -->\n    <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 mb-6\">\n      <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 mb-4 border-b border-slate-100 gap-2\">\n        <h3 class=\"text-sm font-bold uppercase tracking-wider text-slate-500\">\n          Speaker Matching Activity\n        </h3>\n        <!-- Live Score Counter -->\n        <div id=\"scoreDisplay\" class=\"bg-slate-100 text-slate-700 font-semibold px-3 py-1.5 rounded-lg text-sm flex items-center gap-2\">\n          <span>Score:</span>\n          <span id=\"currentScore\" class=\"font-bold text-indigo-600\">0</span> / <span id=\"maxScore\">5</span>\n        </div>\n      </div>\n\n      <!-- Speakers list with dropdown selectors -->\n      <div class=\"space-y-3\" id=\"questionsContainer\">\n        \n        <!-- Speaker 1 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 hover:bg-indigo-50/40 rounded-xl border border-slate-200 transition-all gap-4\">\n          <div class=\"flex items-center gap-3\">\n            <span class=\"w-9 h-9 rounded-lg bg-slate-800 text-white font-bold text-sm flex items-center justify-center shadow-sm shrink-0\">\n              1\n            </span>\n            <span class=\"font-medium text-slate-700 text-sm sm:text-base\">Speaker 1</span>\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label for=\"speaker1\" class=\"text-xs font-medium text-slate-400 hidden sm:inline\">Picture:</label>\n            <select id=\"speaker1\" data-answer=\"B\" class=\"interactive-input w-28 sm:w-36 h-11 px-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-800 font-semibold text-base focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all cursor-pointer shadow-sm\">\n              <option value=\"\" disabled selected>Select...</option>\n              <option value=\"A\">Picture A</option>\n              <option value=\"B\">Picture B</option>\n              <option value=\"C\">Picture C</option>\n              <option value=\"D\">Picture D</option>\n              <option value=\"E\">Picture E</option>\n            </select>\n          </div>\n        </div>\n\n        <!-- Speaker 2 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 hover:bg-indigo-50/40 rounded-xl border border-slate-200 transition-all gap-4\">\n          <div class=\"flex items-center gap-3\">\n            <span class=\"w-9 h-9 rounded-lg bg-slate-800 text-white font-bold text-sm flex items-center justify-center shadow-sm shrink-0\">\n              2\n            </span>\n            <span class=\"font-medium text-slate-700 text-sm sm:text-base\">Speaker 2</span>\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label for=\"speaker2\" class=\"text-xs font-medium text-slate-400 hidden sm:inline\">Picture:</label>\n            <select id=\"speaker2\" data-answer=\"D\" class=\"interactive-input w-28 sm:w-36 h-11 px-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-800 font-semibold text-base focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all cursor-pointer shadow-sm\">\n              <option value=\"\" disabled selected>Select...</option>\n              <option value=\"A\">Picture A</option>\n              <option value=\"B\">Picture B</option>\n              <option value=\"C\">Picture C</option>\n              <option value=\"D\">Picture D</option>\n              <option value=\"E\">Picture E</option>\n            </select>\n          </div>\n        </div>\n\n        <!-- Speaker 3 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 hover:bg-indigo-50/40 rounded-xl border border-slate-200 transition-all gap-4\">\n          <div class=\"flex items-center gap-3\">\n            <span class=\"w-9 h-9 rounded-lg bg-slate-800 text-white font-bold text-sm flex items-center justify-center shadow-sm shrink-0\">\n              3\n            </span>\n            <span class=\"font-medium text-slate-700 text-sm sm:text-base\">Speaker 3</span>\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label for=\"speaker3\" class=\"text-xs font-medium text-slate-400 hidden sm:inline\">Picture:</label>\n            <select id=\"speaker3\" data-answer=\"E\" class=\"interactive-input w-28 sm:w-36 h-11 px-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-800 font-semibold text-base focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all cursor-pointer shadow-sm\">\n              <option value=\"\" disabled selected>Select...</option>\n              <option value=\"A\">Picture A</option>\n              <option value=\"B\">Picture B</option>\n              <option value=\"C\">Picture C</option>\n              <option value=\"D\">Picture D</option>\n              <option value=\"E\">Picture E</option>\n            </select>\n          </div>\n        </div>\n\n        <!-- Speaker 4 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 hover:bg-indigo-50/40 rounded-xl border border-slate-200 transition-all gap-4\">\n          <div class=\"flex items-center gap-3\">\n            <span class=\"w-9 h-9 rounded-lg bg-slate-800 text-white font-bold text-sm flex items-center justify-center shadow-sm shrink-0\">\n              4\n            </span>\n            <span class=\"font-medium text-slate-700 text-sm sm:text-base\">Speaker 4</span>\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label for=\"speaker4\" class=\"text-xs font-medium text-slate-400 hidden sm:inline\">Picture:</label>\n            <select id=\"speaker4\" data-answer=\"A\" class=\"interactive-input w-28 sm:w-36 h-11 px-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-800 font-semibold text-base focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all cursor-pointer shadow-sm\">\n              <option value=\"\" disabled selected>Select...</option>\n              <option value=\"A\">Picture A</option>\n              <option value=\"B\">Picture B</option>\n              <option value=\"C\">Picture C</option>\n              <option value=\"D\">Picture D</option>\n              <option value=\"E\">Picture E</option>\n            </select>\n          </div>\n        </div>\n\n        <!-- Speaker 5 -->\n        <div class=\"flex items-center justify-between p-3.5 bg-slate-50 hover:bg-indigo-50/40 rounded-xl border border-slate-200 transition-all gap-4\">\n          <div class=\"flex items-center gap-3\">\n            <span class=\"w-9 h-9 rounded-lg bg-slate-800 text-white font-bold text-sm flex items-center justify-center shadow-sm shrink-0\">\n              5\n            </span>\n            <span class=\"font-medium text-slate-700 text-sm sm:text-base\">Speaker 5</span>\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label for=\"speaker5\" class=\"text-xs font-medium text-slate-400 hidden sm:inline\">Picture:</label>\n            <select id=\"speaker5\" data-answer=\"C\" class=\"interactive-input w-28 sm:w-36 h-11 px-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-800 font-semibold text-base focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all cursor-pointer shadow-sm\">\n              <option value=\"\" disabled selected>Select...</option>\n              <option value=\"A\">Picture A</option>\n              <option value=\"B\">Picture B</option>\n              <option value=\"C\">Picture C</option>\n              <option value=\"D\">Picture D</option>\n              <option value=\"E\">Picture E</option>\n            </select>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- ACTION BUTTONS -->\n      <div class=\"flex flex-wrap items-center justify-end gap-3 mt-6 pt-4 border-t border-slate-100\">\n        <button id=\"resetBtn\" class=\"w-full sm:w-auto px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm min-h-[42px]\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n          </svg>\n          Reset Answers\n        </button>\n        <button id=\"checkBtn\" class=\"w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm min-h-[42px]\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n          </svg>\n          Check Answers\n        </button>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"text-center py-4 text-xs text-slate-400 border-t border-slate-200 mt-auto bg-white\">\n    Interactive ELT Activity &bull; Designed for Touch & Responsive Devices\n  </footer>\n\n  <!-- SCRIPT LOGIC -->\n  <script>\n    // MANDATORY PEDAGOGICAL METRICS CONTRACT\n    window.ACTIVITY_METRICS = {\n      domain: 'Listening',\n      skill: 'listening_for_gist_and_detail',\n      maxScore: 5\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const checkBtn = document.getElementById('checkBtn');\n      const resetBtn = document.getElementById('resetBtn');\n      const inputs = document.querySelectorAll('.interactive-input');\n      const currentScoreEl = document.getElementById('currentScore');\n\n      // Check Answers handler\n      checkBtn.addEventListener('click', () => {\n        let correctCount = 0;\n\n        inputs.forEach(input => {\n          const userAnswer = input.value.trim().toUpperCase();\n          const correctAnswer = input.getAttribute('data-answer').toUpperCase();\n\n          // Remove previous states\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n          if (userAnswer === correctAnswer) {\n            correctCount++;\n            input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');\n          } else {\n            input.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n          }\n        });\n\n        // Update score UI\n        currentScoreEl.textContent = correctCount;\n\n        // Dispatch mandatory custom event\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: inputs.length,\n            completed: correctCount === inputs.length\n          }\n        }));\n\n        // Post message to parent container if applicable\n        if (window.parent !== window) {\n          window.parent.postMessage({\n            type: 'ACTIVITY_SCORE',\n            score: correctCount,\n            total: inputs.length\n          }, '*');\n        }\n      });\n\n      // Reset handler\n      resetBtn.addEventListener('click', () => {\n        inputs.forEach(input => {\n          input.value = '';\n          input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n        });\n\n        currentScoreEl.textContent = '0';\n\n        // Dispatch update for reset\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: 0,\n            total: inputs.length,\n            completed: false\n          }\n        }));\n\n        if (window.parent !== window) {\n          window.parent.postMessage({\n            type: 'ACTIVITY_SCORE',\n            score: 0,\n            total: inputs.length\n          }, '*');\n        }\n      });\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793469052698,
      "title": "Listening Comprehension - Neighbours",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Listening Comprehension - Neighbours</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .transition-all {\n      transition-property: all;\n      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n      transition-duration: 200ms;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col justify-between\">\n\n  <!-- STICKY AUDIO HEADER -->\n  <header id=\"audioHeader\" class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"bg-indigo-100 text-indigo-700 p-1.5 rounded-lg\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 11.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\" />\n          </svg>\n        </span>\n        <div>\n          <h1 id=\"audioStatusText\" class=\"text-sm font-semibold text-slate-700\">Listening Activity</h1>\n          <p class=\"text-xs text-indigo-600 font-medium flex items-center gap-1\" id=\"audioLockMsg\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-3.5 h-3.5 inline\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\" />\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n            </svg>\n            Play audio to listen and answer\n          </p>\n        </div>\n      </div>\n      <!-- FULLY ACCESSIBLE AUDIO CONTAINER -->\n      <div id=\"audioWrapper\" class=\"w-full sm:w-auto transition-all duration-300\">\n        <audio id=\"lessonAudio\" controls class=\"w-full sm:w-80 h-10\" src=\"data:audio/mpeg;base64,\"></audio>\n      </div>\n    </div>\n  </header>\n\n  <!-- MAIN CONTAINER -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow my-4\">\n    \n    <!-- INSTRUCTION CARD -->\n    <section class=\"bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200 mb-6\">\n      <div class=\"flex items-start gap-3\">\n        <span class=\"bg-sky-500 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">b</span>\n        <div>\n          <h2 class=\"text-lg font-bold text-slate-900\">Listen again. Answer these questions.</h2>\n          <p class=\"text-slate-600 text-sm mt-1\">Type your answers in the input fields below based on what you heard. Be concise and accurate.</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- QUESTIONS FORM -->\n    <form id=\"quizForm\" class=\"space-y-4 sm:space-y-6\" onsubmit=\"return false;\">\n      \n      <!-- Question 1 -->\n      <div class=\"bg-white rounded-xl p-4 sm:p-5 shadow-sm border border-slate-200 transition-all hover:border-slate-300\">\n        <label for=\"q1\" class=\"block text-sm sm:text-base font-medium text-slate-900 mb-2\">\n          <span class=\"font-bold text-indigo-600 mr-2\">1.</span> What do the first person's neighbours do when she goes away?\n        </label>\n        <div class=\"relative\">\n          <input \n            type=\"text\" \n            id=\"q1\" \n            data-answer=\"They look after her cats.\" \n            class=\"w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 px-3.5 text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all\" \n            placeholder=\"Type your answer here...\"\n            autocomplete=\"off\">\n        </div>\n        <p class=\"text-xs text-slate-400 mt-1 italic hidden correct-hint\">Correct answer: They look after her cats.</p>\n      </div>\n\n      <!-- Question 2 -->\n      <div class=\"bg-white rounded-xl p-4 sm:p-5 shadow-sm border border-slate-200 transition-all hover:border-slate-300\">\n        <label for=\"q2\" class=\"block text-sm sm:text-base font-medium text-slate-900 mb-2\">\n          <span class=\"font-bold text-indigo-600 mr-2\">2.</span> What is the second person thinking of doing?\n        </label>\n        <div class=\"relative\">\n          <input \n            type=\"text\" \n            id=\"q2\" \n            data-answer=\"Moving house\" \n            class=\"w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 px-3.5 text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all\" \n            placeholder=\"Type your answer here...\"\n            autocomplete=\"off\">\n        </div>\n        <p class=\"text-xs text-slate-400 mt-1 italic hidden correct-hint\">Correct answer: Moving house</p>\n      </div>\n\n      <!-- Question 3 -->\n      <div class=\"bg-white rounded-xl p-4 sm:p-5 shadow-sm border border-slate-200 transition-all hover:border-slate-300\">\n        <label for=\"q3\" class=\"block text-sm sm:text-base font-medium text-slate-900 mb-2\">\n          <span class=\"font-bold text-indigo-600 mr-2\">3.</span> How far away is the third person's nearest neighbour?\n        </label>\n        <div class=\"relative\">\n          <input \n            type=\"text\" \n            id=\"q3\" \n            data-answer=\"About 4 miles away\" \n            class=\"w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 px-3.5 text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all\" \n            placeholder=\"Type your answer here...\"\n            autocomplete=\"off\">\n        </div>\n        <p class=\"text-xs text-slate-400 mt-1 italic hidden correct-hint\">Correct answer: About 4 miles away</p>\n      </div>\n\n      <!-- Question 4 -->\n      <div class=\"bg-white rounded-xl p-4 sm:p-5 shadow-sm border border-slate-200 transition-all hover:border-slate-300\">\n        <label for=\"q4\" class=\"block text-sm sm:text-base font-medium text-slate-900 mb-2\">\n          <span class=\"font-bold text-indigo-600 mr-2\">4.</span> Why does the fourth person think the children get into trouble?\n        </label>\n        <div class=\"relative\">\n          <input \n            type=\"text\" \n            id=\"q4\" \n            data-answer=\"There aren't enough places for them to play.\" \n            class=\"w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 px-3.5 text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all\" \n            placeholder=\"Type your answer here...\"\n            autocomplete=\"off\">\n        </div>\n        <p class=\"text-xs text-slate-400 mt-1 italic hidden correct-hint\">Correct answer: There aren't enough places for them to play.</p>\n      </div>\n\n      <!-- Question 5 -->\n      <div class=\"bg-white rounded-xl p-4 sm:p-5 shadow-sm border border-slate-200 transition-all hover:border-slate-300\">\n        <label for=\"q5\" class=\"block text-sm sm:text-base font-medium text-slate-900 mb-2\">\n          <span class=\"font-bold text-indigo-600 mr-2\">5.</span> Why is it important for the fifth person to park near her house?\n        </label>\n        <div class=\"relative\">\n          <input \n            type=\"text\" \n            id=\"q5\" \n            data-answer=\"Because she has two children under the age of two.\" \n            class=\"w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 px-3.5 text-slate-800 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all\" \n            placeholder=\"Type your answer here...\"\n            autocomplete=\"off\">\n        </div>\n        <p class=\"text-xs text-slate-400 mt-1 italic hidden correct-hint\">Correct answer: Because she has two children under the age of two.</p>\n      </div>\n\n      <!-- AUDIO SCRIPT REFERENCE ACCORDION (LOCKED UNTIL CHECKED) -->\n      <div id=\"transcriptWrapper\" class=\"bg-slate-100 border border-slate-200 rounded-2xl p-5 sm:p-6 mt-8 opacity-40 pointer-events-none select-none transition-all duration-300\">\n        <div class=\"flex items-start gap-3 mb-3\">\n          <span class=\"bg-slate-700 text-white font-bold text-xs px-2.5 py-1 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">Audio Script</span>\n          <div>\n            <h3 id=\"transcriptStatusTitle\" class=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n              <span>Locked Audio Script</span>\n              <span id=\"transcriptLockBadge\" class=\"text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-medium flex items-center gap-1\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\" />\n                </svg>\n                Check answers to unlock\n              </span>\n            </h3>\n            <p class=\"text-slate-600 text-sm mt-0.5\">Compare your answers with the conversation script once checked.</p>\n          </div>\n        </div>\n        <div class=\"text-sm text-slate-700 space-y-3 bg-white p-4 sm:p-5 rounded-xl border border-slate-200 mt-4 leading-relaxed max-h-72 overflow-y-auto\">\n          <p><strong class=\"text-indigo-900\">PRESENTER:</strong> ...And we'll have more about that story later in the programme. A new report out today says that one of the biggest causes of stress is our neighbours. So we sent our reporter, Mandy Stevens, to find out what the public think.</p>\n          <p><strong class=\"text-indigo-900\">MANDY:</strong> Excuse me, can I ask you if you get on well with your neighbours?</p>\n          <p><strong class=\"text-slate-900\">FIRST PERSON:</strong> Oh, yes, definitely. I've got fantastic neighbours – well, they're friends really, not just neighbours. We often, you know, go round to visit each other for er coffee and um just talk about the day. And when I um go away for the weekend they, you know, always look after my cats, which is really useful.</p>\n          <p><strong class=\"text-slate-900\">SECOND PERSON:</strong> Well, I kind of get on with all my neighbours er except one. They've er got a teenage son, you see, and he's, like, learning to play the drums. They're really loud and er it drives us crazy! I've, like, talked to his parents, but you know, they just don't care. We're thinking of moving house to get away from them.</p>\n          <p><strong class=\"text-slate-900\">THIRD PERSON:</strong> Well, I don't um have any neighbours, actually. I live in a big house in the country and er there's nobody near me. The nearest house is about um 4 miles away. And, you know, that's um just the way I want it. I like the quiet, you see.</p>\n          <p><strong class=\"text-slate-900\">FOURTH PERSON:</strong> Well, most of my neighbours are, you know, OK, but um it's the kids that are the problem. There aren't enough places for them to play, you see, so they just get into trouble. It's er it's not really their fault, they're kind of ... just bored really and you know there's not much to do round here.</p>\n          <p><strong class=\"text-slate-900\">FIFTH PERSON:</strong> Well, in our street there're, like, not enough places to park. So you know, people just um park anywhere. So sometimes I er have to leave my car a long way from my house, which is, you know, really annoying. I've got 2 kids under the age of 2, you see, and sometimes I um have to carry them quite a long way. So, yeah, my neighbours are a bit of a problem.</p>\n        </div>\n      </div>\n\n      <!-- DISCUSSION SECTION (Part C) -->\n      <div class=\"bg-sky-50 border border-sky-200 rounded-2xl p-5 sm:p-6 mt-8\">\n        <div class=\"flex items-start gap-3\">\n          <span class=\"bg-sky-700 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">c</span>\n          <div>\n            <h3 class=\"text-base font-bold text-sky-900\">Work in pairs.</h3>\n            <p class=\"text-sky-800 text-sm mt-1\">Who do you think has the biggest problem with their neighbours? Discuss with a partner.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- ACTION CONTROLS -->\n      <div class=\"flex flex-wrap items-center justify-between gap-4 pt-4\">\n        <div id=\"scoreDisplay\" class=\"text-sm font-semibold text-slate-700 bg-slate-100 px-4 py-2.5 rounded-xl hidden\">\n          Score: <span id=\"scoreVal\">0</span> / <span id=\"totalVal\">5</span>\n        </div>\n        <div class=\"flex items-center gap-3 w-full sm:w-auto ml-auto\">\n          <button \n            type=\"button\" \n            id=\"resetBtn\" \n            onclick=\"resetActivity()\" \n            class=\"flex-1 sm:flex-none px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium text-sm hover:bg-slate-100 active:scale-95 transition-all\">\n            🔄 Reset\n          </button>\n          <button \n            type=\"button\" \n            id=\"checkBtn\" \n            onclick=\"checkAnswers()\" \n            class=\"flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-medium text-sm hover:bg-indigo-700 active:scale-95 shadow-sm shadow-indigo-200 transition-all\">\n            ✓ Check Answers\n          </button>\n        </div>\n      </div>\n\n    </form>\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-100 bg-white\">\n    Interactive Listening Task • ELT Responsive Micro-App\n  </footer>\n\n  <!-- SCRIPT LOGIC & ANALYTICS -->\n  <script>\n    // Mandatory Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Listening',\n      skill: 'listening_comprehension_neighbours',\n      maxScore: 5\n    };\n\n    function normalizeText(text) {\n      return text\n        .toLowerCase()\n        .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g, \"\")\n        .replace(/\\s+/g, \" \")\n        .trim();\n    }\n\n    function checkAnswers() {\n      const inputs = document.querySelectorAll('#quizForm input[type=\"text\"]');\n      let correctCount = 0;\n\n      inputs.forEach(input => {\n        const userVal = normalizeText(input.value);\n        const expectedVal = normalizeText(input.getAttribute('data-answer'));\n        \n        // Find wrapper parent container for styling\n        const container = input.closest('div.bg-white');\n        const hint = container.querySelector('.correct-hint');\n        \n        // Remove prior status classes\n        input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n        \n        if (userVal === expectedVal && userVal !== \"\") {\n          correctCount++;\n          input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-medium');\n          if (hint) hint.classList.add('hidden');\n        } else {\n          input.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900', 'font-medium');\n          if (hint) hint.classList.remove('hidden');\n        }\n      });\n\n      // Show score banner\n      const scoreDisplay = document.getElementById('scoreDisplay');\n      const scoreVal = document.getElementById('scoreVal');\n      scoreVal.textContent = correctCount;\n      scoreDisplay.classList.remove('hidden');\n\n      // Unlock Transcript (Rule: Transcript locked until checked)\n      const transcriptWrapper = document.getElementById('transcriptWrapper');\n      const transcriptLockBadge = document.getElementById('transcriptLockBadge');\n      const transcriptStatusTitle = document.getElementById('transcriptStatusTitle');\n\n      transcriptWrapper.classList.remove('opacity-40', 'pointer-events-none', 'select-none');\n      transcriptLockBadge.className = \"text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-medium flex items-center gap-1\";\n      transcriptLockBadge.innerHTML = '<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" /></svg> Unlocked';\n\n      // Dispatch Custom Event for live analytics\n      window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n        detail: {\n          metrics: window.ACTIVITY_METRICS,\n          score: correctCount,\n          total: inputs.length,\n          completed: correctCount === inputs.length\n        }\n      }));\n\n      // Post message to parent container if embedded in iframe\n      if (window.parent !== window) {\n        window.parent.postMessage({ \n          type: 'ACTIVITY_SCORE', \n          score: correctCount, \n          total: inputs.length,\n          completed: correctCount === inputs.length\n        }, '*');\n      }\n    }\n\n    function resetActivity() {\n      const inputs = document.querySelectorAll('#quizForm input[type=\"text\"]');\n      inputs.forEach(input => {\n        input.value = '';\n        input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900', 'font-medium');\n        const container = input.closest('div.bg-white');\n        const hint = container.querySelector('.correct-hint');\n        if (hint) hint.classList.add('hidden');\n      });\n\n      // Hide score banner\n      document.getElementById('scoreDisplay').classList.add('hidden');\n\n      // Lock transcript again\n      const transcriptWrapper = document.getElementById('transcriptWrapper');\n      const transcriptLockBadge = document.getElementById('transcriptLockBadge');\n      \n      transcriptWrapper.classList.add('opacity-40', 'pointer-events-none', 'select-none');\n      transcriptLockBadge.className = \"text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-medium flex items-center gap-1\";\n      transcriptLockBadge.innerHTML = '<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\" /></svg> Check answers to unlock';\n    }\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793469732783,
      "title": "Neighbourhood Problems - Quantifiers Writing Practice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Neighbourhood Problems - Quantifiers Writing Practice</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n    body {\n      font-family: 'Inter', sans-serif;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between\">\n\n  <!-- Sticky Header & Audio/Context Bar -->\n  <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n    <div class=\"max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3\">\n      <div class=\"flex items-center gap-2.5\">\n        <span class=\"bg-indigo-600 text-white font-bold text-sm w-8 h-8 rounded-xl flex items-center justify-center shadow-sm\">9a</span>\n        <div>\n          <h1 class=\"text-base font-bold text-slate-900 leading-tight\">My Neighbourhood Problems</h1>\n          <p class=\"text-xs text-slate-500\">Write sentences using <span class=\"font-semibold text-indigo-600\">too much, too many, (not) enough</span>.</p>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <div id=\"score-badge\" class=\"bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold px-3 py-1.5 rounded-xl\">\n          Sentences Written: <span id=\"written-count\">0</span> / 8\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"w-full max-w-4xl mx-auto p-4 sm:p-6 md:p-8 flex-grow\">\n    \n    <!-- Instructions & Reference Box -->\n    <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 mb-6\">\n      <div class=\"flex items-start gap-3 mb-4\">\n        <div class=\"p-2 bg-amber-100 text-amber-700 rounded-xl mt-0.5\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n          </svg>\n        </div>\n        <div>\n          <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-500 mb-1\">Task Instructions</h2>\n          <p class=\"text-slate-700 text-sm sm:text-base leading-relaxed\">\n            Think about the problems in your neighbourhood. Write 8 personal sentences using <strong class=\"text-indigo-600\">too much</strong>, <strong class=\"text-indigo-600\">too many</strong>, or <strong class=\"text-indigo-600\">(not) enough</strong>. Use your own ideas or choose from the vocabulary cloud below. Be ready to discuss them in groups!\n          </p>\n        </div>\n      </div>\n\n      <!-- Examples Bar -->\n      <div class=\"bg-slate-50 border border-slate-200/80 rounded-xl p-3.5 mb-5 text-xs sm:text-sm text-slate-600\">\n        <span class=\"font-bold text-slate-700 block mb-1\">Examples:</span>\n        <ul class=\"space-y-1 italic text-slate-600\">\n          <li>• \"There's <strong>too much</strong> traffic on my street during rush hour.\"</li>\n          <li>• \"There <strong>aren't enough</strong> cinemas or theatres near my house.\"</li>\n        </ul>\n      </div>\n\n      <!-- Vocabulary Help Box (Collapsible / Interactive Tags) -->\n      <div>\n        <span class=\"block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2\">Vocabulary Inspiration (Click to copy into your sentence):</span>\n        <div class=\"flex flex-wrap gap-1.5\" id=\"vocab-chips\">\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">traffic</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">cinemas</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">places for children to play</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">places to park</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">noise at night</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">trains</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">buses</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">pollution</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">rubbish</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">dogs</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">late-night bars</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">good schools</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">parks</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">sports centres</button>\n          <button type=\"button\" class=\"vocab-chip bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg transition-colors font-medium cursor-pointer\">police</button>\n        </div>\n      </div>\n    </section>\n\n    <!-- Interactive Writing Form (8 Sentences) -->\n    <section class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 mb-6\">\n      <div class=\"flex justify-between items-center mb-4\">\n        <h3 class=\"text-sm font-bold uppercase tracking-wider text-slate-500\">Your Sentences</h3>\n        <span class=\"text-xs text-slate-400\">Click any input box to start writing</span>\n      </div>\n\n      <div class=\"space-y-3.5\" id=\"sentences-container\">\n        <!-- Sentence 1 -->\n        <div class=\"flex items-center gap-3 bg-slate-50/50 p-2.5 rounded-xl border border-slate-200/60 hover:border-indigo-200 transition-all\">\n          <span class=\"flex-shrink-0 w-7 h-7 bg-slate-200 text-slate-700 font-bold text-xs rounded-lg flex items-center justify-center\">1</span>\n          <input type=\"text\" data-answer=\"personal\" class=\"sentence-input w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\" placeholder=\"e.g., There is too much traffic in my street...\">\n        </div>\n        <!-- Sentence 2 -->\n        <div class=\"flex items-center gap-3 bg-slate-50/50 p-2.5 rounded-xl border border-slate-200/60 hover:border-indigo-200 transition-all\">\n          <span class=\"flex-shrink-0 w-7 h-7 bg-slate-200 text-slate-700 font-bold text-xs rounded-lg flex items-center justify-center\">2</span>\n          <input type=\"text\" data-answer=\"personal\" class=\"sentence-input w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\" placeholder=\"Write your second sentence...\">\n        </div>\n        <!-- Sentence 3 -->\n        <div class=\"flex items-center gap-3 bg-slate-50/50 p-2.5 rounded-xl border border-slate-200/60 hover:border-indigo-200 transition-all\">\n          <span class=\"flex-shrink-0 w-7 h-7 bg-slate-200 text-slate-700 font-bold text-xs rounded-lg flex items-center justify-center\">3</span>\n          <input type=\"text\" data-answer=\"personal\" class=\"sentence-input w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\" placeholder=\"Write your third sentence...\">\n        </div>\n        <!-- Sentence 4 -->\n        <div class=\"flex items-center gap-3 bg-slate-50/50 p-2.5 rounded-xl border border-slate-200/60 hover:border-indigo-200 transition-all\">\n          <span class=\"flex-shrink-0 w-7 h-7 bg-slate-200 text-slate-700 font-bold text-xs rounded-lg flex items-center justify-center\">4</span>\n          <input type=\"text\" data-answer=\"personal\" class=\"sentence-input w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\" placeholder=\"Write your fourth sentence...\">\n        </div>\n        <!-- Sentence 5 -->\n        <div class=\"flex items-center gap-3 bg-slate-50/50 p-2.5 rounded-xl border border-slate-200/60 hover:border-indigo-200 transition-all\">\n          <span class=\"flex-shrink-0 w-7 h-7 bg-slate-200 text-slate-700 font-bold text-xs rounded-lg flex items-center justify-center\">5</span>\n          <input type=\"text\" data-answer=\"personal\" class=\"sentence-input w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\" placeholder=\"Write your fifth sentence...\">\n        </div>\n        <!-- Sentence 6 -->\n        <div class=\"flex items-center gap-3 bg-slate-50/50 p-2.5 rounded-xl border border-slate-200/60 hover:border-indigo-200 transition-all\">\n          <span class=\"flex-shrink-0 w-7 h-7 bg-slate-200 text-slate-700 font-bold text-xs rounded-lg flex items-center justify-center\">6</span>\n          <input type=\"text\" data-answer=\"personal\" class=\"sentence-input w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\" placeholder=\"Write your sixth sentence...\">\n        </div>\n        <!-- Sentence 7 -->\n        <div class=\"flex items-center gap-3 bg-slate-50/50 p-2.5 rounded-xl border border-slate-200/60 hover:border-indigo-200 transition-all\">\n          <span class=\"flex-shrink-0 w-7 h-7 bg-slate-200 text-slate-700 font-bold text-xs rounded-lg flex items-center justify-center\">7</span>\n          <input type=\"text\" data-answer=\"personal\" class=\"sentence-input w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\" placeholder=\"Write your seventh sentence...\">\n        </div>\n        <!-- Sentence 8 -->\n        <div class=\"flex items-center gap-3 bg-slate-50/50 p-2.5 rounded-xl border border-slate-200/60 hover:border-indigo-200 transition-all\">\n          <span class=\"flex-shrink-0 w-7 h-7 bg-slate-200 text-slate-700 font-bold text-xs rounded-lg flex items-center justify-center\">8</span>\n          <input type=\"text\" data-answer=\"personal\" class=\"sentence-input w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\" placeholder=\"Write your eighth sentence...\">\n        </div>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"flex flex-wrap gap-3 mt-6 pt-4 border-t border-slate-100\">\n        <button id=\"check-btn\" type=\"button\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 px-5 rounded-xl shadow-sm transition-all flex items-center gap-2 cursor-pointer\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n          </svg>\n          Save & Review Sentences\n        </button>\n        <button id=\"reset-btn\" type=\"button\" class=\"bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm py-2.5 px-5 rounded-xl transition-all flex items-center gap-2 cursor-pointer\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n          </svg>\n          Reset\n        </button>\n      </div>\n    </section>\n\n    <!-- Group Discussion Prompts (Part b) -->\n    <section class=\"bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5 sm:p-6\">\n      <div class=\"flex items-start gap-3\">\n        <div class=\"p-2 bg-indigo-600 text-white rounded-xl mt-0.5 shadow-sm\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\" />\n          </svg>\n        </div>\n        <div>\n          <h3 class=\"text-sm font-bold uppercase tracking-wider text-indigo-900 mb-1\">b) Group Discussion Task</h3>\n          <p class=\"text-slate-700 text-sm sm:text-base leading-relaxed mb-3\">\n            Compare your ideas with your classmates. Discuss the following questions:\n          </p>\n          <ul class=\"space-y-2 text-sm text-slate-700 list-disc list-inside\">\n            <li>How many of your ideas are the same as your classmates'?</li>\n            <li>What do you think are the <strong>three biggest problems</strong> in your neighbourhood overall?</li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"w-full text-center py-4 text-xs text-slate-400 border-t border-slate-100 mt-8\">\n    ELT Interactive Writing Activity • Quantifiers: Too much, Too many, (Not) enough\n  </footer>\n\n  <!-- Script and Metrics Controller -->\n  <script>\n    // Mandatory Pedagogical Metrics Contract\n    window.ACTIVITY_METRICS = {\n      domain: 'Vocabulary',\n      skill: 'writing_quantifiers_neighbourhood',\n      maxScore: 8\n    };\n\n    document.addEventListener('DOMContentLoaded', () => {\n      const inputs = document.querySelectorAll('.sentence-input');\n      const writtenCountSpan = document.getElementById('written-count');\n      const checkBtn = document.getElementById('check-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const vocabChips = document.querySelectorAll('.vocab-chip');\n      \n      let activeInput = inputs[0]; // Default active input for vocabulary chips\n\n      // Track last focused input\n      inputs.forEach(input => {\n        input.addEventListener('focus', () => {\n          activeInput = input;\n        });\n        \n        input.addEventListener('input', updateProgress);\n      });\n\n      // Vocabulary chip click helper\n      vocabChips.forEach(chip => {\n        chip.addEventListener('click', () => {\n          if (activeInput) {\n            const word = chip.textContent;\n            if (activeInput.value.length > 0 && !activeInput.value.endsWith(' ')) {\n              activeInput.value += ' ';\n            }\n            activeInput.value += word + ' ';\n            activeInput.focus();\n            updateProgress();\n          }\n        });\n      });\n\n      function updateProgress() {\n        let count = 0;\n        inputs.forEach(input => {\n          if (input.value.trim().length > 3) {\n            count++;\n          }\n        });\n        writtenCountSpan.textContent = count;\n      }\n\n      // Check Answers Button\n      checkBtn.addEventListener('click', () => {\n        let correctCount = 0;\n        \n        inputs.forEach(input => {\n          const val = input.value.trim();\n          // Since these are creative personal sentences, any reasonable sentence > 5 characters containing some text is accepted as complete and valid.\n          if (val.length >= 5) {\n            input.classList.remove('border-slate-200', 'border-red-500', 'bg-red-50');\n            input.classList.add('border-emerald-500', 'bg-emerald-50/30');\n            correctCount++;\n          } else if (val.length > 0) {\n            input.classList.remove('border-slate-200', 'border-emerald-500', 'bg-emerald-50/30');\n            input.classList.add('border-red-500', 'bg-red-50');\n          } else {\n            input.classList.remove('border-emerald-500', 'bg-emerald-50/30', 'border-red-500', 'bg-red-50');\n            input.classList.add('border-slate-200');\n          }\n        });\n\n        updateProgress();\n\n        // Dispatch Custom Analytics Event\n        window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n          detail: {\n            metrics: window.ACTIVITY_METRICS,\n            score: correctCount,\n            total: inputs.length,\n            completed: correctCount === inputs.length\n          }\n        }));\n\n        // Post message to parent container if embedded in iframe\n        if (window.parent !== window) {\n          window.parent.postMessage({ \n            type: 'ACTIVITY_SCORE', \n            score: correctCount, \n            total: inputs.length \n          }, '*');\n        }\n      });\n\n      // Reset Button\n      resetBtn.addEventListener('click', () => {\n        inputs.forEach(input => {\n          input.value = '';\n          input.classList.remove('border-emerald-500', 'bg-emerald-50/30', 'border-red-500', 'bg-red-50');\n          input.classList.add('border-slate-200');\n        });\n        updateProgress();\n      });\n    });\n  </script>\n</body>\n</html>"
    },
    {
      "id": 1793469815488,
      "title": "Improve Your Town/City Activity",
      "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"h-full\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Improve Your Town/City Activity</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 6px;\n            height: 6px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: #f1f5f9;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: #cbd5e1;\n            border-radius: 9999px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n            background: #94a3b8;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 h-full flex flex-col antialiased selection:bg-indigo-100 selection:text-indigo-800\">\n\n    <!-- MAIN CONTAINER (W-full max-w-4xlmx-auto, strictly compliant) -->\n    <main class=\"w-full max-w-4xl mx-auto flex-grow p-4 sm:p-6 md:p-8 flex flex-col justify-between\">\n        \n        <!-- CARD WRAPPER -->\n        <div class=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col flex-grow\">\n            \n            <!-- HEADER SECTION -->\n            <header class=\"bg-gradient-to-r from-indigo-800 to-indigo-900 text-white p-5 sm:p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-indigo-700/50\">\n                <div class=\"flex items-center gap-3\">\n                    <div class=\"bg-indigo-600 text-white w-10 h-10 rounded-xl flex items-center justify-center font-bold text-lg shadow-inner shrink-0\">\n                        10\n                    </div>\n                    <div>\n                        <span class=\"text-xs font-semibold uppercase tracking-wider text-indigo-200 bg-indigo-700/60 px-2.5 py-1 rounded-md inline-block mb-1\">Speaking & Writing</span>\n                        <h1 class=\"text-xl sm:text-2xl font-bold tracking-tight\">Improving Your Town or City</h1>\n                    </div>\n                </div>\n\n                <!-- Live Score Badge -->\n                <div class=\"bg-indigo-950/60 backdrop-blur-md px-4 py-2 rounded-xl border border-indigo-700/50 flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-start\">\n                    <span class=\"text-sm font-medium text-indigo-200\">Score:</span>\n                    <span id=\"score-display\" class=\"font-bold text-lg text-emerald-400 bg-emerald-950/60 px-3 py-0.5 rounded-lg border border-emerald-500/30\">0 / 5</span>\n                </div>\n            </header>\n\n            <!-- CONTENT BODY -->\n            <div class=\"p-4 sm:p-6 md:p-8 space-y-8 flex-grow\">\n\n                <!-- TASK A -->\n                <section class=\"bg-slate-50/80 border border-slate-200/80 rounded-2xl p-5 sm:p-6 transition-all hover:border-slate-300\">\n                    <div class=\"flex items-start gap-3 mb-4\">\n                        <span class=\"bg-indigo-100 text-indigo-700 font-bold px-2.5 py-1 rounded-lg text-sm shrink-0\">a)</span>\n                        <div>\n                            <h2 class=\"text-base sm:text-lg font-semibold text-slate-900\">\n                                Make a list of five things you would like to do to improve your town/city (or the town/city you're studying in).\n                            </h2>\n                            <p class=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n                                Examples: <span class=\"italic font-medium text-slate-600\">improve public transport</span>, <span class=\"italic font-medium text-slate-600\">build a new cinema</span>.\n                            </p>\n                        </div>\n                    </div>\n\n                    <!-- Interactive Inputs List -->\n                    <div class=\"space-y-3 mt-4\" id=\"task-a-inputs\">\n                        <div class=\"flex items-center gap-2\">\n                            <span class=\"bg-slate-200 text-slate-700 font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0\">1</span>\n                            <input type=\"text\" data-answer=\"improve public transport\" placeholder=\"e.g. improve public transport\" \n                                class=\"w-full bg-white border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 placeholder-slate-400 transition-all outline-none\">\n                        </div>\n                        <div class=\"flex items-center gap-2\">\n                            <span class=\"bg-slate-200 text-slate-700 font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0\">2</span>\n                            <input type=\"text\" data-answer=\"build a new cinema\" placeholder=\"e.g. build a new cinema\" \n                                class=\"w-full bg-white border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 placeholder-slate-400 transition-all outline-none\">\n                        </div>\n                        <div class=\"flex items-center gap-2\">\n                            <span class=\"bg-slate-200 text-slate-700 font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0\">3</span>\n                            <input type=\"text\" data-answer=\"plant more trees\" placeholder=\"e.g. plant more trees, create bike lanes...\" \n                                class=\"w-full bg-white border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 placeholder-slate-400 transition-all outline-none\">\n                        </div>\n                        <div class=\"flex items-center gap-2\">\n                            <span class=\"bg-slate-200 text-slate-700 font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0\">4</span>\n                            <input type=\"text\" data-answer=\"open a new park\" placeholder=\"e.g. open a new park, clean the streets...\" \n                                class=\"w-full bg-white border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 placeholder-slate-400 transition-all outline-none\">\n                        </div>\n                        <div class=\"flex items-center gap-2\">\n                            <span class=\"bg-slate-200 text-slate-700 font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0\">5</span>\n                            <input type=\"text\" data-answer=\"build a new sports center\" placeholder=\"e.g. build a new sports center, lower taxes...\" \n                                class=\"w-full bg-white border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 rounded-xl px-4 py-2.5 text-sm sm:text-base text-slate-800 placeholder-slate-400 transition-all outline-none\">\n                        </div>\n                    </div>\n                </section>\n\n                <!-- TASK B & C: CONVERSATIONAL MODEL (Patron A styling) -->\n                <section class=\"bg-gradient-to-br from-slate-50 to-indigo-50/30 border border-slate-200/80 rounded-2xl p-5 sm:p-6\">\n                    <div class=\"flex items-start gap-3 mb-4\">\n                        <span class=\"bg-sky-100 text-sky-700 font-bold px-2.5 py-1 rounded-lg text-sm shrink-0\">b & c</span>\n                        <div>\n                            <h2 class=\"text-base sm:text-lg font-semibold text-slate-900\">\n                                Work in pairs & groups. Explain why you chose your items and agree on a final list.\n                            </h2>\n                            <p class=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n                                Review the conversation model below:\n                            </p>\n                        </div>\n                    </div>\n\n                    <!-- Speech bubbles dialogue box -->\n                    <div class=\"space-y-4 my-6 bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-sm\">\n                        <!-- Speaker 1 -->\n                        <div class=\"flex items-start gap-3\">\n                            <div class=\"bg-sky-100 text-sky-800 text-xs font-bold px-2.5 py-1.5 rounded-lg shrink-0 mt-1\">Person A</div>\n                            <div class=\"bg-sky-50 border border-sky-100 rounded-2xl p-3.5 text-sm sm:text-base text-slate-700 shadow-sm relative w-full\">\n                                I'd like to improve public transport because there are too many cars.\n                            </div>\n                        </div>\n\n                        <!-- Speaker 2 -->\n                        <div class=\"flex items-start gap-3 justify-end\">\n                            <div class=\"bg-emerald-50 border border-emerald-100 rounded-2xl p-3.5 text-sm sm:text-base text-slate-700 shadow-sm relative w-full text-right sm:text-left\">\n                                Yes, that's a good idea. I've got that on my list too.\n                            </div>\n                            <div class=\"bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1.5 rounded-lg shrink-0 mt-1\">Person B</div>\n                        </div>\n                    </div>\n\n                    <div class=\"bg-amber-50 border border-amber-200/80 rounded-xl p-4 flex items-start gap-3\">\n                        <svg class=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                        </svg>\n                        <p class=\"text-xs sm:text-sm text-amber-900\">\n                            <strong class=\"font-semibold\">Discussion prompt:</strong> Agree on a final list of five things with your classmates. Which is the most important improvement, do you think?\n                        </p>\n                    </div>\n                </section>\n\n            </div>\n\n            <!-- FOOTER ACTION BAR -->\n            <footer class=\"bg-slate-100 border-t border-slate-200 p-4 sm:p-6 flex flex-wrap items-center justify-between gap-4\">\n                <button id=\"reset-btn\" class=\"w-full sm:w-auto px-5 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold rounded-xl text-sm transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    Reset Activity\n                </button>\n\n                <button id=\"check-btn\" class=\"w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-sm transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    Check Answers\n                </button>\n            </footer>\n\n        </div>\n\n    </main>\n\n    <!-- SCRIPT LOGIC & PEDAGOGICAL METRICS CONTRACT -->\n    <script>\n        // Mandatory Pedagogical Metrics Contract\n        window.ACTIVITY_METRICS = {\n            domain: 'Vocabulary',\n            skill: 'town_city_improvements',\n            maxScore: 5\n        };\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const scoreDisplay = document.getElementById('score-display');\n            const inputs = document.querySelectorAll('#task-a-inputs input');\n\n            // Helper to clean and normalize text inputs for flexible evaluation\n            function normalize(text) {\n                return text.trim().toLowerCase().replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g,\"\").replace(/\\s{2,}/g,\" \");\n            }\n\n            checkBtn.addEventListener('click', () => {\n                let correctCount = 0;\n\n                inputs.forEach(input => {\n                    const expected = normalize(input.getAttribute('data-answer'));\n                    const userVal = normalize(input.value);\n\n                    // Remove existing validation styling classes\n                    input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n                    if (userVal !== \"\" && userVal === expected) {\n                        correctCount++;\n                        input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-medium');\n                    } else {\n                        input.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n                    }\n                });\n\n                // Update UI Score\n                scoreDisplay.textContent = `${correctCount} / ${inputs.length}`;\n\n                // Dispatch global events for parent frames / host systems\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: correctCount,\n                        total: inputs.length,\n                        completed: correctCount === inputs.length\n                    }\n                }));\n\n                try {\n                    window.parent.postMessage({ \n                        type: 'ACTIVITY_SCORE', \n                        score: correctCount, \n                        total: inputs.length,\n                        metrics: window.ACTIVITY_METRICS\n                    }, '*');\n                } catch (e) {\n                    console.log('PostMessage not available or blocked');\n                }\n            });\n\n            resetBtn.addEventListener('click', () => {\n                inputs.forEach(input => {\n                    input.value = '';\n                    input.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900', 'font-medium');\n                });\n                scoreDisplay.textContent = `0 / ${inputs.length}`;\n\n                window.dispatchEvent(new CustomEvent('ELT_ACTIVITY_UPDATE', {\n                    detail: {\n                        metrics: window.ACTIVITY_METRICS,\n                        score: 0,\n                        total: inputs.length,\n                        completed: false\n                    }\n                }));\n            });\n        });\n    </script>\n</body>\n</html>"
    }
  ]
}