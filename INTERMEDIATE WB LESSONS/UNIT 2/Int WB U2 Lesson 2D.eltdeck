{
  "version": "2.0",
  "title": "Int WB U2 Lesson 2D",
  "updatedAt": "2026-10-28T18:35:09.483Z",
  "slides": [
    {
      "id": 1793212144159,
      "title": "Showing concern, giving and responding to advice",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Showing concern, giving and responding to advice</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        .option-btn { transition: all 0.2s ease; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col\">\n\n    <!-- STICKY HEADER / SCORE COUNTER -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b w-full shadow-sm flex items-center justify-between\">\n        <div class=\"flex items-center gap-2\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z\" />\n            </svg>\n            <h1 class=\"font-bold text-sm md:text-base text-slate-900 truncate\">Showing concern & responses</h1>\n        </div>\n        <div class=\"flex items-center gap-3\">\n            <div id=\"score-display\" class=\"text-xs md:text-sm font-semibold bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full border border-indigo-100\">\n                Score: <span id=\"current-score\">0</span>/<span id=\"total-score\">5</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-2xl mx-auto p-4 md:p-6 flex-1 flex flex-col gap-6\">\n\n        <!-- INTRO / REFERENCE SECTION -->\n        <section class=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-100\">\n            <div class=\"flex items-center gap-2 mb-3 text-indigo-600\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                </svg>\n                <h2 class=\"font-bold text-slate-800 text-sm md:text-base\">Reference Guide</h2>\n            </div>\n            <p class=\"text-xs md:text-sm text-slate-600 leading-relaxed mb-3\">\n                Read the situations below and choose the most appropriate empathetic response or expression of concern.\n            </p>\n        </section>\n\n        <!-- INTERACTIVE EXERCISE -->\n        <section class=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-6\">\n            <div class=\"border-b pb-3 flex items-center justify-between\">\n                <h2 class=\"font-bold text-slate-900 text-sm md:text-base flex items-center gap-2\">\n                    <span class=\"bg-indigo-600 text-white w-6 h-6 rounded-full inline-flex items-center justify-center text-xs\">1</span>\n                    Choose the best response for each sentence.\n                </h2>\n                <span class=\"text-xs text-slate-400 font-medium\">RW2.1</span>\n            </div>\n\n            <div id=\"questions-container\" class=\"flex flex-col gap-6\">\n                <!-- Question 1 -->\n                <div class=\"question-item flex flex-col gap-3\" data-qid=\"1\" data-answer=\"a\">\n                    <p class=\"text-sm md:text-base font-medium text-slate-800\">\n                        <span class=\"font-bold text-indigo-600 mr-1\">1.</span> Clare’s had terrible insomnia.\n                    </p>\n                    <div class=\"flex flex-col gap-2 pl-4\">\n                        <button type=\"button\" data-option=\"a\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">a</span>\n                            <span>Oh, dear. What’s the matter?</span>\n                        </button>\n                        <button type=\"button\" data-option=\"b\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">b</span>\n                            <span>Yes, I see what you mean.</span>\n                        </button>\n                        <button type=\"button\" data-option=\"c\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">c</span>\n                            <span>I can see why you’re upset.</span>\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Question 2 -->\n                <div class=\"question-item flex flex-col gap-3\" data-qid=\"2\" data-answer=\"c\">\n                    <p class=\"text-sm md:text-base font-medium text-slate-800\">\n                        <span class=\"font-bold text-indigo-600 mr-1\">2.</span> Look at Mike’s report. It’s terrible!\n                    </p>\n                    <div class=\"flex flex-col gap-2 pl-4\">\n                        <button type=\"button\" data-option=\"a\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">a</span>\n                            <span>Oh, how awful!</span>\n                        </button>\n                        <button type=\"button\" data-option=\"b\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">b</span>\n                            <span>Oh, dear. What a shame.</span>\n                        </button>\n                        <button type=\"button\" data-option=\"c\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">c</span>\n                            <span>Yes, I see what you mean.</span>\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Question 3 -->\n                <div class=\"question-item flex flex-col gap-3\" data-qid=\"3\" data-answer=\"b\">\n                    <p class=\"text-sm md:text-base font-medium text-slate-800\">\n                        <span class=\"font-bold text-indigo-600 mr-1\">3.</span> Mo’s in hospital with a broken leg.\n                    </p>\n                    <div class=\"flex flex-col gap-2 pl-4\">\n                        <button type=\"button\" data-option=\"a\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">a</span>\n                            <span>Yes, I see what you mean.</span>\n                        </button>\n                        <button type=\"button\" data-option=\"b\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">b</span>\n                            <span>Oh, how awful!</span>\n                        </button>\n                        <button type=\"button\" data-option=\"c\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">c</span>\n                            <span>Oh, dear. What’s the matter?</span>\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Question 4 -->\n                <div class=\"question-item flex flex-col gap-3\" data-qid=\"4\" data-answer=\"b\">\n                    <p class=\"text-sm md:text-base font-medium text-slate-800\">\n                        <span class=\"font-bold text-indigo-600 mr-1\">4.</span> We started at the company at the same time, but he’s been promoted.\n                    </p>\n                    <div class=\"flex flex-col gap-2 pl-4\">\n                        <button type=\"button\" data-option=\"a\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">a</span>\n                            <span>Oh, dear. What a shame.</span>\n                        </button>\n                        <button type=\"button\" data-option=\"b\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">b</span>\n                            <span>I can see why you’re upset.</span>\n                        </button>\n                        <button type=\"button\" data-option=\"c\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">c</span>\n                            <span>Oh, how awful.</span>\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Question 5 -->\n                <div class=\"question-item flex flex-col gap-3\" data-qid=\"5\" data-answer=\"a\">\n                    <p class=\"text-sm md:text-base font-medium text-slate-800\">\n                        <span class=\"font-bold text-indigo-600 mr-1\">5.</span> Sally lost her job last week.\n                    </p>\n                    <div class=\"flex flex-col gap-2 pl-4\">\n                        <button type=\"button\" data-option=\"a\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">a</span>\n                            <span>Oh, I’m sorry to hear that.</span>\n                        </button>\n                        <button type=\"button\" data-option=\"b\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">b</span>\n                            <span>I can see why you’re upset.</span>\n                        </button>\n                        <button type=\"button\" data-option=\"c\" class=\"option-btn text-left text-sm md:text-base p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 flex items-center gap-3 min-h-[42px]\">\n                            <span class=\"w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500 shrink-0\">c</span>\n                            <span>Yes, I see what you mean.</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ACTION BUTTONS -->\n            <div class=\"flex flex-col sm:flex-row gap-3 pt-4 border-t\">\n                <button id=\"check-btn\" class=\"w-full sm:flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-6 rounded-xl shadow-sm transition-all min-h-[42px] flex items-center justify-center gap-2\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                    Check Answers\n                </button>\n                <button id=\"reset-btn\" class=\"w-full sm:w-auto bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium py-3 px-6 rounded-xl transition-all min-h-[42px] flex items-center justify-center gap-2\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n                    </svg>\n                    Reset\n                </button>\n            </div>\n        </section>\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"text-center py-6 text-xs text-slate-400\">\n        Interactive ELT Learning Module • Responsive Design\n    </footer>\n\n    <!-- INTERACTION LOGIC -->\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const questionItems = document.querySelectorAll('.question-item');\n            const checkBtn = document.getElementById('check-btn');\n            const resetBtn = document.getElementById('reset-btn');\n            const currentScoreEl = document.getElementById('current-score');\n            const totalScoreEl = document.getElementById('total-score');\n\n            const totalQuestions = questionItems.length;\n            totalScoreEl.textContent = totalQuestions;\n\n            // Handle option selection\n            questionItems.forEach(item => {\n                const buttons = item.querySelectorAll('.option-btn');\n                buttons.forEach(btn => {\n                    btn.addEventListener('click', () => {\n                        // If already checked, don't allow changing unless reset\n                        if (checkBtn.dataset.checked === 'true') return;\n\n                        buttons.forEach(b => {\n                            b.classList.remove('border-indigo-600', 'bg-indigo-50', 'text-indigo-900', 'font-semibold');\n                            b.classList.add('border-slate-200');\n                        });\n                        btn.classList.remove('border-slate-200');\n                        btn.classList.add('border-indigo-600', 'bg-indigo-50', 'text-indigo-900', 'font-semibold');\n                        item.dataset.selected = btn.dataset.option;\n                    });\n                });\n            });\n\n            // Check Answers\n            checkBtn.addEventListener('click', () => {\n                let correctCount = 0;\n                checkBtn.dataset.checked = 'true';\n\n                questionItems.forEach(item => {\n                    const correctAnswer = item.dataset.answer;\n                    const selectedAnswer = item.dataset.selected;\n                    const buttons = item.querySelectorAll('.option-btn');\n\n                    buttons.forEach(btn => {\n                        const opt = btn.dataset.option;\n                        btn.disabled = true;\n                        \n                        if (opt === correctAnswer) {\n                            btn.classList.remove('border-slate-200', 'hover:border-indigo-300', 'hover:bg-indigo-50/50');\n                            btn.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-semibold');\n                        } else if (opt === selectedAnswer && selectedAnswer !== correctAnswer) {\n                            btn.classList.remove('border-slate-200', 'hover:border-indigo-300', 'hover:bg-indigo-50/50');\n                            btn.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n                        }\n                    });\n\n                    if (selectedAnswer === correctAnswer) {\n                        correctCount++;\n                    }\n                });\n\n                currentScoreEl.textContent = correctCount;\n\n                // Send score to parent window if inside iframe\n                try {\n                    window.parent.postMessage({\n                        type: 'ACTIVITY_SCORE',\n                        score: correctCount,\n                        total: totalQuestions\n                    }, '*');\n                } catch (e) {\n                    console.log('PostMessage not available');\n                }\n            });\n\n            // Reset Activity\n            resetBtn.addEventListener('click', () => {\n                checkBtn.dataset.checked = 'false';\n                currentScoreEl.textContent = '0';\n\n                questionItems.forEach(item => {\n                    delete item.dataset.selected;\n                    const buttons = item.querySelectorAll('.option-btn');\n                    buttons.forEach(btn => {\n                        btn.disabled = false;\n                        btn.classList.remove(\n                            'border-indigo-600', 'bg-indigo-50', 'text-indigo-900', 'font-semibold',\n                            'border-emerald-500', 'bg-emerald-50', 'text-emerald-900',\n                            'border-rose-500', 'bg-rose-50', 'text-rose-900'\n                        );\n                        btn.classList.add('border-slate-200');\n                    });\n                });\n            });\n        });\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793212262295,
      "title": "Match Problems and Advice - ELT Interactive Exercise",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Match Problems and Advice - ELT Interactive Exercise</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            -webkit-tap-highlight-color: transparent;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased\">\n\n    <!-- STICKY TOP HEADER / CONTROLS -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur z-20 py-3 px-4 border-b border-slate-200 w-full shadow-sm\">\n        <div class=\"max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"bg-indigo-100 p-2 rounded-xl text-indigo-600\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z\" />\n                    </svg>\n                </div>\n                <div>\n                    <h1 class=\"text-base font-bold text-slate-900 leading-tight\">Problem & Advice Matching</h1>\n                    <p class=\"text-xs text-slate-500\">Match problems 1–5 to the correct advice a–e.</p>\n                </div>\n            </div>\n\n            <!-- Score Badge & Actions -->\n            <div class=\"flex items-center gap-2 w-full sm:w-auto justify-end\">\n                <div id=\"score-badge\" class=\"hidden bg-indigo-50 border border-indigo-200 text-indigo-700 px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5\">\n                    <span>Score:</span>\n                    <span id=\"score-display\" class=\"font-bold text-sm\">0/5</span>\n                </div>\n                <button id=\"reset-btn\" onclick=\"resetActivity()\" class=\"px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 rounded-xl transition-all min-h-[42px] flex items-center justify-center\">\n                    Reset\n                </button>\n                <button id=\"check-btn\" onclick=\"checkAnswers()\" class=\"px-5 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 rounded-xl shadow-sm transition-all min-h-[42px] flex items-center justify-center\">\n                    Check Answers\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-3xl mx-auto p-4 md:p-6 flex-grow space-y-6\">\n\n        <!-- INSTRUCTIONS CARD -->\n        <section class=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80\">\n            <div class=\"flex items-start gap-3\">\n                <span class=\"flex-shrink-0 bg-indigo-600 text-white font-bold text-sm w-7 h-7 rounded-lg flex items-center justify-center\">2</span>\n                <div class=\"space-y-1\">\n                    <h2 class=\"font-semibold text-slate-900 text-base\">Match problems 1–5 to the advice a–e.</h2>\n                    <p class=\"text-sm text-slate-600\">Select the letter of the best advice for each personal problem listed below.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- REFERENCE ADVICE BOX (Options a-e) -->\n        <section class=\"bg-amber-50/60 rounded-2xl p-5 border border-amber-200/80 shadow-sm\">\n            <h3 class=\"text-xs font-bold uppercase tracking-wider text-amber-800 mb-3 flex items-center gap-1.5\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                </svg>\n                Advice Options (a – e)\n            </h3>\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-sm\">\n                <div class=\"bg-white/80 p-3 rounded-xl border border-amber-100 shadow-xs flex gap-2\">\n                    <span class=\"font-bold text-amber-700\">a)</span>\n                    <span class=\"text-slate-700\">You should offer to babysit.</span>\n                </div>\n                <div class=\"bg-white/80 p-3 rounded-xl border border-amber-100 shadow-xs flex gap-2\">\n                    <span class=\"font-bold text-amber-700\">b)</span>\n                    <span class=\"text-slate-700\">Maybe you ought to see the doctor about it.</span>\n                </div>\n                <div class=\"bg-white/80 p-3 rounded-xl border border-amber-100 shadow-xs flex gap-2\">\n                    <span class=\"font-bold text-amber-700\">c)</span>\n                    <span class=\"text-slate-700\">Have you tried giving them a choice of different types?</span>\n                </div>\n                <div class=\"bg-white/80 p-3 rounded-xl border border-amber-100 shadow-xs flex gap-2\">\n                    <span class=\"font-bold text-amber-700\">d)</span>\n                    <span class=\"text-slate-700\">I'd have a chat with him and find out what the problem is.</span>\n                </div>\n                <div class=\"bg-white/80 p-3 rounded-xl border border-amber-100 shadow-xs flex gap-2 sm:col-span-2\">\n                    <span class=\"font-bold text-amber-700\">e)</span>\n                    <span class=\"text-slate-700\">Why don't you send her some flowers?</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- INTERACTIVE PROBLEMS SECTION -->\n        <section class=\"space-y-4\">\n            <h3 class=\"text-xs font-bold uppercase tracking-wider text-slate-500 px-1\">Problems (Select your answer)</h3>\n            \n            <div id=\"problems-container\" class=\"space-y-3\">\n                <!-- Item 1 -->\n                <div class=\"problem-card bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all\" data-id=\"1\">\n                    <div class=\"flex items-start gap-3 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-lg flex items-center justify-center\">1</span>\n                        <p class=\"text-sm font-medium text-slate-800 pt-0.5\">My children don't eat enough vegetables.</p>\n                    </div>\n                    <div class=\"flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100\">\n                        <span class=\"text-xs font-medium text-slate-500 sm:hidden\">Select advice:</span>\n                        <div class=\"relative\">\n                            <select class=\"answer-select w-28 sm:w-24 bg-slate-50 border border-slate-300 text-slate-800 text-sm font-medium rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2.5 min-h-[42px] cursor-pointer\" data-problem=\"1\">\n                                <option value=\"\">—</option>\n                                <option value=\"a\">a</option>\n                                <option value=\"b\">b</option>\n                                <option value=\"c\">c</option>\n                                <option value=\"d\">d</option>\n                                <option value=\"e\">e</option>\n                            </select>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Item 2 -->\n                <div class=\"problem-card bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all\" data-id=\"2\">\n                    <div class=\"flex items-start gap-3 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-lg flex items-center justify-center\">2</span>\n                        <p class=\"text-sm font-medium text-slate-800 pt-0.5\">She's angry that I forgot her birthday.</p>\n                    </div>\n                    <div class=\"flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100\">\n                        <span class=\"text-xs font-medium text-slate-500 sm:hidden\">Select advice:</span>\n                        <div class=\"relative\">\n                            <select class=\"answer-select w-28 sm:w-24 bg-slate-50 border border-slate-300 text-slate-800 text-sm font-medium rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2.5 min-h-[42px] cursor-pointer\" data-problem=\"2\">\n                                <option value=\"\">—</option>\n                                <option value=\"a\">a</option>\n                                <option value=\"b\">b</option>\n                                <option value=\"c\">c</option>\n                                <option value=\"d\">d</option>\n                                <option value=\"e\">e</option>\n                            </select>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Item 3 -->\n                <div class=\"problem-card bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all\" data-id=\"3\">\n                    <div class=\"flex items-start gap-3 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-lg flex items-center justify-center\">3</span>\n                        <p class=\"text-sm font-medium text-slate-800 pt-0.5\">One of my best students doesn't do his homework.</p>\n                    </div>\n                    <div class=\"flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100\">\n                        <span class=\"text-xs font-medium text-slate-500 sm:hidden\">Select advice:</span>\n                        <div class=\"relative\">\n                            <select class=\"answer-select w-28 sm:w-24 bg-slate-50 border border-slate-300 text-slate-800 text-sm font-medium rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2.5 min-h-[42px] cursor-pointer\" data-problem=\"3\">\n                                <option value=\"\">—</option>\n                                <option value=\"a\">a</option>\n                                <option value=\"b\">b</option>\n                                <option value=\"c\">c</option>\n                                <option value=\"d\">d</option>\n                                <option value=\"e\">e</option>\n                            </select>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Item 4 -->\n                <div class=\"problem-card bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all\" data-id=\"4\">\n                    <div class=\"flex items-start gap-3 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-lg flex items-center justify-center\">4</span>\n                        <p class=\"text-sm font-medium text-slate-800 pt-0.5\">I can't sleep! My husband snores so much.</p>\n                    </div>\n                    <div class=\"flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100\">\n                        <span class=\"text-xs font-medium text-slate-500 sm:hidden\">Select advice:</span>\n                        <div class=\"relative\">\n                            <select class=\"answer-select w-28 sm:w-24 bg-slate-50 border border-slate-300 text-slate-800 text-sm font-medium rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2.5 min-h-[42px] cursor-pointer\" data-problem=\"4\">\n                                <option value=\"\">—</option>\n                                <option value=\"a\">a</option>\n                                <option value=\"b\">b</option>\n                                <option value=\"c\">c</option>\n                                <option value=\"d\">d</option>\n                                <option value=\"e\">e</option>\n                            </select>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Item 5 -->\n                <div class=\"problem-card bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all\" data-id=\"5\">\n                    <div class=\"flex items-start gap-3 flex-grow\">\n                        <span class=\"flex-shrink-0 bg-slate-100 text-slate-700 font-bold text-sm w-7 h-7 rounded-lg flex items-center justify-center\">5</span>\n                        <p class=\"text-sm font-medium text-slate-800 pt-0.5\">My sister doesn't go out much because she's got two children.</p>\n                    </div>\n                    <div class=\"flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100\">\n                        <span class=\"text-xs font-medium text-slate-500 sm:hidden\">Select advice:</span>\n                        <div class=\"relative\">\n                            <select class=\"answer-select w-28 sm:w-24 bg-slate-50 border border-slate-300 text-slate-800 text-sm font-medium rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 p-2.5 min-h-[42px] cursor-pointer\" data-problem=\"5\">\n                                <option value=\"\">—</option>\n                                <option value=\"a\">a</option>\n                                <option value=\"b\">b</option>\n                                <option value=\"c\">c</option>\n                                <option value=\"d\">d</option>\n                                <option value=\"e\">e</option>\n                            </select>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- BOTTOM ACTION BUTTON FOR MOBILE CONVENIENCE -->\n        <div class=\"pt-2 pb-6 flex justify-center\">\n            <button onclick=\"checkAnswers()\" class=\"w-full sm:w-auto px-8 py-3 text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 rounded-xl shadow-md transition-all min-h-[48px] flex items-center justify-center gap-2\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                </svg>\n                Check Answers\n            </button>\n        </div>\n    </main>\n\n    <!-- JAVASCRIPT LOGIC -->\n    <script>\n        // Answer Key Truth based on OCR references (#1 shows 1.c pre-solved, #2 gives complete answer key: 1.c, 2.e, 3.d, 4.b, 5.a)\n        const answerKey = {\n            \"1\": \"c\",\n            \"2\": \"e\",\n            \"3\": \"d\",\n            \"4\": \"b\",\n            \"5\": \"a\"\n        };\n\n        function checkAnswers() {\n            let correctCount = 0;\n            const totalCount = Object.keys(answerKey).length;\n            const selects = document.querySelectorAll('.answer-select');\n\n            selects.forEach(select => {\n                const problemId = select.getAttribute('data-problem');\n                const userVal = select.value.toLowerCase().trim();\n                const card = select.closest('.problem-card');\n\n                // Clear previous state classes\n                card.classList.remove('border-emerald-500', 'bg-emerald-50/40', 'border-rose-500', 'bg-rose-50/40');\n                select.classList.remove('border-emerald-500', 'text-emerald-700', 'bg-emerald-50', 'border-rose-500', 'text-rose-700', 'bg-rose-50');\n\n                if (userVal === \"\") {\n                    card.classList.add('border-slate-200');\n                } else if (userVal === answerKey[problemId]) {\n                    correctCount++;\n                    card.classList.add('border-emerald-500', 'bg-emerald-50/40');\n                    select.classList.add('border-emerald-500', 'text-emerald-700', 'bg-emerald-50');\n                } else {\n                    card.classList.add('border-rose-500', 'bg-rose-50/40');\n                    select.classList.add('border-rose-500', 'text-rose-700', 'bg-rose-50');\n                }\n            });\n\n            // Update UI Score Display\n            const scoreBadge = document.getElementById('score-badge');\n            const scoreDisplay = document.getElementById('score-display');\n            scoreDisplay.textContent = `${correctCount}/${totalCount}`;\n            scoreBadge.classList.remove('hidden');\n\n            // Post message score to parent container/LMS iframe sandbox\n            window.parent.postMessage({\n                type: 'ACTIVITY_SCORE',\n                score: correctCount,\n                total: totalCount\n            }, '*');\n        }\n\n        function resetActivity() {\n            const selects = document.querySelectorAll('.answer-select');\n            selects.forEach(select => {\n                select.value = \"\";\n                const card = select.closest('.problem-card');\n                card.classList.remove('border-emerald-500', 'bg-emerald-50/40', 'border-rose-500', 'bg-rose-50/40');\n                select.classList.remove('border-emerald-500', 'text-emerald-700', 'bg-emerald-50', 'border-rose-500', 'text-rose-700', 'bg-rose-50');\n            });\n\n            document.getElementById('score-badge').classList.add('hidden');\n            window.scrollTo({ top: 0, behavior: 'smooth' });\n        }\n    </script>\n</body>\n</html>"
    },
    {
      "id": 1793212456007,
      "title": "Complete the Conversations - ELT Interactive Exercise",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Complete the Conversations - ELT Interactive Exercise</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom animations & smooth touches */\n        .tap-target { min-height: 44px; min-width: 44px; }\n        .fade-in { animation: fadeIn 0.3s ease-in-out forwards; }\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(4px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col\">\n\n    <!-- STICKY TOP HEADER / CONTROLS -->\n    <header class=\"sticky top-0 bg-white/95 backdrop-blur-md z-30 py-3 px-4 border-b border-slate-200 shadow-sm w-full\">\n        <div class=\"max-w-3xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n            <div class=\"flex items-center space-x-2\">\n                <div class=\"bg-indigo-600 text-white p-2 rounded-xl shadow-sm\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z\"></path></svg>\n                </div>\n                <div>\n                    <h1 class=\"text-sm md:text-base font-bold text-slate-900 leading-tight\">Complete the Conversations</h1>\n                    <p class=\"text-xs text-slate-500\">Choose the correct phrases to complete each dialogue.</p>\n                </div>\n            </div>\n\n            <!-- Score & Global Actions -->\n            <div class=\"flex items-center gap-2\">\n                <div id=\"score-badge\" class=\"hidden items-center bg-indigo-50 border border-indigo-200 px-3 py-1.5 rounded-xl text-xs font-semibold text-indigo-700\">\n                    Score: <span id=\"current-score\" class=\"ml-1 text-sm font-bold\">0</span>/<span id=\"total-score\">12</span>\n                </div>\n                <button onclick=\"resetActivity()\" class=\"tap-target px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-medium transition flex items-center gap-1 border border-slate-300\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"></path></svg>\n                    <span>Reset</span>\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- MAIN CONTAINER -->\n    <main class=\"w-full max-w-3xl mx-auto p-3 md:p-6 flex-grow mb-12\">\n        \n        <!-- INSTRUCTION CARD -->\n        <section class=\"bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-200 mb-6\">\n            <div class=\"flex items-start gap-3\">\n                <div class=\"bg-amber-100 text-amber-700 p-2 rounded-xl mt-0.5\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                </div>\n                <div>\n                    <h2 class=\"text-sm font-bold text-slate-900\">Exercise 3 Instruction</h2>\n                    <p class=\"text-xs md:text-sm text-slate-600 mt-0.5\">Complete the conversations with the phrases in the boxes. Tap on each gap to select the correct expression.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- CONVERSATIONS FORM -->\n        <form id=\"activity-form\" onsubmit=\"event.preventDefault(); checkAnswers();\" class=\"space-y-6\">\n\n            <!-- CONVERSATION 1 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-6 shadow-sm border border-slate-200\">\n                <div class=\"flex items-center justify-between mb-4 pb-2 border-b border-slate-100\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-lg\">Conversation 1</span>\n                </div>\n                <div class=\"space-y-3 text-sm md:text-base\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Rita</span>\n                        <p class=\"text-slate-800 flex-1\">Mark seems really fed up at the moment.</p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-indigo-600 w-16 uppercase text-xs pt-1\">David</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-1 text-slate-600 italic bg-slate-50 p-2 rounded-xl border border-slate-200\">\n                            <span>1</span>\n                            <span class=\"font-semibold text-slate-800\">Oh, dear. What's the matter?</span>\n                            <span class=\"text-xs text-slate-400 not-italic ml-auto\">(Given)</span>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Rita</span>\n                        <p class=\"text-slate-800 flex-1\">I think he's under pressure at work.</p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-indigo-600 w-16 uppercase text-xs pt-1\">David</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>2</span>\n                            <!-- Gap 2 -->\n                            <select name=\"gap-2\" data-answer=\"Why don't you\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                            <span class=\"text-slate-800\">talk to him about it?</span>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Rita</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>3</span>\n                            <!-- Gap 3 -->\n                            <select name=\"gap-3\" data-answer=\"I've tried that\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                            <span class=\"text-slate-800\">, but he says I don't understand.</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- CONVERSATION 2 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-6 shadow-sm border border-slate-200\">\n                <div class=\"flex items-center justify-between mb-4 pb-2 border-b border-slate-100\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-lg\">Conversation 2</span>\n                </div>\n                <div class=\"space-y-3 text-sm md:text-base\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Sam</span>\n                        <p class=\"text-slate-800 flex-1\">I've got too much work at the moment.</p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-indigo-600 w-16 uppercase text-xs pt-1\">Alex</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>4</span>\n                            <!-- Gap 4 -->\n                            <select name=\"gap-4\" data-answer=\"Yes, I see what you mean\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Sam</span>\n                        <p class=\"text-slate-800 flex-1\">I don't know where to start.</p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-indigo-600 w-16 uppercase text-xs pt-1\">Alex</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>5</span>\n                            <!-- Gap 5 -->\n                            <select name=\"gap-5\" data-answer=\"Have you tried\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                            <span class=\"text-slate-800\">asking your boss for help?</span>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Sam</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>6</span>\n                            <!-- Gap 6 -->\n                            <select name=\"gap-6\" data-answer=\"Well, it's worth a try\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                            <span class=\"text-slate-800\">, I guess.</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- CONVERSATION 3 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-6 shadow-sm border border-slate-200\">\n                <div class=\"flex items-center justify-between mb-4 pb-2 border-b border-slate-100\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-lg\">Conversation 3</span>\n                </div>\n                <div class=\"space-y-3 text-sm md:text-base\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Chris</span>\n                        <p class=\"text-slate-800 flex-1\">Pat and I broke up last week.</p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-indigo-600 w-16 uppercase text-xs pt-1\">Simon</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>7</span>\n                            <!-- Gap 7 -->\n                            <select name=\"gap-7\" data-answer=\"I'm sorry to hear that\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Chris</span>\n                        <p class=\"text-slate-800 flex-1\">She wants to get back together, but I'm not sure.</p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-indigo-600 w-16 uppercase text-xs pt-1\">Simon</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>8</span>\n                            <!-- Gap 8 -->\n                            <select name=\"gap-8\" data-answer=\"I'd take\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                            <span class=\"text-slate-800\">some time off work and think about it.</span>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Chris</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>9</span>\n                            <!-- Gap 9 -->\n                            <select name=\"gap-9\" data-answer=\"that's a good idea\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- CONVERSATION 4 -->\n            <div class=\"bg-white rounded-2xl p-4 md:p-6 shadow-sm border border-slate-200\">\n                <div class=\"flex items-center justify-between mb-4 pb-2 border-b border-slate-100\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-lg\">Conversation 4</span>\n                </div>\n                <div class=\"space-y-3 text-sm md:text-base\">\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Chloe</span>\n                        <p class=\"text-slate-800 flex-1\">It was really expensive and it's already broken down twice.</p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-indigo-600 w-16 uppercase text-xs pt-1\">Paul</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>10</span>\n                            <!-- Gap 10 -->\n                            <select name=\"gap-10\" data-answer=\"I can see why you're upset\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Chloe</span>\n                        <p class=\"text-slate-800 flex-1\">It's new as well.</p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-indigo-600 w-16 uppercase text-xs pt-1\">Paul</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>11</span>\n                            <!-- Gap 11 -->\n                            <select name=\"gap-11\" data-answer=\"You ought to\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                            <span class=\"text-slate-800\">write to the company.</span>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3\">\n                        <span class=\"font-bold text-slate-700 w-16 uppercase text-xs pt-1\">Chloe</span>\n                        <div class=\"flex-1 flex items-center flex-wrap gap-2\">\n                            <span>12</span>\n                            <!-- Gap 12 -->\n                            <select name=\"gap-12\" data-answer=\"might try that\" class=\"flex-1 min-w-[200px] bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm md:text-base text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition\">\n                                <option value=\"\">-- Select phrase --</option>\n                                <option value=\"Why don't you\">Why don't you</option>\n                                <option value=\"I've tried that\">I've tried that</option>\n                                <option value=\"Yes, I see what you mean\">Yes, I see what you mean</option>\n                                <option value=\"Have you tried\">Have you tried</option>\n                                <option value=\"Well, it's worth a try\">Well, it's worth a try</option>\n                                <option value=\"I'm sorry to hear that\">I'm sorry to hear that</option>\n                                <option value=\"I'd take\">I'd take</option>\n                                <option value=\"that's a good idea\">that's a good idea</option>\n                                <option value=\"I can see why you're upset\">I can see why you're upset</option>\n                                <option value=\"You ought to\">You ought to</option>\n                                <option value=\"might try that\">might try that</option>\n                            </select>\n                            <span class=\"text-slate-800\">. Thanks.</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- SUBMIT BUTTON -->\n            <div class=\"pt-4 flex justify-center\">\n                <button type=\"submit\" class=\"tap-target w-full sm:w-auto px-8 py-3.5 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-bold rounded-2xl shadow-lg shadow-indigo-200 transition text-base flex items-center justify-center gap-2\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                    <span>Check Answers</span>\n                </button>\n            </div>\n\n        </form>\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"text-center py-6 text-xs text-slate-400 border-t border-slate-200 mt-auto bg-white\">\n        Interactive ELT Micro-App &bull; Mobile-First Optimized\n    </footer>\n\n    <!-- INTERACTION LOGIC -->\n    <script>\n        function checkAnswers() {\n            const selects = document.querySelectorAll('select[data-answer]');\n            let correctCount = 0;\n            const totalCount = selects.length;\n\n            selects.forEach(select => {\n                const userAnswer = select.value.trim();\n                const correctAnswer = select.getAttribute('data-answer').trim();\n\n                // Reset previous states\n                select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900');\n\n                if (userAnswer.toLowerCase() === correctAnswer.toLowerCase()) {\n                    correctCount++;\n                    select.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-bold');\n                } else {\n                    select.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');\n                }\n            });\n\n            // Update badge score\n            const scoreBadge = document.getElementById('score-badge');\n            const currentScoreEl = document.getElementById('current-score');\n            const totalScoreEl = document.getElementById('total-score');\n\n            scoreBadge.classList.remove('hidden');\n            scoreBadge.classList.add('flex', 'fade-in');\n            currentScoreEl.textContent = correctCount;\n            totalScoreEl.textContent = totalCount;\n\n            // Post message to parent container if applicable\n            if (window.parent && window.parent !== window) {\n                window.parent.postMessage({\n                    type: 'ACTIVITY_SCORE',\n                    score: correctCount,\n                    total: totalCount\n                }, '*');\n            }\n\n            // Smooth scroll to top to see score\n            window.scrollTo({ top: 0, behavior: 'smooth' });\n        }\n\n        function resetActivity() {\n            const selects = document.querySelectorAll('select[data-answer]');\n            selects.forEach(select => {\n                select.value = \"\";\n                select.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'border-rose-500', 'bg-rose-50', 'text-rose-900', 'font-bold');\n            });\n\n            const scoreBadge = document.getElementById('score-badge');\n            scoreBadge.classList.add('hidden');\n            scoreBadge.classList.remove('flex');\n\n            window.scrollTo({ top: 0, behavior: 'smooth' });\n        }\n    </script>\n</body>\n</html>"
    }
  ]
}